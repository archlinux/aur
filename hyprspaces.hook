[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = hyprland
Target = hyprland-git

[Action]
Description = Rebuilding hyprspaces plugin for updated Hyprland...
When = PostTransaction
Depends = cmake
Depends = pkgconf
Depends = gcc
Depends = make
Exec = /usr/lib/hyprspaces/scripts/hyprspaces-rebuild
