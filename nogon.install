post_install() {
	cat <<EOM
:: To start nogon, enable the system or user service:
   systemctl enable --now nogon # or...
   systemctl --user enable --now nogon

:: Generate a default config file:
   nogon create-config ~/.config/nogon/config.yml
EOM
}

post_upgrade() {
	# Restart the system service if it is already running, to reload the binary.
	/usr/bin/systemctl set-property nogon Markers=needs-restart

	cat <<EOM
:: Restart the nogon user service if running:
   systemctl --user restart nogon
EOM
}
