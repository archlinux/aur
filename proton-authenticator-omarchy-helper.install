post_install() {
    cat <<'EOF'
==> Start the helper for your user (the Omarchy panel's Install button does this):
      systemctl --user enable --now proton-authenticator-omarchy-helper.service
EOF
}

post_upgrade() {
    # Running helpers restart themselves onto the new binary as soon as their
    # window is hidden (they exit 75 and systemd restarts them); nothing to do.
    :
}
