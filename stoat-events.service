[Unit]
Description=Stoat.chat Events
Wants=network-online.target stoat-api.service
After=network-online.target stoat-api.service
RequiresMountsFor=/etc/stoat
# Allow expected 10-second restarts while limiting unusually fast crash loops.
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=exec
User=stoat
Group=stoat
WorkingDirectory=/etc/stoat
ExecStartPre=/usr/lib/stoat/wait-api
ExecStart=/usr/bin/revolt-bonfire
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10s
TimeoutStartSec=15min
UMask=0077

# Hardening
ProtectSystem=yes
PrivateTmp=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
