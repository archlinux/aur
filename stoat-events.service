[Unit]
Description=Stoat.chat Events
Wants=network-online.target mongodb.service valkey.service rabbitmq.service stoat-api.service
After=network-online.target mongodb.service valkey.service rabbitmq.service stoat-api.service
RequiresMountsFor=/etc/stoat
StartLimitIntervalSec=0

[Service]
Type=exec
User=stoat
Group=stoat
WorkingDirectory=/etc/stoat/
ExecStartPre=/usr/lib/stoat/wait-api
ExecStart=/usr/bin/revolt-bonfire
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10s
TimeoutStartSec=15min

# Hardening
ProtectSystem=yes
PrivateTmp=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
