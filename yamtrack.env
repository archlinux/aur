# https://github.com/FuzzyGrim/Yamtrack/wiki/Environment-Variables

# Required: set to a long random string (do NOT keep the default from upstream).
SECRET=

# Bind address for gunicorn (reverse proxy should front this)
YAMTRACK_BIND=127.0.0.1:8000
WEB_CONCURRENCY=1
YAMTRACK_LOGLEVEL=INFO

# Timezone used by Django
TZ=UTC

# Valkey/Redis endpoint (Valkey defaults to localhost:6379)
REDIS_URL=redis://localhost:6379
# Optional: namespacing if you share one Valkey with other apps
# REDIS_PREFIX=yamtrack

# Reverse proxy settings (highly recommended in production)
# If you see 403s behind a proxy, set URLS/CSRF appropriately.
# URLS=https://yamtrack.example.com
# CSRF=https://yamtrack.example.com
# ALLOWED_HOSTS=yamtrack.example.com

# Optional: if hosting on a subpath, e.g. https://example.com/yamtrack
# BASE_URL=/yamtrack

# PostgreSQL (optional). If DB_HOST is set, PostgreSQL is used instead of SQLite.
# DB_HOST=127.0.0.1
# DB_NAME=yamtrack
# DB_USER=yamtrack
# DB_PASSWORD=change-me
# DB_PORT=5432

# Optional feature flags
# ADMIN_ENABLED=true
# REGISTRATION=true
# DEBUG=false
