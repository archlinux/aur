_atualizar_caches() {
  gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor 2>/dev/null || true
  kbuildsycoca6 --noincremental 2>/dev/null || true
}

_msg_autostart() {
  echo "Agildo Thermo C++: arranque automatico em /etc/xdg/autostart/"
  echo "  Desactivar: Configuracoes do Sistema > Arranque"
  echo "  ou: sudo rm /etc/xdg/autostart/agildothermo.desktop"
}

post_install() { _atualizar_caches; _msg_autostart; }
post_upgrade() { _atualizar_caches; _msg_autostart; }
post_remove() { _atualizar_caches; }
