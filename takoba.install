_src="/usr/share/vicinae-takoba"

_install_for_user() {
  local home="$1"
  local user="$2"
  local dst="$home/.local/share/vicinae/extensions/takoba"
  [ -d "$home" ] || return 0
  mkdir -p "$dst/assets"
  mkdir -p "$dst/dict"
  mkdir -p "$dst/scripts"
  cp "$_src/takoba.js" "$dst/"
  cp "$_src/package.json" "$dst/"
  cp "$_src/icon.png" "$dst/"
  cp "$_src/icon.png" "$dst/assets/"
  cp -r "$_src/dict/"* "$dst/dict/"
  cp "$_src/scripts/furigana-worker.cjs" "$dst/scripts/"
  chown -R "$user:$user" "$dst"
}

_remove_for_user() {
  local home="$1"
  local dst="$home/.local/share/vicinae/extensions/takoba"
  [ -d "$dst" ] && rm -rf "$dst"
}

post_install() {
  for home in /home/*; do
    [ -d "$home" ] || continue
    _install_for_user "$home" "$(basename "$home")"
  done
}

post_upgrade() {
  post_install
}

post_remove() {
  for home in /home/*; do
    [ -d "$home" ] || continue
    _remove_for_user "$home"
  done
}
