post_install() {
    cat <<'EOF'
podping-alpha-gossip-listener:

- Review /etc/conf.d/podping-alpha-gossip-listener before starting the service.
- Persistent runtime data lives under /var/lib/podping-alpha-gossip-listener/.
- The service runs as the podping system user.

To start and enable the listener:
  systemctl enable --now podping-alpha-gossip-listener.service

If you want publisher filtering, create:
  /var/lib/podping-alpha-gossip-listener/trusted_publishers.txt

If you enable SSE, adjust SSE_BIND_ADDR in:
  /etc/conf.d/podping-alpha-gossip-listener
EOF
}

post_upgrade() {
    post_install
}
