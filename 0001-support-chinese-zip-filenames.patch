+	g_autofree char *after = NULL;
+	gsize before_len, after_len;
+	g_assert_true (g_file_get_contents (zip, &before, &before_len, &error));
+	g_assert_no_error (error);
+	GList *removed = g_list_append (NULL, "missing.txt");
+	fr_archive_remove (archive, removed, FR_COMPRESSION_NORMAL, cancel, completed, &state);
