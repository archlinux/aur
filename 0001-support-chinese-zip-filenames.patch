+static void
+write_encrypted_zip (const char *path)
+{
+	struct archive *writer = archive_write_new ();
+	struct archive_entry *entry = archive_entry_new ();
+	g_assert_cmpint (archive_write_set_format_zip (writer), ==, ARCHIVE_OK);
+	g_assert_cmpint (archive_write_set_format_option (writer, "zip", "hdrcharset", "GBK"), ==, ARCHIVE_OK);
+	g_assert_cmpint (archive_write_set_passphrase (writer, "secret"), ==, ARCHIVE_OK);
+	g_assert_cmpint (archive_write_set_options (writer, "zip:encryption=aes256"), ==, ARCHIVE_OK);
+	g_assert_cmpint (archive_write_open_filename (writer, path), ==, ARCHIVE_OK);
+	archive_entry_set_pathname (entry, "加密中文.txt");
+	archive_entry_set_filetype (entry, AE_IFREG);
+	archive_entry_set_perm (entry, 0600);
+	archive_entry_set_size (entry, 5);
+	g_assert_cmpint (archive_write_header (writer, entry), ==, ARCHIVE_OK);
+	g_assert_cmpint (archive_write_data (writer, "hello", 5), ==, 5);
+	g_assert_cmpint (archive_write_close (writer), ==, ARCHIVE_OK);
+	archive_entry_free (entry);
+	archive_write_free (writer);
+}
+
+static void
+test_password_read (void)
+{
+	g_autoptr (GError) error = NULL;
