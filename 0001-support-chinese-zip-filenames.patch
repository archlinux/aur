+/* Build actual ZIP headers: no charset conversion by the fixture writer. */
+typedef struct {
+	const char *name;
+	const char *encoding;
+	guint16 flags;
+	const char *unicode_name;
+} ZipName;
+
+static void
+le16 (GByteArray *bytes, guint16 value)
+{
+	value = GUINT16_TO_LE (value);
+	g_byte_array_append (bytes, (guint8 *) &value, 2);
+}
+
+static void
+le32 (GByteArray *bytes, guint32 value)
+{
+	value = GUINT32_TO_LE (value);
+	g_byte_array_append (bytes, (guint8 *) &value, 4);
+}
+
+static void
+zip_header (GByteArray *bytes, const char *name, guint16 flags,
+	    GByteArray *extra, gboolean central, guint32 offset, const char *comment)
+{
+	le32 (bytes, central ? 0x02014b50 : 0x04034b50);
+	if (central)
+		le16 (bytes, 20); /* DOS host */
+	le16 (bytes, 20);
+	le16 (bytes, flags);
+	le16 (bytes, 0); /* stored */
+	le16 (bytes, 0);
+	le16 (bytes, 33); /* 1980-01-01 */
+	le32 (bytes, 0x3610a686); /* CRC32("hello") */
+	le32 (bytes, 5);
+	le32 (bytes, 5);
+	le16 (bytes, strlen (name));
+	le16 (bytes, extra->len);
+	if (central) {
+		le16 (bytes, comment != NULL ? strlen (comment) : 0);
+		le16 (bytes, 0);
+		le16 (bytes, 0);
+		le32 (bytes, 0);
+		le32 (bytes, offset);
+	}
+	g_byte_array_append (bytes, (guint8 *) name, strlen (name));
+	g_byte_array_append (bytes, extra->data, extra->len);
+	if (central && (comment != NULL))
+		g_byte_array_append (bytes, (guint8 *) comment, strlen (comment));
+}
+
+static void
+write_zip_full (const char *path, const ZipName *names, guint count,
+                const char *archive_comment, const char *file_comment)
+{
+	g_autoptr (GByteArray) local = g_byte_array_new ();
+	g_autoptr (GByteArray) central = g_byte_array_new ();
+	g_autoptr (GError) error = NULL;
+	for (guint i = 0; i < count; i++) {
+		g_autofree char *raw = g_convert (names[i].name, -1, names[i].encoding, "UTF-8", NULL, NULL, &error);
+		g_autoptr (GByteArray) extra = g_byte_array_new ();
+		g_assert_no_error (error);
+		if (names[i].unicode_name != NULL) {
+			le16 (extra, 0x7075);
+			le16 (extra, 5 + strlen (names[i].unicode_name));
+			g_byte_array_append (extra, (const guint8 *) "\1", 1);
+			le32 (extra, crc32 (0, (guint8 *) raw, strlen (raw)));
+			g_byte_array_append (extra, (guint8 *) names[i].unicode_name, strlen (names[i].unicode_name));
+		}
+		zip_header (central, raw, names[i].flags, extra, TRUE, local->len, file_comment);
+		zip_header (local, raw, names[i].flags, extra, FALSE, 0, NULL);
+		g_byte_array_append (local, (const guint8 *) "hello", 5);
+	}
+	guint32 offset = local->len;
+	g_byte_array_append (local, central->data, central->len);
+	le32 (local, 0x06054b50);
+	le16 (local, 0);
+	le16 (local, 0);
+	le16 (local, count);
+	le16 (local, count);
+	le32 (local, central->len);
+	le32 (local, offset);
+	le16 (local, archive_comment != NULL ? strlen (archive_comment) : 0);
+	if (archive_comment != NULL)
+		g_byte_array_append (local, (guint8 *) archive_comment, strlen (archive_comment));
+	g_assert_true (g_file_set_contents (path, (char *) local->data, local->len, &error));
+	g_assert_no_error (error);
+}
+
+static void
+write_zip (const char *path, const ZipName *names, guint count)
+{
+	write_zip_full (path, names, count, NULL, NULL);
+}
+
+typedef struct {
+	GMainLoop *loop;
+	FrArchive *archive;
+	GError *error;
+} Result;
+
+static void
+opened (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	Result *state = user_data;
+	state->archive = fr_archive_open_finish (G_FILE (source), result, &state->error);
+	g_main_loop_quit (state->loop);
+}
+
+static void
+completed (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	Result *state = user_data;
+	fr_archive_operation_finish (FR_ARCHIVE (source), result, &state->error);
+	g_main_loop_quit (state->loop);
+}
+
+static FrArchive *
+open_zip (const char *path, Result *state, GCancellable *cancel)
+{
+	g_autoptr (GFile) file = g_file_new_for_path (path);
+	fr_archive_open (file, cancel, opened, state);
+	g_main_loop_run (state->loop);
+	g_assert_no_error (state->error);
+	g_assert_nonnull (state->archive);
+	return state->archive;
+}
+
+static void
+check_archive (const ZipName *names, guint count, gboolean selected)
+{
+	g_autoptr (GError) error = NULL;
+	g_autofree char *tmp = g_dir_make_tmp ("file-roller-cn-XXXXXX", &error);
+	g_autofree char *zip = g_build_filename (tmp, "sample.zip", NULL);
+	g_autofree char *out = g_build_filename (tmp, "out", NULL);
+	g_autoptr (GFile) dest = g_file_new_for_path (out);
+	g_autoptr (GFile) root = g_file_new_for_path (tmp);
+	g_autoptr (GCancellable) cancel = g_cancellable_new ();
+	Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+	g_assert_no_error (error);
+	write_zip (zip, names, count);
+	g_assert_cmpint (g_mkdir (out, 0700), ==, 0);
+	g_autoptr (FrArchive) archive = open_zip (zip, &state, cancel);
+	fr_archive_list (archive, NULL, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_assert_no_error (state.error);
+	g_assert_cmpuint (archive->files->len, ==, count);
+	for (guint i = 0; i < count; i++) {
+		const char *expected = names[i].unicode_name ? names[i].unicode_name : names[i].name;
+		g_assert_true (g_hash_table_contains (archive->files_hash, expected));
+	}
+	GList *files = selected ? g_list_append (NULL, (gpointer) names[0].name) : NULL;
+	fr_archive_extract (archive, files, dest, "/", FALSE, TRUE, FALSE, NULL, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_list_free (files);
+	g_assert_no_error (state.error);
+	for (guint i = 0; i < count; i++) {
+		const char *name = names[i].unicode_name ? names[i].unicode_name : names[i].name;
+		g_autofree char *path = g_build_filename (out, name, NULL);
+		g_autofree char *contents = NULL;
+		if (selected && i > 0) {
+			g_assert_false (g_file_test (path, G_FILE_TEST_EXISTS));
+			continue;
+		}
+		g_assert_true (g_file_get_contents (path, &contents, NULL, &error));
+		g_assert_no_error (error);
+		g_assert_cmpstr (contents, ==, "hello");
+	}
+	if ((count > 1) && !selected) {
+		GList *removed = g_list_append (NULL, (gpointer) names[0].name);
+		fr_archive_remove (archive, removed, FR_COMPRESSION_NORMAL, cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		g_list_free (removed);
+		g_assert_no_error (state.error);
+		fr_archive_list (archive, NULL, cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		g_assert_no_error (state.error);
+		g_assert_cmpuint (archive->files->len, ==, count - 1);
+		g_assert_false (g_hash_table_contains (archive->files_hash, names[0].name));
+		for (guint i = 1; i < count; i++)
+			g_assert_true (g_hash_table_contains (archive->files_hash, names[i].name));
+	}
+	g_main_loop_unref (state.loop);
+	g_assert_true (_g_file_remove_directory (root, NULL, &error));
+	g_assert_no_error (error);
+}
+
+static void
+test_encoding (gconstpointer data)
+{
+	const ZipName *name = data;
+	check_archive (name, 1, FALSE);
+}
+
+static void
+test_mixed (void)
+{
+	const ZipName names[] = {
+		{ "中文目录/表格 ①.txt", "GBK", 0, NULL },
+		{ "简体中文.txt", "GB2312", 0, NULL },
+		{ "扩展字符𠀀.txt", "GB18030", 0, NULL },
+		{ "日本語😀.txt", "UTF-8", 0x800, NULL },
+		{ "plain.txt", "UTF-8", 0, NULL },
+	};
+	check_archive (names, G_N_ELEMENTS (names), FALSE);
+	check_archive (names, G_N_ELEMENTS (names), TRUE);
+}
