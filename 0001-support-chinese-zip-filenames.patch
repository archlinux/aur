+static void
+test_password_write (void)
+{
+	g_autoptr (GError) error = NULL;
+	g_autofree char *tmp = g_dir_make_tmp ("file-roller-cn-XXXXXX", &error);
+	g_autofree char *zip = g_build_filename (tmp, "created.zip", NULL);
+	g_autofree char *source = g_build_filename (tmp, "中文.txt", NULL);
+	g_autoptr (GFile) root = g_file_new_for_path (tmp);
+	g_autoptr (GFile) file = g_file_new_for_path (source);
+	g_autoptr (GFile) archive_file = g_file_new_for_path (zip);
+	g_autoptr (GCancellable) cancel = g_cancellable_new ();
+	Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+	g_assert_no_error (error);
+	g_assert_true (g_file_set_contents (source, "hello", 5, &error));
+	g_assert_no_error (error);
+	g_autoptr (FrArchive) archive = fr_archive_create (archive_file, "application/zip");
+	g_assert_nonnull (archive);
+	g_assert_true (fr_archive_is_capable_of (archive, FR_ARCHIVE_CAN_ENCRYPT));
+	GList *files = g_list_append (NULL, file);
+	fr_archive_add_files (archive, files, root, "/", FALSE, FALSE, "secret", FALSE,
+	                      FR_COMPRESSION_NORMAL, 0, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_list_free (files);
+	g_assert_no_error (state.error);
+	/* Independent reader: the created data must require a password. */
+	for (guint i = 0; i < 2; i++) {
+		struct archive *reader = archive_read_new ();
+		struct archive_entry *entry;
+		char buffer[8] = { 0 };
+		archive_read_support_format_zip (reader);
+		if (i == 1)
+			archive_read_add_passphrase (reader, "secret");
+		g_assert_cmpint (archive_read_open_filename (reader, zip, 10240), ==, ARCHIVE_OK);
+		g_assert_cmpint (archive_read_next_header (reader, &entry), ==, ARCHIVE_OK);
+		g_assert_cmpint (archive_entry_is_encrypted (entry), ==, 1);
+		if (i == 0)
+			g_assert_cmpint (archive_read_data (reader, buffer, 8), <, 0);
+		else {
+			g_assert_cmpint (archive_read_data (reader, buffer, 8), ==, 5);
+			g_assert_cmpstr (buffer, ==, "hello");
+		}
+		archive_read_free (reader);
+	}
+	g_main_loop_unref (state.loop);
+	g_assert_true (_g_file_remove_directory (root, NULL, &error));
+	g_assert_no_error (error);
+}
