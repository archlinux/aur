+static void
+test_integrity (void)
+{
+	const ZipName name = { "中文.txt", "GBK", 0, NULL };
+	for (guint i = 0; i < 2; i++) {
+		g_autoptr (GError) error = NULL;
+		g_autofree char *tmp = g_dir_make_tmp ("file-roller-cn-XXXXXX", &error);
+		g_autofree char *zip = g_build_filename (tmp, "sample.zip", NULL);
+		g_autoptr (GFile) root = g_file_new_for_path (tmp);
+		g_autoptr (GCancellable) cancel = g_cancellable_new ();
+		Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+		g_assert_no_error (error);
+		write_zip (zip, &name, 1);
+		if (i == 1) {
+			g_autofree char *bytes = NULL;
+			gsize length;
+			g_assert_true (g_file_get_contents (zip, &bytes, &length, &error));
+			g_assert_no_error (error);
+			char *payload = g_strstr_len (bytes + 30, length - 30, "hello");
+			/* Headers contain NULs, so find the known payload after filename. */
+			if (payload == NULL)
+				payload = bytes + 30 + (guint8) bytes[26] + ((guint8) bytes[27] << 8);
+			*payload = 'x';
+			g_assert_true (g_file_set_contents (zip, bytes, length, &error));
+			g_assert_no_error (error);
+		}
+		g_autoptr (FrArchive) archive = open_zip (zip, &state, cancel);
+		g_assert_true (archive->propTest);
+		fr_archive_test (archive, NULL, cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		if (i == 0)
+			g_assert_no_error (state.error);
+		else {
+			g_assert_error (state.error, FR_ERROR, FR_ERROR_COMMAND_ERROR);
+			g_clear_error (&state.error);
+		}
+		g_main_loop_unref (state.loop);
+		g_assert_true (_g_file_remove_directory (root, NULL, &error));
+		g_assert_no_error (error);
+	}
+}
