+static void
+test_comments (void)
+{
+	const ZipName names[] = {
+		{ "保留.txt", "GBK", 0, NULL },
+		{ "删除.txt", "GBK", 0, NULL },
+	};
+	for (guint i = 0; i < 4; i++) {
+		g_autoptr (GError) error = NULL;
+		g_autofree char *tmp = g_dir_make_tmp ("file-roller-cn-XXXXXX", &error);
+		g_autofree char *zip = g_build_filename (tmp, "comments.zip", NULL);
+		g_autofree char *before = NULL;
+		g_autofree char *after = NULL;
+		gsize before_len, after_len;
+		g_autoptr (GFile) root = g_file_new_for_path (tmp);
+		g_autoptr (GCancellable) cancel = g_cancellable_new ();
+		Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+		g_assert_no_error (error);
+		write_zip_full (zip, names, G_N_ELEMENTS (names), (i == 0 || i == 3) ? "Archive note" : NULL,
+		                (i == 1 || i == 2) ? "File note" : NULL);
+		if (i >= 2) {
+			g_autofree char *bytes = NULL;
+			gsize length;
+			g_assert_true (g_file_get_contents (zip, &bytes, &length, &error));
+			g_assert_no_error (error);
+			if (i == 2) {
+				memset (bytes + length - 14, 0, 4); /* underreported entries */
+				g_assert_true (g_file_set_contents (zip, bytes, length, &error));
+			}
+			else {
+				g_autoptr (GByteArray) ambiguous = g_byte_array_new ();
+				const guint8 fake_end[22] = { 0x50, 0x4b, 0x05, 0x06 };
+				bytes[length - strlen ("Archive note") - 2] = strlen ("Archive note") + 22;
+				g_byte_array_append (ambiguous, (guint8 *) bytes, length);
+				g_byte_array_append (ambiguous, fake_end, sizeof fake_end);
+				g_assert_true (g_file_set_contents (zip, (char *) ambiguous->data, ambiguous->len, &error));
+			}
+			g_assert_no_error (error);
+		}
+		g_assert_true (g_file_get_contents (zip, &before, &before_len, &error));
+		g_assert_no_error (error);
+		g_autoptr (FrArchive) archive = open_zip (zip, &state, cancel);
+		GList *removed = g_list_append (NULL, "删除.txt");
+		fr_archive_remove (archive, removed, FR_COMPRESSION_NORMAL, cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		g_list_free (removed);
+		g_assert_error (state.error, FR_ERROR, FR_ERROR_COMMAND_ERROR);
+		g_assert_nonnull (strstr (state.error->message, i == 2 ? "Cannot safely" : "comments"));
+		g_clear_error (&state.error);
+		g_assert_true (g_file_get_contents (zip, &after, &after_len, &error));
+		g_assert_no_error (error);
+		g_assert_cmpmem (before, before_len, after, after_len);
+		g_main_loop_unref (state.loop);
+		g_assert_true (_g_file_remove_directory (root, NULL, &error));
+		g_assert_no_error (error);
+	}
+}
