+/* libarchive does not expose ZIP archive/file comments. Refuse an edit that
+ * would silently discard them. Read only the directory, not file payloads. */
+static guint16
+zip_uint16 (const guint8 *p)
+{
+	return p[0] | ((guint16) p[1] << 8);
+}
+
+static guint32
+zip_uint32 (const guint8 *p)
+{
+	guint32 value;
+	memcpy (&value, p, sizeof value);
+	return GUINT32_FROM_LE (value);
+}
+
+static guint64
+zip_uint64 (const guint8 *p)
+{
+	guint64 value;
+	memcpy (&value, p, sizeof value);
+	return GUINT64_FROM_LE (value);
+}
+
+static gboolean
+zip_read_at (GInputStream *stream, goffset offset, void *buffer, gsize size,
+             GCancellable *cancellable, GError **error)
+{
+	gsize bytes;
+	if (!g_seekable_seek (G_SEEKABLE (stream), offset, G_SEEK_SET, cancellable, error)
+	    || !g_input_stream_read_all (stream, buffer, size, &bytes, cancellable, error))
+		return FALSE;
+	if (bytes != size) {
+		g_set_error_literal (error, FR_ERROR, FR_ERROR_COMMAND_ERROR, "Truncated ZIP directory");
+		return FALSE;
+	}
+	return TRUE;
+}
+
+static gboolean
+zip_can_rewrite (LoadData *data)
+{
+	g_autoptr (GInputStream) stream = NULL;
+	g_autofree guint8 *tail = NULL;
+	guint8 locator[20], header[56];
+	goffset size, end, position;
+	guint64 directory_size, entries;
+	gssize found = -1;
+	gsize tail_size;
+
+	if (!_g_str_equal (data->archive->mime_type, "application/zip")
+	    && !_g_str_equal (data->archive->mime_type, "application/x-cbz"))
+		return TRUE;
+	stream = G_INPUT_STREAM (g_file_read (fr_archive_get_file (data->archive), data->cancellable, &data->error));
+	if (stream == NULL) {
+		if (g_error_matches (data->error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND)) {
+			g_clear_error (&data->error); /* creating a new ZIP */
+			return TRUE;
+		}
+		return FALSE;
+	}
+	if (!g_seekable_seek (G_SEEKABLE (stream), 0, G_SEEK_END, data->cancellable, &data->error))
+		return FALSE;
+	size = g_seekable_tell (G_SEEKABLE (stream));
+	tail_size = MIN (size, 65535 + 22);
+	tail = g_malloc (tail_size);
+	if (!zip_read_at (stream, size - tail_size, tail, tail_size, data->cancellable, &data->error))
+		return FALSE;
+	for (gssize i = (gssize) tail_size - 22; i >= 0; i--)
+		if ((zip_uint32 (tail + i) == 0x06054b50)
+		    && (i + 22 + zip_uint16 (tail + i + 20) == tail_size)) {
+			/* An EOCD-looking sequence can itself occur in a comment.
+			 * Reject any such commented candidate rather than losing it. */
+			if (zip_uint16 (tail + i + 20) != 0)
+				goto comments;
+			if (found < 0)
+				found = i;
+		}
+	if (found < 0)
+		goto invalid_directory;
+	if (zip_uint16 (tail + found + 20) != 0)
+		goto comments;
+	end = size - tail_size + found;
+	directory_size = zip_uint32 (tail + found + 12);
+	entries = zip_uint16 (tail + found + 10);
+	if (end >= 20) {
+		if (!zip_read_at (stream, end - 20, locator, sizeof locator, data->cancellable, &data->error))
+			return FALSE;
+		if (zip_uint32 (locator) == 0x07064b50) {
+			guint64 zip64_offset = zip_uint64 (locator + 8);
+			if ((end < 76) || (zip64_offset > (guint64) (end - 76)))
+				goto invalid_directory;
+			if (!zip_read_at (stream, zip64_offset, header, sizeof header, data->cancellable, &data->error))
+				return FALSE;
+			if ((zip_uint32 (header) != 0x06064b50) || (zip_uint64 (header + 4) < 44))
+				goto invalid_directory;
+			entries = zip_uint64 (header + 32);
+			directory_size = zip_uint64 (header + 40);
+			end = zip64_offset;
+		}
+	}
+	if ((directory_size > (guint64) end) || (entries > directory_size / 46))
+		goto invalid_directory;
+	position = end - directory_size;
+	for (guint64 i = 0; i < entries; i++) {
+		if (position > end - 46)
+			goto invalid_directory;
+		if (!zip_read_at (stream, position, header, 46, data->cancellable, &data->error))
+			return FALSE;
+		if (zip_uint32 (header) != 0x02014b50)
+			goto invalid_directory;
+		if (zip_uint16 (header + 32) != 0)
+			goto comments;
+		position += 46 + zip_uint16 (header + 28) + zip_uint16 (header + 30);
+		if (position > end)
+			goto invalid_directory;
+	}
+	if ((position != end) || ((entries == 0) && (end != 0)))
+		goto invalid_directory;
+	return TRUE;
+comments:
+	g_set_error_literal (&data->error, FR_ERROR, FR_ERROR_COMMAND_ERROR,
+	                    "Editing ZIP archives with comments is not supported; the original archive was kept unchanged");
+	return FALSE;
+invalid_directory:
+	g_set_error_literal (&data->error, FR_ERROR, FR_ERROR_COMMAND_ERROR,
+	                    "Cannot safely rewrite this ZIP directory; the original archive was kept unchanged");
+	return FALSE;
+}
