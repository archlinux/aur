+static void
+test_split (void)
+{
+	g_autofree char *sevenz = g_find_program_in_path ("7z");
+	if (sevenz == NULL) {
+		g_test_skip ("7zip is required to exercise split ZIP compatibility");
+		return;
+	}
+	g_autoptr (GError) error = NULL;
+	g_autofree char *tmp = g_dir_make_tmp ("file-roller-cn-XXXXXX", &error);
+	g_autofree char *source = g_build_filename (tmp, "data.bin", NULL);
+	g_autofree char *volume = g_build_filename (tmp, "split.zip.001", NULL);
+	g_autofree char *out = g_build_filename (tmp, "out", NULL);
+	g_autofree char *extracted = g_build_filename (out, "data.bin", NULL);
+	g_autofree char *contents = NULL;
+	gsize length;
+	char bytes[20000] = { 0 };
+	g_autoptr (GFile) root = g_file_new_for_path (tmp);
+	g_autoptr (GFile) dest = g_file_new_for_path (out);
+	g_autoptr (GCancellable) cancel = g_cancellable_new ();
+	Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+	g_assert_no_error (error);
+	g_assert_true (g_file_set_contents (source, bytes, sizeof bytes, &error));
+	g_assert_no_error (error);
+	char *args[] = { sevenz, "a", "-tzip", "-mx=0", "-v8k", "split.zip", "data.bin", NULL };
+	int status;
+	g_assert_true (g_spawn_sync (tmp, args, NULL, G_SPAWN_STDOUT_TO_DEV_NULL,
+	                            NULL, NULL, NULL, NULL, &status, &error));
+	g_assert_no_error (error);
+	g_assert_true (g_spawn_check_wait_status (status, &error));
+	g_assert_no_error (error);
+	g_assert_cmpint (g_mkdir (out, 0700), ==, 0);
+	g_autoptr (FrArchive) archive = open_zip (volume, &state, cancel);
+	fr_archive_list (archive, NULL, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_assert_no_error (state.error);
+	fr_archive_extract (archive, NULL, dest, "/", FALSE, TRUE, FALSE, NULL, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_assert_no_error (state.error);
+	g_assert_true (g_file_get_contents (extracted, &contents, &length, &error));
+	g_assert_no_error (error);
+	g_assert_cmpmem (bytes, sizeof bytes, contents, length);
+	g_main_loop_unref (state.loop);
+	g_assert_true (_g_file_remove_directory (root, NULL, &error));
+	g_assert_no_error (error);
+}
