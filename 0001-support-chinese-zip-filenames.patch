+/* libarchive converts explicitly Unicode names through LC_CTYPE. Use a
+ * thread-local UTF-8 locale, without changing the GUI/process locale. */
+typedef struct {
+	locale_t previous;
+	locale_t utf8;
+} ArchiveLocale;
+
+static void
+archive_locale_clear (ArchiveLocale *scope)
+{
+	if (scope->utf8 != (locale_t) 0) {
+		uselocale (scope->previous);
+		freelocale (scope->utf8);
+	}
+}
+
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC (ArchiveLocale, archive_locale_clear)
+
+static ArchiveLocale
+archive_locale_init (void)
+{
+	ArchiveLocale scope = { 0 };
+	scope.utf8 = newlocale (LC_CTYPE_MASK, "C.UTF-8", (locale_t) 0);
+	if (scope.utf8 != (locale_t) 0)
+		scope.previous = uselocale (scope.utf8);
+	return scope;
+}
