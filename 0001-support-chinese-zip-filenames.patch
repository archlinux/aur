+/* Decode before any selection, path safety checks, or archive rewrite.
+ * Libarchive has already applied ZIP's UTF-8 flag and Unicode path extras.
+ * On Unix it otherwise preserves legacy filename bytes. */
+static char *
+zip_name_to_utf8 (const char *name,
+                  GError    **error)
+{
+	const char *encoding;
+	char *converted;
+
+	if ((name == NULL) || g_utf8_validate (name, -1, NULL))
+		return NULL;
+
+	encoding = g_getenv ("FILE_ROLLER_FILENAME_ENCODING");
+	if ((encoding == NULL) || (*encoding == 0)) {
+		converted = g_convert (name, -1, "UTF-8", "GB18030", NULL, NULL, NULL);
+		if (converted == NULL)
+			converted = g_convert (name, -1, "UTF-8", "CP437", NULL, NULL, error);
+	}
+	else
+		converted = g_convert (name, -1, "UTF-8", encoding, NULL, NULL, error);
+
+	return converted;
+}
+
+
+static int
+read_next_header (struct archive        *a,
+                  struct archive_entry **entry)
+{
+	int r = archive_read_next_header (a, entry);
+	g_autoptr (GError) error = NULL;
+	g_autofree char *pathname = NULL;
+	g_autofree char *symlink = NULL;
+	g_autofree char *hardlink = NULL;
+
+	if ((r != ARCHIVE_OK)
+	    || ((archive_format (a) & ARCHIVE_FORMAT_BASE_MASK) != ARCHIVE_FORMAT_ZIP))
+		return r;
+
+	if (archive_entry_pathname (*entry) == NULL) {
+		archive_set_error (a, EILSEQ, "Missing archive entry pathname");
+		return ARCHIVE_FATAL;
+	}
+
+	pathname = zip_name_to_utf8 (archive_entry_pathname (*entry), &error);
+	if (error == NULL)
+		symlink = zip_name_to_utf8 (archive_entry_symlink (*entry), &error);
+	if (error == NULL)
+		hardlink = zip_name_to_utf8 (archive_entry_hardlink (*entry), &error);
+	if (error != NULL) {
+		archive_set_error (a, EILSEQ, "Cannot decode archive filename: %s", error->message);
+		return ARCHIVE_FATAL;
+	}
+
+	if (pathname != NULL) {
+		/* GBK can use 0x5c as a trail byte: split Windows paths only
+		 * after decoding, never by replacing raw backslash bytes. */
+		g_strdelimit (pathname, "\\", '/');
+		archive_entry_set_pathname (*entry, pathname);
+	}
+	if (symlink != NULL)
+		archive_entry_set_symlink (*entry, symlink);
+	if (hardlink != NULL)
+		archive_entry_set_hardlink (*entry, hardlink);
+	return ARCHIVE_OK;
 }
 
 
