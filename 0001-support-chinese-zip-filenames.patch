+/* -- integrity test -- */
+
+static void
+test_archive_thread (GSimpleAsyncResult *result, GObject *object, GCancellable *cancellable)
+{
+	g_auto (ArchiveLocale) locale = archive_locale_init ();
+	g_autoptr (LoadData) data = g_simple_async_result_get_op_res_gpointer (result);
+	g_autoptr (_archive_read_ctx) reader = NULL;
+	struct archive_entry *entry;
+	int r = create_read_object (data, &reader);
+
+	if (r == ARCHIVE_OK) {
+		while ((r = read_next_header (reader, &entry)) == ARCHIVE_OK) {
+			const void *buffer;
+			size_t size;
+			int64_t offset;
+			while (!g_cancellable_is_cancelled (cancellable)
+			       && (r = archive_read_data_block (reader, &buffer, &size, &offset)) == ARCHIVE_OK)
+				;
+			if ((r != ARCHIVE_EOF) || g_cancellable_is_cancelled (cancellable))
+				break;
+		}
+	}
+	if (data->error == NULL)
+		g_cancellable_set_error_if_cancelled (cancellable, &data->error);
+	if ((data->error == NULL) && (r != ARCHIVE_EOF))
+		data->error = _g_error_new_from_archive_error (archive_error_string (reader));
+	if (data->error != NULL)
+		g_simple_async_result_set_from_error (result, data->error);
+}
+
+static void
+fr_archive_libarchive_test (FrArchive *archive, const char *password,
+                            GCancellable *cancellable, GAsyncReadyCallback callback,
+                            gpointer user_data)
+{
+	LoadData *data = g_new0 (LoadData, 1);
+	load_data_init (data);
+	data->archive = g_object_ref (archive);
+	data->password = g_strdup (password);
+	data->cancellable = _g_object_ref (cancellable);
+	data->result = g_simple_async_result_new (G_OBJECT (archive), callback, user_data, fr_archive_test);
+	g_simple_async_result_set_op_res_gpointer (data->result, data, NULL);
+	g_simple_async_result_run_in_thread (data->result, test_archive_thread, G_PRIORITY_DEFAULT, cancellable);
+}
