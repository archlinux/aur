+	g_autofree char *valid = g_build_filename (out, "正常中文.txt", NULL);
+	g_autoptr (GFile) root = g_file_new_for_path (tmp);
+	g_autoptr (GFile) dest = g_file_new_for_path (out);
+	g_autoptr (GCancellable) cancel = g_cancellable_new ();
