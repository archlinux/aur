+	g_autofree char *zip = g_build_filename (tmp, "encrypted.zip", NULL);
+	g_autofree char *out = g_build_filename (tmp, "out", NULL);
+	g_autofree char *extracted = g_build_filename (out, "加密中文.txt", NULL);
+	g_autofree char *contents = NULL;
+	g_autoptr (GFile) dest = g_file_new_for_path (out);
+	g_autoptr (GFile) root = g_file_new_for_path (tmp);
+	g_autoptr (GCancellable) cancel = g_cancellable_new ();
+	Result state = { g_main_loop_new (NULL, FALSE), NULL, NULL };
+	g_assert_no_error (error);
+	write_encrypted_zip (zip);
+	g_assert_cmpint (g_mkdir (out, 0700), ==, 0);
+	g_autoptr (FrArchive) archive = open_zip (zip, &state, cancel);
+	fr_archive_list (archive, NULL, cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_assert_no_error (state.error);
+	g_assert_cmpuint (archive->files->len, ==, 1);
+	FrFileData *file = g_ptr_array_index (archive->files, 0);
+	g_assert_true (file->encrypted);
+	const char *passwords[] = { NULL, "wrong", "secret" };
+	for (guint i = 0; i < G_N_ELEMENTS (passwords); i++) {
+		fr_archive_extract (archive, NULL, dest, "/", FALSE, TRUE, FALSE, passwords[i], cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		if (i < 2) {
+			g_assert_error (state.error, FR_ERROR, FR_ERROR_ASK_PASSWORD);
+			g_clear_error (&state.error);
+		}
+		else
+			g_assert_no_error (state.error);
+	}
+	g_assert_true (g_file_get_contents (extracted, &contents, NULL, &error));
+	g_assert_no_error (error);
+	g_assert_cmpstr (contents, ==, "hello");
+	g_autofree char *before = NULL;
+	g_autofree char *after = NULL;
+	gsize before_len, after_len;
+	g_assert_true (g_file_get_contents (zip, &before, &before_len, &error));
+	g_assert_no_error (error);
+	GList *renamed = g_list_append (NULL, "加密中文.txt");
+	for (guint i = 0; i < 2; i++) {
+		fr_archive_set_password (archive, i == 0 ? "wrong" : "secret");
+		fr_archive_rename (archive, renamed, "加密中文.txt", "重命名.txt", "/", FALSE, FALSE,
+		                   "加密中文.txt", cancel, completed, &state);
+		g_main_loop_run (state.loop);
+		if (i == 0) {
+			g_assert_error (state.error, FR_ERROR, FR_ERROR_ASK_PASSWORD);
+			g_clear_error (&state.error);
+			g_assert_true (g_file_get_contents (zip, &after, &after_len, &error));
+			g_assert_no_error (error);
+			g_assert_cmpmem (before, before_len, after, after_len);
+		}
+		else
+			g_assert_no_error (state.error);
+	}
+	g_list_free (renamed);
+	fr_archive_list (archive, "secret", cancel, completed, &state);
+	g_main_loop_run (state.loop);
+	g_assert_no_error (state.error);
+	g_assert_true (g_hash_table_contains (archive->files_hash, "重命名.txt"));
+	file = g_ptr_array_index (archive->files, 0);
+	g_assert_true (file->encrypted);
+	g_main_loop_unref (state.loop);
+	g_assert_true (_g_file_remove_directory (root, NULL, &error));
+	g_assert_no_error (error);
+}
