+/* libarchive's GInputStream reader cannot join split ZIP volumes. Keep
+ * the upstream 7-Zip backend for these rather than extracting a prefix. */
+static gboolean
+is_split_zip (GFile *file, const char *mime_type)
+{
+	g_autofree char *name = NULL;
+	g_autofree char *lower = NULL;
+	g_autoptr (GFile) parent = NULL;
+	gsize length;
+	if (!_g_str_equal (mime_type, "application/zip")
+	    && !_g_str_equal (mime_type, "application/x-cbz"))
+		return FALSE;
+	name = g_file_get_basename (file);
+	lower = g_ascii_strdown (name, -1);
+	length = strlen (lower);
+	if (g_str_has_suffix (lower, ".001")
+	    || ((length > 4) && (lower[length - 4] == '.') && (lower[length - 3] == 'z')
+	        && g_ascii_isdigit (lower[length - 2]) && g_ascii_isdigit (lower[length - 1])))
+		return TRUE;
+	if (!g_str_has_suffix (lower, ".zip"))
+		return FALSE;
+	parent = g_file_get_parent (file);
+	if (parent == NULL)
+		return FALSE;
+	const char *extensions[] = { ".z01", ".Z01" };
+	for (guint i = 0; i < G_N_ELEMENTS (extensions); i++) {
+		g_autofree char *stem = g_strndup (name, length - 4);
+		g_autofree char *volume_name = g_strconcat (stem, extensions[i], NULL);
+		g_autoptr (GFile) volume = g_file_get_child (parent, volume_name);
+		if (g_file_query_exists (volume, NULL))
+			return TRUE;
+	}
+	return FALSE;
+}
