+int
+main (int argc, char **argv)
+{
+	static const ZipName cases[] = {
+		{ "中文目录/测试文件.txt", "GB2312", 0, NULL },
+		{ "中文目录/表格 ①.txt", "GBK", 0, NULL },
+		{ "扩展字符𠀀.txt", "GB18030", 0, NULL },
+		{ "UTF8目录/中文😀.txt", "UTF-8", 0x800, NULL },
+		{ "没有标记的中文.txt", "UTF-8", 0, NULL },
+		{ "legacy.txt", "UTF-8", 0, "Unicode目录/正确😀.txt" },
+		{ "中文.txt", "GBK", 0, "优先Unicode😀.txt" },
+		{ "plain.txt", "UTF-8", 0, NULL },
+		{ "café.txt", "CP437", 0, NULL },
+	};
+	setlocale (LC_ALL, "");
+	g_test_init (&argc, &argv, NULL);
+	fr_initialize_data ();
+	for (guint i = 0; i < G_N_ELEMENTS (cases); i++) {
+		g_autofree char *name = g_strdup_printf ("/archive/encoding/%u", i);
+		g_test_add_data_func (name, &cases[i], test_encoding);
+	}
+	g_test_add_func ("/archive/mixed-and-selected", test_mixed);
+	g_test_add_func ("/archive/backend", test_backend);
+	g_test_add_func ("/archive/override", test_override);
+	g_test_add_func ("/archive/invalid-encoding", test_invalid_encoding);
+	g_test_add_func ("/archive/path-safety", test_path_safety);
+	g_test_add_func ("/archive/comments", test_comments);
+	g_test_add_func ("/archive/integrity", test_integrity);
+	g_test_add_func ("/archive/split", test_split);
+	g_test_add_func ("/archive/password-read", test_password_read);
+	g_test_add_func ("/archive/password-write", test_password_write);
+	return g_test_run ();
+}
