From d2dad0d497977526b86ceaefcf1ebf5dca4fab28 Mon Sep 17 00:00:00 2001
From: Younes Khoudli <younes.khoudli@epita.fr>
Date: Sat, 22 Aug 2026 19:49:59 +0200
Subject: [PATCH] makeplugin: do not bundle system dependencies

---
 makeplugin.py | 17 +----------------
 1 file changed, 1 insertion(+), 16 deletions(-)

diff --git a/makeplugin.py b/makeplugin.py
index 8a717b12..f614e11c 100644
--- a/makeplugin.py
+++ b/makeplugin.py
@@ -34,25 +34,10 @@ if __name__=="__main__":
                   files,
                   exclude=exclude)
 
-    os.chdir('../included_dependencies')
-    files=[
-        'cloudscraper',
-        'requests',
-        'requests_toolbelt',
-        'requests_file.py',
-        'urllib3',
-        'certifi',
-        'idna',
-        'brotlidecpy', # still needed for cal5.
-        ]
-    createZipFile("../"+filename,"a",
-                  files,
-                  exclude=exclude)
-
     os.chdir('..')
     # 'a' for append
     files=['fanficfare']
     createZipFile(filename,"a",
                   files,
-                  exclude=exclude)
+                  exclude=exclude + ['*.py'])
 
