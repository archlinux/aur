[Unit]
Description=The openHAB 5 Home Automation Bus Solution
Documentation=http://docs.openhab.org
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=openhab5
Group=openhab5
WorkingDirectory=/usr/share/openhab5
EnvironmentFile=/etc/default/openhab5
ExecStart=/usr/share/openhab5/karaf_wrapper.sh server
ExecStop=/usr/share/openhab5/karaf_wrapper.sh stop
Restart=on-failure

[Install]
WantedBy=multi-user.target
