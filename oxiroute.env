RUST_LOG=info
OXIROUTE_AUDIT_DIR=/var/lib/oxiroute/audit
OXIROUTE_AUDIT_MAX_RECORDS=10000
OXIROUTE_AUDIT_MAX_RECORD_BYTES=16384
OXIROUTE_AUDIT_MAX_FILE_BYTES=1048576
OXIROUTE_AUDIT_MAX_TOTAL_BYTES=8388608
OXIROUTE_AUDIT_MAX_ROTATED_FILES=7
# OXIROUTE_MANAGEMENT_TOKEN_FILE=/etc/oxiroute/management.token
# Deprecated: set `retirement { drain_deadline_ms }` in the configuration instead, which takes
# precedence. Longest time (seconds, 1 to 86400) a replaced worker keeps serving the connections it
# already accepted after a configuration reload; the default is the larger of 10800 (3 hours) and
# the longest HTTP upstream_io_timeout_ms.
# OXIROUTE_RELOAD_DRAIN_SECONDS=10800
