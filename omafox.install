# shellcheck shell=bash

post_install() {
  printf '%s\n' \
    '' \
    '==> Omafox installed successfully!' \
    '' \
    '🚀 To complete setup:' \
    '   1. Install the separately distributed Omafox extension in Firefox or Zen Browser.' \
    '   2. Run as your desktop user:' \
    '      omafox setup' \
    '' \
    '   This will:' \
    '   • Enable the Omarchy theme hook' \
    '   • Queue the current palette for connected browsers' \
    '   • Configure the CSS bridge for existing Zen profiles' \
    '' \
    'Restart Zen once after setup, then change your Omarchy theme and watch your browsers follow along!' \
    ''
}

post_upgrade() {
  printf '%s\n' \
    '' \
    '==> Omafox updated successfully!' \
    '' \
    '   To complete the update:' \
    '   • Install or update the separately distributed Omafox extension in Firefox or Zen.' \
    '   • Run "omafox setup" as your desktop user.' \
    '   • Restart Zen, or restart Firefox/reload the extension.' \
    ''
}

post_remove() {
  printf '%s\n' \
    '' \
    '==> Omafox removed.' \
    '' \
    'Preserved user files:' \
    '   • ~/.config/omarchy/hooks/theme-set.d/omafox' \
    '   • ~/.local/state/omafox/theme.json' \
    '   • Managed files and blocks in detected Zen profiles' \
    '' \
    'Remove only the Omafox-owned files and marked blocks if "omafox remove" was not run first.' \
    'Zen preferences copied from user.js can be reset in about:config if desired.' \
    'The separately installed browser extension was not removed.' \
    '' \
    'Thank you for using Omafox!' \
    ''
}
