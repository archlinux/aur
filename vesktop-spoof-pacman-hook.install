#!/bin/bash

post_install() {
    /usr/bin/sed -i 's|Exec=/usr/bin/vesktop\s*%U|Exec=/usr/bin/vesktop --user-agent-os windows %U|' /usr/share/applications/vesktop.desktop
}

post_upgrade() {
    post_install
}

post_remove() {
    /usr/bin/sed -i 's|Exec=/usr/bin/vesktop --user-agent-os windows %U|Exec=/usr/bin/vesktop\s*%U|' /usr/share/applications/vesktop.desktop
}
