+    } else if let Ok(nodeinfo) = crate::backend::virsh::exec::run(uri, &["nodeinfo"]).await {
+        let info = crate::backend::virsh::host_local::parse_nodeinfo(&nodeinfo, "remote");
+        out.push((
+            String::from("cpus     "),
+            format!("{} threads · {}", info.threads, info.cpu_model),
+        ));
     }
     out
 }
