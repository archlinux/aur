post_install() {
  echo "==> Creating symlink for opencode-openai-codex-auth plugin..."
  echo "==> This is not standard practice for AUR packages and may have unintended side effects."
  
  getent passwd | while IFS=: read -r name _ uid gid _ home _; do
    if [ "$uid" -ge 1000 ] && [ -d "$home" ] && [ "$home" != "/" ]; then
      echo "--> Processing user: $name"
      su -s /bin/sh -c "mkdir -p '$home/.config/opencode/plugin' && ln -sf '/usr/lib/opencode/plugins/opencode-openai-codex-auth' '$home/.config/opencode/plugin/'" "$name"
    fi
  done
}

post_upgrade() {
  post_install
}

pre_remove() {
  echo "==> Removing symlink for opencode-openai-codex-auth plugin..."
  getent passwd | while IFS=: read -r name _ uid _ _ home _; do
    if [ "$uid" -ge 1000 ] && [ -d "$home" ] && [ "$home" != "/" ]; then
      if [ -L "$home/.config/opencode/plugin/opencode-openai-codex-auth" ]; then
        echo "--> Removing for user: $name"
        su -s /bin/sh -c "rm '$home/.config/opencode/plugin/opencode-openai-codex-auth'" "$name"
      fi
    fi
  done
}