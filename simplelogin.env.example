URL=https://simplelogin.example.com

EMAIL_DOMAIN=alias.example.com
SUPPORT_EMAIL=support@alias.example.com
SUPPORT_NAME=SimpleLogin

EMAIL_SERVERS_WITH_PRIORITY=[(10, "mail.example.com.")]

DISABLE_ALIAS_SUFFIX=1

DKIM_PRIVATE_KEY_PATH=/etc/simplelogin/dkim.key
DKIM_PUBLIC_KEY_PATH=/etc/simplelogin/dkim.pub.key

DB_URI=postgresql://simplelogin@/simplelogin?host=/run/postgresql

FLASK_SECRET=change-me

GNUPGHOME=/var/lib/simplelogin/pgp
LOCAL_FILE_UPLOAD=1

POSTFIX_SERVER=localhost

MEM_STORE_URI=redis+unix:///run/valkey/valkey.sock

DISABLE_REGISTRATION=1
DISABLE_ONBOARDING=true
