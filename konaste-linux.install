post_install() {
	case "${LANG}" in
		ja*) DISCLAIMER="Konaste Linuxは、Wineを使用してLinux環境でコナステゲームをプレイ可能にする非公式プロジェクトです。したがって、KONAMI Amusementによる承認やサポートは一切ありません。Konaste Linuxをご利用になる場合、発生する可能性のある問題についてKONAMIがサポートを提供しないことに同意したものとみなされます。" ;;
		*) DISCLAIMER="Konaste Linux is an unofficial project to allow users to play KONAMI Amusement Game Station (Konaste) games on Linux-based operating systems using Wine. As such, it is not affiliated with, endorsed, nor supported by KONAMI Amusement. By using this script, you agree that KONAMI will not provide support for any problems that may arise." ;;
	esac

	echo -e "\033[1m\n${DISCLAIMER}\n\033[22m"
	unset DISCLAIMER

	echo -e "Run \033[1mkonaste init\033[22m to create the Wineprefix!"
}

post_remove() {
	case "${LANG}" in
		ja*) UNINSTALL_TIP="Konaste Linux のアンインストールを完了するには、\033[1m~/.local/share/konaste-linux\033[22m にあるデータディレクトリを削除してください。" ;;
		*) UNINSTALL_TIP="To complete the uninstall of Konaste Linux, remove the data directory at \033[1m~/.local/share/konaste-linux\033[22m." ;;
	esac

	echo -e "\033[1m\n${UNINSTALL_TIP}\n\033[22m"
	unset UNINSTALL_TIP
}
