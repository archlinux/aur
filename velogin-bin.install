post_install() {
    echo ':: velogin installed.'
    echo ':: Disable your current display manager (if any) and getty@tty1:'
    echo '     systemctl disable <current-login-manager>.service'
    echo '     systemctl disable getty@tty1.service'
    echo ':: Enable velogin login manager:'
    echo '     systemctl enable velogin.service'
}

post_upgrade() {
    post_install
}
