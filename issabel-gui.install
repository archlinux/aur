post_install() {
  echo "=========================================="
  echo "  IssabelPBX Installation"
  echo "=========================================="
  echo ""

  # 1. Set permissions
  echo ">>> Setting permissions..."
  chown -R asterisk:asterisk /var/www/html/admin
  chmod 755 /var/www/html/admin
  chown -R asterisk:asterisk /var/www/html/admin/modules
  chmod 755 /var/www/html/admin/modules
  find /var/www/html/admin/modules -type d -exec chmod 755 {} \; 2>/dev/null
  find /var/www/html/admin/modules -type f -exec chmod 644 {} \; 2>/dev/null
  chown -R asterisk:asterisk /var/www/html/admin/libraries
  chmod 755 /var/www/html/admin/libraries
  chown asterisk:asterisk /var/www/html/admin/libraries/gettextinc.php
  chmod 644 /var/www/html/admin/libraries/gettextinc.php
  chown -R asterisk:asterisk /var/www/html/admin/views
  chmod 755 /var/www/html/admin/views

  # 2. Apply PHP 8.x compatibility fixes
  echo ">>> Applying PHP 8.x compatibility fixes..."

  # Fix admin/libraries/gettextinc.php - syntax error in function __
  if [ -f /var/www/html/admin/libraries/gettextinc.php ]; then
    # Check if the broken line exists and fix it
    if grep -q "function __(\$msgid) {); }" /var/www/html/admin/libraries/gettextinc.php 2>/dev/null; then
      sed -i "s/function __(\$msgid) {); }/function __(\$msgid) {/" \
        /var/www/html/admin/libraries/gettextinc.php
    fi
  fi

  # Fix admin/views/menu.php - implode() requires separator in PHP 8
  if [ -f /var/www/html/admin/views/menu.php ]; then
    # Fix implode calls
    sed -i 's/\$mods\[\$t\] \.= implode(\$items);/$mods[$t] .= implode("", $items);/' \
      /var/www/html/admin/views/menu.php 2>/dev/null || true
    sed -i 's/\$out \.= implode(\$mods);/$out .= implode("", $mods);/' \
      /var/www/html/admin/views/menu.php 2>/dev/null || true
    
    # Add $mods array initialization if not present
    if ! grep -q '\$mods = array();' /var/www/html/admin/views/menu.php; then
      sed -i '91i\    $mods = array();' /var/www/html/admin/views/menu.php
    fi
  fi

  # Fix qr_batch IssabelQRConfig.class.php - count() on potentially false result
  if [ -f /var/www/html/modules/qr_batch/libs/IssabelQRConfig.class.php ]; then
    sed -i 's/if(count($result)>0)/if($result !== false \&\& count($result)>0)/' \
      /var/www/html/modules/qr_batch/libs/IssabelQRConfig.class.php 2>/dev/null || true
  fi

  # 3. Initialize MySQL database for issabelPBX
  echo ">>> Initializing MySQL database..."
  if systemctl is-active --quiet mariadb; then
    # Create asterisk database if not exists
    mysql -u root -e "CREATE DATABASE IF NOT EXISTS asterisk CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null || true
    mysql -u root -e "CREATE USER IF NOT EXISTS 'asteriskuser'@'localhost' IDENTIFIED BY '385044c4053aa853e679';" 2>/dev/null || true
    mysql -u root -e "GRANT ALL PRIVILEGES ON asterisk.* TO 'asteriskuser'@'localhost';" 2>/dev/null || true
    mysql -u root -e "FLUSH PRIVILEGES;" 2>/dev/null || true
    
    # Create modules table if not exists
    mysql -u root asterisk -e "CREATE TABLE IF NOT EXISTS modules (
      id INT AUTO_INCREMENT PRIMARY KEY,
      modulename VARCHAR(100) NOT NULL,
      enabled TINYINT(1) DEFAULT 0,
      version VARCHAR(20),
      publisher VARCHAR(100),
      license VARCHAR(50)
    ) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null || true
  fi

  # 4. Create configuration files
  echo ">>> Creating configuration files..."
  if [ ! -f /etc/issabelpbx.conf ]; then
    cat > /etc/issabelpbx.conf << 'EOFCFG'
<?php
$amp_conf['AMPDBUSER']  = 'asteriskuser';
$amp_conf['AMPDBPASS']  = '385044c4053aa853e679';
$amp_conf['AMPDBHOST']  = 'localhost';
$amp_conf['AMPDBNAME']  = 'asterisk';
$amp_conf['AMPDBENGINE'] = 'mysql';
$amp_conf['datasource'] = '';
require_once('/var/www/html/admin/bootstrap.php');
EOFCFG
    chown root:root /etc/issabelpbx.conf
    chmod 644 /etc/issabelpbx.conf
  fi

  if [ ! -f /etc/amportal.conf ]; then
    cat > /etc/amportal.conf << 'EOFAMP'
# IssabelPBX Configuration
AMPDBHOST=localhost
AMPDBNAME=asterisk
AMPDBUSER=asteriskuser
AMPDBPASS=385044c4053aa853e679
AMPDBENGINE=mysql
ASTMANAGERHOST=localhost
ASTMANAGERPORT=5038
ASTMANAGERPROXYPORT=0
AMPMGRUSER=admin
AMPMGRPASS=admin
EOFAMP
    chown root:root /etc/amportal.conf
    chmod 644 /etc/amportal.conf
  fi

  # 5. Clear template cache
  echo ">>> Clearing template cache..."
  rm -rf /var/www/html/var/templates_c/*

  # 6. Restart services
  echo ">>> Restarting services..."
  systemctl restart httpd 2>/dev/null || true

  # 7. Create log file
  touch /var/log/asterisk/issabelpbx_dbug
  chown asterisk:asterisk /var/log/asterisk/issabelpbx_dbug
  chmod 666 /var/log/asterisk/issabelpbx_dbug

  echo ""
  echo "=========================================="
  echo "  IssabelPBX installed successfully!"
  echo "=========================================="
  echo ""
  echo "Access: http://localhost:8080/index.php"
  echo "Login: admin"
  echo "Password: admin1234"
  echo ""
  echo "IMPORTANT: This is a BETA release for Arch Linux."
  echo "Some features may not work correctly."
  echo ""
  echo "If you encounter issues:"
  echo "  1. Check logs: tail -f /var/log/httpd/error_log"
  echo "  2. Clear browser cache"
  echo "  3. Report issues on GitHub"
  echo ""
}

post_upgrade() {
  post_install
}
