[Desktop Entry]
Name=TrackMania United Forever
Icon=trackmania-forever-united
Type=Application
Categories=Game;
Keywords=racing;tmf;tmnf;vanilla;
Path=/opt/TmForever
Exec=trackmania-forever TmForever.exe /singleinst --file-or-url %u
MimeType=application/x-trackmania-forever-replay;application/x-trackmania-forever-challenge;x-scheme-handler/tmtp;
Actions=launcher;

[Desktop Action launcher]
Name=Launcher
Exec=trackmania-forever TmForeverLauncher.exe
