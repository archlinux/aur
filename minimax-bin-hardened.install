post_install() {
  local BLUE='\033[0;34m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local RED='\033[0;31m'
  local BOLD='\033[1m'
  local NC='\033[0m'

  echo -e ""
  echo -e "${BLUE}+============================================================================+${NC}"
  echo -e "${BLUE}|              ${BOLD}MINIMAX-BIN-HARDENED - Installation Complete${NC}${BLUE}                  |${NC}"
  echo -e "${BLUE}+============================================================================+${NC}"
  echo -e ""

  if command -v apparmor_parser >/dev/null 2>&1; then
    echo -e "${GREEN}  AppArmor detected. Configuring security profile...${NC}"

    if cp /usr/share/apparmor/minimax.apparmor /etc/apparmor.d/minimax 2>/dev/null; then
      if apparmor_parser -r /etc/apparmor.d/minimax 2>/dev/null; then
        if aa-enforce /etc/apparmor.d/minimax 2>/dev/null; then
          echo -e "${GREEN}   Profile installed, loaded, and ENFORCED.${NC}"
          echo -e "${GREEN}   MiniMax is now running under Mandatory Access Control.${NC}"
        else
          echo -e "${YELLOW}   Profile loaded but could not be enforced (aa-enforce failed).${NC}"
        fi
      else
        echo -e "${YELLOW}   Profile installed but could not be loaded (apparmor_parser failed).${NC}"
      fi
    else
      echo -e "${RED}   Could not install AppArmor profile to /etc/apparmor.d/${NC}"
    fi
  else
    echo -e "${YELLOW}  AppArmor NOT detected.${NC}"
    echo -e "   For maximum security, we strongly recommend installing AppArmor:"
    echo -e "   ${BOLD}sudo pacman -S apparmor${NC}"
    echo -e "   Then reinstall this package to auto-configure the profile."
  fi

  echo -e ""
  echo -e "${BOLD}  SECURITY VERIFICATION:${NC}"
  echo -e "   You can verify the integrity of this installation by reading:"
  echo -e "   ${BLUE}/usr/share/doc/minimax-bin-hardened/SECURITY.md${NC}"
  echo -e ""
  echo -e "${BOLD}  NEXT STEPS:${NC}"
  echo -e "   1. Launch MiniMax from your application menu or run: ${BOLD}minimax${NC}"
  echo -e "   2. If you experience permission issues, check system logs:"
  echo -e "      ${BOLD}journalctl -xe | grep minimax${NC}"
  echo -e ""
  echo -e "${BLUE}----------------------------------------------------------------------------${NC}"
  echo -e ""
}

post_upgrade() {
  post_install

  echo -e "\033[1;33m  CACHE CLEANUP ADVICE:\033[0m"
  echo -e "   If MiniMax behaves unexpectedly after upgrade, clear the cache:"
  echo -e "   \033[1mrm -rf ~/.config/minimax/Cache ~/.config/minimax/CachedData ~/.config/minimax/Code\ Cache\033[0m"
  echo -e ""
}

post_remove() {
  echo -e ""
  echo -e "\033[1;34m  CLEANUP RECOMMENDATIONS:\033[0m"
  echo -e ""
  echo -e "   1. Remove AppArmor profile (if installed):"
  echo -e "      \033[1msudo rm /etc/apparmor.d/minimax\033[0m"
  echo -e "      \033[1msudo systemctl reload apparmor\033[0m"
  echo -e ""
  echo -e "   2. Remove user data (Optional):"
  echo -e "      \033[1mrm -rf ~/.config/minimax ~/.cache/minimax ~/.local/share/minimax\033[0m"
  echo -e ""
}
