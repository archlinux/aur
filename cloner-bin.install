post_install() {
    cat <<'EOF'

Cloner needs write access to Ingenic SoC USB devices.
udev rules were installed to /usr/lib/udev/rules.d/50-cloner.rules.

Add yourself to the plugdev group to use the device without root:

    sudo usermod -aG plugdev $USER

Then log out and back in (or run: newgrp plugdev).

Note: this package ships a prebuilt binary. Upstream does not release source code.
EOF
}

post_upgrade() {
    post_install
}