      "TypeTextRequestDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "keyDelay": {
            "default": 0,
            "type": "number",
            "description": "A delay between keystrokes in milliseconds. By default type as fast as possible"
          },
          "keyDelayDeviation": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Deviation for randomness of delay. Final delay = delay ± (delay * deviation). E.g if keyDelay = 100 and deviation = 0.2. Then value would be 80-120ms"
          }
        },
        "required": [
