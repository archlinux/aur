post_install() {
  /usr/lib/vok_sk/vok_sk-register add
  echo "-- Layout 'vok_sk' (Slovak, Vogo's keyboard) is now available in X11 and Wayland."
  echo "-- Please read http://www.abclinuxu.cz/blog/origami/2006/12/21/162644"
}

post_upgrade() {
  post_install
}

pre_remove() {
  /usr/lib/vok_sk/vok_sk-register remove
}
