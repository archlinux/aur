[Unit]
Description=PDS Gatekeeper - 2FA microservice for self-hosted AT Protocol PDSes
Documentation=https://tangled.org/baileytownsend.dev/pds-gatekeeper
After=network.target

[Service]
User=pds-gatekeeper
Group=pds-gatekeeper
EnvironmentFile=-/etc/pds-gatekeeper.env
ExecStart=/usr/bin/pds-gatekeeper

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pds
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
