[Unit]
Description=PDS Gatekeeper - 2FA microservice for self-hosted AT Protocol PDSes
Documentation=https://tangled.org/did:plc:rnpkyqnmsw4ipey6eotbdnnf/pds-gatekeeper
Requires=pds.service
After=pds.service

[Service]
User=pds
Group=pds
EnvironmentFile=/etc/pds-gatekeeper.env
ExecStart=/usr/bin/pds-gatekeeper
WorkingDirectory=/var/lib/pds

ReadWritePaths=/var/lib/pds
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=noaccess
ProcSubset=pid
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
PrivateDevices=yes
PrivateUsers=self
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
