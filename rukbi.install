# rukbi install script: informational message about the required session
# restart (kwin_wayland scans XKB extension directories once, at startup).

post_install() {
    printf '\n'
    printf '==============================================================\n'
    printf '  Rukbi keyboard layouts installed.\n'
    printf '  Restart the session (log out and log back in) now,\n'
    printf '  then add the layouts:\n'
    printf '    System Settings -> Keyboard -> Layouts -> Add layout\n'
    printf '==============================================================\n'
    printf '\n'
}

post_upgrade() {
    post_install
}