[Unit]
Description=wmbusmeters service
After=network.target

[Service]
Type=forking
User=wmbusmeters
RuntimeDirectory=wmbusmeters
ExecStart=/usr/bin/wmbusmetersd /run/wmbusmeters/wmbusmeters.pid
ExecReload=/usr/bin/kill -HUP $MAINPID
PIDFile=/run/wmbusmeters/wmbusmeters.pid
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
