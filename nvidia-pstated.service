[Unit]
Description=A daemon that automatically manages the performance states of NVIDIA GPUs
StartLimitInterval=0

[Service]
DynamicUser=yes
EnvironmentFile=/etc/conf.d/nvidia-pstated
ExecStart=/usr/bin/nvidia-pstated $NVIDIA_PSTATED_ARGS
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
