pre_install() {
    echo "=============================================="
    echo " ffmpeg-cuda-full conflicts with stock ffmpeg"
    echo "=============================================="
    echo ""
    echo " During FFmpeg ABI transitions, upgrade this"
    echo " package and repository consumers together:"
    echo ""
    echo "   paru --combinedupgrade -Syu ffmpeg-cuda-full"
    echo "=============================================="
}

pre_upgrade() {
    pre_install
}
