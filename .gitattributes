.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# LF required for interactive patching as of Git 2.17.1
*.diff          text eol=lf
*.patch         text eol=lf

# Patches have inconsistent line endings, which need to be preserved
github-*.patch  binary
