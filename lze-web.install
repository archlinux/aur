post_install() {
if [ -n "$SUDO_USER" ]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
else
    USER_HOME=$HOME
fi
  pip config set global.target /usr/local/bin 
  sudo pip install webssh --break-system-packages
  mkdir  $HOME/Documents/note
  chmod 777  $HOME/Documents
  chmod 777  $HOME/Downloads 
  chmod 777  $HOME/Pictures
  chmod 777 $HOME/Documents/note
  ln -s $HOME/Documents /opt/lze-web/Documents
  ln -s $HOME/Downloads /opt/lze-web/Downloads
  ln -s $HOME/Pictures /opt/lze-web/Pictures
  ln -s /opt/lze-web/code/Terminal/webssh-start /usr/bin/webssh-start
  ln -s /opt/lze-web/code/Terminal/webssh-stop /usr/bin/webssh-stop
  mv /etc/httpd/conf/httpd.conf /etc/httpd/conf/httpd.conf.back
  mv /etc/httpd/conf/httpd.conf.lze /etc/httpd/conf/httpd.conf
  mv /etc/php/php.ini /etc/php/php.ini.bck
  mv /etc/php/php.lze /etc/php/php.ini
  systemctl enable --now httpd.service
cp -r  templates /usr/lib/python3.12/site-packages/webssh
cp -r  statici /usr/lib/python3.12/site-packages/webssh
rm -rf  templates
rm -rf  statici 
sudo systemctl enable --now wessh.service
}

post_upgrade() {
	post_install
}

pre_remove() {
	#

	action="$1"
	if [ "$2" = "in-favour" ]; then
	  # Treat conflict remove as an upgrade.
	  action="upgrade"
	fi

}

post_remove() {
systemctl disable --now wessh.service
rm /etc/systemd/system/wessh.service
rm -rf /opt/lze-web
mv /etc/httpd/conf/httpd.conf.bck  /etc/httpd/conf/httpd.conf 
mv /etc/php/php.ini.bck  /etc/php/php.ini
}
