post_install() {
  if [ -n "$SUDO_USER" ]; then
    cu_user="$SUDO_USER"
    uhome=$(getent passwd "$current_user" | cut -d: -f6)
else
    cu_user=$(whoami)
fi

  mkdir /$cu_user
  mkdir /$cu_user/Documents
  mkdir /$cu_user/Downloads
  mkdir /$cu_user/Pictures
  mkdir /$cu_user/Note
  mkdir /$cu_user/Bookmark
  chmod 777  -R /$cu_user
  ln -s /$cu_user /opt/lze-web/file
  ln -s /opt/lze-web/code/Terminal/webssh-start /usr/bin/webssh-start
  ln -s /opt/lze-web/code/Terminal/webssh-stop /usr/bin/webssh-stop
  ln -s /opt/lze-web/code/Terminal/webssh /usr/lib/python3.12/site-packages/webssh
  mv /etc/httpd/conf/httpd.conf /etc/httpd/conf/httpd.conf.back
  mv /etc/httpd/conf/httpd.conf.lze /etc/httpd/conf/httpd.conf
  mv /etc/php/php.ini /etc/php/php.ini.bck
  mv /etc/php/php.ini.lze /etc/php/php.ini
  systemctl enable --now httpd.service
sudo systemctl enable --now wessh.service
}

post_upgrade() {
	post_install
}

pre_remove() {
	#

	action="$1"
	if [ "$2" = "in-favour" ]; then
	  # Treat conflict remove as an upgrade.
	  action="upgrade"
	fi

}

post_remove() {
systemctl disable --now wessh.service
rm -rf /usr/lib/python3.12/site-packages/webssh
rm /etc/systemd/system/wessh.service
rm -rf /opt/lze-web
rm /usr/bin/webssh-start
rm /usr/bin/webssh-stop
mv /etc/httpd/conf/httpd.conf.bck  /etc/httpd/conf/httpd.conf 
mv /etc/php/php.ini.bck  /etc/php/php.ini
}
