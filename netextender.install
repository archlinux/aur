post_install() {
    echo
    echo "Enable the background service before connecting:"
    echo "    systemctl enable --now NEService"
}
post_upgrade() {
    echo
    echo "NEService.service moved from /etc/systemd/system to /usr/lib/systemd/system."
    echo "If you had enabled the service, refresh the stale symlink with:"
    echo "    systemctl reenable NEService"
    echo
    echo "NetExtender no longer uses pppd. If you had run 'chmod u+s /usr/bin/pppd'"
    echo "for an earlier version, you may now revert it with 'chmod u-s /usr/bin/pppd'."
}
