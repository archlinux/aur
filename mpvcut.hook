[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = etc/skel/.config/mpv/scripts/mpvcut/*

[Action]
Description = Install/upgrade mpvcut in ~/.config/mpv/scripts/
When = PostTransaction
Exec = /usr/local/bin/update-mpvcut

[Trigger]
Operation = Remove
Type = Path
Target = etc/skel/.config/mpv/scripts/mpvcut/*

[Action]
Description = Remove mpvcut from all users
When = PreTransaction
Exec = /usr/local/bin/remove-mpvcut
