[Unit]
Description=AnythingLLM Server
Documentation=https://github.com/Mintplex-Labs/anything-llm
After=network-online.target
Wants=network-online.target
Before=anythingllm-collector.service

[Service]
Type=simple
User=anythingllm
Group=anythingllm
WorkingDirectory=/srv/anythingllm/server

EnvironmentFile=/etc/anythingllm/server.env
Environment=NODE_ENV=production

ExecStartPre=/bin/bash -c '\
    cd /srv/anythingllm/server && \
    npx prisma generate --schema=./prisma/schema.prisma && \
    npx prisma migrate deploy --schema=./prisma/schema.prisma'
ExecStart=/usr/bin/node /srv/anythingllm/server/index.js

StandardOutput=append:/var/log/anythingllm/server.log
StandardError=append:/var/log/anythingllm/server.log

Restart=on-failure
RestartSec=10
StartLimitInterval=2min
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/anythingllm /var/lib/anythingllm /var/log/anythingllm /etc/anythingllm
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
