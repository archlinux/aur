#!/usr/bin/env python3
"""
nouveau-ctrl — CLI management tool for Nouveau Fermi GPU reclocking & telemetry
Usage:
  nouveau-ctrl status
  nouveau-ctrl set <03|07|0f|10|auto>
  nouveau-ctrl set_throttle_temp <temp>
  nouveau-ctrl daemon [start|stop|status|restart|enable|disable|reload]
  nouveau-ctrl watch [-i SECONDS]
"""
import argparse
import glob
import os
import re
import shutil
import subprocess
import sys
import time

PSTATE_CANDIDATES = [
    "/sys/kernel/debug/dri/0/pstate",
    "/sys/kernel/debug/dri/0000:01:00.0/pstate",
    "/sys/kernel/debug/dri/128/pstate",
]
CLIENTS_CANDIDATES = [
    "/sys/kernel/debug/dri/0/clients",
    "/sys/kernel/debug/dri/0000:01:00.0/clients",
    "/sys/kernel/debug/dri/128/clients",
]
HWMON_GLOB = "/sys/class/drm/card0/device/hwmon/hwmon*/"
CONFIG_PATH = "/etc/nouveau-dynclockd.conf"

PSTATE_LABELS = {
    "03": "P12 Low-Power Standby / Idle",
    "07": "P8  Standard 2D Desktop",
    "08": "P8  Standard 2D Desktop",
    "0f": "P0  Full 3D Performance",
    "10": "OC  Boost / Overclock",
}

def read_privileged_file(paths):
    """Reads a file, attempting direct read, then sudo -n, then interactive sudo if in TTY."""
    if isinstance(paths, str):
        paths = [paths]
    for p in paths:
        if not os.path.exists(p) and not p.startswith("/sys/kernel/debug"):
            continue
        try:
            with open(p, "r") as f:
                return f.read().strip()
        except (PermissionError, FileNotFoundError):
            try:
                out = subprocess.run(["sudo", "-n", "cat", p], capture_output=True, text=True, timeout=2)
                if out.returncode == 0 and out.stdout:
                    return out.stdout.strip()
            except Exception:
                pass
            if sys.stdin.isatty():
                try:
                    out = subprocess.run(["sudo", "cat", p], capture_output=True, text=True, timeout=10)
                    if out.returncode == 0 and out.stdout:
                        return out.stdout.strip()
                except Exception:
                    pass
        except Exception:
            pass
    return None

def read_sysfs(path):
    """Reads standard world-readable sysfs nodes."""
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return None

def get_config_throttle_temp():
    """Reads configured thermal throttle temperature from config file."""
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("THROTTLE_TEMP="):
                        val = line.split("=", 1)[1].strip()
                        return int(val)
        except Exception:
            pass
    return 80

def get_pstates_data():
    raw = read_privileged_file(PSTATE_CANDIDATES)
    if not raw:
        return {}, None, None

    states = {}
    active_state_id = None
    live_clock = None

    for line in raw.splitlines():
        line_str = line.strip()
        if not line_str:
            continue

        # Check for live operating clock line (e.g., "AC: core 202 MHz memory 324 MHz")
        if line_str.startswith("AC:") or line_str.startswith("DC:") or line_str.startswith("none:"):
            m_live = re.match(r"(?:AC|DC|none):\s*core\s+(\d+)\s*MHz(?:\s*shader\s+(\d+)\s*MHz)?\s*memory\s+(\d+)\s*MHz", line_str)
            if m_live:
                core = int(m_live.group(1))
                shader = int(m_live.group(2)) if m_live.group(2) else core * 2
                mem = int(m_live.group(3))
                live_clock = {"core": core, "shader": shader, "memory": mem, "raw": line_str}
            continue

        # Match performance state entries: "07: core 202 MHz [shader 405 MHz] memory 324 MHz [AC DC *]"
        m_state = re.match(r"(\w+):\s*core\s+(\d+)\s*MHz(?:\s*shader\s+(\d+)\s*MHz)?\s*memory\s+(\d+)\s*MHz(.*)", line_str)
        if m_state:
            st_id = m_state.group(1)
            core = int(m_state.group(2))
            shader = int(m_state.group(3)) if m_state.group(3) else core * 2
            mem = int(m_state.group(4))
            flags = m_state.group(5).strip() if m_state.group(5) else ""
            
            is_active = "*" in flags
            if is_active:
                active_state_id = st_id

            states[st_id] = {
                "id": st_id,
                "core": core,
                "shader": shader,
                "memory": mem,
                "flags": flags,
                "active": is_active,
                "label": PSTATE_LABELS.get(st_id, "Performance Level"),
            }

    if not active_state_id and live_clock:
        for st_id, s in states.items():
            if s["core"] == live_clock["core"] and s["memory"] == live_clock["memory"]:
                active_state_id = st_id
                s["active"] = True
                break

    return states, active_state_id, live_clock

def get_hwmon_data():
    base_dirs = glob.glob(HWMON_GLOB)
    data = {}
    
    if base_dirs:
        base = base_dirs[0]
        # Temperature
        raw_temp = read_sysfs(os.path.join(base, "temp1_input"))
        if raw_temp and raw_temp.isdigit():
            data["temp_c"] = float(raw_temp) / 1000.0

        # Core Voltage
        raw_volt = read_sysfs(os.path.join(base, "in0_input"))
        if raw_volt and raw_volt.isdigit():
            data["voltage_v"] = float(raw_volt) / 1000.0

        # GPU Fan RPM & PWM if present
        raw_fan = read_sysfs(os.path.join(base, "fan1_input"))
        if raw_fan and raw_fan.isdigit():
            data["fan_rpm"] = int(raw_fan)
            data["fan_label"] = "GPU Fan"
        raw_pwm = read_sysfs(os.path.join(base, "pwm1"))
        if raw_pwm and raw_pwm.isdigit():
            data["pwm"] = int(raw_pwm)

    # If fan was not found in GPU hwmon, scan system/platform hwmons (e.g. dell_smm)
    if "fan_rpm" not in data:
        for hw_path in glob.glob("/sys/class/hwmon/hwmon*/"):
            for f in glob.glob(os.path.join(hw_path, "fan*_input")):
                raw_fan = read_sysfs(f)
                if raw_fan and raw_fan.isdigit():
                    lbl_file = f.replace("_input", "_label")
                    lbl = read_sysfs(lbl_file) or "Processor Fan"
                    data["fan_rpm"] = int(raw_fan)
                    data["fan_label"] = lbl
                    break
            if "fan_rpm" in data:
                break

    return data

def get_pcie_data():
    dev_path = "/sys/bus/pci/devices/0000:01:00.0/"
    cur_spd = read_sysfs(os.path.join(dev_path, "current_link_speed"))
    cur_wid = read_sysfs(os.path.join(dev_path, "current_link_width"))
    max_spd = read_sysfs(os.path.join(dev_path, "max_link_speed"))
    max_wid = read_sysfs(os.path.join(dev_path, "max_link_width"))
    if cur_spd and cur_wid:
        gen_cur = " (Gen1)" if "2.5" in cur_spd else (" (Gen2)" if "5.0" in cur_spd else (" (Gen3)" if "8.0" in cur_spd else ""))
        gen_max = " (Gen1)" if max_spd and "2.5" in max_spd else (" (Gen2)" if max_spd and "5.0" in max_spd else (" (Gen3)" if max_spd and "8.0" in max_spd else ""))
        cur_str = f"{cur_spd.replace(' PCIe', '')}{gen_cur} x{cur_wid}"
        max_str = f"{max_spd.replace(' PCIe', '')}{gen_max} x{max_wid}" if (max_spd and max_wid) else ""
        return cur_str, max_str
    return None, None

def get_daemon_status():
    try:
        res = subprocess.run(["systemctl", "is-active", "nouveau-dynclockd.service"], capture_output=True, text=True, timeout=2)
        status = res.stdout.strip()
        return status if status else "unknown"
    except Exception:
        return "unknown"

def get_drm_clients():
    raw = read_privileged_file(CLIENTS_CANDIDATES)
    if not raw:
        return []
    clients = []
    lines = raw.splitlines()
    for l in lines[1:]:
        parts = l.split()
        if len(parts) >= 2:
            comm = parts[0]
            tgid = parts[1]
            if comm not in ("systemd-logind", "<unset>"):
                clients.append({"command": comm, "pid": tgid, "raw": l})
    return clients

def cmd_status(args):
    states, active_id, live = get_pstates_data()
    hw = get_hwmon_data()
    daemon = get_daemon_status()
    clients = get_drm_clients()
    throttle_temp = get_config_throttle_temp()

    print("================================================================================")
    print(" 🎮 Nouveau Fermi GPU Status & Reclocking Control")
    print("================================================================================")

    # Active clock & hardware state
    if live:
        active_desc = f"P-State [{active_id}]" if active_id else "Dynamic State"
        print(f" • Active Clocks:  Core: {live['core']} MHz  |  Shader: {live['shader']} MHz  |  Memory: {live['memory']} MHz ({active_desc})")
    elif active_id and active_id in states:
        s = states[active_id]
        print(f" • Active Clocks:  Core: {s['core']} MHz  |  Shader: {s['shader']} MHz  |  Memory: {s['memory']} MHz (P-State [{active_id}])")
    else:
        print(" • Active Clocks:  [Permission required or pstate node unavailable]")

    # Telemetry info
    temp_c = hw.get("temp_c")
    if temp_c is not None:
        if temp_c > 75.0:
            temp_color = "\033[31;1m"  # Red (> 75 °C)
        elif temp_c >= 65.0:
            temp_color = "\033[33;1m"  # Yellow (65 - 75 °C)
        else:
            temp_color = "\033[32;1m"  # Green (< 65 °C)

        if temp_c >= throttle_temp:
            thermal_status = f"\033[31;1mTHROTTLED (Capped to P-State 07)\033[0m"
        else:
            thermal_status = f"\033[32mNormal (Cap: 07)\033[0m"
        temp_str = f"{temp_color}{temp_c:.1f} °C\033[0m  (Throttle Limit: {throttle_temp} °C | Status: {thermal_status})"
    else:
        temp_str = "N/A"

    volt_str = f"{hw['voltage_v']:.3f} V" if "voltage_v" in hw else "N/A"
    
    if "fan_rpm" in hw:
        fan_str = f"{hw['fan_rpm']} RPM ({hw.get('fan_label', 'Fan')})"
    else:
        fan_str = "N/A"

    pcie_cur, pcie_max = get_pcie_data()
    if pcie_cur:
        pcie_str = f"{pcie_cur}" + (f"  [Max: {pcie_max}]" if pcie_max else "")
    else:
        pcie_str = "N/A"

    daemon_str = f"\033[32mActive (running)\033[0m" if daemon == "active" else f"\033[33m{daemon}\033[0m"

    print(f" • Temperature:    {temp_str}")
    print(f" • Core Voltage:   {volt_str}")
    print(f" • Fan Speed:      {fan_str}")
    print(f" • PCIe Link:      {pcie_str}")
    print(f" • Dynamic Daemon: nouveau-dynclockd ({daemon_str})")
    print("--------------------------------------------------------------------------------")

    # P-States Table
    if states:
        print(" Available Performance States (P-States):")
        for st_id, s in sorted(states.items()):
            marker = "▶ [*]" if (st_id == active_id or s["active"]) else "  [ ]"
            label = s["label"]
            print(f"  {marker} {st_id}: Core {s['core']:>4} MHz  |  Shader {s['shader']:>4} MHz  |  Memory {s['memory']:>4} MHz  —  {label}")
    else:
        print(" Performance States: Could not read /sys/kernel/debug/dri/*/pstate (Run with sudo or check debugfs permissions)")

    print("--------------------------------------------------------------------------------")
    
    # Active 3D DRM Clients
    if clients:
        print(" Active DRM / 3D Clients:")
        unique_clients = {}
        for c in clients:
            unique_clients[c["command"]] = c["pid"]
        for comm, pid in unique_clients.items():
            print(f"   • {comm:<20} (PID: {pid})")
    else:
        print(" Active DRM / 3D Clients: None detected (Idle Desktop)")
    print("================================================================================")

def cmd_set(args):
    target = args.state
    if target == "auto":
        print("[*] Enabling dynamic governor daemon (nouveau-dynclockd)...")
        subprocess.run(["sudo", "systemctl", "restart", "nouveau-dynclockd.service"])
        print("[✓] Dynamic GPU governor active.")
        return

    if target not in ("03", "07", "08", "0f", "10", "AC"):
        print(f"[!] Invalid state '{target}'. Valid states: 03 (idle), 07 (2D desktop), 0f (3D performance), 10 (OC), auto", file=sys.stderr)
        sys.exit(1)

    print(f"[[*] Stopping background daemon to lock GPU clock to '{target}'...")
    subprocess.run(["sudo", "systemctl", "stop", "nouveau-dynclockd.service"], capture_output=True)

    target_node = "/sys/kernel/debug/dri/0/pstate"
    for p in PSTATE_CANDIDATES:
        if os.path.exists(p):
            target_node = p
            break

    try:
        res = subprocess.run(["sudo", "tee", target_node], input=target + "\n", text=True, capture_output=True, timeout=5)
        if res.returncode == 0:
            print(f"[✓] Successfully locked GPU to P-State: {target}")
            time.sleep(0.2)
            cmd_status(args)
        else:
            print(f"[!] Failed to set pstate: {res.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"[!] Error writing to {target_node}: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_set_throttle_temp(args):
    temp = args.temp
    if temp < 50 or temp > 95:
        print(f"[!] Error: Temperature must be between 50 and 95 °C (got {temp}).", file=sys.stderr)
        sys.exit(1)

    conf_path = CONFIG_PATH
    lines = []
    found = False
    if os.path.exists(conf_path):
        try:
            with open(conf_path, "r") as f:
                for line in f:
                    if line.strip().startswith("THROTTLE_TEMP="):
                        lines.append(f"THROTTLE_TEMP={temp}\n")
                        found = True
                    else:
                        lines.append(line)
        except Exception:
            pass
    if not found:
        lines.append(f"THROTTLE_TEMP={temp}\n")

    content = "".join(lines)
    written = False
    try:
        with open(conf_path, "w") as f:
            f.write(content)
        written = True
    except PermissionError:
        try:
            res = subprocess.run(["sudo", "tee", conf_path], input=content, text=True, capture_output=True, timeout=5)
            written = (res.returncode == 0)
        except Exception:
            pass

    if not written:
        print(f"[!] Failed to write to {conf_path}. Check permissions or run with sudo.", file=sys.stderr)
        sys.exit(1)

    print(f"[✓] Thermal throttle threshold successfully set to {temp} °C in {conf_path}")

    # Notify daemon if running (daemon auto-reloads on file mtime within 1s as well)
    if get_daemon_status() == "active":
        subprocess.run(["sudo", "-n", "systemctl", "kill", "-s", "HUP", "nouveau-dynclockd.service"], capture_output=True)
        print("[✓] Daemon configuration updated (auto-reloading).")

def cmd_daemon(args):
    action = args.action
    if action not in ("start", "stop", "status", "restart", "enable", "disable", "reload"):
        print("Usage: nouveau-ctrl daemon [start|stop|status|restart|enable|disable|reload]", file=sys.stderr)
        sys.exit(1)
    
    if action == "status":
        subprocess.run(["systemctl", "status", "nouveau-dynclockd.service"])
    elif action == "reload":
        subprocess.run(["sudo", "systemctl", "kill", "-s", "HUP", "nouveau-dynclockd.service"])
        print("[✓] Sent SIGHUP reload signal to nouveau-dynclockd.")
    else:
        subprocess.run(["sudo", "systemctl", action, "nouveau-dynclockd.service"])

def cmd_watch(args):
    interval = max(0.5, args.interval)
    try:
        while True:
            os.system("clear" if os.name == "posix" else "cls")
            cmd_status(args)
            print(f"\n[Live Monitor: updating every {interval}s — Press Ctrl+C to exit]")
            time.sleep(interval)
    except KeyboardInterrupt:
        print("\nExiting monitor.")

def cmd_help(args, parsers):
    if hasattr(args, "topic") and args.topic:
        if args.topic in parsers:
            parsers[args.topic].print_help()
            return
        print(f"Unknown help topic '{args.topic}'. Available commands: status, set, set_throttle_temp, daemon, watch, help", file=sys.stderr)
        return
    parsers["_root"].print_help()

def main():
    p = argparse.ArgumentParser(
        prog="nouveau-ctrl",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="""🎮 Nouveau Fermi GPU Performance & Reclocking Management Utility

Commands:
  status                     Show live GPU clocks, P-States, temperature, fan, and active 3D clients
  set <03|07|0f|10|auto>     Lock performance state or return to dynamic governor
  set_throttle_temp <temp>   Configure dynamic governor thermal throttle threshold in °C (default: 80)
  daemon [action]            Manage the background governor (start|stop|status|restart|reload)
  watch [-i SECONDS]         Live monitoring dashboard (top-like view)
  help [command]             Show this help message or details for a command

Examples:
  nouveau-ctrl status
  nouveau-ctrl set 0f              # Lock to full 3D performance (590 MHz / 900 MHz)
  nouveau-ctrl set auto            # Return to dynamic frequency governor
  nouveau-ctrl set_throttle_temp 80 # Cap to state 07 at 80 °C
  nouveau-ctrl watch -i 0.5        # Fast refresh live monitor
"""
    )
    sub = p.add_subparsers(dest="cmd", help="Command to run")

    s = sub.add_parser("status", help="Show current GPU clocks, P-States, temperature, fan speed, and 3D clients")
    s.set_defaults(func=cmd_status)

    s2 = sub.add_parser("set", help="Set GPU clock state (03, 07, 0f, 10, auto)")
    s2.add_argument("state", help="Target state: 03 (idle), 07 (2D), 0f (3D), 10 (OC), or auto")
    s2.set_defaults(func=cmd_set)

    s_temp = sub.add_parser("set_throttle_temp", aliases=["set-throttle-temp"], help="Set GPU thermal throttle temperature in °C (caps clock to 07)")
    s_temp.add_argument("temp", type=int, help="Target throttle temperature in °C (e.g. 80)")
    s_temp.set_defaults(func=cmd_set_throttle_temp)

    s3 = sub.add_parser("daemon", help="Manage background governor (nouveau-dynclockd)")
    s3.add_argument("action", nargs="?", default="status", help="start | stop | status | restart | enable | disable | reload")
    s3.set_defaults(func=cmd_daemon)

    s4 = sub.add_parser("watch", help="Live top-like monitoring dashboard")
    s4.add_argument("-i", "--interval", type=float, default=1.0, help="Refresh interval in seconds (default: 1.0)")
    s4.set_defaults(func=cmd_watch)

    parsers = {"_root": p, "status": s, "set": s2, "set_throttle_temp": s_temp, "daemon": s3, "watch": s4}

    s5 = sub.add_parser("help", help="Display help information")
    s5.add_argument("topic", nargs="?", help="Specific command to get help for")
    s5.set_defaults(func=lambda args: cmd_help(args, parsers))

    if len(sys.argv) == 1:
        p.print_help()
        sys.exit(0)

    args = p.parse_args()
    if hasattr(args, "func"):
        args.func(args)
    else:
        p.print_help()

if __name__ == "__main__":
    main()
