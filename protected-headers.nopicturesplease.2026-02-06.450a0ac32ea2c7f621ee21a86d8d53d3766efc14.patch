+static GPtrArray *extract_headers(FILE *fp)
+{
+	GPtrArray *headers, *external_headers;
+
+	cm_return_val_if_fail(fp != NULL, NULL);
+
+	headers = procheader_get_header_array(fp);
+
+	external_headers = g_ptr_array_new_with_free_func(procheader_header_free);
+
+	for (gint i = 0; i < headers->len; i++) {
+		Header *header = g_ptr_array_index(headers, i);
+		if (!procheader_header_is_internal(header->name)) {
+			Header *my_hdr = (Header *)g_ptr_array_steal_index(headers,i);
+			g_ptr_array_add(external_headers, my_hdr);
+		}
+	}
+
+	g_ptr_array_free(headers, TRUE);
+
+	return external_headers;
+}
+
+static gchar *extract_subject(MimeInfo *mimeinfo)
+{
+	FILE *fp;
+	gchar *subject = NULL;
+
+	if (mimeinfo->content == MIMECONTENT_MEM)
+		fp = str_open_as_stream(mimeinfo->data.mem);
+	else
+		fp = claws_fopen(mimeinfo->data.filename, "rb");
+	if (!fp) {
+		FILE_OP_ERROR(mimeinfo->data.filename, "claws_fopen");
+		return FALSE;
+	}
+	if (fseek(fp, mimeinfo->offset, SEEK_SET) < 0) {
+		FILE_OP_ERROR(mimeinfo->data.filename, "fseek");
+		claws_fclose(fp);
+		return FALSE;
+	}
+
+	GPtrArray *headers = extract_headers(fp);
+	if (headers) {
+		for (gint i = 0; i < headers->len; i++) {
+			Header *header = g_ptr_array_index(headers, i);
+			if (!strcmp(header->name, "Subject:")) {
+				subject = g_strdup(header->body);
+				break;
+			}
+		}
+		g_ptr_array_free(headers, TRUE);
+	}
+
+	claws_fclose(fp);
+
+	if(subject)
+		unfold_line(subject);
+
+	return subject;
+}
+
+gchar *procmsg_extract_subject(MimeInfo *mimeinfo)
+{
+	GNode *iter;
+	gchar *subject = extract_subject(mimeinfo);
+
+	g_message("extracting subject from mimeinfo %p", mimeinfo);
+	if(subject && strncmp(subject, "...", 3) != 0) {
+		g_message("extracted subject %s from mimeinfo %p", subject,mimeinfo);
+		return subject;
+	}
+	g_free(subject);
+
+	for (iter = g_node_first_child(mimeinfo->node) ; iter != NULL ;
+			iter = g_node_next_sibling(iter)) {
+		g_message("itrying next node: %p", iter->data);
+		subject = procmsg_extract_subject((MimeInfo *) iter->data);
+		if(subject && strncmp(subject, "...", 3) != 0)
+			return subject;
+		g_free(subject);
+	}
+
+	return NULL;
+}
