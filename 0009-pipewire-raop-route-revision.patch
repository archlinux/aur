+			RAOP_SAFETY_GATE_ADOPT_ROUTE_DENIED);
+	command.nonce = TEST_NONCE;
+	spa_assert_se(raop_safety_gate_validate_adopt_route(&gate, &command, 10) ==
+			RAOP_SAFETY_GATE_ADOPT_ROUTE_DENIED);
