+static void test_adopt_route_contract(void)
+{
+	struct raop_safety_gate gate;
+	struct raop_safety_gate_adopt_route_command command;
+	static const char valid[] =
+		"{\"command.id\":\"raop-safety-gate-hold-and-adopt-route\","
+		"\"nonce\":\"0123456789abcdef\","
+		"\"publication.generation\":\"9\","
+		"\"route.current-revision\":\"1\","
+		"\"route.revision\":\"2\"}";
