+static void safety_gate_adopt_route(struct impl *impl,
+		const struct raop_safety_gate_adopt_route_command *command)
+{
+	enum raop_safety_gate_adopt_route_result result;
+	int res;
+
+	result = raop_safety_gate_validate_adopt_route(&impl->safety_gate,
+			command, impl->publication_generation);
+	if (result == RAOP_SAFETY_GATE_ADOPT_ROUTE_STALE) {
+		pw_log_debug("ignoring stale RAOP Route revision %" PRIu64,
+				command->revision);
+		return;
+	}
+	if (result == RAOP_SAFETY_GATE_ADOPT_ROUTE_DENIED) {
+		pw_log_warn("denying RAOP Route revision %" PRIu64,
+				command->revision);
+		return;
+	}
+	if (result == RAOP_SAFETY_GATE_ADOPT_ROUTE_RETRY)
+		volume_route_adopt_complete(impl);
+	if (result == RAOP_SAFETY_GATE_ADOPT_ROUTE_ADVANCE) {
+		if ((res = safety_gate_close_and_drain(impl)) < 0) {
+			safety_gate_close_barrier_failed(impl,
+					RAOP_SAFETY_GATE_ACTIVATION,
+					"failed Route revision adoption", res);
+			return;
+		}
+		volume_route_adopt_begin(impl);
+		raop_safety_gate_commit_adopt_route(&impl->safety_gate, command);
+	}
+	if ((res = safety_gate_publish(impl)) < 0)
+		safety_gate_close_barrier_failed(impl, RAOP_SAFETY_GATE_ERROR,
+				"failed Route revision publication", res);
