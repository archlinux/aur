+			&command) == 0);
+	spa_assert_se(raop_safety_gate_validate_adopt_route(&gate, &command, 9) ==
+			RAOP_SAFETY_GATE_ADOPT_ROUTE_ADVANCE);
+	{
+		uint64_t before_sequence = gate.sequence;
+	raop_safety_gate_commit_adopt_route(&gate, &command);
+		spa_assert_se(gate.sequence == before_sequence + 1);
+		spa_assert_se((gate.reasons & RAOP_SAFETY_GATE_ACTIVATION) != 0);
+	}
+	/* An exact retry after a lost publication acknowledgement is idempotent. */
+	spa_assert_se(raop_safety_gate_validate_adopt_route(&gate, &command, 9) ==
+			RAOP_SAFETY_GATE_ADOPT_ROUTE_RETRY);
