+int raop_safety_gate_parse_adopt_route_command(const char *json,
+		struct raop_safety_gate_adopt_route_command *command)
+{
+	struct spa_json top, iter;
+	const char *object, *value;
+	char key[64], id[64], nonce[19], generation[32], current[32], next[32];
+	bool have_id = false, have_nonce = false, have_generation = false,
+		have_current = false, have_next = false, have_unknown = false;
+	int object_len, len;
+
+	if (json == NULL || command == NULL)
+		return -EINVAL;
+	spa_json_init(&top, json, strlen(json));
+	object_len = spa_json_next(&top, &object);
+	if (object_len <= 0 || !spa_json_is_object(object, object_len))
+		return -EINVAL;
+	object_len = spa_json_container_len(&top, object, object_len);
+	if (object_len <= 0 || spa_json_next(&top, &value) != 0 ||
+			spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+	while ((len = spa_json_object_next(&iter, key, sizeof(key), &value)) > 0) {
+		char *target = NULL;
+		size_t size = 0;
+		bool *present = NULL;
+
+		if (spa_streq(key, "command.id")) {
+			target = id; size = sizeof(id); present = &have_id;
+		} else if (spa_streq(key, "nonce")) {
+			target = nonce; size = sizeof(nonce); present = &have_nonce;
+		} else if (spa_streq(key, "publication.generation")) {
+			target = generation; size = sizeof(generation);
+			present = &have_generation;
+		} else if (spa_streq(key, "route.current-revision")) {
+			target = current; size = sizeof(current); present = &have_current;
+		} else if (spa_streq(key, "route.revision")) {
+			target = next; size = sizeof(next); present = &have_next;
+		} else {
+			have_unknown = true;
+			continue;
+		}
+		if (*present || !parse_string(value, len, target, size))
+			return -EINVAL;
+		*present = true;
+	}
+	if (len < 0 || !have_id)
+		return -EINVAL;
+	if (!spa_streq(id, RAOP_SAFETY_GATE_ADOPT_ROUTE_COMMAND))
+		return -ENOENT;
+	if (!have_nonce || !have_generation || !have_current || !have_next ||
+			have_unknown || !lowercase_hexadecimal_string(nonce) ||
+			!spa_atou64(nonce, &command->nonce, 16) ||
+			command->nonce == 0 || !decimal_string(generation) ||
+			!spa_atou64(generation, &command->publication_generation, 10) ||
+			command->publication_generation == 0 ||
+			!decimal_string(current) ||
+			!spa_atou64(current, &command->current_revision, 10) ||
+			command->current_revision == 0 || !decimal_string(next) ||
+			!spa_atou64(next, &command->revision, 10) ||
+			command->revision == 0)
+		return -EINVAL;
+	return 0;
+}
+
+enum raop_safety_gate_adopt_route_result
+raop_safety_gate_validate_adopt_route(
+		const struct raop_safety_gate *gate,
+		const struct raop_safety_gate_adopt_route_command *command,
+		uint64_t publication_generation)
+{
+	if (gate == NULL || command == NULL || command->nonce != gate->nonce ||
+			command->publication_generation != publication_generation)
+		return RAOP_SAFETY_GATE_ADOPT_ROUTE_DENIED;
+	if (command->revision == gate->route_revision)
+		return command->current_revision != UINT64_MAX &&
+				command->current_revision + 1 == command->revision ?
+			RAOP_SAFETY_GATE_ADOPT_ROUTE_RETRY :
+			RAOP_SAFETY_GATE_ADOPT_ROUTE_STALE;
+	if (gate->route_revision == UINT64_MAX ||
+			command->current_revision != gate->route_revision ||
+			command->revision != gate->route_revision + 1)
+		return RAOP_SAFETY_GATE_ADOPT_ROUTE_STALE;
+	return RAOP_SAFETY_GATE_ADOPT_ROUTE_ADVANCE;
+}
+
+void raop_safety_gate_commit_adopt_route(
+		struct raop_safety_gate *gate,
+		const struct raop_safety_gate_adopt_route_command *command)
+{
+	gate->route_revision = command->revision;
+	raop_safety_gate_invalidate(gate, RAOP_SAFETY_GATE_ACTIVATION);
+}
