# shellcheck shell=bash
# -*- sh -*-

post_install() {
  cat <<__EOT__
» Please notice that the opnk command has been renamed to openk.
»
» In order to take advantage of the Full-Text RSS Site Config,
» add the following line to your ~/.config/offpunk/offpunkrc:
»
» 	set ftr_site_config /usr/share/ftr-site-config
__EOT__
}

post_upgrade() {
  post_install "$@"
}

# eof
