post_install() {
	cat <<-'EOF'
		xTool Studio is installed in /usr/lib/xtool-studio.

		USB connection to the machine: the device exposes an RNDIS network
		gadget on 201.234.3.0/24 with its own DHCP server, but NetworkManager
		autocreates that link as link-local only. Enable DHCP once:

		  nmcli connection modify \
		    "$(nmcli -g GENERAL.CONNECTION device show <usb-interface>)" \
		    ipv4.method auto

		Wi-Fi needs no setup (device API on http://<machine-ip>:8080).

		Processing jobs requires Wine: the algorithm worker (toolpath
		generation) is a closed-source Windows binary, started transparently
		under Wine by /usr/lib/xtool-studio/resources/tools/algo-server/.
	EOF
}

post_upgrade() {
	post_install
}
