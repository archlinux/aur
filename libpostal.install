post_install() {
    echo ":: You need to download libpostal's trained data to"
    echo "   /var/lib/libpostal prior to using this library."
    echo "   libpostal_data download all /var/lib/libpostal"
}

post_upgrade() {
    echo ":: You might want to update libpostal's trained data."
    echo "   This can be done with the libpostal_data command, e.g.:"
    echo "   libpostal_data download all /var/lib/libpostal"
}

post_remove() {
    echo ":: You might still have libpostal's trained data in"
    echo "   /var/lib/libpostal (manually downloaded)."
    echo "   You can safely remove this directory."
}
