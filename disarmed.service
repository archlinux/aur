[Unit]
Description=disarmed VPN daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/disarmedd
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# TUN device requires these capabilities
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_RESOURCE

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateDevices=false
DeviceAllow=/dev/net/tun rw
ReadWritePaths=/etc/disarmed /var/run /dev/net

[Install]
WantedBy=multi-user.target
