#!/usr/bin/gawk -f
BEGIN {
	FS = ",";
	print "# brscan4-supported scanners (or interfaces of MFD)";
	print "";
}
NF >= 3 && $1 ~ /^0[xX][[:xdigit:]]+$/ {
    id = toupper( substr( $1, length($1) - 3 ));
	name = $4
	gsub("\"", "", name)
	print "# " name;
	print "usb:v04F9p" id "*";
	print " libsane_matched=yes";
	print "";
}
