post_install() {
    echo -e "\n\e[1;38;5;51m================================================================\e[0m"
    echo -e "\e[1;38;5;220m  AUR-SENTRY :: First AI-Based Pacman Security Agent Installed  \e[0m"
    echo -e "  \e[38;5;51mDeveloped by Arunachalam (Tamil Nadu, India)\e[0m"
    echo -e "\e[1;38;5;51m================================================================\e[0m\n"
    echo -e "  \e[1m1. Configure your Google Gemini API Key:\e[0m"
    echo -e "     \e[38;5;46maur-sentry --set-key \"YOUR_GEMINI_API_KEY\"\e[0m\n"
    echo -e "  \e[1m2. Enable in /etc/pacman.conf (optional):\e[0m"
    echo -e "     Add under \e[33m[options]\e[0m in \e[33m/etc/pacman.conf\e[0m:"
    echo -e "     \e[36mXferCommand = /usr/bin/arcxos-dl %u -o %o\e[0m  (Fast Visualizer)"
    echo -e "     \e[36mXferCommand = /usr/bin/aur-sentry %u -o %o\e[0m (Full AI Threat Shield)\n"
    echo -e "  \e[1m3. Test Security Scanner:\e[0m"
    echo -e "     \e[38;5;46maur-sentry \"neovim\" --scan-only\e[0m\n"
}

post_upgrade() {
    post_install
}
