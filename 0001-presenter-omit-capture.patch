+        }
+    }
+
+    return std::ranges::any_of(Desktop::fadingOutState()->fadeouts(),
+                               [monitor](const auto& fadeout) { return fadeout && fadeout->monitor() == monitor && fadeout->omitFromScreenShare(); });
+}
