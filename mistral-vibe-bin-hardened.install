post_install() {
  # Define colors for nice output
  local BLUE='\033[0;34m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local RED='\033[0;31m'
  local BOLD='\033[1m'
  local NC='\033[0m' # No Color

  echo -e ""
  echo -e "${BLUE}╔════════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║         ${BOLD}MISTRAL-VIBE-BIN-HARDENED - Installation Complete${NC}${BLUE}               ║${NC}"
  echo -e "${BLUE}╚════════════════════════════════════════════════════════════════════════════╝${NC}"
  echo -e ""

  # Check if AppArmor is installed and auto-configure
  if command -v apparmor_parser >/dev/null 2>&1; then
    echo -e "${GREEN}🛡️  AppArmor detected. Configuring security profile...${NC}"
    
    # Install the profile
    if cp /usr/share/apparmor/vibe.apparmor /etc/apparmor.d/vibe 2>/dev/null; then
      
      # Load the profile
      if apparmor_parser -r /etc/apparmor.d/vibe 2>/dev/null; then
        
        # Enforce the profile
        if aa-enforce /etc/apparmor.d/vibe 2>/dev/null; then
          echo -e "${GREEN}   ✓ Profile installed, loaded, and ENFORCED.${NC}"
          echo -e "${GREEN}   ✓ Mistral Vibe is now running under Mandatory Access Control.${NC}"
        else
          echo -e "${YELLOW}   ⚠️  Profile loaded but could not be enforced (aa-enforce failed).${NC}"
        fi
      else
        echo -e "${YELLOW}   ⚠️  Profile installed but could not be loaded (apparmor_parser failed).${NC}"
      fi
    else
      echo -e "${RED}   ❌ Could not install AppArmor profile to /etc/apparmor.d/${NC}"
    fi
  else
    echo -e "${YELLOW}⚠️  AppArmor NOT detected.${NC}"
    echo -e "   For maximum security, we strongly recommend installing AppArmor:"
    echo -e "   ${BOLD}sudo pacman -S apparmor${NC}"
    echo -e "   Then reinstall this package to auto-configure the profile."
  fi

  echo -e ""
  echo -e "${BOLD}🔒 SECURITY VERIFICATION:${NC}"
  echo -e "   You can verify the integrity of this installation by reading:"
  echo -e "   ${BLUE}/usr/share/doc/mistral-vibe-bin-hardened/SECURITY.md${NC}"
  echo -e ""
  echo -e "${BOLD}🔑 API KEY SETUP:${NC}"
  echo -e "   Before using Mistral Vibe, you need to configure your Mistral AI API key:"
  echo -e "   ${GREEN}vibe --setup${NC}"
  echo -e ""
  echo -e "${BOLD}🚀 USAGE:${NC}"
  echo -e "   Start the Mistral Vibe coding agent:"
  echo -e "   ${GREEN}vibe${NC}  or  ${GREEN}vibe-acp${NC}"
  echo -e ""
  echo -e "   Both commands are equivalent and launch the AI coding agent in ACP mode."
  echo -e ""
  echo -e "${BOLD}📚 DOCUMENTATION:${NC}"
  echo -e "   - Mistral Vibe GitHub: https://github.com/mistralai/mistral-vibe"
  echo -e "   - Security Docs: /usr/share/doc/mistral-vibe-bin-hardened/SECURITY.md"
  echo -e ""
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e ""
}

post_upgrade() {
  post_install
  
  echo -e "\033[1;33m⚠️  CONFIGURATION NOTE:\033[0m"
  echo -e "   Mistral Vibe stores configuration in ~/.config/mistral-vibe/"
  echo -e "   If you experience issues after upgrade, verify your API key:"
  echo -e "   ${BOLD}vibe --setup${NC}"
  echo -e ""
}

post_remove() {
  echo -e ""
  echo -e "\033[1;34m🧹 CLEANUP RECOMMENDATIONS:\033[0m"
  echo -e ""
  echo -e "   1. Remove AppArmor profile (if installed):"
  echo -e "      ${BOLD}sudo rm /etc/apparmor.d/vibe${NC}"
  echo -e "      ${BOLD}sudo systemctl reload apparmor${NC}"
  echo -e ""
  echo -e "   2. Remove user data (Optional):"
  echo -e "      ${BOLD}rm -rf ~/.config/mistral-vibe${NC}"
  echo -e "      ${BOLD}rm -rf ~/.mistral-vibe${NC}"
  echo -e "      ${BOLD}rm -rf ~/.cache/mistral-vibe${NC}"
  echo -e ""
  echo -e "   ${YELLOW}⚠️  WARNING: This will delete your Mistral AI API key configuration!${NC}"
  echo -e ""
}
