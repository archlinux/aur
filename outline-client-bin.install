
post_install() {
  # Grant specific capabilities so Outline can run without root permisssion
  #   - cap_net_admin: configure network interfaces, set up routing tables, etc.
  #   - cap_dac_override: modify network configuration files owned by root
  # Preserve the capabilities assigned by the original .deb package
  if ! /usr/bin/setcap cap_net_admin,cap_dac_override+eip /opt/outline-client/Outline; then
    echo "WARNING: Failed to set Outline capabilities." >&2
    echo "Outline networking functionality may not work correctly." >&2
  fi
}

post_upgrade() {
  post_install
}
