# mercury-browser-v3-bin.install
# Desktop and icon caches are updated by the usual alpm hooks; this file only warns about AVX2.

_check_avx2() {
  if [[ -r /proc/cpuinfo ]] && ! grep -qw avx2 /proc/cpuinfo; then
    echo "==> WARNING: mercury-browser-v3-bin is built for AVX2 / x86-64-v3."
    echo "    This CPU does not advertise avx2; the browser may crash on startup."
  fi
}

post_install() {
  _check_avx2
}

post_upgrade() {
  post_install
}
