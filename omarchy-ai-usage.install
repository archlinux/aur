post_install() {
    local user="${SUDO_USER:-$USER}"
    if [ "$user" != "root" ] && [ -n "$user" ]; then
        echo "  󰧑  Configuring Waybar for $user..."
        su "$user" -c "omarchy-ai-usage-setup" 2>/dev/null && return
    fi
    # Fallback if auto-setup fails
    cat <<EOF

  ═══════════════════════════════════════════════
  󰧑  omarchy-ai-usage installed!

  Run to configure Waybar:

    omarchy-ai-usage-setup
  ═══════════════════════════════════════════════

EOF
}

post_upgrade() {
    local user="${SUDO_USER:-$USER}"
    if [ "$user" != "root" ] && [ -n "$user" ]; then
        echo "  󰧑  Updating Waybar scripts for $user..."
        su "$user" -c "omarchy-ai-usage-setup" 2>/dev/null && return
    fi
    cat <<EOF

  ═══════════════════════════════════════════════
  󰧑  omarchy-ai-usage upgraded to $1

  Run to update scripts:

    omarchy-ai-usage-setup
  ═══════════════════════════════════════════════

EOF
}

post_remove() {
    local user="${SUDO_USER:-$USER}"
    if [ "$user" != "root" ] && [ -n "$user" ]; then
        echo "  󰧑  Cleaning up Waybar config for $user..."
        su "$user" -c "omarchy-ai-usage-remove" 2>/dev/null && return
    fi
    cat <<EOF

  ═══════════════════════════════════════════════
  󰧑  omarchy-ai-usage removed

  Run to clean up:

    omarchy-ai-usage-remove
  ═══════════════════════════════════════════════

EOF
}
