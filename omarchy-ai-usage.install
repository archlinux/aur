post_install() {
    local user="${SUDO_USER:-}"
    [ -z "$user" ] && user=$(logname 2>/dev/null)
    [ -z "$user" ] || [ "$user" = "root" ] && user=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd)
    
    if [ -n "$user" ] && [ "$user" != "root" ]; then
        echo "  󰧑  Configuring waybar for user: $user"
        su "$user" -c "/usr/bin/omarchy-ai-usage-setup"
    fi
}

post_upgrade() {
    post_install
}

post_remove() {
    local user="${SUDO_USER:-}"
    [ -z "$user" ] && user=$(logname 2>/dev/null)
    [ -z "$user" ] || [ "$user" = "root" ] && user=$(awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }' /etc/passwd)
    
    if [ -n "$user" ] && [ "$user" != "root" ]; then
        echo "  󰧑  Cleaning up waybar for user: $user"
        su "$user" -c "/usr/bin/omarchy-ai-usage-remove"
    fi
}
