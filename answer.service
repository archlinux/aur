[Unit]
Description=running answer daemon
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
# 'setcap CAP_NET_BIND_SERVICE=+ep' is to allow non-root user binding port within 1-1024
ExecStart=bash -c 'setcap CAP_NET_BIND_SERVICE=+ep /usr/bin/answer; if [[ -f "/var/lib/answer/data/conf/config.yaml" ]]; then sudo -u answer /usr/bin/answer run; else sudo -u answer /usr/bin/answer init ;fi'
ExecStop=

[Install]
WantedBy=multi-user.target