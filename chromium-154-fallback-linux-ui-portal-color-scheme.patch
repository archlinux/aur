-void FallbackLinuxUi::SetColorScheme(std::optional<bool> prefer_dark) {}
+void FallbackLinuxUi::SetColorScheme(std::optional<bool> prefer_dark) {
+  if (!os_settings_provider_) {
+    if (!prefer_dark) {
+      return;
+    }
+    os_settings_provider_ = std::make_unique<PortalOsSettingsProvider>();
+  }
+  os_settings_provider_->SetColorScheme(prefer_dark);
+}
+
+ui::NativeTheme::PreferredColorScheme
+FallbackLinuxUi::PortalOsSettingsProvider::PreferredColorScheme() const {
+  if (prefer_dark_) {
+    return *prefer_dark_ ? ui::NativeTheme::PreferredColorScheme::kDark
+                         : ui::NativeTheme::PreferredColorScheme::kLight;
+  }
+  return OsSettingsProvider::PreferredColorScheme();
+}
+
+void FallbackLinuxUi::PortalOsSettingsProvider::SetColorScheme(
+    std::optional<bool> prefer_dark) {
+  if (prefer_dark_ == prefer_dark) {
+    return;
+  }
+  prefer_dark_ = prefer_dark;
+  NotifyOnSettingsChanged();
+}
 
