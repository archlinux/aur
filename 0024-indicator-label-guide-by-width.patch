-//NOTE: the panel reserves room for the guide, so digits are masked to keep the
-//width steady, and the widest guide seen is kept so the item never shrinks back
+//NOTE: the panel reserves room for the guide, so digits are masked as '0' and
+//every integer part gets at least 3 of them: 5% and 100% take the same room
+//from the first update
+static gchar *
+label_mask (const gchar *text)
+{
+	GString *buf = g_string_new(NULL);
+	const gchar *p;
+	gsize len;
+
+	for (p=text; *p != '\0'; p++) {
+		if (g_ascii_isdigit(*p) && (p == text || strchr("0123456789.,", p[-1]) == NULL)) {
+			for (len=strspn(p, "0123456789"); len < 3; len++)
+				g_string_append_c(buf, '0');
+		}
+		g_string_append_c(buf, g_ascii_isdigit(*p) ? '0' : *p);
+	}
+
+	return g_string_free(buf, FALSE);
+}
+
+//NOTE: pixels, in this process's font. The byte length says nothing about the
+//width: "0.0 KiB/s" holds a 2 byte no-break space, it is longer in bytes than
+//"000 bytes/s" and narrower
+static gint
+label_width (const gchar *text)
+{
+	PangoLayout *layout = gtk_widget_create_pango_layout(offscr, text);
+	gint width;
+
+	pango_layout_get_pixel_size(layout, &width, NULL);
+	g_object_unref(layout);
+
+	return width;
+}
+
+//NOTE: a wider text widens the guide, and the guide never gets narrower,
+//otherwise the tray item grows and shrinks back with the text
 static void
-label_set (AppIndicator *ind, const gchar *text, gchar *guide, size_t guide_size)
+label_set (AppIndicator *ind, const gchar *text, gchar **guide)
 {
-	gchar buf[128];
-	guint i;
+	gchar *mask;
 
 	if (ind == NULL)
 		return;
 
-	g_strlcpy(buf, text, sizeof(buf));
-	for (i=0; buf[i] != '\0'; i++) {
-		if (g_ascii_isdigit(buf[i]))
-			buf[i] = '0';
+	mask = label_mask(text);
+	if (*guide == NULL || label_width(mask) > label_width(*guide)) {
+		g_free(*guide);
+		*guide = mask;
+	} else {
+		g_free(mask);
 	}
-	if (strlen(buf) > strlen(guide))
-		g_strlcpy(guide, buf, guide_size);
 
-	app_indicator_set_label (ind, text, guide);
+	app_indicator_set_label (ind, text, *guide);
 }
 
