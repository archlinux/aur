+clone_packaged_repo() (
+    local package_patch="${BASH_SOURCE[0]%/*}/runtime-policy.patch"
+    if [[ ! "$INSTALL_COMMIT" =~ ^[0-9a-fA-F]{40}$ ]] || [ ! -r "$package_patch" ]; then
+        fail "The desktop package requires a full commit pin and runtime-policy.patch." missing_dependency
+    fi
+    package_patch=$(realpath "$package_patch")
+    if [ ! -e "$INSTALL_DIR" ]; then
+        git init -q "$INSTALL_DIR" || return 1
+        git -C "$INSTALL_DIR" remote add origin "$REPO_URL" || return 1
+    fi
+    if [ ! -d "$INSTALL_DIR/.git" ]; then
+        fail "Not a standalone Git checkout: $INSTALL_DIR. Nothing was overwritten." dir_not_checkout
+    fi
+    cd "$INSTALL_DIR" || return 1
+    local previous_commit old_patch_applied=false
+    local record="$PWD/.git/hermes-desktop-runtime.patch"
+    previous_commit=$(git rev-parse --verify HEAD 2>/dev/null) || previous_commit=""
+    if [ -f "$record" ]; then
+        if git apply --reverse --check "$record" 2>/dev/null; then
+            old_patch_applied=true
+        elif ! git diff --quiet; then
+            fail "Local edits conflict with the previous desktop patch. Resolve them before retrying." local_changes_blocked
+        fi
+    fi
+    if [ "$previous_commit" = "$INSTALL_COMMIT" ] && [ "$old_patch_applied" = true ] && cmp -s "$record" "$package_patch"; then
+        return 0
+    fi
+    git diff --cached --quiet || fail "Staged changes found; leaving the checkout unchanged." local_changes_blocked
+    git cat-file -e "$INSTALL_COMMIT^{commit}" 2>/dev/null || git fetch --depth 1 "$REPO_URL" "$INSTALL_COMMIT" || return 1
+
+    # Validate both the user's work and the new patch in a temporary index.
+    local temporary_index
+    temporary_index=$(mktemp "$PWD/.git/hermes-desktop-index.XXXXXX") || return 1
+    trap 'rm -f "$temporary_index" "$temporary_index.lock"' EXIT
+    if ! (
+        export GIT_INDEX_FILE="$temporary_index"
+        if [ -n "$previous_commit" ]; then
+            git read-tree "$previous_commit" && git add -u || exit 1
+            if [ "$old_patch_applied" = true ]; then git apply --cached --reverse "$record" || exit 1; fi
+            git diff --cached --quiet "$previous_commit" || exit 1
+        fi
+        git read-tree "$INSTALL_COMMIT" && git apply --cached "$package_patch"
+    ); then
+        fail "Local edits or an incompatible desktop patch prevent this update. Nothing was overwritten." local_changes_blocked
+    fi
+    if [ "$old_patch_applied" = true ]; then git apply --reverse "$record" || return 1; fi
+    if ! git checkout --no-overwrite-ignore --detach "$INSTALL_COMMIT"; then
+        if [ "$old_patch_applied" = true ]; then git apply "$record"; fi
+        return 1
+    fi
+    if ! git apply "$package_patch"; then
+        if [ -n "$previous_commit" ] && git checkout --no-overwrite-ignore --detach "$previous_commit"; then
+            if [ "$old_patch_applied" = true ]; then git apply "$record"; fi
+        fi
+        return 1
+    fi
+    cp "$package_patch" "$record.tmp" && mv "$record.tmp" "$record" || return 1
+    log_success "Repository ready at the desktop package commit"
+)
