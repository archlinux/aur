+
+/// Reports whether `token` is parked in the `PRINT_JOBS` cache, without claiming it.
+///
+/// `Print` uses this to tell the two flows apart: a cached token means the
+/// application went through `PreparePrint`, while an unknown or absent token
+/// means it expects the dialog to be shown at print time.
+pub struct PrintTokenProbe {
+    pub token: u32,
+}
+
+impl PrintTokenProbe {
+    pub async fn run(self, proxy: &UiProxy) -> Result<bool, UiError> {
+        crate::gui::run_ui_task(
+            proxy,
+            move |send, _, _| {
+                let exists = PRINT_JOBS.with(|jobs| jobs.borrow().contains_key(&self.token));
+                let _ = send.dispatch(Ok(exists));
+            },
+            || UiError::Closed,
+        )
+        .await
     }
 }
 
