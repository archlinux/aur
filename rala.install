post_install() {
    cat <<'EOF'
  Configure rala in /etc/rala/config.toml.
  Set domain and clone_prefix, then create your first account:
    sudo -u rala rala create user alice --config /etc/rala/config.toml

  Enable and start the service:
    sudo systemctl enable --now rala.service
EOF
}

post_upgrade() {
    post_install
}
