# Апстримовские preinst/prerm в .deb не делают ничего, кроме остановки
# запущенного ядра плагина перед установкой/удалением - воспроизводим то же
# самое. Шаблон поиска взят оттуда же (полный путь, чтобы не зацепить чужой
# процесс с похожим именем).
_stop_plugin() {
    local pattern='^/opt/iitrust/gosuslugi_plugin/bin/gosuslugi_plugin'
    local sig
    pgrep -f "$pattern" >/dev/null 2>&1 || return 0
    echo "  Останавливаю запущенное ядро Госплагина..."
    for sig in INT TERM KILL; do
        pgrep -f "$pattern" >/dev/null 2>&1 || return 0
        pkill --signal "$sig" -f "$pattern" >/dev/null 2>&1
        sleep 1
    done
}

pre_install() {
    _stop_plugin
}

pre_upgrade() {
    _stop_plugin
}

pre_remove() {
    _stop_plugin
}

post_install() {
    cat <<'EOF'

  Госплагин (локальный модуль) установлен в /opt/iitrust/gosuslugi_plugin.

  Чтобы он заработал, нужны ещё две вещи:

  1. Расширение браузера "Госплагин":
       Chrome / Chromium / Яндекс.Браузер / Vivaldi:
         https://chromewebstore.google.com/detail/jabjbhgjaidecageckilhonbggakppme
       Firefox:
         https://addons.mozilla.org/ru/firefox/addon/%D0%B3%D0%BE%D1%81%D0%BF%D0%BB%D0%B0%D0%B3%D0%B8%D0%BD/
     Браузер нужно перезапустить - манифесты native messaging host читаются
     только при старте.

  2. Для USB-токенов и смарт-карт (Рутокен, JaCarta и т.п.) - служба pcscd:
       sudo systemctl enable --now pcscd.socket

EOF
}

post_upgrade() {
    echo "  Перезапустите браузер, чтобы он подхватил обновлённый модуль Госплагина."
}
