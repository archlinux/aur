#!/bin/bash

post_install() {
    echo 
    echo "Caelestia GIF manager has been installed successfully!"
    echo "IMPORTANT: Please run the following command to finalize the setup:"
    echo "  caelestia-gif --init"
    echo
    echo "For more information, visit: https://gitlab.com/gnoooo/caelestia-gif/-/blob/master/README.md#what-is---init"
}
