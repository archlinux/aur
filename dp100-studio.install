post_install() {
  cat <<'MSG'
==> DP100 Studio installs a udev rule (70-dp100.rules) that lets the logged-in
    user open the DP100. It applies to devices connected after it loads, so
    unplug the DP100 and plug it back in, then double-tap ◀ on its panel to
    put it in USBD mode.
MSG
}

post_upgrade() {
  :
}
