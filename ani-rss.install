PKGNAME=ani-rss
USER=$PKGNAME

migrate_from_v1() {
  echo "coping '/var/lib/${PKGNAME}/config/ani.json' to '/var/lib/${PKGNAME}/config/ani.v2.json'"
  cp "/var/lib/${PKGNAME}/config/ani.json" "/var/lib/${PKGNAME}/config/ani.v2.json"

  echo "coping '/var/lib/${PKGNAME}/config/config.json' to '/var/lib/${PKGNAME}/config/config.v2.json'"
  cp "/var/lib/${PKGNAME}/config/config.json" "/var/lib/${PKGNAME}/config/config.v2.json"

  echo "replacing with 's|backRssList|standbyRssList|g' in '/var/lib/${PKGNAME}/config/ani.v2.json'"
  sed 's|backRssList|standbyRssList|g' -i "/var/lib/${PKGNAME}/config/ani.v2.json"

  echo "unlinking '/etc/${PKGNAME}/config.json'"
  unlink "/etc/${PKGNAME}/config.json"
}

link_config() {
  ln -f "/var/lib/${PKGNAME}/config/config.v2.json" "/etc/${PKGNAME}/config.v2.json"
}
link_log() {
  ln -sf "/var/log/${PKGNAME}" "/var/lib/${PKGNAME}/config/logs"
  chown $USER: "/var/lib/${PKGNAME}/config/logs" "/var/log/${PKGNAME}"
}

## arg 1:  the new package version
post_install() {
  if ! id -u ${PKGNAME} > /dev/null 2>&1; then
    useradd --system --shell '/usr/bin/nologin' --create-home --home-dir "/var/lib/${PKGNAME}" $USER
  fi
  mkdir "/var/lib/${PKGNAME}/config"
  chown --recursive $USER: "/var/lib/${PKGNAME}" "/etc/${PKGNAME}"
  link_config
  link_log
}

## arg 1:  the new package version
## arg 2:  the old package version
post_upgrade() {
  [ ! -f "/var/lib/${PKGNAME}/config/ani.json" ] && migrate_from_v1
  link_config
  link_log
}


