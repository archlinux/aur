post_install() {
  echo "=========================================================================="
  echo "  OpenCode Qwen OAuth Plugin Installed"
  echo "=========================================================================="
  echo ""
  echo "To enable this plugin, add it to your opencode configuration file"
  echo "(e.g., ~/.config/opencode/opencode.json):"
  echo ""
  echo '  {'
  echo '    "plugin": ["opencode-qwencode-oauth"],'
  echo '    "provider": {'
  echo '      "qwen": {'
  echo '        "npm": "@ai-sdk/openai",'
  echo '        "options": {'
  echo '          "baseURL": "https://portal.qwen.ai/v1",'
  echo '          "compatibility": "strict"'
  echo '        }'
  echo '      }'
  echo '    }'
  echo '  }'
  echo ""
  echo "Then run '/connect' in opencode to authenticate."
  echo "=========================================================================="
}

post_upgrade() {
  post_install
}