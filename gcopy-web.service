[Unit]
Description=Gcopy frontend
Wants=network-online.target gcopy.service
After=network-online.target gcopy.service
Requires=gcopy.service

[Service]
User=gcopy
Restart=on-failure
EnvironmentFile=-/etc/gcopy/gcopy-web.env
ExecStart=/usr/bin/node /usr/lib/gcopy/server.js
TimeoutStopSec=5
SyslogIdentifier=gcopy-web

[Install]
WantedBy=multi-user.target
