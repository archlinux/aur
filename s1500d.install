post_install() {
    if [[ -f /usr/lib/sysusers.d/s1500d.conf ]]; then
        systemd-sysusers s1500d.conf >/dev/null 2>&1 || true
    fi
    udevadm control --reload-rules >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    echo '==> s1500d installed.'
    echo '    1. Edit /etc/s1500d/config.toml to set your handler path and profiles.'
    echo '    2. Verify the scanner in the foreground: s1500d --doctor'
    echo '    3. After verification, enable the service: systemctl enable --now s1500d'
    echo '    See /usr/share/s1500d/ for example handler scripts.'
}

post_upgrade() {
    post_install
    echo '==> If s1500d is active, restart it after reviewing the new configuration.'
}
