From 9e79b0e9fbb061f19bc9d69ef77a5076d78dd59a Mon Sep 17 00:00:00 2001
From: xAsh <xash@riseup.net>
Date: Tue, 11 Aug 2026 21:06:56 +0200
Subject: [PATCH] Restore --path game directory option

---
 launcher/launcher/launcher.cli                |  7 +++
 launcher/launcher/launcher.cxx                | 49 +++++++++++++++++--
 .../launcher/launcher-options.cxx             | 17 +++++++
 .../launcher/launcher-options.hxx             |  8 +++
 .../launcher/launcher-options.ixx             | 12 +++++
 5 files changed, 90 insertions(+), 3 deletions(-)

diff --git a/launcher/launcher/launcher.cli b/launcher/launcher/launcher.cli
index c77d707..749c0af 100644
--- a/launcher/launcher/launcher.cli
+++ b/launcher/launcher/launcher.cli
@@ -25,6 +25,13 @@ namespace launcher
 
     // Common options.
     //
+    std::string --path
+    {
+      "<dir>",
+      "The installation directory for the game files. If not specified, the
+       launcher executable's directory is used."
+    };
+
     bool --prerelease
     {
       "Opt-in to pre-release (beta) updates. Use this to test upcoming
diff --git a/launcher/launcher/launcher.cxx b/launcher/launcher/launcher.cxx
index 8271ab7..8d5babf 100644
--- a/launcher/launcher/launcher.cxx
+++ b/launcher/launcher/launcher.cxx
@@ -1026,8 +1026,47 @@ try
   }
 #endif
 
+  // Resolve a relative --path from the directory in which the launcher was
+  // invoked, before reanchor_cwd() changes the working directory.
+  //
+  path requested_root;
+
+  if (opt.path_specified ())
+  {
+    requested_root = from_utf8 (opt.path ());
+
+    if (requested_root.empty ())
+      throw invalid_argument ("--path cannot be empty");
+
+    error_code ec;
+    requested_root = absolute (requested_root, ec);
+
+    if (ec)
+      throw system_error (ec,
+                          "failed to resolve installation root: " +
+                            to_utf8 (requested_root));
+  }
+
   reanchor_cwd ();
 
+  if (!requested_root.empty ())
+  {
+    error_code ec;
+    requested_root = canonical (requested_root, ec);
+
+    if (ec)
+      throw system_error (ec,
+                          "failed to canonicalize installation root: " +
+                            to_utf8 (requested_root));
+
+    current_path (requested_root, ec);
+
+    if (ec)
+      throw system_error (ec,
+                          "failed to change to installation root: " +
+                            to_utf8 (requested_root));
+  }
+
   {
     error_code ec;
     create_directories (path ("cache"), ec);
@@ -1076,8 +1115,8 @@ try
       return 0;
   }
 
-  // The installation root is the current working directory (which
-  // reanchor_cwd() has already set to the launcher binary's directory).
+  // The installation root is the current working directory, set above from
+  // --path when specified or to the launcher binary's directory otherwise.
   //
   path root (current_path ());
 
@@ -1171,7 +1210,11 @@ try
       co_await sync_dlc (io, hc, dc, pc, cc, root);
 
 #ifdef __linux__
-      co_await sync_helper (io, gh, dc, pc, cc, root, true);
+      if (!opt.path_specified () || !opt.skip_launch ())
+        co_await sync_helper (io, gh, dc, pc, cc, root, true);
+      else
+        info ("skipping linux steam helper synchronization "
+              "(--path with --skip-launch)");
 #endif
     }(),
       [&io, &sync_ex] (exception_ptr ep)
