@@ -38,6 +38,22 @@ if test -n "$PKG_CONFIG" && test "x$enable_lockdev" = xyes; then
 	PKG_CHECK_MODULES([LOCKDEV], [lockdev], AC_DEFINE([HAVE_LOCKDEV],[1],[Define if you have lockdev]),[:])
