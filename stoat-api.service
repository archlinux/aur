[Unit]
Description=Stoat.chat API
Wants=network-online.target mongodb.service valkey.service rabbitmq.service
After=network-online.target mongodb.service valkey.service rabbitmq.service
RequiresMountsFor=/etc/stoat
StartLimitIntervalSec=0

[Service]
Type=exec
User=stoat
Group=stoat
WorkingDirectory=/etc/stoat/
ExecStart=/usr/bin/revolt-delta
ExecStartPost=/usr/lib/stoat/wait-api
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10s
TimeoutStartSec=15min

# Hardening
ProtectSystem=yes
PrivateTmp=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
