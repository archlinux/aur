[Unit]
Description=Stoat.chat API
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/etc/stoat
# Allow expected 10-second restarts while limiting unusually fast crash loops.
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=exec
User=stoat
Group=stoat
WorkingDirectory=/etc/stoat
ExecStart=/usr/bin/revolt-delta
ExecStartPost=/usr/lib/stoat/wait-api
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=10s
TimeoutStartSec=15min
UMask=0077

# Hardening
ProtectSystem=yes
PrivateTmp=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
