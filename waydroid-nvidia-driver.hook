# waydroid-nvidia: the nvidia-prolapse vendor image is gated on, and pinned to, the NVIDIA kernel module it ran on.
# After a driver update the container refuses to start with the new module until the setup re-gates it.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = nvidia-utils
Target = nvidia-open
Target = nvidia-open-dkms
Target = nvidia-open-lts
Target = nvidia
Target = nvidia-dkms
Target = nvidia-lts
# AUR driver branches (names checked against the AUR RPC on 2026-10-25): the 580 legacy branch for
# Maxwell/Pascal/Volta, and the beta branch. Explicit names, not a glob: nvidia* would also match
# nvidia-settings, nvidia-prime and the like, which do not change the kernel module.
Target = nvidia-580xx-utils
Target = nvidia-580xx-dkms
Target = nvidia-utils-beta
Target = nvidia-beta
Target = nvidia-beta-dkms
Target = nvidia-open-beta
Target = nvidia-open-beta-dkms

[Action]
Description = Checking the waydroid-nvidia driver mode...
When = PostTransaction
Exec = /usr/lib/waydroid-nvidia/driver-update-note
