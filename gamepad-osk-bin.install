post_install() {
  echo ""
  echo "==> gamepad-osk installed!"
  echo ""
  echo "  Quick start:  gamepad-osk"
  echo "  Config:       ~/.config/gamepad-osk/config (auto-created on first run)"
  echo "  All options:  gamepad-osk --help"
  echo ""
  echo "  Systemd user service:"
  echo "    systemctl --user enable --now gamepad-osk"
  echo ""
  echo "  Toggle visibility:  gamepad-osk --toggle"
  echo "  Toggle combo:       Set toggle_combo in config (e.g. guide+a) for built-in show/hide"
  echo ""
  echo ":: Your user must be in the 'input' group for gamepad access:"
  echo "   sudo usermod -aG input \$USER"
  echo ":: Log out and back in for the group change to take effect."
  echo ""
}

post_upgrade() {
  post_install
}
