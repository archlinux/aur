# Be sure to use `systemctl edit profilarr` to modify this service with an
# override.conf because direct changes will be overwritten by package updates.
#
# A user per service with shared group setup would have an override like:
# [Service]
# Group=sharedgroupname
# UMask=002
#
# If your media directory is in /home (it shouldn't be)
# You will need to have an override like:
# [Service]
# PrivateUsers=false
# ProtectHome=false
#
# When running profilarr in LXC:
# [Service]
# PrivateUsers=false

[Unit]
Description=Configuration Management Platform for Radarr/Sonarr
Wants=network-online.target
After=network-online.target

[Service]
User=profilarr
Group=profilarr
ExecStart=/usr/share/webapps/profilarr/profilarr
KillMode=process
EnvironmentFile=/etc/profilarr/profilarr.env
PIDFile=/run/profilarr/profilarr.pid
SyslogIdentifier=profilarr
WorkingDirectory=/usr/share/webapps/profilarr
ReadWritePaths=/var/lib/profilarr/
Restart=on-failure
RestartSec=5

# Hardening
CapabilityBoundingSet=CAP_CHOWN CAP_FSETID CAP_SETGID
LockPersonality=true
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=full
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
SocketBindAllow=ipv4:tcp
SocketBindAllow=ipv6:tcp
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
