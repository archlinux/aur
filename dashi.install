post_install() {
    /usr/bin/udevadm control --reload || true
    /usr/bin/udevadm trigger || true
    /usr/bin/systemctl try-reload-or-restart polkit.service 2>/dev/null || true

    printf '%s\n\n' "Dashi installed to /usr/bin/dashi"
    printf '%s\n' "If brightness/bluetooth is not functional immediately, restart your system."
    printf '%s\n\n' "To enable basic functionality, add your user to the wheel group:"
    printf '  %s\n\n' "sudo usermod -aG wheel \$USER"
}

