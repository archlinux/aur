From: Andreas Schneider <asn@cryptomilk.org>
Date: Mon, 3 Nov 2025 16:37:46 +0100
Subject: [PATCH 11/15] chore(auth): Rename KerberosAuthenticationHandler to
 GSSAPIAuthenticationHandler

---
 src/cepces/auth.py   | 4 ++--
 src/cepces/config.py | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/cepces/auth.py b/src/cepces/auth.py
index b3a5e32..cf7323b 100644
--- a/src/cepces/auth.py
+++ b/src/cepces/auth.py
@@ -50,8 +50,8 @@ class AnonymousAuthenticationHandler(AuthenticationHandler):
         return SOAPAuth.AnonymousAuthentication()
 
 
-class KerberosAuthenticationHandler(AuthenticationHandler):
-    """Kerberos Authentication Handler"""
+class GSSAPIAuthenticationHandler(AuthenticationHandler):
+    """GSSAPI Authentication Handler"""
 
     def handle(self):
         parser = self._parser
diff --git a/src/cepces/config.py b/src/cepces/config.py
index 0f29fde..9df28b3 100644
--- a/src/cepces/config.py
+++ b/src/cepces/config.py
@@ -43,7 +43,7 @@ class Configuration(Base):
 
     AUTH_HANDLER_MAP = {
         "Anonymous": CoreAuth.AnonymousAuthenticationHandler,
-        "Kerberos": CoreAuth.KerberosAuthenticationHandler,
+        "Kerberos": CoreAuth.GSSAPIAuthenticationHandler,
         "UsernamePassword": CoreAuth.UsernamePasswordAuthenticationHandler,
         "Certificate": CoreAuth.CertificateAuthenticationHandler,
     }
