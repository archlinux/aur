post_install() {
  cat <<'EOF'
==> Arm Toolchain for Embedded (ATfE) was installed to /opt/atfe.

    To use it, add its bin directory to your PATH, e.g.:

      export PATH="/opt/atfe/bin:$PATH"

    Usage examples:

      clang --target=arm-none-eabi -mcpu=cortex-m4 ...
      clang --target=aarch64-none-elf ...

    Note: /opt/atfe/bin provides unprefixed clang/llvm/lld binaries, so
    adding it to PATH will shadow the system toolchain in that shell.
    Consider doing this only in embedded project shells.
EOF
}

post_upgrade() {
  post_install
}
