post_install() {
  echo -e "\nRackpeek does not provide a way to configure the config path yet."
  echo "You'll need to create a config/config.yaml in the directory where you want to use the app"
  echo
  echo "Example:"
  echo '$ mkdir -p ~/inventory/config'
  echo '$ cd ~/inventory'
  echo '$ touch config/config.yaml'
  echo '$ rackpeek -v'
  echo
}
