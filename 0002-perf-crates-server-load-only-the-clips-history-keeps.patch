+    /// Rewrites the clips file so that it holds exactly `records`, then drops
+    /// every image file that is no longer referenced.
+    async fn compact(&mut self, records: &[model::v2::ClipboardValue]) -> Result<(), Error> {
+        let clips_file_path = self.clips_file_path();
+        let staging_file_path = clips_file_path.with_extension("compacting");
+
+        let mut buffer = Vec::new();
+        for record in records {
+            bincode::serialize_into(&mut buffer, record).context(error::SeriailizeClipSnafu)?;
+        }
