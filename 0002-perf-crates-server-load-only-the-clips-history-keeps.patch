+    async fn test_loaded_images_stay_in_the_store_until_they_are_asked_for() {
+        let dir = TestDir::new("deferred-image");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        let clip = image_clip(7, 1);
+        driver.put(&clip).await.unwrap();
+
+        let clips = driver.load(10).await.unwrap();
+        assert_eq!(clips.len(), 1);
+
+        // Everything a clip is listed by is known without the image being read.
+        let loaded = &clips[0];
+        assert!(loaded.is_image_deferred());
+        assert_eq!(loaded.sha256_digest(), clip.sha256_digest());
+        assert_eq!(loaded.id(), clip.id());
+        assert_eq!(loaded.timestamp(), clip.timestamp());
+        assert_eq!(loaded.mime(), clip.mime());
+        assert_eq!(loaded.len(), clip.len());
+        assert!(loaded.to_clipboard_content().is_err());
+
+        // Reading the image back yields exactly the pixels that were stored.
+        let png = ImageStore::new(dir.path()).load(loaded.sha256_digest()).unwrap();
+        let loaded = loaded.clone().with_image(png);
+        assert!(!loaded.is_image_deferred());
+        assert_eq!(loaded.sha256_digest(), clip.sha256_digest());
+        assert_eq!(loaded.to_clipboard_content().unwrap(), clip.to_clipboard_content().unwrap());
+    }
+
+    #[tokio::test]
+    async fn test_image_store_reports_a_missing_image() {
+        let dir = TestDir::new("missing-image");
+        let _driver = FileSystemDriver::new(dir.path()).await.unwrap();
+
+        assert!(ImageStore::new(dir.path()).load(&[0xAB; 32]).is_none());
+    }
+
+    #[tokio::test]
+    async fn test_storing_the_same_image_twice_writes_one_file() {
+        let dir = TestDir::new("content-addressed");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        driver.put(&image_clip(3, 2)).await.unwrap();
+        driver.put(&image_clip(3, 1)).await.unwrap();
+
+        assert_eq!(dir.image_count(), 1);
+    }
+
+    #[tokio::test]
+    async fn test_load_compacts_the_store_and_drops_orphan_images() {
+        let dir = TestDir::new("compaction");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        for seed in 0..8u8 {
+            driver.put(&image_clip(seed, i64::from(100 - seed))).await.unwrap();
+        }
+        assert_eq!(dir.image_count(), 8);
+        let stored_len = dir.clips_len();
+
+        let clips = driver.load(3).await.unwrap();
+        assert_eq!(clips.len(), 3);
+        assert_eq!(dir.image_count(), 3, "images no longer referenced must be removed");
+        assert!(dir.clips_len() < stored_len, "the clips file must be rewritten");
+
+        // A second load of the compacted store returns the very same clips.
+        let mut reloaded = driver.load(3).await.unwrap();
+        reloaded.sort_unstable();
+        let mut clips = clips;
+        clips.sort_unstable();
+        assert_eq!(reloaded, clips);
+    }
+
+    #[tokio::test]
+    async fn test_save_restores_image_files_dropped_by_compaction() {
+        let dir = TestDir::new("save-after-compaction");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        let clips = (0..3u8).map(|seed| image_clip(seed, i64::from(10 - seed))).collect::<Vec<_>>();
+        for clip in &clips {
+            driver.put(clip).await.unwrap();
+        }
+
+        assert_eq!(driver.load(1).await.unwrap().len(), 1);
+        assert_eq!(dir.image_count(), 1, "compaction drops the images it no longer references");
+
+        // Saving clips whose image files are gone must write them out again.
+        driver.save(&clips).await.unwrap();
+        assert_eq!(dir.image_count(), 3);
+
+        let store = ImageStore::new(dir.path());
+        let mut reloaded = driver.load(3).await.unwrap();
+        reloaded.sort_unstable();
+        let mut clips = clips;
+        clips.sort_unstable();
+        assert_eq!(reloaded.len(), clips.len());
+        for (reloaded, clip) in reloaded.iter().zip(clips.iter()) {
+            assert_eq!(reloaded.sha256_digest(), clip.sha256_digest());
+            let reloaded =
+                reloaded.clone().with_image(store.load(reloaded.sha256_digest()).unwrap());
+            assert_eq!(
+                reloaded.to_clipboard_content().unwrap(),
+                clip.to_clipboard_content().unwrap()
+            );
+        }
+    }
+
+    #[tokio::test]
+    async fn test_duplicated_clips_collapse_into_one_entry() {
+        let dir = TestDir::new("duplicates");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        for seconds_ago in (1..=5i64).rev() {
+            driver.put(&text_clip("same", seconds_ago)).await.unwrap();
+        }
+
+        let clips = driver.load(5).await.unwrap();
+        assert_eq!(clips.len(), 1);
+        assert_eq!(clips[0].as_utf8_string(), "same");
+    }
+
+    #[tokio::test]
+    async fn test_shrink_to_keeps_the_newest_clips() {
+        let dir = TestDir::new("shrink");
+        let mut driver = FileSystemDriver::new(dir.path()).await.unwrap();
+        for i in 0..6i64 {
+            driver.put(&text_clip(&format!("clip-{i}"), 50 - i)).await.unwrap();
+        }
+
+        driver.shrink_to(2).await.unwrap();
+
+        let mut previews = driver
+            .load(10)
+            .await
+            .unwrap()
+            .iter()
+            .map(ClipEntry::as_utf8_string)
+            .collect::<Vec<_>>();
+        previews.sort();
+        assert_eq!(previews, vec!["clip-4", "clip-5"]);
+    }
+}
