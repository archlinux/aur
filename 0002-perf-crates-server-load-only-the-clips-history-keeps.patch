+            .filter(|record| record.mime.type_() == mime::IMAGE)
+            .map(|record| image_file_path_from_digest(&image_dir_path, &record.data))
+            .collect::<HashSet<_>>();
+        if let Ok(mut entries) = tokio::fs::read_dir(&image_dir_path).await {
+            while let Ok(Some(entry)) = entries.next_entry().await {
