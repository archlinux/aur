[Unit]
Description=Intelligent Input Bus
Documentation=man:ibus-daemon(1)
Conflicts=fcitx.service
Before=ibus-config@.service
Requires=ibus-config@.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/ibus-daemon-run-with-env /usr/bin/ibus-daemon --replace --xim
ExecReload=/usr/bin/ibus-daemon-run-with-env /usr/bin/ibus restart
ExecStop=/usr/bin/ibus-daemon-run-with-env /usr/bin/ibus exit
Environment=DISPLAY="%I" GTK_IM_MODULE=ibus QT_IM_MODULE=ibus XMODIFIERS="@im=ibus"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
