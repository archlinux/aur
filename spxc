#!/bin/bash
VERSION="V1.4"

case "$1" in
    -v)
        echo "$VERSION"
        ;;
    -sysfo)
        echo "--- System Information ---"
        echo "CPU: $(lscpu | grep 'Model name' | cut -d ':' -f 2 | sed 's/^[ \t]*//')"
        echo "GPU: $(lspci | grep -i vga | cut -d ':' -f 3 | sed 's/^[ \t]*//')"
        echo "RAM: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
        echo "IP (Local): $(hostname -I | awk '{print $1}')"
        echo "IP (Public): $(curl -s https://ifconfig.me || echo 'N/A')"
        echo "Timezone: $(timedatectl show --property=Timezone --value)"
        echo "Keyboard: $(localectl status | grep 'X11 Layout' | cut -d ':' -f 2 | sed 's/^[ \t]*//')"
        
        if [ -d /sys/class/power_supply/BAT0 ]; then
            capacity=$(cat /sys/class/power_supply/BAT0/capacity)
            status=$(cat /sys/class/power_supply/BAT0/status)
            echo "Battery: $capacity% ($status)"
        else
            echo "Battery: N/A"
        fi
        echo "--------------------------"
        ;;
    -mkserv)
        DIR=$2
        PORT=$3
        
        if [ -z "$DIR" ] || [ -z "$PORT" ]; then
            echo "Usage: spxc -mkserv [directory] [port]"
            exit 1
        fi

        mkdir -p "$DIR"
        
        CREATE_INDEX=true
        if [ -f "$DIR/index.html" ]; then
            echo "index.html already exists in $DIR."
            read -p "Do you want to override it? (y/N): " choice
            case "$choice" in
                y|Y ) CREATE_INDEX=true ;;
                * ) CREATE_INDEX=false ;;
            esac
        fi

        if [ "$CREATE_INDEX" = true ]; then
            cat > "$DIR/index.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spxc Server</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background: rgba(30, 41, 59, 0.7);
            padding: 3rem;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            border: 1px solid #334155;
            text-align: center;
            backdrop-filter: blur(10px);
        }
        h1 {
            margin: 0;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2.5rem;
        }
        p { color: #94a3b8; margin-top: 1rem; }
        .badge {
            display: inline-block;
            margin-top: 2rem;
            padding: 0.5rem 1rem;
            background: #0ea5e9;
            color: white;
            border-radius: 9999px;
            font-weight: bold;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>Spxc set up complete</h1>
        <p>Your Python server is running smoothly.</p>
        <div class="badge">$VERSION ACTIVE</div>
    </div>
</body>
</html>
EOF
            echo "Created $DIR/index.html"
        else
            echo "Skipping index.html creation."
        fi

        echo "Starting server on port $PORT..."
        echo "Press Ctrl+C to close server"
        cd "$DIR" && python3 -m http.server "$PORT"
        ;;
    -rmweb)
        DIR=$2
        if [ -z "$DIR" ]; then
            echo "Usage: spxc -rmweb [directory]"
            exit 1
        fi
        if [ ! -d "$DIR" ]; then
            echo "Error: Directory '$DIR' does not exist."
            exit 1
        fi

        mapfile -t files < <(find "$DIR" -maxdepth 1 -name "*.html")
        
        if [ ${#files[@]} -eq 0 ]; then
            echo "No HTML files found in $DIR."
            exit 0
        fi

        echo "The following files will be deleted:"
        for file in "${files[@]}"; do
            echo "  $file"
        done

        read -p "Are you sure you want to delete these ${#files[@]} files? (y/N): " choice
        case "$choice" in
            y|Y ) 
                for file in "${files[@]}"; do
                    rm "$file"
                done
                echo "HTML files removed from $DIR."
                ;;
            * ) 
                echo "Operation cancelled."
                ;;
        esac
        ;;
    -dweb)
        DIR=$2
        URL=$3
        NAME=$4
        
        if [ -z "$DIR" ] || [ -z "$URL" ] || [ -z "$NAME" ]; then
            echo "Usage: spxc -dweb [directory] [URL] [html name]"
            exit 1
        fi

        if [[ ! "$NAME" =~ \.html$ ]]; then
            NAME="$NAME.html"
        fi

        mkdir -p "$DIR"
        FILEPATH="$DIR/$NAME"

        if [ -f "$FILEPATH" ]; then
            echo "File '$FILEPATH' already exists."
            read -p "Do you want to override it? (y/N): " choice
            case "$choice" in
                y|Y ) ;;
                * ) echo "Download cancelled."; exit 0 ;;
            esac
        fi

        echo "Generating Shielded Bundle (V1.4) from $URL..."
        
        export SPXC_URL="$URL"
        export SPXC_FILEPATH="$FILEPATH"
        export SPXC_BASE_DOMAIN=$(python3 -c "import urllib.parse; print(urllib.parse.urlparse('$URL').netloc)")

        python3 - <<'EOF'
import urllib.request, urllib.parse, re, sys, os, json, base64

url = os.environ.get('SPXC_URL')
filepath = os.environ.get('SPXC_FILEPATH')
base_domain = os.environ.get('SPXC_BASE_DOMAIN')
headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36'}
pages = {} 

def fetch_resource(target_url, binary=False):
    try:
        req = urllib.request.Request(target_url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as r:
            data = r.read()
            return data if binary else data.decode('utf-8', errors='ignore')
    except:
        return None

def process_page(current_url, depth=0):
    parsed = urllib.parse.urlparse(current_url)
    path = parsed.path or "/index.html"
    if path in pages: return
    
    print(f" Crawling: {current_url}")
    content = fetch_resource(current_url)
    if not content: return

    # 1. Strip Security & Redirects
    content = re.sub(r'<link[^>]+rel=["\'](manifest|preload|prefetch|preconnect)["\'][^>]*>', '', content)
    content = re.sub(r'navigator\.serviceWorker\.register\(.*?\)', '', content)
    content = re.sub(r'<meta[^>]+http-equiv=["\'](Content-Security-Policy|X-Frame-Options|refresh)["\'][^>]*>', '', content)

    # 2. Inlining
    def inline_assets(match):
        tag = match.group(0)
        is_js = '<script' in tag
        attr = 'src' if is_js else 'href'
        m = re.search(f'{attr}=["\']([^"\']+)["\']', tag)
        if m:
            asset_url = urllib.parse.urljoin(current_url, m.group(1))
            data = fetch_resource(asset_url, binary=True)
            if data:
                b64 = base64.b64encode(data).decode('utf-8')
                if is_js: return f'<script>(function(){{var s=document.createElement("script");s.textContent=atob("{b64}");document.head.appendChild(s);}})();</script>'
                else: return f'<style>@import url("data:text/css;base64,{b64}");</style>'
        return tag

    content = re.sub(r'<link[^>]+rel=["\']stylesheet["\'][^>]*>', inline_assets, content)
    content = re.sub(r'<script[^>]+src=["\'][^"\']+["\'][^>]*>.*?</script>', inline_assets, content, flags=re.DOTALL)

    def rewrite_link(match):
        href = match.group(1)
        if href.startswith(('#', 'javascript:', 'data:')): return match.group(0)
        link_url = urllib.parse.urljoin(current_url, href)
        if urllib.parse.urlparse(link_url).netloc == base_domain:
            return f'href="#!{urllib.parse.urlparse(link_url).path or "/index.html"}"'
        return match.group(0)
    content = re.sub(r'href=["\']([^"\']+)["\']', rewrite_link, content)

    pages[path] = base64.b64encode(content.encode('utf-8')).decode('utf-8')

    if depth < 1:
        links = re.findall(r'href=["\']#!([^"\']+)["\']', content)
        for lpath in links:
            if lpath not in pages and not lpath.endswith(('.png', '.jpg', '.ico', '.pdf', '.mp4')):
                process_page(urllib.parse.urljoin(url, lpath), depth + 1)

process_page(url)

shield_script = f"""
<script id="spxc-shield">
(function spxc_shield() {{
    // 1. Block redirects & Frame busting
    const noop = () => {{}};
    window.onbeforeunload = null;
    Object.defineProperty(window, 'location', {{
        value: new Proxy(window.location, {{
            set: (target, prop, value) => {{
                if (prop === 'href' || prop === 'replace' || prop === 'assign') {{
                    console.log('Blocked redirect to:', value);
                    return true;
                }}
                target[prop] = value;
                return true;
            }}
        }}),
        configurable: false
    }});
    
    // 2. Suppress all noise
    window.onerror = () => true;
    window.onunhandledrejection = () => true;
    window.fetch = () => Promise.reject("Sandbox");

    // 3. Router Logic
    const pages = {json.dumps(pages)};
    function loadPage(path) {{
        if (!path || path === '/') path = '/index.html';
        const b64 = pages[path] || pages[path + '.html'] || pages[path + '/index.html'];
        if (b64) {{
            try {{
                const content = atob(b64);
                document.open();
                document.write(content + '<script>(' + spxc_shield.toString() + ')()</script>');
                document.close();
            }} catch(e) {{}}
        }}
    }}

    window.onhashchange = () => {{
        if (window.location.hash.startsWith('#!')) loadPage(window.location.hash.substring(2));
    }};

    if (window.location.hash.startsWith('#!')) loadPage(window.location.hash.substring(2));
}})();
</script>
"""

initial_path = urllib.parse.urlparse(url).path or "/index.html"
initial_content = base64.b64decode(pages[initial_path]).decode('utf-8', errors='ignore')
with open(filepath, "w", encoding='utf-8') as f:
    f.write(initial_content + shield_script)
print(f"Shielded Bundle V1.4 saved to {filepath}")
EOF
        ;;
    --help)
        echo "Available commands:"
        echo "  -v                             Show version"
        echo "  -sysfo                         Show detailed system information"
        echo "  -mkserv [directory] [port]        Create and start a dark-themed Python server"
        echo "  -rmweb [directory]                Remove all HTML files in a directory after confirmation"
        echo "  -dweb [directory] [URL] [name]    Generate a single-file Shielded Bundle (SPA) for extreme apps"
        ;;
    *)
        echo "Usage: spxc --help"
        exit 1
        ;;
esac
