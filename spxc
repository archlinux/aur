#!/bin/bash
VERSION="V0.7"

case "$1" in
    -v)
        echo "$VERSION"
        ;;
    -sysfo)
        echo "--- System Information ---"
        echo "CPU: $(lscpu | grep 'Model name' | cut -d ':' -f 2 | sed 's/^[ \t]*//')"
        echo "GPU: $(lspci | grep -i vga | cut -d ':' -f 3 | sed 's/^[ \t]*//')"
        echo "RAM: $(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
        echo "IP (Local): $(hostname -I | awk '{print $1}')"
        echo "IP (Public): $(curl -s https://ifconfig.me || echo 'N/A')"
        echo "Timezone: $(timedatectl show --property=Timezone --value)"
        echo "Keyboard: $(localectl status | grep 'X11 Layout' | cut -d ':' -f 2 | sed 's/^[ \t]*//')"
        
        if [ -d /sys/class/power_supply/BAT0 ]; then
            capacity=$(cat /sys/class/power_supply/BAT0/capacity)
            status=$(cat /sys/class/power_supply/BAT0/status)
            echo "Battery: $capacity% ($status)"
        else
            echo "Battery: N/A"
        fi
        echo "--------------------------"
        ;;
    -mkserv)
        DIR=$2
        PORT=$3
        
        if [ -z "$DIR" ] || [ -z "$PORT" ]; then
            echo "Usage: spxc -mkserv [directory] [port]"
            exit 1
        fi

        mkdir -p "$DIR"
        
        CREATE_INDEX=true
        if [ -f "$DIR/index.html" ]; then
            echo "index.html already exists in $DIR."
            read -p "Do you want to override it? (y/N): " choice
            case "$choice" in
                y|Y ) CREATE_INDEX=true ;;
                * ) CREATE_INDEX=false ;;
            esac
        fi

        if [ "$CREATE_INDEX" = true ]; then
            cat > "$DIR/index.html" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spxc Server</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            background: rgba(30, 41, 59, 0.7);
            padding: 3rem;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            border: 1px solid #334155;
            text-align: center;
            backdrop-filter: blur(10px);
        }
        h1 {
            margin: 0;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2.5rem;
        }
        p { color: #94a3b8; margin-top: 1rem; }
        .badge {
            display: inline-block;
            margin-top: 2rem;
            padding: 0.5rem 1rem;
            background: #0ea5e9;
            color: white;
            border-radius: 9999px;
            font-weight: bold;
            font-size: 0.8rem;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>Spxc set up complete</h1>
        <p>Your Python server is running smoothly.</p>
        <div class="badge">$VERSION ACTIVE</div>
    </div>
</body>
</html>
EOF
            echo "Created $DIR/index.html"
        else
            echo "Skipping index.html creation."
        fi

        echo "Starting server on port $PORT..."
        echo "Press Ctrl+C to close server"
        cd "$DIR" && python3 -m http.server "$PORT"
        ;;
    -rmweb)
        DIR=$2
        if [ -z "$DIR" ]; then
            echo "Usage: spxc -rmweb [directory]"
            exit 1
        fi
        if [ ! -d "$DIR" ]; then
            echo "Error: Directory '$DIR' does not exist."
            exit 1
        fi

        mapfile -t files < <(find "$DIR" -maxdepth 1 -name "*.html")
        
        if [ ${#files[@]} -eq 0 ]; then
            echo "No HTML files found in $DIR."
            exit 0
        fi

        echo "The following files will be deleted:"
        for file in "${files[@]}"; do
            echo "  $file"
        done

        read -p "Are you sure you want to delete these ${#files[@]} files? (y/N): " choice
        case "$choice" in
            y|Y ) 
                for file in "${files[@]}"; do
                    rm "$file"
                done
                echo "HTML files removed from $DIR."
                ;;
            * ) 
                echo "Operation cancelled."
                ;;
        esac
        ;;
    -dweb)
        DIR=$2
        URL=$3
        NAME=$4
        
        if [ -z "$DIR" ] || [ -z "$URL" ] || [ -z "$NAME" ]; then
            echo "Usage: spxc -dweb [directory] [URL] [html name]"
            exit 1
        fi

        if [[ ! "$NAME" =~ \.html$ ]]; then
            NAME="$NAME.html"
        fi

        mkdir -p "$DIR"
        FILEPATH="$DIR/$NAME"

        if [ -f "$FILEPATH" ]; then
            echo "File '$FILEPATH' already exists."
            read -p "Do you want to override it? (y/N): " choice
            case "$choice" in
                y|Y ) ;;
                * ) echo "Download cancelled."; exit 0 ;;
            esac
        fi

        echo "Downloading and inlining CSS/JS from $URL..."
        python3 - <<EOF
import urllib.request, urllib.parse, re, sys

url = "$URL"
filepath = "$FILEPATH"
headers = {'User-Agent': 'Mozilla/5.0'}

def fetch_resource(target_url):
    try:
        req = urllib.request.Request(target_url, headers=headers)
        with urllib.request.urlopen(req) as r:
            return r.read().decode('utf-8')
    except:
        return None

try:
    html = fetch_resource(url)
    if html is None:
        print(f"Error: Could not download {url}")
        sys.exit(1)
    
    def inline_css(match):
        tag = match.group(0)
        href_match = re.search(r'href=["\']([^"\']+)["\']', tag)
        if href_match:
            css_href = href_match.group(1)
            css_url = urllib.parse.urljoin(url, css_href)
            content = fetch_resource(css_url)
            if content:
                return f"<style>\n/* Inlined from {css_url} */\n{content}\n</style>"
        return tag

    def inline_js(match):
        tag = match.group(0)
        src_match = re.search(r'src=["\']([^"\']+)["\']', tag)
        if src_match:
            js_src = src_match.group(1)
            js_url = urllib.parse.urljoin(url, js_src)
            content = fetch_resource(js_url)
            if content:
                return f"<script>\n/* Inlined from {js_url} */\n{content}\n</script>"
        return tag

    # Inline CSS
    new_html = re.sub(r'<link[^>]+rel=["\']stylesheet["\'][^>]*>', inline_css, html)
    new_html = re.sub(r'<link[^>]+href=["\'][^"\']+["\'][^>]*rel=["\']stylesheet["\'][^>]*>', inline_css, new_html)
    
    # Inline JS
    new_html = re.sub(r'<script[^>]+src=["\'][^"\']+["\'][^>]*>.*?</script>', inline_js, new_html, flags=re.DOTALL)
    
    with open(filepath, "w") as f:
        f.write(new_html)
    print(f"Successfully saved to {filepath}")
except Exception as e:
    print(f"Error: {e}")
    sys.exit(1)
EOF
        ;;
    --help)
        echo "Available commands:"
        echo "  -v                                Show version"
        echo "  -sysfo                            Show detailed system information"
        echo "  -mkserv [directory] [port]        Create and start a dark-themed Python server"
        echo "  -rmweb [directory]                Remove all HTML files in a directory after confirmation"
        echo "  -dweb [directory] [URL] [name]    Download HTML and inline all CSS/JS into a single file"
        ;;
    *)
        echo "Usage: spxc --help"
        exit 1
        ;;
esac
