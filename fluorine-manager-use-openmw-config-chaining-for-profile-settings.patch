     if (stream.gcount() == 0) {
       return false;
     } else {
       throw ESP::InvalidRecordException("record incomplete");
     }
   }
+
+  m_DataSize = decodeLittleEndian32(header.data());
+  m_Unknown  = decodeLittleEndian32(header.data() + 4);
+  m_Flags    = decodeLittleEndian32(header.data() + 8);
   return true;
 }
