+static void sync_gsettings_interface()
+{
+    char *quoted, *command;
+    gboolean ok = FALSE;
+
+    if (!g_find_program_in_path("gsettings"))
+    {
+        g_message("Skipping gsettings sync: gsettings not found");
+        return;
+    }
+
+    if (app.widget_theme && *app.widget_theme)
+    {
+        quoted = g_shell_quote(app.widget_theme);
+        command = g_strdup_printf("gsettings set org.gnome.desktop.interface gtk-theme %s", quoted);
+        g_spawn_command_line_sync(command, NULL, NULL, NULL, NULL);
+        ok = TRUE;
+        g_free(command);
+        g_free(quoted);
+    }
+
+    if (app.icon_theme && *app.icon_theme)
+    {
+        quoted = g_shell_quote(app.icon_theme);
+        command = g_strdup_printf("gsettings set org.gnome.desktop.interface icon-theme %s", quoted);
+        g_spawn_command_line_sync(command, NULL, NULL, NULL, NULL);
+        ok = TRUE;
+        g_free(command);
+        g_free(quoted);
+    }
+
+    if (app.cursor_theme && *app.cursor_theme)
+    {
+        quoted = g_shell_quote(app.cursor_theme);
+        command = g_strdup_printf("gsettings set org.gnome.desktop.interface cursor-theme %s", quoted);
+        g_spawn_command_line_sync(command, NULL, NULL, NULL, NULL);
+        ok = TRUE;
+        g_free(command);
+        g_free(quoted);
+    }
+
+    if (app.default_font && *app.default_font)
+    {
+        quoted = g_shell_quote(app.default_font);
+        command = g_strdup_printf("gsettings set org.gnome.desktop.interface font-name %s", quoted);
+        g_spawn_command_line_sync(command, NULL, NULL, NULL, NULL);
+        ok = TRUE;
+        g_free(command);
+        g_free(quoted);
+    }
+
+    command = g_strdup_printf("gsettings set org.gnome.desktop.interface cursor-size %d", app.cursor_theme_size);
+    g_spawn_command_line_sync(command, NULL, NULL, NULL, NULL);
+    g_free(command);
+    ok = TRUE;
+
+    if (ok)
+        g_message("Applied appearance values to gsettings");
+}
+
+static gboolean labwc_environment_line_matches_key(const char *line, const char *key)
+{
+    gsize key_len;
+
+    while (*line == ' ' || *line == '\t')
+        ++line;
+
+    if (*line == '#')
+        return FALSE;
+
+    key_len = strlen(key);
+    if (strncmp(line, key, key_len) != 0)
+        return FALSE;
+
+    line += key_len;
+    while (*line == ' ' || *line == '\t')
+        ++line;
+
+    return *line == '=';
+}
+
+static void append_labwc_environment_line(GString *out, const char *line,
+                                          const char *theme, const char *size,
+                                          gboolean *theme_written,
+                                          gboolean *size_written)
+{
+    if (labwc_environment_line_matches_key(line, "XCURSOR_THEME"))
+    {
+        if (!*theme_written)
+            g_string_append_printf(out, "XCURSOR_THEME=%s\n", theme);
+        *theme_written = TRUE;
+        return;
+    }
+
+    if (labwc_environment_line_matches_key(line, "XCURSOR_SIZE"))
+    {
+        if (!*size_written)
+            g_string_append_printf(out, "XCURSOR_SIZE=%s\n", size);
+        *size_written = TRUE;
+        return;
+    }
+
+    g_string_append(out, line);
+    g_string_append_c(out, '\n');
+}
+
+static void sync_labwc_environment()
+{
+    char *labwc_dir;
+    char *environment_path;
+    char *contents = NULL;
+    char **lines;
+    char *size;
+    const char *theme;
+    GString *out;
+    gboolean theme_written = FALSE;
+    gboolean size_written = FALSE;
+    int i;
+
+    theme = (app.cursor_theme && *app.cursor_theme) ? app.cursor_theme : "default";
+    size = g_strdup_printf("%d", app.cursor_theme_size);
+
+    labwc_dir = g_build_filename(g_get_user_config_dir(), "labwc", NULL);
+    g_mkdir_with_parents(labwc_dir, 0755);
+    environment_path = g_build_filename(labwc_dir, "environment", NULL);
+
+    if (!g_file_get_contents(environment_path, &contents, NULL, NULL))
+        contents = g_strdup("");
+
+    lines = g_strsplit(contents, "\n", -1);
+    out = g_string_new(NULL);
+
+    for (i = 0; lines[i] != NULL; ++i)
+    {
+        if (lines[i + 1] == NULL && lines[i][0] == '\0')
+            break;
+        append_labwc_environment_line(out, lines[i], theme, size,
+                                      &theme_written, &size_written);
+    }
+
+    if (!theme_written)
+        g_string_append_printf(out, "XCURSOR_THEME=%s\n", theme);
+    if (!size_written)
+        g_string_append_printf(out, "XCURSOR_SIZE=%s\n", size);
+
+    if (g_file_set_contents(environment_path, out->str, -1, NULL))
+        g_message("Applied cursor values to labwc environment: %s", environment_path);
+
+    /* If we run under labwc, ask it to reload XCURSOR_THEME/XCURSOR_SIZE now.
+     * Other wlroots compositors do not provide this command; there the values
+     * above still apply to newly started clients and after the next login. */
+    if (g_getenv("LABWC_PID") && g_find_program_in_path("labwc"))
+        g_spawn_command_line_async("labwc --reconfigure", NULL);
+
+    g_string_free(out, TRUE);
+    g_strfreev(lines);
+    g_free(contents);
+    g_free(environment_path);
+    g_free(labwc_dir);
+    g_free(size);
+}
+
+static void ensure_user_autostart_sync()
+{
+    char *autostart_dir;
+    char *desktop_path;
+    const char *desktop_content =
+        "[Desktop Entry]\n"
+        "Type=Application\n"
+        "Name=Synchronize GTK Appearance\n"
+        "Comment=Sync GTK appearance values to gsettings\n"
+        "Exec=/usr/bin/lxappearance-wlr-sync-gsettings\n"
+        "OnlyShowIn=labwc;\n"
+        "NoDisplay=true\n"
+        "X-GNOME-Autostart-enabled=true\n";
+
+    autostart_dir = g_build_filename(g_get_user_config_dir(), "autostart", NULL);
+    if (!g_file_test(autostart_dir, G_FILE_TEST_IS_DIR))
+        g_mkdir_with_parents(autostart_dir, 0755);
+
+    desktop_path = g_build_filename(autostart_dir, "lxappearance-wlr-sync-gsettings.desktop", NULL);
+    g_file_set_contents(desktop_path, desktop_content, -1, NULL);
+    g_message("Ensured autostart entry: %s", desktop_path);
+
+    g_free(desktop_path);
+    g_free(autostart_dir);
+}
