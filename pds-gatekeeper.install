post_install() {
  echo "==> Edit /etc/pds-gatekeeper.env and configure your reverse proxy"
  echo "==> The 'pds-gatekeeper' user is added to the 'pds' group to allow access to atproto-pds files"
  echo "==> See https://tangled.org/baileytownsend.dev/pds-gatekeeper"
}

post_upgrade() {
  echo "==> Review /etc/pds-gatekeeper.env for new configuration options"
}
