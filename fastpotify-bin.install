post_install() {
  cat <<'EOF'
Fastpotify has been renamed to Spotifast.

This package is now spotifast-bin. Switch with:

  yay -S spotifast-bin

Accept the offer to replace fastpotify-bin. Your settings and saved sign-ins
are kept. This update changes only package metadata, not application code.

Details: https://spotifast.rocks/renaming/
EOF
}

post_upgrade() {
  post_install
}
