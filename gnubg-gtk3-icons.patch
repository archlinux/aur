+/*
+ * Fixed dark background for the main toolbar, so its icons (gnubg's own
+ * bundled ones and anything still resolved via the system icon theme)
+ * stay legible regardless of the user's active GTK/icon theme - see
+ * gtk_widget_set_name(pwtb, "gnubg-toolbar") in gtktoolbar.c.
+ */
+#gnubg-toolbar {
+    background-color: #363636;
+}
