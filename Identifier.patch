From 14c669adf81bcb449e7e3c8d3a611cfab313846f Mon Sep 17 00:00:00 2001
From: Raidriar <git.raidriar@pm.me>
Date: Tue, 16 Jun 2026 00:35:03 -0700
Subject: [PATCH] Append "AUR" to identifier

---
 crates/renderide/src/build_info.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/renderide/src/build_info.rs b/crates/renderide/src/build_info.rs
index 2088031..72e3933 100644
--- a/crates/renderide/src/build_info.rs
+++ b/crates/renderide/src/build_info.rs
@@ -38,8 +38,8 @@ pub(crate) fn renderer_commit_sha8_label() -> &'static str {
 
 fn renderer_identifier_for(version: &str, commit_sha8: Option<&str>) -> String {
     match commit_sha8 {
-        Some(commit) => format!("Renderide {version}-{commit}"),
-        None => format!("Renderide {version}"),
+        Some(commit) => format!("Renderide {version}-{commit} (AUR)"),
+        None => format!("Renderide {version} (AUR)"),
     }
 }
 
