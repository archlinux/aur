post_install() {
	cat <<'MSG'
==> Aurelia runs Windows games through Proton, which needs Vulkan.
==> For 32-bit games, enable [multilib] in /etc/pacman.conf and install
==> the 32-bit driver for your GPU, for example:
==>   AMD:    lib32-vulkan-radeon
==>   Intel:  lib32-vulkan-intel
==>   NVIDIA: lib32-nvidia-utils
==> plus lib32-vulkan-icd-loader lib32-freetype2 lib32-wayland.
==> Check your setup with: vulkaninfo --summary
MSG
}

post_upgrade() {
	post_install
}
