pre_install() {
  echo "\x1b[31mRequires Ruby 3.1+, won't work with official ArchLinux Ruby."
  echo "Set another Ruby runtime for example with asdf-vm.\x1b[0m"
}

post_install() {
  set -e
  cd /usr/share/aspisec
  #rm -f Gemfile.lock
  bundle config build.nokogiri --use-system-libraries
  bundle config set --local path 'vendor/bundle'
  bundle config set --local without development install test lint docs
  bundle install
}

post_upgrade() {
  post_install "$@"
}

post_remove() {
  rm -r /usr/share/aspisec/{vendor,.bundle}
  rmdir /usr/share/aspisec
}

