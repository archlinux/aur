pre_upgrade() {
	if command -v systemctl >/dev/null 2>&1; then
		systemctl disable --now onlyoffice-fileconverter.service >/dev/null 2>&1 || true
	fi
}

post_install() {
	cat <<EOF
Document Server 9.4 community runs as one process. RabbitMQ and a database are not used; open documents are kept in memory and do not survive a restart of the service.

Before the first start, edit:
    /etc/webapps/onlyoffice/documentserver/local.json
Replace every SECRET. The service listens on port 8080.

Then enable and start onlyoffice-docservice.service.
nginx is optional and can be used as a reverse proxy.
EOF
}

post_upgrade() {
	cat <<EOF
Document Server 9.4 no longer needs RabbitMQ, PostgreSQL or MariaDB.
onlyoffice-fileconverter.service has been removed: conversion runs inside onlyoffice-docservice.service.

If local.json was modified, pacman keeps it and saves the new file as local.json.pacnew. Queue and SQL settings in an old local.json are ignored by the community build. Replace the SECRET placeholders if you switch to the new file.
EOF
}
