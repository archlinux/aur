#!/bin/sh

# Handle jagex-jav protocol
JAGEX_CONFIG=${1:-jagex-jav://oldschool.runescape.com/jav_config.ws}

/usr/lib/jvm/java-8-openjdk/jre/bin/java \
-Dcom.jagex.configuri="$JAGEX_CONFIG" \
-Dsystem.class.loader=app.systemclassloader \
-Xmx512m -Xss2m \
-XX:CompileThreshold=1500 \
-jar "/usr/share/java/osrs-launcher/jagexappletviewer.jar" osrs