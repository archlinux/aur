post_install() {
  cat <<'MSG'
==> One step is needed before the keyboard can be reached without root.
    The udev rule is installed, but the running system has not applied it:

      sudo udevadm control --reload-rules && sudo udevadm trigger

    Then UNPLUG AND REPLUG the keyboard.

==> Commands:
      epomaker-rt100        terminal interface
      epomaker-rt100-gtk    desktop app  (install epomaker-rt100-gtk-git)

==> To show the clock, CPU and temperature on the screen:
      systemctl --user enable --now epomaker-controller.service
MSG
}

post_upgrade() {
  cat <<'MSG'
==> If the keyboard stops responding after this upgrade, reapply the udev rule:
      sudo udevadm control --reload-rules && sudo udevadm trigger
    then unplug and replug it.
MSG
}
