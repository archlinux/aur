post_install() {
  cat <<'MSG'
==> The keyboard needs a udev rule to be reachable without root.
    It was installed, but the running system has not picked it up yet:

      sudo udevadm control --reload-rules && sudo udevadm trigger

    Then UNPLUG AND REPLUG the keyboard.

==> Front ends (install whichever you want):
      pacman -S python-textual                       -> epomaker-rt100      (terminal)
      pacman -S python-gobject gtk4 libadwaita       -> epomaker-rt100-gtk  (desktop)

==> To show the clock, CPU and temperature on the screen:
      systemctl --user enable --now epomaker-controller.service
MSG
}

post_upgrade() {
  post_install
}
