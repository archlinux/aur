#!/bin/python
from pystray import Icon, MenuItem, Menu
from PIL import Image
import sys
import os
import subprocess

app_path = "/opt/zalo"
electron22_path = "/usr/bin/electron22"

# Paths to your Zalo application and icon
app_asar = os.path.join(app_path, "app.asar")
icon_path = os.path.join(app_path, "icon.png")

def start_zalo():
    return subprocess.Popen([electron22_path, app_asar] + sys.argv[1:])

# Start the Zalo application
process = start_zalo()

def open_app():
    start_zalo()

def exit_action(icon, item):
    process.kill()
    icon.stop()

# Load the tray icon image
image = Image.open(icon_path)

# Create the tray menu
menu = Menu(
    MenuItem('Mở Zalo', lambda: open_app()),
    MenuItem('Thoát', exit_action)
)

# Create the tray icon
icon = Icon("Custom Tray Icon", image, "Zalo", menu)

# Run the icon
icon.run()
