post_install() {
    c_green="\033[1;32m"
    c_cyan="\033[1;36m"
    c_yellow="\033[1;33m"
    c_bold="\033[1m"
    c_reset="\033[0m"

    # nap udev rule cho /dev/uinput
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger /dev/uinput 2>/dev/null || true
    modprobe uinput 2>/dev/null || true

    echo -e "${c_green}::${c_reset} ${c_bold}Cài đặt Clak thành công!${c_reset}"
    echo -e "${c_yellow}:: QUAN TRỌNG:${c_reset} ${c_bold}Hãy mở 'clak-gui' và chạy 'Chẩn đoán'${c_reset}"
    echo -e "   (hoặc chạy lệnh terminal: ${c_cyan}${c_bold}clak doctor${c_reset})"
    echo -e "   để kiểm tra môi trường, kích hoạt bộ gõ và tối ưu hóa hệ thống (WPS Office, JetBrains, uinput) chỉ với 1-Click!"
    echo -e "${c_cyan}:: Lưu ý:${c_reset} Hãy tắt các bộ gõ tiếng Việt khác và chỉ để duy nhất Clak vì Clak đã hỗ trợ cả Tiếng Việt và Tiếng Anh"
    if [ -n "${SUDO_USER:-}" ] && command -v notify-send >/dev/null 2>&1; then
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$SUDO_USER")/bus" notify-send -i org.fcitx.Fcitx5.clak "Clak Tiếng Việt" "Cài đặt thành công! Hãy mở 'clak-gui' chạy 'Chẩn đoán' (hoặc gõ 'clak doctor') để kiểm tra và tối ưu 1-click." 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -i org.fcitx.Fcitx5.clak "Clak Tiếng Việt" "Cài đặt thành công! Hãy mở 'clak-gui' chạy 'Chẩn đoán' (hoặc gõ 'clak doctor') để kiểm tra và tối ưu 1-click." 2>/dev/null || true
    fi
}

post_upgrade() {
    c_green="\033[1;32m"
    c_cyan="\033[1;36m"
    c_yellow="\033[1;33m"
    c_bold="\033[1m"
    c_reset="\033[0m"

    echo -e "${c_green}::${c_reset} ${c_bold}Đã update Clak lên phiên bản mới${c_reset}"
    if [ -n "${SUDO_USER:-}" ] && command -v notify-send >/dev/null 2>&1; then
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$SUDO_USER")/bus" notify-send -i org.fcitx.Fcitx5.clak "Clak" "Đã cập nhật lên bản mới! Hãy mở 'clak-gui' chạy 'Chẩn đoán' (hoặc gõ 'clak doctor') để kiểm tra và tối ưu 1-click." 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -i org.fcitx.Fcitx5.clak "Clak" "Đã cập nhật lên bản mới! Hãy mở 'clak-gui' chạy 'Chẩn đoán' (hoặc gõ 'clak doctor') để kiểm tra và tối ưu 1-click." 2>/dev/null || true
    fi
    touch -c /usr/share/icons/hicolor || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    if [ -n "${SUDO_USER:-}" ] && pgrep -u "$SUDO_USER" -x fcitx5 >/dev/null 2>&1; then
        echo -e "${c_cyan}::${c_reset} Đang nạp lại daemon Fcitx5 cho ${c_bold}$SUDO_USER${c_reset}..."
        user_uid=$(id -u "$SUDO_USER" 2>/dev/null || echo 1000)
        user_bus="unix:path=/run/user/${user_uid}/bus"
        fcitx_pid=$(pgrep -u "$SUDO_USER" -x fcitx5 | head -n 1)
        wayland_disp=$(tr '\0' '\n' < "/proc/${fcitx_pid}/environ" 2>/dev/null | grep '^WAYLAND_DISPLAY=' | cut -d= -f2-)
        disp=$(tr '\0' '\n' < "/proc/${fcitx_pid}/environ" 2>/dev/null | grep '^DISPLAY=' | cut -d= -f2-)
        sudo -u "$SUDO_USER" env XDG_RUNTIME_DIR="/run/user/${user_uid}" WAYLAND_DISPLAY="$wayland_disp" DISPLAY="$disp" DBUS_SESSION_BUS_ADDRESS="$user_bus" fcitx5 -r -d >/dev/null 2>&1 || true
    fi
    echo -e "${c_yellow}:: QUAN TRỌNG:${c_reset} ${c_bold}Hãy mở 'clak-gui' và chạy 'Chẩn đoán'${c_reset}"
    echo -e "   (hoặc chạy lệnh terminal: ${c_cyan}${c_bold}clak doctor${c_reset})"
    echo -e "   để kiểm tra môi trường, kích hoạt bộ gõ và tối ưu hóa hệ thống (WPS Office, JetBrains, uinput) chỉ với 1-Click!"
}
