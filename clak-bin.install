post_install() {
    c_green="\033[1;32m"
    c_cyan="\033[1;36m"
    c_yellow="\033[1;33m"
    c_bold="\033[1m"
    c_reset="\033[0m"

    echo -e "${c_green}::${c_reset} ${c_bold}Cài đặt Clak thành công!${c_reset}"
    echo -e "${c_cyan}::${c_reset} Hãy khởi động lại Fcitx5 và vào cấu hình (${c_cyan}fcitx5-configtool${c_reset}) thêm Clak vào danh sách bộ gõ để sử dụng"
    echo -e "${c_yellow}:: Lưu ý:${c_reset} ${c_bold}Hãy tắt hết các bàn phím khác và chỉ thêm mỗi Clak. Nó hỗ trợ gõ cả tiếng Anh và tiếng Việt${c_reset}"
    if [ -n "${SUDO_USER:-}" ] && command -v notify-send >/dev/null 2>&1; then
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$SUDO_USER")/bus" notify-send -i org.fcitx.Fcitx5.clak "Clak" "Cài đặt thành công! Hãy tắt hết các bàn phím khác và chỉ thêm mỗi Clak. Nó hỗ trợ gõ cả tiếng Anh và tiếng Việt" 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -i org.fcitx.Fcitx5.clak "Clak" "Cài đặt thành công! Hãy tắt hết các bàn phím khác và chỉ thêm mỗi Clak. Nó hỗ trợ gõ cả tiếng Anh và tiếng Việt" 2>/dev/null || true
    fi
}

post_upgrade() {
    c_green="\033[1;32m"
    c_cyan="\033[1;36m"
    c_bold="\033[1m"
    c_reset="\033[0m"

    echo -e "${c_green}::${c_reset} ${c_bold}Đã update Clak lên phiên bản mới${c_reset}"
    if [ -n "${SUDO_USER:-}" ] && command -v notify-send >/dev/null 2>&1; then
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$SUDO_USER")/bus" notify-send -i org.fcitx.Fcitx5.clak "Clak" "Đã cập nhật phiên bản mới thành công" 2>/dev/null || true
    elif command -v notify-send >/dev/null 2>&1; then
        notify-send -i org.fcitx.Fcitx5.clak "Clak" "Đã cập nhật phiên bản mới thành công" 2>/dev/null || true
    fi
    touch -c /usr/share/icons/hicolor || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    if [ -n "${SUDO_USER:-}" ] && pgrep -u "$SUDO_USER" -x fcitx5 >/dev/null 2>&1; then
        echo -e "${c_cyan}::${c_reset} Đang nạp lại daemon Fcitx5 cho ${c_bold}$SUDO_USER${c_reset}..."
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$SUDO_USER")/bus" fcitx5 -r -d >/dev/null 2>&1 || true
    fi
}
