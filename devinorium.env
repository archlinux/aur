# Environment overrides for the devinorium systemd service.
# See .env.example in the source tree for the full list.
#
#DEVINORIUM_HOST=127.0.0.1
#DEVINORIUM_PORT=7878
#DEVINORIUM_BOOTSTRAP_USERNAME=owner
#DEVINORIUM_BOOTSTRAP_PASSWORD=change-me
#DEVINORIUM_SESSION_KEY=
#DEVINORIUM_SECURE_COOKIE=false
#DEVINORIUM_TRUST_PROXY=false
