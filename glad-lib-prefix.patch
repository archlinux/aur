From 2903937b8b3cd7c1b9d6b3b1d6e312c91f56cd57 Mon Sep 17 00:00:00 2001
From: oweissbarth <mail@oweissbarth.de>
Date: Wed, 8 Oct 2025 20:39:50 +0200
Subject: [PATCH] add feather-tk prefix to glad lib

---
 deps/glad_GL_4_1/CMakeLists.txt  | 8 ++++----
 lib/feather-tk/gl/CMakeLists.txt | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/deps/glad_GL_4_1/CMakeLists.txt b/deps/glad_GL_4_1/CMakeLists.txt
index ad7f1f0..7546303 100644
--- a/deps/glad_GL_4_1/CMakeLists.txt
+++ b/deps/glad_GL_4_1/CMakeLists.txt
@@ -5,12 +5,12 @@ set(HEADERS
 set(SOURCE
     src/gl.c)
 
-add_library(glad ${HEADERS} ${SOURCE})
-target_link_libraries(glad OpenGL::GL ${CMAKE_DL_LIBS})
-set_target_properties(glad PROPERTIES FOLDER deps)
+add_library(feather-tk-glad ${HEADERS} ${SOURCE})
+target_link_libraries(feather-tk-glad OpenGL::GL ${CMAKE_DL_LIBS})
+set_target_properties(feather-tk-glad PROPERTIES FOLDER deps)
 
 install(
-    TARGETS glad
+    TARGETS feather-tk-glad
     EXPORT gladTargets
     ARCHIVE DESTINATION lib
     LIBRARY DESTINATION lib
diff --git a/lib/feather-tk/gl/CMakeLists.txt b/lib/feather-tk/gl/CMakeLists.txt
index c3f09e5..ef17c17 100644
--- a/lib/feather-tk/gl/CMakeLists.txt
+++ b/lib/feather-tk/gl/CMakeLists.txt
@@ -34,7 +34,7 @@ elseif ("${feather_tk_API}" STREQUAL "GLES_2")
 endif()
 
 add_library(feather-tk-gl ${HEADERS} ${PRIVATE_HEADERS} ${SOURCE})
-target_link_libraries(feather-tk-gl feather-tk-core glad glfw)
+target_link_libraries(feather-tk-gl feather-tk-core feather-tk-glad glfw)
 set_target_properties(feather-tk-gl PROPERTIES FOLDER lib)
 set_target_properties(feather-tk-gl PROPERTIES PUBLIC_HEADER "${HEADERS}")
 
-- 
2.51.0

