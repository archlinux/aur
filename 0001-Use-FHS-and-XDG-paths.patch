From db122b3a9b374bad864af037cbc4ed8f868f15fc Mon Sep 17 00:00:00 2001
From: xiota <>
Date: Wed, 18 Nov 2026 08:01:37 +0000
Subject: [PATCH] Use FHS and XDG paths

---
 games/__init__.py            | 22 ----------------------
 ialauncher/cd.py             |  3 +--
 ialauncher/game.py           | 21 +++++++++++++++++++--
 ialauncher/scenes/loading.py |  3 +--
 4 files changed, 21 insertions(+), 28 deletions(-)
 delete mode 100644 games/__init__.py

diff --git a/games/__init__.py b/games/__init__.py
deleted file mode 100644
index 55ebe94..0000000
--- a/games/__init__.py
+++ /dev/null
@@ -1,22 +0,0 @@
-"""The games, one directory per game with a metadata.ini and title.png.
-
-Releases also include metadata.json, with the metadata of all games,
-which IA Launcher reads instead of thousands of metadata.ini files.
-"""
-
-import json
-from configparser import RawConfigParser
-from pathlib import Path
-
-
-def write_metadata(file: Path) -> None:
-    """Write the metadata of all games to the file, or raise ValueError."""
-    metadata = {}
-    for ini in sorted(Path(__file__).parent.glob("*/metadata.ini")):
-        if not ini.with_name("title.png").is_file():
-            msg = f"Missing title.png for {ini.parent.name}"
-            raise ValueError(msg)
-        config = RawConfigParser()
-        config.read(ini, encoding="utf-8")
-        metadata[ini.parent.name] = dict(config["metadata"])
-    file.write_text(json.dumps(metadata, indent=4), encoding="utf-8")
diff --git a/ialauncher/cd.py b/ialauncher/cd.py
index 56b5eba..4a34b2d 100644
--- a/ialauncher/cd.py
+++ b/ialauncher/cd.py
@@ -10,12 +10,11 @@ from threading import Event, Lock, Thread
 
 import pygame as pg
 
-import games
 from ialauncher import options
 
 SECTOR = 2352
 FRAMES_PER_SECOND = 75
-GAMES_DIR = Path(games.__file__).parent
+GAMES_DIR = Path("/usr/share/ialauncher")
 POLL_INTERVAL = 0.1
 VOLUME = 0.5
 MIN_SECONDS = 10
diff --git a/ialauncher/game.py b/ialauncher/game.py
index 85f4cf9..2222a75 100644
--- a/ialauncher/game.py
+++ b/ialauncher/game.py
@@ -23,6 +23,7 @@ from urllib.parse import unquote
 from zipfile import ZipFile
 
 import pygame as pg
+import xdg.BaseDirectory
 
 from .emulator import (
     NO_WINDOW,
@@ -74,14 +75,16 @@ class Game:
 
     def __init__(self, path: Path, metadata: dict[str, str] | None = None) -> None:
         """Create the game from its metadata, or raise MetadataError."""
-        self.path = path
         self.identifier = path.name
+        self.system_path = path
+        self.user_path = Path(xdg.BaseDirectory.xdg_data_home) / "ialauncher" / self.identifier
+        self.path = self.user_path if self.user_path.exists() else self.system_path
         self.download_thread: Download | None = None
         self.unzip_thread: Unzip | None = None
         self.emulator: Emulator | None = None
         self.thumbnails: dict[tuple[int, int], pg.Surface] = {}
         self.color: tuple[int, int, int] | None = None
-        self.titlescreen = path / "title.png"
+        self.titlescreen = self.path / "title.png"
         try:
             self.configure(given=metadata)
         except (KeyError, ValueError, configparser.Error) as e:
@@ -89,6 +92,15 @@ class Game:
             msg = f"Invalid metadata for {self.identifier}\n\n{reason}"
             raise MetadataError(msg) from e
 
+    def ensure_user_copy(self) -> None:
+        """Copy the game to the user directory before modifying it."""
+        if self.path == self.system_path:
+            self.user_path.parent.mkdir(parents=True, exist_ok=True)
+            if not self.user_path.exists():
+                shutil.copytree(self.system_path, self.user_path)
+            self.path = self.user_path
+            self.configure(given=None)
+
     def configure(self, *, given: dict[str, str] | None) -> None:
         """Use the given metadata, or read metadata.ini and check for title.png."""
         self.config = RawConfigParser()
@@ -152,6 +164,7 @@ class Game:
 
         Raises EmulatorError if DOSBox (or ScummVM) isn't installed.
         """
+        self.ensure_user_copy()
         if self.engine == "scummvm":
             return self.start_scummvm(autorun=autorun)
         if self.engine == "qemu":
@@ -233,6 +246,7 @@ class Game:
 
     def save_metadata(self, key: str, value: str) -> None:
         """Save the value and missing DOSBox defaults to metadata.ini and the cache."""
+        self.ensure_user_copy()
         metadata = dict(self.config["metadata"])
         if self.engine == "dosbox":
             missing = {k: v for k, v in DOSBOX_DEFAULTS.items() if k not in metadata}
@@ -335,10 +349,12 @@ class Game:
         """Delete the downloaded game, including its saved state."""
         if not self.is_ready():
             return
+        self.ensure_user_copy()
         shutil.rmtree(self.gamedir, ignore_errors=True)
 
     def download(self) -> None:
         """Start downloading the game in a new thread."""
+        self.ensure_user_copy()
         self.download_thread = Download(
             self.urls, self.gamedir, size=self.size, romdir=self.missing_mt32_roms()
         )
@@ -349,6 +365,7 @@ class Game:
 
         Return the thread that unzips it.
         """
+        self.ensure_user_copy()
         if self.unzip_thread is None or not self.unzip_thread.is_alive():
             # ScummVM can't read disc images, so extract them. DOSBox games
             # mount their disc images themselves.
