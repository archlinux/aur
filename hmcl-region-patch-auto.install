post_install() {
    # Patch the HMCL installations that are installed system wide. The detection does not ask
    # pacman for the files of the packages that provide HMCL, because pacman still holds the
    # lock of its database while this script runs.
    /usr/bin/hmcl-region-patch apply \
        --all --system-only --no-pacman \
        --state-dir /var/lib/hmcl-region-patch \
        --yes || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Restore the archives that were patched, so that the system is left as it was.
    /usr/bin/hmcl-region-patch revert \
        --state-dir /var/lib/hmcl-region-patch \
        --yes || true
    rm -rf /var/lib/hmcl-region-patch/backups /var/lib/hmcl-region-patch/state.properties
}
