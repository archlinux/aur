+                    struct drm_atomic_commit *state,
+                #else
                     struct drm_atomic_state *state,
+                #endif
                     bool stall) {
                 (void)drm_atomic_helper_swap_state(state, stall);
             }"
@@ -4340,8 +4350,13 @@ compile_test() {
             #
             CODE="
             #include <drm/drm_atomic_helper.h>
