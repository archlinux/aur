-				EASTL_ASSERT(((size_t)pAligned & ~(alignment - 1)) == (size_t)pAligned);
-
-				return pAligned;
-			#elif (EASTL_DEBUGPARAMS_LEVEL <= 0)
-				return ::new(alignment, offset, (char*)0, flags, 0, (char*)0,        0) char[n];
