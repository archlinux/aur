[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = discord-canary

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = discord-canary-with-flags


[Action]
Description = Adding support for discord-canary.conf to discord-canary
When = PostTransaction
Exec = /usr/share/libalpm/scripts/discord-canary-flags
