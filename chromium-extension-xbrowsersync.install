post_install() {
  cat <<MSG
==> xBrowserSync is an unpacked extension and must be loaded by hand:
      1. open chrome://extensions and turn on "Developer mode"
      2. "Load unpacked" and pick  /usr/share/chromium-extension-xbrowsersync
    Its id is fakjahadieaofbjbamolhoeliigapkga.
    It is a Manifest V2 extension: Google Chrome >= 139 refuses it, use a Chromium
    build that still supports MV2 (e.g. ungoogled-chromium).
MSG
}

post_upgrade() {
  echo "==> xBrowserSync updated: press reload on its card in chrome://extensions."
}
