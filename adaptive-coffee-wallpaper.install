# shellcheck shell=bash
# pacman install scriptlet for adaptive-coffee-wallpaper
post_install() {
    cat <<'MSG'
==> Adaptive Coffee Wallpaper
    Frames:        /usr/share/adaptive-wallpaper/wallpapers
    Tray app:      adaptive-wallpaper   (GNOME, XFCE, Cinnamon, MATE, ...)
    KDE Plasma:    Desktop -> Configure Desktop and Wallpaper -> "Adaptive Coffee",
                   then set the folder to /usr/share/adaptive-wallpaper/wallpapers
MSG
}

post_upgrade() {
    post_install
}

post_remove() {
    cat <<'MSG'
==> Per-user files are not touched by pacman. If autostart was enabled, remove
    ~/.config/autostart/adaptive-wallpaper.desktop (and optionally
    ~/.config/adaptive-wallpaper, ~/.local/share/adaptive-wallpaper).
    Tip: next time run `adaptive-wallpaper --uninstall` before removing the package.
MSG
}
