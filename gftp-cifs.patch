+static off_t
+smb_get_file (gftp_request * request, const char * filename, off_t startsize)
+{
+  smb_protocol_data *spd;
+  struct smb2_stat_64 st;
+  const char *relative;
+  char *error, *path;
+  int ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (filename != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  relative = filename;
+  if (*relative == '/')
+    {
+      while (*relative == '/')
+        relative++;
+      if (g_str_has_prefix (relative, spd->share) &&
+          (relative[strlen (spd->share)] == '/' ||
+           relative[strlen (spd->share)] == '\0'))
+        {
+          relative += strlen (spd->share);
+          while (*relative == '/')
+            relative++;
+        }
+      path = g_strdup (relative);
+    }
+  else if (spd->cur_dir != NULL && *spd->cur_dir != '\0')
+    path = g_build_filename (spd->cur_dir, filename, NULL);
+  else
+    path = g_strdup (filename);
+
+  spd->fh = smb2_open (spd->smb2, path, O_RDONLY);
+  if (spd->fh == NULL)
+    {
+      error = smb_error_message (spd);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error opening SMB file %s: %s\n"), path,
+                                 error);
+      g_free (error);
+      g_free (path);
+      return (smb_error_result (request, 0));
+    }
+
+  ret = smb2_fstat (spd->smb2, spd->fh, &st);
+  if (ret < 0)
+    {
+      error = smb_error_message (spd);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error getting size of SMB file %s: %s\n"),
+                                 path, error);
+      g_free (error);
+      ret = smb_error_result (request, ret);
+      if (spd->smb2 != NULL)
+        smb2_close (spd->smb2, spd->fh);
+      spd->fh = NULL;
+      spd->offset = 0;
+      g_free (path);
+      return (ret);
+    }
+
+  spd->offset = startsize;
+  g_free (path);
+  return ((off_t) st.smb2_size);
+}
