+static ssize_t
+smb_get_next_file_chunk (gftp_request * request, char * buf, size_t size)
+{
+  smb_protocol_data *spd;
+  const char *error;
+  size_t chunk, max_read;
+  int64_t end;
+  ssize_t ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (buf != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->fh != NULL, GFTP_EFATAL);
+
+  end = smb2_lseek (spd->smb2, spd->fh, 0, SEEK_END, NULL);
+  if (end < 0)
+    return (smb_error_result (request, (int) end));
+  if (spd->offset >= end)
+    return (0);
+
+  max_read = smb2_get_max_read_size (spd->smb2);
+  chunk = size < max_read ? size : max_read;
+  ret = smb2_pread (spd->smb2, spd->fh, (uint8_t *) buf, chunk,
+                    spd->offset);
+  if (ret < 0)
+    {
+      error = smb2_get_error (spd->smb2);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error reading SMB file: %s\n"),
+                                 error != NULL ? error : _("Unknown SMB error"));
+      return (smb_error_result (request, (int) ret));
+    }
+
+  spd->offset += ret;
+  return (ret);
+}
