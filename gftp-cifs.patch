+static int
+smb_list_files (gftp_request * request)
+{
+  smb_protocol_data *spd;
+  char *error;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  if (spd->dir != NULL)
+    {
+      smb2_closedir (spd->smb2, spd->dir);
+      spd->dir = NULL;
+    }
+  if (spd->share_enum_reply != NULL)
+    {
+      smb2_free_data (spd->smb2, spd->share_enum_reply);
+      spd->share_enum_reply = NULL;
+    }
+
+  if (strcmp (spd->share, "IPC$") == 0)
+    {
+      spd->share_enum_index = 0;
+      spd->share_enum_reply = smb2_share_enum_sync (spd->smb2, SHARE_INFO_1);
+      if (spd->share_enum_reply == NULL)
+        {
+          error = smb_error_message (spd);
+          request->logging_function (gftp_logging_error, request,
+                                     _("Error listing SMB shares: %s\n"),
+                                     error);
+          g_free (error);
+          return (smb_error_result (request, 0));
+        }
+
+      return (0);
+    }
+
+  spd->dir = smb2_opendir (spd->smb2, spd->cur_dir);
+  if (spd->dir == NULL)
+    {
+      error = smb_error_message (spd);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error listing SMB directory %s: %s\n"),
+                                 request->directory, error);
+      g_free (error);
+      return (smb_error_result (request, 0));
+    }
+
+  return (0);
+}
