+static ssize_t
+smb_put_next_file_chunk (gftp_request * request, char * buf, size_t size)
+{
+  smb_protocol_data *spd;
+  const char *error;
+  size_t chunk, max_write;
+  ssize_t ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (buf != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->fh != NULL, GFTP_EFATAL);
+
+  max_write = smb2_get_max_write_size (spd->smb2);
+  chunk = size < max_write ? size : max_write;
+  ret = smb2_pwrite (spd->smb2, spd->fh, (uint8_t *) buf, chunk,
+                     spd->offset);
+  if (ret < 0)
+    {
+      error = smb2_get_error (spd->smb2);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error writing SMB file: %s\n"),
+                                 error != NULL ? error : _("Unknown SMB error"));
+      return (smb_error_result (request, (int) ret));
+    }
+
+  spd->offset += ret;
+  return (ret);
+}
