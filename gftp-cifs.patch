diff --git a/lib/protocol_smb.c b/lib/protocol_smb.c
new file mode 100644
index 0000000..697f32e
--- /dev/null
+++ b/lib/protocol_smb.c
@@ -0,0 +1,1469 @@
+#include "gftp.h"
+
+#ifdef USE_SMB
+
+#include <errno.h>
+#include <poll.h>
+#include <smb2/smb2.h>
+#include <smb2/libsmb2.h>
+#include <smb2/libsmb2-raw.h>
+#include <smb2/libsmb2-share-enum.h>
+
+typedef struct {
+  struct smb2_context *smb2;
+  struct smb2_url *url;
+  char *share;
+  char *cur_dir;
+  struct smb2dir *dir;
+  struct srvsvc_NetrShareEnum_rep *share_enum_reply;
+  uint32_t share_enum_index;
+  struct smb2fh *fh;
+  off_t offset;
+} smb_protocol_data;
+
+static GMutex smb_ctx_mutex;
+
+static gftp_config_vars config_vars[] =
+{
+  {"", N_("SMB"), gftp_option_type_notebook, NULL, NULL,
+   GFTP_CVARS_FLAGS_SHOW_BOOKMARK, NULL, GFTP_PORT_GTK, NULL},
+
+  /* Input-type options must precede the checkboxes. Only the checkbox printer
+     starts a fresh GtkTable (options_dialog.c, _print_option_type_checkbox);
+     _gen_input_widget() attaches into whatever table is current, so an int or
+     text option listed after a checkbox lands in a cell the checkbox already
+     occupies and the two are drawn on top of each other. */
+  {"smb_timeout_seconds", N_("SMB operation timeout (seconds)"),
+   gftp_option_type_int, GINT_TO_POINTER (0), NULL,
+   GFTP_CVARS_FLAGS_SHOW_BOOKMARK,
+   N_("Abort SMB operations after this many seconds (0 disables the timeout)"),
+   GFTP_PORT_ALL, NULL},
+  {"smb_require_signing", N_("Require SMB signing"),
+   gftp_option_type_checkbox, GINT_TO_POINTER (0), NULL,
+   GFTP_CVARS_FLAGS_SHOW_BOOKMARK,
+   N_("Require SMB2/SMB3 message signing"), GFTP_PORT_ALL, NULL},
+  {"smb_require_encryption", N_("Require SMB3 encryption"),
+   gftp_option_type_checkbox, GINT_TO_POINTER (0), NULL,
+   GFTP_CVARS_FLAGS_SHOW_BOOKMARK,
+   N_("Require SMB3 transport encryption"), GFTP_PORT_ALL, NULL},
+  {NULL, NULL, 0, NULL, NULL, 0, NULL, 0, NULL}
+};
+
+int smb_connect (gftp_request * request)
+{
+  if (request->datafd > 0)
+    return (0);
+
+  smb_protocol_data *spd = request->protocol_data;
+  struct smb2_url *parsed_url;
+  const char *directory, *path, *component_end, *error;
+  char *server, *url, *share, *username, *user, *separator;
+  intptr_t require_encryption, require_signing, timeout_seconds;
+  int auth_failure, ret, result;
+
+  g_return_val_if_fail (request->hostname != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+
+  if (request->port == 0 || request->port == 445)
+    server = g_strdup (request->hostname);
+  else
+    server = g_strdup_printf ("%s:%u", request->hostname, request->port);
+
+  directory = request->directory != NULL ? request->directory : "";
+  while (*directory == '/')
+    directory++;
+
+  component_end = strchr (directory, '/');
+  if (*directory == '\0')
+    {
+      share = g_strdup ("IPC$");
+      path = "";
+    }
+  else
+    {
+      if (component_end == NULL)
+        {
+          share = g_strdup (directory);
+          path = "";
+        }
+      else
+        {
+          share = g_strndup (directory, component_end - directory);
+          path = component_end + 1;
+          while (*path == '/')
+            path++;
+        }
+    }
+
+  url = g_strdup_printf ("smb://%s/%s/%s", server, share, path);
+
+  g_mutex_lock (&smb_ctx_mutex);
+  spd->smb2 = smb2_init_context ();
+  g_mutex_unlock (&smb_ctx_mutex);
+  if (spd->smb2 == NULL)
+    {
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error connecting to %s: Could not initialize SMB context\n"),
+                                 url);
+      g_free (url);
+      g_free (share);
+      g_free (server);
+      return (GFTP_ERETRYABLE);
+    }
+
+  parsed_url = smb2_parse_url (spd->smb2, url);
+  if (parsed_url == NULL)
+    {
+      error = smb2_get_error (spd->smb2);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error parsing %s: %s\n"), url,
+                                 error != NULL ? error : _("Unknown SMB error"));
+      g_mutex_lock (&smb_ctx_mutex);
+      smb2_destroy_context (spd->smb2);
+      g_mutex_unlock (&smb_ctx_mutex);
+      spd->smb2 = NULL;
+      g_free (url);
+      g_free (share);
+      g_free (server);
+      return (GFTP_EFATAL);
+    }
+
+  username = g_strdup (request->username != NULL ? request->username : "");
+  separator = strchr (username, ';');
+  if (separator != NULL)
+    {
+      *separator = '\0';
+      user = separator + 1;
+      smb2_set_domain (spd->smb2, username);
+    }
+  else
+    user = username;
+
+  smb2_set_user (spd->smb2, user);
+  smb2_set_password (spd->smb2,
+                     request->password != NULL ? request->password : "");
+
+  gftp_lookup_request_option (request, "smb_require_signing",
+                              &require_signing);
+  gftp_lookup_request_option (request, "smb_require_encryption",
+                              &require_encryption);
+  gftp_lookup_request_option (request, "smb_timeout_seconds",
+                              &timeout_seconds);
+  smb2_set_sign (spd->smb2, (int) require_signing);
+  smb2_set_seal (spd->smb2, (int) require_encryption);
+  smb2_set_timeout (spd->smb2, (int) timeout_seconds);
+
+  ret = smb2_connect_share (spd->smb2, server, share, user);
+  if (ret != 0)
+    {
+      error = smb2_get_error (spd->smb2);
+      auth_failure = (ret == -EACCES || ret == -EPERM) &&
+                     (error == NULL || strstr (error, "Socket connect failed") == NULL);
+      if (auth_failure)
+        {
+          request->logging_function (gftp_logging_error, request,
+                                     _("Authentication failed for %s: %s\n"), url,
+                                     error != NULL ? error : _("Unknown SMB error"));
+          /*
+           * libsmb2 closes the context before reporting a session-setup
+           * failure, so a follow-up read on the closed socket overwrites the
+           * real cause with "Read from socket failed, errno:9". The detail
+           * above is therefore often useless; state the usual cause instead.
+           */
+          request->logging_function (gftp_logging_error, request,
+                                     _("If the server requires SMB signing, anonymous and guest sessions cannot be signed. Supply real credentials, using DOMAIN;user for a domain account.\n"));
+        }
+      else
+        request->logging_function (gftp_logging_error, request,
+                                   _("Error connecting to %s: %s\n"), url,
+                                   error != NULL ? error : _("Unknown SMB error"));
+      smb2_destroy_url (parsed_url);
+      g_mutex_lock (&smb_ctx_mutex);
+      smb2_destroy_context (spd->smb2);
+      g_mutex_unlock (&smb_ctx_mutex);
+      spd->smb2 = NULL;
+      request->datafd = -1;
+      g_free (username);
+      g_free (url);
+      g_free (share);
+      g_free (server);
+      result = auth_failure ? GFTP_EFATAL : GFTP_ERETRYABLE;
+      return (result);
+    }
+
+  if (spd->url != NULL)
+    smb2_destroy_url (spd->url);
+  g_free (spd->share);
+  g_free (spd->cur_dir);
+  spd->url = parsed_url;
+  spd->share = g_strdup (share);
+  spd->cur_dir = g_strdup (path);
+  request->datafd = smb2_get_fd (spd->smb2);
+
+  g_free (username);
+  g_free (url);
+  g_free (share);
+  g_free (server);
+  return (0);
+}
+
+void smb_disconnect (gftp_request * request)
+{
+  smb_protocol_data *spd;
+
+  g_return_if_fail (request != NULL);
+
+  request->datafd = -1;
+  spd = request->protocol_data;
+  if (spd == NULL || spd->smb2 == NULL)
+    return;
+
+  smb2_disconnect_share (spd->smb2);
+  g_mutex_lock (&smb_ctx_mutex);
+  smb2_destroy_context (spd->smb2);
+  g_mutex_unlock (&smb_ctx_mutex);
+  spd->smb2 = NULL;
+  spd->dir = NULL;
+  spd->fh = NULL;
+}
+
+void smb_destroy (gftp_request * request)
+{
+  smb_protocol_data *spd;
+
+  g_return_if_fail (request != NULL);
+
+  spd = request->protocol_data;
+  if (spd == NULL)
+    return;
+
+  if (spd->smb2 != NULL)
+    smb_disconnect (request);
+  if (spd->url != NULL)
+    smb2_destroy_url (spd->url);
+  spd->url = NULL;
+  g_free (spd->share);
+  spd->share = NULL;
+  g_free (spd->cur_dir);
+  spd->cur_dir = NULL;
+}
+
+void smb_swap_socks (gftp_request * dest, gftp_request * source)
+{
+  smb_protocol_data *dspd = dest->protocol_data;
+  smb_protocol_data *sspd = source->protocol_data;
+
+  dspd->smb2 = sspd->smb2;
+  sspd->smb2 = NULL;
+  dspd->url = sspd->url;
+  sspd->url = NULL;
+  dspd->share = sspd->share;
+  sspd->share = NULL;
+  dspd->cur_dir = sspd->cur_dir;
+  sspd->cur_dir = NULL;
+}
+
+static int
+smb_error_result (gftp_request * request, int ret)
+{
+  smb_protocol_data *spd = request->protocol_data;
+  const char *error;
+  int error_number;
+
+  /*
+   * Never call smb2_get_nterror(): it is declared in <smb2/libsmb2.h> but is
+   * absent from lib/libsmb2.syms, so builds applying that export list (Arch's
+   * package) fail to link. No exported call reads an NT status back off the
+   * context, so a non-negative ret carries no errno and stays retryable.
+   */
+  if (ret < 0)
+    error_number = -ret;
+  else
+    error_number = 0;
+
+  error = smb2_get_error (spd->smb2);
+  if (ret == -1 || (error != NULL && g_str_has_prefix (error, "Poll failed")))
+    {
+      /*
+       * Known, accepted limitation: Stop/cancel cannot cleanly abort a
+       * libsmb2 sync call. SIGINT/SIGALRM interrupts its poll() with an
+       * outstanding PDU (and may strand sync callback data), so the context
+       * is dead and must never be reused. Prefer smb2_set_timeout() for a
+       * cooperative operation bound.
+       */
+      request->datafd = -1;
+      spd->dir = NULL;
+      spd->share_enum_reply = NULL;
+      spd->share_enum_index = 0;
+      spd->fh = NULL;
+      spd->offset = 0;
+      g_mutex_lock (&smb_ctx_mutex);
+      smb2_destroy_context (spd->smb2);
+      g_mutex_unlock (&smb_ctx_mutex);
+      spd->smb2 = NULL;
+    }
+
+  switch (error_number)
+    {
+    case EACCES:
+    case EPERM:
+    case ENOENT:
+    case ENOTDIR:
+    case EINVAL:
+      return (GFTP_EFATAL);
+    default:
+      return (GFTP_ERETRYABLE);
+    }
+}
+
+static char *
+smb_error_message_with_fallback (smb_protocol_data * spd,
+                                 uint32_t fallback_status)
+{
+  const char *detail, *status_name;
+  uint32_t status;
+
+  detail = smb2_get_error (spd->smb2);
+  status = fallback_status;
+
+  status_name = status != 0 ? nterror_to_str (status) : NULL;
+
+  if (status_name != NULL && *status_name != '\0')
+    {
+      if (detail != NULL && *detail != '\0' &&
+          strstr (detail, status_name) == NULL)
+        return (g_strdup_printf ("%s; %s", status_name, detail));
+      if (detail != NULL && *detail != '\0')
+        return (g_strdup (detail));
+      return (g_strdup (status_name));
+    }
+
+  if (detail != NULL && *detail != '\0')
+    return (g_strdup (detail));
+  return (g_strdup (_("Unknown SMB error")));
+}
+
+static char *
+smb_error_message (smb_protocol_data * spd)
+{
+  return (smb_error_message_with_fallback (spd, 0));
+}
+
+typedef struct {
+  int complete;
+  int status;
+} smb_connect_result;
+
+static void
+smb_connect_callback (struct smb2_context *smb2, int status,
+                      void *command_data, void *private_data)
+{
+  smb_connect_result *result = private_data;
+
+  (void) smb2;
+  (void) command_data;
+  result->status = status;
+  result->complete = 1;
+}
+
+static int
+smb_wait_for_connect (smb_protocol_data * spd, smb_connect_result * result)
+{
+  struct pollfd pfd;
+  int ret, seconds_waited = 0;
+
+  while (!result->complete)
+    {
+      pfd.fd = smb2_get_fd (spd->smb2);
+      if (pfd.fd < 0)
+        return (GFTP_EFATAL);
+      pfd.events = smb2_which_events (spd->smb2);
+      pfd.revents = 0;
+
+      ret = poll (&pfd, 1, 1000);
+      if (ret < 0)
+        return (-errno);
+      if (ret == 0)
+        {
+          if (++seconds_waited >= 15)
+            return (-ETIMEDOUT);
+          continue;
+        }
+      if (smb2_service (spd->smb2, pfd.revents) < 0 &&
+          smb2_get_fd (spd->smb2) >= 0)
+        return (-EIO);
+    }
+
+  return (result->status);
+}
+
+static int
+smb_connect_new_share (smb_protocol_data * spd, const char *server,
+                       const char *share, const char *user)
+{
+  smb_connect_result result = { 0, 0 };
+  int ret;
+
+  ret = smb2_connect_share_async (spd->smb2, server, share, user,
+                                  smb_connect_callback, &result);
+  if (ret < 0)
+    return (ret);
+  return (smb_wait_for_connect (spd, &result));
+}
+
+static int
+smb_finish_disconnect (smb_protocol_data * spd)
+{
+  struct pollfd pfd;
+  int ret, seconds_waited = 0;
+
+  while (smb2_get_fd (spd->smb2) >= 0)
+    {
+      pfd.fd = smb2_get_fd (spd->smb2);
+      pfd.events = smb2_which_events (spd->smb2);
+      pfd.revents = 0;
+
+      ret = poll (&pfd, 1, 1000);
+      if (ret < 0)
+        return (-errno);
+      if (ret == 0)
+        {
+          if (++seconds_waited >= 15)
+            return (-ETIMEDOUT);
+          continue;
+        }
+      if (smb2_service (spd->smb2, pfd.revents) < 0 &&
+          smb2_get_fd (spd->smb2) >= 0)
+        return (-EIO);
+    }
+
+  return (0);
+}
+
+static int
+smb_probe_share (gftp_request * request, const char *server,
+                 const char *share, const char *user, char **error_message)
+{
+  struct smb2_context *probe;
+  const char *separator;
+  char *domain;
+  int ret;
+
+  g_mutex_lock (&smb_ctx_mutex);
+  probe = smb2_init_context ();
+  g_mutex_unlock (&smb_ctx_mutex);
+  if (probe == NULL)
+    {
+      *error_message = g_strdup (_("Could not initialize SMB context"));
+      return (GFTP_ERETRYABLE);
+    }
+
+  separator = request->username != NULL ? strchr (request->username, ';') : NULL;
+  if (separator != NULL)
+    {
+      domain = g_strndup (request->username, separator - request->username);
+      smb2_set_domain (probe, domain);
+      g_free (domain);
+    }
+  smb2_set_user (probe, user);
+  smb2_set_password (probe,
+                     request->password != NULL ? request->password : "");
+
+  ret = smb2_connect_share (probe, server, share, user);
+  if (ret < 0)
+    *error_message = g_strdup (smb2_get_error (probe));
+  else
+    smb2_disconnect_share (probe);
+
+  g_mutex_lock (&smb_ctx_mutex);
+  smb2_destroy_context (probe);
+  g_mutex_unlock (&smb_ctx_mutex);
+
+  if (ret == 0)
+    return (0);
+  if ((ret == -EACCES || ret == -EPERM) &&
+      (*error_message == NULL ||
+       strstr (*error_message, "Socket connect failed") == NULL))
+    return (GFTP_EFATAL);
+  return (GFTP_ERETRYABLE);
+}
+
+static int
+smb_chdir (gftp_request * request, const char *directory)
+{
+  smb_protocol_data *spd;
+  const char *error, *path, *separator, *user;
+  char *candidate, *normalized, *probe_error, *server, *share;
+  int ret, rollback_ret, result;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (directory != NULL, GFTP_EFATAL);
+
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  if (*directory == '/')
+    candidate = g_strdup (directory);
+  else if (request->directory != NULL)
+    candidate = g_strconcat (request->directory, "/", directory, NULL);
+  else
+    candidate = g_strdup_printf ("/%s/%s", spd->share, directory);
+
+  if (*candidate != '/')
+    {
+      char *absolute = g_strconcat ("/", candidate, NULL);
+
+      g_free (candidate);
+      candidate = absolute;
+    }
+
+  normalized = gftp_expand_path (request, candidate);
+  g_free (candidate);
+
+  path = normalized;
+  while (*path == '/')
+    path++;
+
+  separator = strchr (path, '/');
+  if (*path == '\0')
+    {
+      share = g_strdup ("IPC$");
+      path = "";
+    }
+  else if (separator == NULL)
+    {
+      share = g_strdup (path);
+      path = "";
+    }
+  else
+    {
+      share = g_strndup (path, separator - path);
+      path = separator + 1;
+    }
+
+  if (g_ascii_strcasecmp (share, spd->share) == 0)
+    {
+      g_free (spd->cur_dir);
+      spd->cur_dir = g_strdup (path);
+      g_free (request->directory);
+      request->directory = normalized;
+      g_free (share);
+      return (0);
+    }
+
+  if (spd->dir != NULL)
+    {
+      smb2_closedir (spd->smb2, spd->dir);
+      spd->dir = NULL;
+    }
+  if (spd->fh != NULL)
+    {
+      ret = smb2_close (spd->smb2, spd->fh);
+      spd->fh = NULL;
+      if (ret < 0)
+        {
+          error = smb2_get_error (spd->smb2);
+          request->logging_function (gftp_logging_error, request,
+                                     _("Error closing SMB file before changing share: %s\n"),
+                                     error != NULL ? error : _("Unknown SMB error"));
+          g_free (share);
+          g_free (normalized);
+          return (smb_error_result (request, ret));
+        }
+    }
+
+  if (request->port == 0 || request->port == 445)
+    server = g_strdup (request->hostname);
+  else
+    server = g_strdup_printf ("%s:%u", request->hostname, request->port);
+  user = request->username != NULL ? request->username : "";
+  separator = strchr (user, ';');
+  if (separator != NULL)
+    user = separator + 1;
+
+  probe_error = NULL;
+  result = smb_probe_share (request, server, share, user, &probe_error);
+  if (result < 0)
+    {
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error changing to SMB share %s: %s\n"),
+                                 share,
+                                 probe_error != NULL ? probe_error :
+                                 _("Unknown SMB error"));
+      g_free (probe_error);
+      g_free (server);
+      g_free (share);
+      g_free (normalized);
+      return (result);
+    }
+
+  ret = smb2_disconnect_share (spd->smb2);
+  request->datafd = -1;
+  if (ret == 0)
+    ret = smb_finish_disconnect (spd);
+  if (ret < 0)
+    {
+      error = smb2_get_error (spd->smb2);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error disconnecting SMB share %s: %s\n"),
+                                 spd->share,
+                                 error != NULL ? error : _("Unknown SMB error"));
+      result = smb_error_result (request, ret);
+      g_free (server);
+      g_free (share);
+      g_free (normalized);
+      return (result);
+    }
+
+  /*
+   * Mandatory before reconnecting a used context: smb2_disconnect_share()
+   * only closes the socket, and smb2_connect_share_async() resets nothing but
+   * server/share/user. The stale session_id, message_id, tree ids and signing
+   * keys would then ride a brand-new TCP connection, which real servers answer
+   * with RST (ECONNRESET). smb2_close_context() clears exactly those fields.
+   */
+  smb2_close_context (spd->smb2);
+
+  ret = smb_connect_new_share (spd, server, share, user);
+  if (ret < 0)
+    {
+      error = smb2_get_error (spd->smb2);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error changing to SMB share %s: %s\n"),
+                                 share,
+                                 error != NULL ? error : _("Unknown SMB error"));
+      result = smb_error_result (request, ret);
+
+      if (spd->smb2 == NULL)
+        {
+          g_free (server);
+          g_free (share);
+          g_free (normalized);
+          return (result);
+        }
+
+      smb2_close_context (spd->smb2);
+      rollback_ret = smb_connect_new_share (spd, server, spd->share, user);
+      if (rollback_ret == 0)
+        request->datafd = smb2_get_fd (spd->smb2);
+      else
+        {
+          error = smb2_get_error (spd->smb2);
+          request->logging_function (gftp_logging_error, request,
+                                     _("Error restoring SMB share %s: %s\n"),
+                                     spd->share,
+                                     error != NULL ? error : _("Unknown SMB error"));
+        }
+
+      g_free (server);
+      g_free (share);
+      g_free (normalized);
+      return (result);
+    }
+
+  g_free (spd->share);
+  spd->share = share;
+  g_free (spd->cur_dir);
+  spd->cur_dir = g_strdup (path);
+  g_free (request->directory);
+  request->directory = normalized;
+  request->datafd = smb2_get_fd (spd->smb2);
+  g_free (server);
+  return (0);
+}
