+    entry = smb2_readdir (spd->smb2, dir);
+  while (entry != NULL &&
+         (strcmp (entry->name, ".") == 0 || strcmp (entry->name, "..") == 0));
+  smb2_closedir (spd->smb2, dir);
+  if (entry != NULL)
+    {
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error removing SMB directory %s: %s\n"),
+                                 path, g_strerror (ENOTEMPTY));
+      g_free (path);
+      return (smb_error_result (request, -ENOTEMPTY));
+    }
+
+  ret = smb2_rmdir (spd->smb2, path);
+  if (ret < 0)
+    {
+      error = smb_error_message (spd);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error removing SMB directory %s: %s\n"),
+                                 path, error);
+      g_free (error);
+      g_free (path);
+      return (smb_error_result (request, ret));
+    }
+
+  g_free (path);
+  return (0);
+}
+
+static int
+smb_rmfile (gftp_request * request, const char * filename)
+{
+  smb_protocol_data *spd;
+  const char *relative;
+  char *error, *path;
+  int ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (filename != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  relative = filename;
+  if (*relative == '/')
+    {
+      while (*relative == '/')
+        relative++;
+      if (g_str_has_prefix (relative, spd->share) &&
+          (relative[strlen (spd->share)] == '/' ||
+           relative[strlen (spd->share)] == '\0'))
+        {
+          relative += strlen (spd->share);
+          while (*relative == '/')
+            relative++;
+        }
+      path = g_strdup (relative);
+    }
+  else if (spd->cur_dir != NULL && *spd->cur_dir != '\0')
+    path = g_build_filename (spd->cur_dir, filename, NULL);
+  else
+    path = g_strdup (filename);
+
+  ret = smb2_unlink (spd->smb2, path);
+  if (ret < 0)
+    {
+      error = smb_error_message (spd);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error deleting SMB file %s: %s\n"), path,
+                                 error);
+      g_free (error);
+      g_free (path);
+      return (smb_error_result (request, ret));
+    }
+
+  g_free (path);
+  return (0);
+}
+
+static int
+smb_rename (gftp_request * request, const char * oldname,
+            const char * newname)
+{
+  smb_protocol_data *spd;
+  const char *relative;
+  char *error, *newpath, *oldpath;
+  int ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (oldname != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (newname != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  relative = oldname;
+  if (*relative == '/')
+    {
+      while (*relative == '/')
+        relative++;
+      if (g_str_has_prefix (relative, spd->share) &&
+          (relative[strlen (spd->share)] == '/' ||
+           relative[strlen (spd->share)] == '\0'))
+        {
+          relative += strlen (spd->share);
+          while (*relative == '/')
+            relative++;
+        }
+      oldpath = g_strdup (relative);
+    }
+  else if (spd->cur_dir != NULL && *spd->cur_dir != '\0')
+    oldpath = g_build_filename (spd->cur_dir, oldname, NULL);
+  else
+    oldpath = g_strdup (oldname);
+
+  relative = newname;
+  if (*relative == '/')
+    {
+      while (*relative == '/')
+        relative++;
+      if (g_str_has_prefix (relative, spd->share) &&
+          (relative[strlen (spd->share)] == '/' ||
+           relative[strlen (spd->share)] == '\0'))
+        {
+          relative += strlen (spd->share);
+          while (*relative == '/')
+            relative++;
+        }
+      newpath = g_strdup (relative);
+    }
+  else if (spd->cur_dir != NULL && *spd->cur_dir != '\0')
+    newpath = g_build_filename (spd->cur_dir, newname, NULL);
+  else
+    newpath = g_strdup (newname);
+
+  ret = smb2_rename (spd->smb2, oldpath, newpath);
+  if (ret < 0)
+    {
+      error = smb_error_message_with_fallback (
+        spd, ret == -EEXIST ? SMB2_STATUS_OBJECT_NAME_COLLISION : 0);
+      request->logging_function (gftp_logging_error, request,
+                                 _("Error renaming SMB file %s to %s: %s\n"),
+                                 oldpath, newpath, error);
+      g_free (error);
+      g_free (newpath);
+      g_free (oldpath);
+      return (smb_error_result (request, ret));
+    }
+
+  g_free (newpath);
+  g_free (oldpath);
+  return (0);
+}
+
+static int
+smb_end_transfer (gftp_request * request)
+{
+  smb_protocol_data *spd;
+  const char *error;
+  int ret;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  if (spd != NULL && spd->smb2 != NULL && spd->dir != NULL)
+    {
+      smb2_closedir (spd->smb2, spd->dir);
+      spd->dir = NULL;
+    }
+  if (spd != NULL && spd->smb2 != NULL && spd->share_enum_reply != NULL)
+    {
+      smb2_free_data (spd->smb2, spd->share_enum_reply);
+      spd->share_enum_reply = NULL;
+      spd->share_enum_index = 0;
+    }
+  if (spd != NULL && spd->smb2 != NULL && spd->fh != NULL)
+    {
+      ret = smb2_close (spd->smb2, spd->fh);
+      spd->fh = NULL;
+      spd->offset = 0;
+      if (ret < 0)
+        {
+          error = smb2_get_error (spd->smb2);
+          request->logging_function (gftp_logging_error, request,
+                                     _("Error closing SMB file: %s\n"),
+                                     error != NULL ? error :
+                                     _("Unknown SMB error"));
+          return (smb_error_result (request, ret));
+        }
+    }
+
+  return (0);
+}
+
+void
+smb_register_module (void)
+{
+  gftp_register_config_vars (config_vars);
+}
+
+int smb_init (gftp_request * request)
+{
+  smb_protocol_data *spd;
+
+  request->protonum = GFTP_PROTOCOL_SMB;
+
+  /* lib/gftp.h:702-712 - the #define must equal the gftp_protocols[] index or gFTP segfaults */
+  g_assert (gftp_protocols[GFTP_PROTOCOL_SMB].init == smb_init);
+  g_assert (g_strcmp0 (gftp_protocols[GFTP_PROTOCOL_SMB].url_prefix, "smb") == 0);
+
+  request->url_prefix = gftp_protocols[GFTP_PROTOCOL_SMB].url_prefix;
+
+  request->init = smb_init;
+  request->copy_param_options = NULL;
+  request->read_function = NULL;
+  request->write_function = NULL;
+  request->destroy = smb_destroy;
+  request->connect = smb_connect;
+  request->post_connect = NULL;
+  request->disconnect = smb_disconnect;
+  request->get_file = smb_get_file;
+  request->put_file = smb_put_file;
+  request->transfer_file = NULL;
+  request->get_next_file_chunk = smb_get_next_file_chunk;
+  request->put_next_file_chunk = smb_put_next_file_chunk;
+  request->end_transfer = smb_end_transfer;
+  request->abort_transfer = NULL;
+  request->stat_filename = smb_stat_filename;
+  request->list_files = smb_list_files;
+  request->get_next_file = smb_get_next_file;
+  request->get_file_size = smb_get_file_size;
+  request->chdir = smb_chdir;
+  request->rmdir = smb_rmdir;
+  request->rmfile = smb_rmfile;
+  request->mkdir = smb_mkdir;
+  request->rename = smb_rename;
+  request->chmod = NULL;
+  request->set_file_time = NULL;
+  request->site = NULL;
+  request->parse_url = NULL;
+  request->set_config_options = NULL;
+  request->swap_socks = smb_swap_socks;
+
+  request->always_connected = 0;
+  request->need_hostport = 1;
+  request->need_username = 1;
+  request->need_password = 1;
+  request->use_cache = 0;
+  request->use_local_encoding = 0;
+
+  spd = g_malloc0 (sizeof (*spd));
+  request->protocol_data = spd;
+
+  return (gftp_set_config_options (request));
+}
