+static int
+smb_get_next_file (gftp_request * request, gftp_file * fle, int fd)
+{
+  smb_protocol_data *spd;
+  struct smb2dirent *entry;
+
+  g_return_val_if_fail (request != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (fle != NULL, GFTP_EFATAL);
+  spd = request->protocol_data;
+  g_return_val_if_fail (spd != NULL, GFTP_EFATAL);
+  g_return_val_if_fail (spd->smb2 != NULL, GFTP_EFATAL);
+
+  (void) fd;
+  if (spd->share_enum_reply != NULL)
+    {
+      struct srvsvc_SHARE_INFO_1_CONTAINER *shares;
+      struct srvsvc_SHARE_INFO_1 *share;
+
+      shares = &spd->share_enum_reply->ses.ShareEnum.Level1;
+      if (spd->share_enum_index >= shares->EntriesRead)
+        {
+          smb2_free_data (spd->smb2, spd->share_enum_reply);
+          spd->share_enum_reply = NULL;
+          spd->share_enum_index = 0;
+          return (0);
+        }
+
+      share = &shares->share_info_1[spd->share_enum_index++];
+      fle->file = g_strdup (share->netname);
+      fle->size = 0;
+      fle->datetime = 0;
+      fle->st_mode = S_IFDIR | S_IRUSR | S_IWUSR | S_IXUSR |
+                     S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH;
+      fle->user = g_strdup (_("-"));
+      fle->group = g_strdup (_("-"));
+      return (1);
+    }
+
+  g_return_val_if_fail (spd->dir != NULL, GFTP_EFATAL);
+  do
+    entry = smb2_readdir (spd->smb2, spd->dir);
+  while (entry != NULL &&
+         (strcmp (entry->name, ".") == 0 || strcmp (entry->name, "..") == 0));
+
+  if (entry == NULL)
+    return (0);
+
+  fle->file = g_strdup (entry->name);
+  fle->size = (off_t) entry->st.smb2_size;
+  fle->datetime = (time_t) entry->st.smb2_mtime;
+  if (entry->st.smb2_type == SMB2_TYPE_DIRECTORY)
+    fle->st_mode = S_IFDIR | S_IRUSR | S_IWUSR | S_IXUSR |
+                   S_IRGRP | S_IXGRP | S_IROTH | S_IXOTH;
+  else
+    fle->st_mode = S_IFREG | S_IRUSR | S_IWUSR | S_IRGRP | S_IROTH;
+  fle->user = g_strdup (_("-"));
+  fle->group = g_strdup (_("-"));
+  return (1);
+}
