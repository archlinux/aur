+/// Brings `data` into the form an [`Entry`] keeps: text as it is, images
+/// PNG-encoded.
+///
+/// PNG input is kept verbatim; only its header is parsed, to check that it is
+/// an image at all and to reject what could not be decoded later.
+fn encode_content(data: &[u8], mime: &mime::Mime) -> Result<Content, Error> {
+    if mime.type_() == mime::TEXT {
+        return Ok(Content::Plaintext(String::from_utf8_lossy(data).to_string()));
+    }
+
+    if mime.type_() != mime::IMAGE {
+        return Err(Error::FormatNotAvailable);
+    }
+
+    let image_format = match mime.subtype() {
+        mime::PNG => {
+            if png_dimensions(data).is_none() {
+                return Err(Error::FormatNotAvailable);
+            }
+            return Ok(Content::Image {
+                byte_length: data.len(),
+                png: Some(Bytes::copy_from_slice(data)),
+            });
+        }
+        mime::JPEG => image::ImageFormat::Jpeg,
+        mime::GIF => image::ImageFormat::Gif,
+        mime::BMP => image::ImageFormat::Bmp,
+        _ => return Err(Error::FormatNotAvailable),
+    };
+
+    let mut reader = image::ImageReader::new(std::io::Cursor::new(&data));
+    reader.set_format(image_format);
+    let image = reader.decode().context(ConvertImageSnafu {})?.into_rgba8();
+    let (width, height) = image.dimensions();
+    let png = encode_as_png(width as usize, height as usize, &image.into_raw())?;
+
+    Ok(Content::Image { byte_length: png.len(), png: Some(Bytes::from(png)) })
+}
+
+fn decode_png(png: &[u8]) -> Result<ClipboardContent, Error> {
+    let mut reader = image::ImageReader::new(std::io::Cursor::new(png));
+    reader.set_format(image::ImageFormat::Png);
+    let image = reader.decode().context(ConvertImageSnafu {})?.into_rgba8();
+    let (width, height) = image.dimensions();
+    Ok(ClipboardContent::Image {
+        width: width as usize,
+        height: height as usize,
+        bytes: Bytes::from(image.into_raw()),
+    })
+}
+
+/// Reads the dimensions out of a PNG header, without decoding the image.
+fn png_dimensions(png: &[u8]) -> Option<(usize, usize)> {
+    let mut reader = image::ImageReader::new(std::io::Cursor::new(png));
+    reader.set_format(image::ImageFormat::Png);
+    reader.into_dimensions().ok().map(|(width, height)| (width as usize, height as usize))
+}
+
 fn encode_as_png(width: usize, height: usize, bytes: &[u8]) -> Result<Vec<u8>, Error> {
     let (width, height) =
         (u32::try_from(width).unwrap_or_default(), u32::try_from(height).unwrap_or_default());
@@ -297,17 +461,24 @@ fn encode_as_png(width: usize, height: usize, bytes: &[u8]) -> Result<Vec<u8>, E
