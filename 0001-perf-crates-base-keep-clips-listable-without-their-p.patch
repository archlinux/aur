+        Content::Plaintext(text) => hasher.update(text.as_bytes()),
+        Content::Image { png, .. } => hasher.update(png.as_ref().map_or(&[][..], |png| png)),
     }
     hasher.finalize().to_vec()
 }
 
+/// The identifier of a clip is the head of its digest, so that it can be told
+/// without the clip itself being at hand, and stays the same across restarts.
+fn derive_id(sha256_digest: &[u8]) -> u64 {
+    let mut head = [0u8; 8];
+    let len = head.len().min(sha256_digest.len());
+    head[..len].copy_from_slice(&sha256_digest[..len]);
+    u64::from_le_bytes(head)
+}
