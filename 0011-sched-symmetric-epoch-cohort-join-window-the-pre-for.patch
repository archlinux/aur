     f.build();
@@ -4784,6 +4794,118 @@ TEST(epoch_W5_preemption_after_join_is_permanent) {
     CHECK_EQ(f.sch.metrics().epochs, 2);             /* the next epoch formed without a re-join */
 }
 
+/* W6 (join window, the symmetric side): the reachable pre-formation join. A PREFILL epoch forms
+ * with a running decode-class row -- a cut, class-guarded at formation, created BEFORE the
+ * formation instant. The one-sided window excluded it forever; the symmetric window admits it
+ * once its class flips into the epoch's, and the flip is reachable here: the epoch governs
+ * prefill, so admission stays open, and a cut preempted under KV pressure replays from zero --
+ * req_class_prefill counts a preempted one's replay as prefill -- and the planning-pass scan
+ * joins it from waiting_. The other cut arrived 5.001 s before the formation: outside the
+ * window on the pre side too, it stays a mid-arrival no matter how it flips. */
+TEST(epoch_W6_preformation_cut_joins_after_its_flip) {
+    Fixture f;
+    f.build(/*blocks=*/156, /*states=*/64);          /* 2496 tokens: a+b+c do not fit, a+c do */
+    f.cfg.prefill_interleave = Config::kPrefillInterleaveEpoch;
+    f.cfg.prefix_cache = false;
+    CHECK_OK(f.start());
+    const uint64_t a = f.submit(2000, 512);
+    CHECK(f.sch.step() != nullptr);                  /* PF epoch E1 {a} */
+    CHECK_EQ(f.sch.metrics().epochs, 1);
+    f.advance_clock_ms(5001);                        /* past E1's window: b, c stay mid-arrivals */
+    const uint64_t b = f.submit(300, 512);           /* mid-arrival: runs beside the cohort */
+    for (int k = 0; k < 200; ++k) {                  /* a places its last chunk; b long decoding */
+        Request* ra = f.sch.find(a);
+        Request* rb = f.sch.find(b);
+        if (ra && ra->n_computed >= 2000 && rb && rb->n_computed >= 300) break;
+        CHECK(f.sch.step() != nullptr);
+        f.commit_plain(12);
+    }
+    REQUIRE(f.sch.find(a)->n_computed >= 2000);
+    REQUIRE(f.sch.find(b)->n_computed >= 300);
+    const uint64_t c = f.submit(2000, 8, /*priority=*/1);   /* refused: a and b hold the pool, and
+        * a chunk of it will not fit beside them. The priority makes it the queue's leader, so the
+        * epoch that forms with it queued governs PREFILL (epoch_form_locked's waiting-lead rule)
+        * and the two running decoders are its cuts. */
+    CHECK_EQ((int)f.sch.find(c)->state, (int)ReqState::Waiting);
+    for (int k = 0; k < 200; ++k) {                  /* a's phase completion closes E1; the next */
+        CHECK(f.sch.step() != nullptr);              /* pass forms E2 with c queued: PF, and the */
+        if (f.sch.metrics().epochs >= 2) break;      /* two running decoders are pre-formation cuts */
+        f.commit_plain(12);
+    }
+    CHECK_EQ(f.sch.metrics().epochs, 2);
+    CHECK_EQ(f.sch.metrics().midarrival_cuts, 2);    /* a and b: the class-guarded cuts */
+    CHECK_EQ(f.sch.metrics().epoch_cohort_joins, 0); /* nothing has flipped yet */
+    /* The liveness net runs the frozen cuts (the governing class cannot fill the plan: c is
+     * refused admission); a grows into the KV wall; the [R7] tier-0 walk takes b, the cut
+     * behind it. A cut is not a member, so the preemption revokes nothing [OD1]. */
+    bool preempted = false;
+    for (int k = 0; k < 1500 && !preempted; ++k) {
+        CHECK(f.sch.step() != nullptr);
+        Request* rb = f.sch.find(b);
+        if (rb && rb->state == ReqState::Preempted) preempted = true;
+        if (preempted) break;
+        f.commit_plain(12);
+    }
+    REQUIRE(preempted);
+    /* The replay reads prefill-class: the next scan sees an in-window (d ~= 0, pre side),
+     * unrevoked cut of the epoch's class -- and joins it. */
+    CHECK(f.sch.step() != nullptr);
+    CHECK_EQ(f.sch.metrics().epoch_cohort_joins, 1);
+    /* a is the same shape -- a pre-formation cut -- but 5.001 s before the formation: the
+     * window's pre side excludes it as surely as the post side excludes a late arrival. */
+    for (int k = 0; k < 50; ++k) {
+        CHECK(f.sch.step() != nullptr);
+        f.commit_plain(12);
+    }
+    CHECK_EQ(f.sch.metrics().epoch_cohort_joins, 1); /* a never joins */
+    CHECK_EQ(f.sch.metrics().epochs, 2);             /* and the drain still holds E2 open */
+}
+
+/* BY DESIGN -- owner-accepted 2026-11-21, do-not-change-without-owner: this pins the accepted
+ * cost of cohort-epoch governance, the load test's zombie-row window. A same-instant burst lands
+ * on a live DECODE epoch: the leader flips on its first commit and the epoch forms on the next
+ * planning pass, so the burst's arrived_us predates epoch_formation_us_. The symmetric window
+ * (epoch_joinable_locked) now covers that edge, but a QUEUED row is not a cut -- formation never
+ * saw it running -- so the pre-formation side does not admit it; the class guard excludes it
+ * (prefill-class rows, a decode epoch), and the DE epoch freezes admission, so it can never flip
+ * into the class. It waits out the cohort's FULL generation -- the E5 tail, bounded by the
+ * cohort's max_tokens -- with every counter silent (a waiting row is not held-counted, not a
+ * cut, not a join). The owner weighed this against the live load-test forensics and kept it:
+ * no admission change, no drain cap. The join counter's honest name for this state is silence. */
+TEST(epoch_same_burst_waits_out_live_decode_epoch_by_design) {
+    Fixture f;
+    f.build();
+    f.cfg.prefill_interleave = Config::kPrefillInterleaveEpoch;
+    f.cfg.prefix_cache = false;
+    CHECK_OK(f.start());
+    const uint64_t a = f.submit(100, 64);             /* the leader: one chunk, then decode */
+    CHECK(f.sch.step() != nullptr);                   /* PF epoch {a} */
+    f.commit_plain(12);                               /* a flips, drops: the epoch drains */
+    const uint64_t b = f.submit(512, 64);             /* same burst: no clock move between them */
+    const int64_t joins0 = f.sch.metrics().epoch_cohort_joins;
+    const int64_t held0 = f.sch.metrics().steps_held + f.sch.metrics().steps_held_decode;
+    CHECK(f.sch.step() != nullptr);                   /* DECODE epoch {a} forms on this pass */
+    CHECK_EQ(f.sch.metrics().epochs, 2);
+    int steps = 0;
+    while (steps < 200) {
+        CHECK(f.sch.step() != nullptr);
+        if (f.sch.metrics().epochs >= 3) break;       /* the boundary pass: formation + admission */
+        CHECK_EQ((int)f.sch.find(b)->state, (int)ReqState::Waiting);
+        f.commit_plain(12);
+        ++steps;
+    }
+    REQUIRE(f.sch.metrics().epochs == 3);
+    CHECK(f.sch.find(a) == nullptr ||
+          f.sch.find(a)->state != ReqState::Running); /* the cohort closed at its max_tokens */
+    CHECK(steps >= 40);                               /* the wait is the full generation */
+    CHECK_EQ(f.sch.metrics().epoch_cohort_joins, joins0);   /* the gate excludes b permanently */
+    CHECK_EQ(f.sch.metrics().midarrival_cuts, 0);     /* queued: not a cut either */
+    CHECK_EQ(f.sch.metrics().steps_held + f.sch.metrics().steps_held_decode, held0);
+    bool b_chunk = false;                             /* b is admitted at the boundary */
+    for (const StepEntry& e : f.sch.plan().e) if (e.seq == b && e.is_prefill) b_chunk = true;
+    CHECK(b_chunk);
+}
+
 /* The prompt is the oldest: its class governs, the decoder admitted beside it is frozen while
  * the prompt runs, and the chunk takes the whole step the frozen row would have shared. When
  * the prompt's last chunk lands, the head turns into a decoder and the lanes reopen. */
