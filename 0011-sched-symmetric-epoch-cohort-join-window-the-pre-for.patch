 bool Scheduler::epoch_joinable_locked(const SchedReq& s) const {
     if (!epoch_live_ || s.epoch_revoked) return false;
-    if (s.arrived_us < epoch_formation_us_) return false;
-    if (s.arrived_us - epoch_formation_us_ > kEpochCohortJoinWindowMs * 1000) return false;
