From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marko Lemmetty <marko.lemmetty@jollamobile.com>
Date: Fri, 15 May 2020 14:47:19 +0300
Subject: [PATCH] Add -p to copyprj to enable copying of prjconf

---
 osc/commandline.py | 3 +++
 osc/core.py        | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/osc/commandline.py b/osc/commandline.py
index 93dd9238198301c15772c4e5a20ca0092b6cd17a..9469532416b8562936f12afa27e2f8d33fb5aa40 100644
--- a/osc/commandline.py
+++ b/osc/commandline.py
@@ -1872,6 +1872,8 @@ class Osc(cmdln.Cmdln):
                         help='replicate the history of each package.')
     @cmdln.option('-o', '--make-older', action='store_true',
                         help='No idea')
+    @cmdln.option('-p', '--prjconf', action='store_true',
+                        help='copy the prjconf also')
     @cmdln.option('-r', '--re-sign', action='store_true',
                         help='re-sign the binaries')
     @cmdln.option('-m', '--message', metavar='TEXT',
@@ -1914,6 +1916,7 @@ class Osc(cmdln.Cmdln):
         r = copy_prj(src_apiurl, src_project, dst_project,
                      withbinaries = opts.with_binaries,
                      withhistory = opts.with_history,
+                     withprjconf = opts.prjconf,
                      makeolder = opts.make_older,
                      resign = opts.re_sign,
                      now = opts.now,
diff --git a/osc/core.py b/osc/core.py
index c2c87fe4a423a75e2e7f4ab3d51f494da90a8fc0..47a6b3f4274890a6694645b92346ad4709334d23 100644
--- a/osc/core.py
+++ b/osc/core.py
@@ -3817,8 +3817,10 @@ def copy_pac(
 def copy_prj(src_apiurl, src_project, dst_project,
              withbinaries = False,
              withhistory = False,
+             withprjconf = False,
              makeolder = False,
              resign = False,
+             now = False,
              comment = None):
     """
     Create a copy of a project.
@@ -3832,6 +3834,8 @@ def copy_prj(src_apiurl, src_project, dst_project,
         query['withbinaries'] = '1'
     if withhistory:
         query['withhistory'] = '1'
+    if withprjconf:
+        query['withprjconf'] = '1'
     if makeolder:
         query['makeolder'] = '1'
     if resign:
@@ -3840,6 +3844,7 @@ def copy_prj(src_apiurl, src_project, dst_project,
         query['comment'] = comment
     if now:
         query['nodelay'] = '1'
+
     u = makeurl(src_apiurl, ['source', dst_project], query=query)
     print("copyprj ", u, file=sys.stderr)
     f = http_POST(u)
