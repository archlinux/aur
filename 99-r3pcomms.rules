# allow r/w access by users of the efusb group to the river 3 plus
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3746", ATTRS{idProduct}=="ffff", MODE="0660", GROUP="efusb"
#ACTION=="add", SUBSYSTEM=="hidraw", DEVPATH=="*0003:3746:FFFE*", MODE="0660", GROUP="efusb", SYMLINK+="hidraw-ef"


# This udev rule was generated by udev-hid-bpf install "${srcdir}/hid_fixes/r3p_fix_hid.bpf.o"
ACTION!="add|remove", GOTO="hid_bpf_end"
SUBSYSTEM!="hid", GOTO="hid_bpf_end"

# r3p_fix_hid.bpf.o 
ACTION=="add",ENV{MODALIAS}=="hid:b0003g0001v00003746p0000FFFF", RUN{program}+="/usr/bin/udev-hid-bpf add $sys$devpath /etc/udev-hid-bpf/r3p_fix_hid.bpf.o"
ACTION=="remove",ENV{MODALIAS}=="hid:b0003g0001v00003746p0000FFFF", RUN{program}+="/usr/bin/udev-hid-bpf remove $sys$devpath "

LABEL="hid_bpf_end"
