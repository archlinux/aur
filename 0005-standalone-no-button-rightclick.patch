+	g_signal_connect (G_OBJECT(ma->panel_data), "button-press-event", G_CALLBACK(standalone_rightclick_cb), menu);
+
+	if (button_config != NULL)
+		g_signal_connect (G_OBJECT(button_config), "clicked", G_CALLBACK(standalone_settingsmenu_cb), menu);
 }
 
