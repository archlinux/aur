+
+static gboolean
+standalone_rightclick_cb (GtkWidget *widget, GdkEventButton *event, GtkMenu *menu)
+{
+	if (event->button != 3)
+		return GDK_EVENT_PROPAGATE;
+
+	gtk_menu_popup_at_pointer (menu, (GdkEvent*)event);
+	return GDK_EVENT_STOP;
+}
