+	$(CC) -c $(CPPFLAGS) $(CFLAGS) $(P_DEFINES) $(LDFLAGS) primer3_boulder_main.c
 
 masker.o: masker.c masker.h libprimer3.h
-	$(CC) -c $(CFLAGS) $(P_DEFINES) masker.c
