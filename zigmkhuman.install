post_install() {
  cat <<'EOF'
ZigMakeHuman was installed.

Launcher:
  /usr/bin/zigmkhuman

Demo client:
  /usr/bin/zigmkhuman-api-client

Default API endpoint:
  http://127.0.0.1:18080/

Config file:
  ~/makehuman/v1py3/zigmkhuman_aiohttp_api.json

Example:
  zigmkhuman-api-client health
EOF
}

post_upgrade() {
  post_install
}
