post_install() {
    echo ""
    echo "  ╔══════════════════════════════════════╗"
    echo "  ║         rmpv installed!              ║"
    echo "  ║                                      ║"
    echo "  ║  Run this once to finish setup:      ║"
    echo "  ║     rmpv-setup                       ║"
    echo "  ║                                      ║"
    echo "  ║  It will copy mpv + rmpc configs     ║"
    echo "  ║  and ask for your Music dir path.    ║"
    echo "  ╚══════════════════════════════════════╝"
    echo ""
    echo "Note: rmpc is recommended. If not installed, use your "
    echo "preferred AUR helper (e.g., yay -S rmpc)."
}

post_upgrade() {
    post_install
}
