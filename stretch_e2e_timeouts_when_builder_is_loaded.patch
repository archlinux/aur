+def pytest_collection_modifyitems(
+    config: pytest.Config, items: list[pytest.Item]
+) -> None:
+    # Per-test wall-clock caps assume an idle machine; stretch them by the
+    # same factor as the helper deadlines in tests.e2e.common.
