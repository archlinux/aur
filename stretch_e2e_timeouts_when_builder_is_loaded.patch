+def time_scale() -> float:
+    # Wall-clock budgets in this suite assume an idle machine. Packaged builds
+    # run on a loaded builder, so allow stretching them. Only values above 1
+    # apply; anything else is treated as the default scale of 1.
+    try:
+        scale = float(os.environ.get("VIBE_TEST_TIME_SCALE", ""))
+    except ValueError:
+        return 1.0
+    return scale if scale > 1.0 else 1.0
+
+
+def scaled_timeout(timeout: float) -> float:
+    return timeout * time_scale()
+
