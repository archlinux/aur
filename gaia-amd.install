post_install() {
    systemctl daemon-reload

    echo ""
    echo "=========================================="
    echo " gaia-amd installed"
    echo "=========================================="
    echo ""
    echo "QUICK START (no systemd required):"
    echo "  gaia-amd-webui      # Launch the Electron desktop app"
    echo "                      # (starts its own backend automatically)"
    echo ""
    echo "LEMONADE SERVER (LLM backend):"
    echo "  The Gaia backend requires lemonade-server to be running."
    echo ""
    echo "  As a system service (starts on boot, all users):"
    echo "    sudo systemctl enable --now lemond.service"
    echo ""
    echo "  As a user service (starts on login, current user only):"
    echo "    systemctl --user enable --now lemond.service"
    echo ""
    echo "  IMPORTANT: Gaia requires ctx_size >= 32768 in lemonade's config."
    echo "  The default (4096) is too small and causes a 'context window too"
    echo "  small' error in the Gaia web UI. Set it to at least 65536 in:"
    echo "    /var/lib/lemonade/.cache/lemonade/config.json"
    echo "  then restart lemond."
    echo ""
    echo "GAIA AGENT UI (web interface via systemd):"
    echo ""
    echo "  As a system service:"
    echo "    sudo systemctl enable --now gaia.service"
    echo "    # Runs as the 'gaia' system user, UI at http://localhost:4200"
    echo ""
    echo "  As a user service:"
    echo "    systemctl --user enable --now gaia.service"
    echo "    # Runs as your user, UI at http://localhost:4200"
    echo ""
    echo "=========================================="
    echo ""
}

post_upgrade() {
    systemctl daemon-reload
    if systemctl is-system-running --quiet 2>/dev/null; then
        systemctl try-restart gaia.service
    fi
    systemctl --user daemon-reload 2>/dev/null || true
}

post_remove() {
    systemctl disable --now gaia.service 2>/dev/null || true
    systemctl --user disable --now gaia.service 2>/dev/null || true
    systemctl daemon-reload
}
