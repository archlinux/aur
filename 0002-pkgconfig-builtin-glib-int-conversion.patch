+++    (guintptr) __atomic_fetch_or (gapa_atomic, (val), __ATOMIC_SEQ_CST);        \
++   }))
++ #define g_atomic_pointer_xor(atomic, val) \
++   (G_GNUC_EXTENSION ({                                                          \
+++    guintptr *gapa_atomic = (guintptr *) atomic;                             \
