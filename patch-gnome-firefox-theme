#!/usr/bin/env bash
set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	printf 'Usage: %s [--remove] [THEME_DIR]\n' "${0##*/}"
	exit 0
fi

action="patch"
if [ "${1:-}" = "--remove" ]; then
	action="remove"
	shift
fi

theme_dir="${1:-${FIREFOX_GNOME_THEME_DIR:-/usr/lib/firefox-gnome-theme}}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -n "${GNOME_PYWALFOX_CSS_SOURCE:-}" ]; then
	source_css="$GNOME_PYWALFOX_CSS_SOURCE"
elif [ -f "$script_dir/pywalfox-colors.css" ]; then
	source_css="$script_dir/pywalfox-colors.css"
else
	source_css="/usr/share/gnome-pywalfox-theme/pywalfox-colors.css"
fi
chrome_entry_file="$theme_dir/userChrome.css"
entry_file="$theme_dir/theme/gnome-theme.css"
content_entry_file="$theme_dir/userContent.css"
target_css="$theme_dir/theme/colors/pywalfox.css"
custom_chrome_file="$theme_dir/customChrome.css"
custom_content_file="$theme_dir/customContent.css"
theme_root_import_line='@import "theme/colors/pywalfox.css";'
legacy_chrome_import_line='@import "colors/pywalfox.css";'
chrome_custom_anchor='@import "customChrome.css"; /**/'
content_custom_anchor='@import "customContent.css"; /**/'
legacy_chrome_anchor='@import "extensions/adaptive-tab-bar-colour.css" screen and -moz-pref("gnomeTheme.extensions.adaptiveTabBarColour");'
legacy_content_anchor='@import "theme/pages/privatebrowsing.css";'

theme_tree_complete() {
	[ -d "$theme_dir/theme/colors" ] &&
		[ -f "$chrome_entry_file" ] &&
		[ -f "$entry_file" ] &&
		[ -f "$content_entry_file" ]
}

if ! theme_tree_complete; then
	if [ "$action" = "remove" ]; then
		printf 'Firefox GNOME Theme directory not found; nothing to remove from %s\n' "$theme_dir"
		exit 0
	fi

	printf 'Firefox GNOME Theme directory not found or incomplete: %s\n' "$theme_dir" >&2
	exit 1
fi

if [ "$action" = "patch" ] && [ ! -f "$source_css" ]; then
	printf 'Pywalfox GNOME color bridge not found: %s\n' "$source_css" >&2
	exit 1
fi

require_anchor() {
	local file="$1"
	local anchor="$2"

	if ! grep -Fxq "$anchor" "$file"; then
		printf 'Import anchor not found in %s\n' "$file" >&2
		exit 42
	fi
}

has_anchor() {
	local file="$1"
	local anchor="$2"

	grep -Fxq "$anchor" "$file"
}

ensure_import() {
	local file="$1"
	local anchor="$2"
	local import_line="$3"
	local tmp
	local status

	tmp="$(mktemp)"
	if awk -v anchor="$anchor" -v import_line="$import_line" '
		$0 == import_line {
			next
		}
		{
			print
		}
		$0 == anchor && !inserted {
			print import_line
			inserted = 1
		}
		END {
			if (!inserted) {
				exit 42
			}
		}
	' "$file" > "$tmp"; then
		chmod --reference="$file" "$tmp"
		chown --reference="$file" "$tmp"
		mv "$tmp" "$file"
	else
		status="$?"
		rm -f "$tmp"
		if [ "$status" -eq 42 ]; then
			printf 'Import anchor not found in %s\n' "$file" >&2
		fi
		exit "$status"
	fi
}

ensure_import_at_top() {
	local file="$1"
	local import_line="$2"
	local tmp
	local status

	tmp="$(mktemp)"
	if [ -f "$file" ]; then
		if awk -v import_line="$import_line" '
			!started {
				started = 1
				if ($0 ~ /^@charset /) {
					print
					print import_line
					print ""
					next
				}
				print import_line
				print ""
			}
			$0 != import_line {
				print
			}
			END {
				if (!started) {
					print import_line
				}
			}
		' "$file" > "$tmp"; then
			chmod --reference="$file" "$tmp"
			chown --reference="$file" "$tmp"
		else
			status="$?"
			rm -f "$tmp"
			exit "$status"
		fi
	else
		printf '%s\n' "$import_line" > "$tmp"
		chmod 0644 "$tmp"
	fi
	mv "$tmp" "$file"
}

remove_import() {
	local file="$1"
	local import_line="$2"
	local tmp
	local status

	if [ ! -f "$file" ]; then
		return
	fi

	if ! grep -Fxq "$import_line" "$file"; then
		return
	fi

	tmp="$(mktemp)"
	if awk -v import_line="$import_line" '
		$0 != import_line {
			print
		}
	' "$file" > "$tmp"; then
		chmod --reference="$file" "$tmp"
		chown --reference="$file" "$tmp"
		mv "$tmp" "$file"
	else
		status="$?"
		rm -f "$tmp"
		exit "$status"
	fi
}

if [ "$action" = "remove" ]; then
	remove_import "$entry_file" "$legacy_chrome_import_line"
	remove_import "$content_entry_file" "$theme_root_import_line"
	remove_import "$custom_chrome_file" "$theme_root_import_line"
	remove_import "$custom_content_file" "$theme_root_import_line"
	rm -f "$target_css"
	chmod 0644 "$chrome_entry_file" "$entry_file" "$content_entry_file"
	[ ! -f "$custom_chrome_file" ] || chmod 0644 "$custom_chrome_file"
	[ ! -f "$custom_content_file" ] || chmod 0644 "$custom_content_file"
	printf 'Removed Firefox GNOME Theme color patch from %s\n' "$theme_dir"
	exit 0
fi

use_custom_imports=false
if has_anchor "$chrome_entry_file" "$chrome_custom_anchor" && has_anchor "$content_entry_file" "$content_custom_anchor"; then
	use_custom_imports=true
else
	require_anchor "$entry_file" "$legacy_chrome_anchor"
	require_anchor "$content_entry_file" "$legacy_content_anchor"
fi

install -Dm644 "$source_css" "$target_css"
remove_import "$entry_file" "$legacy_chrome_import_line"
remove_import "$content_entry_file" "$theme_root_import_line"
if [ "$use_custom_imports" = "true" ]; then
	ensure_import_at_top "$custom_chrome_file" "$theme_root_import_line"
	ensure_import_at_top "$custom_content_file" "$theme_root_import_line"
	chmod 0644 "$custom_chrome_file" "$custom_content_file"
else
	ensure_import "$entry_file" "$legacy_chrome_anchor" "$legacy_chrome_import_line"
	ensure_import "$content_entry_file" "$legacy_content_anchor" "$theme_root_import_line"
fi
chmod 0644 "$chrome_entry_file" "$entry_file" "$content_entry_file" "$target_css"
printf 'Patched Firefox GNOME Theme colors in %s\n' "$theme_dir"
