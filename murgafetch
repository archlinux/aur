#!/bin/bash

# Ascii
ascii_art=(
"@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"
"@@@@@@@@@@@@  @@@@@@@@@@@@@@@@@@@@@@@@@"
"@@@@@@@@@@@@@@@@@        #@@@@@@@@@@@@@"
"@@@@@@%@@@@@@@               :@@@@@@@@@"
"@@@@@@@@   .            .      :@@@=@@@"
"+@@@@#.:-......         ....- :@@@@@%=="
"@@@=...                    ...  @@+@@@@"
"@@.. .  .               :@@.  .  @@@@@@"
"@@.                 +@@@%  .@@:  @@@@@@"
"@@@@@@@@@%%.-###@@@@@=:  #@-  .. =@  @@"
"@@+:@@@@@@@@.   .-%#@ @@@ @@@*:: -@  @@"
"@@ @@      %.  ..  =##-   ..   . @@ .@@"
"@@  ..+.  -+   . .             . %  @@@"
"@@ ..   =*%+  =-  .   .      ..- @  @@@"
"@@ : . : **.   :.=#..          . @  @@@"
"@@-... : #        #.#:  .   :.. @@ @@@@"
"@@@.. :  #@@+*###    +..   .    @@@@@@@"
"@@@:. @@@@@@@@@@@      .. .   :%@@@@@@@"
"%@@@ @@@@@#    @@@@@@@@% .   % @@@@@@@@"
"@@@@@    %# =+#*   # =@@ .  #%@@@@@@@@@"
"@@@@@@+ ..@@*- *##+.      .%@@@@@@@@@@@"
"@@@@@@@%  -.@@@* =.     +@@@@@@@@@@@@@@"
"@@@@@@@@@          . @@@@@@@@@@ @ *  : "
"@@@@@@@@@@@@@@@%-%@@@@@@@@@@%:@#@@=@-.*"
"@@@@@@@#@+#*@@@@@@@@@@@@@@##@@@@%#@@@@@"
)

# Obtener información del sistema
info_lines=(
"user=$(whoami)@$(hostname)"
"os=$(grep "^PRETTY_NAME" /etc/os-release | cut -d= -f2 | tr -d '"')"
"kernel=$(uname -r)"
"uptime=$(uptime -p)"
"disk=$(df -h / | awk 'NR==2 {print $3 " / " $2 " used"}')"
"available RAM="$(free -h | awk '/Mem:/ {print $3}')" / "$(free -h | awk '/Mem:/ {print $2}')""
)
# Determinar el número máximo de líneas
max_lines=${#ascii_art[@]}
if [ ${#info_lines[@]} -gt $max_lines ]; then
  max_lines=${#info_lines[@]}
fi

# Imprimir lado a lado
for (( i=0; i<max_lines; i++ )); do
  art="${ascii_art[i]}"
  info="${info_lines[i]}"
  printf "\033[1;36m%-15s\033[0m  %s\n" "$art" "$info"
done


