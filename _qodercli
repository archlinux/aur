#compdef qodercli

# Zsh completion for qodercli
# Generated for qodercli AUR package

_qodercli() {
  local -a commands
  commands=(
    'jobs:List concurrent job(s) for current workspace'
    'rm:Remove concurrent job(s) for current workspace'
    'feedback:Submit feedback with optional images'
    'help:Help about any command'
    'mcp:Manage MCP (Model Context Protocol) servers'
    'status:Show account and CLI status'
    'update:Check remote version and self-update to the latest release'
  )

  local -a global_flags
  global_flags=(
    '--agents[JSON object defining custom agents]:agents:'
    '--allowed-tools[Comma or space-separated list of allowed tool names]:allowed-tools:'
    '--attachment[Attachment path]:attachment:_files'
    '--branch[Branch name]:branch:'
    {-c,--continue}'[Continue the most recent conversation]'
    '--dangerously-skip-permissions[Bypass all permission checks]'
    '--disallowed-tools[Comma or space-separated list of disallowed tool names]:disallowed-tools:'
    {-h,--help}'[help for qodercli]'
    '--input-format[Input format for non-interactive mode]:input-format:(text stream-json)'
    '--max-output-tokens[Max tokens for model output response]:max-output-tokens:(16k 32k)'
    '--max-turns[Maximum agent loop cycles]:max-turns:'
    '--model[Specify the model level to use for the session]:model:(auto efficient gmodel kmodel lite mmodel performance q35model qmodel ultimate)'
    {-f,--output-format}'[Output format for non-interactive mode]:output-format:(text json stream-json)'
    '--path[Worktree path of the worktree job]:path:_directories'
    {-p,--print}'[Print response and exit]:print:'
    {-q,--quiet}'[Hide spinner in non-interactive mode]'
    {-r,--resume}'[Resume a conversation]:resume:'
    {-v,--version}'[Version]'
    '--with-claude-config[Load claude code configurations]'
    {-w,--workspace}'[Current working directory]:workspace:_directories'
    '--worktree[Start a concurrent job via git worktree]'
    '--yolo[Bypass all permission checks]'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    $global_flags \
    '1: :->cmds' \
    '*::arg:->args'

  case $state in
    cmds)
      _describe -t commands 'qodercli commands' commands
      ;;
    args)
      case $words[1] in
        jobs)
          _qodercli_jobs
          ;;
        rm)
          _qodercli_rm
          ;;
        feedback)
          _qodercli_feedback
          ;;
        mcp)
          _qodercli_mcp
          ;;
        status)
          _qodercli_status
          ;;
        update)
          _qodercli_update
          ;;
        help)
          _describe -t commands 'qodercli commands' commands
          ;;
      esac
      ;;
  esac
}

_qodercli_jobs() {
  _arguments \
    {-a,--all}'[Show all concurrent jobs]' \
    {-h,--help}'[help for jobs]' \
    {-w,--workspace}'[Current working directory]:workspace:_directories'
}

_qodercli_rm() {
  _arguments \
    {-h,--help}'[help for rm]' \
    '--kubeconfig[Kubeconfig of the kubernetes job]:kubeconfig:_files' \
    '--namespace[Namespace of the kubernetes job]:namespace:' \
    {-w,--workspace}'[Current working directory]:workspace:_directories'
}

_qodercli_feedback() {
  _arguments \
    {-c,--content}'[Feedback content]:content:' \
    {-h,--help}'[help for feedback]' \
    {-i,--images}'[Image file paths]:images:_files -g "*.png(*.jpg|.jpeg|.gif|.webp)"' \
    {-s,--session}'[Session ID]:session:' \
    '--workdir[Working directory]:workdir:_directories' \
    {-w,--workspace}'[Current working directory]:workspace:_directories'
}

_qodercli_mcp() {
  local -a mcp_commands
  mcp_commands=(
    'add:Add a new MCP server'
    'auth:Authenticate with an MCP server using OAuth'
    'get:Get details of an MCP server'
    'list:List all MCP servers'
    'remove:Remove an MCP Server'
  )

  _arguments \
    {-h,--help}'[help for mcp]' \
    {-w,--workspace}'[Current working directory]:workspace:_directories' \
    '1: :->mcp_cmds' \
    '*::arg:->args'

  case $state in
    mcp_cmds)
      _describe -t mcp_commands 'mcp commands' mcp_commands
      ;;
    args)
      case $words[1] in
        add)
          _qodercli_mcp_add
          ;;
        auth)
          _qodercli_mcp_auth
          ;;
        get)
          _qodercli_mcp_get
          ;;
        list)
          _qodercli_mcp_list
          ;;
        remove)
          _qodercli_mcp_remove
          ;;
      esac
      ;;
  esac
}

_qodercli_mcp_add() {
  _arguments \
    {-e,--env}'[Set environment variables]:env:' \
    {-H,--header}'[Set HTTP headers for SSE and HTTP transports]:header:' \
    {-h,--help}'[help for add]' \
    {-s,--scope}'[Configuration scope]:scope:(local user project)' \
    {-t,--transport}'[Transport type]:transport:(stdio sse http)' \
    {-w,--workspace}'[Current working directory]:workspace:_directories' \
    '1:name:' \
    '2:endpoint:'
}

_qodercli_mcp_auth() {
  _arguments \
    {-h,--help}'[help for auth]' \
    {-w,--workspace}'[Current working directory]:workspace:_directories' \
    '1:server-name:'
}

_qodercli_mcp_get() {
  _arguments \
    {-h,--help}'[help for get]' \
    {-w,--workspace}'[Current working directory]:workspace:_directories' \
    '1:name:'
}

_qodercli_mcp_list() {
  _arguments \
    {-h,--help}'[help for list]' \
    {-w,--workspace}'[Current working directory]:workspace:_directories'
}

_qodercli_mcp_remove() {
  _arguments \
    {-h,--help}'[help for remove]' \
    {-s,--scope}'[Configuration scope]:scope:(local user project)' \
    {-w,--workspace}'[Current working directory]:workspace:_directories' \
    '1:name:'
}

_qodercli_status() {
  _arguments \
    {-h,--help}'[help for status]' \
    {-o,--output}'[Output format]:output:(text json)' \
    {-w,--workspace}'[Current working directory]:workspace:_directories'
}

_qodercli_update() {
  # update command doesn't accept any arguments or flags
  _message 'update command does not accept any arguments'
}

_qodercli
