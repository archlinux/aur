post_install() {
  echo "==> smb-mount-controller installed"
  echo "==> Edit /etc/smb-controller.conf before running"
  echo "==> Run: sudo smb-controller OR sudo systemctl enable --now smb-controller.service"
}

post_upgrade() {
  echo "==> smb-mount-controller: check /etc/smb-controller.conf.pacnew if present"
}
