post_install() {
    cat <<EOF
==> Voxtype Post-installation Steps:

    1. Add your user to the 'input' group:
       sudo usermod -aG input \$USER

    2. Log out and back in for group changes to take effect

    3. Download a model:
       voxtype setup model

    4. Start voxtype:
       systemctl --user enable --now voxtype

EOF
}
