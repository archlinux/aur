[Desktop Entry]
Type=Application
Name=XYVR
Comment=XYVR is an address book application that lets you search through your VRChat, Resonite, and ChilloutVR contacts.
Version=@PACKAGE_VERSION@
Exec=xyvr %u
Icon=xyvr
Categories=Network;Chat;Game;
StartupWMClass=XYVR
Terminal=false
MimeType=x-scheme-handler/xyvr;
Path=/opt/xyvr