post_install() {
  cat << 'EOF'

==> complex-dwm-slock-git installed.

  Test first (does not need setuid, locks the running X session):
      slock -t

  Customisation (optional):
      ~/.config/slock/avatar.png   (or ~/.face)   avatar image
      ~/.config/slock/font.ttf                    custom font
  Defaults live in /usr/share/slock/.

  PAM service: /etc/pam.d/slock (kept across upgrades if you edit it).
  Docs: /usr/share/doc/complex-dwm-slock-git/README.md

  If you ever get stuck on the lock screen, switch to a TTY
  (Ctrl+Alt+F2), log in and run: pkill slock

EOF
}

post_upgrade() {
  post_install
}
