# apm.install
post_install() {
    echo "Configuring APM..."
    export PACKAGE_NAME="apm"
    
    systemctl daemon-reload || true
    systemctl enable apm-daily-update || true
    systemctl start apm-daily-update || true
    systemctl restart apparmor.service || true

    if [ -f /usr/lib/sysctl.d/apm.conf ]; then
        sysctl -p /usr/lib/sysctl.d/apm.conf 2>/dev/null || true
    fi

    systemctl reload apparmor || true

    # 桌面集成
    amber-pm-dstore-patch || true
    amber-pm-desktop-fix || true


    echo "========================================================"
    echo -e "  APM Daily updates are enabled by default."
    echo -e "  You can disable them with the following command:"
    echo -e "  systemctl stop apm-daily-update"
    echo -e "  systemctl disable apm-daily-update"
    echo "========================================================"
}

post_upgrade() {
    post_install

    if [ ! -f /var/lib/apm/.migrated-v2 ]; then
        echo "正在检查是否需要从旧版 APM 迁移软件包..."
        if /usr/bin/apm migrate; then
            touch /var/lib/apm/.migrated-v2 2>/dev/null || true
        else
            echo "自动迁移未完成。修复后请手动执行: sudo apm migrate"
        fi
    fi
}

pre_remove() {
    export PACKAGE_NAME="apm"
    
    systemctl stop apm-daily-update 2>/dev/null || true
    systemctl disable apm-daily-update 2>/dev/null || true
}

post_remove() {
    export PACKAGE_NAME="apm"
    echo "正在卸载 APM，并删除 /var/lib/apm 下的全部应用..."

    # 清理指向 /var/lib/apm 的桌面/图标/自启动等集成链接。
    # dstore-patch 创建的是相对链接，这里用 realpath 解析后再判断。
    for d in \
        /usr/share/applications /usr/local/share/applications /usr/local/share/applications/apm \
        /usr/share/icons /usr/local/share/icons \
        /etc/xdg/autostart \
        /usr/share/mime /usr/share/glib-2.0/schemas /usr/share/GConf \
        /usr/share/help /usr/share/locale /usr/share/pixmaps \
        /usr/share/polkit-1/actions /usr/share/fcitx /etc/fonts/conf.d; do
        [ -d "$d" ] || continue
        while IFS= read -r link; do
            target="$(realpath -m -- "$link" 2>/dev/null)" || continue
            case "$target" in
                /var/lib/apm/*) rm -f -- "$link" ;;
            esac
        done < <(find "$d" -type l 2>/dev/null)
    done

    # 删除所有软件包（包括 base 环境、缓存、数据库）
    rm -rf /var/lib/apm

    # 删除用户目录里的应用数据（旧版 postrm 也做同样的清理）
    for h in /root /home/*; do
        [ -d "$h/.apm" ] && rm -rf -- "$h/.apm"
    done

    echo "已删除 /var/lib/apm 与用户目录下的 ~/.apm"
}
