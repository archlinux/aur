[Unit]
Description=nfapd collector to port %i
After=network.target

[Service]
User=nfdump
Group=nfdump
Type=forking
ExecStartPre=/usr/bin/install -d -o nfdump -g nfdump -m 0750 /var/lib/nfdump/profiles-data/live/peer%i
ExecStart=/usr/bin/nfcapd -w /var/lib/nfdump/profiles-data/live/peer%i -D -p %i -B 212992 -S 1 -P /run/nfdump/nfcapd.p%i.pid -z -I peer%i
PIDFile=/run/nfdump/nfcapd.p%i.pid

[Install]
WantedBy=multi-user.target

