#!/usr/bin/env bash

build() {
	# mkinitcpio's run_build_hook discards build()'s return value, so returning
	# 1 on its own reports the problem and still lets the image be generated.
	# Bumping _builderrors is how a hook actually aborts the build; mkinitcpio
	# declares and consumes it, and its own acpi_override hook does the same.
	# shellcheck disable=SC2034
	if ! pacman -Qi tailscale >/dev/null 2>&1; then
		error "Package tailscale not installed"
		builderrors=$((++_builderrors))
		return 1
	fi

	local setupdir="/etc/initcpio/tailscale"
	for fn in tailscaled.state default.env; do
		if ! [[ -r "${setupdir}/${fn}" && -s "${setupdir}/${fn}" ]]; then
			error "Missing configuration file at ${setupdir}/${fn}. Have you run setup-initcpio-tailscale yet?"
			# shellcheck disable=SC2034
			builderrors=$((++_builderrors))
			return 1
		fi
	done
	add_file ${setupdir}/default.env /etc/default/tailscaled
	add_file ${setupdir}/tailscaled.state /var/lib/tailscale/tailscaled.state

	# Copy ssh host keys if they exist
	if [[ -d ${setupdir}/ssh ]]; then
		for f in "${setupdir}"/ssh/*; do
			[[ -e $f ]] || continue
			add_file "$f" /var/lib/tailscale/ssh/
		done
	fi

	# tailscale requirements
	add_module tun
	add_full_dir /usr/lib/xtables
	add_all_modules netfilter
	map add_binary getent iptables ip6tables tailscale tailscaled

	if [[ $(type -t add_systemd_unit) == function ]]; then
		add_systemd_unit tailscaled.service
		add_systemd_drop_in tailscaled.service override <<-EOU
			[Unit]
			DefaultDependencies=no
			After=network-online.target
			Wants=network-online.target
		EOU
		add_symlink /etc/systemd/system/sysinit.target.wants/tailscaled.service \
			/usr/lib/systemd/system/tailscaled.service
	else
		add_runscript

		# tailscaled resolves the login user through the user database -- which
		# is what the getent above is for -- and of the hooks mkinitcpio ships
		# only 'systemd' writes one. Without it the Tailscale SSH server refuses
		# every session, and so does a dropbear or tinyssh running alongside it,
		# on an image that is otherwise perfectly reachable.
		#
		# Skipped when something has already provided a database, so a hook that
		# knows more than this one always wins. The shell has to exist inside the
		# image, hence /bin/sh (busybox) rather than whatever the host uses.
		if [[ ! -e "$BUILDROOT/etc/passwd" ]]; then
			printf 'root:x:0:0:root:/root:/bin/sh\n' | add_file - /etc/passwd 0644
			printf 'root:*:::::::\n' | add_file - /etc/shadow 0400
			printf 'root:x:0:\n' | add_file - /etc/group 0644
			printf 'passwd: files\ngroup: files\nshadow: files\n' |
				add_file - /etc/nsswitch.conf 0644
			add_dir /root
		fi
	fi
}

help() {
	cat <<-__EOF_HELP__
		This hook starts tailscaled inside the initramfs, so the machine joins your
		tailnet before the root filesystem is unlocked.

		It copies the required files and binaries into the image. Configuration is
		taken from the host:

		   * /etc/initcpio/tailscale/tailscaled.state
		     to /var/lib/tailscale/tailscaled.state

		   * /etc/initcpio/tailscale/default.env
		     to /etc/default/tailscaled

		Run /usr/bin/setup-initcpio-tailscale first if you have not already: it
		registers the initrd node and writes both files.

		Works with systemd and busybox init alike. On a systemd-based initramfs,
		list 'tailscale' AFTER 'systemd'. This hook decides which kind of image it
		is building by looking for helpers the 'systemd' hook defines, so listing it
		earlier silently produces the busybox layout -- an image that builds cleanly
		and never connects.

		Configure a network hook as well. None of mkinitcpio's stock hooks bring up
		an interface, and tailscaled can do nothing without an address: 'sd-network'
		(mkinitcpio-systemd-extras) for systemd init, 'net' (mkinitcpio-nfs-utils)
		or 'netconf' (mkinitcpio-extras) for busybox init.

		An SSH server hook is not needed: setup-initcpio-tailscale enables
		Tailscale's own SSH server. Only if you ran it with '--no-ssh' do you need
		one of your own -- 'sd-tinyssh' (mkinitcpio-systemd-extras), or 'dropbear'
		or 'tinyssh' (mkinitcpio-extras).

		For more check https://github.com/dangra/mkinitcpio-tailscale
	__EOF_HELP__
}

