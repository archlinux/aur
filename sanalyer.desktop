[Desktop Entry]
Name=sanalyer
GenericName=Instant Messenger
Comment=Instant messaging and VoIP application
Exec=/usr/bin/sanalyer %U
Terminal=false
Type=Application
Icon=sanalyer
StartupWMClass=sanalyer
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
Categories=Network;InstantMessaging;Chat;
StartupNotify=true
SingleMainWindow=true
MimeType=x-scheme-handler/sanalyer;
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=/usr/bin/sanalyer --fluxer-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=/usr/bin/sanalyer --fluxer-task=new-dm %U
