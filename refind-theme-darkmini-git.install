# Adapted from https://aur.archlinux.org/packages/refind-theme-refind2k-git

post_install() {
    local install_dir='/usr/share/refind/themes/darkmini'
    cd "$install_dir" || exit 1
    ./setup.sh
}

post_upgrade() {
    post_install
}

pre_remove() {
    local install_dir='/usr/share/refind/themes/darkmini'
    cd "$install_dir" || exit 1
    ./setup.sh -u
}
