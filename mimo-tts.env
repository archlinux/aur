# MiMo TTS API configuration
# Copy this file and fill in your API key.
# The install script will place it at /etc/speech-dispatcher/mimo-tts.env

MIMO_API_KEY=""

# Voice selection (default: mimo_default)
# Available voices:
#   Chinese: mimo_default (default), 冰糖, 茉莉, 苏打, 白桦
#   English: Mia, Chloe, Milo, Dean
MIMO_VOICE="mimo_default"

# Style prompt for voice (optional)
# Use natural language to control speech style, e.g.:
#   "Bright, bouncy, slightly sing-song tone"
#   "Deep, calm, and steady voice"
# Leave empty for default style
MIMO_STYLE=""
