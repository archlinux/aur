+++ b/kernel-open/nvidia-drm/nvidia-drm-connector.c
@@ -147,6 +147,11 @@ __nv_drm_detect_encoder(struct NvKmsKapiDynamicDisplayParams *pDetectParams,
             }
         }
 
+        /* Force non_desktop for VR HMDs: MSFT-VR EDID extension marks them
