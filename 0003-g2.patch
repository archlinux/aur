+    (
+        struct NvKmsKapiDevice *device,
+        NvU32 apiHead,
+        NvBool permissive
+    );
+
     /*!
      * Registers for notification, via
      * NvKmsKapiAllocateDeviceParams::eventCallback, of the events specified
diff --git a/kernel-open/nvidia-drm/nvidia-drm-connector.c b/kernel-open/nvidia-drm/nvidia-drm-connector.c
index 2d5483a7..82227535 100644
