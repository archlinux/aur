+// Compatibility helpers for TVM's raw structural callback ABI.
+// FFI's current helpers return Expected<T>. These separate names retain its
+// predicates and value/type checks while moving errors or visit interrupts
+// into the raw owning TVMFFIAny storage required by TVM's registered hooks.
+// Typed Expected-returning methods continue to use the upstream FFI helpers.
+#ifndef TVM_IR_STRUCTURAL_FFI_COMPAT_H_
+#define TVM_IR_STRUCTURAL_FFI_COMPAT_H_
+
+#include <tvm/ffi/extra/structural_mutate.h>
+#include <tvm/ffi/extra/structural_visit.h>
+
+#define TVM_S_VISIT_RAW_MAYBE_EARLY_RETURN(Result)                                                 \
+  do {                                                                                             \
+    auto&& tvm_ffi_res_ = (Result);                                                                \
+    if (TVM_FFI_PREDICT_FALSE(::tvm::ffi::detail::StructuralVisitNeedEarlyReturn(tvm_ffi_res_))) { \
+      return ::tvm::ffi::detail::ExpectedUnsafe::MoveToTVMFFIAny(::std::move(tvm_ffi_res_));                                                            \
+    }                                                                                              \
+  } while (0)
+
+#define TVM_S_MUTATE_RAW_MAYBE_EARLY_RETURN(Result)                     \
+  do {                                                                  \
+    auto&& tvm_ffi_res_ = (Result);                                     \
+    if (TVM_FFI_PREDICT_FALSE(tvm_ffi_res_.is_err())) {                 \
+      return ::tvm::ffi::detail::ExpectedUnsafe::MoveToTVMFFIAny(::std::move(tvm_ffi_res_)); \
+    }                                                                   \
+  } while (0)
+
+#define TVM_S_MUTATE_RAW_ASSIGN_OR_RETURN_IMPL_(Result, Type, Name, ResultExpr)               \
+  auto Result = (ResultExpr); /* NOLINT(bugprone-macro-parentheses) */                        \
+  TVM_S_MUTATE_RAW_MAYBE_EARLY_RETURN(Result);                                                \
+  if constexpr (!::tvm::ffi::type_subsumes_v<::tvm::ffi::Expected<Type>, decltype(Result)>) { \
+    if (TVM_FFI_PREDICT_FALSE(!::tvm::ffi::detail::AnyUnsafe::CheckAnyStrict<Type>(           \
+            ::tvm::ffi::detail::ExpectedUnsafe::GetData(Result)))) {                          \
+      return ::tvm::ffi::detail::ExpectedUnsafe::MoveToTVMFFIAny(\
+          ::tvm::ffi::Expected<Type>(::tvm::ffi::detail::SMutateDeclaredTypeError()));                                  \
+    }                                                                                         \
+  }                                                                                           \
+  Type Name = /* NOLINT(bugprone-macro-parentheses) */                                        \
+      ::tvm::ffi::detail::AnyUnsafe::MoveFromAnyAfterCheck<Type>(                             \
+          ::std::move(::tvm::ffi::detail::ExpectedUnsafe::GetData(Result)))
+
+#define TVM_S_MUTATE_RAW_ASSIGN_OR_RETURN(Type, Name, ResultExpr)                                  \
+  TVM_S_MUTATE_RAW_ASSIGN_OR_RETURN_IMPL_(TVM_FFI_STR_CONCAT(tvm_ffi_mutate_result_, __COUNTER__), \
+                                          Type, Name, ResultExpr)
+
+#endif  // TVM_IR_STRUCTURAL_FFI_COMPAT_H_
