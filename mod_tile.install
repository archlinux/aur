post_install() {
  cat << 'EOF'
==> To enable 'mod_tile':
    - Add the following line to '/etc/httpd/conf/httpd.conf':
      Include conf/extra/httpd-tile.conf

    - Restart Apache HTTP Server:
      systemctl restart httpd

==> To enable 'render-example-map' from 'mod_tile':
    - Add the following line to '/etc/httpd/conf/httpd.conf':
      Include conf/extra/httpd-tile-renderd-example-map.conf

    - Add the following lines to '/etc/renderd.conf':
      [example-map]
      URI=/tiles/renderd-example
      XML=/usr/share/renderd/example-map/mapnik.xml

      [example-map-jpg]
      TYPE=jpg image/jpeg jpeg
      URI=/tiles/renderd-example-jpg
      XML=/usr/share/renderd/example-map/mapnik.xml

      [example-map-png256]
      TYPE=png image/png png256
      URI=/tiles/renderd-example-png256
      XML=/usr/share/renderd/example-map/mapnik.xml

      [example-map-png32]
      TYPE=png image/png png32
      URI=/tiles/renderd-example-png32
      XML=/usr/share/renderd/example-map/mapnik.xml

      [example-map-webp]
      TYPE=webp image/webp webp
      URI=/tiles/renderd-example-webp
      XML=/usr/share/renderd/example-map/mapnik.xml

    - Restart Apache HTTP Server & renderd:
      systemctl restart httpd renderd
EOF
}
