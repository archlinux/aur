+
+namespace KWin
+{
+
+struct NodeListenerData;
+struct ClientListenerData;
+
+/**
+ * @brief Tracks PipeWire consumer applications for screencast streams
+ *
+ * Monitors the PipeWire graph to detect which application is consuming
+ * a screencast stream (e.g., "obs", "floorp", "firefox"). Uses PipeWire
+ * registry to watch for Link objects connecting the stream's output node
+ * to a consumer's input node, then queries the consumer node properties
+ * to extract application name and PID.
+ */
+class PipeWireConsumerTracker : public QObject
+{
+    Q_OBJECT
+    Q_DISABLE_COPY(PipeWireConsumerTracker)
+
+public:
+    /**
+     * @brief Construct a new PipeWire Consumer Tracker
+     * @param core PipeWire core object (must remain valid for tracker lifetime)
+     * @param nodeId PipeWire node ID of the screencast stream to track
+     * @param parent QObject parent
+     */
+    explicit PipeWireConsumerTracker(pw_core *core, uint32_t nodeId, QObject *parent = nullptr);
+    ~PipeWireConsumerTracker() noexcept override;
+
+    /**
+     * @brief Get the consumer application name
+     * @return Application name (e.g., "obs", "floorp") or empty if no consumer
+     */
+    QString consumerApp() const
+    {
+        return m_consumerApp;
+    }
+
+    /**
+     * @brief Get the consumer process ID
+     * @return PID of the consumer process, or 0 if no consumer
+     */
+    quint32 consumerPID() const
+    {
+        return m_consumerPID;
+    }
+
+    /**
+     * @brief Check if a consumer is connected
+     * @return true if a consumer is currently connected
+     */
+    bool hasConsumer() const
+    {
+        return m_consumerPID != 0;
+    }
+
+Q_SIGNALS:
+    /**
+     * @brief Emitted when a consumer application connects
+     * @param appName Name of the consumer application
+     * @param pid PID of the consumer process
+     */
+    void consumerConnected(const QString &appName, quint32 pid);
+
+    /**
+     * @brief Emitted when the consumer disconnects
+     */
+    void consumerDisconnected();
+
+private:
+    struct LinkInfo
+    {
+        uint32_t inputNode; // Destination
+        uint32_t outputNode; // Source
+    };
+
+    struct ClientInfo
+    {
+        QString appName; // PW_KEY_APP_NAME
+        QString appBinary; // PW_KEY_APP_PROCESS_BINARY
+        quint32 pid = 0; // PW_KEY_APP_PROCESS_ID
+    };
+
+    void setupRegistry();
+    void cleanupRegistry();
+
+    void onRegistryGlobal(uint32_t id, uint32_t permissions, const char *type,
+                          uint32_t version, const spa_dict *props);
+    void onRegistryGlobalRemove(uint32_t id);
+
+    // Qt thread-safe methods (called via invokeMethod from PipeWire thread)
+    void handleRegistryGlobal(uint32_t id, QString type, QVariantMap props);
+    void handleRegistryGlobalRemove(uint32_t id);
+    void handleNodeInfo(uint32_t nodeId, QVariantMap props);
+
+    void checkLinkForConsumer(uint32_t linkId, const QVariantMap &props);
+    void queryNodeProperties(uint32_t nodeId);
+    void queryClientProperties(uint32_t clientId);
+    void handleClientInfo(uint32_t clientId, QVariantMap props);
+    void followLinksDownstream(uint32_t nodeId, int depth = 0);
+
+    // Helper methods for handleNodeInfo() to improve readability
+    struct NodeProperties
+    {
+        QString appName;
+        QString appBinary;
+        quint32 pid = 0;
+        uint32_t clientId = 0;
+    };
+    NodeProperties extractNodeProperties(const QVariantMap &props);
+    QString determineConsumerApp(const QString &appName, const QString &appBinary);
+    void emitConsumerFound(const QString &consumerApp, quint32 pid);
+    void searchDownstreamForConsumer(uint32_t nodeId);
+    void cleanupNodeListener(uint32_t nodeId);
+
+    pw_core *m_core;
+    uint32_t m_nodeId;
+
+    pw_registry *m_registry = nullptr;
+    spa_hook m_registryListener;
+
+    QString m_consumerApp;
+    quint32 m_consumerPID = 0;
+
+    QHash<uint32_t, ClientInfo> m_clientNodes; // client_id -> ClientInfo (cached client info)
+    QHash<uint32_t, uint32_t> m_links; // link_id -> consumer_node_id
+    QHash<uint32_t, LinkInfo> m_allLinks; // link_id -> LinkInfo (for graph traversal)
+    QSet<uint32_t> m_visitedNodes; // Prevent cycles in graph traversal
+    std::unordered_map<uint32_t, std::unique_ptr<NodeListenerData>> m_nodeListeners; // node_id -> listener data
+    std::unordered_map<uint32_t, std::unique_ptr<ClientListenerData>> m_clientListeners; // client_id -> listener data
+    QMutex m_nodeListenersMutex; // Protects m_nodeListeners from concurrent access
+    QMutex m_clientListenersMutex; // Protects m_clientListeners from concurrent access
+    QElapsedTimer m_searchTimer; // Tracks time spent in graph traversal to prevent timeout
+};
+
+} // namespace KWin
