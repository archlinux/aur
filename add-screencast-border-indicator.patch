+*/
+
+#include "screencastborderrenderer.h"
+#include "kwinscreencastborder_logging.h"
+#include "opengl/glutils.h"
+
+#include "core/rendertarget.h"
+#include "core/renderviewport.h"
+#include "effect/effecthandler.h"
+#include "screencastborderbutton.h"
+
+#include <QIcon>
+#include <QPainter>
+
+#include <KLocalizedString>
+
+namespace KWin
+{
+
+// Internal helper to render border with given projection matrix and geometry
+// Consolidates common OpenGL rendering code from drawWindow() and drawBorder()
+// When outputBounds is provided, only draws edge segments visible on that output
+// to prevent double lines at monitor boundaries in multi-monitor setups
+void ScreencastBorderRenderer::drawBorderInternal(const RenderTarget &renderTarget, const QMatrix4x4 &projectionMatrix,
+                                                  const QRectF &geometry, const QColor &color, int width,
+                                                  const QRectF &outputBounds)
+{
+    GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+    vbo->reset();
+
+    ShaderBinder binder(ShaderTrait::UniformColor | ShaderTrait::TransformColorspace);
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projectionMatrix);
+    binder.shader()->setUniform(GLShader::ColorUniform::Color, color);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureWidth, 1);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureHeight, 1);
+
+    // Set colorspace transformation uniforms (critical for correct color rendering)
+    // Without this, colors appear black because the shader doesn't know how to transform
+    // from sRGB to the output's color space
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB,
+                                           renderTarget.colorDescription(),
+                                           RenderingIntent::Perceptual);
+
+    glLineWidth(width);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    QList<QVector2D> vertices;
+
+    // Extract geometry boundaries
+    const qreal left = geometry.x();
+    const qreal top = geometry.y();
+    const qreal right = geometry.x() + geometry.width();
+    const qreal bottom = geometry.y() + geometry.height();
+
+    if (outputBounds.isEmpty()) {
+        // Original behavior: draw full rectangle as closed loop
+        vertices.reserve(5);
+        vertices.append(QVector2D(left, top));
+        vertices.append(QVector2D(right, top));
+        vertices.append(QVector2D(right, bottom));
+        vertices.append(QVector2D(left, bottom));
+        vertices.append(QVector2D(left, top)); // Close the loop
+
+        qCDebug(KWIN_SCREENCASTBORDER) << "drawBorderInternal() full rectangle:"
+                                       << "geometry=" << geometry
+                                       << "color=" << color
+                                       << "lineWidth=" << width;
+
+        vbo->setVertices(vertices);
+        vbo->render(GL_LINE_STRIP);
+    } else {
+        // Multi-monitor mode: draw only edge segments within this output
+        // Each edge is drawn as separate line segments to prevent double lines at monitor boundaries
+        vertices.reserve(8); // Maximum 4 edges × 2 vertices each
+
+        const qreal outLeft = outputBounds.x();
+        const qreal outTop = outputBounds.y();
+        const qreal outRight = outputBounds.x() + outputBounds.width();
+        const qreal outBottom = outputBounds.y() + outputBounds.height();
+
+        // Top edge: draw if it's within output's vertical range
+        if (top >= outTop && top <= outBottom) {
+            qreal edgeLeft = qMax(left, outLeft);
+            qreal edgeRight = qMin(right, outRight);
+            if (edgeRight > edgeLeft) {
+                vertices.append(QVector2D(edgeLeft, top));
+                vertices.append(QVector2D(edgeRight, top));
+            }
+        }
+
+        // Right edge: draw if it's within output's horizontal range
+        if (right >= outLeft && right <= outRight) {
+            qreal edgeTop = qMax(top, outTop);
+            qreal edgeBottom = qMin(bottom, outBottom);
+            if (edgeBottom > edgeTop) {
+                vertices.append(QVector2D(right, edgeTop));
+                vertices.append(QVector2D(right, edgeBottom));
+            }
+        }
+
+        // Bottom edge: draw if it's within output's vertical range
+        if (bottom >= outTop && bottom <= outBottom) {
+            qreal edgeLeft = qMax(left, outLeft);
+            qreal edgeRight = qMin(right, outRight);
+            if (edgeRight > edgeLeft) {
+                vertices.append(QVector2D(edgeRight, bottom));
+                vertices.append(QVector2D(edgeLeft, bottom));
+            }
+        }
+
+        // Left edge: draw if it's within output's horizontal range
+        if (left >= outLeft && left <= outRight) {
+            qreal edgeTop = qMax(top, outTop);
+            qreal edgeBottom = qMin(bottom, outBottom);
+            if (edgeBottom > edgeTop) {
+                vertices.append(QVector2D(left, edgeBottom));
+                vertices.append(QVector2D(left, edgeTop));
+            }
+        }
+
+        qCDebug(KWIN_SCREENCASTBORDER) << "drawBorderInternal() clipped edges:"
+                                       << "geometry=" << geometry
+                                       << "outputBounds=" << outputBounds
+                                       << "edgeSegments=" << (vertices.size() / 2)
+                                       << "color=" << color
+                                       << "lineWidth=" << width;
+
+        if (!vertices.isEmpty()) {
+            vbo->setVertices(vertices);
+            vbo->render(GL_LINES); // Draw as separate line segments, not a strip
+        }
+    }
+
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawBorder(const RenderTarget &renderTarget, const RenderViewport &viewport,
+                                          const QRect &geometry, const QColor &color, int width,
+                                          const QRect &outputBounds)
+{
+    // Use simple scaling like MouseMark effect (which works correctly)
+    // Keep geometry in global logical coordinates and just multiply by scale
+    // The projectionMatrix() handles the coordinate system transformation
+    const qreal scale = viewport.scale();
+
+    // Scale geometry from logical pixels to device pixels
+    QRectF scaledGeometry(
+        geometry.x() * scale,
+        geometry.y() * scale,
+        geometry.width() * scale,
+        geometry.height() * scale);
+
+    // Scale output bounds from logical pixels to device pixels (for multi-monitor clipping)
+    QRectF scaledOutputBounds;
+    if (!outputBounds.isEmpty()) {
+        scaledOutputBounds = QRectF(
+            outputBounds.x() * scale,
+            outputBounds.y() * scale,
+            outputBounds.width() * scale,
+            outputBounds.height() * scale);
+    }
+
+    // Scale the line width proportionally
+    int scaledWidth = qRound(width * scale);
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "drawBorder():"
+                                   << "geometry=" << geometry
+                                   << "outputBounds=" << outputBounds
+                                   << "scale=" << scale
+                                   << "scaledGeometry=" << scaledGeometry
+                                   << "scaledOutputBounds=" << scaledOutputBounds
+                                   << "color=" << color
+                                   << "color.isValid=" << color.isValid()
+                                   << "color.rgb=0x" << QString::number(color.rgb(), 16)
+                                   << "width=" << width
+                                   << "scaledWidth=" << scaledWidth;
+
+    // Delegate to internal helper that handles all OpenGL rendering
+    drawBorderInternal(renderTarget, viewport.projectionMatrix(), scaledGeometry, color, scaledWidth, scaledOutputBounds);
+}
+
+std::unique_ptr<GLTexture> ScreencastBorderRenderer::createTextTexture(const QString &text, qreal fontSize,
+                                                                       const QColor &textColor, const QSizeF &size, qreal scale)
+{
+    // Create QImage with sufficient size for text at device scale
+    QImage image(qCeil(size.width() * scale), qCeil(size.height() * scale), QImage::Format_ARGB32_Premultiplied);
+    image.setDevicePixelRatio(scale);
+    image.fill(Qt::transparent);
+
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setRenderHint(QPainter::TextAntialiasing);
+
+    // Configure font
+    QFont font = painter.font();
+    font.setPixelSize(qRound(fontSize));
+    font.setWeight(QFont::Medium);
+    painter.setFont(font);
+
+    // Draw text centered
+    painter.setPen(textColor);
+    QRectF textBounds(0, 0, size.width(), size.height());
+    painter.drawText(textBounds, Qt::AlignCenter, text);
+
+    painter.end();
+
+    // Create OpenGL texture from QImage
+    return GLTexture::upload(image);
+}
+
+std::unique_ptr<GLTexture> ScreencastBorderRenderer::createIconTexture(const QString &iconName, const QSizeF &size, qreal scale)
+{
+    // Load icon from theme
+    QIcon icon = QIcon::fromTheme(iconName);
+    if (icon.isNull()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Failed to load icon:" << iconName;
+        return nullptr;
+    }
+
+    // Calculate physical pixel size
+    QSize physicalSize(qCeil(size.width() * scale), qCeil(size.height() * scale));
+
+    // Get pixmap at desired size
+    QPixmap pixmap = icon.pixmap(physicalSize);
+
+    // Convert to QImage
+    QImage image = pixmap.toImage();
+    if (image.isNull()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Failed to convert icon to image:" << iconName;
+        return nullptr;
+    }
+
+    // Set device pixel ratio for HiDPI support
+    image.setDevicePixelRatio(scale);
+
+    // Ensure correct format
+    if (image.format() != QImage::Format_ARGB32_Premultiplied && image.format() != QImage::Format_ARGB32) {
+        image = image.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    }
+
+    // Upload to OpenGL texture
+    return GLTexture::upload(image);
+}
+
+void ScreencastBorderRenderer::drawRoundedRect(GLVertexBuffer *vbo, GLShader *shader,
+                                               qreal left, qreal top, qreal right, qreal bottom,
+                                               qreal radius, const QColor &color)
+{
+    shader->setUniform(GLShader::ColorUniform::Color, color);
+
+    // Simplified version: draw rectangle (rounded corners require more complex tesselation)
+    // TODO: Implement proper rounded corners with circle segments if needed
+    QList<QVector2D> vertices;
+    vertices.reserve(6);
+
+    // Two triangles forming a rectangle
+    vertices << QVector2D(left, top) << QVector2D(right, top) << QVector2D(left, bottom);
+    vertices << QVector2D(right, top) << QVector2D(right, bottom) << QVector2D(left, bottom);
+
+    vbo->reset();
+    vbo->setVertices(vertices);
+    vbo->render(GL_TRIANGLES);
+}
+
+QColor ScreencastBorderRenderer::getContrastColor(const QColor &backgroundColor)
+{
+    // Perceived brightness (ITU-R BT.709)
+    qreal luminance = (0.2126 * backgroundColor.redF() + 0.7152 * backgroundColor.greenF() + 0.0722 * backgroundColor.blueF());
+    return luminance > 0.5 ? QColor(0, 0, 0, 200) : QColor(255, 255, 255, 200);
+}
+
+void ScreencastBorderRenderer::drawStopButton(const RenderTarget &renderTarget, const QMatrix4x4 &projectionMatrix,
+                                              ButtonState &button, const QColor &borderColor,
+                                              int borderWidth, qreal scale)
+{
+    // If button is mostly hidden (opacity < 0.1), draw thickened border segment instead
+    if (button.opacity < 0.1 && !button.isPinned) {
+        drawThickenedBorderSegment(renderTarget, projectionMatrix, button.buttonRect, borderColor, borderWidth, scale);
+        return; // Don't draw button itself
+    }
+
+    // Calculate colors with opacity
+    QColor bgColor = borderColor;
+    int baseAlpha = button.isHovered ? 220 : 200;
+    bgColor.setAlpha(qRound(baseAlpha * button.opacity));
+
+    QColor contrastColor = getContrastColor(borderColor);
+    contrastColor.setAlpha(qRound(contrastColor.alpha() * button.opacity));
+
+    // Draw button components
+    drawButtonBackground(renderTarget, projectionMatrix, button.buttonRect, bgColor, scale);
+    drawButtonGrip(projectionMatrix, button.gripRect, contrastColor, scale);
+    drawButtonIcon(renderTarget, projectionMatrix, button, scale);
+    drawButtonPinIcon(renderTarget, projectionMatrix, button, scale);
+
+    // Draw tooltip if hovering for > 1 second
+    drawTooltip(renderTarget, projectionMatrix, button, scale);
+}
+
+void ScreencastBorderRenderer::drawButtonBackground(const RenderTarget &renderTarget,
+                                                    const QMatrix4x4 &projectionMatrix,
+                                                    const QRectF &buttonRect,
+                                                    const QColor &bgColor,
+                                                    qreal scale)
+{
+    GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+    ShaderBinder binder(ShaderTrait::UniformColor | ShaderTrait::TransformColorspace);
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projectionMatrix);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureWidth, 1);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureHeight, 1);
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    const qreal cornerRadius = 3.0 * scale;
+    drawRoundedRect(vbo, binder.shader(),
+                    buttonRect.left(), buttonRect.top(),
+                    buttonRect.right(), buttonRect.bottom(),
+                    cornerRadius, bgColor);
+
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawButtonGrip(const QMatrix4x4 &projectionMatrix,
+                                              const QRectF &gripRect,
+                                              const QColor &gripColor,
+                                              qreal scale)
+{
+    GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+    ShaderBinder binder(ShaderTrait::UniformColor);
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projectionMatrix);
+    binder.shader()->setUniform(GLShader::ColorUniform::Color, gripColor);
+
+    const qreal gripTop = gripRect.top() + gripRect.height() * 0.25;
+    const qreal gripBottom = gripRect.bottom() - gripRect.height() * 0.25;
+    const qreal lineSpacing = gripRect.width() / 4.0;
+
+    QList<QVector2D> gripVertices;
+    gripVertices.reserve(6);
+    for (int i = 0; i < 3; ++i) {
+        qreal lineX = gripRect.left() + lineSpacing * (i + 1);
+        gripVertices.append(QVector2D(lineX, gripTop));
+        gripVertices.append(QVector2D(lineX, gripBottom));
+    }
+
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glLineWidth(2.0 * scale);
+
+    vbo->reset();
+    vbo->setVertices(gripVertices);
+    vbo->render(GL_LINES);
+
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawButtonIcon(const RenderTarget &renderTarget,
+                                              const QMatrix4x4 &projectionMatrix,
+                                              ButtonState &button,
+                                              qreal scale)
+{
+    // Generate stop icon texture if not cached
+    if (!button.textTexture) {
+        button.textTexture = createIconTexture(
+            QStringLiteral("media-playback-stop"),
+            button.textRect.size(),
+            scale);
+    }
+
+    if (!button.textTexture) {
+        return; // Texture creation failed
+    }
+
+    ShaderBinder binder(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace);
+
+    QMatrix4x4 mvp = projectionMatrix;
+    mvp.translate(button.textRect.x(), button.textRect.y());
+
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, mvp);
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    button.textTexture->render(button.textRect.size());
+
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawButtonPinIcon(const RenderTarget &renderTarget,
+                                                 const QMatrix4x4 &projectionMatrix,
+                                                 ButtonState &button,
+                                                 qreal scale)
+{
+    // Generate pin icon texture if not cached
+    if (!button.pinTexture) {
+        const QString pinIconName = button.isPinned
+            ? QStringLiteral("window-pin")
+            : QStringLiteral("window-unpin");
+        button.pinTexture = createIconTexture(pinIconName, button.pinButtonRect.size(), scale);
+    }
+
+    if (!button.pinTexture) {
+        return; // Texture creation failed
+    }
+
+    ShaderBinder binder(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace);
+
+    QMatrix4x4 mvp = projectionMatrix;
+    mvp.translate(button.pinButtonRect.x(), button.pinButtonRect.y());
+
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, mvp);
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    button.pinTexture->render(button.pinButtonRect.size());
+
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawThickenedBorderSegment(const RenderTarget &renderTarget,
+                                                          const QMatrix4x4 &projectionMatrix,
+                                                          const QRectF &buttonRect,
+                                                          const QColor &borderColor,
+                                                          int borderWidth,
+                                                          qreal scale)
+{
+    GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+    vbo->reset();
+
+    ShaderBinder binder(ShaderTrait::UniformColor | ShaderTrait::TransformColorspace);
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projectionMatrix);
+    binder.shader()->setUniform(GLShader::ColorUniform::Color, borderColor);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureWidth, 1);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureHeight, 1);
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+    // Draw thickened line (original width + 2px)
+    // Offset Y downward so line extends from top border downward
+    int originalWidth = qRound(borderWidth * scale);
+    int additionalThickness = qRound(2.0 * scale);
+    int thickenedWidth = originalWidth + additionalThickness;
+    qreal yOffset = thickenedWidth / 2.0; // Shift down by half of total width to place top edge at buttonRect.y()
+
+    glLineWidth(thickenedWidth);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    QList<QVector2D> vertices;
+    vertices.reserve(2);
+    qreal lineY = buttonRect.y() + yOffset; // Apply offset to keep top edge fixed
+    vertices.append(QVector2D(buttonRect.left(), lineY));
+    vertices.append(QVector2D(buttonRect.right(), lineY));
+
+    vbo->setVertices(vertices);
+    vbo->render(GL_LINES);
+    glDisable(GL_BLEND);
+}
+
+void ScreencastBorderRenderer::drawTooltip(const RenderTarget &renderTarget, const QMatrix4x4 &projectionMatrix,
+                                           const ButtonState &button, qreal scale)
+{
+    if (!button.showTooltip) {
+        return;
+    }
+
+    // Tooltip: "Stop sharing" (translated with context for translators)
+    const QString tooltipText = i18nc("@action:button Stop screencast recording", "Stop sharing");
+
+    // Calculate tooltip dimensions
+    const qreal tooltipPadding = 8.0 * scale;
+    const qreal tooltipFontSize = 12.0 * scale;
+
+    // Estimate tooltip width
+    const qreal estimatedWidth = tooltipText.length() * (tooltipFontSize * 0.6) + 2.0 * tooltipPadding;
+    const qreal tooltipHeight = tooltipFontSize + 2.0 * tooltipPadding;
+
+    // Position tooltip below the button
+    const qreal tooltipX = button.buttonRect.center().x() - (estimatedWidth / 2.0);
+    const qreal tooltipY = button.buttonRect.bottom() + 5.0 * scale;
+
+    QRectF tooltipRect(tooltipX, tooltipY, estimatedWidth, tooltipHeight);
+
+    // Draw tooltip background (semi-transparent dark)
+    GLVertexBuffer *vbo = GLVertexBuffer::streamingBuffer();
+    ShaderBinder binder(ShaderTrait::UniformColor | ShaderTrait::TransformColorspace);
+    binder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, projectionMatrix);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureWidth, 1);
+    binder.shader()->setUniform(GLShader::IntUniform::TextureHeight, 1);
+    binder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+    QColor bgColor(0, 0, 0, 200);
+    drawRoundedRect(vbo, binder.shader(), tooltipRect.left(), tooltipRect.top(), tooltipRect.right(), tooltipRect.bottom(), 3.0 * scale, bgColor);
+
+    // Render tooltip text
+    auto tooltipTexture = createTextTexture(tooltipText, tooltipFontSize, QColor(255, 255, 255, 255), tooltipRect.size(), scale);
+
+    if (tooltipTexture) {
+        ShaderBinder texBinder(ShaderTrait::MapTexture | ShaderTrait::TransformColorspace);
+
+        QMatrix4x4 mvp = projectionMatrix;
+        mvp.translate(tooltipRect.x(), tooltipRect.y());
+
+        texBinder.shader()->setUniform(GLShader::Mat4Uniform::ModelViewProjectionMatrix, mvp);
+        texBinder.shader()->setColorspaceUniforms(ColorDescription::sRGB, renderTarget.colorDescription(), RenderingIntent::Perceptual);
+
+        tooltipTexture->render(tooltipRect.size());
+    }
+
+    glDisable(GL_BLEND);
+}
+
+} // namespace KWin
