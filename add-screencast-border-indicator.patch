diff --git a/src/plugins/screencastborder/screencastborderbutton.cpp b/src/plugins/screencastborder/screencastborderbutton.cpp
new file mode 100644
index 0000000000..f594eeaa85
--- /dev/null
+++ b/src/plugins/screencastborder/screencastborderbutton.cpp
@@ -0,0 +1,498 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastborderbutton.h"
+#include "kwinscreencastborder_logging.h"
+
+#include <QDateTime>
+
+namespace KWin
+{
+
+ScreencastButtonController::ScreencastButtonController(QObject *parent)
+    : QObject(parent)
+{
+}
+
+ScreencastButtonController::~ScreencastButtonController() = default;
+
+void ScreencastButtonController::setShowButtons(bool show)
+{
+    if (m_showButtons != show) {
+        m_showButtons = show;
+        Q_EMIT repaintNeeded();
+    }
+}
+
+void ScreencastButtonController::createButton(const QString &streamId)
+{
+    if (m_buttons.find(streamId) != m_buttons.end()) {
+        return; // Already exists
+    }
+
+    auto button = std::make_unique<ButtonState>();
+    button->positionRatio = 0.75f; // Default to 3/4 position
+    button->isHovered = false;
+    button->isDragging = false;
+    button->lastInteractionTime = QDateTime::currentMSecsSinceEpoch(); // Initialize to current time (show immediately)
+    m_buttons.insert({streamId, std::move(button)});
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "Created button for stream:" << streamId;
+}
+
+void ScreencastButtonController::removeButton(const QString &streamId)
+{
+    if (m_buttons.erase(streamId) > 0) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Removed button for stream:" << streamId;
+        Q_EMIT repaintNeeded();
+    }
+}
+
+void ScreencastButtonController::updateButtonGeometry(const QString &streamId, const QRectF &screencastGeometry, qreal scale)
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        // Create button if it doesn't exist
+        createButton(streamId);
+        it = m_buttons.find(streamId);
+    }
+
+    ButtonState &button = *it->second;
+
+    // Store geometry and scale for drag calculations
+    button.streamGeometry = QRectF(screencastGeometry.x() / scale, screencastGeometry.y() / scale,
+                                   screencastGeometry.width() / scale, screencastGeometry.height() / scale);
+    button.scale = scale;
+
+    // Get titlebar height - use a sensible default
+    // (The main effect may cache this in ScreencastInfo, but we'll use a constant here)
+    qreal titlebarHeight = 32.0;
+
+    // Button dimensions (max 20px height for larger icons)
+    const qreal buttonHeight = qMin(titlebarHeight, 20.0) * scale;
+    const qreal gripWidth = buttonHeight; // Square grip
+    const qreal paddingV = 1.0 * scale; // Minimal padding for larger icons
+    const qreal paddingH = 2.0 * scale; // Reduced padding for compact layout
+    const qreal buttonSpacing = 3.0 * scale; // Spacing between button components
+    const qreal edgeMargin = 6.0 * scale; // Margin from section edges
+
+    // Calculate emoji button size (stop emoji ◼️)
+    const qreal fontSize = buttonHeight - 2.0 * paddingV;
+
+    // Emoji is roughly square, estimate width based on height
+    const qreal emojiWidth = fontSize + 2.0 * paddingH;
+
+    // Pin button (right side)
+    const qreal pinButtonWidth = buttonHeight * 0.8; // Slightly smaller than grip
+
+    // Total width includes margins and spacing between components
+    const qreal totalWidth = edgeMargin + gripWidth + buttonSpacing + emojiWidth + buttonSpacing + pinButtonWidth + edgeMargin;
+
+    // Position button on top border line
+    const qreal buttonCenterX = screencastGeometry.x() + (screencastGeometry.width() * button.positionRatio);
+    qreal buttonX = buttonCenterX - (totalWidth / 2.0);
+    const qreal buttonY = screencastGeometry.y(); // ON the top line
+
+    // Clamp to keep ENTIRE button within window borders
+    const qreal minButtonX = screencastGeometry.x();
+    const qreal maxButtonX = screencastGeometry.x() + screencastGeometry.width() - totalWidth;
+    buttonX = qMax(minButtonX, qMin(maxButtonX, buttonX));
+
+    // Update positionRatio to reflect clamped position (ensures consistency for subsequent updates)
+    const qreal clampedCenterX = buttonX + (totalWidth / 2.0);
+    button.positionRatio = (clampedCenterX - screencastGeometry.x()) / screencastGeometry.width();
+
+    // Update rectangles in device coordinates (scaled) - for rendering
+    button.buttonRect = QRectF(buttonX, buttonY, totalWidth, buttonHeight);
+    button.gripRect = QRectF(buttonX + edgeMargin, buttonY, gripWidth, buttonHeight);
+    button.textRect = QRectF(buttonX + edgeMargin + gripWidth + buttonSpacing, buttonY, emojiWidth, buttonHeight);
+    button.pinButtonRect = QRectF(buttonX + edgeMargin + gripWidth + buttonSpacing + emojiWidth + buttonSpacing, buttonY, pinButtonWidth, buttonHeight);
+
+    // Also store in logical coordinates (unscaled) - for input hit testing
+    button.buttonRectLogical = QRectF(buttonX / scale, buttonY / scale, totalWidth / scale, buttonHeight / scale);
+    button.gripRectLogical = QRectF((buttonX + edgeMargin) / scale, buttonY / scale, gripWidth / scale, buttonHeight / scale);
+    button.textRectLogical = QRectF((buttonX + edgeMargin + gripWidth + buttonSpacing) / scale, buttonY / scale, emojiWidth / scale, buttonHeight / scale);
+    button.pinButtonRectLogical = QRectF((buttonX + edgeMargin + gripWidth + buttonSpacing + emojiWidth + buttonSpacing) / scale, buttonY / scale, pinButtonWidth / scale, buttonHeight / scale);
+
+    // Mark texture for regeneration if height changed
+    if (qAbs(button.cachedButtonHeight - buttonHeight) > 0.1) {
+        button.textTexture.reset();
+        button.pinTexture.reset();
+        button.cachedButtonHeight = buttonHeight;
+    }
+
+    // Mark button for re-rendering due to geometry change
+    button.renderDirty = true;
+}
+
+bool ScreencastButtonController::handlePointerMotion(const QPointF &pos, qint64 timestamp)
+{
+    if (!m_showButtons) {
+        return false;
+    }
+
+    // Check if we're currently dragging
+    if (!m_draggingStreamId.isEmpty()) {
+        auto it = m_buttons.find(m_draggingStreamId);
+        if (it != m_buttons.end()) {
+            ButtonState &button = *it->second;
+
+            // Calculate new position ratio based on drag distance
+            const qreal deltaX = pos.x() - button.dragStartPos.x();
+            const qreal screencastWidth = button.streamGeometry.width();
+
+            // Calculate new position ratio
+            const qreal deltaRatio = deltaX / screencastWidth;
+            float newRatio = button.dragStartRatio + deltaRatio;
+
+            // Clamp to keep ENTIRE button within vertical borders
+            // Note: buttonRect is in scaled coordinates, streamGeometry is in logical
+            qreal buttonHalfWidth = (button.buttonRect.width() / button.scale) / 2.0;
+            qreal minRatio = buttonHalfWidth / screencastWidth;
+            qreal maxRatio = 1.0f - minRatio;
+            newRatio = qMax(minRatio, qMin(maxRatio, static_cast<qreal>(newRatio)));
+            button.positionRatio = newRatio;
+
+            // Update interaction time during drag
+            button.lastInteractionTime = timestamp;
+
+            Q_EMIT repaintNeeded();
+            return true; // Consume event
+        }
+    }
+
+    // Check for hover and proximity detection
+    bool foundHover = false;
+    for (auto &[streamId, buttonPtr] : m_buttons) {
+        if (!buttonPtr) {
+            continue;
+        }
+        ButtonState &button = *buttonPtr;
+
+        // Check proximity to button area (for showing hidden button)
+        bool nearTopBorder = isMouseNearTopBorder(pos, streamId, 20.0);
+        if (nearTopBorder) {
+            button.lastInteractionTime = timestamp;
+        }
+
+        // Check hover over entire button
+        bool isOverButton = hitTestButton(pos, streamId);
+        if (isOverButton) {
+            button.lastInteractionTime = timestamp;
+            foundHover = true;
+
+            if (!button.isHovered) {
+                button.isHovered = true;
+                button.hoverStartTime = timestamp;
+                button.showTooltip = false;
+                button.renderDirty = true; // Hover state affects rendering
+                Q_EMIT repaintNeeded();
+            } else {
+                // Check if hover duration exceeds 1 second for tooltip
+                if ((timestamp - button.hoverStartTime) > 1000 && !button.showTooltip) {
+                    button.showTooltip = true;
+                    button.renderDirty = true; // Tooltip affects rendering
+                    Q_EMIT repaintNeeded();
+                }
+            }
+        } else {
+            // Mouse left button area
+            if (button.isHovered) {
+                button.isHovered = false;
+                button.showTooltip = false;
+                button.renderDirty = true; // Hover state affects rendering
+                Q_EMIT repaintNeeded();
+            }
+        }
+
+        // Check hover over each component individually for per-component highlighting
+        bool isOverGrip = hitTestGrip(pos, streamId);
+        if (isOverGrip != button.isGripHovered) {
+            button.isGripHovered = isOverGrip;
+            button.renderDirty = true; // Grip hover affects rendering
+            Q_EMIT repaintNeeded();
+        }
+
+        bool isOverStop = hitTestStopButton(pos, streamId);
+        if (isOverStop != button.isStopHovered) {
+            button.isStopHovered = isOverStop;
+            button.renderDirty = true; // Stop button hover affects rendering
+            Q_EMIT repaintNeeded();
+        }
+
+        bool isOverPin = hitTestPinButton(pos, streamId);
+        if (isOverPin != button.isPinHovered) {
+            button.isPinHovered = isOverPin;
+            // Invalidate pin texture to regenerate with new hover state
+            button.pinTexture.reset();
+            button.renderDirty = true; // Pin button hover affects rendering
+            Q_EMIT repaintNeeded();
+        }
+    }
+
+    return false; // Don't consume event unless dragging
+}
+
+bool ScreencastButtonController::handlePointerButton(const QPointF &pos, Qt::MouseButton button,
+                                                     bool pressed, qint64 timestamp)
+{
+    if (!m_showButtons) {
+        return false;
+    }
+
+    // Button release
+    if (!pressed) {
+        // End dragging
+        if (!m_draggingStreamId.isEmpty()) {
+            auto it = m_buttons.find(m_draggingStreamId);
+            if (it != m_buttons.end()) {
+                ButtonState &buttonState = *it->second;
+                buttonState.isDragging = false;
+                buttonState.renderDirty = true; // Drag state affects rendering
+                qCDebug(KWIN_SCREENCASTBORDER) << "Drag ended at ratio:" << buttonState.positionRatio;
+                m_draggingStreamId.clear();
+                Q_EMIT repaintNeeded();
+                return true; // Consume event
+            }
+        }
+        return false;
+    }
+
+    // Button press
+    if (button == Qt::LeftButton) {
+        for (auto &[streamId, buttonPtr] : m_buttons) {
+            if (!buttonPtr) {
+                continue;
+            }
+
+            if (hitTestButton(pos, streamId)) {
+                ButtonState &buttonState = *buttonPtr;
+
+                // Update interaction time
+                buttonState.lastInteractionTime = timestamp;
+
+                // Check if clicking on pin button
+                if (hitTestPinButton(pos, streamId)) {
+                    // Toggle pin state
+                    buttonState.isPinned = !buttonState.isPinned;
+                    // Invalidate pin texture to show new state
+                    buttonState.pinTexture.reset();
+                    buttonState.renderDirty = true; // Pin state affects rendering
+                    qCDebug(KWIN_SCREENCASTBORDER) << "Pin toggled to:" << (buttonState.isPinned ? "pinned" : "unpinned");
+                    Q_EMIT repaintNeeded();
+                    return true; // Consume event
+                } else if (hitTestGrip(pos, streamId)) {
+                    // Start dragging
+                    buttonState.isDragging = true;
+                    buttonState.dragStartPos = pos;
+                    buttonState.dragStartRatio = buttonState.positionRatio;
+                    buttonState.renderDirty = true; // Drag state affects rendering
+                    m_draggingStreamId = streamId;
+                    qCDebug(KWIN_SCREENCASTBORDER) << "Drag started at ratio:" << buttonState.positionRatio;
+                    Q_EMIT repaintNeeded();
+                    return true; // Consume event
+                } else {
+                    // Click on stop button - emit signal
+                    Q_EMIT stopRequested(streamId);
+                    return true; // Consume event
+                }
+            }
+        }
+    }
+
+    return false; // Don't consume event
+}
+
+void ScreencastButtonController::updateAnimations(qint64 currentTime)
+{
+    // Performance optimization: early exit if no buttons exist
+    if (m_buttons.empty()) {
+        return;
+    }
+
+    // Performance optimization: check if any button needs animation update
+    // Skip expensive iteration if all buttons are in stable state
+    bool hasAnimatingButton = false;
+    bool hasButtonNeedingCheck = false;
+
+    for (const auto &[streamId, buttonPtr] : m_buttons) {
+        if (!buttonPtr) {
+            continue;
+        }
+        const ButtonState &button = *buttonPtr;
+
+        // Button is currently animating (opacity or collapse in transition)
+        if (button.isAnimating) {
+            hasAnimatingButton = true;
+            break; // Early exit - we know we need to update
+        }
+
+        // Button might need to start animating (not in final state)
+        // Check if opacity or collapseProgress are not at their target values
+        const bool shouldHide = shouldHideButton(button, currentTime);
+        const bool opacityAtTarget = shouldHide ? (button.opacity == 0.0) : (button.opacity == 1.0);
+        const bool collapseAtTarget = shouldHide ? (button.collapseProgress == 0.0) : (button.collapseProgress == 1.0);
+
+        if (!opacityAtTarget || !collapseAtTarget) {
+            hasButtonNeedingCheck = true;
+            break; // Early exit - we know we need to update
+        }
+    }
+
+    // If no buttons are animating and all are in stable state, skip update
+    if (!hasAnimatingButton && !hasButtonNeedingCheck) {
+        return;
+    }
+
+    bool needsRepaint = false;
+
+    for (auto &[streamId, buttonPtr] : m_buttons) {
+        if (!buttonPtr) {
+            continue;
+        }
+
+        ButtonState &button = *buttonPtr;
+        const qreal animationStep = 0.033; // 3.3% per frame (~500ms for full transition at 60fps)
+
+        if (shouldHideButton(button, currentTime)) {
+            // Collapse animation (fade + height collapse)
+            bool changed = false;
+
+            if (button.opacity > 0.0) {
+                button.opacity = qMax(0.0, button.opacity - animationStep);
+                changed = true;
+            }
+
+            if (button.collapseProgress > 0.0) {
+                button.collapseProgress = qMax(0.0, button.collapseProgress - animationStep);
+                changed = true;
+            }
+
+            if (changed) {
+                button.isAnimating = true;
+                needsRepaint = true;
+            } else {
+                button.isAnimating = false;
+            }
+        } else {
+            // Expand animation (fade + height expand)
+            bool changed = false;
+
+            if (button.opacity < 1.0) {
+                button.opacity = qMin(1.0, button.opacity + animationStep);
+                changed = true;
+            }
+
+            if (button.collapseProgress < 1.0) {
+                button.collapseProgress = qMin(1.0, button.collapseProgress + animationStep);
+                changed = true;
+            }
+
+            if (changed) {
+                button.isAnimating = true;
+                needsRepaint = true;
+            } else {
+                button.isAnimating = false;
+            }
+        }
+    }
+
+    if (needsRepaint) {
+        Q_EMIT repaintNeeded();
+    }
+}
+
+ScreencastButtonController::ButtonState *ScreencastButtonController::getButton(const QString &streamId)
+{
+    auto it = m_buttons.find(streamId);
+    if (it != m_buttons.end()) {
+        return it->second.get();
+    }
+    return nullptr;
+}
+
+bool ScreencastButtonController::isButtonVisible(const QString &streamId) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it != m_buttons.end()) {
+        return it->second->opacity > 0.0;
+    }
+    return false;
+}
+
+bool ScreencastButtonController::hitTestButton(const QPointF &pos, const QString &streamId) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        return false;
+    }
+    // Use logical coordinates for hit testing (mouse events are in logical coords)
+    return it->second->buttonRectLogical.contains(pos);
+}
+
+bool ScreencastButtonController::hitTestGrip(const QPointF &pos, const QString &streamId) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        return false;
+    }
+    // Use logical coordinates for hit testing (mouse events are in logical coords)
+    return it->second->gripRectLogical.contains(pos);
+}
+
+bool ScreencastButtonController::hitTestPinButton(const QPointF &pos, const QString &streamId) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        return false;
+    }
+    // Use logical coordinates for hit testing (mouse events are in logical coords)
+    return it->second->pinButtonRectLogical.contains(pos);
+}
+
+bool ScreencastButtonController::hitTestStopButton(const QPointF &pos, const QString &streamId) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        return false;
+    }
+    // Use logical coordinates for hit testing (mouse events are in logical coords)
+    return it->second->textRectLogical.contains(pos);
+}
+
+bool ScreencastButtonController::isMouseNearTopBorder(const QPointF &pos, const QString &streamId,
+                                                      qreal proximityDistance) const
+{
+    auto it = m_buttons.find(streamId);
+    if (it == m_buttons.end()) {
+        return false;
+    }
+
+    const ButtonState &button = *it->second;
+
+    // Check if mouse is near the button position (where the thickened border segment would be)
+    // Only check horizontal position around button, and vertical proximity to top border
+    // Use logical coordinates for hit testing (mouse events are in logical coords)
+    const QRectF &buttonRect = button.buttonRectLogical;
+
+    return (pos.y() >= buttonRect.y() - proximityDistance && pos.y() <= buttonRect.y() + proximityDistance
+            && pos.x() >= buttonRect.left() && pos.x() <= buttonRect.right());
+}
+
+bool ScreencastButtonController::shouldHideButton(const ButtonState &button, qint64 currentTime) const
+{
+    // Never hide if pinned
+    if (button.isPinned) {
+        return false;
+    }
+
+    // Hide if no interaction for 3 seconds (3000ms)
+    const qint64 hideDelay = 3000;
+    return (currentTime - button.lastInteractionTime) > hideDelay;
+}
+
