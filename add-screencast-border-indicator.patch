@@ -0,0 +1,134 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "outputstreamhandler.h"
+#include "core/output.h"
+#include "effect/effecthandler.h"
+#include "kwinscreencastborder_logging.h"
+#include "screencastdbus_utils.h"
+
+#include <QDBusArgument>
+
+namespace KWin
+{
+
+OutputStreamHandler::OutputStreamHandler(EffectsHandler *effects, QObject *parent)
+    : IStreamTypeHandler(parent)
+    , m_effects(effects)
+{
+}
+
+OutputStreamHandler::~OutputStreamHandler()
+{
+    // Disconnect all signals
+    for (auto it = m_streamData.begin(); it != m_streamData.end(); ++it) {
+        QObject::disconnect(it->geometryConnection);
+    }
+}
+
+std::optional<ScreencastStreamInfo> OutputStreamHandler::processStream(
+    const QString &path,
+    const QVariantMap &interfaces,
+    const QVariantMap &commonProps)
+{
+    // Extract output-specific properties using utility function
+    QVariantMap outputProps = extractDBusProperties(interfaces, SCREENCAST_OUTPUT_INTERFACE);
+
+    // Extract and validate geometry from D-Bus properties
+    QRect geometry = extractGeometry(outputProps, path);
+    if (geometry.isEmpty()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Invalid or empty geometry for output" << path;
+        return std::nullopt;
+    }
+
+    // Create stream info
+    ScreencastStreamInfo info;
+    info.objectPath = path;
+    info.type = StreamType::Output;
+    info.geometry = geometry;
+
+    // Extract consumer information
+    extractConsumerInfo(commonProps, info.consumerApp, info.consumerPID);
+
+    // Find the output matching this geometry
+    // (We'll connect to its geometryChanged signal in connectSignals)
+    Output *output = nullptr;
+    const auto outputs = m_effects->screens();
+    for (Output *out : outputs) {
+        if (out->geometry() == geometry) {
+            output = out;
+            break;
+        }
+    }
+
+    if (output) {
+        StreamData data;
+        data.output = output;
+        m_streamData[path] = data; // Store for later signal connection
+        qCDebug(KWIN_SCREENCASTBORDER) << "Found output for stream" << path << ":" << output->name();
+    } else {
+        qCDebug(KWIN_SCREENCASTBORDER) << "No output found matching geometry" << geometry << "for" << path;
+    }
+
+    return info;
+}
+
+bool OutputStreamHandler::handlePropertyChange(
+    const QString &path,
+    ScreencastStreamInfo &info,
+    const QVariantMap &changedProps)
+{
+    // Use validated geometry update helper
+    QRect newGeometry;
+    if (updateGeometryFromProperties(changedProps, info.geometry, newGeometry)) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Output geometry updated for" << path
+                                       << "from" << info.geometry << "to" << newGeometry;
+        info.geometry = newGeometry;
+        return true;
+    }
+
+    return false;
+}
+
+void OutputStreamHandler::connectSignals(
+    const QString &path,
+    const ScreencastStreamInfo &info)
+{
+    Q_UNUSED(info);
+
+    auto it = m_streamData.find(path);
+    if (it == m_streamData.end() || !it->output) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "No output to connect signals for" << path;
+        return;
+    }
+
+    Output *output = it->output;
+
+    // Connect to output geometry changes
+    // Note: geometryUpdateNeeded signal removed - geometry updates handled automatically
+    it->geometryConnection = connect(
+        output,
+        &Output::geometryChanged,
+        this,
+        [this, path]() {
+        // Geometry updates handled automatically by scene graph
+    });
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "Connected output signals for" << path << "to" << output->name();
+}
+
+void OutputStreamHandler::disconnectSignals(const QString &path)
+{
+    auto it = m_streamData.find(path);
+    if (it != m_streamData.end()) {
+        QObject::disconnect(it->geometryConnection);
+        m_streamData.erase(it);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Disconnected output signals for" << path;
+    }
+}
+
+} // namespace KWin
+
+#include "moc_outputstreamhandler.cpp"
