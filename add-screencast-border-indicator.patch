diff --git a/src/plugins/screencast/pipewireConsumertracker.cpp b/src/plugins/screencast/pipewireConsumertracker.cpp
new file mode 100644
index 0000000000..22f768504c
--- /dev/null
+++ b/src/plugins/screencast/pipewireConsumertracker.cpp
@@ -0,0 +1,695 @@
+/*
+    SPDX-FileCopyrightText: 2024 KDE Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "pipewireConsumertracker.h"
+
+#include "kwinscreencast_logging.h"
+
+#include <QVariantMap>
+
+#include <pipewire/keys.h>
+
+#include <cstring>
+
+namespace KWin
+{
+
+// Helper: Convert spa_dict to QVariantMap (spa_dict is temporary, must copy)
+// Validates UTF-8 encoding to prevent crashes from malformed PipeWire data
+static QVariantMap spaDictToMap(const spa_dict *dict)
+{
+    QVariantMap map;
+    if (!dict) {
+        return map;
+    }
+
+    for (uint32_t i = 0; i < dict->n_items; ++i) {
+        const spa_dict_item &item = dict->items[i];
+        if (!item.key || !item.value) {
+            continue;
+        }
+
+        // Validate UTF-8 encoding for both key and value
+        // fromUtf8() with QStringDecoder::Flag::Stateless will replace invalid sequences
+        QString key = QString::fromUtf8(item.key);
+        QString value = QString::fromUtf8(item.value);
+
+        // Check if conversion produced valid strings (fromUtf8 returns replacement chars for invalid data)
+        if (!key.isEmpty() && !value.isEmpty()) {
+            map[key] = value;
+        }
+    }
+    return map;
+}
+
+struct NodeListenerData
+{
+    PipeWireConsumerTracker *tracker;
+    pw_node *proxy;
+    spa_hook listener;
+    uint32_t nodeId;
+};
+
+struct ClientListenerData
+{
+    PipeWireConsumerTracker *tracker;
+    pw_client *proxy;
+    spa_hook listener;
+    uint32_t clientId;
+};
+
+PipeWireConsumerTracker::PipeWireConsumerTracker(pw_core *core, uint32_t nodeId, QObject *parent)
+    : QObject(parent)
+    , m_core(core)
+    , m_nodeId(nodeId)
+{
+    setupRegistry();
+}
+
+PipeWireConsumerTracker::~PipeWireConsumerTracker()
+{
+    // Cleanup all client listeners (mutex protected)
+    {
+        QMutexLocker lock(&m_clientListenersMutex);
+        for (auto &[clientId, listenerData] : m_clientListeners) {
+            if (listenerData && listenerData->proxy) {
+                spa_hook_remove(&listenerData->listener);
+                pw_proxy_destroy(reinterpret_cast<pw_proxy *>(listenerData->proxy));
+            }
+        }
+        m_clientListeners.clear();
+    }
+
+    cleanupRegistry();
+}
+
+void PipeWireConsumerTracker::setupRegistry()
+{
+    if (!m_core) {
+        qCWarning(KWIN_SCREENCAST) << "Cannot setup registry: no PipeWire core";
+        return;
+    }
+
+    m_registry = pw_core_get_registry(m_core, PW_VERSION_REGISTRY, 0);
+    if (!m_registry) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to get PipeWire registry";
+        return;
+    }
+
+    static const pw_registry_events registryEvents = {
+        .version = PW_VERSION_REGISTRY_EVENTS,
+        .global = [](void *data, uint32_t id, uint32_t permissions, const char *type,
+                     uint32_t version, const spa_dict *props) {
+        auto tracker = static_cast<PipeWireConsumerTracker *>(data);
+        tracker->onRegistryGlobal(id, permissions, type, version, props);
+    },
+        .global_remove = [](void *data, uint32_t id) {
+        auto tracker = static_cast<PipeWireConsumerTracker *>(data);
+        tracker->onRegistryGlobalRemove(id);
+    }};
+
+    pw_registry_add_listener(m_registry, &m_registryListener, &registryEvents, this);
+    qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Registry listener setup complete for node" << m_nodeId;
+}
+
+void PipeWireConsumerTracker::cleanupRegistry()
+{
+    // Cleanup all node listeners (mutex protected)
+    {
+        QMutexLocker locker(&m_nodeListenersMutex);
+        for (auto &pair : m_nodeListeners) {
+            spa_hook_remove(&pair.second->listener);
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(pair.second->proxy));
+        }
+        m_nodeListeners.clear();
+    }
+
+    m_allLinks.clear();
+    m_clientNodes.clear();
+    m_visitedNodes.clear();
+
+    if (m_registry) {
+        spa_hook_remove(&m_registryListener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(m_registry));
+        m_registry = nullptr;
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Registry cleaned up";
+    }
+}
+
+void PipeWireConsumerTracker::onRegistryGlobal(uint32_t id, uint32_t permissions,
+                                               const char *type, uint32_t version,
+                                               const spa_dict *props)
+{
+    Q_UNUSED(permissions);
+    Q_UNUSED(version);
+
+    // Copy data from PipeWire thread to avoid race conditions
+    QString typeStr = QString::fromUtf8(type);
+    QVariantMap propsMap = spaDictToMap(props);
+
+    // Dispatch to Qt thread for thread-safe processing
+    QMetaObject::invokeMethod(this, [this, id, typeStr, propsMap]() {
+        handleRegistryGlobal(id, typeStr, propsMap);
+    }, Qt::QueuedConnection);
+}
+
+void PipeWireConsumerTracker::handleRegistryGlobal(uint32_t id, QString type, QVariantMap props)
+{
+    // This runs in Qt thread - thread-safe
+    if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Link)) {
+        // Cache ALL links for later graph traversal
+        QString inputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_INPUT_NODE)).toString();
+        QString outputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_OUTPUT_NODE)).toString();
+
+        if (!inputNodeStr.isEmpty() && !outputNodeStr.isEmpty()) {
+            bool okInput, okOutput;
+            uint32_t inputNode = inputNodeStr.toUInt(&okInput);
+            uint32_t outputNode = outputNodeStr.toUInt(&okOutput);
+
+            if (okInput && okOutput) {
+                m_allLinks[id] = LinkInfo{inputNode, outputNode};
+
+                qCDebug(KWIN_SCREENCAST) << "Cached link:" << id
+                                         << "output=" << outputNode
+                                         << "input=" << inputNode;
+            }
+        }
+
+        checkLinkForConsumer(id, props);
+    } else if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Node)) {
+        // Cache node properties for when we need them
+        QString nodeIdStr = props.value(QString::fromUtf8(PW_KEY_OBJECT_ID)).toString();
+        if (!nodeIdStr.isEmpty()) {
+            bool ok;
+            uint32_t nodeId = nodeIdStr.toUInt(&ok);
+            if (!ok) {
+                qCWarning(KWIN_SCREENCAST) << "Invalid node ID string:" << nodeIdStr;
+                return;
+            }
+            // Check if this is a node we're looking for
+            if (m_links.values().contains(nodeId)) {
+                queryNodeProperties(nodeId);
+            }
+        }
+    } else if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Client)) {
+        // Cache client info - clients always have app name and PID
+        QString appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+        QString appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+
+        // Try multiple PID property names (different PipeWire versions use different keys)
+        QString pidStr = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_ID)).toString();
+        if (pidStr.isEmpty()) {
+            pidStr = props.value(QStringLiteral("application.process.id")).toString();
+        }
+        if (pidStr.isEmpty()) {
+            pidStr = props.value(QStringLiteral("pipewire.sec.pid")).toString();
+        }
+
+        if (!appName.isEmpty() || !appBinary.isEmpty()) {
+            ClientInfo clientInfo;
+            clientInfo.appName = appName;
+            clientInfo.appBinary = appBinary;
+
+            if (!pidStr.isEmpty()) {
+                bool ok;
+                quint32 pid = pidStr.toUInt(&ok);
+                // Validate PID: must be non-zero and within reasonable bounds (2^22)
+                // PID 0 is invalid (kernel process), and PIDs > 4194304 are unrealistic
+                if (!ok || pid == 0 || pid > 4194304) {
+                    qCWarning(KWIN_SCREENCAST) << "Invalid PID for client:" << pidStr;
+                    clientInfo.pid = 0;
+                } else {
+                    clientInfo.pid = pid;
+                }
+            }
+
+            m_clientNodes[id] = clientInfo;
+            qCDebug(KWIN_SCREENCAST) << "Cached client:" << id
+                                     << "app=" << (appName.isEmpty() ? appBinary : appName)
+                                     << "pid=" << clientInfo.pid;
+        }
+    }
+}
+
+void PipeWireConsumerTracker::onRegistryGlobalRemove(uint32_t id)
+{
+    // Dispatch to Qt thread for thread-safe processing
+    QMetaObject::invokeMethod(this, [this, id]() {
+        handleRegistryGlobalRemove(id);
+    }, Qt::QueuedConnection);
+}
+
+void PipeWireConsumerTracker::handleRegistryGlobalRemove(uint32_t id)
+{
+    // This runs in Qt thread - thread-safe
+    // Handle link removal
+    if (m_links.contains(id)) {
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Link removed:" << id;
+        m_links.remove(id);
+        m_allLinks.remove(id);
+
+        // Consumer disconnected
+        if (m_links.isEmpty()) {
+            m_consumerApp.clear();
+            m_consumerPID = 0;
+            Q_EMIT consumerDisconnected();
+        }
+    }
+
+    // Handle client removal
+    if (m_clientNodes.contains(id)) {
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Client removed:" << id;
+        m_clientNodes.remove(id);
+    }
+
+    // Handle node listener removal
+    auto it = m_nodeListeners.find(id);
+    if (it != m_nodeListeners.end()) {
+        auto data = std::move(it->second);
+        m_nodeListeners.erase(it);
+        spa_hook_remove(&data->listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(data->proxy));
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Node listener removed for node" << id;
+    }
+}
+
+void PipeWireConsumerTracker::checkLinkForConsumer(uint32_t linkId, const QVariantMap &props)
+{
+    if (props.isEmpty() || m_nodeId == 0) {
+        return;
+    }
+
+    // Check if this link connects TO our stream node
+    QString outputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_OUTPUT_NODE)).toString();
+    if (outputNodeStr.isEmpty()) {
+        return;
+    }
+
+    bool ok;
+    uint32_t outputNodeId = outputNodeStr.toUInt(&ok);
+    if (!ok) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid output node ID string:" << outputNodeStr;
+        return;
+    }
+    if (outputNodeId != m_nodeId) {
+        return; // Not our stream
+    }
+
+    // This link connects to us! Get the consumer node ID
+    QString inputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_INPUT_NODE)).toString();
+    if (inputNodeStr.isEmpty()) {
+        return;
+    }
+
+    uint32_t consumerNodeId = inputNodeStr.toUInt(&ok);
+    if (!ok) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid input node ID string:" << inputNodeStr;
+        return;
+    }
+    m_links[linkId] = consumerNodeId;
+
+    qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Link detected:"
+                             << "id=" << linkId
+                             << "output_node=" << outputNodeId
+                             << "input_node=" << consumerNodeId;
+
+    // Query the consumer node properties
+    queryNodeProperties(consumerNodeId);
+}
+
+void PipeWireConsumerTracker::queryNodeProperties(uint32_t nodeId)
+{
+    // We need to bind to the node to get its properties
+    // This requires creating a proxy and listening for info events
+    auto nodeProxy = static_cast<pw_node *>(
+        pw_registry_bind(m_registry, nodeId, PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, 0));
+
+    if (!nodeProxy) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to bind to consumer node" << nodeId;
+        return;
+    }
+
+    auto listenerData = std::make_unique<NodeListenerData>(NodeListenerData{this, nodeProxy, {}, nodeId});
+    NodeListenerData *listenerDataPtr = nullptr;
+
+    // Track the listener for cleanup (mutex protected)
+    {
+        QMutexLocker locker(&m_nodeListenersMutex);
+        // Avoid duplicate queries
+        if (m_nodeListeners.count(nodeId) > 0) {
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(nodeProxy));
+            return;
+        }
+        m_nodeListeners[nodeId] = std::move(listenerData);
+        listenerDataPtr = m_nodeListeners[nodeId].get();
+    }
+
+    static const pw_node_events nodeEvents = {
+        .version = PW_VERSION_NODE_EVENTS,
+        .info = [](void *data, const pw_node_info *info) {
+        auto *ld = static_cast<NodeListenerData *>(data);
+
+        if (!info || !info->props) {
+            return;
+        }
+
+        // Copy props from PipeWire thread to avoid race conditions
+        QVariantMap propsMap = spaDictToMap(info->props);
+        uint32_t nodeId = ld->nodeId;
+        QPointer<PipeWireConsumerTracker> tracker = ld->tracker;
+
+        // Dispatch to Qt thread for thread-safe processing
+        QMetaObject::invokeMethod(ld->tracker, [tracker, nodeId, propsMap]() {
+            if (!tracker) {
+                qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker was destroyed before node info processing";
+                return;
+            }
+            tracker->handleNodeInfo(nodeId, propsMap);
+        }, Qt::QueuedConnection);
+    }};
+
+    // Add listener outside mutex to avoid deadlock (PipeWire may call callback immediately)
+    pw_node_add_listener(nodeProxy, &listenerDataPtr->listener, &nodeEvents, listenerDataPtr);
+}
+
+void PipeWireConsumerTracker::queryClientProperties(uint32_t clientId)
+{
+    // Bind to the client to get its CURRENT properties (not cached)
+    // This is critical because portal updates client properties after initial registration
+    auto clientProxy = static_cast<pw_client *>(
+        pw_registry_bind(m_registry, clientId, PW_TYPE_INTERFACE_Client, PW_VERSION_CLIENT, 0));
+
+    if (!clientProxy) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to bind to client" << clientId;
+        // Fallback: use cached data if available
+        if (m_clientNodes.contains(clientId)) {
+            const ClientInfo &clientInfo = m_clientNodes[clientId];
+            QString app = clientInfo.appName.isEmpty() ? clientInfo.appBinary : clientInfo.appName;
+            m_consumerApp = app;
+            m_consumerPID = clientInfo.pid;
+            qCDebug(KWIN_SCREENCAST) << "Using cached client info (bind failed):" << app << "pid=" << clientInfo.pid;
+            Q_EMIT consumerConnected(app, clientInfo.pid);
+        } else {
+            Q_EMIT consumerConnected(QString(), 0);
+        }
+        return;
+    }
+
+    auto listenerData = std::make_unique<ClientListenerData>(ClientListenerData{this, clientProxy, {}, clientId});
+    ClientListenerData *listenerDataPtr = nullptr;
+
+    // Track the listener for cleanup (mutex protected)
+    {
+        QMutexLocker locker(&m_clientListenersMutex);
+        // Avoid duplicate queries
+        if (m_clientListeners.count(clientId) > 0) {
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(clientProxy));
+            return;
+        }
+        m_clientListeners[clientId] = std::move(listenerData);
+        listenerDataPtr = m_clientListeners[clientId].get();
+    }
+
+    static const pw_client_events clientEvents = {
+        .version = PW_VERSION_CLIENT_EVENTS,
+        .info = [](void *data, const pw_client_info *info) {
+        auto *ld = static_cast<ClientListenerData *>(data);
+
+        if (!info || !info->props) {
+            return;
+        }
+
+        // Copy props from PipeWire thread to avoid race conditions
+        QVariantMap propsMap = spaDictToMap(info->props);
+        uint32_t clientId = ld->clientId;
+        QPointer<PipeWireConsumerTracker> tracker = ld->tracker;
+
+        // Dispatch to Qt thread for thread-safe processing
+        QMetaObject::invokeMethod(ld->tracker, [tracker, clientId, propsMap]() {
+            if (!tracker) {
+                qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker was destroyed before client info processing";
+                return;
+            }
+            tracker->handleClientInfo(clientId, propsMap);
+        }, Qt::QueuedConnection);
+    }};
+
+    // Add listener outside mutex to avoid deadlock (PipeWire may call callback immediately)
+    pw_client_add_listener(clientProxy, &listenerDataPtr->listener, &clientEvents, listenerDataPtr);
+}
+
+PipeWireConsumerTracker::NodeProperties PipeWireConsumerTracker::extractNodeProperties(const QVariantMap &props)
+{
+    NodeProperties result;
+
+    // Extract application info
+    result.appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+    result.appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+    QString appPIDStr = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_ID)).toString();
+
+    // Parse and validate PID
+    if (!appPIDStr.isEmpty()) {
+        bool ok;
+        quint32 pid = appPIDStr.toUInt(&ok);
+        // Validate PID: must be non-zero and within reasonable bounds (2^22)
+        if (!ok || pid == 0 || pid > 4194304) {
+            qCWarning(KWIN_SCREENCAST) << "Invalid PID:" << appPIDStr;
+            result.pid = 0;
+        } else {
+            result.pid = pid;
+        }
+    }
+
+    // Extract client.id
+    QString clientIdStr = props.value(QString::fromUtf8(PW_KEY_CLIENT_ID)).toString();
+    if (!clientIdStr.isEmpty()) {
+        bool ok;
+        result.clientId = clientIdStr.toUInt(&ok);
+        if (!ok) {
+            qCWarning(KWIN_SCREENCAST) << "Invalid client.id string:" << clientIdStr;
+            result.clientId = 0;
+        }
+    }
+
+    return result;
+}
+
+QString PipeWireConsumerTracker::determineConsumerApp(const QString &appName, const QString &appBinary)
+{
+    if (!appName.isEmpty()) {
+        return appName;
+    }
+    return appBinary;
+}
+
+void PipeWireConsumerTracker::emitConsumerFound(const QString &consumerApp, quint32 pid)
+{
+    m_consumerApp = consumerApp;
+    m_consumerPID = pid;
+
+    qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Consumer detected (node properties):"
+                             << "app=" << consumerApp << "pid=" << pid;
+
+    Q_EMIT consumerConnected(consumerApp, pid);
+}
+
+void PipeWireConsumerTracker::searchDownstreamForConsumer(uint32_t nodeId)
+{
+    qCDebug(KWIN_SCREENCAST) << "Node" << nodeId
+                             << "has no app properties, searching downstream for consumer";
+
+    qCDebug(KWIN_SCREENCAST) << "  -> m_allLinks count:" << m_allLinks.size() << "keys:" << m_allLinks.keys();
+    qCDebug(KWIN_SCREENCAST) << "  -> m_clientNodes keys:" << m_clientNodes.keys();
+
+    m_visitedNodes.clear(); // Reset for new search
+    m_visitedNodes.insert(nodeId); // Mark current as visited
+    m_searchTimer.start(); // Start timeout tracking for graph traversal
+    followLinksDownstream(nodeId, 0);
+
+    // If still nothing found, emit with empty values
+    if (m_consumerApp.isEmpty()) {
+        qCDebug(KWIN_SCREENCAST) << "Could not find consumer app after downstream search";
+        m_consumerApp = QString();
+        m_consumerPID = 0;
+        Q_EMIT consumerConnected(QString(), 0);
+    }
+}
+
+void PipeWireConsumerTracker::cleanupNodeListener(uint32_t nodeId)
+{
+    // Cleanup this specific listener immediately to prevent race conditions
+    // handleNodeInfo is already running in Qt thread (queued from PipeWire callback),
+    // so we can safely remove the listener synchronously here.
+    QMutexLocker locker(&m_nodeListenersMutex);
+    auto it = m_nodeListeners.find(nodeId);
+    if (it != m_nodeListeners.end()) {
+        // Remove hook immediately to prevent PipeWire from calling callbacks
+        // This MUST be done synchronously before PipeWire can invoke another callback
+        spa_hook_remove(&it->second->listener);
+
+        // Defer proxy destruction to avoid potential issues with PipeWire cleanup order
+        // The proxy itself can be safely destroyed later in the event loop
+        pw_node *proxy = it->second->proxy;
+        QMetaObject::invokeMethod(this, [proxy]() {
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(proxy));
+        }, Qt::QueuedConnection);
+
+        // Remove from map
+        m_nodeListeners.erase(it);
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Node listener cleanup complete for node" << nodeId;
+    }
+}
+
+void PipeWireConsumerTracker::handleNodeInfo(uint32_t nodeId, QVariantMap props)
+{
+    // This runs in Qt thread - thread-safe
+    // Extract and parse all node properties
+    NodeProperties nodeProps = extractNodeProperties(props);
+
+    // Debug: log all node properties for troubleshooting
+    qCDebug(KWIN_SCREENCAST) << "Node" << nodeId << "properties:" << props;
+    qCDebug(KWIN_SCREENCAST) << "  -> clientId:" << nodeProps.clientId
+                             << "appName:" << nodeProps.appName
+                             << "appBinary:" << nodeProps.appBinary;
+
+    QString consumerApp = determineConsumerApp(nodeProps.appName, nodeProps.appBinary);
+
+    if (!consumerApp.isEmpty()) {
+        // Found app info directly in node properties - use it
+        emitConsumerFound(consumerApp, nodeProps.pid);
+    } else if (nodeProps.clientId != 0) {
+        // Node belongs to a Client - query CURRENT properties (not cached)
+        // This handles portal property updates: portal changes client properties
+        // from "xdg-desktop-portal" to the real app name after authentication
+        qCDebug(KWIN_SCREENCAST) << "Node" << nodeId << "has client.id" << nodeProps.clientId
+                                 << "- querying current client properties";
+        queryClientProperties(nodeProps.clientId);
+    } else {
+        // No app info on this node - try following links downstream to find consumer
+        searchDownstreamForConsumer(nodeId);
+    }
+
+    // Cleanup this specific listener immediately to prevent race conditions
+    cleanupNodeListener(nodeId);
+}
+
+void PipeWireConsumerTracker::handleClientInfo(uint32_t clientId, QVariantMap props)
+{
+    // This runs in Qt thread - thread-safe
+    // Extract CURRENT application info from client (handles portal property updates)
+    QString appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+    QString appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+
+    // Try multiple PID property names (different PipeWire versions use different keys)
+    QString pidStr = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_ID)).toString();
+    if (pidStr.isEmpty()) {
+        pidStr = props.value(QStringLiteral("application.process.id")).toString();
+    }
+    if (pidStr.isEmpty()) {
+        pidStr = props.value(QStringLiteral("pipewire.sec.pid")).toString();
+    }
+
+    QString consumerApp;
+    if (!appName.isEmpty()) {
+        consumerApp = appName;
+    } else if (!appBinary.isEmpty()) {
+        consumerApp = appBinary;
+    }
+
+    quint32 pid = 0;
+    if (!pidStr.isEmpty()) {
+        bool ok;
+        pid = pidStr.toUInt(&ok);
+        // Validate PID: must be non-zero and within reasonable bounds (2^22)
+        if (!ok || pid == 0 || pid > 4194304) {
+            qCWarning(KWIN_SCREENCAST) << "Invalid PID:" << pidStr;
+            pid = 0;
+        }
+    }
+
+    qCDebug(KWIN_SCREENCAST) << "Client" << clientId << "CURRENT properties (queried, not cached):"
+                             << "app=" << consumerApp << "pid=" << pid;
+
+    if (!consumerApp.isEmpty()) {
+        m_consumerApp = consumerApp;
+        m_consumerPID = pid;
+
+        qCDebug(KWIN_SCREENCAST) << "PipeWireConsumerTracker: Consumer detected (queried client):"
+                                 << "app=" << consumerApp << "pid=" << pid;
+
+        Q_EMIT consumerConnected(consumerApp, pid);
+    } else {
+        qCDebug(KWIN_SCREENCAST) << "Client" << clientId << "has no app info, emitting empty consumer";
+        Q_EMIT consumerConnected(QString(), 0);
+    }
+
+    // Cleanup this client listener immediately
+    {
+        QMutexLocker lock(&m_clientListenersMutex);
+        m_clientListeners.erase(clientId);
+    }
+}
+
+void PipeWireConsumerTracker::followLinksDownstream(uint32_t nodeId, int depth)
+{
+    // Prevent infinite recursion and timeout
+    // MAX_DEPTH = 5: Typical PipeWire filter chains (e.g., stream -> adapter -> filter -> client)
+    // rarely exceed 5 nodes. This protects against pathological graphs while allowing
+    // reasonable real-world topologies.
+    const int MAX_DEPTH = 5;
+    // SEARCH_TIMEOUT_MS = 200ms: Prevents hanging on complex/malicious PipeWire graphs
+    // Real-world searches typically complete in <10ms. Reduced from 500ms to minimize
+    // potential lag during stream setup.
+    const qint64 SEARCH_TIMEOUT_MS = 200;
+
+    if (depth >= MAX_DEPTH) {
+        qCDebug(KWIN_SCREENCAST) << "Max depth" << MAX_DEPTH << "reached in downstream search";
+        return;
+    }
+
+    if (m_searchTimer.isValid() && m_searchTimer.elapsed() > SEARCH_TIMEOUT_MS) {
+        qCWarning(KWIN_SCREENCAST) << "Graph traversal timeout after" << m_searchTimer.elapsed()
+                                   << "ms (limit:" << SEARCH_TIMEOUT_MS << "ms)";
+        return;
+    }
+
+    qCDebug(KWIN_SCREENCAST) << "Searching downstream from node" << nodeId << "depth" << depth;
+
+    // Find all links where this node is the OUTPUT (source)
+    // We want to follow forward to INPUT (destination) nodes - towards the consumer
+    for (auto it = m_allLinks.constBegin(); it != m_allLinks.constEnd(); ++it) {
+        const LinkInfo &link = it.value();
+
+        if (link.outputNode == nodeId) {
+            // Found a link flowing out from our node
+            uint32_t downstreamNode = link.inputNode;
+
+            // Avoid cycles
+            if (m_visitedNodes.contains(downstreamNode)) {
+                qCDebug(KWIN_SCREENCAST) << "Node" << downstreamNode << "already visited, skipping";
+                continue;
+            }
+            m_visitedNodes.insert(downstreamNode);
+
+            qCDebug(KWIN_SCREENCAST) << "Following link" << it.key()
+                                     << "to downstream node" << downstreamNode;
+
+            // Query this downstream node's properties
+            queryNodeProperties(downstreamNode);
+
+            // If we still don't have app info, recurse further downstream
+            if (m_consumerApp.isEmpty()) {
+                followLinksDownstream(downstreamNode, depth + 1);
+            } else {
+                // Found it! Stop searching
+                qCDebug(KWIN_SCREENCAST) << "Found consumer via downstream search:"
+                                         << m_consumerApp;
+                return;
+            }
+        }
+    }
+}
+
+} // namespace KWin
