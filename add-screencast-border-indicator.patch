+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "streamtypehandler.h"
+
+#include <QHash>
+#include <QMetaObject>
+#include <QPointer>
+
+namespace KWin
+{
+
+/**
+ * @brief Handles output-specific screencast streams.
+ *
+ * Output streams record an entire monitor/output. This handler:
+ * - Extracts geometry from D-Bus properties (X, Y, Width, Height)
+ * - Finds the corresponding Output and tracks its geometryChanged signal
+ * - Updates geometry on D-Bus PropertyChanged events
+ */
+class OutputStreamHandler : public IStreamTypeHandler
+{
+    Q_OBJECT
+
+public:
+    explicit OutputStreamHandler(EffectsHandler *effects, QObject *parent = nullptr);
+    ~OutputStreamHandler() override;
+
+    std::optional<ScreencastStreamInfo> processStream(
+        const QString &path,
+        const QVariantMap &interfaces,
+        const QVariantMap &commonProps) override;
+
+    bool handlePropertyChange(
+        const QString &path,
+        ScreencastStreamInfo &info,
+        const QVariantMap &changedProps) override;
+
+    void connectSignals(
+        const QString &path,
+        const ScreencastStreamInfo &info) override;
+
+    void disconnectSignals(const QString &path) override;
+
+private:
+    EffectsHandler *m_effects;
+
+    // Track signal connections and output references per stream
+    struct StreamData
+    {
+        QPointer<Output> output;
+        QMetaObject::Connection geometryConnection;
+    };
+    QHash<QString, StreamData> m_streamData;
+};
+
+} // namespace KWin
