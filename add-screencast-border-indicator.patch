diff --git a/src/plugins/screencast/screencast_validation_constants.h b/src/plugins/screencast/screencast_validation_constants.h
new file mode 100644
index 0000000000..7652803d6f
--- /dev/null
+++ b/src/plugins/screencast/screencast_validation_constants.h
@@ -0,0 +1,40 @@
+/*
+    SPDX-FileCopyrightText: 2025 KDE Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <cstdint>
+
+namespace KWin
+{
+
+/**
+ * Validation constants for D-Bus data from untrusted sources
+ *
+ * These limits prevent integer overflow, DoS attacks, and other security issues
+ * when processing geometry and process ID data from D-Bus interfaces.
+ *
+ * Usage:
+ * - Screen coordinates: MIN_COORDINATE_16BIT to MAX_COORDINATE_16BIT
+ * - Dimensions (width/height): 1 to MAX_DIMENSION
+ * - Process IDs: 0 < pid <= MAX_PID
+ */
+
+// Screen coordinate bounds (16-bit signed integer range)
+// Reasonable for typical multi-monitor setups including negative coordinates
+constexpr int MIN_COORDINATE_16BIT = -32768;
+constexpr int MAX_COORDINATE_16BIT = 32767;
+
+// Maximum dimension (width or height) for screencasts
+// Supports up to 16K resolution (15360x8640) with safety margin
+// Prevents DoS attacks via huge memory allocations
+constexpr int MAX_DIMENSION = 16384;
+
+// Maximum reasonable process ID
+// Linux kernel typically uses much lower values, 2^22 is generous upper bound
+// PID 0 is kernel process (invalid for user processes)
+constexpr uint32_t MAX_PID = 4194304; // 2^22
+
+} // namespace KWin
