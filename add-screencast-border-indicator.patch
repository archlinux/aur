+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastborderdbus.h"
+#include "kwinscreencastborder_logging.h"
+#include "screencastdbus_utils.h"
+
+#include <QDBusArgument>
+#include <QDBusInterface>
+#include <QDBusReply>
+#include <QTimer>
+
+namespace KWin
+{
+
+namespace
+{
+// Security: Limit maximum pending streams to prevent DoS via resource exhaustion
+// Attacker could create many streams without consumers, each allocating timers and memory
+// 64 is reasonable: typical user unlikely to start >64 recordings simultaneously
+constexpr size_t MAX_PENDING_STREAMS = 64;
+
+// Helper to convert string to StreamType enum
+StreamType stringToStreamType(const QString &typeStr)
+{
+    if (typeStr == QLatin1String("window")) {
+        return StreamType::Window;
+    } else if (typeStr == QLatin1String("output")) {
+        return StreamType::Output;
+    } else if (typeStr == QLatin1String("region")) {
+        return StreamType::Region;
+    }
+    // Default to Window if unknown
+    return StreamType::Window;
+}
+
+// Pending stream awaiting consumer detection
+struct PendingStream
+{
+    QString path;
+    StreamType type;
+    QVariantMap interfaces;
+    QTimer *timeoutTimer = nullptr;
+};
+} // anonymous namespace
+
+class ScreencastDBusClientPrivate
+{
+public:
+    QHash<QString, PendingStream> pendingStreams;
+};
+
+ScreencastDBusClient::ScreencastDBusClient(QObject *parent)
+    : QObject(parent)
+    , m_dbus(QDBusConnection::sessionBus())
+    , d(new ScreencastDBusClientPrivate)
+{
+}
+
+ScreencastDBusClient::~ScreencastDBusClient()
+{
+    // Cleanup pending stream timers
+    for (const PendingStream &pending : d->pendingStreams) {
+        if (pending.timeoutTimer) {
+            pending.timeoutTimer->stop();
+            pending.timeoutTimer->deleteLater();
+        }
+    }
+
+    delete d;
+}
+
+void ScreencastDBusClient::connectToService()
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Connecting to ObjectManager D-Bus";
+
+    if (!m_serviceWatcher) {
+        m_serviceWatcher = new QDBusServiceWatcher(
+            KWIN_SERVICE,
+            m_dbus,
+            QDBusServiceWatcher::WatchForRegistration | QDBusServiceWatcher::WatchForUnregistration,
+            this);
+        connect(m_serviceWatcher, &QDBusServiceWatcher::serviceOwnerChanged,
+                this, &ScreencastDBusClient::onServiceOwnerChanged);
+    }
+
+    // Connect to ObjectManager signals
+    bool success1 = m_dbus.connect(
+        KWIN_SERVICE,
+        SCREENCAST_PATH,
+        QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+        QStringLiteral("InterfacesAdded"),
+        this,
+        SLOT(onInterfacesAdded(QDBusObjectPath, QVariantMap)));
+
+    bool success2 = m_dbus.connect(
+        KWIN_SERVICE,
+        SCREENCAST_PATH,
+        QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+        QStringLiteral("InterfacesRemoved"),
+        this,
+        SLOT(onInterfacesRemoved(QDBusObjectPath, QStringList)));
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "D-Bus connection results -"
+                                   << "InterfacesAdded:" << success1
+                                   << "InterfacesRemoved:" << success2;
+
+    if (success1 && success2) {
+        m_connected = true;
+        Q_EMIT serviceConnected();
+
+        // Query existing screencasts
+        QDBusMessage call = QDBusMessage::createMethodCall(
+            KWIN_SERVICE,
+            SCREENCAST_PATH,
+            QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+            QStringLiteral("GetManagedObjects"));
+
+        m_dbus.callWithCallback(
+            call,
+            this,
+            SLOT(onGetManagedObjectsReply(QDBusMessage)),
+            SLOT(onDBusError(QDBusError)));
+    }
+}
+
+void ScreencastDBusClient::stopStream(const QString &objectPath)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Stopping screencast:" << objectPath;
+
+    QDBusInterface iface(
+        KWIN_SERVICE,
+        objectPath,
+        SCREENCAST_INTERFACE,
+        m_dbus);
+
+    if (!iface.isValid()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Invalid D-Bus interface for" << objectPath;
+        return;
+    }
+
+    QDBusReply<void> reply = iface.call(QStringLiteral("Stop"));
+    if (!reply.isValid()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Failed to stop screencast:" << reply.error().message();
+    } else {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Successfully stopped screencast:" << objectPath;
+    }
+}
+
+void ScreencastDBusClient::onGetManagedObjectsReply(const QDBusMessage &reply)
+{
+    // Validate D-Bus message has arguments before accessing
+    if (reply.arguments().isEmpty()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "GetManagedObjects reply has no arguments";
+        return;
+    }
+
+    // Validate reply type before conversion to prevent silent failures
+    const QVariant var = reply.arguments().at(0);
+    if (!var.canConvert<QVariantMap>()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Invalid reply type from GetManagedObjects - expected QVariantMap, got:"
+                                         << var.typeName();
+        return;
+    }
+
+    QVariantMap objects = var.toMap();
+    qCDebug(KWIN_SCREENCASTBORDER) << "GetManagedObjects returned" << objects.size() << "objects";
+
+    for (auto it = objects.constBegin(); it != objects.constEnd(); ++it) {
+        QDBusObjectPath path(it.key()); // Key is already a QString representing the path
+        QVariantMap interfaces = it.value().toMap();
+
+        onInterfacesAdded(path, interfaces);
+    }
+}
+
+void ScreencastDBusClient::onDBusError(const QDBusError &error)
+{
+    qCWarning(KWIN_SCREENCASTBORDER) << "D-Bus error:" << error.message();
+}
+
+void ScreencastDBusClient::onInterfacesAdded(const QDBusObjectPath &objectPath,
+                                             const QVariantMap &interfaces)
+{
+    QString path = objectPath.path();
+    qCDebug(KWIN_SCREENCASTBORDER) << "InterfacesAdded:" << path;
+    qCDebug(KWIN_SCREENCASTBORDER) << "interfaces.keys():" << interfaces.keys();
+
+    // Extract common properties
+    QVariantMap commonProps = extractDBusProperties(interfaces, SCREENCAST_INTERFACE);
+    if (commonProps.isEmpty()) {
+        return;
+    }
+
+    QString typeStr = commonProps.value(QStringLiteral("Type")).toString();
+    StreamType type = stringToStreamType(typeStr);
+    QString consumerApp = commonProps.value(QStringLiteral("ConsumerApp")).toString();
+    qCDebug(KWIN_SCREENCASTBORDER) << "Type:" << typeStr << "consumerApp:" << consumerApp;
+
+    // Handle consumer detection delay - if ConsumerApp is empty, delay emitting streamAdded
+    // until consumer is detected (or timeout expires) to avoid flashing during portal picker
+    if (consumerApp.isEmpty()) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "ConsumerApp empty, delaying stream notification for:" << path;
+
+        // Security: Prevent DoS via unbounded pending stream accumulation
+        if (d->pendingStreams.size() >= MAX_PENDING_STREAMS) {
+            qCWarning(KWIN_SCREENCASTBORDER) << "Maximum pending streams (" << MAX_PENDING_STREAMS
+                                             << ") exceeded, rejecting stream:" << path;
+            // Still subscribe to handle removal signal, but don't queue
+            subscribeToPropertyChanges(path);
+            return;
+        }
+
+        PendingStream pendingStream;
+        pendingStream.path = path;
+        pendingStream.type = type;
+        pendingStream.interfaces = interfaces;
+
+        // Set up timeout timer (300ms - enough time for consumer detection, short enough to not be noticeable)
+        pendingStream.timeoutTimer = new QTimer(this);
+        pendingStream.timeoutTimer->setSingleShot(true);
+        pendingStream.timeoutTimer->setInterval(300);
+        connect(pendingStream.timeoutTimer, &QTimer::timeout, this, [this, path]() {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Consumer detection timeout for:" << path;
+            // Timeout expired - assume consumer is not hidden, emit streamAdded
+            if (d->pendingStreams.contains(path)) {
+                PendingStream pending = d->pendingStreams.take(path);
+                QVariantMap commonProps = extractDBusProperties(pending.interfaces, SCREENCAST_INTERFACE);
+                // Don't filter - if timeout expired without consumer, show border
+                Q_EMIT streamAdded(pending.path, pending.type, pending.interfaces);
+            }
+        });
+        pendingStream.timeoutTimer->start();
+
+        // Subscribe to property changes for this object
+        subscribeToPropertyChanges(path);
+
+        // Store in pending streams
+        d->pendingStreams[path] = std::move(pendingStream);
+        return;
+    }
+
+    // Subscribe to property changes (Effect will handle filtering)
+    subscribeToPropertyChanges(path);
+
+    // Emit signal for main effect to process
+    Q_EMIT streamAdded(path, type, interfaces);
+}
+
+void ScreencastDBusClient::onInterfacesRemoved(const QDBusObjectPath &objectPath,
+                                               const QStringList &interfaces)
+{
+    Q_UNUSED(interfaces);
+
+    QString path = objectPath.path();
+    qCDebug(KWIN_SCREENCASTBORDER) << "InterfacesRemoved:" << path;
+
+    // Disconnect per-object PropertiesChanged signal
+    if (m_subscribedPaths.contains(path)) {
+        m_dbus.disconnect(
+            KWIN_SERVICE,
+            path,
+            QStringLiteral("org.freedesktop.DBus.Properties"),
+            QStringLiteral("PropertiesChanged"),
+            this,
+            SLOT(onObjectPropertiesChanged(QString, QVariantMap, QStringList)));
+        m_subscribedPaths.remove(path);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Unsubscribed from PropertiesChanged for" << path;
+    }
+
+    // Remove from pending streams if present (and cleanup timer)
+    if (d->pendingStreams.contains(path)) {
+        PendingStream pending = d->pendingStreams.take(path);
+        if (pending.timeoutTimer) {
+            pending.timeoutTimer->stop();
+            pending.timeoutTimer->deleteLater();
+        }
+        qCDebug(KWIN_SCREENCASTBORDER) << "Removed pending stream:" << path;
+    }
+
+    // Emit removal signal
+    Q_EMIT streamRemoved(path);
+}
+
+void ScreencastDBusClient::onObjectPropertiesChanged(const QString &interface,
+                                                     const QVariantMap &changedProps,
+                                                     const QStringList &invalidated)
+{
+    // CRITICAL: Extract path IMMEDIATELY before any processing to avoid race condition
+    // QDBusContext::message() returns the CURRENT message being processed.
+    // If another DBus signal arrives during processing, the context changes!
+    const QString objectPath = QDBusContext::message().path();
+
+    Q_UNUSED(invalidated);
+
+    if (interface != SCREENCAST_INTERFACE) {
+        return;
+    }
+
+    // Check if this is a pending stream waiting for consumer detection
+    if (d->pendingStreams.contains(objectPath)) {
+        if (changedProps.contains(QStringLiteral("ConsumerApp"))) {
+            QString newConsumerApp = changedProps.value(QStringLiteral("ConsumerApp")).toString();
+            qCDebug(KWIN_SCREENCASTBORDER) << "ConsumerApp detected for pending stream:" << objectPath
+                                           << "app:" << newConsumerApp;
+
+            PendingStream pending = d->pendingStreams.take(objectPath);
+
+            // Cancel timeout timer
+            if (pending.timeoutTimer) {
+                pending.timeoutTimer->stop();
+                pending.timeoutTimer->deleteLater();
+            }
+
+            // Emit streamAdded - Effect will handle filtering
+            qCDebug(KWIN_SCREENCASTBORDER) << "Consumer detected, emitting streamAdded for:" << objectPath;
+
+            // Update ConsumerApp in interfaces before emitting
+            QVariantMap interfaces = pending.interfaces;
+            QVariantMap commonProps = extractDBusProperties(interfaces, SCREENCAST_INTERFACE);
+            commonProps[QStringLiteral("ConsumerApp")] = newConsumerApp;
+
+            // Update the interfaces map with new consumer info
+            // Need to reconstruct the interface entry
+            if (interfaces.contains(SCREENCAST_INTERFACE)) {
+                QVariantMap updatedInterface;
+                const QVariant interfaceValue = interfaces.value(SCREENCAST_INTERFACE);
+                if (interfaceValue.canConvert<QDBusArgument>()) {
+                    const QDBusArgument arg = interfaceValue.value<QDBusArgument>();
+                    arg >> updatedInterface;
+                } else {
+                    updatedInterface = interfaceValue.toMap();
+                }
+                updatedInterface[QStringLiteral("ConsumerApp")] = newConsumerApp;
+                interfaces[SCREENCAST_INTERFACE] = updatedInterface;
+            }
+
+            Q_EMIT streamAdded(pending.path, pending.type, interfaces);
+            return;
+        }
+    }
+
+    // For non-pending streams, just forward the property change
+    Q_EMIT streamPropertiesChanged(objectPath, changedProps);
+}
+
+void ScreencastDBusClient::onServiceOwnerChanged(const QString &service, const QString &oldOwner, const QString &newOwner)
+{
+    Q_UNUSED(oldOwner);
+
+    if (service == KWIN_SERVICE) {
+        if (!newOwner.isEmpty()) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Service appeared, reconnecting";
+            connectToService();
+        } else {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Service disappeared, clearing state";
+            m_connected = false;
+
+            // Clear pending streams
+            for (const PendingStream &pending : d->pendingStreams) {
+                if (pending.timeoutTimer) {
+                    pending.timeoutTimer->stop();
+                    pending.timeoutTimer->deleteLater();
+                }
+            }
+            d->pendingStreams.clear();
+
+            Q_EMIT serviceDisconnected();
+        }
+    }
+}
+
+void ScreencastDBusClient::subscribeToPropertyChanges(const QString &path)
+{
+    bool success = m_dbus.connect(
+        KWIN_SERVICE,
+        path,
+        QStringLiteral("org.freedesktop.DBus.Properties"),
+        QStringLiteral("PropertiesChanged"),
+        this,
+        SLOT(onObjectPropertiesChanged(QString, QVariantMap, QStringList)));
+
+    if (success) {
+        m_subscribedPaths.insert(path);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Subscribed to PropertiesChanged for" << path;
+    }
+}
+
+std::optional<StreamType> ScreencastDBusClient::determineStreamType(const QVariantMap &interfaces)
+{
+    if (interfaces.contains(SCREENCAST_WINDOW_INTERFACE)) {
+        return StreamType::Window;
+    } else if (interfaces.contains(SCREENCAST_OUTPUT_INTERFACE)) {
+        return StreamType::Output;
+    } else if (interfaces.contains(SCREENCAST_REGION_INTERFACE)) {
+        return StreamType::Region;
+    }
+    return std::nullopt;
+}
+
+} // namespace KWin
+
