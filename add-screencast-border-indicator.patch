+++ b/src/plugins/screencastborder/windowstreamhandler.h
@@ -0,0 +1,72 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "streamtypehandler.h"
+
+#include <QHash>
+#include <QMetaObject>
+#include <QUuid>
+
+namespace KWin
+{
+
+/**
+ * @brief Handles window-specific screencast streams.
+ *
+ * Window streams record a specific window. This handler:
+ * - Extracts window UUID and finds the corresponding EffectWindow
+ * - Uses EffectWindow::frameGeometry() instead of D-Bus properties
+ * - Tracks window geometry changes via windowFrameGeometryChanged signal
+ * - Handles window closure via windowClosed signal
+ * - Manages pending windows with initially invalid (0x0) geometry
+ */
+class WindowStreamHandler : public IStreamTypeHandler
+{
+    Q_OBJECT
+
+public:
+    explicit WindowStreamHandler(EffectsHandler *effects, QObject *parent = nullptr);
+    ~WindowStreamHandler() override;
+
+    std::optional<ScreencastStreamInfo> processStream(
+        const QString &path,
+        const QVariantMap &interfaces,
+        const QVariantMap &commonProps) override;
+
+    bool handlePropertyChange(
+        const QString &path,
+        ScreencastStreamInfo &info,
+        const QVariantMap &changedProps) override;
+
+    void connectSignals(
+        const QString &path,
+        const ScreencastStreamInfo &info) override;
+
+    void disconnectSignals(const QString &path) override;
+
+private:
+    EffectsHandler *m_effects;
+
+    // Track signal connections per stream
+    struct SignalConnections
+    {
+        QMetaObject::Connection geometryConnection;
+        QMetaObject::Connection closedConnection;
+    };
+    QHash<QString, SignalConnections> m_connections;
+
+    // Pending windows awaiting valid geometry
+    struct PendingWindowInfo
+    {
+        QString windowId;
+        QString consumerApp;
+        quint32 consumerPID = 0;
+    };
+    QHash<QString, PendingWindowInfo> m_pendingWindows;
+};
+
+} // namespace KWin
