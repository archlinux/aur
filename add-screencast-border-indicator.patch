+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastdbus_utils.h"
+
+#include <QDBusArgument>
+
+namespace KWin
+{
+
+QVariantMap extractDBusProperties(const QVariantMap &interfaces, const QString &interfaceName)
+{
+    QVariantMap props;
+    const QVariant interfaceValue = interfaces.value(interfaceName);
+    if (interfaceValue.canConvert<QDBusArgument>()) {
+        const QDBusArgument arg = interfaceValue.value<QDBusArgument>();
+        arg >> props;
+    } else {
+        props = interfaceValue.toMap();
+    }
+    return props;
+}
+
+QRect extractGeometry(const QVariantMap &props, const QString &streamName)
+{
+    Q_UNUSED(streamName); // Used in log messages for context
+
+    bool ok;
+
+    // Extract X coordinate as double first (DBus properties use double for coordinates)
+    // Then round instead of truncate for consistency with QRectF::toRect()
+    double xDouble = props.value(QStringLiteral("X")).toDouble(&ok);
+    if (!ok || xDouble < MIN_COORDINATE_16BIT || xDouble > MAX_COORDINATE_16BIT) {
+        return QRect(); // Invalid - conversion failed or out of bounds
+    }
+    int x = qRound(xDouble);
+
+    // Extract Y coordinate as double, then round
+    double yDouble = props.value(QStringLiteral("Y")).toDouble(&ok);
+    if (!ok || yDouble < MIN_COORDINATE_16BIT || yDouble > MAX_COORDINATE_16BIT) {
+        return QRect(); // Invalid - conversion failed or out of bounds
+    }
+    int y = qRound(yDouble);
+
+    // Extract and validate width (must be positive and reasonable)
+    // Range: 1 to MAX_DIMENSION (max 16K resolution, prevents integer overflow)
+    int width = props.value(QStringLiteral("Width")).toInt(&ok);
+    if (!ok || width <= 0 || width > MAX_DIMENSION) {
+        return QRect(); // Invalid - must be positive and within reasonable bounds
+    }
+
+    // Extract and validate height (must be positive and reasonable)
+    // Range: 1 to MAX_DIMENSION (max 16K resolution, prevents integer overflow)
+    int height = props.value(QStringLiteral("Height")).toInt(&ok);
+    if (!ok || height <= 0 || height > MAX_DIMENSION) {
+        return QRect(); // Invalid - must be positive and within reasonable bounds
+    }
+
+    return QRect(x, y, width, height);
+}
+
+void extractConsumerInfo(const QVariantMap &commonProps, QString &outConsumerApp, quint32 &outConsumerPID)
+{
+    // Extract consumer application name (may be empty if not yet detected)
+    outConsumerApp = commonProps.value(QStringLiteral("ConsumerApp")).toString();
+
+    // Extract consumer process ID (0 if not available)
+    outConsumerPID = commonProps.value(QStringLiteral("ConsumerPID")).toUInt();
+}
+
+bool updateGeometryFromProperties(const QVariantMap &changedProps, const QRect &currentGeometry, QRect &outGeometry)
+{
+    // Check if any geometry properties are present
+    if (!changedProps.contains(QStringLiteral("X")) && !changedProps.contains(QStringLiteral("Y"))
+        && !changedProps.contains(QStringLiteral("Width")) && !changedProps.contains(QStringLiteral("Height"))) {
+        return false; // No geometry changes
+    }
+
+    bool ok;
+    int x = currentGeometry.x();
+    int y = currentGeometry.y();
+    int width = currentGeometry.width();
+    int height = currentGeometry.height();
+
+    // Validate and update X coordinate if present
+    if (changedProps.contains(QStringLiteral("X"))) {
+        double xDouble = changedProps.value(QStringLiteral("X")).toDouble(&ok);
+        if (!ok || xDouble < MIN_COORDINATE_16BIT || xDouble > MAX_COORDINATE_16BIT) {
+            return false; // Invalid X coordinate
+        }
+        x = qRound(xDouble);
+    }
+
+    // Validate and update Y coordinate if present
+    if (changedProps.contains(QStringLiteral("Y"))) {
+        double yDouble = changedProps.value(QStringLiteral("Y")).toDouble(&ok);
+        if (!ok || yDouble < MIN_COORDINATE_16BIT || yDouble > MAX_COORDINATE_16BIT) {
+            return false; // Invalid Y coordinate
+        }
+        y = qRound(yDouble);
+    }
+
+    // Validate and update width if present
+    if (changedProps.contains(QStringLiteral("Width"))) {
+        int newWidth = changedProps.value(QStringLiteral("Width")).toInt(&ok);
+        if (!ok || newWidth <= 0 || newWidth > MAX_DIMENSION) {
+            return false; // Invalid width
+        }
+        width = newWidth;
+    }
+
+    // Validate and update height if present
+    if (changedProps.contains(QStringLiteral("Height"))) {
+        int newHeight = changedProps.value(QStringLiteral("Height")).toInt(&ok);
+        if (!ok || newHeight <= 0 || newHeight > MAX_DIMENSION) {
+            return false; // Invalid height
+        }
+        height = newHeight;
+    }
+
+    QRect newGeometry(x, y, width, height);
+    if (newGeometry != currentGeometry) {
+        outGeometry = newGeometry;
+        return true; // Geometry changed and is valid
+    }
+
+    return false; // Geometry unchanged
+}
+
+bool validatePID(quint32 pid)
+{
+    // PID must be non-zero and within reasonable bounds
+    // PID 0 is invalid (kernel process on Unix)
+    // Maximum PID is typically much lower than 2^32, we use 2^22 (4,194,304) as reasonable upper limit
+    return pid > 0 && pid <= MAX_PID;
+}
+
+} // namespace KWin
