@@ -0,0 +1,29 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "streamtypehandler.h"
+#include "outputstreamhandler.h"
+#include "regionstreamhandler.h"
+#include "windowstreamhandler.h"
+
+namespace KWin
+{
+
+std::unique_ptr<IStreamTypeHandler> StreamTypeHandlerFactory::create(StreamType type,
+                                                                     EffectsHandler *effects,
+                                                                     QObject *parent)
+{
+    switch (type) {
+    case StreamType::Window:
+        return std::make_unique<WindowStreamHandler>(effects, parent);
+    case StreamType::Output:
+        return std::make_unique<OutputStreamHandler>(effects, parent);
+    case StreamType::Region:
+        return std::make_unique<RegionStreamHandler>(parent);
+    }
+    return nullptr;
+}
+
+} // namespace KWin
diff --git a/src/plugins/screencastborder/streamtypehandler.h b/src/plugins/screencastborder/streamtypehandler.h
new file mode 100644
index 0000000000..747ec691db
--- /dev/null
+++ b/src/plugins/screencastborder/streamtypehandler.h
@@ -0,0 +1,156 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QMetaObject>
+#include <QObject>
+#include <QPointer>
+#include <QRect>
+#include <QString>
+#include <QVariantMap>
+
+#include <optional>
+
+namespace KWin
+{
+
+class EffectWindow;
+class EffectsHandler;
+class Output;
+
+/**
+ * @brief Type of screencast stream.
+ */
+enum class StreamType {
+    Window, ///< Recording a specific window
+    Output, ///< Recording an entire monitor/output
+    Region ///< Recording a rectangular screen region
+};
+
+/**
+ * @brief Common information about a registered screencast stream.
+ *
+ * Stores metadata and state for a screencast, including
+ * geometry, consumer application info, and references (for window streams).
+ */
+struct ScreencastStreamInfo
+{
+    QString objectPath; ///< D-Bus object path
+    StreamType type; ///< Type of stream (Window/Output/Region)
+    QRect geometry; ///< Screen area being recorded
+    QString consumerApp; ///< Application consuming the stream (e.g., "obs", "firefox")
+    quint32 consumerPID = 0; ///< PID of consuming application
+    QPointer<EffectWindow> window; ///< Window being recorded (window streams only)
+    qreal titlebarHeight = 32.0; ///< Cached titlebar height for button positioning
+};
+
+/**
+ * @brief Interface for handling stream type-specific logic.
+ *
+ * Each screencast type (Window, Output, Region) has different requirements
+ * for geometry extraction, signal connections, and property updates.
+ * Implementations handle these differences.
+ */
+class IStreamTypeHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit IStreamTypeHandler(QObject *parent = nullptr)
+        : QObject(parent)
+    {
+    }
+
+    virtual ~IStreamTypeHandler() = default;
+
+    /**
+     * @brief Process a new stream of this type.
+     * @param path D-Bus object path
+     * @param interfaces D-Bus interface map with type-specific properties
+     * @param commonProps Common stream properties (ConsumerApp, ConsumerPID, etc.)
+     * @return Stream info if successful, nullopt if pending/failed
+     *
+     * Extracts geometry and type-specific data from interfaces.
+     * May return nullopt if stream requires pending state (e.g., window with 0x0 geometry).
+     */
+    virtual std::optional<ScreencastStreamInfo> processStream(
+        const QString &path,
+        const QVariantMap &interfaces,
+        const QVariantMap &commonProps) = 0;
+
+    /**
+     * @brief Handle property changes for this stream type.
+     * @param path D-Bus object path
+     * @param info Current stream info (will be updated if geometry changed)
+     * @param changedProps Changed D-Bus properties
+     * @return true if geometry changed (repaint needed), false otherwise
+     *
+     * Updates stream info based on D-Bus property changes.
+     * May update geometry, consumer info, or other type-specific data.
+     */
+    virtual bool handlePropertyChange(
+        const QString &path,
+        ScreencastStreamInfo &info,
+        const QVariantMap &changedProps) = 0;
+
+    /**
+     * @brief Connect signals for geometry tracking.
+     * @param path D-Bus object path
+     * @param info Stream info with necessary references
+     *
+     * Sets up connections to track geometry changes specific to this stream type.
+     * For example, window streams connect to windowFrameGeometryChanged.
+     */
+    virtual void connectSignals(
+        const QString &path,
+        const ScreencastStreamInfo &info) = 0;
+
+    /**
+     * @brief Disconnect signals when stream ends.
+     * @param path D-Bus object path
+     *
+     * Removes signal connections created by connectSignals().
+     */
+    virtual void disconnectSignals(const QString &path) = 0;
+
+Q_SIGNALS:
+    /**
+     * @brief Emitted when stream should be removed (e.g., window closed).
+     * @param path D-Bus object path
+     */
+    void streamRemovalRequested(const QString &path);
+
+    /**
+     * @brief Emitted when a pending stream becomes ready for registration.
+     * @param path D-Bus object path
+     * @param info Complete stream info for the now-ready stream
+     *
+     * Used by handlers that defer stream creation (e.g., WindowStreamHandler
+     * waiting for valid geometry). When the stream becomes ready, this signal
+     * notifies the Effect to register it.
+     */
+    void pendingStreamReady(const QString &path, const ScreencastStreamInfo &info);
+};
+
+/**
+ * @brief Factory for creating stream type handlers.
+ */
+class StreamTypeHandlerFactory
+{
+public:
+    /**
+     * @brief Create handler for the specified stream type.
+     * @param type Stream type to handle
+     * @param effects Effects handler for accessing KWin APIs
+     * @param parent Parent QObject
+     * @return Handler instance, or nullptr if type is invalid
+     */
+    static std::unique_ptr<IStreamTypeHandler> create(StreamType type,
+                                                      EffectsHandler *effects,
+                                                      QObject *parent = nullptr);
+};
+
+} // namespace KWin
diff --git a/src/plugins/screencastborder/windowstreamhandler.cpp b/src/plugins/screencastborder/windowstreamhandler.cpp
new file mode 100644
index 0000000000..535f3f7b48
--- /dev/null
+++ b/src/plugins/screencastborder/windowstreamhandler.cpp
@@ -0,0 +1,218 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "windowstreamhandler.h"
+#include "effect/effecthandler.h"
+#include "effect/effectwindow.h"
+#include "kwinscreencastborder_logging.h"
+#include "screencastdbus_utils.h"
+
+#include <QDBusArgument>
+
+namespace KWin
+{
+
+WindowStreamHandler::WindowStreamHandler(EffectsHandler *effects, QObject *parent)
+    : IStreamTypeHandler(parent)
+    , m_effects(effects)
+{
+}
+
+WindowStreamHandler::~WindowStreamHandler()
+{
+    // Disconnect all signals
+    for (auto it = m_connections.begin(); it != m_connections.end(); ++it) {
+        QObject::disconnect(it->geometryConnection);
+        QObject::disconnect(it->closedConnection);
+    }
+
+    // Clear pending windows
+    m_pendingWindows.clear();
+}
+
+std::optional<ScreencastStreamInfo> WindowStreamHandler::processStream(
+    const QString &path,
+    const QVariantMap &interfaces,
+    const QVariantMap &commonProps)
+{
+    // Extract window-specific properties using utility function
+    QVariantMap windowProps = extractDBusProperties(interfaces, SCREENCAST_WINDOW_INTERFACE);
+
+    // Find the window by UUID
+    QString windowId = windowProps.value(QStringLiteral("WindowId")).toString();
+    QUuid uuid(windowId);
+    if (uuid.isNull()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Invalid window UUID:" << windowId;
+        return std::nullopt;
+    }
+
+    EffectWindow *window = m_effects->findWindow(uuid);
+    if (!window) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Window not found for UUID:" << windowId;
+        return std::nullopt;
+    }
+
+    // Use EffectWindow geometry directly instead of D-Bus properties
+    // D-Bus properties may be 0x0 at InterfacesAdded time
+    QRect geometry = window->frameGeometry().toRect();
+
+    if (geometry.isEmpty()) {
+        // Geometry may be initially empty - store as pending window
+        qCDebug(KWIN_SCREENCASTBORDER) << "Window geometry empty - storing as pending:" << path;
+
+        PendingWindowInfo pendingInfo;
+        pendingInfo.windowId = windowId;
+        extractConsumerInfo(commonProps, pendingInfo.consumerApp, pendingInfo.consumerPID);
+
+        m_pendingWindows[path] = pendingInfo;
+        return std::nullopt;
+    }
+
+    // Create stream info
+    ScreencastStreamInfo info;
+    info.objectPath = path;
+    info.type = StreamType::Window;
+    info.geometry = geometry;
+
+    // Extract consumer information
+    extractConsumerInfo(commonProps, info.consumerApp, info.consumerPID);
+
+    info.window = window;
+
+    // Cache titlebar height for button positioning
+    // Simple heuristic: titlebar is roughly 32px (will be refined by actual measurements)
+    info.titlebarHeight = 32.0;
+
+    return info;
+}
+
+bool WindowStreamHandler::handlePropertyChange(
+    const QString &path,
+    ScreencastStreamInfo &info,
+    const QVariantMap &changedProps)
+{
+    // Check if this is a pending window stream waiting for valid geometry
+    if (m_pendingWindows.contains(path)) {
+        if (changedProps.contains(QStringLiteral("X")) || changedProps.contains(QStringLiteral("Y"))
+            || changedProps.contains(QStringLiteral("Width")) || changedProps.contains(QStringLiteral("Height"))) {
+
+            const PendingWindowInfo &pendingInfo = m_pendingWindows[path];
+
+            // Find the EffectWindow by UUID
+            QUuid uuid(pendingInfo.windowId);
+            EffectWindow *window = m_effects->findWindow(uuid);
+
+            if (window) {
+                // Use EffectWindow geometry directly (not D-Bus properties)
+                QRect geometry = window->frameGeometry().toRect();
+
+                if (!geometry.isEmpty()) {
+                    qCDebug(KWIN_SCREENCASTBORDER) << "Pending window geometry became valid:" << geometry
+                                                   << "- emitting pendingStreamReady";
+
+                    // Create stream info
+                    ScreencastStreamInfo streamInfo;
+                    streamInfo.objectPath = path;
+                    streamInfo.type = StreamType::Window;
+                    streamInfo.geometry = geometry;
+                    streamInfo.consumerApp = pendingInfo.consumerApp;
+                    streamInfo.consumerPID = pendingInfo.consumerPID;
+                    streamInfo.window = window;
+                    streamInfo.titlebarHeight = 32.0;
+
+                    // Remove from pending windows
+                    m_pendingWindows.remove(path);
+
+                    // Emit signal for Effect to register the stream
+                    Q_EMIT pendingStreamReady(path, streamInfo);
+
+                    // Return false since this is not an update to existing stream
+                    return false;
+                }
+            }
+        }
+        // Pending window not ready yet
+        return false;
+    }
+
+    // Handle property changes for active (non-pending) streams
+    bool geometryChanged = false;
+
+    // For window streams, use EffectWindow geometry, not D-Bus properties
+    // However, D-Bus PropertyChanged can signal that geometry needs to be re-read
+    if (changedProps.contains(QStringLiteral("X")) || changedProps.contains(QStringLiteral("Y"))
+        || changedProps.contains(QStringLiteral("Width")) || changedProps.contains(QStringLiteral("Height"))) {
+
+        if (info.window) {
+            QRect newGeometry = info.window->frameGeometry().toRect();
+            if (newGeometry != info.geometry && !newGeometry.isEmpty()) {
+                qCDebug(KWIN_SCREENCASTBORDER) << "Window geometry updated for" << path
+                                               << "from" << info.geometry << "to" << newGeometry;
+                info.geometry = newGeometry;
+                geometryChanged = true;
+            }
+        }
+    }
+
+    return geometryChanged;
+}
+
+void WindowStreamHandler::connectSignals(
+    const QString &path,
+    const ScreencastStreamInfo &info)
+{
+    if (!info.window) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Cannot connect signals - no window for" << path;
+        return;
+    }
+
+    SignalConnections connections;
+
+    // Connect to window geometry changes
+    // Note: geometryUpdateNeeded signal removed - WindowItem children follow parent automatically
+    connections.geometryConnection = connect(
+        info.window.data(),
+        &EffectWindow::windowFrameGeometryChanged,
+        this,
+        [this, path](EffectWindow *, const QRectF &) {
+        // Geometry updates handled automatically by scene graph
+    });
+
+    // Connect to window closure using EffectsHandler::windowClosed
+    connections.closedConnection = connect(
+        m_effects,
+        &EffectsHandler::windowClosed,
+        this,
+        [this, path, window = info.window](EffectWindow *w) {
+        if (w == window) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Window closed for" << path << "- requesting removal";
+            Q_EMIT streamRemovalRequested(path);
+        }
+    });
+
+    m_connections[path] = connections;
+    qCDebug(KWIN_SCREENCASTBORDER) << "Connected window signals for" << path;
+}
+
+void WindowStreamHandler::disconnectSignals(const QString &path)
+{
+    // Remove from pending windows if present
+    if (m_pendingWindows.remove(path) > 0) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Removed pending window stream:" << path;
+    }
+
+    // Disconnect signal connections
+    auto it = m_connections.find(path);
+    if (it != m_connections.end()) {
+        QObject::disconnect(it->geometryConnection);
+        QObject::disconnect(it->closedConnection);
+        m_connections.erase(it);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Disconnected window signals for" << path;
+    }
+}
+
+} // namespace KWin
+
+#include "moc_windowstreamhandler.cpp"
diff --git a/src/plugins/screencastborder/windowstreamhandler.h b/src/plugins/screencastborder/windowstreamhandler.h
new file mode 100644
index 0000000000..ed84c1214c
