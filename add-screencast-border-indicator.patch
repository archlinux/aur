+#pragma once
+
+#include "screencastborderbutton.h"
+
+#include <QColor>
+#include <QMatrix4x4>
+#include <QRect>
+#include <QRectF>
+#include <QSizeF>
+#include <QString>
+#include <memory>
+
+namespace KWin
+{
+
+class GLShader;
+class GLTexture;
+class GLVertexBuffer;
+class RenderTarget;
+class RenderViewport;
+
+/**
+ * @brief Utility class for rendering screencast borders and UI elements.
+ *
+ * Provides stateless rendering functions for drawing borders, buttons,
+ * tooltips, and other OpenGL-based UI elements. All methods are static
+ * and take rendering state as parameters.
+ */
+class ScreencastBorderRenderer
+{
+public:
+    // ButtonState type from ScreencastButtonController
+    using ButtonState = ScreencastButtonController::ButtonState;
+    /**
+     * @brief Draws a colored border around a rectangular area.
+     * @param renderTarget The render target
+     * @param viewport The render viewport
+     * @param geometry The area to draw border around
+     * @param color Border color
+     * @param width Border width in pixels
+     * @param outputBounds Optional clipping bounds (for multi-monitor)
+     */
+    static void drawBorder(const RenderTarget &renderTarget,
+                           const RenderViewport &viewport,
+                           const QRect &geometry,
+                           const QColor &color,
+                           int width,
+                           const QRect &outputBounds = QRect());
+
+    /**
+     * @brief Creates a text texture for button labels.
+     * @param text Text to render
+     * @param fontSize Font size in points
+     * @param textColor Text color
+     * @param size Target size for the texture
+     * @param scale Device pixel ratio for HiDPI
+     * @return OpenGL texture containing rendered text
+     */
+    static std::unique_ptr<GLTexture> createTextTexture(const QString &text,
+                                                        qreal fontSize,
+                                                        const QColor &textColor,
+                                                        const QSizeF &size,
+                                                        qreal scale);
+
+    /**
+     * @brief Creates an icon texture from system theme.
+     * @param iconName Icon name (e.g., "media-playback-stop")
+     * @param size Target size for the icon
+     * @param scale Device pixel ratio for HiDPI
+     * @return OpenGL texture containing rendered icon
+     */
+    static std::unique_ptr<GLTexture> createIconTexture(const QString &iconName,
+                                                        const QSizeF &size,
+                                                        qreal scale);
+
+    /**
+     * @brief Draws a rounded rectangle using OpenGL.
+     * @param vbo Vertex buffer for geometry
+     * @param shader Shader program to use
+     * @param left Left edge coordinate
+     * @param top Top edge coordinate
+     * @param right Right edge coordinate
+     * @param bottom Bottom edge coordinate
+     * @param radius Corner radius in pixels
+     * @param color Fill color
+     */
+    static void drawRoundedRect(GLVertexBuffer *vbo,
+                                GLShader *shader,
+                                qreal left, qreal top,
+                                qreal right, qreal bottom,
+                                qreal radius,
+                                const QColor &color);
+
+    /**
+     * @brief Calculates contrasting color for text on background.
+     * @param backgroundColor Background color to contrast against
+     * @return Black or white color for optimal readability
+     */
+    static QColor getContrastColor(const QColor &backgroundColor);
+
+    /**
+     * @brief Draws the interactive stop button.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param button Button state containing geometry and textures (modifies cached textures)
+     * @param borderColor Border color (for thickened segment when hidden)
+     * @param borderWidth Border width in pixels (for thickened segment)
+     * @param scale Device pixel ratio
+     */
+    static void drawStopButton(const RenderTarget &renderTarget,
+                               const QMatrix4x4 &projectionMatrix,
+                               ButtonState &button,
+                               const QColor &borderColor,
+                               int borderWidth,
+                               qreal scale);
+
+    /**
+     * @brief Draws thickened border segment where button would be (when hidden).
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param buttonRect Button area in device coordinates
+     * @param borderColor Border color
+     * @param borderWidth Border width in pixels
+     * @param scale Device pixel ratio
+     */
+    static void drawThickenedBorderSegment(const RenderTarget &renderTarget,
+                                           const QMatrix4x4 &projectionMatrix,
+                                           const QRectF &buttonRect,
+                                           const QColor &borderColor,
+                                           int borderWidth,
+                                           qreal scale);
+
+    /**
+     * @brief Draws a tooltip above the button.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param button Button state (read-only for tooltip)
+     * @param scale Device pixel ratio
+     */
+    static void drawTooltip(const RenderTarget &renderTarget,
+                            const QMatrix4x4 &projectionMatrix,
+                            const ButtonState &button,
+                            qreal scale);
+
+private:
+    /**
+     * @brief Internal helper for border rendering with projection matrix.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param geometry Border geometry in device coordinates
+     * @param color Border color
+     * @param width Border width in pixels
+     * @param outputBounds Optional clipping bounds
+     */
+    static void drawBorderInternal(const RenderTarget &renderTarget,
+                                   const QMatrix4x4 &projectionMatrix,
+                                   const QRectF &geometry,
+                                   const QColor &color,
+                                   int width,
+                                   const QRectF &outputBounds = QRectF());
+
+    /**
+     * @brief Helper: Draw button background with rounded corners.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param buttonRect Button rectangle in device coordinates
+     * @param bgColor Background color (with opacity)
+     * @param scale Device pixel ratio
+     */
+    static void drawButtonBackground(const RenderTarget &renderTarget,
+                                     const QMatrix4x4 &projectionMatrix,
+                                     const QRectF &buttonRect,
+                                     const QColor &bgColor,
+                                     qreal scale);
+
+    /**
+     * @brief Helper: Draw button grip (3 vertical lines for dragging).
+     * @param projectionMatrix Projection matrix for rendering
+     * @param gripRect Grip rectangle in device coordinates
+     * @param gripColor Grip line color
+     * @param scale Device pixel ratio
+     */
+    static void drawButtonGrip(const QMatrix4x4 &projectionMatrix,
+                               const QRectF &gripRect,
+                               const QColor &gripColor,
+                               qreal scale);
+
+    /**
+     * @brief Helper: Draw button stop icon texture.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param button Button state (modifies cached texture if needed)
+     * @param scale Device pixel ratio
+     */
+    static void drawButtonIcon(const RenderTarget &renderTarget,
+                               const QMatrix4x4 &projectionMatrix,
+                               ButtonState &button,
+                               qreal scale);
+
+    /**
+     * @brief Helper: Draw button pin icon texture.
+     * @param renderTarget The render target
+     * @param projectionMatrix Projection matrix for rendering
+     * @param button Button state (modifies cached texture if needed)
+     * @param scale Device pixel ratio
+     */
+    static void drawButtonPinIcon(const RenderTarget &renderTarget,
+                                  const QMatrix4x4 &projectionMatrix,
+                                  ButtonState &button,
+                                  qreal scale);
+};
+
+} // namespace KWin
