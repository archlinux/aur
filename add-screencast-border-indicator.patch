+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "scene/item.h"
+#include "screencastborderbutton.h"
+
+#include <QColor>
+#include <memory>
+
+namespace KWin
+{
+
+class ImageItem;
+class ScreencastButtonController;
+
+// Type alias for nested ButtonState struct
+using ButtonState = ScreencastButtonController::ButtonState;
+
+/**
+ * @brief Scene graph Item that renders screencast stop button.
+ *
+ * ButtonItem integrates stop buttons into the scene graph using composition:
+ * - Container Item with ImageItem child for rendering
+ * - Correct Z-ordering (buttons render with their parent, not always on top)
+ * - Unified coordinate system (scene coordinates, no manual scaling)
+ * - Automatic repaint handling (scene graph manages updates)
+ * - Rendered to QImage using QPainter, then uploaded as texture via child ImageItem
+ *
+ * The button consists of:
+ * - Background rectangle with rounded corners
+ * - Grip lines (drag handle)
+ * - Stop icon (from theme)
+ * - Pin icon (from theme, when visible)
+ *
+ * ButtonItem holds a non-owning pointer to ButtonState, which is managed by
+ * ScreencastButtonController. The controller handles all interaction logic
+ * (hover, drag, click), while ButtonItem focuses purely on rendering.
+ */
+class ButtonItem : public Item
+{
+    Q_OBJECT
+
+public:
+    /**
+     * @brief Create a ButtonItem.
+     * @param state Non-owning pointer to button state (managed by controller)
+     * @param parent Parent Item (WindowItem for window streams, overlayItem for output/region)
+     */
+    explicit ButtonItem(ButtonState *state, Item *parent = nullptr);
+    ~ButtonItem() override;
+
+    /**
+     * @brief Get the button state.
+     * @return Non-owning pointer to button state
+     */
+    ButtonState *buttonState() const;
+
+    /**
+     * @brief Set border color for button rendering.
+     * @param color Border color from parent stream
+     */
+    void setBorderColor(const QColor &color);
+
+    /**
+     * @brief Set border width for consistent styling.
+     * @param width Border width from parent stream
+     */
+    void setBorderWidth(int width);
+
+    /**
+     * @brief Update button rendering.
+     *
+     * Renders button to QImage and updates child ImageItem.
+     * Should be called when button state changes.
+     */
+    void updateButton();
+
+private:
+    /**
+     * @brief Render button to QImage.
+     * @return QImage with button rendered at device resolution
+     */
+    QImage renderButton() const;
+
+    /**
+     * @brief Get contrast color for button foreground elements.
+     * @param backgroundColor Button background color
+     * @return White or black, depending on background luminance
+     */
+    QColor getContrastColor(const QColor &backgroundColor) const;
+
+    /**
+     * @brief Draw button background with rounded bottom corners.
+     * @param painter Painter to draw with (already configured)
+     * @param buttonRect Button rectangle in logical coordinates
+     * @param bgColor Background color with opacity
+     */
+    void drawButtonBackground(QPainter &painter, const QRectF &buttonRect, const QColor &bgColor) const;
+
+    /**
+     * @brief Draw grip lines (drag handle) with hover effect.
+     * @param painter Painter to draw with (already configured)
+     * @param gripRect Grip rectangle in logical coordinates
+     */
+    void drawButtonGrip(QPainter &painter, const QRectF &gripRect) const;
+
+    /**
+     * @brief Draw stop icon with hover highlighting.
+     * @param painter Painter to draw with (already configured)
+     * @param iconRect Icon rectangle in logical coordinates
+     */
+    void drawButtonIcon(QPainter &painter, const QRectF &iconRect) const;
+
+    /**
+     * @brief Draw pin icon with hover highlighting.
+     * @param painter Painter to draw with (already configured)
+     * @param pinRect Pin rectangle in logical coordinates
+     */
+    void drawButtonPinIcon(QPainter &painter, const QRectF &pinRect) const;
+
+    ButtonState *m_state; ///< Non-owning pointer to button state
+    QColor m_borderColor; ///< Border color for styling
+    int m_borderWidth = 5; ///< Border width for consistency
+
+    std::unique_ptr<ImageItem> m_imageItem; ///< Child item for rendering
+};
+
+} // namespace KWin
