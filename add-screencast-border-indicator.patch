@@ -0,0 +1,71 @@
+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "../screencast/screencast_validation_constants.h"
+
+#include <QLatin1String>
+#include <QRect>
+#include <QString>
+#include <QVariantMap>
+
+namespace KWin
+{
+
+// D-Bus constants shared between DBus client and stream handlers
+static constexpr QLatin1String KWIN_SERVICE("org.kde.KWin");
+static constexpr QLatin1String SCREENCAST_PATH("/org/kde/KWin/ScreenCast");
+static constexpr QLatin1String SCREENCAST_INTERFACE("org.kde.KWin.ScreenCast");
+static constexpr QLatin1String SCREENCAST_WINDOW_INTERFACE("org.kde.KWin.ScreenCast.Window");
+static constexpr QLatin1String SCREENCAST_OUTPUT_INTERFACE("org.kde.KWin.ScreenCast.Output");
+static constexpr QLatin1String SCREENCAST_REGION_INTERFACE("org.kde.KWin.ScreenCast.Region");
+
+// Validation constants are now imported from screencast_validation_constants.h
+// This ensures consistency between server-side (screencast) and client-side (screencastborder) validation
+
+/**
+ * @brief Extract properties from D-Bus interface map.
+ * @param interfaces Map of interface names to properties
+ * @param interfaceName Interface to extract
+ * @return Property map, or empty if interface not found
+ */
+QVariantMap extractDBusProperties(const QVariantMap &interfaces, const QString &interfaceName);
+
+/**
+ * @brief Extract and validate geometry from D-Bus properties.
+ * @param props Property map containing X, Y, Width, Height
+ * @param streamName Stream identifier for error reporting
+ * @return Valid QRect, or invalid QRect if validation fails
+ */
+QRect extractGeometry(const QVariantMap &props, const QString &streamName);
+
+/**
+ * @brief Extract consumer information from D-Bus common properties.
+ * @param commonProps Property map containing ConsumerApp and ConsumerPID
+ * @param outConsumerApp Output parameter for consumer application name
+ * @param outConsumerPID Output parameter for consumer process ID
+ */
+void extractConsumerInfo(const QVariantMap &commonProps, QString &outConsumerApp, quint32 &outConsumerPID);
+
+/**
+ * @brief Update geometry from D-Bus property changes with validation.
+ * Validates each property change and updates the geometry only if all values are valid.
+ * Uses the same validation rules as extractGeometry().
+ * @param changedProps Map of changed properties (may contain X, Y, Width, Height)
+ * @param currentGeometry Current geometry to use as fallback for missing properties
+ * @param outGeometry Output parameter for the new geometry
+ * @return true if geometry changed and is valid, false otherwise
+ */
+bool updateGeometryFromProperties(const QVariantMap &changedProps, const QRect &currentGeometry, QRect &outGeometry);
+
+/**
+ * @brief Validate a process ID from D-Bus.
+ * @param pid Process ID to validate
+ * @return true if PID is valid (non-zero and within reasonable bounds), false otherwise
+ */
+bool validatePID(quint32 pid);
+
+} // namespace KWin
diff --git a/src/plugins/screencastborder/streamtypehandler.cpp b/src/plugins/screencastborder/streamtypehandler.cpp
new file mode 100644
index 0000000000..1f507bf713
