+/*
+    SPDX-FileCopyrightText: 2025
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastborder_config.h"
+
+#include "screencastborderconfig.h"
+#include <config-kwin.h>
+
+#include <KLocalizedString>
+#include <KPluginFactory>
+#include <QInputDialog>
+#include <kwineffects_interface.h>
+
+K_PLUGIN_CLASS(KWin::ScreencastBorderEffectConfig)
+
+namespace KWin
+{
+
+ScreencastBorderEffectConfig::ScreencastBorderEffectConfig(QObject *parent, const KPluginMetaData &data)
+    : KCModule(parent, data)
+{
+    ui.setupUi(widget());
+    ScreencastBorderConfig::instance(KWIN_CONFIG);
+    addConfig(ScreencastBorderConfig::self(), widget());
+
+    // Connect slider value change to label update
+    connect(ui.kcfg_BorderWidth, &QSlider::valueChanged, this, &ScreencastBorderEffectConfig::onBorderWidthChanged);
+
+    // Connect button clicks
+    connect(ui.buttonAdd, &QPushButton::clicked, this, &ScreencastBorderEffectConfig::onAddApplicationClicked);
+    connect(ui.buttonRemove, &QPushButton::clicked, this, &ScreencastBorderEffectConfig::onRemoveApplicationClicked);
+
+    // Connect list selection change to update Remove button state
+    connect(ui.listWidgetHiddenApps, &QListWidget::itemSelectionChanged, this, &ScreencastBorderEffectConfig::updateRemoveButtonState);
+
+    // Initial state
+    updateRemoveButtonState();
+    onBorderWidthChanged(ui.kcfg_BorderWidth->value());
+}
+
+ScreencastBorderEffectConfig::~ScreencastBorderEffectConfig()
+{
+}
+
+void ScreencastBorderEffectConfig::load()
+{
+    KCModule::load();
+    loadHiddenApplications();
+}
+
+void ScreencastBorderEffectConfig::save()
+{
+    saveHiddenApplications();
+    KCModule::save();
+
+    OrgKdeKwinEffectsInterface interface(QStringLiteral("org.kde.KWin"),
+                                         QStringLiteral("/Effects"),
+                                         QDBusConnection::sessionBus());
+    interface.reconfigureEffect(QStringLiteral("screencastborder"));
+}
+
+void ScreencastBorderEffectConfig::defaults()
+{
+    KCModule::defaults();
+    loadHiddenApplications();
+}
+
+void ScreencastBorderEffectConfig::onBorderWidthChanged(int value)
+{
+    ui.labelBorderWidthValue->setText(i18n("%1 px", value));
+}
+
+void ScreencastBorderEffectConfig::onAddApplicationClicked()
+{
+    bool ok;
+    QString appName = QInputDialog::getText(widget(),
+                                            i18n("Add Application"),
+                                            i18n("Application executable name:"),
+                                            QLineEdit::Normal,
+                                            QString(),
+                                            &ok);
+
+    if (ok && !appName.isEmpty()) {
+        // Check if already exists
+        auto items = ui.listWidgetHiddenApps->findItems(appName, Qt::MatchExactly);
+        if (items.isEmpty()) {
+            ui.listWidgetHiddenApps->addItem(appName);
+            markAsChanged();
+        }
+    }
+}
+
+void ScreencastBorderEffectConfig::onRemoveApplicationClicked()
+{
+    auto selectedItems = ui.listWidgetHiddenApps->selectedItems();
+    for (auto *item : selectedItems) {
+        delete item;
+    }
+    markAsChanged();
+    updateRemoveButtonState();
+}
+
+void ScreencastBorderEffectConfig::updateRemoveButtonState()
+{
+    ui.buttonRemove->setEnabled(!ui.listWidgetHiddenApps->selectedItems().isEmpty());
+}
+
+void ScreencastBorderEffectConfig::loadHiddenApplications()
+{
+    ui.listWidgetHiddenApps->clear();
+
+    const QStringList apps = ScreencastBorderConfig::hiddenApplications();
+    for (const QString &app : apps) {
+        if (!app.isEmpty()) {
+            ui.listWidgetHiddenApps->addItem(app);
+        }
+    }
+}
+
+void ScreencastBorderEffectConfig::saveHiddenApplications()
+{
+    QStringList apps;
+    for (int i = 0; i < ui.listWidgetHiddenApps->count(); ++i) {
+        QString appName = ui.listWidgetHiddenApps->item(i)->text();
+        if (!appName.isEmpty()) {
+            apps.append(appName);
+        }
+    }
+
+    ScreencastBorderConfig::setHiddenApplications(apps);
+}
+
+} // namespace KWin
+
+#include "moc_screencastborder_config.cpp"
+#include "screencastborder_config.moc"
