+*/
+
+#pragma once
+
+#include "opengl/gltexture.h"
+
+#include <QObject>
+#include <QPointF>
+#include <QRectF>
+#include <QString>
+
+#include <memory>
+#include <unordered_map>
+
+namespace KWin
+{
+
+/**
+ * @brief Manages interactive stop button state and animations.
+ *
+ * This class handles all button-related logic including:
+ * - Button geometry calculation and layout
+ * - Mouse interaction (hover, click, drag)
+ * - Drag-to-reposition functionality
+ * - Pin button to keep visible
+ * - Auto-hide/show animations based on proximity
+ * - Tooltip display
+ *
+ * The controller maintains state for multiple buttons (one per active screencast)
+ * and emits signals when user actions occur (stop requested, repaint needed).
+ */
+class ScreencastButtonController : public QObject
+{
+    Q_OBJECT
+
+public:
+    /**
+     * @brief Button state for interactive stop button.
+     *
+     * Manages geometry, interaction state, animations, and cached textures
+     * for the stop button displayed at the top of screencast areas.
+     * Uses both logical (unscaled) and device (scaled) coordinates.
+     */
+    struct ButtonState
+    {
+        // Device coordinates (scaled) - used for rendering
+        QRectF buttonRect; ///< Entire button area (grip + button)
+        QRectF gripRect; ///< Grip area (left part of button)
+        QRectF textRect; ///< Text/clickable area (right part of button)
+        QRectF pinButtonRect; ///< Pin icon hit area
+
+        // Logical coordinates (unscaled) - used for input hit testing
+        QRectF buttonRectLogical;
+        QRectF gripRectLogical;
+        QRectF textRectLogical;
+        QRectF pinButtonRectLogical;
+
+        float positionRatio = 0.75f; ///< Position along top edge (0.0-1.0)
+        bool isHovered = false; ///< Mouse is over entire button area
+        bool isGripHovered = false; ///< Mouse is over grip specifically
+        bool isStopHovered = false; ///< Mouse is over stop button specifically
+        bool isDragging = false; ///< Currently dragging the grip
+        QPointF dragStartPos; ///< Mouse position when drag started
+        float dragStartRatio; ///< positionRatio when drag started
+
+        // Cached textures for rendering (lazily initialized)
+        // Non-const to allow explicit mutation during rendering
+        std::unique_ptr<GLTexture> textTexture; ///< Cached text rendering
+        qreal cachedButtonHeight = 0.0; ///< Track if texture needs regeneration
+
+        // Pin button state
+        bool isPinned = false; ///< Pin state (default: unpinned/auto-hide)
+        bool isPinHovered = false; ///< Mouse is over pin button
+        std::unique_ptr<GLTexture> pinTexture; ///< Cached pin icon rendering
+
+        // Auto-hide animation state
+        qreal opacity = 1.0; ///< Current opacity (0.0-1.0) for fade animation
+        qreal collapseProgress = 1.0; ///< Collapse/expand progress (0.0=collapsed, 1.0=expanded)
+        qint64 lastInteractionTime = 0; ///< Timestamp of last hover/drag (ms since epoch)
+        bool isAnimating = false; ///< Whether animation is in progress
+
+        // Rendering optimization: dirty flag to avoid re-rendering every frame
+        qreal lastRenderedCollapseProgress = -1.0; ///< Last collapseProgress value rendered
+        bool renderDirty = true; ///< True if button needs re-rendering
+
+        // Tooltip state
+        qint64 hoverStartTime = 0; ///< When hover started (for tooltip delay)
+        bool showTooltip = false; ///< Whether to show tooltip
+
+        // Cached stream geometry (in logical coordinates) for drag calculations
+        QRectF streamGeometry;
+        qreal scale = 1.0;
+
+        // Move-only type (because of unique_ptr)
+        ButtonState() = default;
+        ButtonState(ButtonState &&) = default;
+        ButtonState &operator=(ButtonState &&) = default;
+        ButtonState(const ButtonState &) = delete;
+        ButtonState &operator=(const ButtonState &) = delete;
+    };
+
+    explicit ScreencastButtonController(QObject *parent = nullptr);
+    ~ScreencastButtonController() override;
+
+    /**
+     * @brief Enable or disable button display.
+     * @param show true to show buttons, false to hide
+     */
+    void setShowButtons(bool show);
+
+    /**
+     * @brief Check if buttons are enabled.
+     * @return true if buttons should be shown, false otherwise
+     */
+    bool showButtons() const
+    {
+        return m_showButtons;
+    }
+
+    /**
+     * @brief Create button state for a new stream.
+     * @param streamId Unique identifier for the stream (D-Bus object path)
+     */
+    void createButton(const QString &streamId);
+
+    /**
+     * @brief Remove button state for a stream.
+     * @param streamId Stream identifier
+     */
+    void removeButton(const QString &streamId);
+
+    /**
+     * @brief Update button geometry based on stream area.
+     * @param streamId Stream identifier
+     * @param streamGeometry Geometry of the screencast area (device coordinates)
+     * @param scale Output scale factor
+     */
+    void updateButtonGeometry(const QString &streamId, const QRectF &streamGeometry, qreal scale);
+
+    /**
+     * @brief Handle pointer motion event.
+     * @param pos Mouse position in logical coordinates
+     * @param timestamp Event timestamp in milliseconds
+     * @return true if event was consumed (button interaction), false otherwise
+     */
+    bool handlePointerMotion(const QPointF &pos, qint64 timestamp);
+
+    /**
+     * @brief Handle pointer button event.
+     * @param pos Mouse position in logical coordinates
+     * @param button Mouse button
+     * @param state Button state (pressed/released)
+     * @param timestamp Event timestamp in milliseconds
+     * @return true if event was consumed (button clicked), false otherwise
+     */
+    bool handlePointerButton(const QPointF &pos, Qt::MouseButton button,
+                             bool pressed, qint64 timestamp);
+
+    /**
+     * @brief Update button animations (fade in/out).
+     * @param currentTime Current timestamp in milliseconds
+     *
+     * Call this every frame to update opacity animations.
+     */
+    void updateAnimations(qint64 currentTime);
+
+    /**
+     * @brief Get button state for a stream.
+     * @param streamId Stream identifier
+     * @return Pointer to button state, or nullptr if not found
+     */
+    ButtonState *getButton(const QString &streamId);
+
+    /**
+     * @brief Check if button is currently visible (not transparent).
+     * @param streamId Stream identifier
+     * @return true if button opacity > 0, false otherwise
+     */
+    bool isButtonVisible(const QString &streamId) const;
+
+    /**
+     * @brief Get all button states (for rendering).
+     * @return Map of stream IDs to button states
+     */
+    const std::unordered_map<QString, std::unique_ptr<ButtonState>> &buttons() const
+    {
+        return m_buttons;
+    }
+
+Q_SIGNALS:
+    /**
+     * @brief Emitted when user requests to stop a screencast.
+     * @param streamId Stream identifier to stop
+     */
+    void stopRequested(const QString &streamId);
+
+    /**
+     * @brief Emitted when button state changes and repaint is needed.
+     */
+    void repaintNeeded();
+
+private:
+    /**
+     * @brief Test if position hits button area.
+     * @param pos Position in logical coordinates
+     * @param streamId Stream identifier
+     * @return true if position is inside button, false otherwise
+     */
+    bool hitTestButton(const QPointF &pos, const QString &streamId) const;
+
+    /**
+     * @brief Test if position hits grip area.
+     * @param pos Position in logical coordinates
+     * @param streamId Stream identifier
+     * @return true if position is inside grip, false otherwise
+     */
+    bool hitTestGrip(const QPointF &pos, const QString &streamId) const;
+
+    /**
+     * @brief Test if position hits pin button area.
+     * @param pos Position in logical coordinates
+     * @param streamId Stream identifier
+     * @return true if position is inside pin button, false otherwise
+     */
+    bool hitTestPinButton(const QPointF &pos, const QString &streamId) const;
+
+    /**
+     * @brief Test if position hits stop button area.
+     * @param pos Position in logical coordinates
+     * @param streamId Stream identifier
+     * @return true if position is inside stop button, false otherwise
+     */
+    bool hitTestStopButton(const QPointF &pos, const QString &streamId) const;
+
+    /**
+     * @brief Check if mouse is near top border of button (proximity detection).
+     * @param pos Mouse position in logical coordinates
+     * @param streamId Stream identifier
+     * @param proximityDistance Distance threshold in pixels
+     * @return true if mouse is within distance, false otherwise
+     */
+    bool isMouseNearTopBorder(const QPointF &pos, const QString &streamId,
+                              qreal proximityDistance = 20.0) const;
+
+    /**
+     * @brief Check if button should be hidden due to inactivity.
+     * @param button Button state
+     * @param currentTime Current timestamp
+     * @return true if button should hide, false otherwise
+     */
+    bool shouldHideButton(const ButtonState &button, qint64 currentTime) const;
+
+    // NOTE: Using std::unordered_map instead of QHash because ButtonState contains
+    // std::unique_ptr members (move-only type). QHash requires copyable types.
+    std::unordered_map<QString, std::unique_ptr<ButtonState>> m_buttons;
+    bool m_showButtons = true;
+    QString m_draggingStreamId; ///< Track which stream's button is being dragged
+};
+
+} // namespace KWin
