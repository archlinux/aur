@@ -0,0 +1,392 @@
+/*
+    SPDX-FileCopyrightText: 2025 KDE Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastdbusinterface.h"
+#include "kwinscreencast_logging.h"
+#include "outputscreencastsource.h"
+#include "regionscreencastsource.h"
+#include "screencastdbus_utils.h"
+#include "screencastmanager.h"
+#include "screencastsource.h"
+#include "screencaststream.h"
+#include "windowscreencastsource.h"
+
+// Generated D-Bus adaptors
+#include "outputstreamadaptor.h"
+#include "regionstreamadaptor.h"
+#include "screencastadaptor.h"
+#include "windowstreamadaptor.h"
+
+#include "core/output.h"
+#include "window.h"
+
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusContext>
+#include <QDBusMessage>
+#include <QElapsedTimer>
+#include <QSet>
+
+namespace KWin
+{
+
+namespace
+{
+// Security: Rate limiting to prevent introspection spam
+// Allows 100 calls per second per service - enough for legitimate use, prevents DoS
+constexpr int RATE_LIMIT_CALLS_PER_SECOND = 100;
+constexpr qint64 RATE_LIMIT_WINDOW_MS = 1000;
+
+struct RateLimitInfo
+{
+    QElapsedTimer windowStart;
+    int callCount = 0;
+};
+} // anonymous namespace
+
+ScreencastDBusInterface::ScreencastDBusInterface(ScreencastManager *manager)
+    : QObject(manager)
+    , m_manager(manager)
+{
+    qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: Constructor called";
+
+    // Register on D-Bus at root path
+    bool registered = QDBusConnection::sessionBus().registerObject(
+        QStringLiteral("/org/kde/KWin/ScreenCast"),
+        QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+        this,
+        QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllSignals);
+
+    qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: ObjectManager registered:" << registered;
+
+    // Connect to stream lifecycle
+    connect(manager, &ScreencastManager::streamAdded,
+            this, &ScreencastDBusInterface::onStreamAdded);
+    connect(manager, &ScreencastManager::streamRemoved,
+            this, &ScreencastDBusInterface::onStreamRemoved);
+
+    qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: Connected to manager signals";
+}
+
+ScreencastDBusInterface::~ScreencastDBusInterface()
+{
+    // Unregister all stream objects
+    for (const QDBusObjectPath &path : m_streamPaths.values()) {
+        QDBusConnection::sessionBus().unregisterObject(path.path());
+    }
+
+    QDBusConnection::sessionBus().unregisterObject(
+        QStringLiteral("/org/kde/KWin/ScreenCast"));
+}
+
+QString ScreencastDBusInterface::streamObjectPath(ScreenCastStream *stream) const
+{
+    if (!stream) {
+        return QString();
+    }
+    return QStringLiteral("/org/kde/KWin/ScreenCast/node_%1").arg(stream->nodeId());
+}
+
+QStringList ScreencastDBusInterface::streamInterfaceNames(ScreenCastStream *stream) const
+{
+    QStringList interfaces;
+    interfaces << QStringLiteral("org.kde.KWin.ScreenCast");
+
+    ScreenCastSource *source = stream->source();
+    if (source) {
+        // Use polymorphic dbusInterfaceName() instead of qobject_cast cascade
+        // This follows Open/Closed Principle - new source types don't require changes here
+        interfaces << source->dbusInterfaceName();
+    }
+
+    return interfaces;
+}
+
+QVariantMap ScreencastDBusInterface::streamInterfaces(ScreenCastStream *stream) const
+{
+    // Delegate to utility function to eliminate duplication
+    return ScreenCastDBusUtils::extractAllStreamProperties(stream);
+}
+
+bool ScreencastDBusInterface::validateCaller()
+{
+    // Security Model:
+    // - Screencast streams are already authorized via xdg-desktop-portal before creation
+    // - This interface exposes read-only metadata about authorized streams
+    // - Access is limited to session bus (same user session)
+    // - We log calls for auditability but don't block legitimate introspection
+    // - Rate limiting prevents introspection spam attacks
+    //
+    // Privacy considerations:
+    // - Exposed data: window titles, positions, consumer app/PID
+    // - This information is already available via other session APIs
+    // - Blocking would break ObjectManager standard pattern
+    //
+    // Future: Consider PolicyKit integration if more fine-grained control is needed
+
+    if (!calledFromDBus()) {
+        // Internal call, always allowed
+        return true;
+    }
+
+    QString callerService = message().service();
+    qCInfo(KWIN_SCREENCAST) << "D-Bus introspection requested by:" << callerService;
+
+    // Verify caller is on session bus (should always be true, but verify)
+    if (callerService.isEmpty()) {
+        qCWarning(KWIN_SCREENCAST) << "D-Bus call from unknown/invalid service";
+        return false;
+    }
+
+    // Rate limiting: Prevent introspection spam (DoS attack vector)
+    auto &rateLimit = m_rateLimitTracking[callerService];
+
+    // Initialize timer if this is first call from this service
+    if (!rateLimit.first.isValid()) {
+        rateLimit.first.start();
+        rateLimit.second = 1;
+        return true;
+    }
+
+    qint64 elapsed = rateLimit.first.elapsed();
+
+    // Reset window if elapsed time exceeds rate limit window
+    if (elapsed >= RATE_LIMIT_WINDOW_MS) {
+        rateLimit.first.restart();
+        rateLimit.second = 1;
+        return true;
+    }
+
+    // Increment call count and check limit
+    rateLimit.second++;
+    if (rateLimit.second > RATE_LIMIT_CALLS_PER_SECOND) {
+        qCWarning(KWIN_SCREENCAST) << "Rate limit exceeded for service:" << callerService
+                                   << "(" << rateLimit.second << "calls in" << elapsed << "ms)";
+        return false;
+    }
+
+    return true;
+}
+
+QVariantMap ScreencastDBusInterface::GetManagedObjects()
+{
+    // Validate and log the caller for security auditing
+    if (!validateCaller()) {
+        sendErrorReply(QDBusError::AccessDenied,
+                       QStringLiteral("Access denied to screencast introspection"));
+        return QVariantMap();
+    }
+
+    qCDebug(KWIN_SCREENCAST) << "D-Bus: GetManagedObjects() called";
+
+    QVariantMap objects;
+    const QList<ScreenCastStream *> streams = m_manager->activeStreams();
+
+    for (ScreenCastStream *stream : streams) {
+        QString path = streamObjectPath(stream);
+        if (!path.isEmpty()) {
+            objects[path] = streamInterfaces(stream);
+        }
+    }
+
+    qCDebug(KWIN_SCREENCAST) << "D-Bus: Returning" << objects.size() << "managed objects";
+    return objects;
+}
+
+void ScreencastDBusInterface::onStreamAdded(ScreenCastStream *stream)
+{
+    qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: onStreamAdded called for stream:" << stream;
+
+    if (!stream || !stream->source()) {
+        qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: Stream has no source, returning";
+        return;
+    }
+
+    // Wait for stream to be ready (have node ID)
+    // Use QPointer to prevent use-after-free if stream is deleted before lambda executes
+    QPointer<ScreenCastStream> streamPtr(stream);
+    connect(stream, &ScreenCastStream::ready, this, [this, streamPtr](quint32 nodeId) {
+        Q_UNUSED(nodeId);
+
+        // Check if stream still exists
+        if (!streamPtr) {
+            qCDebug(KWIN_SCREENCAST) << "Stream was deleted before ready signal";
+            return;
+        }
+
+        ScreenCastStream *stream = streamPtr.data();
+        QString path = streamObjectPath(stream);
+        if (path.isEmpty()) {
+            qCWarning(KWIN_SCREENCAST) << "Failed to generate path for stream";
+            return;
+        }
+
+        // Store stream path
+        QDBusObjectPath objectPath(path);
+        m_streamPaths[stream] = objectPath;
+
+        // Create and track adaptors
+        m_streamAdaptors[stream] = createStreamAdaptors(stream);
+
+        // Register stream on D-Bus
+        registerStreamOnDBus(path, stream);
+
+        // Connect all property change signals
+        connectStreamPropertySignals(stream, path);
+    }, Qt::SingleShotConnection);
+}
+
+void ScreencastDBusInterface::onStreamRemoved(ScreenCastStream *stream)
+{
+    qCDebug(KWIN_SCREENCAST) << "ScreencastDBusInterface: onStreamRemoved called for stream:" << stream;
+
+    if (!m_streamPaths.contains(stream)) {
+        return;
+    }
+
+    QDBusObjectPath objectPath = m_streamPaths.take(stream);
+    m_streamsAnnouncedOnDBus.remove(stream);
+    QStringList interfaces = streamInterfaceNames(stream);
+
+    // Remove adaptor tracking - adaptors will be automatically deleted by Qt
+    // since stream is their parent (QObject parent-child relationship)
+    if (m_streamAdaptors.contains(stream)) {
+        int count = m_streamAdaptors.take(stream).size();
+        qCDebug(KWIN_SCREENCAST) << "Removed tracking for" << count << "adaptors (Qt will auto-delete)";
+    }
+
+    // Unregister object
+    QDBusConnection::sessionBus().unregisterObject(objectPath.path());
+
+    // Emit InterfacesRemoved signal
+    Q_EMIT InterfacesRemoved(objectPath, interfaces);
+
+    qCDebug(KWIN_SCREENCAST) << "InterfacesRemoved emitted for" << objectPath.path();
+}
+
+QList<QObject *> ScreencastDBusInterface::createStreamAdaptors(ScreenCastStream *stream)
+{
+    QList<QObject *> adaptors;
+    adaptors.append(new ScreenCastAdaptor(stream));
+
+    ScreenCastSource *source = stream->source();
+    // Defensive nullptr check before creating type-specific adaptors
+    if (source && qobject_cast<WindowScreenCastSource *>(source)) {
+        adaptors.append(new WindowStreamAdaptor(stream));
+    } else if (source && qobject_cast<OutputScreenCastSource *>(source)) {
+        adaptors.append(new OutputStreamAdaptor(stream));
+    } else if (source && qobject_cast<RegionScreenCastSource *>(source)) {
+        adaptors.append(new RegionStreamAdaptor(stream));
+    }
+
+    return adaptors;
+}
+
+bool ScreencastDBusInterface::registerStreamOnDBus(const QString &path, ScreenCastStream *stream)
+{
+    bool registered = QDBusConnection::sessionBus().registerObject(
+        path,
+        stream,
+        QDBusConnection::ExportAdaptors);
+
+    qCDebug(KWIN_SCREENCAST) << "Registered stream at" << path << ":" << registered;
+    return registered;
+}
+
+void ScreencastDBusInterface::connectStreamPropertySignals(ScreenCastStream *stream, const QString &path)
+{
+    // Use QPointer for safety even though Qt auto-disconnects when sender is destroyed
+    QPointer<ScreenCastStream> streamPtr(stream);
+
+    // Connect consumer change signals
+    connect(stream, &ScreenCastStream::consumerConnected, this, [this, streamPtr, path]() {
+        if (!streamPtr)
+            return;
+        ScreenCastStream *stream = streamPtr.data();
+
+        // Only emit PropertiesChanged if stream was already announced
+        if (!m_streamsAnnouncedOnDBus.contains(stream)) {
+            return; // Will be handled by emitInterfacesAdded
+        }
+
+        QVariantMap changedProps;
+        changedProps[QStringLiteral("ConsumerApp")] = stream->ConsumerApp();
+        changedProps[QStringLiteral("ConsumerPID")] = stream->ConsumerPID();
+
+        QDBusMessage signal = QDBusMessage::createSignal(
+            path,
+            QStringLiteral("org.freedesktop.DBus.Properties"),
+            QStringLiteral("PropertiesChanged"));
+        signal << QStringLiteral("org.kde.KWin.ScreenCast") << changedProps << QStringList();
+        QDBusConnection::sessionBus().send(signal);
+    });
+
+    // Connect state change signals
+    connect(stream, &ScreenCastStream::stateChanged, this, [this, streamPtr, path]() {
+        if (!streamPtr)
+            return;
+        ScreenCastStream *stream = streamPtr.data();
+
+        QVariantMap changedProps;
+        changedProps[QStringLiteral("State")] = stream->State();
+
+        QDBusMessage signal = QDBusMessage::createSignal(
+            path,
+            QStringLiteral("org.freedesktop.DBus.Properties"),
+            QStringLiteral("PropertiesChanged"));
+        signal << QStringLiteral("org.kde.KWin.ScreenCast") << changedProps << QStringList();
+        QDBusConnection::sessionBus().send(signal);
+    });
+
+    // Connect geometry changes for windows
+    ScreenCastSource *source = stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        QPointer<WindowScreenCastSource> windowSourcePtr(windowSource);
+        connect(windowSource, &WindowScreenCastSource::rectChanged, this, [this, windowSourcePtr, path]() {
+            if (!windowSourcePtr)
+                return;
+
+            QVariantMap changedProps;
+            changedProps[QStringLiteral("X")] = windowSourcePtr->X();
+            changedProps[QStringLiteral("Y")] = windowSourcePtr->Y();
+            changedProps[QStringLiteral("Width")] = windowSourcePtr->Width();
+            changedProps[QStringLiteral("Height")] = windowSourcePtr->Height();
+
+            QDBusMessage signal = QDBusMessage::createSignal(
+                path,
+                QStringLiteral("org.freedesktop.DBus.Properties"),
+                QStringLiteral("PropertiesChanged"));
+            signal << QStringLiteral("org.kde.KWin.ScreenCast.Window") << changedProps << QStringList();
+            QDBusConnection::sessionBus().send(signal);
+
+            qCDebug(KWIN_SCREENCAST) << "Window geometry PropertyChanged emitted for" << path;
+        });
+    }
+
+    // Emit InterfacesAdded when consumer connects
+    QDBusObjectPath objectPath(path);
+    connect(stream, &ScreenCastStream::consumerConnected, this, [this, streamPtr, objectPath, path]() {
+        if (!streamPtr)
+            return;
+        ScreenCastStream *stream = streamPtr.data();
+
+        // Only emit once
+        if (m_streamsAnnouncedOnDBus.contains(stream)) {
+            return;
+        }
+
+        QVariantMap interfaces = streamInterfaces(stream);
+        Q_EMIT InterfacesAdded(objectPath, interfaces);
+        m_streamsAnnouncedOnDBus.insert(stream);
+
+        qCDebug(KWIN_SCREENCAST) << "InterfacesAdded emitted for" << path
+                                 << "ConsumerPID:" << stream->ConsumerPID()
+                                 << "ConsumerApp:" << stream->ConsumerApp();
+    });
+}
+
+} // namespace KWin
+
+#include "moc_screencastdbusinterface.cpp"
