+/*
+    SPDX-FileCopyrightText: 2025 KDE Contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastdbus_utils.h"
+#include "kwinscreencast_logging.h"
+#include "outputscreencastsource.h"
+#include "regionscreencastsource.h"
+#include "screencast_validation_constants.h"
+#include "screencaststream.h"
+#include "screencasttypes.h"
+#include "windowscreencastsource.h"
+
+#include "core/output.h"
+#include "window.h"
+
+namespace KWin
+{
+
+namespace ScreenCastDBusUtils
+{
+
+QRect extractGeometryFromProperties(const QVariantMap &props)
+{
+    // Extract geometry properties with validation
+    bool xOk, yOk, widthOk, heightOk;
+    double x = props.value(QStringLiteral("X")).toDouble(&xOk);
+    double y = props.value(QStringLiteral("Y")).toDouble(&yOk);
+    int width = props.value(QStringLiteral("Width")).toInt(&widthOk);
+    int height = props.value(QStringLiteral("Height")).toInt(&heightOk);
+
+    if (!xOk || !yOk || !widthOk || !heightOk) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to extract geometry from properties: conversion failed";
+        return QRect(); // Invalid rect
+    }
+
+    // Validate coordinate ranges to prevent integer overflow
+    // X/Y coordinates should fit in 16-bit signed int range (typical screen coordinates)
+    if (x < MIN_COORDINATE_16BIT || x > MAX_COORDINATE_16BIT || y < MIN_COORDINATE_16BIT || y > MAX_COORDINATE_16BIT) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid geometry: coordinates out of range"
+                                   << "X:" << x << "Y:" << y
+                                   << "(valid range:" << MIN_COORDINATE_16BIT << "to" << MAX_COORDINATE_16BIT << ")";
+        return QRect();
+    }
+
+    // Validate dimension ranges to prevent security issues
+    if (width <= 0 || height <= 0) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid geometry: non-positive dimensions" << width << "x" << height;
+        return QRect();
+    }
+
+    // Sanity check: geometry shouldn't be larger than 16K resolution
+    // This prevents potential DoS attacks via huge memory allocations
+    if (width > MAX_DIMENSION || height > MAX_DIMENSION) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid geometry: dimensions too large" << width << "x" << height
+                                   << "(max:" << MAX_DIMENSION << ")";
+        return QRect();
+    }
+
+    return QRect(qRound(x), qRound(y), width, height);
+}
+
+QVariantMap extractCommonStreamProperties(ScreenCastStream *stream)
+{
+    if (!stream) {
+        return QVariantMap();
+    }
+
+    QVariantMap props;
+    props[QStringLiteral("Identifier")] = QString::number(stream->nodeId());
+    props[QStringLiteral("State")] = stream->streamState();
+    props[QStringLiteral("ConsumerApp")] = stream->consumerApp();
+    props[QStringLiteral("ConsumerPID")] = stream->consumerPID();
+    props[QStringLiteral("Type")] = stream->Type();
+
+    return props;
+}
+
+QVariantMap extractWindowProperties(WindowScreenCastSource *source)
+{
+    QVariantMap props;
+
+    if (!source) {
+        return props;
+    }
+
+    Window *window = source->window();
+    if (!window) {
+        return props;
+    }
+
+    props[QStringLiteral("WindowId")] = window->internalId().toString();
+    props[QStringLiteral("WindowClass")] = window->resourceClass();
+    props[QStringLiteral("ResourceName")] = window->resourceName();
+    props[QStringLiteral("Caption")] = window->caption();
+
+    return props;
+}
+
+QVariantMap extractOutputProperties(OutputScreenCastSource *source)
+{
+    QVariantMap props;
+
+    if (!source) {
+        return props;
+    }
+
+    Output *output = source->output();
+    if (!output) {
+        return props;
+    }
+
+    props[QStringLiteral("OutputName")] = output->name();
+    props[QStringLiteral("X")] = source->X();
+    props[QStringLiteral("Y")] = source->Y();
+    props[QStringLiteral("Width")] = source->Width();
+    props[QStringLiteral("Height")] = source->Height();
+
+    return props;
+}
+
+QVariantMap extractRegionProperties(RegionScreenCastSource *source)
+{
+    QVariantMap props;
+
+    if (!source) {
+        return props;
+    }
+
+    props[QStringLiteral("X")] = source->X();
+    props[QStringLiteral("Y")] = source->Y();
+    props[QStringLiteral("Width")] = source->Width();
+    props[QStringLiteral("Height")] = source->Height();
+    props[QStringLiteral("Scale")] = source->Scale();
+
+    return props;
+}
+
+QVariantMap extractAllStreamProperties(ScreenCastStream *stream)
+{
+    QVariantMap interfaces;
+
+    if (!stream) {
+        return interfaces;
+    }
+
+    // Common interface properties
+    interfaces[QStringLiteral("org.kde.KWin.ScreenCast")] = extractCommonStreamProperties(stream);
+
+    // Type-specific interface properties
+    ScreenCastSource *source = stream->source();
+    if (!source) {
+        return interfaces;
+    }
+
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Window")] = extractWindowProperties(windowSource);
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Output")] = extractOutputProperties(outputSource);
+    } else if (auto *regionSource = qobject_cast<RegionScreenCastSource *>(source)) {
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Region")] = extractRegionProperties(regionSource);
+    }
+
+    return interfaces;
+}
+
+} // namespace ScreenCastDBusUtils
+
+} // namespace KWin
