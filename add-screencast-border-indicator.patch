+
+#pragma once
+
+#include "effect/effect.h"
+#include "input.h"
+#include "input_event.h"
+#include "scene/outlinedborderitem.h"
+#include "screencastborderitem.h"
+#include "streamtypehandler.h"
+
+#include <QColor>
+#include <QHash>
+#include <QPointer>
+#include <QRect>
+
+#include <memory>
+#include <unordered_map>
+
+namespace KWin
+{
+
+class EffectWindow;
+class ScreencastDBusClient;
+class ScreencastButtonController;
+class IStreamTypeHandler;
+
+/**
+ * @brief Effect that renders colored borders around active screencast streams.
+ *
+ * This effect provides visual feedback when screen recording is active by drawing
+ * colored borders around the recorded area (window, output, or region). It also
+ * provides an interactive stop button for terminating recordings.
+ *
+ * The effect uses extracted components for modularity:
+ * - ScreencastDBusClient: Handles all D-Bus communication
+ * - ScreencastButtonController: Manages button state and interaction
+ * - ScreencastBorderRenderer: Provides rendering utilities
+ * - IStreamTypeHandler: Strategy pattern for type-specific logic
+ *
+ * @section Features
+ * - Colored border rendering for window/output/region screencasts
+ * - Interactive stop button with drag-to-reposition capability
+ * - Auto-hide/show animation for button based on mouse proximity
+ * - Pin button to keep button visible permanently
+ * - Multi-monitor support with proper coordinate scaling
+ * - Application filtering (hide borders for specific applications)
+ *
+ * @section DBus D-Bus Communication
+ * Connects to: org.kde.KWin service, /org/kde/KWin/ScreenCast path
+ * Implements: org.freedesktop.DBus.ObjectManager interface
+ *
+ * @see ScreencastManager, ScreencastDBusClient
+ */
+class ScreencastBorderEffect : public Effect, public InputEventFilter
+{
+    Q_OBJECT
+
+public:
+    /**
+     * @brief Constructs the screencast border effect.
+     *
+     * Initializes components and registers as input event filter.
+     */
+    ScreencastBorderEffect();
+
+    /**
+     * @brief Destroys the effect and cleans up resources.
+     */
+    ~ScreencastBorderEffect() noexcept override;
+
+    /**
+     * @brief Reloads configuration from settings.
+     * @param flags Configuration change flags
+     */
+    void reconfigure(ReconfigureFlags flags) override;
+
+    /**
+     * @brief Renders buttons for all screencasts.
+     *
+     * Border rendering is handled by scene graph (OutlinedBorderItem),
+     * this method only renders interactive stop buttons as overlays.
+     */
+    void paintScreen(const RenderTarget &renderTarget, const RenderViewport &viewport, int mask, const QRegion &region, Output *screen) override;
+
+    /**
+     * @brief Window rendering hook (no longer draws borders - handled by scene graph).
+     */
+    void drawWindow(const RenderTarget &renderTarget, const RenderViewport &viewport, EffectWindow *w, int mask, const QRegion &region, WindowPaintData &data) override;
+
+    /**
+     * @brief Handles mouse movement for button interaction.
+     */
+    bool pointerMotion(PointerMotionEvent *event) override;
+
+    /**
+     * @brief Handles mouse button clicks for button interaction.
+     */
+    bool pointerButton(PointerButtonEvent *event) override;
+
+    /**
+     * @brief Returns the desired position in the effect chain.
+     */
+    int requestedEffectChainPosition() const override
+    {
+        return 80; // Run after wobbly windows
+    }
+
+    /**
+     * @brief Checks if the effect is supported on this system.
+     */
+    static bool supported();
+
+private Q_SLOTS:
+    // D-Bus client signal handlers
+    void onStreamAdded(const QString &path, StreamType type, const QVariantMap &interfaces);
+    void onStreamRemoved(const QString &path);
+    void onStreamPropertiesChanged(const QString &path, const QVariantMap &changedProps);
+    void onServiceConnected();
+    void onServiceDisconnected();
+
+    // Button controller signal handlers
+    void onStopRequested(const QString &streamId);
+    void onRepaintNeeded();
+
+    // Stream handler signal handlers
+    void onStreamRemovalRequested(const QString &path);
+    void onPendingStreamReady(const QString &path, const ScreencastStreamInfo &info);
+
+    // Window signal handlers
+    void onWindowGeometryChanged(const QRectF &oldGeometry);
+
+private:
+    void loadConfig();
+    void registerScreencast(const ScreencastStreamInfo &info);
+    void updateButtonGeometryForStream(const QString &path);
+
+    // Pending border creation (race condition handling)
+    void tryCreatePendingBorders();
+    void createBorderAndButton(const QString &path, const ScreencastStreamInfo &info);
+
+    // Helper methods for createBorderAndButton() to improve readability
+    void createBorderItem(const ScreencastStreamInfo &streamInfo);
+    void createButtonItem(const ScreencastStreamInfo &streamInfo);
+    void setupWindowGeometryTracking(Window *window);
+
+    // Occlusion detection (requires Input system access)
+    bool isButtonOccluded(const QPointF &pos, const ScreencastStreamInfo &info) const;
+
+    // Filtering (business logic - belongs in presentation layer, not service layer)
+    bool shouldFilterStream(const QString &consumerApp) const;
+
+    // Components
+    ScreencastDBusClient *m_dbusClient = nullptr;
+    ScreencastButtonController *m_buttonController = nullptr;
+
+    // Stream type handlers (strategy pattern)
+    // Using std::unordered_map instead of QHash because unique_ptr is move-only
+    std::unordered_map<StreamType, std::unique_ptr<IStreamTypeHandler>> m_handlers;
+
+    // Configuration
+    QColor m_borderColor{255, 0, 0};
+    int m_borderWidth = 5;
+    QStringList m_hiddenApplications; ///< Applications to filter out
+
+    // Active screencasts (key = D-Bus object path)
+    QHash<QString, ScreencastStreamInfo> m_activeScreencasts;
+
+    // Border items for scene graph rendering (key = D-Bus object path)
+    // Using scene graph Items ensures proper Z-order and alpha blending with transparent windows
+    std::unordered_map<QString, std::unique_ptr<OutlinedBorderItem>> m_borderItems;
+
+    // Pending borders awaiting WindowItem creation (race condition mitigation)
+    // Key = D-Bus object path, retried every frame until WindowItem available
+    std::unordered_map<QString, ScreencastStreamInfo> m_pendingBorders;
+
+    // Button items for scene graph rendering (key = D-Bus object path)
+    // Integrating buttons into scene graph fixes Z-order and coordinate issues
+    std::unordered_map<QString, std::unique_ptr<ButtonItem>> m_buttonItems;
+
+    // Track current output being painted (for multi-monitor clipping)
+    Output *m_currentOutput = nullptr;
+};
+
+} // namespace KWin
