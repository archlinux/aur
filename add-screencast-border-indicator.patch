+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastborderitem.h"
+#include "kwinscreencastborder_logging.h"
+#include "scene/imageitem.h"
+#include "scene/itemrenderer.h"
+#include "scene/scene.h"
+
+#include <QIcon>
+#include <QPainter>
+#include <QPainterPath>
+
+namespace KWin
+{
+
+ButtonItem::ButtonItem(ButtonState *state, Item *parent)
+    : Item(parent)
+    , m_state(state)
+{
+    if (!m_state) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "ButtonItem created with null ButtonState";
+        return;
+    }
+
+    // Set item size from button state (logical coordinates)
+    const qreal scale = m_state->scale > 0 ? m_state->scale : 1.0;
+    setSize(QSizeF(m_state->buttonRect.width(), m_state->buttonRect.height()) / scale);
+
+    // Default border styling
+    m_borderColor = QColor(Qt::red);
+    m_borderWidth = 5;
+
+    // Create child ImageItem using factory pattern
+    // CRITICAL: Must use scene()->renderer()->createImageItem() to get correct subclass
+    // - OpenGL renderer creates ImageItemOpenGL (has buildQuads() for rendering)
+    // - QPainter renderer creates plain ImageItem (draws directly)
+    // Direct instantiation of ImageItem would fail on OpenGL systems (no buildQuads())
+    if (scene() && scene()->renderer()) {
+        m_imageItem = scene()->renderer()->createImageItem(this);
+    } else {
+        qCWarning(KWIN_SCREENCASTBORDER) << "ButtonItem created without scene/renderer - cannot create ImageItem";
+    }
+
+    // Initial render
+    updateButton();
+}
+
+ButtonItem::~ButtonItem() = default;
+
+ButtonState *ButtonItem::buttonState() const
+{
+    return m_state;
+}
+
+void ButtonItem::setBorderColor(const QColor &color)
+{
+    if (m_borderColor != color) {
+        m_borderColor = color;
+        scheduleRepaint(boundingRect());
+    }
+}
+
+void ButtonItem::setBorderWidth(int width)
+{
+    if (m_borderWidth != width) {
+        m_borderWidth = width;
+        scheduleRepaint(boundingRect());
+    }
+}
+
+QColor ButtonItem::getContrastColor(const QColor &backgroundColor) const
+{
+    // Perceived brightness (ITU-R BT.709)
+    qreal luminance = (0.2126 * backgroundColor.redF() + 0.7152 * backgroundColor.greenF() + 0.0722 * backgroundColor.blueF());
+    return luminance > 0.5 ? QColor(0, 0, 0, 200) : QColor(255, 255, 255, 200);
+}
+
+QImage ButtonItem::renderButton() const
+{
+    if (!m_state) {
+        return QImage();
+    }
+
+    const qreal scale = m_state->scale;
+    if (scale <= 0) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "Invalid scale in ButtonState:" << scale;
+        return QImage();
+    }
+
+    // Create image at device resolution for sharp rendering
+    // Section collapses to borderWidth + 3px (buttons hide, only section background visible)
+    const qreal fullHeight = m_state->buttonRect.height();
+    const qreal minHeight = (static_cast<qreal>(m_borderWidth) + 3.0) * scale;
+    const qreal collapsedHeight = minHeight + (fullHeight - minHeight) * m_state->collapseProgress;
+    QSize imageSize(qCeil(m_state->buttonRect.width()), qCeil(collapsedHeight));
+
+    QImage image(imageSize, QImage::Format_ARGB32_Premultiplied);
+    image.fill(Qt::transparent);
+    image.setDevicePixelRatio(scale);
+
+    QPainter painter(&image);
+    painter.setRenderHint(QPainter::Antialiasing, true);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+
+    // Calculate background color with opacity
+    QColor bgColor = m_borderColor;
+    int baseAlpha = m_state->isHovered ? 240 : 180;
+    bgColor.setAlpha(baseAlpha);
+
+    // Convert device rects to logical coordinates for QPainter
+    QRectF buttonRect(0, 0, m_state->buttonRect.width() / scale, collapsedHeight / scale);
+    QRectF gripRect = m_state->gripRect.translated(-m_state->buttonRect.topLeft());
+    gripRect = QRectF(gripRect.x() / scale, gripRect.y() / scale, gripRect.width() / scale, gripRect.height() / scale);
+    QRectF iconRect = m_state->textRect.translated(-m_state->buttonRect.topLeft());
+    iconRect = QRectF(iconRect.x() / scale, iconRect.y() / scale, iconRect.width() / scale, iconRect.height() / scale);
+    QRectF pinRect = m_state->pinButtonRect.translated(-m_state->buttonRect.topLeft());
+    pinRect = QRectF(pinRect.x() / scale, pinRect.y() / scale, pinRect.width() / scale, pinRect.height() / scale);
+
+    // Draw background (always visible)
+    drawButtonBackground(painter, buttonRect, bgColor);
+
+    // Draw button elements (only visible when not collapsed)
+    if (m_state->collapseProgress > 0.5) {
+        drawButtonGrip(painter, gripRect);
+        drawButtonIcon(painter, iconRect);
+        drawButtonPinIcon(painter, pinRect);
+    }
+
+    return image;
+}
+
+void ButtonItem::drawButtonBackground(QPainter &painter, const QRectF &buttonRect, const QColor &bgColor) const
+{
+    const qreal cornerRadius = 8.0;
+    QPainterPath backgroundPath;
+    // Start at top-left corner
+    backgroundPath.moveTo(buttonRect.left(), buttonRect.top());
+    // Top edge (straight)
+    backgroundPath.lineTo(buttonRect.right(), buttonRect.top());
+    // Right edge (straight to arc start)
+    backgroundPath.lineTo(buttonRect.right(), buttonRect.bottom() - cornerRadius);
+    // Bottom-right rounded corner
+    backgroundPath.arcTo(buttonRect.right() - 2 * cornerRadius, buttonRect.bottom() - 2 * cornerRadius,
+                         2 * cornerRadius, 2 * cornerRadius, 0, -90);
+    // Bottom edge (arc to arc)
+    backgroundPath.arcTo(buttonRect.left(), buttonRect.bottom() - 2 * cornerRadius,
+                         2 * cornerRadius, 2 * cornerRadius, 270, -90);
+    // Left edge (straight back to start)
+    backgroundPath.lineTo(buttonRect.left(), buttonRect.top());
+    painter.fillPath(backgroundPath, bgColor);
+}
+
+void ButtonItem::drawButtonGrip(QPainter &painter, const QRectF &gripRect) const
+{
+    // Draw grip lines (use border color, significantly lighter on hover)
+    QColor gripColor = m_borderColor.lighter(m_state->isGripHovered ? 200 : 120);
+    gripColor.setAlpha(qRound(gripColor.alpha() * m_state->opacity));
+    QPen gripPen(gripColor, 2.0);
+    gripPen.setCapStyle(Qt::RoundCap);
+    painter.setPen(gripPen);
+
+    const qreal gripTop = gripRect.top() + gripRect.height() * 0.25;
+    const qreal gripBottom = gripRect.bottom() - gripRect.height() * 0.25;
+    const qreal lineSpacing = gripRect.width() / 4.0;
+
+    for (int i = 0; i < 3; ++i) {
+        qreal lineX = gripRect.left() + lineSpacing * (i + 1);
+        painter.drawLine(QPointF(lineX, gripTop), QPointF(lineX, gripBottom));
+    }
+
+    // Add white overlay on grip hover for extra visibility
+    if (m_state->isGripHovered) {
+        QColor gripHighlight = Qt::white;
+        gripHighlight.setAlpha(qRound(100 * m_state->opacity));
+        QPainterPath path;
+        path.addRoundedRect(gripRect, 4.0, 4.0); // Rounded corners for smooth look
+        painter.fillPath(path, gripHighlight);
+    }
+}
+
+void ButtonItem::drawButtonIcon(QPainter &painter, const QRectF &iconRect) const
+{
+    QIcon stopIcon = QIcon::fromTheme(QStringLiteral("media-playback-stop"));
+    if (!stopIcon.isNull()) {
+        QSize iconSize(qCeil(iconRect.width()), qCeil(iconRect.height()));
+        QPixmap iconPixmap = stopIcon.pixmap(iconSize);
+
+        // Apply opacity to icon
+        painter.setOpacity(m_state->opacity);
+        painter.drawPixmap(iconRect.toRect(), iconPixmap);
+        painter.setOpacity(1.0);
+
+        // Add strong highlight overlay on hover
+        if (m_state->isStopHovered) {
+            QColor highlightColor = Qt::white;
+            highlightColor.setAlpha(qRound(150 * m_state->opacity)); // High-visibility overlay
+            QPainterPath path;
+            path.addRoundedRect(iconRect, 6.0, 6.0); // Rounded corners for smooth look
+            painter.fillPath(path, highlightColor);
+        }
+    }
+}
+
+void ButtonItem::drawButtonPinIcon(QPainter &painter, const QRectF &pinRect) const
+{
+    if (!pinRect.isValid()) {
+        return;
+    }
+
+    const QString pinIconName = m_state->isPinned
+        ? QStringLiteral("window-pin")
+        : QStringLiteral("window-unpin");
+    QIcon pinIcon = QIcon::fromTheme(pinIconName);
+    if (!pinIcon.isNull()) {
+        QSize iconSize(qCeil(pinRect.width()), qCeil(pinRect.height()));
+        QPixmap iconPixmap = pinIcon.pixmap(iconSize);
+
+        // Apply opacity to icon
+        painter.setOpacity(m_state->opacity);
+        painter.drawPixmap(pinRect.toRect(), iconPixmap);
+        painter.setOpacity(1.0);
+    }
+
+    // Add strong highlight overlay on hover
+    if (m_state->isPinHovered) {
+        QColor highlightColor = Qt::white;
+        highlightColor.setAlpha(qRound(150 * m_state->opacity)); // High-visibility overlay
+        QPainterPath path;
+        path.addRoundedRect(pinRect, 6.0, 6.0); // Rounded corners for smooth look
+        painter.fillPath(path, highlightColor);
+    }
+}
+
+void ButtonItem::updateButton()
+{
+    if (!m_state || !m_imageItem) {
+        return;
+    }
+
+    const qreal scale = m_state->scale;
+    if (scale <= 0) {
+        return;
+    }
+
+    // Performance optimization: skip rendering if button hasn't changed significantly
+    // Only re-render when:
+    // 1. Dirty flag is set (geometry/hover state changed)
+    // 2. collapseProgress changed by more than 5% (avoid re-rendering every animation frame)
+    constexpr qreal COLLAPSE_THRESHOLD = 0.05; // 5% change threshold
+    const bool collapseChanged = qAbs(m_state->collapseProgress - m_state->lastRenderedCollapseProgress) > COLLAPSE_THRESHOLD;
+    const bool needsRender = m_state->renderDirty || collapseChanged;
+
+    if (!needsRender) {
+        // Button hasn't changed enough to warrant re-rendering
+        return;
+    }
+
+    // Render button to QImage (respects collapseProgress for height)
+    QImage buttonImage = renderButton();
+    if (!buttonImage.isNull()) {
+        m_imageItem->setImage(buttonImage);
+
+        // ImageItem size must match image logical size (image.size() / devicePixelRatio)
+        // This ensures correct scaling: device pixels in QImage, logical size for scene graph
+        // collapseProgress is already applied in renderButton() - image is rendered at collapsed height
+        QSizeF logicalSize = buttonImage.size() / buttonImage.devicePixelRatio();
+        m_imageItem->setSize(logicalSize);
+
+        // Update render state tracking
+        m_state->lastRenderedCollapseProgress = m_state->collapseProgress;
+        m_state->renderDirty = false;
+    }
+
+    // Section always visible - only button elements fade via image alpha
+    // Item opacity stays at 1.0 to keep collapsed section strip visible
+    qCDebug(KWIN_SCREENCASTBORDER) << "updateButton: state opacity=" << m_state->opacity
+                                   << "item opacity set to 1.0 (section always visible)";
+    setOpacity(1.0);
+
+    // NOTE: Position is set ONCE in registerScreencast() and should
+    // NOT be updated here. Updating position every frame would override
+    // window-relative positioning, breaking animations.
+}
+
+} // namespace KWin
+
+#include "moc_screencastborderitem.cpp"
