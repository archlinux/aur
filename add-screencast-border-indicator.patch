+/*
+    SPDX-FileCopyrightText: 2025
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include "streamtypehandler.h"
+
+#include <QDBusConnection>
+#include <QDBusContext>
+#include <QDBusError>
+#include <QDBusMessage>
+#include <QDBusObjectPath>
+#include <QDBusServiceWatcher>
+#include <QObject>
+#include <QSet>
+#include <QStringList>
+#include <QVariantMap>
+
+namespace KWin
+{
+
+class ScreencastDBusClientPrivate;
+
+/**
+ * @brief Handles D-Bus communication with ScreencastManager.
+ *
+ * This class manages the connection to the ScreencastManager plugin via
+ * the org.freedesktop.DBus.ObjectManager interface and tracks active
+ * screencast streams.
+ *
+ * The class emits signals for stream lifecycle events (added, removed,
+ * properties changed) which the main effect can respond to.
+ */
+class ScreencastDBusClient : public QObject, protected QDBusContext
+{
+    Q_OBJECT
+
+public:
+    explicit ScreencastDBusClient(QObject *parent = nullptr);
+    ~ScreencastDBusClient() override;
+
+    /**
+     * @brief Initiate connection to the ScreencastManager D-Bus service.
+     *
+     * Sets up service watcher, subscribes to ObjectManager signals,
+     * and queries existing streams.
+     */
+    void connectToService();
+
+    /**
+     * @brief Request termination of a screencast stream.
+     * @param objectPath D-Bus object path of the stream
+     */
+    void stopStream(const QString &objectPath);
+
+    /**
+     * @brief Check if currently connected to the service.
+     * @return true if connected, false otherwise
+     */
+    bool isConnected() const
+    {
+        return m_connected;
+    }
+
+Q_SIGNALS:
+    /**
+     * @brief Emitted when a new stream is discovered and passes filtering.
+     * @param path D-Bus object path
+     * @param type Stream type (Window, Output, or Region)
+     * @param interfaces Map of D-Bus interfaces and their properties
+     *
+     * The receiver should extract type-specific properties from interfaces:
+     * - StreamType::Window: "org.kde.KWin.ScreenCast.Window"
+     * - StreamType::Output: "org.kde.KWin.ScreenCast.Output"
+     * - StreamType::Region: "org.kde.KWin.ScreenCast.Region"
+     * - Common properties: "org.kde.KWin.ScreenCast"
+     */
+    void streamAdded(const QString &path, StreamType type, const QVariantMap &interfaces);
+
+    /**
+     * @brief Emitted when a stream is removed.
+     * @param path D-Bus object path
+     */
+    void streamRemoved(const QString &path);
+
+    /**
+     * @brief Emitted when stream properties change.
+     * @param path D-Bus object path
+     * @param changedProps Map of changed property names to new values
+     */
+    void streamPropertiesChanged(const QString &path, const QVariantMap &changedProps);
+
+    /**
+     * @brief Emitted when connection to ScreencastManager is established.
+     */
+    void serviceConnected();
+
+    /**
+     * @brief Emitted when connection to ScreencastManager is lost.
+     */
+    void serviceDisconnected();
+
+private Q_SLOTS:
+    void onGetManagedObjectsReply(const QDBusMessage &reply);
+    void onDBusError(const QDBusError &error);
+    void onInterfacesAdded(const QDBusObjectPath &objectPath, const QVariantMap &interfaces);
+    void onInterfacesRemoved(const QDBusObjectPath &objectPath, const QStringList &interfaces);
+    void onObjectPropertiesChanged(const QString &interface, const QVariantMap &changedProps, const QStringList &invalidated);
+    void onServiceOwnerChanged(const QString &service, const QString &oldOwner, const QString &newOwner);
+
+private:
+    /**
+     * @brief Subscribe to PropertiesChanged signal for a specific object.
+     * @param path D-Bus object path
+     */
+    void subscribeToPropertyChanges(const QString &path);
+
+    /**
+     * @brief Determine stream type from interfaces.
+     * @param interfaces Map of D-Bus interfaces
+     * @return Stream type, or nullopt if type cannot be determined
+     */
+    std::optional<StreamType> determineStreamType(const QVariantMap &interfaces);
+
+    QDBusConnection m_dbus;
+    QDBusServiceWatcher *m_serviceWatcher = nullptr;
+    bool m_connected = false;
+    QSet<QString> m_subscribedPaths;
+    ScreencastDBusClientPrivate *d;
+};
+
+} // namespace KWin
