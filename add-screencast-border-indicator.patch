+namespace KWin
+{
+
+ScreencastBorderEffect::ScreencastBorderEffect()
+    : Effect()
+    , InputEventFilter(InputFilterOrder::ScreenEdge)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "ScreencastBorderEffect() constructor starting";
+
+    ScreencastBorderConfig::instance(effects->config());
+    loadConfig();
+
+    // Load hidden applications list for filtering
+    m_hiddenApplications = ScreencastBorderConfig::hiddenApplications();
+
+    // Create D-Bus client component
+    m_dbusClient = new ScreencastDBusClient(this);
+
+    // Connect D-Bus client signals
+    connect(m_dbusClient, &ScreencastDBusClient::streamAdded,
+            this, &ScreencastBorderEffect::onStreamAdded);
+    connect(m_dbusClient, &ScreencastDBusClient::streamRemoved,
+            this, &ScreencastBorderEffect::onStreamRemoved);
+    connect(m_dbusClient, &ScreencastDBusClient::streamPropertiesChanged,
+            this, &ScreencastBorderEffect::onStreamPropertiesChanged);
+    connect(m_dbusClient, &ScreencastDBusClient::serviceConnected,
+            this, &ScreencastBorderEffect::onServiceConnected);
+    connect(m_dbusClient, &ScreencastDBusClient::serviceDisconnected,
+            this, &ScreencastBorderEffect::onServiceDisconnected);
+
+    // Create button controller component
+    m_buttonController = new ScreencastButtonController(this);
+    m_buttonController->setShowButtons(ScreencastBorderConfig::showStopButton());
+
+    // Connect button controller signals
+    connect(m_buttonController, &ScreencastButtonController::stopRequested,
+            this, &ScreencastBorderEffect::onStopRequested);
+    connect(m_buttonController, &ScreencastButtonController::repaintNeeded,
+            this, &ScreencastBorderEffect::onRepaintNeeded);
+
+    // Create stream type handlers
+    m_handlers[StreamType::Window] = StreamTypeHandlerFactory::create(StreamType::Window, effects, this);
+    m_handlers[StreamType::Output] = StreamTypeHandlerFactory::create(StreamType::Output, effects, this);
+    m_handlers[StreamType::Region] = StreamTypeHandlerFactory::create(StreamType::Region, effects, this);
+
+    // Connect handler signals
+    for (auto &[type, handler] : m_handlers) {
+        // geometryUpdateNeeded signal no longer needed - WindowItem children follow parent automatically
+        connect(handler.get(), &IStreamTypeHandler::streamRemovalRequested,
+                this, &ScreencastBorderEffect::onStreamRemovalRequested);
+        connect(handler.get(), &IStreamTypeHandler::pendingStreamReady,
+                this, &ScreencastBorderEffect::onPendingStreamReady);
+    }
+
+    // Connect to D-Bus service
+    m_dbusClient->connectToService();
+
+    // Register input filter
+    input()->installInputEventFilter(this);
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "ScreencastBorderEffect() constructor complete";
+}
+
+ScreencastBorderEffect::~ScreencastBorderEffect()
+{
+    input()->uninstallInputEventFilter(this);
+    // Handlers automatically cleaned up via unique_ptr
+}
+
+void ScreencastBorderEffect::loadConfig()
+{
+    ScreencastBorderConfig::self()->read();
+    m_borderColor = ScreencastBorderConfig::borderColor();
+    m_borderWidth = ScreencastBorderConfig::borderWidth();
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "loadConfig(): m_borderColor=" << m_borderColor
+                                   << "isValid=" << m_borderColor.isValid()
+                                   << "rgb=0x" << QString::number(m_borderColor.rgb(), 16)
+                                   << "m_borderWidth=" << m_borderWidth;
+}
+
+void ScreencastBorderEffect::reconfigure(ReconfigureFlags flags)
+{
+    Q_UNUSED(flags);
+    loadConfig();
+
+    // Update hidden applications list
+    m_hiddenApplications = ScreencastBorderConfig::hiddenApplications();
+
+    // Update components with new configuration
+    if (m_buttonController) {
+        m_buttonController->setShowButtons(ScreencastBorderConfig::showStopButton());
+    }
+
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::onStreamAdded(const QString &path, StreamType type, const QVariantMap &interfaces)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "onStreamAdded:" << path << "type:" << static_cast<int>(type);
+
+    // Get handler for this stream type
+    auto it = m_handlers.find(type);
+    if (it == m_handlers.end()) {
+        qCWarning(KWIN_SCREENCASTBORDER) << "No handler for stream type:" << static_cast<int>(type);
+        return;
+    }
+
+    IStreamTypeHandler *handler = it->second.get();
+
+    // Extract common properties
+    QVariantMap commonProps;
+    const QVariant interfaceValue = interfaces.value(QStringLiteral("org.kde.KWin.ScreenCast"));
+    if (interfaceValue.canConvert<QDBusArgument>()) {
+        const QDBusArgument arg = interfaceValue.value<QDBusArgument>();
+        arg >> commonProps;
+    } else {
+        commonProps = interfaceValue.toMap();
+    }
+
+    // Filter by consumer application (business logic in presentation layer)
+    QString consumerApp = commonProps.value(QStringLiteral("ConsumerApp")).toString();
+    if (shouldFilterStream(consumerApp)) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Filtering stream from hidden application:" << consumerApp;
+        return;
+    }
+
+    // Process stream via handler
+    auto streamInfoOpt = handler->processStream(path, interfaces, commonProps);
+
+    if (!streamInfoOpt.has_value()) {
+        // Stream is pending (e.g., window with 0x0 geometry)
+        // Handler will emit pendingStreamReady when ready
+        qCDebug(KWIN_SCREENCASTBORDER) << "Stream is pending, handler will notify when ready:" << path;
+        return;
+    }
+
+    // Register the screencast
+    registerScreencast(streamInfoOpt.value());
+}
+
+void ScreencastBorderEffect::onStreamRemoved(const QString &path)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "onStreamRemoved:" << path;
+
+    // Remove from active screencasts
+    if (m_activeScreencasts.remove(path) > 0) {
+        qCDebug(KWIN_SCREENCASTBORDER) << "Border deactivated for" << path;
+
+        // Disconnect handler signals (handler will clean up pending windows)
+        for (auto &[type, handler] : m_handlers) {
+            handler->disconnectSignals(path);
+        }
+
+        // Remove button
+        m_buttonController->removeButton(path);
+
+        // Remove border item (unique_ptr auto-deletes)
+        m_borderItems.erase(path);
+
+        // Remove button item (unique_ptr auto-deletes)
+        m_buttonItems.erase(path);
+
+        // Remove from pending borders if present (race condition cleanup)
+        m_pendingBorders.erase(path);
+
+        effects->addRepaintFull();
+    }
+}
+
+void ScreencastBorderEffect::onStreamPropertiesChanged(const QString &path, const QVariantMap &changedProps)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "onStreamPropertiesChanged:" << path;
+
+    // Check if this is an active screencast
+    if (!m_activeScreencasts.contains(path)) {
+        // Not an active stream - handler will handle pending windows via pendingStreamReady signal
+        return;
+    }
+
+    auto &info = m_activeScreencasts[path];
+
+    // Update consumer app if changed
+    if (changedProps.contains(QStringLiteral("ConsumerApp"))) {
+        QString newConsumerApp = changedProps.value(QStringLiteral("ConsumerApp")).toString();
+        info.consumerApp = newConsumerApp;
+        qCDebug(KWIN_SCREENCASTBORDER) << "Consumer app updated for" << path << ":" << newConsumerApp;
+    }
+
+    // Update consumer PID if changed (with validation)
+    if (changedProps.contains(QStringLiteral("ConsumerPID"))) {
+        quint32 newPID = changedProps.value(QStringLiteral("ConsumerPID")).toUInt();
+        if (validatePID(newPID)) {
+            info.consumerPID = newPID;
+            qCDebug(KWIN_SCREENCASTBORDER) << "Consumer PID updated for" << path << ":" << info.consumerPID;
+        } else {
+            qCWarning(KWIN_SCREENCASTBORDER) << "Invalid ConsumerPID from D-Bus for" << path << ":" << newPID;
+        }
+    }
+
+    // Let handler process type-specific property changes
+    auto handlerIt = m_handlers.find(info.type);
+    if (handlerIt != m_handlers.end()) {
+        bool geometryChanged = handlerIt->second->handlePropertyChange(path, info, changedProps);
+
+        if (geometryChanged) {
+            updateButtonGeometryForStream(path);
+            effects->addRepaintFull();
+        }
+    }
+}
+
+void ScreencastBorderEffect::onServiceConnected()
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "ScreencastManager service connected";
+}
+
+void ScreencastBorderEffect::onServiceDisconnected()
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "ScreencastManager service disconnected, clearing state";
+    m_activeScreencasts.clear();
+    // Handlers will clean up their own pending windows
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::onStopRequested(const QString &streamId)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Stop requested for:" << streamId;
+    m_dbusClient->stopStream(streamId);
+}
+
+void ScreencastBorderEffect::onRepaintNeeded()
+{
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::onWindowGeometryChanged(const QRectF &oldGeometry)
+{
+    Q_UNUSED(oldGeometry);
+
+    // Get the Window that emitted the signal
+    Window *window = qobject_cast<Window *>(sender());
+    if (!window) {
+        return;
+    }
+
+    // Find the stream for this window
+    QString streamPath;
+    for (const auto &[path, info] : m_activeScreencasts.asKeyValueRange()) {
+        if (info.type == StreamType::Window && info.window && info.window->window() == window) {
+            streamPath = path;
+            break;
+        }
+    }
+
+    if (streamPath.isEmpty()) {
+        return; // Window not associated with any active stream
+    }
+
+    // Update stream geometry
+    QRect newGeometry = window->frameGeometry().toRect();
+    m_activeScreencasts[streamPath].geometry = newGeometry;
+
+    qCDebug(KWIN_SCREENCASTBORDER) << "Window geometry changed for stream:" << streamPath
+                                   << "new geometry:" << newGeometry;
+
+    // Update border item's innerRect (border size must match new window size)
+    auto borderIt = m_borderItems.find(streamPath);
+    if (borderIt != m_borderItems.end()) {
+        QRectF innerRect = QRectF(
+                               0, 0,
+                               newGeometry.width(),
+                               newGeometry.height())
+                               .adjusted(m_borderWidth, m_borderWidth, -m_borderWidth, -m_borderWidth);
+
+        borderIt->second->setInnerRect(innerRect);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Updated border innerRect to:" << innerRect;
+    }
+
+    // Update button geometry (for hit testing - button position stays window-relative)
+    updateButtonGeometryForStream(streamPath);
+
+    // Update ButtonItem position to reflect clamped position (same logic as drag handling)
+    auto buttonIt = m_buttonItems.find(streamPath);
+    if (buttonIt != m_buttonItems.end() && buttonIt->second) {
+        auto *button = m_buttonController->getButton(streamPath);
+        if (button) {
+            qreal scale = button->scale > 0 ? button->scale : 1.0;
+
+            // Convert to window-relative coords
+            QRect windowGeometry = window->frameGeometry().toRect();
+            QPointF position(
+                (button->buttonRect.x() / scale) - windowGeometry.x(),
+                (button->buttonRect.y() / scale) - windowGeometry.y());
+
+            buttonIt->second->setPosition(position);
+        }
+    }
+
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::onStreamRemovalRequested(const QString &path)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Stream removal requested for:" << path;
+
+    if (m_activeScreencasts.remove(path) > 0) {
+        // Disconnect handler signals
+        for (auto &[type, handler] : m_handlers) {
+            handler->disconnectSignals(path);
+        }
+
+        // Remove button
+        m_buttonController->removeButton(path);
+
+        // Remove border item (unique_ptr auto-deletes)
+        m_borderItems.erase(path);
+
+        effects->addRepaintFull();
+    }
+}
+
+void ScreencastBorderEffect::onPendingStreamReady(const QString &path, const ScreencastStreamInfo &info)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Pending stream ready:" << path;
+
+    // Register the now-ready stream
+    registerScreencast(info);
+
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::registerScreencast(const ScreencastStreamInfo &streamInfo)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Registering screencast:" << streamInfo.objectPath
+                                   << "geometry:" << streamInfo.geometry
+                                   << "type:" << static_cast<int>(streamInfo.type);
+
+    // Add to active screencasts (streamInfo now contains all necessary data including type)
+    m_activeScreencasts[streamInfo.objectPath] = streamInfo;
+
+    // Connect handler signals for this stream
+    auto handlerIt = m_handlers.find(streamInfo.type);
+    if (handlerIt != m_handlers.end()) {
+        handlerIt->second->connectSignals(streamInfo.objectPath, streamInfo);
+    }
+
+    // Check if WindowItem is available for window streams (race condition mitigation)
+    if (streamInfo.type == StreamType::Window) {
+        if (!streamInfo.window || !streamInfo.window->windowItem()) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "WindowItem not ready for" << streamInfo.objectPath
+                                           << "- adding to pending borders (will retry)";
+            m_pendingBorders[streamInfo.objectPath] = streamInfo;
+            effects->addRepaintFull(); // Trigger tryCreatePendingBorders in next paint
+            return;
+        }
+    }
+
+    // WindowItem available (or not needed) - create border and button immediately
+    createBorderAndButton(streamInfo.objectPath, streamInfo);
+
+    effects->addRepaintFull();
+}
+
+void ScreencastBorderEffect::createBorderItem(const ScreencastStreamInfo &streamInfo)
+{
+    BorderOutline outline(m_borderWidth, m_borderColor, BorderRadius());
+
+    if (streamInfo.type == StreamType::Window && streamInfo.window) {
+        // For window streams: attach border to WindowItem (window-relative coordinates)
+        // This allows border to participate in ALL window effects (wobbly, magic lamp, etc.)
+        // Border WILL be captured in screencast stream (user-requested behavior)
+        // Border automatically follows window transformations via scene graph
+
+        // Convert to window-relative coordinates (0,0 = top-left window corner)
+        QRect windowGeometry = streamInfo.window->frameGeometry().toRect();
+        QRectF innerRect = QRectF(
+                               0, 0,
+                               windowGeometry.width(),
+                               windowGeometry.height())
+                               .adjusted(m_borderWidth, m_borderWidth, -m_borderWidth, -m_borderWidth);
+
+        auto borderItem = std::make_unique<OutlinedBorderItem>(
+            innerRect,
+            outline,
+            streamInfo.window->windowItem()); // Window-relative parent
+        // No setZ() - inherits window's Z-order automatically
+
+        m_borderItems[streamInfo.objectPath] = std::move(borderItem);
+
+        qCDebug(KWIN_SCREENCASTBORDER) << "Created window border in WindowItem (window-relative coordinates)";
+    } else {
+        // For output/region streams: use overlayItem (no associated window)
+        // Border should render INWARD (inside monitor bounds), not outward
+        // OutlinedBorderItem uses inflate() which expands rect outward by borderWidth
+        // So we pre-shrink the rect by borderWidth to compensate
+        QRectF innerRect = streamInfo.geometry.adjusted(
+            m_borderWidth, m_borderWidth, -m_borderWidth, -m_borderWidth);
+
+        auto borderItem = std::make_unique<OutlinedBorderItem>(
+            innerRect,
+            outline,
+            effects->scene()->overlayItem());
+        borderItem->setZ(90); // Explicit Z for overlay children
+        m_borderItems[streamInfo.objectPath] = std::move(borderItem);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Created output/region border in overlayItem (inward rendering)";
+    }
+}
+
+void ScreencastBorderEffect::createButtonItem(const ScreencastStreamInfo &streamInfo)
+{
+    auto *button = m_buttonController->getButton(streamInfo.objectPath);
+    if (!button) {
+        return;
+    }
+
+    Item *parent = nullptr;
+    QPointF position;
+    qreal scale = button->scale > 0 ? button->scale : 1.0;
+
+    if (streamInfo.type == StreamType::Window && streamInfo.window) {
+        // Window streams: attach to WindowItem (window-relative coordinates)
+        // Button will be captured in stream and animate with window effects
+        parent = streamInfo.window->windowItem();
+
+        // Convert from screen coords to window-relative coords
+        QRect windowGeometry = streamInfo.window->frameGeometry().toRect();
+        position = QPointF(
+            (button->buttonRect.x() / scale) - windowGeometry.x(),
+            (button->buttonRect.y() / scale) - windowGeometry.y());
+
+        qCDebug(KWIN_SCREENCASTBORDER) << "Button uses WindowItem parent (window-relative coords)";
+    } else {
+        // Output/region streams: attach to overlayItem (screen coordinates)
+        // Button NOT captured in stream, always visible on top
+        parent = effects->scene()->overlayItem();
+        position = QPointF(
+            button->buttonRect.x() / scale,
+            button->buttonRect.y() / scale);
+
+        qCDebug(KWIN_SCREENCASTBORDER) << "Button uses overlayItem parent (screen coords)";
+    }
+
+    if (parent) {
+        auto buttonItem = std::make_unique<ButtonItem>(button, parent);
+        buttonItem->setPosition(position);
+        buttonItem->setBorderColor(m_borderColor);
+        buttonItem->setBorderWidth(m_borderWidth);
+
+        // Don't set explicit Z value - let scene graph handle Z-ordering naturally
+
+        m_buttonItems[streamInfo.objectPath] = std::move(buttonItem);
+        qCDebug(KWIN_SCREENCASTBORDER) << "Created ButtonItem in scene graph";
+    }
+}
+
+void ScreencastBorderEffect::setupWindowGeometryTracking(Window *window)
+{
+    if (!window) {
+        return;
+    }
+
+    // Track window geometry changes to update border size and button geometry
+    // Note: Position follows automatically via WindowItem transforms, but size must be explicitly updated
+    connect(window, &Window::frameGeometryChanged,
+            this, &ScreencastBorderEffect::onWindowGeometryChanged);
+}
+
+void ScreencastBorderEffect::createBorderAndButton(const QString &path, const ScreencastStreamInfo &streamInfo)
+{
+    qCDebug(KWIN_SCREENCASTBORDER) << "Creating border and button for:" << path;
+
+    // Create button state and calculate geometry
+    m_buttonController->createButton(path);
+    updateButtonGeometryForStream(path);
+
+    // Create border item in scene graph
+    createBorderItem(streamInfo);
+
+    // Create button item in scene graph
+    createButtonItem(streamInfo);
+
+    // Setup window geometry tracking for window streams
+    if (streamInfo.type == StreamType::Window && streamInfo.window) {
+        if (Window *win = streamInfo.window->window()) {
+            setupWindowGeometryTracking(win);
+        }
+    }
+}
+
+void ScreencastBorderEffect::tryCreatePendingBorders()
+{
+    // Retry creating borders for streams where WindowItem wasn't ready
+    for (auto it = m_pendingBorders.begin(); it != m_pendingBorders.end();) {
+        const QString &path = it->first;
+        const ScreencastStreamInfo &info = it->second;
+
+        // Check if window still exists
+        if (!info.window) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Pending border window deleted:" << path;
+            it = m_pendingBorders.erase(it);
+            continue;
+        }
+
+        // Check if WindowItem is now available
+        if (info.window->windowItem()) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "WindowItem now available for pending border:" << path;
+            createBorderAndButton(path, info);
+            it = m_pendingBorders.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void ScreencastBorderEffect::updateButtonGeometryForStream(const QString &path)
+{
+    auto it = m_activeScreencasts.find(path);
+    if (it == m_activeScreencasts.end()) {
+        return;
+    }
+
+    const ScreencastStreamInfo &info = it.value();
+
+    // Assume scale 1.0 for now - will be updated during paintScreen with actual scale
+    qreal scale = 1.0;
+
+    // Find the output containing this geometry to get actual scale
+    const auto outputs = effects->screens();
+    for (Output *output : outputs) {
+        if (output->geometry().intersects(info.geometry)) {
+            scale = output->scale();
+            break;
+        }
+    }
+
+    // ALL geometry (window, output, region) is in logical coordinates
+    // No special case needed - just convert to device coordinates for button controller
+    QRectF logicalGeometry = info.geometry;
+
+    // Convert logical to device coordinates for button controller
+    QRectF scaledGeometry(
+        logicalGeometry.x() * scale,
+        logicalGeometry.y() * scale,
+        logicalGeometry.width() * scale,
+        logicalGeometry.height() * scale);
+
+    m_buttonController->updateButtonGeometry(path, scaledGeometry, scale);
+}
+
+void ScreencastBorderEffect::paintScreen(const RenderTarget &renderTarget, const RenderViewport &viewport,
+                                         int mask, const QRegion &region, Output *screen)
+{
+    // Store current output for use in drawWindow() (multi-monitor clipping)
+    m_currentOutput = screen;
+
+    // Try creating any pending borders (race condition mitigation)
+    if (!m_pendingBorders.empty()) {
+        tryCreatePendingBorders();
+    }
+
+    // Update button animations (fade in/out based on interaction)
+    m_buttonController->updateAnimations(QDateTime::currentMSecsSinceEpoch());
+
+    // Update button geometry and rendering
+    for (auto &[path, buttonItem] : m_buttonItems) {
+        if (!buttonItem) {
+            continue;
+        }
+
+        auto *button = m_buttonController->getButton(path);
+        if (!button) {
+            continue;
+        }
+
+        // If button is being dragged, recalculate geometry and update position
+        if (button->isDragging) {
+            updateButtonGeometryForStream(path);
+
+            // Position changed due to drag - update ButtonItem position
+            qreal scale = button->scale > 0 ? button->scale : 1.0;
+            QPointF position;
+            auto streamIt = m_activeScreencasts.find(path);
+            if (streamIt != m_activeScreencasts.end()) {
+                const ScreencastStreamInfo &streamInfo = streamIt.value();
+
+                if (streamInfo.type == StreamType::Window && streamInfo.window) {
+                    // Window streams: convert to window-relative coords
+                    QRect windowGeometry = streamInfo.window->frameGeometry().toRect();
+                    position = QPointF(
+                        (button->buttonRect.x() / scale) - windowGeometry.x(),
+                        (button->buttonRect.y() / scale) - windowGeometry.y());
+                } else {
+                    // Output/region streams: use screen coords directly
+                    position = QPointF(
+                        button->buttonRect.x() / scale,
+                        button->buttonRect.y() / scale);
+                }
+
+                buttonItem->setPosition(position);
+            }
+        }
+        // When not dragging, position is NOT updated:
+        // - WindowItem children automatically follow parent transformations (move/resize)
+        // - overlayItem children remain in fixed screen positions
+
+        // Update button rendering (handles collapse animation, opacity, textures)
+        buttonItem->updateButton();
+    }
+
+    effects->paintScreen(renderTarget, viewport, mask, region, screen);
+
+    // Border and button rendering handled by scene graph (OutlinedBorderItem + ButtonItem)
+    // WindowItem children automatically inherit all parent transformations (wobbly, magic lamp, etc.)
+}
+
+// prePaintWindow() removed - no longer needed with WindowItem parenting
+
+void ScreencastBorderEffect::drawWindow(const RenderTarget &renderTarget, const RenderViewport &viewport,
+                                        EffectWindow *w, int mask, const QRegion &region, WindowPaintData &data)
+{
+    effects->drawWindow(renderTarget, viewport, w, mask, region, data);
+
+    // Border rendering handled by scene graph (OutlinedBorderItem)
+    // WindowItem children automatically inherit parent transformations
+}
+
+bool ScreencastBorderEffect::pointerMotion(PointerMotionEvent *event)
+{
+    if (m_activeScreencasts.isEmpty()) {
+        return false;
+    }
+
+    QPointF pos = event->position;
+    qint64 currentTime = QDateTime::currentMSecsSinceEpoch();
+
+    // Let button controller handle the motion
+    bool consumed = m_buttonController->handlePointerMotion(pos, currentTime);
+
+    // If dragging, update button geometry based on stream geometry
+    // (Button controller needs current geometry to calculate new ratio)
+    if (consumed) {
+        for (const auto &[path, info] : m_activeScreencasts.asKeyValueRange()) {
+            auto *button = m_buttonController->getButton(path);
+            if (button && button->isDragging) {
+                updateButtonGeometryForStream(path);
+            }
+        }
+    }
+
+    return consumed;
+}
+
+bool ScreencastBorderEffect::pointerButton(PointerButtonEvent *event)
+{
+    if (m_activeScreencasts.isEmpty()) {
+        return false;
+    }
+
+    QPointF pos = event->position;
+    bool pressed = (event->state == PointerButtonState::Pressed);
+    qint64 currentTime = QDateTime::currentMSecsSinceEpoch();
+
+    // Check for occlusion before letting button controller handle the event
+    if (pressed && event->button == Qt::LeftButton) {
+        for (const auto &[path, info] : m_activeScreencasts.asKeyValueRange()) {
+            auto *button = m_buttonController->getButton(path);
+            if (button && button->buttonRectLogical.contains(pos)) {
+                if (isButtonOccluded(pos, info)) {
+                    qCDebug(KWIN_SCREENCASTBORDER) << "Button occluded, ignoring click";
+                    return false;
+                }
+            }
+        }
+    }
+
+    return m_buttonController->handlePointerButton(pos, event->button, pressed, currentTime);
+}
+
+bool ScreencastBorderEffect::isButtonOccluded(const QPointF &pos, const ScreencastStreamInfo &info) const
+{
+    // For window streams, verify the click is on the actual recorded window (not occluded)
+    if (info.type == StreamType::Window) {
+        Window *topWindow = input()->findToplevel(pos);
+        if (!info.window || !topWindow || topWindow != info.window->window()) {
+            // Button is occluded by another window
+            return true;
+        }
+    }
+    // For output/region streams, buttons are in overlay layer (always on top)
+    // Scene graph renders them above all windows via overlayItem parent, so they can't be occluded
+    else {
+        // No occlusion check needed - overlay items are always clickable
+        return false;
+    }
+
+    return false;
+}
+
+bool ScreencastBorderEffect::shouldFilterStream(const QString &consumerApp) const
+{
+    // Empty consumer app means detection hasn't happened yet - don't filter
+    if (consumerApp.isEmpty()) {
+        return false;
+    }
+
+    // Check if consumer matches any hidden application (case-insensitive)
+    for (const QString &hiddenApp : m_hiddenApplications) {
+        if (consumerApp.compare(hiddenApp, Qt::CaseInsensitive) == 0) {
+            qCDebug(KWIN_SCREENCASTBORDER) << "Filtering stream - consumerApp:"
+                                           << consumerApp << "matches hidden:" << hiddenApp;
+            return true;
+        }
+    }
+    return false;
+}
+
+// findStreamPathForWindow() removed - no longer needed with WindowItem parenting
+// calculateWindowTransform() removed - WindowItem children inherit transforms automatically
+
+bool ScreencastBorderEffect::supported()
+{
+    return effects->isOpenGLCompositing();
+}
+
+} // namespace KWin
