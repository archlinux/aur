post_install() {
  # Remove stale local user schemas that override the system schema.
  # These are left behind by previous 'meson install' to a local prefix
  # and cause startup crashes because they lack newer keys like
  # playback-volume-local, playback-volume-cast, playback-volume-dlna.
  for userdir in /home/*/.local/share/glib-2.0/schemas; do
    if [ -f "$userdir/de.haeckerfelix.Shortwave.gschema.xml" ]; then
      echo "==> Removing stale local schema override in $userdir"
      rm -f "$userdir/de.haeckerfelix.Shortwave.gschema.xml"
      glib-compile-schemas "$userdir" 2>/dev/null || true
    fi
  done

  # Remove stale files from previous manual installs under /usr/local.
  # /usr/local/bin and /usr/local/share precede /usr/bin and /usr/share in
  # PATH and XDG_DATA_DIRS, so leftovers there shadow the packaged files
  # and break the application (e.g. missing GSettings keys, stale icons).
  for stale in \
    /usr/local/bin/shortwave \
    /usr/local/share/shortwave \
    /usr/local/share/applications/de.haeckerfelix.Shortwave.desktop \
    /usr/local/share/metainfo/de.haeckerfelix.Shortwave.metainfo.xml \
    /usr/local/share/glib-2.0/schemas/de.haeckerfelix.Shortwave.gschema.xml \
    /usr/local/share/icons/hicolor/scalable/apps/de.haeckerfelix.Shortwave.svg \
    /usr/local/share/icons/hicolor/scalable/status/de.haeckerfelix.Shortwave-symbolic.svg \
    /usr/local/share/icons/hicolor/symbolic/apps/de.haeckerfelix.Shortwave-symbolic.svg
  do
    if [ -e "$stale" ]; then
      echo "==> Removing stale manual install leftover: $stale"
      rm -rf "$stale"
    fi
  done
  if [ -d /usr/local/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/local/share/glib-2.0/schemas 2>/dev/null || true
  fi
  if [ -d /usr/local/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -t -f /usr/local/share/icons/hicolor 2>/dev/null || true
  fi

  # Ensure system GSettings schemas are compiled
  if [ -d /usr/share/glib-2.0/schemas ]; then
    echo "==> Compiling GSettings schemas..."
    glib-compile-schemas /usr/share/glib-2.0/schemas
    echo "==> Schema compilation complete"
  fi
  
  # Update icon cache
  if [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  
  # Update desktop database
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  # Recompile schemas after removal to clean up
  if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
  fi
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
