post_install() {
  # Ensure GSettings schemas are compiled
  # This is critical for app startup - force compilation even if hooks ran
  if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas
  fi
  
  # Update icon cache (redundant with pacman hooks but harmless)
  if [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  
  # Update desktop database (redundant with pacman hooks but harmless)
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  # Recompile schemas after removal to clean up
  if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
  fi
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
