fcp.enabled=true
fcp.port=9481
fproxy.advancedModeEnabled=true
fproxy.css=sky-dark-static
fproxy.enabled=true
fproxy.port=8888
logger.dirname=/opt/hyphanet/logs
logger.interval=24HOUR
logger.priority=ERROR
node.clientThrottleFile=/opt/hyphanet/user/data/client-throttle.dat
node.downloadAllowedDirs=all
node.downloadsDir=/opt/hyphanet/downloads
node.install.cfgDir=/opt/hyphanet/conf
node.install.nodeDir=/opt/hyphanet/noderef
node.install.persistentTempDir=/opt/hyphanet/persistent-temp
node.install.pluginDir=/opt/hyphanet/plugins
node.install.pluginStoresDir=/opt/hyphanet/plugins/data
node.install.runDir=/opt/hyphanet
node.install.storeDir=/opt/hyphanet/user/data
node.install.tempDir=/opt/hyphanet/tmp
node.install.userDir=/opt/hyphanet/user
node.load.nodeThrottleFile=/opt/hyphanet/user/data/node-throttle.dat
node.load.threadLimit=1000
node.masterKeyFile=/opt/hyphanet/user/master.keys
node.skipWrapperWarning=true
node.updater.autoupdate=false
node.updater.enabled=false
node.updater.updateInstallers=false
node.updater.updateSeednodes=true
node.uploadAllowedDirs=all
pluginmanager.enabled=true
security-levels.networkThreatLevel=HIGH
security-levels.physicalThreatLevel=NORMAL
ssl.sslKeyStore=/opt/hyphanet/user/certs
