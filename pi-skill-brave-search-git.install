post_install() {
  cat <<'EOF'
==> pi-skill-brave-search-git installed.

Pi discovers skills from configured paths.

Add one of these to your Pi settings:

Global (all projects): ~/.pi/agent/settings.json
{
  "skills": ["/usr/share/pi/skills"]
}

Project-only: .pi/settings.json
{
  "skills": ["/usr/share/pi/skills/brave-search"]
}

Note: you need an api from brave and set environment var BRAVE_API_KEY
Register at https://api-dashboard.search.brave.com/register
EOF
}

post_upgrade() {
  post_install "$@"
}
