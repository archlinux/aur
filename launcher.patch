diff -urN dunedynasty-1.6.4.orig/static/linux/dunedynasty-launcher dunedynasty-1.6.4/static/linux/dunedynasty-launcher
--- dunedynasty-1.6.4.orig/static/linux/dunedynasty-launcher	2025-05-31 19:12:09.000000000 +0200
