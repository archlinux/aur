@@ -1,5 +1,13 @@
 #!/bin/sh
-cp -r /app/share/dunedynasty $XDG_DATA_HOME
+XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
+
+PREFIX=/usr
+if [ -d "/app/share/dunedynasty" ]; then
