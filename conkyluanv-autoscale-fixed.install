post_install() {
  echo "You must install one of the nvidia packages suitable"
  echo "for your GPU for the nvidia support to properly work"
  
  # Update icon cache
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

post_upgrade() {
  post_install $1
}

post_remove() {
  # Update icon cache
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
} 