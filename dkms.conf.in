PACKAGE_NAME=@DKMS_PACKAGE_NAME@
PACKAGE_VERSION=@PCIE_DRIVER_VERSION@
KBUILD_PATH=$dkms_tree/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/linux/pcie
MAKE="make -C ${kernel_source_dir} M=${KBUILD_PATH} modules"
BUILT_MODULE_NAME[0]=hailo_pci
BUILT_MODULE_LOCATION[0]=linux/pcie
DEST_MODULE_LOCATION[0]=/updates/dkms
AUTOINSTALL=yes
