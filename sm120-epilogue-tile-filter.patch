--- /dev/null
+++ b/test/python/cutlass/test_sm120_epilogue_filter.py
@@ -0,0 +1,80 @@
+#################################################################################################
+#
+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: BSD-3-Clause
+#
+#################################################################################################
+
+"""Regression coverage for the SM120 generated-library epilogue filter."""
+
+import os
+import sys
+import unittest
+
+_CUTLASS_PY = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "..", "python")
+)
+if _CUTLASS_PY not in sys.path:
+  sys.path.insert(0, _CUTLASS_PY)
+
+from cutlass_library.library import (  # noqa: E402
+    DataType,
+    LayoutType,
+    sm120_rowmajor_epilogue_threadblock_shape_ok,
+)
+
+
+class Sm120EpilogueThreadblockFilterTests(unittest.TestCase):
+  @staticmethod
+  def compatible(n, element_c, element_d, output_sf_vector_size=None):
+    return sm120_rowmajor_epilogue_threadblock_shape_ok(
+        (128, n, 128),
+        element_c,
+        element_d,
+        LayoutType.RowMajor,
+        output_sf_vector_size)
+
+  def test_fp32_output_retains_small_n(self):
+    self.assertTrue(self.compatible(8, DataType.void, DataType.f32))
+    self.assertTrue(self.compatible(16, DataType.f16, DataType.f32))
+
+  def test_eight_bit_output_starts_at_n16(self):
+    self.assertFalse(self.compatible(8, DataType.void, DataType.e5m2))
+    self.assertTrue(self.compatible(16, DataType.void, DataType.e5m2))
+
+  def test_output_scale_vector_32_starts_at_n32(self):
+    self.assertFalse(
+        self.compatible(16, DataType.f16, DataType.e5m2, 32))
+    self.assertTrue(
+        self.compatible(32, DataType.f16, DataType.e5m2, 32))
+
+  def test_fp4_output_storage_starts_at_n32(self):
+    self.assertFalse(
+        self.compatible(8, DataType.f16, DataType.e2m1, 16))
+    self.assertFalse(
+        self.compatible(16, DataType.f16, DataType.e2m1, 16))
+    self.assertTrue(
+        self.compatible(32, DataType.f16, DataType.e2m1, 16))
+    self.assertTrue(
+        self.compatible(32, DataType.f16, DataType.e2m1, 32))
+
+  def test_fp6_output_requires_n_multiple_of_128(self):
+    for element_d in (DataType.e2m3, DataType.e3m2):
+      for n in (8, 16, 32, 64):
+        with self.subTest(element_d=element_d, n=n):
+          self.assertFalse(
+              self.compatible(n, DataType.f16, element_d, 32))
+      self.assertTrue(
+          self.compatible(128, DataType.f16, element_d, 32))
+
+  def test_non_rowmajor_layout_fails_closed(self):
+    with self.assertRaisesRegex(ValueError, "row-major D only"):
+      sm120_rowmajor_epilogue_threadblock_shape_ok(
+          (128, 128, 128),
+          DataType.void,
+          DataType.f32,
+          LayoutType.ColumnMajor)
+
+
+if __name__ == "__main__":
+  unittest.main()
