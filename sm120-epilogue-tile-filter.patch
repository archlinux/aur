+#
+def sm120_rowmajor_epilogue_threadblock_shape_ok(
+    threadblock_mnk, element_c, element_d, gmem_layout_tag_d,
+    output_sf_vector_size=None):
+  """
+  Return whether an SM120 auto-epilogue can represent a row-major output.
+
+  The SM120 mainloop accepts smaller CTA-N shapes than every output storage
+  atom and block-scale-factor visitor can represent.  Keep the valid small-N
+  kernels while preventing the manifest from instantiating impossible C++
+  template combinations.
+  """
+  if gmem_layout_tag_d != LayoutType.RowMajor:
+    raise ValueError("SM120 epilogue filter currently models row-major D only")
+
+  cta_n = threadblock_mnk[1]
+  fp6_types = (DataType.e2m3, DataType.e3m2)
+
+  # FP6 TMA output is stored in 8-bit containers and requires a contiguous
+  # CTA/epilogue extent of 128 elements.
+  if element_d in fp6_types:
+    if cta_n % 128 != 0:
+      return False
+    epilogue_n = 128
+  else:
+    epilogue_n = min(cta_n, 32)
+
+  def storage_atom_ok(element):
+    if element == DataType.void:
+      return True
+    storage_bits = 8 if element in fp6_types else DataTypeSize[element]
+    required_extent = max(8, 128 // storage_bits)
+    return epilogue_n % required_extent == 0
+
+  if not storage_atom_ok(element_c) or not storage_atom_ok(element_d):
+    return False
+
+  if output_sf_vector_size is not None:
+    if epilogue_n % output_sf_vector_size != 0:
+      return False
+    vectors_per_epilogue = epilogue_n // output_sf_vector_size
+    if vectors_per_epilogue not in (1, 2, 4, 8):
+      return False
+
+  return True
+
