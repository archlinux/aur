list_conf_files(){
  ls \
  /usr/share/dbeaver/dbeaver.ini \
  /usr/share/dbeaver-ce/dbeaver.ini \
  /usr/lib/dbeaver-ce/dbeaver.ini \
  /usr/lib/dbeaver/dbeaver.ini \
  2>/dev/null
}

post_install() {
  list_conf_files | /usr/share/libalpm/scripts/dbeaver-jvm-setting.sh ;
}

post_upgrade() {
  post_install
}