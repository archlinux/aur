# radiance.service EnvironmentFile - the process environment for the server
# (0600 root:root inside 0750 /etc/radiance: it is a secret store, not a file to
# chmod 0644 while chasing a permission error; post_upgrade repairs drift).
# systemd EnvironmentFile syntax: KEY=value lines only - no export, no $(), and
# NO expansion or command substitution (values are parsed literally). The unit
# loads it as EnvironmentFile=- (absent/empty = keyless server, fine on
# 127.0.0.1). All server settings live in /etc/radiance/radiance.yaml (0644).
#
# API key: uncomment `api-key-env: RADIANCE_API_KEY` in radiance.yaml, then set
# the key below. While api-key-env names this variable, an empty value refuses
# startup (fail-closed) - a loud signal, not silent auth-disabled.
RADIANCE_API_KEY=

# Optional engine environment (radiance --help / docs/GUIDE.md):
#RADIANCE_HOME=
#RADIANCE_KERNELS=
#RADIANCE_LOG=
