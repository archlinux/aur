[Unit]
Description=Synology Drive Client Daemon
After=network.target

[Service]
Type=simple
ExecStart=/opt/Synology/SynologyDrive/package/cloudstation/bin/cloud-drive-daemon
Environment="LD_LIBRARY_PATH=/opt/Synology/SynologyDrive/package/cloudstation/lib"
WorkingDirectory=/opt/Synology/SynologyDrive/package/cloudstation/bin
Restart=on-failure

[Install]
WantedBy=default.target
