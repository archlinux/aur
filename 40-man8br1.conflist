{
  "cniVersion": "1.0.0",
  "name": "man8br",
  "plugins": [
    {
      "type": "bridge",
      "bridge": "man8br1",
      "isGateway": true,
      "ipMasq": true,
      "ipMasqBackend": "nftables",
      "ipam": {
        "type": "host-local",
        "routes": [
          {
            "dst": "0.0.0.0/0"
          },
          {
            "dst": "2000::/3"
          }
        ],
        "ranges": [
          [
            {
              "subnet": "10.10.1.0/24"
            }
          ],
          [
            {
              "subnet": "3ffe:ffff:0:02ff::/64",
              "rangeStart": "3ffe:ffff:0:02ff::0010",
              "rangeEnd": "3ffe:ffff:0:02ff::0275"
            }
          ]
        ]
      }
    },
    {
        "type": "portmap",
        "capabilities": {"portMappings": true},
        "backend": "nftables"
    }
  ]
}