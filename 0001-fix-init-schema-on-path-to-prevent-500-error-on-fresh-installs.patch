From 759287959883e0733a2f96b54f094766dfa25785 Mon Sep 17 00:00:00 2001
From: graysky <therealgraysky AT proton DOT me>
Date: Mon, 6 Jul 2026 16:56:08 -0400
Subject: [PATCH] fix: Init schema on paths to prevent 500 error on fresh installs

The 'readings' table is created lazily during write operations (`log_reading`,
`import_csv_files`). On a fresh install, if the sensor daemon hasn't written
data before a user visits the dashboard, the missing table causes a hard 500
error in `day_stats()`.

Fix this by calling `_init_db()` on read paths (`query_readings`,
`query_readings_range`, and `day_stats`) to ensure the schema is self-healed
before querying.

---
 raspisump/log.py       | 2 ++
 raspisump/web/stats.py | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/raspisump/log.py b/raspisump/log.py
index 3de8d6fde6dc..06a63645e405 100644
--- a/raspisump/log.py
+++ b/raspisump/log.py
@@ -65,6 +65,7 @@ def query_readings(date: str = None, last: int = None) -> list:
     """
     conn = sqlite3.connect(DB_PATH)
     try:
+        _init_db(conn)
         if last is not None:
             rows = conn.execute(
                 "SELECT ts, water_depth, unit FROM readings"
@@ -199,6 +200,7 @@ def query_readings_range(
     end_ts = f"{end_date} {end_time}:59" if end_time else f"{end_date} 23:59:59"
     conn = sqlite3.connect(DB_PATH)
     try:
+        _init_db(conn)
         return conn.execute(
             "SELECT ts, water_depth, unit FROM readings"
             " WHERE ts >= ? AND ts <= ? ORDER BY ts",
diff --git a/raspisump/web/stats.py b/raspisump/web/stats.py
index ac65d0235c27..717399f06a66 100644
--- a/raspisump/web/stats.py
+++ b/raspisump/web/stats.py
@@ -6,7 +6,7 @@ Does not modify log.py; CLI tools are unaffected.
 import sqlite3
 import time
 
-from raspisump.log import DB_PATH
+from raspisump.log import DB_PATH, _init_db
 
 
 def day_stats(date=None):
@@ -20,6 +20,7 @@ def day_stats(date=None):
 
     conn = sqlite3.connect(DB_PATH)
     try:
+        _init_db(conn)
         row = conn.execute(
             """
             SELECT
