# Messages pacman shows after vtium is installed, upgraded or removed, the
# same for every console package. Nothing here starts, stops,
# restarts, enables or disables a unit: a restart hangs up every session on
# that VT, so a new build takes effect at each VT's next start, and which
# VTs run vtium is the user's choice, made with vtium console (ADR-1500 D3,
# D5, D7).
#
# pacman removes a console package that another one conflicts with the way
# it removes one on request, scriptlets included, and the scriptlets cannot
# tell the two apart. So the removal messages say what holds when another
# vtium console package takes this one's place, and post_install says what
# the replaced package left.

_vtium_enable() {
  cat <<'EOF'
==> vtium runs on no VT until you turn it on, the same as the kmscon package.
    vtium console gives vtium a VT, or every VT, and takes them back:
      vtium console status
      sudo vtium console enable 3
      sudo vtium console enable --all
    enable --all is for a machine whose autovt@.service link does not name
    kmscon. vtium console starts nothing: it changes which console starts on
    a VT next time, and prints the command that starts vtium there now, which
    ends every session on that VT. enable 3 refuses a VT that kmscon, a
    display manager or a graphical session holds, and enable --all passes
    such a VT by and names it. To give VTs back, which you also do before you
    remove vtium:
      sudo vtium console disable 3
      sudo vtium console disable --all
    To share VTs with kmscon, or to move from kmscon to vtium, read the README:
      https://github.com/vtium/vtium-arch#sharing-vts-with-kmscon
EOF
}

# The VTs whose vtium@ runs now, one name a line, or nothing.
_vtium_running() {
  systemctl list-units 'vtium@*' --state=running --plain --no-legend 2>/dev/null |
    awk '$1 ~ /^vtium@tty[0-9]+\.service$/ { print $1 }'
}

# The VTs whose vtium still runs the build it started with, under a heading,
# or nothing.
_vtium_still_running() {
  local running
  running=$(_vtium_running)
  [ -n "$running" ] || return 0
  printf '%s\n' "    These still run the build they started with:"
  # shellcheck disable=SC2086 # one unit name a word
  printf '      %s\n' $running
}

# The links to vtium@.service under /etc/systemd/system, one path a line,
# or nothing. Each outlives the package and then names a unit that is gone,
# until another vtium console package installs it again.
_vtium_links() {
  local l
  for l in /etc/systemd/system/autovt@.service /etc/systemd/system/autovt@tty*.service /etc/systemd/system/getty.target.wants/vtium@tty*.service; do
    [ -L "$l" ] && [ "$(readlink "$l")" = /usr/lib/systemd/system/vtium@.service ] && printf '%s\n' "$l"
  done
  return 0
}

# A first install says that vtium runs on no VT. When this package takes the
# place of another vtium console package, the links that gave vtium its VTs
# are still there and name vtium@.service, which this package installs
# again, so those VTs stay vtium's, and a vtium that still runs keeps the
# build it started with until it restarts.
post_install() {
  local links running
  links=$(_vtium_links)
  running=$(_vtium_running)
  if [ -z "$links" ] && [ -z "$running" ]; then
    _vtium_enable
    return 0
  fi
  if [ -n "$links" ]; then
    cat <<'EOF'
==> vtium already holds VTs on this machine, through these links, which the
    console package this one replaced, or an earlier install, left. They
    name vtium@.service, which this package installs, so those VTs stay
    vtium's and you need change nothing:
EOF
    # shellcheck disable=SC2086 # one path a word
    printf '      %s\n' $links
    cat <<'EOF'
    vtium console status lists them, and sudo vtium console disable --all
    gives them back.
EOF
  fi
  if [ -n "$running" ]; then
    cat <<'EOF'
==> No running vtium was restarted: a restart ends every session on its VT.
    Each VT runs this build from its next start, at a reboot or when you
    restart it on purpose, from another VT or over ssh, after logging out
    there, for VT 3:
      sudo systemctl restart vtium@tty3.service
EOF
    _vtium_still_running
  fi
}

post_upgrade() {
  cat <<'EOF'
==> vtium was upgraded, and no running vtium was restarted: a restart ends
    every session on its VT. Each VT runs the new build from its next start,
    at a reboot or when you restart it on purpose, from another VT or over
    ssh, after logging out there, for VT 3:
      sudo systemctl restart vtium@tty3.service
EOF
  _vtium_still_running
}

pre_remove() {
  local running
  running=$(_vtium_running)
  [ -n "$running" ] || return 0
  printf '%s\n' "==> vtium is being removed while these run; each keeps running from memory"
  printf '%s\n' "    until it stops:"
  # shellcheck disable=SC2086 # one unit name a word
  printf '      %s\n' $running
  printf '%s\n' "    sudo systemctl stop vtium@ttyN.service stops one, which ends every"
  printf '%s\n' "    session on that VT."
  if [ -n "$(_vtium_links)" ]; then
    printf '%s\n' "    A VT whose link still names vtium@.service then has no console unit;"
    printf '%s\n' "    pacman lists those links when the removal ends. If pacman removes this"
    printf '%s\n' "    package to install another vtium console package, that package"
    printf '%s\n' "    installs vtium@.service again, the links stay valid, and you need do"
    printf '%s\n' "    nothing."
  fi
}

post_remove() {
  # The links that vtium console made, or that were made by hand, outlive the
  # package and now point at nothing, until another vtium console package
  # installs vtium@.service again; this names each one and changes nothing.
  # vtium console disable --all, run before the removal, gives each back as
  # it was. A getty comes back through add-wants, which makes only its
  # getty.target want: systemctl enable getty@ttyN.service would also link
  # autovt@ttyN.service to the getty, and vtium console enable N refuses a VT
  # whose own link names another console.
  local l vt left='' getty='' records=/var/lib/vtium/console
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    left+="      sudo rm $l"$'\n'
    case $l in
    */autovt@.service)
      getty+="      sudo systemctl preset getty@.service"$'\n' ;;
    */autovt@*)
      vt=${l##*@}
      getty+="      sudo systemctl add-wants getty.target getty@${vt%.service}.service"$'\n' ;;
    esac
  done <<<"$(_vtium_links)"
  left+=$getty
  [ -n "$left" ] || return 0
  printf '%s\n' "==> If pacman removed this package to install another vtium console package,"
  printf '%s\n' "    such as vtium-minspec in place of vtium, that package installs"
  printf '%s\n' "    vtium@.service again, the links below stay valid, and you need do"
  printf '%s\n' "    nothing. Otherwise vtium is removed, but these links to vtium@.service"
  printf '%s\n' "    are left and point at nothing, so logind would start nothing on those"
  printf '%s\n' "    VTs. Remove each, and enable its VT's getty at boot again. Where kmscon"
  printf '%s\n' "    served a VT, skip that VT's add-wants line and link the VT to kmscon"
  printf '%s\n' "    instead, as shown below:"
  printf '%s' "$left"
  printf '%s\n' "    The kmscon link, for a VT that kmscon served:"
  printf '%s\n' "      sudo ln -s /usr/lib/systemd/system/kmsconvt@.service \\"
  printf '%s\n' "        /etc/systemd/system/autovt@ttyN.service"
  printf '%s\n' "    Then reload systemd:"
  printf '%s\n' "      sudo systemctl daemon-reload"
  printf '%s\n' "    Each getty starts at the next boot, or now, once vtium has stopped on its"
  printf '%s\n' "    VT, with sudo systemctl start getty@ttyN.service. Started while vtium"
  printf '%s\n' "    still runs there, the getty stops vtium, which ends every session on"
  printf '%s\n' "    that VT."
  if [ -n "$(ls -A "$records" 2>/dev/null)" ]; then
    printf '%s\n' "    Or put back exactly what vtium console recorded in $records:"
    printf '%s\n' "    install vtium again, run sudo vtium console disable --all, then remove it."
  fi
  printf '%s\n' "    Next time, run sudo vtium console disable --all before you remove vtium's"
  printf '%s\n' "    console package."
}
