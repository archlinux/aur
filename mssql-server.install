_masterdb=/var/opt/mssql/data/master.mdf
_restartflag=/run/mssql-server.upgrade-restart

_setup_hint() {
	cat <<'MSG'

  Microsoft SQL Server 2025 is installed but not yet configured.

  1. Run the one-time setup (it asks for the edition, the licence terms and
     the "sa" password):

       sudo /opt/mssql/bin/mssql-conf setup

  2. Enable and start the service:

       sudo systemctl enable --now mssql-server

  3. Check it came up:

       systemctl status mssql-server
       sudo journalctl -u mssql-server -e

  The engine listens on TCP 1433 by default. Connect with sqlcmd, Azure Data
  Studio, DBeaver or any SQL Server client as user "sa".

MSG
}

post_install() {
	_setup_hint
}

pre_upgrade() {
	# $1 = new version, $2 = old version
	local newmajor=${1%%.*} oldmajor=${2%%.*}

	rm -f "$_restartflag"

	[ -f "$_masterdb" ] || return 0
	[ "$newmajor" = "$oldmajor" ] && return 0

	# Major version jump. Stop the engine before its binaries are swapped out
	# from under it, and remember whether it was running so post_upgrade can
	# put it back the way it found it.
	if systemctl is-active --quiet mssql-server 2>/dev/null; then
		: > "$_restartflag" 2>/dev/null || true
		systemctl stop mssql-server || true
	fi
}

post_upgrade() {
	local newmajor=${1%%.*} oldmajor=${2%%.*}
	local was_running=0

	[ -f "$_restartflag" ] && was_running=1
	rm -f "$_restartflag"

	if [ ! -f "$_masterdb" ]; then
		_setup_hint
		return 0
	fi

	[ "$newmajor" = "$oldmajor" ] && return 0

	cat <<MSG

  ############################################################################
  ##  SQL Server major version $oldmajor -> $newmajor : databases are converted  ##
  ############################################################################

  On its first start the new engine rewrites every database in
  /var/opt/mssql - master, msdb, model and all user databases - to the new
  on-disk format. This CANNOT BE UNDONE: version $oldmajor can no longer open
  those files afterwards, there is no downgrade path, and the two majors
  cannot run side by side because /opt/mssql and /var/opt/mssql are fixed
  locations.

  Rolling back needs a copy of /var/opt/mssql taken BEFORE this upgrade, with
  the service stopped. If you do not have one, going back means restoring
  from a BACKUP DATABASE dump made by the old engine.

  Database compatibility levels are preserved, so existing databases keep the
  behaviour they had; only the physical file format moves.

MSG

	if [ "$was_running" = 1 ]; then
		cat <<'MSG'
  The service was running before the upgrade and is being started again now,
  so the conversion is happening as you read this. Follow it with:

      sudo journalctl -u mssql-server -f

MSG
		systemctl start mssql-server || true
	else
		cat <<'MSG'
  The service was not running, so nothing has been converted yet. It will be
  converted the next time the engine starts - including automatically at boot
  if the unit is enabled.

MSG
	fi
}

pre_remove() {
	systemctl stop mssql-server 2>/dev/null || true
	rm -f "$_restartflag"
}

post_remove() {
	cat <<'MSG'

  /var/opt/mssql has been left in place; it holds your databases.
  Remove it manually if you no longer need them:

      sudo rm -rf /var/opt/mssql

MSG
}
