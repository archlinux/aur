# Core Netfilter and Connection Tracking (Crucial Dependencies)
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_SECMARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_TIMEOUT=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_NEEDED=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NETFILTER_TPROXY=y
CONFIG_NF_CONN_SECMARK=y
CONFIG_NETFILTER_XT_TARGET_LOG=y

# nftables Framework and Components
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_COMPAT=y
CONFIG_NF_FLOWTABLE_INET=y
CONFIG_NF_FLOWTABLE_IPV4=y
CONFIG_NF_FLOWTABLE_IPV6=y
CONFIG_NF_TABLES_SET=y
CONFIG_NF_TABLES_RAW=y
CONFIG_NF_TABLES_MANGLE=y
CONFIG_NF_TABLES_NAT=y
CONFIG_NF_TABLES_EXTRA=y
CONFIG_NF_TABLES_BPF=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y

# Legacy iptables Support (Required for iptables-nft compatibility)
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y

# Legacy IPv4 Tables/Chains
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_SECURITY=y
CONFIG_IP_NF_ARPTABLES=y
CONFIG_IP_NF_ARP_FILTER=y
CONFIG_IP_NF_ARP_MANGLE=y

# Legacy IPv4 Targets/Matches
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MATCH_STATE=y
CONFIG_IP_NF_MATCH_CONNTRACK=y
CONFIG_IP_NF_MATCH_MARK=y
CONFIG_IP_NF_MATCH_MULTIPORT=y
CONFIG_IP_NF_MATCH_LIMIT=y

# Legacy IPv6 Tables/Chains
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_SECURITY=y

# Legacy IPv6 Targets/Matches
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_MATCH_STATE=y
CONFIG_IP6_NF_MATCH_CONNTRACK=y

# Optional/Suggested Modules
CONFIG_BRIDGE_NETFILTER=m
CONFIG_IP_SET=m
CONFIG_IP_SET_PROC_FS=y
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_NAT_FTP=m