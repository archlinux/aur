# ----------------------------------------------------------------------------
# 1. CORE FRAMEWORK & ESSENTIAL DEPENDENCIES (Built-in: =y)
# These are essential for Netfilter hooks and fundamental packet handling.
# ----------------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_X_TABLES=y                     # x_tables
CONFIG_NF_CONNTRACK=y                 # nf_conntrack
CONFIG_NF_NAT=y                       # nf_nat
