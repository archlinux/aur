# ----------------------------------------------------------------------------
# 1. CORE NETFILTER FRAMEWORK (Built-in: =y)
# These are essential for the kernel's networking stack to provide firewall hooks.
# ----------------------------------------------------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_X_TABLES=y                     # x_tables base
CONFIG_NF_CONNTRACK=y                 # nf_conntrack (Stateful Firewalling)
CONFIG_NF_NAT=y                       # nf_nat (Network Address Translation)
CONFIG_NF_TABLES=y                    # nf_tables (New Firewall Backend)

# Essential protocols/defrag for ConnTrack/NAT
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y

# ----------------------------------------------------------------------------
# 2. IP SETS (IP_SET_*) (Modular: =m)
# Required for fast matching against lists of IP addresses, ports, etc.
# ----------------------------------------------------------------------------
CONFIG_IP_SET=m                       # ip_set
CONFIG_IP_SET_MAX=y                   # Base setting for IP sets
CONFIG_IP_SET_PROC_FS=y               # Base setting for IP sets
CONFIG_IP_SET_BITMAP_IP=m             # ip_set_bitmap_ip
CONFIG_IP_SET_BITMAP_IPMAC=m          # ip_set_bitmap_ipmac
CONFIG_IP_SET_BITMAP_PORT=m           # ip_set_bitmap_port
CONFIG_IP_SET_HASH_IP=m               # ip_set_hash_ip
CONFIG_IP_SET_HASH_IPMAC=m            # ip_set_hash_ipmac
CONFIG_IP_SET_HASH_IPMARK=m           # ip_set_hash_ipmark
CONFIG_IP_SET_HASH_IPPORT=m           # ip_set_hash_ipport
CONFIG_IP_SET_HASH_IPPORTNET=m        # ip_set_hash_ipportnet
CONFIG_IP_SET_HASH_IPPORTIP=m         # ip_set_hash_ipportip
CONFIG_IP_SET_HASH_MAC=m              # ip_set_hash_mac
CONFIG_IP_SET_HASH_NET=m              # ip_set_hash_net
CONFIG_IP_SET_HASH_NETNET=m           # ip_set_hash_netnet
CONFIG_IP_SET_HASH_NETIFACE=m         # ip_set_hash_netiface
CONFIG_IP_SET_HASH_NETPORT=m          # ip_set_hash_netport
CONFIG_IP_SET_HASH_NETPORTNET=m       # ip_set_hash_netportnet
CONFIG_IP_SET_LIST_SET=m              # ip_set_list_set

# ----------------------------------------------------------------------------
# 3. IP VIRTUAL SERVER (IP_VS_*) (Modular: =m)
# Required for layer 4 load balancing.
# ----------------------------------------------------------------------------
CONFIG_IP_VS=m                        # ip_vs
CONFIG_IP_VS_IPV6=y                   # IPVS over IPv6 (set to 'y' or 'm')
CONFIG_IP_VS_PROTO_TCP=y              # IPVS required protocol support
CONFIG_IP_VS_PROTO_UDP=y              # IPVS required protocol support
CONFIG_IP_VS_PROTO_SCTP=y             # IPVS required protocol support
CONFIG_IP_VS_PROTO_AH_ESP=y           # IPVS required protocol support
CONFIG_IP_VS_NFCT=y                   # IPVS connection tracking support

# IPVS Schedulers (Load Balancing Algorithms)
CONFIG_IP_VS_DH=m                     # ip_vs_dh (Destination Hashing)
CONFIG_IP_VS_FO=m                     # ip_vs_fo (Fastest Open)
CONFIG_IP_VS_FTP=m                    # ip_vs_ftp (FTP Connection Helper)
CONFIG_IP_VS_LC=m                     # ip_vs_lc (Least-Connection)
CONFIG_IP_VS_LBLC=m                   # ip_vs_lblc (Locality-Based Least-Connection)
CONFIG_IP_VS_LBLCR=m                  # ip_vs_lblcr (Locality-Based Least-Connection with Replication)
CONFIG_IP_VS_MH=m                     # ip_vs_mh (Maglev Hashing)
CONFIG_IP_VS_NQ=m                     # ip_vs_nq (Never Queue)
CONFIG_IP_VS_OVS=m                    # ip_vs_ovf (One-Shot Virtual Server - often named OVS)
CONFIG_IP_VS_OVF=m                    # This specific symbol may be deprecated/merged, but included for completeness.
CONFIG_IP_VS_RR=m                     # ip_vs_rr (Round-Robin)
CONFIG_IP_VS_SED=m                    # ip_vs_sed (Shortest Expected Delay)
CONFIG_IP_VS_SH=m                     # ip_vs_sh (Source Hashing)
CONFIG_IP_VS_WLC=m                    # ip_vs_wlc (Weighted Least-Connection)
CONFIG_IP_VS_WRR=m                    # ip_vs_wrr (Weighted Round-Robin)

# IPVS Application Helpers
CONFIG_IP_VS_PE_SIP=m                 # ip_vs_pe_sip (SIP Persistence Engine)

