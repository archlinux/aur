+					ret);
+				input_free_device(input);
+				return;
+			}
+
+			WRITE_ONCE(wd->input, input);
+		}
+
+		ret = wtp_enable_raw_mode(hidpp);
+		if (ret)
+			return;
+	} else if (hidpp->quirks & HIDPP_QUIRK_CLASS_WTP) {
 		ret = wtp_connect(hdev);
 		if (ret)
