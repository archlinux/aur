@@ -3054,7 +3072,7 @@ static int wtp_mouse_raw_xy_event(struct hidpp_device *hidpp, u8 *data)
 		.button = data[0] & 0x01,
 	};
 
-	wtp_send_raw_xy_event(hidpp, &raw);
+	wtp_send_raw_xy_event(hidpp, input, &raw);
 
