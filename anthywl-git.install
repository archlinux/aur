post_install() {
  cat >&2 << 'EOF'

    ##                                                ##
    ## To get started with anthywl, copy the example  ##
    ## `/usr/share/anthywl/examples/config` file to   ##
    ## the `${XDG_HOME}/anthywl/` directory. Or, if   ##
    ## XDG_HOME is not set, to `~/.config/anthywl/`.  ##
    ##                                                ##

EOF
}
