post_install() {
  cat <<EOF
==> pi-ext-mempalace installed to /usr/share/pi/extensions/mempalace/

To make it available to pi, add /usr/share/pi/extensions to your
~/.pi/agent/settings.json "extensions" list, or create a symlink:

    ln -s /usr/share/pi/extensions/mempalace ~/.pi/agent/extensions-ordered/00-mempalace

Requires python-mempalace (installed automatically as a dependency).

EOF
}

post_upgrade() {
  post_install
}
