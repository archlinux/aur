post_install() {
    echo "MusicLyricApp has been installed to /opt/musiclyricapp"
    echo "You can start it by running 'musiclyricapp' from the command line"
    echo "or from your application menu."
    echo ""
    echo "For more information, visit: https://github.com/jitwxs/163MusicLyrics"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "Removing MusicLyricApp..."
}