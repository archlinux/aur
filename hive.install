post_install() {
  cat <<'MSG'
hive-bin installed.
Run `hive setup` in a project to install and start the native Hive web and daemon services, bootstrap the managed web bundle, and enroll the project. Use `hive setup --no-service` to keep Hive web foreground-only.
MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'MSG'
hive-bin removed.
pacman -R hive-bin alone does not touch project .hive-state directories.
Use `hive uninstall` flags deliberately for user config/cache or state cleanup.
MSG
}
