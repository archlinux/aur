# Copy to ~/.config/hindsight/hindsight-api.env
#
# The database and role must exist already, e.g.
#   createdb hindsight && psql -d hindsight -c 'CREATE EXTENSION IF NOT EXISTS vector;'
HINDSIGHT_API_DATABASE_URL=postgresql:///hindsight?host=/run/postgresql

# Fact extraction and consolidation call an LLM. Any OpenAI-compatible endpoint
# works, including a local llama.cpp server.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:8080/v1
HINDSIGHT_API_LLM_API_KEY=none
HINDSIGHT_API_LLM_MODEL=local

# Embeddings and reranking stay on this machine, no PyTorch required.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_RERANKER_PROVIDER=flashrank

# The API listens on all interfaces, port 8888. Override if that port is taken:
# HINDSIGHT_API_PORT=8889
# HINDSIGHT_API_HOST=127.0.0.1
