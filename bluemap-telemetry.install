post_install() {
  local config=/etc/bluemap-telemetry/config.env

  if [[ ! -e "$config" ]]; then
    install -dm750 /etc/bluemap-telemetry
    install -Dm600 /etc/bluemap-telemetry/config.env.example "$config"
    echo ">>> Created $config from the example template."
    echo ">>> Edit RCON credentials and WEB_ROOT before enabling the service."
  fi

  echo ">>> Requires a minecraft system user (for example from the minecraftd package)."
  echo ">>> Ensure the minecraft user can write to WEB_ROOT (group membership or ACLs)."
  echo ">>> Enable and start with: systemctl enable --now bluemap-telemetry.service"
  echo ""
  echo ">>> Optional: install the marker datapack into a world (replace WORLD, e.g. /srv/minecraft/world):"
  echo ">>>   cp -a /usr/share/bluemap-telemetry/datapack WORLD/datapacks/bluemap-telemetry"
  echo ">>> Re-copy the datapack after package upgrades (or use a world symlink + allowed_symlinks.txt)."
  echo ">>> Then run /reload in-game or restart the Minecraft server."
  echo ""
  echo ">>> Optional typed-marker icons (once; survives package upgrades):"
  echo ">>> Symlink the icon dir into the BlueMap web root (next to index.html, NOT into assets/):"
  echo ">>>   ln -s /usr/share/bluemap-telemetry/assets/markers /srv/http/bluemap-telemetry"
  echo ">>> Keep MARKER_ICON_BASE=bluemap-telemetry in /etc/bluemap-telemetry/config.env"
  echo ">>> (or change both the link name and MARKER_ICON_BASE together)."
  echo ">>> Details: /usr/share/bluemap-telemetry/datapack/README.md (Marker types / icons)."
}

post_upgrade() {
  post_install "$@"
}

pre_remove() {
  if [[ $1 -eq 0 ]]; then
    if systemctl is-active --quiet bluemap-telemetry.service; then
      systemctl stop bluemap-telemetry.service
    fi
    if systemctl is-enabled --quiet bluemap-telemetry.service 2>/dev/null; then
      systemctl disable bluemap-telemetry.service
    fi
  fi
}

post_remove() {
  if [[ $1 -eq 0 ]]; then
    echo ">>> Removed bluemap-telemetry.service (config in /etc/bluemap-telemetry/ was kept)."
  fi
}
