+#include <QtCore/QTimerEvent>
+#include <QtGui/private/qhighdpiscaling_p.h>
+#include <qpa/qwindowsysteminterface.h>
+
+QT_BEGIN_NAMESPACE
+
+using namespace std::chrono_literals;
+
+static constexpr auto pointerReleasePollInterval = 100ms;
+
+namespace {
+
+struct PointerState
+{
+    QXcbScreen *screen = nullptr;
+    bool buttonPressed = false;
+};
+
+PointerState queryPointerState(QXcbConnection *connection)
+{
+    QXcbVirtualDesktop *virtualDesktop = nullptr;
+    QPoint pos;
+    int mask = 0;
+    QXcbCursor::queryPointer(connection, &virtualDesktop, &pos, &mask);
+
+    return {
+        virtualDesktop ? virtualDesktop->screenAt(pos) : nullptr,
+        (mask & (XCB_BUTTON_MASK_1 | XCB_BUTTON_MASK_2 | XCB_BUTTON_MASK_3)) != 0,
+    };
+}
+
+}
+
+void QXcbWindow::rescale(const QWindowList &windows, qreal oldFactor, qreal newFactor, qxp::function_ref<void()> applyScale)
+{
+    if (qFuzzyCompare(oldFactor, newFactor)) {
+        applyScale();
+        return;
+    }
+
+    struct RescaledWindow
+    {
+        QPointer<QXcbWindow> window;
+        bool keepsLogicalSize;
+    };
+
+    QList<RescaledWindow> rescaledWindows;
+    for (QWindow *window : windows) {
+        auto *platformWindow = static_cast<QXcbWindow *>(window->handle());
+        if (!platformWindow || platformWindow->isForeignWindow())
+            continue;
+
+        const bool keepsLogicalSize = platformWindow->keepsLogicalSizeOnRescale();
+        if (keepsLogicalSize)
+            platformWindow->QPlatformWindow::setGeometry(platformWindow->rescaledGeometry(oldFactor, newFactor));
+        rescaledWindows.append({ platformWindow, keepsLogicalSize });
+    }
+
+    applyScale();
+
+    for (const RescaledWindow &rescaled : std::as_const(rescaledWindows)) {
+        if (rescaled.window)
+            rescaled.window->finishRescale(rescaled.keepsLogicalSize);
+    }
+}
+
+void QXcbWindow::timerEvent(QTimerEvent *event)
+{
+    if (event->id() != m_pointerReleaseTimer.id()) {
+        QObject::timerEvent(event);
+        return;
+    }
+
+    const PointerState pointer = queryPointerState(connection());
+    if (pointer.buttonPressed)
+        return;
+
+    m_pointerReleaseTimer.stop();
+    if (pointer.screen && !wmControlsSize())
+        switchToScreen(pointer.screen);
+    else
+        updateScreen();
+}
+
+void QXcbWindow::updateScreenAfterMoveResize()
+{
+    if (m_pointerReleaseTimer.isActive())
+        return;
+
+    if (!m_embedded && !wmControlsSize() && queryPointerState(connection()).buttonPressed)
+        m_pointerReleaseTimer.start(pointerReleasePollInterval, this);
+    else
+        updateScreen();
+}
+
+void QXcbWindow::updateScreen()
+{
+    if (m_pointerReleaseTimer.isActive())
+        return;
+
+    auto *screen = static_cast<QXcbScreen *>(screenForGeometry(geometry()));
+    if (screen && staysOnScaleAfterRescale(screen))
+        switchToScreen(screen);
+}
+
+void QXcbWindow::switchToScreen(QXcbScreen *screen)
+{
+    if (screen == xcbScreen())
+        return;
+
+    QWindowList windows = window()->findChildren<QWindow *>();
+    windows.removeIf([](const QWindow *child) { return child->isTopLevel(); });
+    windows.prepend(window());
+
+    rescale(windows, QHighDpiScaling::factor(window()), QHighDpiScaling::factor(screen), [this, screen] {
+        QWindowSystemInterface::handleWindowScreenChanged<QWindowSystemInterface::SynchronousDelivery>(
+                window(), screen->QPlatformScreen::screen());
+    });
+}
+
+bool QXcbWindow::staysOnScaleAfterRescale(const QXcbScreen *screen) const
+{
+    const qreal oldFactor = QHighDpiScaling::factor(window());
+    const qreal newFactor = QHighDpiScaling::factor(screen);
+    if (qFuzzyCompare(oldFactor, newFactor) || !keepsLogicalSizeOnRescale())
+        return true;
+
+    const QPlatformScreen *rescaledScreen = screenForGeometry(rescaledGeometry(oldFactor, newFactor));
+    return rescaledScreen && qFuzzyCompare(QHighDpiScaling::factor(rescaledScreen), newFactor);
+}
+
+bool QXcbWindow::keepsLogicalSizeOnRescale() const
+{
+    if (m_embedded)
+        return false;
+
+    if (QPlatformWindow::parent())
+        return true;
+
+    return !wmControlsSize() && !m_pointerReleaseTimer.isActive();
+}
+
+bool QXcbWindow::wmControlsSize() const
+{
+    return m_windowState.testAnyFlags(Qt::WindowMinimized | Qt::WindowMaximized | Qt::WindowFullScreen);
+}
+
+QRect QXcbWindow::rescaledGeometry(qreal oldFactor, qreal newFactor) const
+{
+    const QRect nativeGeometry = geometry();
+    const QPoint origin = QPlatformWindow::parent() ? QPoint() : nativeGeometry.topLeft();
+    return QHighDpi::scale(QHighDpi::fromNative(nativeGeometry, oldFactor, origin), newFactor, origin);
+}
+
+void QXcbWindow::finishRescale(bool keepsLogicalSize)
+{
+    if (QPlatformWindow::parent()) {
+        if (keepsLogicalSize)
+            setGeometry(geometry());
+        return;
+    }
+
+    propagateSizeHints();
+    if (keepsLogicalSize)
+        configureSize(geometry().size());
+
+    xcb_flush(xcb_connection());
+}
+
+QT_END_NAMESPACE
