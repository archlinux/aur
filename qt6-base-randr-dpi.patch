+std::optional<qreal> QXcbScreen::readHighDpiScaleFactor() const
+{
+    if (!connection()->isAtLeastXRandR12() || m_output == XCB_NONE)
+        return std::nullopt;
+
+    auto reply = Q_XCB_REPLY(xcb_randr_get_output_property, xcb_connection(),
+                             m_output, atom(QXcbAtom::AtomDPI), XCB_ATOM_INTEGER, 0, 1, false, false);
+    if (!reply || reply->type != XCB_ATOM_INTEGER || reply->format != 32 || reply->num_items != 1)
+        return std::nullopt;
+
+    const int32_t dpi = *reinterpret_cast<const int32_t *>(xcb_randr_get_output_property_data(reply.get()));
+    if (dpi <= 0)
+        return std::nullopt;
+
+    return dpi / logicalBaseDpi().first;
+}
