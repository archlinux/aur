+void QXcbScreen::updateHighDpiScaleFactor()
+{
+    const std::optional<qreal> factor = readHighDpiScaleFactor();
+    if (factor == highDpiScaleFactor())
+        return;
+
+    const qreal oldFactor = QHighDpiScaling::factor(this);
+    setHighDpiScaleFactor(factor);
+
+    QScreen *screen = QPlatformScreen::screen();
+    if (!screen)
+        return;
+
+    QHighDpiScaling::updateHighDpiScaling();
+    const QDpi dpi = logicalDpi();
+    QXcbWindow::rescale(windows(), oldFactor, QHighDpiScaling::factor(this), [screen, dpi] {
+        QWindowSystemInterface::handleScreenLogicalDotsPerInchChange(screen, dpi.first, dpi.second);
+    });
+}
