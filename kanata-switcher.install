post_install() {
    cat <<'EOF'

  ==> kanata-switcher installed
  ==> Before starting it, configure:
  ==>   - Kanata with its TCP server enabled
  ==>   - ~/.config/kanata/kanata-switcher.json
  ==> To enable and start the service:
  ==>   systemctl --user enable --now kanata-switcher.service
  ==> For a non-default Kanata port, override ExecStart with:
  ==>   systemctl --user edit kanata-switcher.service
  ==> To check status:
  ==>   systemctl --user status kanata-switcher.service

EOF
}

post_upgrade() {
    echo '  ==> Restart the user service to load the upgraded binary:'
    echo '  ==>   systemctl --user restart kanata-switcher.service'
}
