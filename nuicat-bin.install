post_install() {
    # Resolve the real installing user (sudo -i / polkit won't set SUDO_USER)
    SUDO_USER="${SUDO_USER:-$(logname 2>/dev/null || true)}"
    groupadd -f input 2>/dev/null || true
    if [ -n "$SUDO_USER" ]; then
        usermod -aG input "$SUDO_USER" 2>/dev/null || true
        # Immediate device access via ACLs (group takes effect on next login)
        setfacl -m u:"$SUDO_USER":rw /dev/uinput 2>/dev/null || true
        for dev in /dev/input/event*; do
            setfacl -m u:"$SUDO_USER":rw "$dev" 2>/dev/null || true
        done
    fi
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=input 2>/dev/null || true
    echo "==> To start nuicat, run: systemctl --user enable --now nuicat.service"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "==> To stop nuicat, run: systemctl --user disable --now nuicat.service"
}
