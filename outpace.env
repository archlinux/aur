# Outpace settings for the systemd service (outpace.service). One VAR=value per line.
# Every OUTPACE_* variable is documented at
# https://github.com/jamezrin/outpace-stream/wiki/Environment-Variables
# Apply changes with: systemctl restart outpace

# HTTP API and RTMP ingest stay on loopback unless a firewall or authenticating proxy
# protects them. Only the peer port (8621/tcp) is meant to face the internet.
OUTPACE_BIND=127.0.0.1:6878
OUTPACE_RTMP_BIND=127.0.0.1:1935
OUTPACE_DATA_DIR=/var/lib/outpace
