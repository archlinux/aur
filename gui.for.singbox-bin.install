post_install() {
    if [ -f /usr/bin/sing-box ]; then
        if ! setcap cap_net_admin=+ep /usr/bin/sing-box; then
            echo "==> TUN mode requires CAP_NET_ADMIN on /usr/bin/sing-box." >&2
        fi
    fi
    echo "==> GUI.for.SingBox uses ~/.local/share/GUI.for.SingBox/ for your data."
    echo "==> CPU selection is automatic. To review it, run gui-for-singbox --select-cpu."
    echo "==> Press Enter to keep Automatic."
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "==> Note: The system files for GUI.for.SingBox have been removed."
    echo "==> However, per Linux FHS guidelines, user data in ~/.local/share is kept intact."
    echo ""
    echo "==> To ONLY remove the app caches & binary copy but KEEP your data/configs, run:"
    echo "    find ~/.local/share/GUI.for.SingBox -mindepth 1 -maxdepth 1 ! -name 'data' -exec rm -rf {} +"
    echo ""
    echo "==> To remove the application's profiles, settings, and data, run:"
    echo "    rm -rf ~/.local/share/GUI.for.SingBox"
    echo '==> The optional CPU preference is stored in ${XDG_CONFIG_HOME:-$HOME/.config}/gui-for-singbox/cpu.'
}
