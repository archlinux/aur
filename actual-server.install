post_install() {
    cat <<MSG
==> actual-server has been installed.
==> Review and update /etc/conf.d/actual-server, then start it with:
==>     systemctl enable --now actual-server.service
==>
==> WARNING: if you change ACTUAL_DATA_DIR in /etc/conf.d/actual-server,
==> you must also update WorkingDirectory= and ReadWritePaths=
==> in the actual-server.service unit with:
==>     systemctl edit actual-server.service
MSG
}

post_upgrade() {
    post_install
}
