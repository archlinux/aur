#!/bin/bash
# omarchy-seq-paste: Sequential copy/paste (FIFO) like macOS Pastebot
# niri port: hyprctl has no niri equivalent, and synthesizing copy/paste
# keystrokes via wtype turned out unreliable (depends on the focused app
# binding Ctrl+Insert/Shift+Insert, which most don't) and could leave the
# system clipboard in a stale/empty state. Instead:
#   push  just grabs whatever is currently on the clipboard (copy normally
#         first, then push)
#   paste just puts the oldest queued item on the clipboard (then paste
#         normally yourself)
# The panel uses alacritty instead of ghostty: ghostty needs OpenGL 4.3,
# which isn't available on all hardware, and fails to open a window there.
# Usage: omarchy-seq-paste push|paste|clear|panel

QUEUE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-seq-paste-${UID}"
COUNTERFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-seq-paste-counter"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-seq-paste-panel.pid"
PANEL_TITLE="omarchy-seq-paste-panel"

next_id() {
  local n=0
  [[ -f "$COUNTERFILE" ]] && n=$(cat "$COUNTERFILE")
  n=$((n + 1))
  echo "$n" > "$COUNTERFILE"
  printf "%06d" "$n"
}

is_panel_open() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

open_panel() {
  if ! is_panel_open; then
    alacritty -T "$PANEL_TITLE" -e omarchy-seq-paste panel &
    echo $! > "$PIDFILE"
    disown
  fi
}

# Best-effort: ask niri for the window with our panel title and close it.
# Steals focus briefly (niri's close-window action only targets the
# focused window), then restores whatever was focused before.
close_panel_via_niri() {
  command -v niri >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0

  local prev_id panel_id
  prev_id=$(niri msg -j focused-window 2>/dev/null | jq -r '.id // empty')
  panel_id=$(niri msg -j windows 2>/dev/null | jq -r --arg t "$PANEL_TITLE" '.[] | select(.title == $t) | .id' | head -1)

  if [[ -n "$panel_id" ]]; then
    niri msg action focus-window --id "$panel_id" >/dev/null 2>&1
    niri msg action close-window >/dev/null 2>&1
    if [[ -n "$prev_id" && "$prev_id" != "$panel_id" ]]; then
      niri msg action focus-window --id "$prev_id" >/dev/null 2>&1
    fi
  fi
}

close_panel() {
  if [[ -f "$PIDFILE" ]]; then
    local pid
    pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null
    rm -f "$PIDFILE"
  fi
  close_panel_via_niri
}

push() {
  local content
  content=$(wl-paste 2>/dev/null)

  if [[ -z "$content" ]]; then
    notify-send -t 2000 "Seq Paste" "Clipboard is empty — copy something first"
    return 1
  fi

  mkdir -p "$QUEUE_DIR"
  echo -n "$content" > "$QUEUE_DIR/$(next_id)"
  open_panel
}

paste() {
  local oldest
  oldest=$(ls -1 "$QUEUE_DIR" 2>/dev/null | sort -n | head -1)

  if [[ -z "$oldest" ]]; then
    notify-send -t 2000 "Seq Paste" "Queue is empty"
    return 1
  fi

  wl-copy < "$QUEUE_DIR/$oldest"
  rm "$QUEUE_DIR/$oldest"

  local remaining
  remaining=$(ls -1 "$QUEUE_DIR" 2>/dev/null | wc -l)
  if [[ "$remaining" -eq 0 ]]; then
    close_panel
  fi
}

clear_queue() {
  rm -rf "$QUEUE_DIR"
  rm -f "$COUNTERFILE"
  close_panel
}

panel() {
  mkdir -p "$QUEUE_DIR"
  trap 'rm -f "$PIDFILE"; exit' EXIT INT TERM

  while true; do
    clear
    printf "\033[1m  SEQ PASTE\033[0m\n"
    echo "  ───────────"

    local files
    files=$(ls -1 "$QUEUE_DIR" 2>/dev/null | sort -n)

    if [[ -z "$files" ]]; then
      echo ""
      printf "  \033[2m(empty)\033[0m\n"
    else
      local i=1
      while IFS= read -r f; do
        local content
        content=$(tr '\n' ' ' < "$QUEUE_DIR/$f" | cut -c1-50)
        if [[ $(wc -c < "$QUEUE_DIR/$f") -gt 50 ]]; then
          content="${content}…"
        fi
        printf "  \033[36m%d.\033[0m %s\n" "$i" "$content"
        ((i++))
      done <<< "$files"
    fi

    echo ""
    printf "  \033[2mSuper+Shift+V to paste next · omarchy-seq-paste clear to empty\033[0m\n"

    inotifywait -qq -t 10 -e create,delete,moved_to "$QUEUE_DIR" 2>/dev/null
  done
}

case "${1:-}" in
  push)  push ;;
  paste) paste ;;
  clear) clear_queue ;;
  panel) panel ;;
  *)
    echo "Usage: omarchy-seq-paste {push|paste|clear|panel}"
    exit 1
    ;;
esac
