+        /// <summary>
+        /// Resolves a parameter name like PowerShell does: the name or an alias of a parameter, or else a
+        /// prefix of only one of them. Returns null if there's no such parameter.
+        /// </summary>
+        private static ParameterMetadata ResolveParameter(IEnumerable<ParameterMetadata> parameters, string name)
+        {
+            ParameterMetadata[] matches = parameters.Where(pm => string.Equals(pm.Name, name, StringComparison.OrdinalIgnoreCase)
+                || pm.Aliases.Contains(name, StringComparer.OrdinalIgnoreCase)).ToArray();
+            if (matches.Length == 0)
+            {
+                matches = parameters.Where(pm => pm.Name.StartsWith(name, StringComparison.OrdinalIgnoreCase)
+                    || pm.Aliases.Any(alias => alias.StartsWith(name, StringComparison.OrdinalIgnoreCase))).ToArray();
+            }
+
+            return matches.Length == 1 ? matches[0] : null;
+        }
