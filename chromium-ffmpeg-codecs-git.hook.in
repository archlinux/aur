[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = @OPERA@
Target = chromium-ffmpeg-codecs-git
Operation = Install

[Action]
When = PostTransaction
Exec = /usr/bin/bash -c 'rm /usr/lib/@OPERA@/libffmpeg.so 2>/dev/null && ln /usr/lib/libffmpeg.so /usr/lib/@OPERA@/libffmpeg.so || cp --reflink=auto /usr/lib/libffmpeg.so /usr/lib/@OPERA@/libffmpeg.so 2>/dev/null ||:'
