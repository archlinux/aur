+
+	if (client == NULL || address == NULL || size == NULL)
+		return -EINVAL;
+	if (client->local_addr.sa.sa_family == AF_INET)
+		required = sizeof(struct sockaddr_in);
+	else if (client->local_addr.sa.sa_family == AF_INET6)
