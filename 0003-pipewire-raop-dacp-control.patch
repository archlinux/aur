+static struct pw_raop_dacp_server *make_loopback_server(
+		struct pw_loop *loop, const char *token,
+		struct callback_state *state, uint32_t expected_peer)
+{
+	const struct sockaddr_in local =
+		loopback_address(INADDR_LOOPBACK, 0);
+	const struct sockaddr_in peer =
+		loopback_address(expected_peer, 0);
+	struct pw_raop_dacp_server *server;
+
+	server = pw_raop_dacp_server_new(loop,
+			(const struct sockaddr *)&local, sizeof(local),
+			(const struct sockaddr *)&peer, sizeof(peer),
+			token, on_command, NULL, state);
+	spa_assert_se(server != NULL);
+	spa_assert_se(pw_raop_dacp_server_get_port(server) != 0);
+	return server;
+}
