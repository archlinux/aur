+	fd = connect_client(pw_raop_dacp_server_get_port(server));
+	send_all(fd, valid, sizeof(valid) - 1);
+	spa_assert_se(collect_response(loop, fd, response,
+			sizeof(response)) > 0);
+	spa_assert_se(state.count == 1);
+	spa_assert_se(state.command == PW_RAOP_DACP_COMMAND_STOP);
+	spa_assert_se(server == NULL);
+	close(fd);
+
+	pw_loop_leave(loop);
+	pw_main_loop_destroy(main_loop);
+}
+
+int main(int argc, char *argv[])
+{
+	pw_init(&argc, &argv);
+	test_valid_commands();
+	test_authentication();
+	test_rejections();
+	test_size_boundaries();
+	test_listener_source_failure_closes_fd();
+	test_client_source_failure_closes_fd();
+	test_loopback();
+	test_mapped_ipv4_peer();
+	test_peer_rejection_and_partial_destroy();
+	test_callback_may_destroy_server();
+	pw_deinit();
+	return 0;
+}
