@@ -0,0 +1,674 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 PipeWire authors */
+/* SPDX-License-Identifier: MIT */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <spa/utils/defs.h>
+
+#include <pipewire/main-loop.h>
+#include <pipewire/pipewire.h>
+
+#include "dacp-server.h"
+
+static void test_valid_commands(void)
+{
+	static const struct {
+		const char *target;
+		enum pw_raop_dacp_command command;
+	} tests[] = {
+		{ "play", PW_RAOP_DACP_COMMAND_PLAY },
+		{ "pause", PW_RAOP_DACP_COMMAND_PAUSE },
+		{ "playpause", PW_RAOP_DACP_COMMAND_PLAY_PAUSE },
+		{ "playresume", PW_RAOP_DACP_COMMAND_PLAY_RESUME },
+		{ "stop", PW_RAOP_DACP_COMMAND_STOP },
+		{ "nextitem", PW_RAOP_DACP_COMMAND_NEXT },
+		{ "previtem", PW_RAOP_DACP_COMMAND_PREVIOUS },
+		{ "volumeup", PW_RAOP_DACP_COMMAND_VOLUME_UP },
+		{ "volumedown", PW_RAOP_DACP_COMMAND_VOLUME_DOWN },
+		{ "mutetoggle", PW_RAOP_DACP_COMMAND_MUTE_TOGGLE },
+		{ "setproperty?dmcp.volume=42",
+			PW_RAOP_DACP_COMMAND_SET_PROPERTY },
+		{ "setproperty?dmcp.device-volume=-8.7510",
+			PW_RAOP_DACP_COMMAND_SET_PROPERTY },
+		{ "setproperty?dmcp.device-volume=-144",
+			PW_RAOP_DACP_COMMAND_SET_PROPERTY },
+	};
+	const char token[] = "1234567890";
+	size_t i;
+
+	for (i = 0; i < SPA_N_ELEMENTS(tests); i++) {
+		struct pw_raop_dacp_request parsed;
+		char request[2048], expected[1024];
+		int size, res;
+
+		size = snprintf(request, sizeof(request),
+				"GET /ctrl-int/1/%s HTTP/1.1\r\n"
+				"Host: sender.local\r\n"
+				"Active-Remote: %s\r\n"
+				"\r\n",
+				tests[i].target, token);
+		spa_assert_se(size > 0 && (size_t)size < sizeof(request));
+		res = pw_raop_dacp_parse_request(request, (size_t)size,
+				token, &parsed);
+		spa_assert_se(res == 0);
+		spa_assert_se(parsed.command == tests[i].command);
+		size = snprintf(expected, sizeof(expected), "/ctrl-int/1/%s",
+				tests[i].target);
+		spa_assert_se(size > 0 && (size_t)size < sizeof(expected));
+		spa_assert_se(strcmp(parsed.target, expected) == 0);
+	}
+}
+
+static void test_authentication(void)
+{
+	static const char valid[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"active-remote:\t24680 \r\n"
+		"\r\n";
+	static const char invalid[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"Active-Remote: 24681\r\n"
+		"\r\n";
+	static const char missing[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"\r\n";
+	static const char duplicate[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"Active-Remote: 24680\r\n"
+		"Active-Remote: 24680\r\n"
+		"\r\n";
+	static const char wrong_first[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"Active-Remote: 14680\r\n\r\n";
+	static const char wrong_middle[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"Active-Remote: 24180\r\n\r\n";
+	static const char wrong_last[] =
+		"GET /ctrl-int/1/playpause HTTP/1.1\r\n"
+		"Active-Remote: 24681\r\n\r\n";
+	struct pw_raop_dacp_request parsed;
+
+	spa_assert_se(pw_raop_dacp_parse_request(valid, sizeof(valid) - 1,
+			"24680", &parsed) == 0);
+	spa_assert_se(pw_raop_dacp_parse_request(invalid, sizeof(invalid) - 1,
+			"24680", &parsed) == -EACCES);
