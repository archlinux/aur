+static void test_client_source_failure_closes_fd(void)
+{
+	struct callback_state state = { 0 };
+	struct pw_main_loop *main_loop;
+	struct pw_loop *real_loop, loop;
+	struct rejecting_loop rejecting;
+	struct pw_raop_dacp_server *server;
+	bool peer_closed = false;
+	unsigned int i;
+	int fd;
+
+	main_loop = pw_main_loop_new(NULL);
+	spa_assert_se(main_loop != NULL);
+	real_loop = pw_main_loop_get_loop(main_loop);
+	spa_assert_se(real_loop != NULL);
+	rejecting_loop_init(&rejecting, real_loop->utils, 2);
+	loop = *real_loop;
+	loop.utils = &rejecting.utils;
+	pw_loop_enter(real_loop);
+
+	server = make_loopback_server(&loop, "1", &state,
+			INADDR_LOOPBACK);
+	fd = connect_client(pw_raop_dacp_server_get_port(server));
+	for (i = 0; i < 100 && rejecting.add_io_calls < 2; i++)
+		spa_assert_se(pw_loop_iterate(real_loop, 10) >= 0);
+	spa_assert_se(rejecting.add_io_calls == 2);
+	spa_assert_se(rejecting.rejected_fd >= 0);
+	spa_assert_se(fcntl(rejecting.rejected_fd, F_GETFD) == -1);
+	spa_assert_se(errno == EBADF);
+
+	for (i = 0; i < 100 && !peer_closed; i++) {
+		char byte;
+		ssize_t size = recv(fd, &byte, sizeof(byte), MSG_DONTWAIT);
+
+		if (size == 0 ||
+		    (size < 0 && errno == ECONNRESET)) {
+			peer_closed = true;
+		} else if (size < 0) {
+			spa_assert_se(errno == EAGAIN || errno == EWOULDBLOCK);
+			spa_assert_se(pw_loop_iterate(real_loop, 10) >= 0);
+		} else {
+			spa_assert_not_reached();
+		}
+	}
+	spa_assert_se(peer_closed);
+	spa_assert_se(state.count == 0);
+
+	close(fd);
+	pw_raop_dacp_server_destroy(server);
+	pw_loop_leave(real_loop);
+	pw_main_loop_destroy(main_loop);
+}
