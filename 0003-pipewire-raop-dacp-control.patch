+static void dacp_session_stop(struct impl *impl)
+{
+#ifdef HAVE_AVAHI
+	if (impl->zeroconf != NULL)
+		pw_zeroconf_set_announce(impl->zeroconf, impl, NULL);
+#endif
+	pw_raop_dacp_server_destroy(impl->dacp_server);
+	impl->dacp_server = NULL;
+	if (impl->headers != NULL) {
+		const char *active_remote =
+			pw_properties_get(impl->headers, "Active-Remote");
+
+		if (active_remote != NULL)
+			explicit_bzero((char *)active_remote,
+					strlen(active_remote));
+		pw_properties_set(impl->headers, "Active-Remote", NULL);
+	}
+	explicit_bzero(impl->active_remote, sizeof(impl->active_remote));
+}
