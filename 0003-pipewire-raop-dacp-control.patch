+static struct spa_source *add_owned_io(struct pw_loop *loop, int fd,
+		uint32_t mask, spa_source_io_func_t func, void *data)
+{
+	struct spa_source *source;
+	int saved_errno;
+
+	source = pw_loop_add_io(loop, fd, mask, true, func, data);
+	if (source != NULL)
+		return source;
+	saved_errno = errno;
+	close(fd);
+	errno = saved_errno;
+	return NULL;
+}
+
+static const char *find_crlf(const char *data, size_t size)
+{
+	size_t i;
+
+	for (i = 0; i + 1 < size; i++) {
+		if (data[i] == '\r' && data[i + 1] == '\n')
+			return data + i;
+	}
+	return NULL;
+}
+
+static uint64_t get_monotonic_time(void)
+{
+	struct timespec now;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		return 0;
+	return (uint64_t)now.tv_sec * SPA_NSEC_PER_SEC + now.tv_nsec;
+}
+
+static bool token_equal(const char *received, size_t received_size,
+		const char *expected)
+{
+	const size_t expected_size = strlen(expected);
+
+	if (received_size != expected_size)
+		return false;
+	return CRYPTO_memcmp(received, expected, expected_size) == 0;
+}
+
+static int parse_command(const char *target, size_t target_size,
+		struct pw_raop_dacp_request *request)
+{
+	static const char prefix[] = "/ctrl-int/1/";
+	const char *name, *query;
+	size_t name_size;
+
+	if (target_size < sizeof(prefix) - 1 ||
+	    memcmp(target, prefix, sizeof(prefix) - 1) != 0)
+		return -ENOENT;
+
+	if (target_size >= sizeof(request->target))
+		return -E2BIG;
+	memcpy(request->target, target, target_size);
+	request->target[target_size] = '\0';
+
+	name = target + sizeof(prefix) - 1;
+	name_size = target_size - (sizeof(prefix) - 1);
+	query = memchr(name, '?', name_size);
+	if (query != NULL)
+		name_size = (size_t)(query - name);
+
+#define MATCH_COMMAND(value, result)					\
+	if (query == NULL && name_size == sizeof(value) - 1 &&		\
+	    memcmp(name, value, sizeof(value) - 1) == 0) {		\
+		request->command = result;				\
+		return 0;						\
+	}
+	MATCH_COMMAND("play", PW_RAOP_DACP_COMMAND_PLAY)
+	MATCH_COMMAND("pause", PW_RAOP_DACP_COMMAND_PAUSE)
+	MATCH_COMMAND("playpause", PW_RAOP_DACP_COMMAND_PLAY_PAUSE)
+	MATCH_COMMAND("playresume", PW_RAOP_DACP_COMMAND_PLAY_RESUME)
+	MATCH_COMMAND("stop", PW_RAOP_DACP_COMMAND_STOP)
+	MATCH_COMMAND("nextitem", PW_RAOP_DACP_COMMAND_NEXT)
+	MATCH_COMMAND("previtem", PW_RAOP_DACP_COMMAND_PREVIOUS)
+	MATCH_COMMAND("volumeup", PW_RAOP_DACP_COMMAND_VOLUME_UP)
+	MATCH_COMMAND("volumedown", PW_RAOP_DACP_COMMAND_VOLUME_DOWN)
+	MATCH_COMMAND("mutetoggle", PW_RAOP_DACP_COMMAND_MUTE_TOGGLE)
+#undef MATCH_COMMAND
+
+	if (name_size == sizeof("setproperty") - 1 &&
+	    memcmp(name, "setproperty", name_size) == 0 && query != NULL) {
+		static const char *const keys[] = {
+			"dmcp.volume=",
+			"dmcp.device-volume=",
+		};
+		const char *value = NULL, *end = target + target_size, *p;
+		char number_string[33];
+		bool have_digit = false, have_dot = false;
+		double number;
+		size_t i;
+
+		for (i = 0; i < SPA_N_ELEMENTS(keys); i++) {
+			const size_t key_size = strlen(keys[i]);
+
+			if ((size_t)(end - (query + 1)) > key_size &&
+			    memcmp(query + 1, keys[i], key_size) == 0) {
+				value = query + 1 + key_size;
+				break;
+			}
+		}
+		if (value == NULL || (size_t)(end - value) > 32)
+			return -ENOENT;
+		for (p = value; p < end; p++) {
+			if (isdigit((unsigned char)*p)) {
+				have_digit = true;
+			} else if (*p == '.' && !have_dot) {
+				have_dot = true;
+			} else if ((*p == '-' || *p == '+') && p == value) {
+				continue;
+			} else {
+				return -EINVAL;
+			}
+		}
+		if (!have_digit)
+			return -EINVAL;
+		memcpy(number_string, value, (size_t)(end - value));
+		number_string[end - value] = '\0';
+		if (!spa_atod(number_string, &number) || !isfinite(number))
+			return -EINVAL;
+		if ((i == 0 && (number < 0.0 || number > 100.0)) ||
+		    (i == 1 && !((number >= -30.0 && number <= 0.0) ||
+				 number == -144.0)))
+			return -ERANGE;
+		request->command = PW_RAOP_DACP_COMMAND_SET_PROPERTY;
+		return 0;
+	}
+
+	return -ENOENT;
+}
+
+int pw_raop_dacp_parse_request(const void *data, size_t size,
+		const char *active_remote,
+		struct pw_raop_dacp_request *request)
+{
+	const char *input = data, *end, *line_end, *cursor;
+	const char *method_end, *target, *target_end, *version;
+	const char *token = NULL;
+	size_t token_size = 0;
+	bool have_token = false, have_end = false;
+
+	if (input == NULL || active_remote == NULL || active_remote[0] == '\0' ||
+	    request == NULL || size == 0 || size > MAX_REQUEST_SIZE)
+		return -EINVAL;
+	if (memchr(input, '\0', size) != NULL)
+		return -EINVAL;
+
+	end = input + size;
+	line_end = find_crlf(input, size);
+	if (line_end == NULL)
+		return -EINVAL;
+
+	method_end = memchr(input, ' ', (size_t)(line_end - input));
+	if (method_end == NULL)
+		return -EINVAL;
+	if ((size_t)(method_end - input) != 3 || memcmp(input, "GET", 3) != 0)
+		return -EPROTONOSUPPORT;
+
+	target = method_end + 1;
+	target_end = memchr(target, ' ', (size_t)(line_end - target));
+	if (target_end == NULL || target_end == target)
+		return -EINVAL;
+	for (cursor = target; cursor < target_end; cursor++) {
+		const unsigned char c = (unsigned char)*cursor;
+		if (c <= 0x20 || c == 0x7f)
+			return -EINVAL;
+	}
+	version = target_end + 1;
+	if (!((size_t)(line_end - version) == 8 &&
+	      (memcmp(version, "HTTP/1.1", 8) == 0 ||
+	       memcmp(version, "HTTP/1.0", 8) == 0)))
+		return -EINVAL;
+
+	cursor = line_end + 2;
+	while (cursor < end) {
+		const char *colon, *value, *value_end;
+
+		line_end = find_crlf(cursor, (size_t)(end - cursor));
+		if (line_end == NULL)
+			return -EINVAL;
+		if (line_end == cursor) {
+			have_end = true;
+			break;
+		}
+
+		colon = memchr(cursor, ':', (size_t)(line_end - cursor));
+		if (colon == NULL || colon == cursor)
+			return -EINVAL;
+		value = colon + 1;
+		while (value < line_end && (*value == ' ' || *value == '\t'))
+			value++;
+		value_end = line_end;
+		while (value_end > value &&
+		       (value_end[-1] == ' ' || value_end[-1] == '\t'))
+			value_end--;
+
+		if ((size_t)(colon - cursor) == strlen("Active-Remote") &&
+		    strncasecmp(cursor, "Active-Remote",
+			    strlen("Active-Remote")) == 0) {
+			if (have_token)
+				return -EINVAL;
+			token = value;
+			token_size = (size_t)(value_end - value);
+			have_token = true;
+		}
+		cursor = line_end + 2;
+	}
+	if (!have_end)
+		return -EINVAL;
+	if (!have_token || !token_equal(token, token_size, active_remote))
+		return -EACCES;
+
+	return parse_command(target, (size_t)(target_end - target), request);
+}
+
+const char *pw_raop_dacp_command_as_string(enum pw_raop_dacp_command command)
+{
+	switch (command) {
+	case PW_RAOP_DACP_COMMAND_PLAY:
+		return "play";
+	case PW_RAOP_DACP_COMMAND_PAUSE:
+		return "pause";
+	case PW_RAOP_DACP_COMMAND_PLAY_PAUSE:
+		return "play-pause";
+	case PW_RAOP_DACP_COMMAND_PLAY_RESUME:
+		return "play-resume";
+	case PW_RAOP_DACP_COMMAND_STOP:
+		return "stop";
+	case PW_RAOP_DACP_COMMAND_NEXT:
+		return "next";
+	case PW_RAOP_DACP_COMMAND_PREVIOUS:
+		return "previous";
+	case PW_RAOP_DACP_COMMAND_VOLUME_UP:
+		return "volume-up";
+	case PW_RAOP_DACP_COMMAND_VOLUME_DOWN:
+		return "volume-down";
+	case PW_RAOP_DACP_COMMAND_MUTE_TOGGLE:
+		return "mute-toggle";
+	case PW_RAOP_DACP_COMMAND_SET_PROPERTY:
+		return "set-property";
+	default:
+		return "unknown";
+	}
+}
+
+static void client_free(struct client *client)
+{
+	struct pw_raop_dacp_server *server = client->server;
+
+	if (client->source != NULL)
+		pw_loop_destroy_source(server->loop, client->source);
+	spa_list_remove(&client->link);
+	server->n_clients--;
+	if (server->n_clients == 0 && server->timer != NULL)
+		pw_loop_update_timer(server->loop, server->timer,
+				NULL, NULL, false);
+	explicit_bzero(client->request, sizeof(client->request));
+	free(client);
+}
+
+static void client_finish(struct client *client)
+{
+	struct pw_raop_dacp_server *server = client->server;
+	struct pw_raop_dacp_request request = client->command;
+	const bool have_command = client->have_command;
+
+	client_free(client);
+
+	/* The callback may synchronously destroy the server. Keep this as the
+	 * final operation and do not touch server afterwards. */
+	if (have_command && server->command != NULL)
+		server->command(server->data, &request);
+}
+
+static void client_queue_response(struct client *client, unsigned int status,
+		const char *reason)
+{
+	int size;
+
+	size = snprintf(client->response, sizeof(client->response),
+			"HTTP/1.1 %u %s\r\n"
+			"Content-Length: 0\r\n"
+			"Connection: close\r\n"
+			"\r\n",
+			status, reason);
+	client->response_size = SPA_MIN((size_t)SPA_MAX(size, 0),
+			sizeof(client->response));
+	client->response_offset = 0;
+	pw_loop_update_io(client->server->loop, client->source,
+			SPA_IO_OUT | SPA_IO_ERR | SPA_IO_HUP);
+}
+
+static void client_handle_request(struct client *client)
+{
+	struct pw_raop_dacp_server *server = client->server;
+	struct pw_raop_dacp_request request;
+	int res;
+
+	res = pw_raop_dacp_parse_request(client->request, client->request_size,
+			server->active_remote, &request);
+	if (res == 0) {
+		pw_log_info("received authenticated DACP command %s",
+				pw_raop_dacp_command_as_string(request.command));
+		client->command = request;
+		client->have_command = true;
+		client_queue_response(client, 204, "No Content");
+	} else if (res == -EACCES) {
+		pw_log_warn("rejected DACP request with invalid credentials");
+		client_queue_response(client, 403, "Forbidden");
+	} else if (res == -ENOENT) {
+		client_queue_response(client, 404, "Not Found");
+	} else if (res == -EPROTONOSUPPORT) {
+		client_queue_response(client, 405, "Method Not Allowed");
+	} else if (res == -E2BIG) {
+		client_queue_response(client, 431, "Request Header Fields Too Large");
+	} else {
+		client_queue_response(client, 400, "Bad Request");
+	}
+}
+
+static void on_client_io(void *data, int fd, uint32_t mask)
+{
+	struct client *client = data;
+	ssize_t size;
+
+	if (mask & SPA_IO_ERR)
+		goto close;
+
+	if ((mask & (SPA_IO_IN | SPA_IO_HUP)) &&
+	    client->response_size == 0) {
+		while (client->request_size < MAX_REQUEST_SIZE) {
+			size = recv(fd, client->request + client->request_size,
+					MAX_REQUEST_SIZE - client->request_size, 0);
+			if (size > 0) {
+				client->request_size += (size_t)size;
+				client->request[client->request_size] = '\0';
+				if (strstr(client->request, "\r\n\r\n") != NULL) {
+					client_handle_request(client);
+					break;
+				}
+				continue;
+			}
+			if (size == 0)
+				goto close;
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				break;
+			goto close;
+		}
+		if (client->request_size == MAX_REQUEST_SIZE &&
+		    client->response_size == 0)
+			client_queue_response(client, 431,
+					"Request Header Fields Too Large");
+	}
+	if ((mask & (SPA_IO_OUT | SPA_IO_HUP)) &&
+	    client->response_size > 0) {
+		size = send(fd, client->response + client->response_offset,
+				client->response_size - client->response_offset,
+				MSG_NOSIGNAL);
+		if (size > 0) {
+			client->response_offset += (size_t)size;
+			if (client->response_offset == client->response_size)
+				goto finish;
+		} else if (size < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+			goto finish;
+		}
+	}
+	return;
+
+finish:
+	client_finish(client);
+	return;
+close:
+	if (client->have_command)
+		client_finish(client);
+	else
+		client_free(client);
+}
+
+static void on_connect(void *data, int fd, uint32_t mask)
+{
+	struct pw_raop_dacp_server *server = data;
+	struct sockaddr_storage addr;
+	socklen_t addr_size;
+	int client_fd;
+
+	if (mask & (SPA_IO_ERR | SPA_IO_HUP)) {
+		pw_raop_dacp_error_func_t error = server->error;
+		void *error_data = server->data;
+
+		pw_log_error("DACP listener failed with I/O mask 0x%x", mask);
+		pw_loop_destroy_source(server->loop, server->source);
+		server->source = NULL;
+		server->port = 0;
+		if (error != NULL)
+			error(error_data, -EIO);
+		return;
+	}
+
+	for (;;) {
+		struct client *client;
+
+		addr_size = sizeof(addr);
+		client_fd = accept4(fd, (struct sockaddr *)&addr, &addr_size,
+				SOCK_NONBLOCK | SOCK_CLOEXEC);
+		if (client_fd < 0) {
+			pw_raop_dacp_error_func_t error;
+			void *error_data;
+			int res;
+
+			if (errno == EINTR)
+				continue;
+			if (errno == EAGAIN || errno == EWOULDBLOCK)
+				return;
+
+			res = -errno;
+			pw_log_error("DACP accept failed: %m");
+			error = server->error;
+			error_data = server->data;
+			pw_loop_destroy_source(server->loop, server->source);
+			server->source = NULL;
+			server->port = 0;
+			if (error != NULL)
+				error(error_data, res);
+			return;
+		}
+		if (server->n_clients >= MAX_CLIENTS ||
+		    !pw_net_are_addresses_equal(&server->peer_addr, &addr, false)) {
+			close(client_fd);
+			continue;
+		}
+		client = calloc(1, sizeof(*client));
+		if (client == NULL) {
+			close(client_fd);
+			continue;
+		}
+		client->server = server;
+		client->deadline = get_monotonic_time() +
+				CLIENT_TIMEOUT_SEC * SPA_NSEC_PER_SEC;
+		spa_list_append(&server->clients, &client->link);
+		server->n_clients++;
+		if (server->n_clients == 1) {
+			struct timespec value = {
+				.tv_sec = 1,
+				.tv_nsec = 0,
+			};
+			struct timespec interval = value;
+
+			pw_loop_update_timer(server->loop, server->timer,
+					&value, &interval, false);
+		}
+		client->source = add_owned_io(server->loop, client_fd,
+				SPA_IO_IN | SPA_IO_ERR | SPA_IO_HUP,
+				on_client_io, client);
+		if (client->source == NULL) {
+			client->source = NULL;
+			client_free(client);
+		}
+	}
+}
+
+static void on_timeout(void *data, uint64_t expirations)
+{
+	struct pw_raop_dacp_server *server = data;
+	struct client *client, *tmp;
+	const uint64_t now = get_monotonic_time();
+
+	spa_list_for_each_safe(client, tmp, &server->clients, link) {
+		/* A command is committed only after its HTTP response has been
+		 * written, or when the authenticated peer closes the connection.
+		 * A timeout means the exchange never completed; discard it instead
+		 * of executing a potentially stale command several seconds later. */
+		if (client->deadline <= now)
+			client_free(client);
+	}
+}
+
+static bool address_is_valid(const struct sockaddr *addr, socklen_t size)
+{
+	if (addr == NULL)
+		return false;
+	if (addr->sa_family == AF_INET)
+		return size == sizeof(struct sockaddr_in);
+	if (addr->sa_family == AF_INET6)
+		return size == sizeof(struct sockaddr_in6);
+	return false;
+}
+
+static int make_server_socket(const struct sockaddr *bind_addr,
+		socklen_t bind_addr_size, uint16_t *port)
+{
+	struct sockaddr_storage addr;
+	socklen_t addr_size;
+	int fd, enabled = 1, res;
+
+	if (bind_addr_size > sizeof(addr) ||
+	    !address_is_valid(bind_addr, bind_addr_size))
+		return -EINVAL;
+
+	spa_zero(addr);
+	memcpy(&addr, bind_addr, bind_addr_size);
+	if (addr.ss_family == AF_INET)
+		((struct sockaddr_in *)&addr)->sin_port = 0;
+	else
+		((struct sockaddr_in6 *)&addr)->sin6_port = 0;
+
+	fd = socket(addr.ss_family,
+			SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (fd < 0)
+		return -errno;
+	if (setsockopt(fd, SOL_SOCKET, SO_REUSEADDR,
+			&enabled, sizeof(enabled)) < 0)
+		pw_log_warn("DACP SO_REUSEADDR failed: %m");
+
+	if (bind(fd, (struct sockaddr *)&addr, bind_addr_size) < 0 ||
+	    listen(fd, MAX_CLIENTS) < 0) {
+		int res = -errno;
+		close(fd);
+		return res;
+	}
+	addr_size = sizeof(addr);
+	if (getsockname(fd, (struct sockaddr *)&addr, &addr_size) < 0) {
+		int res = -errno;
+		close(fd);
+		return res;
+	}
+	if ((res = pw_net_get_ip(&addr, NULL, 0, NULL, port)) < 0) {
+		close(fd);
+		return res;
+	}
+	return fd;
+}
+
+struct pw_raop_dacp_server *pw_raop_dacp_server_new(
+		struct pw_loop *loop,
+		const struct sockaddr *bind_addr,
+		socklen_t bind_addr_size,
+		const struct sockaddr *peer_addr,
+		socklen_t peer_addr_size,
+		const char *active_remote,
+		pw_raop_dacp_command_func_t command,
+		pw_raop_dacp_error_func_t error,
+		void *data)
+{
+	struct pw_raop_dacp_server *server;
+	char bind_ip[INET6_ADDRSTRLEN + IF_NAMESIZE + 1];
+	char peer_ip[INET6_ADDRSTRLEN + IF_NAMESIZE + 1];
+	int fd, res;
+
+	if (loop == NULL ||
+	    bind_addr_size > sizeof(struct sockaddr_storage) ||
+	    peer_addr_size > sizeof(struct sockaddr_storage) ||
+	    !address_is_valid(bind_addr, bind_addr_size) ||
+	    !address_is_valid(peer_addr, peer_addr_size) ||
+	    active_remote == NULL || active_remote[0] == '\0') {
+		errno = EINVAL;
+		return NULL;
+	}
+	server = calloc(1, sizeof(*server));
+	if (server == NULL)
+		return NULL;
+	server->loop = loop;
+	server->command = command;
+	server->error = error;
+	server->data = data;
+	spa_list_init(&server->clients);
+
+	memcpy(&server->peer_addr, peer_addr, peer_addr_size);
+	if ((server->active_remote = strdup(active_remote)) == NULL) {
+		res = -errno;
+		goto error;
+	}
+	if ((fd = make_server_socket(bind_addr, bind_addr_size,
+			&server->port)) < 0) {
+		res = fd;
+		goto error;
+	}
+	server->source = add_owned_io(loop, fd,
+			SPA_IO_IN | SPA_IO_ERR | SPA_IO_HUP,
+			on_connect, server);
+	if (server->source == NULL) {
+		res = -errno;
+		goto error;
+	}
+	server->timer = pw_loop_add_timer(loop, on_timeout, server);
+	if (server->timer == NULL) {
+		res = -errno;
+		goto error;
+	}
+
+	if (pw_net_get_ip((struct sockaddr_storage *)bind_addr,
+			bind_ip, sizeof(bind_ip), NULL, NULL) < 0)
+		spa_scnprintf(bind_ip, sizeof(bind_ip), "<unknown>");
+	if (pw_net_get_ip(&server->peer_addr,
+			peer_ip, sizeof(peer_ip), NULL, NULL) < 0)
+		spa_scnprintf(peer_ip, sizeof(peer_ip), "<unknown>");
+	pw_log_info("DACP server listening on %s port %u for RAOP peer %s",
+			bind_ip, server->port, peer_ip);
+	return server;
+
+error:
+	pw_raop_dacp_server_destroy(server);
+	errno = -res;
+	return NULL;
+}
+
+void pw_raop_dacp_server_destroy(struct pw_raop_dacp_server *server)
+{
+	struct client *client;
+
+	if (server == NULL)
+		return;
+	spa_list_consume(client, &server->clients, link)
+		client_free(client);
+	if (server->timer != NULL)
+		pw_loop_destroy_source(server->loop, server->timer);
+	if (server->source != NULL)
+		pw_loop_destroy_source(server->loop, server->source);
+	if (server->active_remote != NULL) {
+		explicit_bzero(server->active_remote,
+				strlen(server->active_remote));
+		free(server->active_remote);
+	}
+	free(server);
+}
+
+uint16_t pw_raop_dacp_server_get_port(
+		const struct pw_raop_dacp_server *server)
+{
+	return server == NULL ? 0 : server->port;
+}
