+struct callback_state {
+	unsigned int count;
+	enum pw_raop_dacp_command command;
+	struct pw_raop_dacp_server **destroy_server;
+};
+
+static void on_command(void *data,
+		const struct pw_raop_dacp_request *request)
+{
+	struct callback_state *state = data;
+
+	state->count++;
+	state->command = request->command;
+	if (state->destroy_server != NULL &&
+	    *state->destroy_server != NULL) {
+		pw_raop_dacp_server_destroy(*state->destroy_server);
+		*state->destroy_server = NULL;
+	}
+}
+
+static struct sockaddr_in loopback_address(uint32_t address, uint16_t port)
+{
+	struct sockaddr_in result = {
+		.sin_family = AF_INET,
+		.sin_port = htons(port),
+		.sin_addr = { .s_addr = htonl(address) },
+	};
+
+	return result;
+}
+
+static int connect_client(uint16_t port)
+{
+	const struct sockaddr_in address =
+		loopback_address(INADDR_LOOPBACK, port);
+	int fd;
+
+	fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	spa_assert_se(fd >= 0);
+	spa_assert_se(connect(fd, (const struct sockaddr *)&address,
+			sizeof(address)) == 0);
+	spa_assert_se(fcntl(fd, F_SETFL,
+			fcntl(fd, F_GETFL, 0) | O_NONBLOCK) == 0);
+	return fd;
+}
+
+struct rejecting_loop {
+	struct spa_loop_utils utils;
+	struct spa_loop_utils *delegate;
+	unsigned int add_io_calls;
+	unsigned int reject_call;
+	int rejected_fd;
+};
+
+static struct spa_source *rejecting_add_io(void *data, int fd,
+		uint32_t mask, bool close_fd, spa_source_io_func_t func,
+		void *user_data)
+{
+	struct rejecting_loop *state = data;
+
+	state->add_io_calls++;
+	if (state->add_io_calls == state->reject_call) {
+		state->rejected_fd = fd;
+		errno = ENOMEM;
+		return NULL;
+	}
+	return spa_loop_utils_add_io(state->delegate, fd, mask, close_fd,
+			func, user_data);
+}
+
+static int rejecting_update_io(void *data, struct spa_source *source,
+		uint32_t mask)
+{
+	struct rejecting_loop *state = data;
+
+	return spa_loop_utils_update_io(state->delegate, source, mask);
+}
+
+static struct spa_source *rejecting_add_timer(void *data,
+		spa_source_timer_func_t func, void *user_data)
+{
+	struct rejecting_loop *state = data;
+
+	return spa_loop_utils_add_timer(state->delegate, func, user_data);
+}
+
+static int rejecting_update_timer(void *data, struct spa_source *source,
+		struct timespec *value, struct timespec *interval, bool absolute)
+{
+	struct rejecting_loop *state = data;
+
+	return spa_loop_utils_update_timer(state->delegate, source,
+			value, interval, absolute);
+}
+
+static void rejecting_destroy_source(void *data, struct spa_source *source)
+{
+	struct rejecting_loop *state = data;
+
+	spa_loop_utils_destroy_source(state->delegate, source);
+}
+
+static const struct spa_loop_utils_methods rejecting_loop_methods = {
+	SPA_VERSION_LOOP_UTILS_METHODS,
+	.add_io = rejecting_add_io,
+	.update_io = rejecting_update_io,
+	.add_timer = rejecting_add_timer,
+	.update_timer = rejecting_update_timer,
+	.destroy_source = rejecting_destroy_source,
+};
+
+static void rejecting_loop_init(struct rejecting_loop *state,
+		struct spa_loop_utils *delegate, unsigned int reject_call)
+{
+	*state = (struct rejecting_loop) {
+		.delegate = delegate,
+		.reject_call = reject_call,
+		.rejected_fd = -1,
+	};
+	state->utils.iface = SPA_INTERFACE_INIT(
+			SPA_TYPE_INTERFACE_LoopUtils, 0,
+			&rejecting_loop_methods, state);
+}
+
+static size_t collect_response(struct pw_loop *loop, int fd,
+		char *response, size_t capacity)
+{
+	size_t offset = 0;
+	unsigned int i;
+
+	for (i = 0; i < 100 && offset + 1 < capacity; i++) {
+		ssize_t size;
+
+		spa_assert_se(pw_loop_iterate(loop, 10) >= 0);
+		size = recv(fd, response + offset, capacity - offset - 1,
+				MSG_DONTWAIT);
+		if (size > 0) {
+			offset += (size_t)size;
+			response[offset] = '\0';
+			if (strstr(response, "\r\n\r\n") != NULL)
+				break;
+		} else if (size == 0) {
+			break;
+		} else {
+			spa_assert_se(errno == EAGAIN || errno == EWOULDBLOCK);
+		}
+	}
+	response[offset] = '\0';
+	return offset;
+}
+
+static void send_all(int fd, const void *data, size_t size)
+{
+	const unsigned char *cursor = data;
+
+	while (size > 0) {
+		ssize_t written = send(fd, cursor, size, MSG_NOSIGNAL);
+
+		spa_assert_se(written > 0);
+		cursor += written;
+		size -= (size_t)written;
+	}
+}
