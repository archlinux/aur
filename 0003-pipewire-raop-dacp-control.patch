+static void rtsp_session_timeout(void *data)
+{
+	struct impl *impl = data;
+
+	if (impl->destroying)
+		return;
+	pw_log_warn("RAOP session transition timed out; reconnecting");
+	/*
+	 * disconnect() normally emits the callback that performs cleanup and
+	 * schedules retry. Repeat both operations afterwards as an idempotent
+	 * fallback for an already-closed RTSP source.
+	 */
+	pw_rtsp_client_disconnect(impl->rtsp);
+	impl->connected = false;
+	impl->connecting = false;
+	connection_cleanup(impl);
+	schedule_rtsp_reconnect(impl);
+}
+
+static void arm_rtsp_session_timeout(struct impl *impl)
+{
+	int res;
+
+	pw_timer_queue_cancel(&impl->session_timeout_timer);
+	res = pw_timer_queue_add(impl->timer_queue,
+			&impl->session_timeout_timer, NULL,
+			RTSP_SESSION_TIMEOUT_SEC * SPA_NSEC_PER_SEC,
+			rtsp_session_timeout, impl);
+	if (res < 0)
+		pw_log_warn("can't arm RAOP session timeout: %s",
+				spa_strerror(res));
+}
