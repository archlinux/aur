+static void rtsp_reconnect_timeout(void *data)
+{
+	struct impl *impl = data;
+
+	if (impl->destroying || !impl->want_stream)
+		return;
+	if (impl->reconnect_attempts < UINT32_MAX)
+		impl->reconnect_attempts++;
+	if (rtsp_do_connect(impl) < 0)
+		schedule_rtsp_reconnect(impl);
