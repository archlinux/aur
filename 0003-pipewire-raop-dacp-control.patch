+static int dacp_session_start(struct impl *impl)
+{
+#ifdef HAVE_AVAHI
+	struct sockaddr_storage local_addr, peer_addr;
+	socklen_t local_size = sizeof(local_addr);
+	socklen_t peer_size = sizeof(peer_addr);
+	struct pw_properties *announce;
+	const char *ifindex;
+	char name[sizeof("iTunes_Ctrl_") + sizeof(impl->dacp_id)];
+	char port[6];
+	uint32_t token;
+	int res;
+
+	if (!impl->dacp_enabled)
+		return 0;
+	if (impl->dacp_server != NULL)
+		return 0;
+	if (impl->zeroconf == NULL)
+		return -ENOTSUP;
+
+	if ((res = pw_rtsp_client_get_local_address(impl->rtsp,
+			&local_addr, &local_size)) < 0 ||
+	    (res = pw_rtsp_client_get_peer_address(impl->rtsp,
+			&peer_addr, &peer_size)) < 0)
+		return res;
+	if ((res = pw_getrandom(&token, sizeof(token), 0)) < 0)
+		return res;
+	if (token == 0)
+		token = 1;
+	spa_scnprintf(impl->active_remote, sizeof(impl->active_remote),
+			"%" PRIu32, token);
+
+	impl->dacp_server = pw_raop_dacp_server_new(impl->loop,
+			(const struct sockaddr *)&local_addr, local_size,
+			(const struct sockaddr *)&peer_addr, peer_size,
+			impl->active_remote, dacp_command,
+			dacp_server_error, impl);
+	if (impl->dacp_server == NULL) {
+		res = -errno;
+		goto error;
+	}
+
+	spa_scnprintf(name, sizeof(name), "iTunes_Ctrl_%s", impl->dacp_id);
+	spa_scnprintf(port, sizeof(port), "%u",
+			pw_raop_dacp_server_get_port(impl->dacp_server));
+	announce = pw_properties_new(
+			PW_KEY_ZEROCONF_NAME, name,
+			PW_KEY_ZEROCONF_TYPE, "_dacp._tcp",
+			PW_KEY_ZEROCONF_PROTO,
+				local_addr.ss_family == AF_INET ? "4" : "6",
+			PW_KEY_ZEROCONF_PORT, port,
+			"txtvers", "1",
+			"Ver", "131075",
+			"DbId", "63B5E5C0C201542E",
+			"OSsi", "0x1F5",
+			NULL);
+	if (announce == NULL) {
+		res = -errno;
+		goto error;
+	}
+	ifindex = pw_properties_get(impl->props, "raop.ifindex");
+	if (ifindex != NULL)
+		pw_properties_set(announce, PW_KEY_ZEROCONF_IFINDEX, ifindex);
+	res = pw_zeroconf_set_announce(impl->zeroconf, impl,
+			&announce->dict);
+	pw_properties_free(announce);
+	if (res < 0)
+		goto error;
+
+	pw_properties_set(impl->headers, "Active-Remote",
+			impl->active_remote);
+	pw_log_info("announced DACP service %s on port %s", name, port);
+	return 0;
+
+error:
+	dacp_session_stop(impl);
+	return res;
+#else
+	return impl->dacp_enabled ? -ENOTSUP : 0;
+#endif
+}
