From 8be0e0876f2dbb0d82153bd8fa731601c3f64ca5 Mon Sep 17 00:00:00 2001
From: Andrii Skliar <andrew.skliar@gmail.com>
Date: Fri, 13 Feb 2026 12:43:11 +0100
Subject: [PATCH] add support for newer CUDA archs (Spark/Thor)

Signed-off-by: Andrii Skliar <andrew.skliar@gmail.com>
Co-Authored-By: Claude Sonnet 4.5 <noreply@anthropic.com>
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 88c334bf41f..169864f4214 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -137,7 +137,7 @@ if (FA2_ENABLED)
 
     # For CUDA we set the architectures on a per file basis
     if (VLLM_GPU_LANG STREQUAL "CUDA")
-        cuda_archs_loose_intersection(FA2_ARCHS "8.0+PTX" "${CUDA_ARCHS}")
+        cuda_archs_loose_intersection(FA2_ARCHS "8.0;9.0a;10.0f;11.0a;12.0f+PTX" "${CUDA_ARCHS}")
         message(STATUS "FA2_ARCHS: ${FA2_ARCHS}")
 
         set_gencode_flags_for_srcs(
