# STG-1.6: Lumalarm no longer installs — and actively removes — any sudoers
# rule. Wake scheduling runs through the D-Bus helper + the polkit action
# org.lumalarm.schedule.wake; there is no passwordless sudo path left.
#
# Only Lumalarm's own file is ever touched. Pre-STG-1 packages shipped
# `%wheel ALL=(ALL) NOPASSWD: /usr/bin/rtcwake` at this exact path, so the
# upgrade path has to be able to take it back out.

_remove_legacy_sudoers() {
    if [ -e /etc/sudoers.d/lumalarm ]; then
        rm -f /etc/sudoers.d/lumalarm
        echo "Removed the obsolete Lumalarm rtcwake sudoers rule."
    fi
}

post_install() {
    _remove_legacy_sudoers
    systemctl daemon-reload
    echo "Lumalarm wake helper registered. No sudoers setup needed."
}

post_upgrade() {
    post_install
}

pre_remove() {
    _remove_legacy_sudoers
    systemctl stop lumalarm-wake-helper.service 2>/dev/null || true
    systemctl daemon-reload
    echo "Lumalarm wake helper removed."
}
