# Pacman owns files; the upstream configurator owns only its marked UFW blocks.
post_install() {
  python /usr/share/waycast/networkd/install.py --configure-only || {
    echo "Waycast networking setup failed. Fix the reported error, then run:"
    echo "sudo python /usr/share/waycast/networkd/install.py --configure-only"
    return 1
  }
}

pre_upgrade() {
  # Prevent D-Bus activation while pacman replaces the helper and its policies.
  systemctl mask --runtime waycast-networkd.service &&
    systemctl stop waycast-networkd.service
}

post_upgrade() {
  post_install
}

pre_remove() {
  python /usr/share/waycast/networkd/install.py --configure-only --uninstall &&
    systemctl mask --runtime waycast-networkd.service
}

post_remove() {
  systemctl daemon-reload
  systemctl reload dbus.service
  systemctl unmask --runtime waycast-networkd.service
}
