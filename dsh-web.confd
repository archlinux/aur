# /etc/conf.d/dsh-web — overrides for dsh-web.service
# Uncomment to change. The service starts with:
#   dsh --profile web --no-open --host $DSH_WEB_HOST --port $DSH_WEB_PORT
# Anything here wins over the unit defaults (EnvironmentFile is read last).

# Bind address: a concrete local interface address; wildcards are rejected by dsh.
#DSH_WEB_HOST=127.0.0.1

# Listen port (dsh default 3080).
#DSH_WEB_PORT=3080

# Root of the app state; defaults to $HOME/.dsh = /var/lib/dshweb/.dsh
#DSH_HOME=/var/lib/dshweb/.dsh

# Opt out of telemetry.
#DSH_TELEMETRY_DISABLED=1
