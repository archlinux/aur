pre_upgrade()
{
  echo "=== PRE-UPGRADE ==="
  systemctl stop wazuh-dashboard 2>/dev/null || true
  cp /etc/wazuh-dashboard/opensearch_dashboards.yml /etc/wazuh-dashboard/opensearch_dashboards.yml.rpmsave 2>/dev/null || true
}

post_upgrade()
{
  echo "=== POST-UPGRADE ==="

  # Restore previous config
  if [ -f /etc/wazuh-dashboard/opensearch_dashboards.yml.rpmsave ]; then
    cp /etc/wazuh-dashboard/opensearch_dashboards.yml /etc/wazuh-dashboard/opensearch_dashboards.yml.rpmnew
    cp /etc/wazuh-dashboard/opensearch_dashboards.yml.rpmsave /etc/wazuh-dashboard/opensearch_dashboards.yml
    echo "Previous config restored. New config saved as opensearch_dashboards.yml.rpmnew"
  fi

  # Recrea el keystore solo si falta (no pisa credenciales existentes)
  _setup_keystore

  # Reapply permissions
  _set_permissions

  # Reapply setcap for privileged ports
  _set_capabilities

  systemctl daemon-reload
  systemctl start wazuh-dashboard
}

post_install()
{
  echo "=== POST-INSTALL ==="

  # Create user and group
  echo "Creating wazuh-dashboard user and group..."
  groupadd -f wazuh-dashboard
  id "wazuh-dashboard" &>/dev/null || useradd --system -d /usr/share/wazuh-dashboard -g wazuh-dashboard -s /usr/bin/nologin wazuh-dashboard

  # Create required directories
  echo "Creating required directories..."
  mkdir -p /usr/share/wazuh-dashboard/data/wazuh/downloads
  mkdir -p /usr/share/wazuh-dashboard/data/wazuh/config
  mkdir -p /usr/share/wazuh-dashboard/data/wazuh/logs
  mkdir -p /etc/wazuh-dashboard/certs
  mkdir -p /var/log/wazuh-dashboard
  mkdir -p /run/wazuh-dashboard

  # Credenciales del dashboard contra el indexer
  _setup_keystore

  # Set permissions
  _set_permissions

  # Set capabilities for privileged port binding (443)
  _set_capabilities

  echo ""
  echo "=========================================="
  echo "  WAZUH DASHBOARD INSTALLATION COMPLETE"
  echo "=========================================="
  echo ""
  echo "=== STEP 1: DEPLOY CERTIFICATES (REQUIRED) ==="
  echo ""
  echo "  cd /root"
  echo "  tar -xf wazuh-certificates.tar -C /etc/wazuh-dashboard/certs/ ./dashboard.pem ./dashboard-key.pem ./root-ca.pem --strip-components=1"
  echo "  chmod 500 /etc/wazuh-dashboard/certs && chmod 400 /etc/wazuh-dashboard/certs/*"
  echo "  chown -R wazuh-dashboard:wazuh-dashboard /etc/wazuh-dashboard/certs"
  echo ""
  echo "=== STEP 2: CONFIGURE DASHBOARD ==="
  echo ""
  echo "Edit /etc/wazuh-dashboard/opensearch_dashboards.yml:"
  echo "  - server.host: 0.0.0.0"
  echo "  - server.port: 443"
  echo "  - opensearch.hosts: https://<INDEXER_IP>:9200"
  echo ""
  echo "=== STEP 3: START SERVICE ==="
  echo ""
  echo "  systemctl daemon-reload"
  echo "  systemctl enable --now wazuh-dashboard"
  echo ""
  echo "=== STEP 4: ACCESS ==="
  echo ""
  echo "  URL: https://<DASHBOARD_IP>:443"
  echo "  Default credentials: admin / admin"
  echo "  (Change password after first login!)"
  echo ""
  echo "  NOTE: the dashboard takes 1-3 minutes to become available on first"
  echo "  start while it optimizes its bundles. HTTP 503 until then is normal."
  echo ""
  echo "=== IF YOU CHANGED THE kibanaserver PASSWORD ==="
  echo ""
  echo "The dashboard reads its indexer credentials from its keystore, not from"
  echo "opensearch_dashboards.yml. After changing the password, update it with:"
  echo ""
  echo "  KS=/usr/share/wazuh-dashboard/bin/opensearch-dashboards-keystore"
  echo "  printf 'kibanaserver'  | \$KS add -f --stdin opensearch.username"
  echo "  printf '<NEW_PASSWORD>'| \$KS add -f --stdin opensearch.password"
  echo "  chown wazuh-dashboard:wazuh-dashboard /etc/wazuh-dashboard/opensearch_dashboards.keystore"
  echo "  systemctl restart wazuh-dashboard"
  echo ""
  echo "Documentation: https://documentation.wazuh.com/current/installation-guide/wazuh-dashboard/step-by-step.html"
}

_setup_keystore()
{
  # opensearch_dashboards.yml NO lleva usuario/contrasena por diseno: el dashboard
  # los lee de su keystore. Sin el, no puede autenticarse contra el indexer y se
  # queda en bucle "[ResponseError]: Response Error" devolviendo HTTP 503 para
  # siempre, con el servicio en estado "active" (parece sano pero no lo esta).
  local ks_bin=/usr/share/wazuh-dashboard/bin/opensearch-dashboards-keystore
  local ks_file=/etc/wazuh-dashboard/opensearch_dashboards.keystore

  if [ ! -x "$ks_bin" ]; then
    echo "  WARNING: keystore binary not found, skipping credential setup"
    return
  fi

  if [ -f "$ks_file" ]; then
    echo "  Keystore already present, keeping existing credentials"
    return
  fi

  echo "Creating dashboard keystore with default credentials..."

  # --allow-root es imprescindible: post_install corre como root y el binario se
  # niega con "OpenSearch Dashboards should not be run as root" y termina sin
  # crear nada. Antes la salida iba a /dev/null, asi que el fallo era invisible
  # y el dashboard se quedaba en HTTP 503 para siempre.
  local ks_out
  if ! ks_out=$("$ks_bin" create --allow-root 2>&1); then
    echo "  WARNING: no se pudo crear el keystore:"
    echo "$ks_out" | sed 's/^/    /'
    echo "  WARNING: el dashboard devolvera HTTP 503 hasta que se cree a mano"
    return
  fi

  printf 'kibanaserver' | "$ks_bin" add -f --stdin --allow-root opensearch.username >/dev/null 2>&1
  printf 'kibanaserver' | "$ks_bin" add -f --stdin --allow-root opensearch.password >/dev/null 2>&1

  if [ -f "$ks_file" ]; then
    chown wazuh-dashboard:wazuh-dashboard "$ks_file" 2>/dev/null || true
    chmod 600 "$ks_file" 2>/dev/null || true
    echo "  Keystore created (user: kibanaserver)"
  else
    echo "  WARNING: keystore was not created, the dashboard will return HTTP 503"
  fi
}

_set_permissions()
{
  echo "Setting permissions..."

  # Main directories
  chown -R wazuh-dashboard:wazuh-dashboard /usr/share/wazuh-dashboard
  chown -R wazuh-dashboard:wazuh-dashboard /etc/wazuh-dashboard
  chown -R wazuh-dashboard:wazuh-dashboard /var/log/wazuh-dashboard 2>/dev/null || true
  chown -R wazuh-dashboard:wazuh-dashboard /run/wazuh-dashboard 2>/dev/null || true

  # Ensure data directories are writable
  chmod -R 750 /usr/share/wazuh-dashboard/data 2>/dev/null || true

  # Config directory
  chmod 750 /etc/wazuh-dashboard
}

_set_capabilities()
{
  echo "Setting capabilities for privileged port binding (443)..."

  # Allow node to bind to privileged ports (< 1024)
  if [ -f /usr/share/wazuh-dashboard/node/bin/node ]; then
    setcap 'cap_net_bind_service=+ep' /usr/share/wazuh-dashboard/node/bin/node
    echo "  setcap applied to node binary"
  else
    echo "  WARNING: node binary not found, setcap not applied"
  fi
}
