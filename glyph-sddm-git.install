post_install() {
  echo "--- Glyph SDDM Installation ---"
  echo "To activate the theme, edit /etc/sddm.conf or a file in /etc/sddm.conf.d/:"
  echo ""
  echo "[Theme]"
  echo "Current=glyph"
  echo ""
  echo "You can test the theme without logging out using:"
  echo "sddm-greeter-qt6 --test-mode --theme /usr/share/sddm/themes/glyph"
  echo "-------------------------------"
}

post_upgrade() {
  post_install
}
