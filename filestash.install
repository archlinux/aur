post_install() {
    cat <<'EOF'
==> Filestash can run in two ways:

    System service (dedicated 'filestash' user):
      sudo systemctl enable --now filestash.service

    User service (recommended for personal use):
      systemctl --user enable --now filestash.service

==> Data locations

    System service:  /var/lib/filestash, /var/cache/filestash, /var/log/filestash
    User service:    ~/.local/share/filestash, ~/.cache/filestash,
                     ~/.local/state/filestash/log

==> Web interface: http://localhost:8334
EOF
}

post_upgrade() {
    post_install
}
