_user="${SUDO_USER:-$(logname 2>/dev/null)}"
_home="$(getent passwd "$_user" | cut -d: -f6)"
_data_home="${XDG_DATA_HOME:-$_home/.local/share}"

print_usage_hint() {
  echo
  echo "==> To run Xenia Canary from the terminal, use the provided helper"
  echo "    script by running: xenia-canary-bin"
  echo "==> Or run it from your application menu (Xenia Canary desktop entry)"
  echo
  echo "==> Xenia Canary will store its cache and logs in:"
  echo "    $_home/.xenia-canary"
  echo "==> The configfile and userprefs are stored in:"
  echo "    $_data_home/Xenia"
  echo
}

post_install() {
  print_usage_hint
  echo "==> NOTE:"
  echo "    This is a preview build and will NOT auto-update"
  echo "==> If you're using an AUR helper like yay, you will need to"
  echo "    periodically reinstall this package manually to update it"
  echo
}

post_upgrade() {
  print_usage_hint
}

post_remove() {
  echo
  echo "==> Xenia Canary has been removed"
  echo "==> You may also remove the ~/.xenia-canary directory manually if needed"
  echo
}
