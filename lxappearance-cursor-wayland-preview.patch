@@ -22,28 +22,128 @@
 #include "cursor-theme.h"
 #include "icon-theme.h"
 #include "lxappearance.h"
-#include <gdk/gdkx.h>
+#include <X11/Xcursor/Xcursor.h>
+
+static guchar unpremultiply_cursor_channel(guchar channel, guchar alpha)
+{
+    if(alpha == 0)
+        return 0;
+    return MIN(255, (channel * 255 + alpha / 2) / alpha);
+}
+
+static GdkPixbuf* pixbuf_from_xcursor_image(XcursorImage* image)
+{
+    guchar* data;
+    guint rowstride;
+    guint i;
+
+    if(image == NULL || image->width == 0 || image->height == 0 || image->pixels == NULL)
+        return NULL;
+
+    rowstride = image->width * 4;
+    data = g_malloc(rowstride * image->height);
+
+    for(i = 0; i < image->width * image->height; ++i)
+    {
+        XcursorPixel pixel = image->pixels[i];
+        guchar alpha = (pixel >> 24) & 0xff;
+        guchar red = (pixel >> 16) & 0xff;
+        guchar green = (pixel >> 8) & 0xff;
+        guchar blue = pixel & 0xff;
+        guchar* out = data + i * 4;
+
+        out[0] = unpremultiply_cursor_channel(red, alpha);
+        out[1] = unpremultiply_cursor_channel(green, alpha);
+        out[2] = unpremultiply_cursor_channel(blue, alpha);
+        out[3] = alpha;
+    }
+
+    return gdk_pixbuf_new_from_data(data, GDK_COLORSPACE_RGB, TRUE, 8,
+                                    image->width, image->height, rowstride,
+                                    (GdkPixbufDestroyNotify)g_free, NULL);
+}
+
+static XcursorImage* choose_nearest_cursor_image(XcursorImages* images, int requested_size)
+{
+    XcursorImage* best = NULL;
+    guint best_distance = G_MAXUINT;
+    int i;
+
+    if(images == NULL || images->nimage <= 0)
+        return NULL;
+
+    for(i = 0; i < images->nimage; ++i)
+    {
+        XcursorImage* image = images->images[i];
+        guint size;
+        guint distance;
+
+        if(image == NULL)
+            continue;
+
+        size = image->size ? image->size : MAX(image->width, image->height);
+        distance = ABS((int)size - requested_size);
+        if(best == NULL || distance < best_distance)
+        {
+            best = image;
+            best_distance = distance;
+        }
+    }
+
+    return best;
+}
+
+static GdkPixbuf* load_cursor_variant_pixbuf(const char* const* names, const char* theme, int size)
+{
+    int i;
+
+    for(i = 0; names[i] != NULL; ++i)
+    {
+        XcursorImages* images = XcursorLibraryLoadImages(names[i], theme, size);
+        GdkPixbuf* pixbuf = NULL;
+
+        if(images == NULL)
+            continue;
+
+        pixbuf = pixbuf_from_xcursor_image(choose_nearest_cursor_image(images, size));
+        XcursorImagesDestroy(images);
+
+        if(pixbuf != NULL)
+            return pixbuf;
+    }
+
+    return NULL;
+}
 
