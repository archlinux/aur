+#endif
+		static_assert(kForcedEngine > 0 && kForcedEngine <= 9,
+		              "OPENCV_FORCE_DNN_ENGINE value must be a single digit");
+		constexpr std::array<char, 2> kForcedEngineValue{
+		    static_cast<char>('0' + kForcedEngine),
+		    '\0',
