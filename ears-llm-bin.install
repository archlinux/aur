post_install() {
    echo "==> Configure:  install -Dm600 /usr/share/doc/ears-llm/env.example ~/.config/ears-llm/env"
    echo "==> Start:      systemctl --user enable --now ears-llm"
    echo "==> GPU: uses Vulkan; needs your card's Vulkan driver (nvidia-utils, vulkan-radeon, vulkan-intel). The first start downloads the default model."
}
