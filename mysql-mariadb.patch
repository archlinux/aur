+    if binary.compiler.target.platform == 'mac':
       binary.compiler.postlink += [
         os.path.join(SM.mariadb_root[arch], 'lib', 'libmariadbclient.a'),
       ]
     if binary.compiler.target.platform == 'linux':
+      # The system's MariaDB Connector/C as a shared library (mariadb_config --libs), with its own
+      # OpenSSL and zlib, instead of a static one with a static OpenSSL
       binary.compiler.postlink += [
-        '-Wl,-Bstatic',
-        '-lssl',
-        '-lcrypto',
-        '-Wl,-Bdynamic',
-        '-lz',
+        '-lmariadb',
         '-lpthread',
         '-lm',
-        '-lrt',
-        '-ldl',
       ]
     elif binary.compiler.target.platform == 'mac':
       binary.compiler.postlink += ['-lz', '-lpthread', '-lm']
