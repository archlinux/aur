# margo-git — post-transaction hooks.
#
# mtune (folder-first music player) ships a /usr/share/applications
# entry, a D-Bus service, hicolor icons, and — load-bearing — a
# GSettings schema (`org.margo.Tune`) that must be compiled into the
# shared schemas cache or the app aborts at startup.

_refresh() {
  glib-compile-schemas /usr/share/glib-2.0/schemas &>/dev/null || true
  update-desktop-database -q /usr/share/applications &>/dev/null || true
  if command -v gtk4-update-icon-cache &>/dev/null; then
    gtk4-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true
  else
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &>/dev/null || true
  fi
}

# Before 4.5.1 `mlogind sync-theme` copied a user's palette over the
# /etc/mlogind/variables.toml backup file. Put the packaged default back
# over such a copy (and only such a copy: the helper checks the old sync's
# header and leaves every other file alone, keeping the old one as
# .old-sync). A .pacnew identical to the restored default is redundant.
_mlogind_retire_old_sync() {
  local helper=/usr/lib/mlogind/retire-old-sync-variables.sh
  local etc=/etc/mlogind/variables.toml
  [ -x "$helper" ] || return 0
  "$helper" "$etc" /usr/lib/mlogind/variables.toml.default || return 0
  if [ -f "$etc.pacnew" ] && cmp -s "$etc.pacnew" "$etc"; then
    rm -f "$etc.pacnew"
  fi
}

post_install() { _refresh; _mlogind_retire_old_sync; }
post_upgrade() { _refresh; _mlogind_retire_old_sync; }
post_remove()  { _refresh; }
