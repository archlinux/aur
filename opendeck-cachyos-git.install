post_install() {
	update-mime-database /usr/share/mime
	update-desktop-database /usr/share/applications
	udevadm control --reload-rules
	udevadm trigger
}

post_upgrade() {
	post_install
}

post_remove() {
	update-mime-database /usr/share/mime
	update-desktop-database /usr/share/applications
	udevadm control --reload-rules
}
