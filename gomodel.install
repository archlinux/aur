## arg 1: the new package version
## arg 2: the old package version

post_install() {
  cat <<EOF

gomodel installed (git build of upstream main). The default config needs NO
editing to start.

--- Quick setup (copy ONE line) -------------------------------------------

Per-user (only your session, starts at login):
  mkdir -p ~/.config/gomodel && printf 'GOMODEL_ENCRYPTION_KEY=%s\n' "$(openssl rand -base64 32)" > ~/.config/gomodel/env && chmod 600 ~/.config/gomodel/env && systemctl --user enable --now gomodel

Then check:  curl -s localhost:8080/healthz

--- Details ---------------------------------------------------------------

Per-user service (starts at login; secrets load from the env file at
unit start, i.e. at login for default.target units):
  1. mkdir -p ~/.config/gomodel && drop a config.yaml there (optional).
  2. Secrets: ~/.config/gomodel/env (chmod 600), e.g.
       GOMODEL_ENCRYPTION_KEY=$(openssl rand -base64 32)
  3. systemctl --user enable --now gomodel

System service: this -git package ships the user unit only. For a
root-managed boot service, install the stable 'gomodel' package instead.

Plugins (needs the 'go' package, optdepend):
  gomodel plugin build -o ~/.local/share/gomodel/plugins/foo.so ./my-plugin
  Enable in config: plugins: { enabled: true, search_paths: [...], load: [...] }
  The .so must be built with the same 'go' version as this package was.

----------------------------------------------------------------------------

EOF
}

post_upgrade() {
  # Restart running services so the new binary is picked up.
  systemctl try-restart gomodel.service 2>/dev/null || true
  cat <<EOF

gomodel upgraded. Running system services were restarted.
User services: run 'systemctl --user restart gomodel' if enabled.
EOF
}
