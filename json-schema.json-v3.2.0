                                    "fn"
                                  ],
                                  "description": "One of the keyboard keys."
                                },
                                {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "enum": [
                                      "0",
                                      "1",
                                      "2",
                                      "3",
