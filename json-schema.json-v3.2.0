                                    "delete",
                                    "return",
                                    "enter",
                                    "tab",
                                    "escape",
                                    "space",
                                    "insert",
                                    "print_screen",
                                    "home",
                                    "end",
                                    "page_up",
                                    "page_down",
                                    "up",
                                    "down",
                                    "left",
                                    "right",
                                    "caps_lock",
                                    "num_lock",
                                    "scroll_lock",
                                    "add",
                                    "subtract",
                                    "multiply",
                                    "divide",
                                    "clear",
                                    "numpad_0",
                                    "numpad_1",
