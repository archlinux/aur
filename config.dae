# Direct-only default: verify the datapath first, then add nodes, groups and
# rules. See https://github.com/daeuniverse/honk/blob/main/doc/en/configuration.md
#
# geoip.dat and geosite.dat under data_dir, which the native API downloads and
# updates, take precedence over the v2ray data linked from /usr/share/honk.

global {
    wan_interface: auto
    data_dir: '/var/lib/honk'
    log_level: info
    auto_config_kernel_parameter: true
}

routing {
    fallback: direct
}

# The first visit to the UI creates the administrator. Changing native_api
# needs a restart. A secret declared in this file makes it read-only to the UI,
# so put token auth in a separate include instead.
experimental {
    native_api {
        enabled: true
        listen: '127.0.0.1:9527'
        ui: embedded
        password_auth: true
        config_write: true
    }
}
