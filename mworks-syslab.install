_instdir="/opt/mworks-syslab"
_julia="${_instdir}/Tools/julia-1.10.10/bin/julia"
_precompile_jl="${_instdir}/Install/config/precompile.jl"

post_install() {
    echo ""
    echo "==> MWORKS.Syslab 已安装至 ${_instdir}"
    echo ""
    echo "==> 预编译 Julia 库（可选）："
    echo "    不预编译也可以正常使用，首次启动 Syslab 时会在终端中自动预编译，缓存位于 ~/TongYuan/.julia。"
    echo "    如需提前预编译（预计数分钟），请以普通用户身份（不要 sudo）执行，缓存会写入 ~/TongYuan/.julia："
    echo "      bash -c 'source ${_instdir}/Setting/syslab-env.sh ${_instdir} && ${_julia} --project=${_instdir}/.julia/environments/v1.10 ${_precompile_jl}'"
    echo ""
    echo "==> MCP 与 skills（可选，让 AI 客户端调用本机 Syslab）："
    echo "    官方会在首次启动时自动修改 Claude / OpenCode / Codex 的配置并覆盖 skills，本包已将其屏蔽。"
    echo "    如需使用，请以普通用户身份（不要 sudo）自行执行："
    echo "    1. MCP："
    echo "         ${_instdir}/Tools/syslab-mcp-server/syslab-mcp-server-install.sh"
    echo "       不带参数为交互模式，会分别询问是否配置 Claude / OpenCode / Codex，已有配置会先备份；"
    echo "       配置完成后重启对应客户端。手动配置方法见同目录 README.md"
    echo "    2. skills（会先删除目标目录中同名的 syslab-* 目录再拷贝，不做备份），建议先预览："
    echo "         ${_instdir}/Tools/syslab-skills/install_syslab_skills.sh --dest-root <目标目录> --dry-run"
    echo "       确认无误后去掉 --dry-run 重新执行。<目标目录> 按客户端选择："
    echo "         OpenCode: ~/.config/opencode/skills    Claude Code: ~/.claude/skills    Codex: ~/.codex/skills"
    echo "         Syslab 自带 AI 助手: ~/.mworks/mogick/Syslab/skills"
    echo "       skills 需要环境变量 SYSLAB_HOME 指向 ${_instdir}"
}

post_upgrade() {
    post_install
}

post_remove() {
    # 删除安装目录以清理残留的预编译缓存（compiled/）和运行时日志（logs/）
    rm -rf "${_instdir}"

    echo "==> 如曾手动配置过 MCP / skills，卸载不会清除它们，请按需自行移除："
    echo "    ~/.claude.json 的 mcpServers.syslab、~/.config/opencode/opencode.json 的 mcp.syslab、"
    echo "    ~/.codex/config.toml 的 [mcp_servers.syslab]，以及所选目录中的 syslab-* 目录"
}
