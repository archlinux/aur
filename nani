#!/bin/sh
nani_dir="$HOME/.config/nani"
[ -f "$nani_dir/nani.conf" ] && . "$nani_dir/nani.conf"

quiz() {
	file="$1"
	[ -f "$file" ] && {
		total_lines=$(wc -l < "$file")
    
		while true; do
			random_line=$(awk -v n="$total_lines" 'BEGIN{srand(); print int(1+rand()*n)}')
			line=$(sed -n "${random_line}p" "$file")
	      
			question=$(echo "$line" | awk '{print $1}')
			answer=$(echo "$line" | awk '{print $2}')
	      
			echo "Solve one $learning_mode question to proceed with nano"
			echo "Sensei: $question"
			printf "You: "
			read -r user_input
			[ "$user_input" = "$answer" ] && { 
				echo "㊗"
				break 
			} || echo "Incorrect. The answer to $question is $answer"
		done
	}
}

[ ! -z "$learning_path" ] && [ ! -z "$learning_mode" ] && {
	[ "$learning_mode" = "NANI?!" ] && { 
	    learning_mode=$(basename $(ls -1 *.nani |  shuf | head -1) .nani)
	} || { 
	    learning_mode=$(echo "$learning_mode" | awk 'BEGIN { srand() } { print $(1 + int(rand() * NF)) }')
	}
	quiz "$learning_path/$learning_mode.nani"
} || {
	number=$(awk -v min=0 -v max=2 'BEGIN{srand(); print int(min+rand()*(max-min+1))}')
		case $number in
			0) echo "NANI!?" ;;
			1) echo "なに" ;;
			2) echo "なにイーツ！！" ;;
    			*) echo "Somebody was too dumb to count. Report it to @derberg:matrix.org" ;;
		esac
}

sleep 3
nano "$@"
