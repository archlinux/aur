[Unit]
Description=AIVPN Server
After=network.target

[Service]
RestartSec=2s
Type=simple
User=aivpn
Group=aivpn
WorkingDirectory=/var/lib/aivpn
Environment=USER=aivpn HOME=/var/lib/aivpn
ExecStart=/usr/bin/aivpn-server --config /etc/aivpn/server.json --clients-db /var/lib/aivpn/clients.json --key-file /etc/aivpn/server.key
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
