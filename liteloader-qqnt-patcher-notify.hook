[Trigger]
Type=Path
Operation=Install
Operation=Upgrade
Target=opt/QQ/resources/app/package.json

[Trigger]
Type=Package
Operation=Upgrade
Target=liteloader-qqnt-patcher

[Action]
Description=Notify to Patch QQ for LiteLoaderQQNT
When=PostTransaction
Exec=/bin/sh -c "/bin/echo -e '\n>>> \e[1;36mThe target file or the patcher has been updated.\e[0m\n>>> \e[1;33mTo patch LinuxQQ for LiteLoaderQQNT, remember to run:\e[0m sudo liteloader-qqnt-patcher upgrade\n'"
