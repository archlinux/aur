From 62359a02f42166f44bf18b629e8c0dde12421a45 Mon Sep 17 00:00:00 2001
From: basalt <basalt@localhost>
Date: Tue, 3 Nov 2026 07:23:20 +0300
Subject: [PATCH] cmake: the runtime tree and the engine path are cache
 variables

'basalt serve' chdirs to BASALT_SOURCE_DIR, the tree holding serve/, tools/ and
data/profiles, and runs 'python3 -m serve.server' from it; basalt-bench and
basalt-probe bake in the engine they start and the data/bench fixtures they read.
All of those are the build tree today, which a packaged install does not keep, so
they become cache variables a packager points at the installed tree:
  -DBASALT_SOURCE_DIR=/usr/lib/basalt -DBASALT_ENGINE_BIN=/usr/lib/basalt/bin/basalt
A plain build is unchanged: the defaults are the values used now.
---
 CMakeLists.txt | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0c4f0485..1396366a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -529,7 +529,10 @@ target_include_directories(basalt PRIVATE ${_gpu_include_directories})
 target_link_libraries(basalt PRIVATE engine engine_session grammar tokenizer prefill spec ${_gpu_runtime_target})
 basalt_embed_manifest(basalt)
 # `basalt serve` runs the Python server from the source tree; the engine reads its expert profiles from data/profiles
-target_compile_definitions(basalt PRIVATE BASALT_SOURCE_DIR="${CMAKE_SOURCE_DIR}")
+# A packaged install points the engine at the installed tree instead (-DBASALT_SOURCE_DIR=/usr/lib/basalt);
+# a plain build keeps the checkout it was configured in.
+set(BASALT_SOURCE_DIR "${CMAKE_SOURCE_DIR}" CACHE PATH "tree the installed engine reads serve/ and data/profiles from")
+target_compile_definitions(basalt PRIVATE BASALT_SOURCE_DIR="${BASALT_SOURCE_DIR}")
 
 # The standard benchmark: a host-only program that drives the engine over its stdin/stdout protocol.
 # The commit stamp is refreshed on every build (not only at configure time), by a target that rewrites the header
@@ -581,11 +584,13 @@ add_dependencies(basalt-bench basalt basalt-device git_stamp)
 target_include_directories(basalt-bench PRIVATE ${CMAKE_BINARY_DIR}/stamp)
 target_link_libraries(basalt-bench PRIVATE engine_session platform warnings ${CMAKE_DL_LIBS})
 basalt_embed_manifest(basalt-bench)
+# a packaged build names the installed engine and the installed fixtures instead of the build tree
+set(BASALT_ENGINE_BIN "$<TARGET_FILE:basalt>" CACHE STRING "the engine basalt-bench and basalt-probe start")
 target_compile_definitions(basalt-bench PRIVATE
-  BASALT_BENCH_ENGINE="$<TARGET_FILE:basalt>"
+  BASALT_BENCH_ENGINE="${BASALT_ENGINE_BIN}"
   BASALT_BENCH_DEVICE="$<TARGET_FILE:basalt-device>"
-  BASALT_BENCH_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/data/bench"
-  BASALT_BENCH_SOURCE_DIR="${CMAKE_CURRENT_SOURCE_DIR}"
+  BASALT_BENCH_FIXTURES="${BASALT_SOURCE_DIR}/data/bench"
+  BASALT_BENCH_SOURCE_DIR="${BASALT_SOURCE_DIR}"
   BASALT_BENCH_BUILD_TYPE="${CMAKE_BUILD_TYPE}"
   BASALT_BENCH_CUDA="${CMAKE_CUDA_COMPILER_VERSION}")
 
@@ -596,8 +601,8 @@ add_dependencies(basalt-probe basalt)
 target_link_libraries(basalt-probe PRIVATE engine_session platform warnings ${CMAKE_DL_LIBS})
 basalt_embed_manifest(basalt-probe)
 target_compile_definitions(basalt-probe PRIVATE
-  BASALT_BENCH_ENGINE="$<TARGET_FILE:basalt>"
-  BASALT_BENCH_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/data/bench")
+  BASALT_BENCH_ENGINE="${BASALT_ENGINE_BIN}"
+  BASALT_BENCH_FIXTURES="${BASALT_SOURCE_DIR}/data/bench")
 
 # closing the engine's stdin mid-request stops it (runs the real engine on a model pack:
 # -DBASALT_STDIN_STOP_MODEL=<pack>, with python3)
