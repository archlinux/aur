#!/usr/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/notion-calendar-flags.conf ]]; then
    NOTION_CALENDAR_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/notion-calendar-flags.conf)"
fi

# --- how the display protocol is chosen ------------------------------------
# Notion Calendar is a repack of the Windows NSIS installer, so it inherits
# Chromium's X11 preference. On a Wayland session where BOTH sockets exist it
# silently picks X11 and runs under XWayland. That is why this was the only
# app on the desktop doing so.
#
# Native Wayland is the right backend, but on its own it renders at 1x on
# this desktop (see the scaling note below), which is half the size of every
# other window. So: force Wayland AND force the 2x device scale, matching
# what the XWayland path was accidentally getting right.
PLATFORM_FLAGS=()
SCALE_FLAGS=()
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    # Both exist (or only Wayland) -> go native Wayland.
    PLATFORM_FLAGS=(--ozone-platform=wayland)
    # Desktop is 3840x2160 at scale=1 with GDK_SCALE=2, so every other app
    # renders at 2x. Notion Calendar's layout is authored for a 96dpi logical
    # desktop, so on native Wayland it takes the compositor's scale (1) and
    # renders everything half-size. Force 2x so 1 CSS px == 2 physical px.
    SCALE_FLAGS=(--force-device-scale-factor=2)
fi

# --- HiDPI fallback for XWayland -----------------------------------------
# If there is no Wayland we fall back to X11. XWayland with force_zero_scaling
# (set by this desktop's Hyprland config) already renders at 2x here, so no
# scale flag is added in that case.

# --- clear a stale single-instance lock -----------------------------------
# Electron takes a SingletonLock in the user-data dir. The upstream main.js
# only checks the lock on win32, so on Linux a stale lock is never honoured
# as "an instance is running"; instead a second launch spawns a second
# BrowserWindow whose renderer hands itself off to the dead process and sits
# at the loading logo forever. That is the "two windows, both stuck loading"
# symptom, and clearing a stale lock here is the direct fix.
USER_DATA="${XDG_CONFIG_HOME}/Notion Calendar"
if [[ -e "$USER_DATA/SingletonLock" ]]; then
    # The symlink target is "<hostname>-<pid>". Only the trailing digits are
    # the pid, so require that shape before deciding anything: an empty or
    # malformed target is treated as stale, and a well-formed one is only
    # stale if /proc/<pid> is absent.
    _owner=""
    [[ -L "$USER_DATA/SingletonLock" ]] && _owner=$(readlink "$USER_DATA/SingletonLock")
    _pid=""
    if [[ "$_owner" =~ -([0-9]+)$ ]]; then
        _pid=${BASH_REMATCH[1]}
    fi
    if [[ -z "$_pid" || ! -d "/proc/$_pid" ]]; then
        rm -f "$USER_DATA/SingletonLock" "$USER_DATA/SingletonCookie" \
              "$USER_DATA/SingletonSocket"
    fi
fi

# Launch
APP_DIR=/usr/lib/notion-calendar
cd "$APP_DIR" || exit 1
# electron41 is used for correct Wayland/HiDPI (3840x2160@scale1 + GDK_SCALE=2).
# electron39 blanks on Nvidia+Wayland (verified via grim captures).
# Keep wrapper without hardcoded --no-sandbox so the user can still override
# via notion-calendar-flags.conf. ELECTRON_OZONE_PLATFORM_HINT=wayland
# (set by Omarchy) is only a hint; the flags above are what actually choose
# the backend, because the hint is ignored when both sockets are present.
exec electron41 "${PLATFORM_FLAGS[@]}" "${SCALE_FLAGS[@]}" "$APP_DIR/app.asar" \
    $NOTION_CALENDAR_USER_FLAGS "$@"
