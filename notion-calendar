#!/usr/bin/bash

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-~/.config}

# Allow users to override command-line options
if [[ -f $XDG_CONFIG_HOME/notion-calendar-flags.conf ]]; then
    NOTION_CALENDAR_USER_FLAGS="$(grep -v '^#' $XDG_CONFIG_HOME/notion-calendar-flags.conf)"
fi

# --- how the display protocol is chosen ------------------------------------
# Notion Calendar is a repack of the Windows NSIS installer, so it inherits
# Chromium's X11 preference. On a Wayland session where BOTH the X11 and the
# Wayland socket exist it silently picks X11 and runs under XWayland. That was
# why it was the only app on the desktop doing so: the
# ELECTRON_OZONE_PLATFORM_HINT set by the session is only a hint and is
# ignored when both sockets are present.
#
# Native Wayland is the correct backend on this host, and it needs no scale
# override here: the panel is 3840x2160 at compositor scale 1, and Electron
# on native Wayland reports devicePixelRatio 1, which is what every other
# app on this desktop (brave, chromium, the notion desktop app) renders at.
PLATFORM_FLAGS=()
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    PLATFORM_FLAGS=(--ozone-platform=wayland)
fi

# DO NOT add --force-device-scale-factor here.
#
# It is a tempting fix for a 1x-looking app, but on this desktop it is wrong.
# Composer scale is already 1 and the panel is 4K, so Electron's own scale
# (1) is already the right answer. Forcing a factor of 2 doubles every
# physical pixel and the whole UI comes back oversized. If a user ever does
# need to override the scale, the supported path is
# ~/.config/notion-calendar-flags.conf, not this file.

# --- clear a stale single-instance lock -----------------------------------
# Electron takes a SingletonLock in the user-data dir. The upstream main.js
# only checks the lock on win32, so on Linux a stale lock is never honoured
# as "an instance is running"; instead a second launch spawns a second
# BrowserWindow whose renderer hands itself off to the dead process and sits
# at the loading logo forever. That is the "two windows, both stuck loading"
# symptom, and clearing a stale lock here is the direct fix.
USER_DATA="${XDG_CONFIG_HOME}/Notion Calendar"
if [[ -e "$USER_DATA/SingletonLock" ]]; then
    # The symlink target is "<hostname>-<pid>". Only the trailing digits are
    # the pid, so require that shape before deciding anything: an empty or
    # malformed target is treated as stale, and a well-formed one is only
    # stale if /proc/<pid> is absent.
    _owner=""
    [[ -L "$USER_DATA/SingletonLock" ]] && _owner=$(readlink "$USER_DATA/SingletonLock")
    _pid=""
    if [[ "$_owner" =~ -([0-9]+)$ ]]; then
        _pid=${BASH_REMATCH[1]}
    fi
    if [[ -z "$_pid" || ! -d "/proc/$_pid" ]]; then
        rm -f "$USER_DATA/SingletonLock" "$USER_DATA/SingletonCookie" \
              "$USER_DATA/SingletonSocket"
    fi
fi

# Launch
APP_DIR=/usr/lib/notion-calendar
cd "$APP_DIR" || exit 1
# electron41 is used for a working Wayland path (electron39 blanks on
# Nvidia+Wayland, verified via grim captures).
# User flags come last so they can still override the platform choice, e.g.
# by putting --force-device-scale-factor=2 in notion-calendar-flags.conf on a
# genuine HiDPI-at-scale-2 panel.
exec electron41 "${PLATFORM_FLAGS[@]}" "$APP_DIR/app.asar" \
    $NOTION_CALENDAR_USER_FLAGS "$@"
