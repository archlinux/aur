prepare() {
  [[ ! -d gcc ]] && ln -s gcc-${_pkgver} gcc

  cd gcc
  [[ ! -e isl ]] && ln -s ../isl isl
  [[ ! -e gmp ]] && ln -s ../gmp-${_gmpver} gmp
  [[ ! -e mpc ]] && ln -s ../mpc-${_mpcver} mpc
  [[ ! -e mpfr ]] && ln -s ../mpfr-${_mpfrver} mpfr
  echo "${_realver}" >gcc/BASE-VER

  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in
  sed -i '/lp64=/s/lib64/lib/' gcc/config/aarch64/t-aarch64-linux

  patch -Np0 -i ${srcdir}/gcc-ada-repro.patch

  mkdir -p ${srcdir}/gcc-build ${srcdir}/libgccjit-build
}

build() {
  local _confflags=(
    --prefix=/usr
    --libdir=/usr/lib
    --libexecdir=/usr/lib
    --mandir=/usr/share/man
    --infodir=/usr/share/info
    --with-bugurl=https://aur.archlinux.org/packages/gcc-snapshot
    --with-build-config=bootstrap-lto
    --with-linker-hash-style=gnu
    --with-isl-include=../gcc/isl/include
    --enable-__cxa_atexit
    --enable-cet=auto
    --enable-checking=release
    --enable-clocale=gnu
    --enable-cxx-modules
    --enable-default-pie
    --enable-default-ssp
    --enable-experimental-modules
    --enable-gnu-indirect-function
    --enable-gnu-unique-object
    --enable-libstdcxx-backtrace
    --enable-link-serialization=1
    --enable-linker-build-id
    --enable-lto
    --enable-plugin
    --enable-shared
    --enable-threads=posix
    --disable-libssp
    --disable-libstdcxx-pch
    --disable-multilib
    --disable-werror
  )

  cd gcc-build

  CFLAGS=${CFLAGS/-Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-Werror=format-security/}

  ../gcc/configure \
    --enable-languages=ada,algol68,c,c++,cobol,d,fortran,go,lto,m2,rust,objc,obj-c++ \
    --enable-offload-targets=amdgcn-amdhsa,nvptx-none \
    --enable-vtable-verify \
    --enable-bootstrap \
    "${_confflags[@]:?_confflags unset}"

  make -O "STAGE1_CFLAGS=-O2" "STAGE2_CFLAGS=-O2" "STAGE3_CFLAGS=-O2" "STAGE4_CFLAGS=-O2" \
          "BOOT_CFLAGS=${CFLAGS}" "BOOT_LDFLAGS=${LDFLAGS}" "LDFLAGS_FOR_TARGET=${LDFLAGS}" \
          bootstrap V=0

  make -O -C ${CHOST}/libstdc++-v3/doc doc-man-doxygen V=0

  cd ${srcdir}/libgccjit-build

  ../gcc/configure \
    --enable-languages=jit \
    --enable-vtable-verify \
    --disable-bootstrap \
    --enable-host-shared \
    "${_confflags[@]:?_confflags unset}"

  make -O "STAGE1_CFLAGS=-O2" "STAGE2_CFLAGS=-O2" "STAGE3_CFLAGS=-O2" "STAGE4_CFLAGS=-O2" \
          "BOOT_CFLAGS=${CFLAGS}" "BOOT_LDFLAGS=${LDFLAGS}" "LDFLAGS_FOR_TARGET=${LDFLAGS}" \
          all-gcc V=0

  cp -a gcc/libgccjit.so* ../gcc-build/gcc/
}

package_gcc-snapshot() {
  pkgdesc="GNU Compiler Collection - C and C++ front-ends (snapshot)"
  depends=("libgcc-snapshot=${pkgver}-${pkgrel}" "libstdc++-snapshot=${pkgver}-${pkgrel}" "glibc>=2.40" zstd)
  provides=(${pkgname}-multilib gcc-multilib gcc)
  replaces=(${pkgname}-multilib gcc-multilib gcc)
  conflicts=(gcc-multilib gcc)
  options=(!emptydirs staticlibs)

  cd gcc-build

  make -C gcc DESTDIR=${pkgdir} install-driver install-cpp install-gcc-ar c++.install-common install-headers install-plugin install-lto-wrapper V=0

  install -m755 -t ${pkgdir}/usr/bin/ gcc/gcov{,-tool}
  install -m755 -t ${pkgdir}/${_libdir}/ gcc/{cc1,cc1plus,collect2,lto1}

  make -C ${CHOST}/libgcc DESTDIR=${pkgdir} install V=0
  rm -f ${pkgdir}/usr/lib/libgcc_s*so*

  make -C ${CHOST}/libstdc++-v3/src DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/include DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/libsupc++ DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/python DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libatomic DESTDIR=${pkgdir} install V=0

  make DESTDIR=${pkgdir} install-libcc1 V=0
  install -d ${pkgdir}/usr/share/gdb/auto-load/usr/lib
  mv ${pkgdir}/usr/lib/libstdc++.so.6.*-gdb.py ${pkgdir}/usr/share/gdb/auto-load/usr/lib/
  rm -f ${pkgdir}/usr/lib/libstdc++.so*

  make DESTDIR=${pkgdir} install-fixincludes V=0
  make -C gcc DESTDIR=${pkgdir} install-mkheaders V=0

  make -C lto-plugin DESTDIR=${pkgdir} install V=0
  install -dm755 ${pkgdir}/usr/lib/bfd-plugins/
  ln -s /${_libdir}/liblto_plugin.so ${pkgdir}/usr/lib/bfd-plugins/

  make -C ${CHOST}/libgomp DESTDIR=${pkgdir} install-nodist_{libsubinclude,toolexeclib}HEADERS V=0
  make -C ${CHOST}/libitm DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libsanitizer DESTDIR=${pkgdir} install-nodist_{saninclude,toolexeclib}HEADERS V=0
  make -C ${CHOST}/libsanitizer/asan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libsanitizer/tsan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libsanitizer/lsan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0

  make -C gcc DESTDIR=${pkgdir} install-man install-info V=0
  rm -f ${pkgdir}/usr/share/man/man1/{ga68,gcobol,gccgo,gfortran,lto-dump,gdc,gm2}*
  rm -f ${pkgdir}/usr/share/man/man3/{ga68,gcobol}*
  rm -f ${pkgdir}/usr/share/info/{ga68,gccgo,gfortran,gnat-style,gnat_rm,gnat_ugn,gdc,m2}*

  make -C libcpp DESTDIR=${pkgdir} install V=0
  make -C gcc DESTDIR=${pkgdir} install-po V=0

  ln -s gcc ${pkgdir}/usr/bin/cc

  for binary in {c++,g++,gcc,gcc-ar,gcc-nm,gcc-ranlib}
  do
    ln -s /usr/bin/${binary} ${pkgdir}/usr/bin/x86_64-linux-gnu-${binary}
  done

  install -Dm755 ${srcdir}/c89 ${pkgdir}/usr/bin/c89
  install -Dm755 ${srcdir}/c99 ${pkgdir}/usr/bin/c99

  make -C ${CHOST}/libstdc++-v3/doc DESTDIR=${pkgdir} doc-install-man V=0
  rm -f ${pkgdir}/usr/lib/libatomic*so*

  make -C ${CHOST}/libvtv DESTDIR=${pkgdir} install V=0
  rm -f ${pkgdir}/usr/lib/libvtv*so*

  python -m compileall ${pkgdir}/usr/share/gcc-${pkgver%%+*}/
  python -O -m compileall ${pkgdir}/usr/share/gcc-${pkgver%%+*}/

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}

