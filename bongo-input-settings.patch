+def input_settings_commands(desktop):
+    """Return the commands that open the desktop's input-method settings.
+
+    The ``fcitx5-configtool`` executable shipped by the fcitx5 package is only
+    a wrapper. When the real GUI (``fcitx5-config-qt``) is missing it falls
+    back to opening ``~/.config/fcitx5`` in the file manager, which made the
+    "Open Input Settings..." button open Files on Omarchy/Hyprland. Prefer the
+    real GUI and never select that wrapper.
+    """
+    desktop = (desktop or "").lower()
+
+    if any(name in desktop for name in ("gnome", "unity", "pantheon", "budgie")):
+        return [
+            ["gnome-control-center", "keyboard"],
+            ["ibus-setup"],
+            ["fcitx5-config-qt"],
+        ]
+
+    commands = [["fcitx5-config-qt"]]
+    if any(name in desktop for name in ("kde", "plasma")):
+        commands.extend([
+            ["kcmshell6", "kcm_fcitx5"],
+            ["kcmshell5", "kcm_fcitx5"],
+            ["kcmshell6", "kcm_keyboard"],
+            ["kcmshell5", "kcm_keyboard"],
+        ])
+
+    commands.append(["ibus-setup"])
+    return commands
+
