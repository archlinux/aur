post_install() {
  echo "=========================================================================="
  echo "  Opencode Gemini Auth Plugin Installed"
  echo "=========================================================================="
  echo ""
  echo "To enable this plugin, add it to your opencode configuration file"
  echo "(e.g., ~/.config/opencode/config.json):"
  echo ""
  echo "  {"
  echo "    \"plugin\": ["
  echo "      \"opencode-gemini-auth\""
  echo "    ]"
  echo "  }"
  echo ""
  echo "If you have existing plugins, simply add it to the list."
  echo "After updating config, run 'opencode auth login' to authenticate."
  echo "=========================================================================="
}

post_upgrade() {
  post_install
}
