post_install() {
  echo "=========================================================================="
  echo "  Opencode Gemini Auth Plugin Installed"
  echo "=========================================================================="
  echo ""
  echo "To enable this plugin, add it to your opencode configuration file"
  echo "(e.g., ~/.config/opencode/opencode.json):"
  echo ""
  echo "  {"
  echo "    \"plugin\": [\"file:///usr/lib/opencode/plugins/opencode-gemini-auth\"]"
  echo "  }"
  echo ""
  echo "Then run 'opencode auth login' to authenticate."
  echo "=========================================================================="
}

post_upgrade() {
  post_install
}
