post_install() {
    echo ""
    echo "==> arch-native-client installed."
    echo ""
    echo "    native-sync: upgrades packages where forge has a newer build."
    echo "      Wire into your update routine: yay -Syu && sudo native-sync"
    echo "      Or run manually: sudo native-sync"
    echo ""
    echo "    pkglist-export (remote mode only): syncs your package list to"
    echo "      the build server after each pacman transaction."
    echo "      Configure: sudo cp /usr/share/arch-native-client/arch-native-client.conf.example \\"
    echo "                          /etc/arch-native-client.conf"
    echo "      Test: sudo pkglist-export"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> arch-native-client upgraded."
    echo ""
}
