#!/usr/bin/env bash
# intel-llm — one entry point for fast local LLMs on Intel laptops.
#
#   intel-llm gpu  [llama-* args...]     Fast GPU  (llama.cpp SYCL, Arc)
#   intel-llm npu  <ir|hf-id> [args...]  Fast NPU  (OpenVINO GenAI, AI Boost)
#   intel-llm devices                    Show which accelerators are usable
#   intel-llm help                       This help
#
# Examples:
#   intel-llm gpu -hf ggml-org/Qwen2.5-1.5B-Instruct-Q4_K_M-GGUF   # GPU server
#   intel-llm npu OpenVINO/Qwen2.5-1.5B-Instruct-int4-ov -p "Hi"   # NPU one-shot
set -euo pipefail

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  gpu) exec intel-gpu "$@" ;;
  npu) exec intel-npu "$@" ;;
  devices)
    echo "Arc GPU (SYCL / llama.cpp):"
    if [[ -x /usr/bin/llama-cli && -e /usr/lib/ggml/libggml-sycl.so ]]; then
      # Prove the backend loads (oneAPI MKL/DNNL must resolve): file presence
      # alone is not enough, a broken loader path shows zero devices.
      if bash -c 'source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1; exec llama-cli --list-devices 2>/dev/null' | grep -q SYCL; then
        bash -c 'source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1; exec llama-cli --list-devices 2>/dev/null' | sed 's/^/  /'
      else
        echo "  backend present but no SYCL device visible — reinstall 'ggml-sycl' / 'intel-oneapi-toolkit'"
      fi
    elif [[ -x /usr/bin/llama-server ]]; then
      echo "  binary present, but install 'ggml-sycl' for the SYCL backend"
    else echo "  not installed (pacman -S llama-cpp ggml-sycl)"; fi
    echo "NPU + GPU/CPU (OpenVINO GenAI):"
    if /usr/bin/python -c 'import openvino_genai' 2>/dev/null; then
      /usr/bin/python -c 'import openvino; print("  OpenVINO sees:", openvino.Core().available_devices)'
      [[ -e /dev/accel/accel0 ]] || echo "  (no /dev/accel/accel0 — install intel-npu-driver for the NPU)"
    else echo "  not installed (pacman -S openvino-genai-bin)"; fi
    ;;
  help|-h|--help) usage ;;
  *) echo "intel-llm: unknown command '$cmd'" >&2; usage; exit 2 ;;
esac
