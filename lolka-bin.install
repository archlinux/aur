#!/bin/bash

_update_databases() {
    if hash update-mime-database 2>/dev/null; then
        update-mime-database /usr/share/mime || true
    fi

    if hash update-desktop-database 2>/dev/null; then
        update-desktop-database /usr/share/applications || true
    fi
}

# Check if AppArmor is available on the system
# Arch typically has AppArmor disabled by default, so we check both kernel support and user tools
_apparmor_available() {
    [ -d /sys/kernel/security/apparmor ] && command -v apparmor_parser >/dev/null 2>&1
}

_install_apparmor_profiles() {
    APPARMOR_PROFILE_SOURCE='/opt/Lolka/resources/apparmor-profile'
    APPARMOR_PROFILE_TARGET='/etc/apparmor.d/lolka'
    if [ -f "$APPARMOR_PROFILE_SOURCE" ]; then
        cp -f "$APPARMOR_PROFILE_SOURCE" "$APPARMOR_PROFILE_TARGET"
    fi
}

_reload_apparmor_profiles() {
    APPARMOR_PROFILE_TARGET='/etc/apparmor.d/lolka'
    if [ -f "$APPARMOR_PROFILE_TARGET" ]; then
        # Only reload profile if not in chroot environment
        if ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; }; then
            apparmor_parser --replace --write-cache --skip-read-cache "$APPARMOR_PROFILE_TARGET" || true
        fi
    fi
}

# Always attempt to remove AppArmor profile, even if AppArmor is currently disabled
# This prevents leftover profiles if user disabled AppArmor after installation
_remove_apparmor_profiles() {
    APPARMOR_PROFILE_TARGET='/etc/apparmor.d/lolka'
    if [ -f "$APPARMOR_PROFILE_TARGET" ]; then
        rm -f "$APPARMOR_PROFILE_TARGET"
        if command -v apparmor_parser >/dev/null 2>&1; then
            apparmor_parser --remove 'lolka' 2>/dev/null || true
        fi
    fi
}

post_install() {
    ln -sf '/opt/Lolka/lolka' '/usr/bin/lolka'

    # Check if user namespaces are supported by the kernel
    if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
        chmod 4755 '/opt/Lolka/chrome-sandbox' || true
    else
        chmod 0755 '/opt/Lolka/chrome-sandbox' || true
    fi

    _update_databases

    if _apparmor_available; then
        _install_apparmor_profiles
        _reload_apparmor_profiles
    fi
}

post_upgrade() {
    _update_databases

    if _apparmor_available; then
        _reload_apparmor_profiles
    fi
}

pre_remove() {
    :
}

post_remove() {
    rm -f '/usr/bin/lolka'
    _update_databases
    _remove_apparmor_profiles
}
