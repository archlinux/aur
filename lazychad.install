post_install() {
  echo "==> LazyChad has been successfully installed."
  echo "==> Type 'lchad' to start."
  echo "==> IMPORTANT: Run 'lazychad-deps' as your normal user to complete setup (Node/Python/Rust)."
}

post_upgrade() {
  echo "==> LazyChad has been successfully upgraded."
  echo "==> IMPORTANT: Run 'lazychad-deps' as your normal user to update toolchain."
}

post_remove() {
  echo "==> Cleaning up LazyChad user directories..."

  # Loop through all home directories (including root) and remove LazyChad folders
  for user_home in /home/* /root; do
    [ -d "$user_home" ] || continue
    for sub in .config/LazyChad .local/share/LazyChad .local/state/LazyChad .cache/LazyChad; do
      if [ -d "$user_home/$sub" ]; then
        echo "  -> Removing $user_home/$sub"
        rm -rf "$user_home/$sub"
      fi
    done
  done

  echo "==> Note: Neovim installed via 'lazychad-nvim' under /usr/local is NOT removed."
  echo "==>       Run 'lazychad-nvim --uninstall' to remove it."
  echo "==> Done. All LazyChad-related user data has been removed."
}
