[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/dbeaver/dbeaver.ini
Target = usr/lib/dbeaver/dbeaver.ini
Target = usr/share/dbeaver-ce/dbeaver.ini
Target = usr/lib/dbeaver-ce/dbeaver.ini

[Action]
Description = Setting native jvm path for DBeaver...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/dbeaver-jvm-setting.sh
NeedsTargets