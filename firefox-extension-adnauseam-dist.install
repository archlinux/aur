_notes() {
  cat <<MSG
==> AdNauseam is installed for Firefox, LibreWolf, Floorp and Firefox Nightly.
    Restart the browser to load it. LibreWolf, Floorp and Nightly copy it into the
    profile at that start and only take newer versions when the browser itself updates.
MSG
}

post_install() { _notes; }
post_upgrade() { _notes; }
