# Persist Bacularis configuration, working data, logs and caches across upgrades.
d /var/lib/bacularis 0750 http http -
d /var/lib/bacularis/api-config 0700 http http -
d /var/lib/bacularis/web-config 0700 http http -
d /var/lib/bacularis/working 0700 http http -
d /var/log/bacularis 0750 http http -
d /var/log/bacularis/api 0700 http http -
d /var/log/bacularis/web 0700 http http -
d /var/cache/bacularis 0750 http http -
d /var/cache/bacularis/runtime 0700 http http -
d /var/cache/bacularis/assets 0700 http http -
# First installation only: do not overwrite application-generated credentials.
C /var/lib/bacularis/api-config/bacularis.users 0600 http http - /usr/share/webapps/bacularis/protected/samples/webserver/bacularis.users.sample
C /var/lib/bacularis/web-config/bacularis.users 0600 http http - /usr/share/webapps/bacularis/protected/samples/webserver/bacularis.users.sample
