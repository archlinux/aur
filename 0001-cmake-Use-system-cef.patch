From 3d6d98079f619f65fc27140700d24134c9e9596d Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Mon, 10 Aug 2026 21:07:36 +0800
Subject: [PATCH 1/6] cmake: Use system cef

---
 CMakeLists.txt                 | 1 +
 src/Web/CMakeLists.txt         | 7 +------
 viewer/CMakeLists.txt          | 4 ++--
 viewer/WebViewer/WebViewer.cpp | 4 ++--
 waywallen/CMakeLists.txt       | 7 +------
 waywallen/web_entry.cpp        | 4 ++--
 6 files changed, 9 insertions(+), 18 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6980779..40d5a8a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,7 @@ endif()
 find_package(PkgConfig REQUIRED)
 find_package(Threads REQUIRED)
 
+find_package(CEF 149.0.7827.156 REQUIRED)
 
 set(OWE_CXX_COMPILE_OPTIONS
     -Wall
diff --git a/src/Web/CMakeLists.txt b/src/Web/CMakeLists.txt
index 3c0fcf6..35036a7 100644
--- a/src/Web/CMakeLists.txt
+++ b/src/Web/CMakeLists.txt
@@ -2,10 +2,6 @@ if(NOT BUILD_WEWEB)
     return()
 endif()
 
-include(${CMAKE_SOURCE_DIR}/cmake/FetchDeps.cmake)
-fetchdeps(${CMAKE_SOURCE_DIR}/deps.json NAMES cef)
-include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/CEF.cmake)
-
 # ---------------------------------------------------------------------------
 # owe-web-api (public C++20 modules for HTML/JS wallpapers)
 # ---------------------------------------------------------------------------
@@ -41,8 +37,7 @@ target_include_directories(owe-web-host PUBLIC .)
 target_link_libraries(owe-web-host
     PUBLIC
         owe-web-api
-        libcef_lib
-        libcef_dll_wrapper)
+        ${CEF_LIBRARIES})
 target_compile_features(owe-web-host PUBLIC cxx_std_20)
 set_target_properties(owe-web-host PROPERTIES
     POSITION_INDEPENDENT_CODE ON
diff --git a/viewer/CMakeLists.txt b/viewer/CMakeLists.txt
index 9660c75..34e737f 100644
--- a/viewer/CMakeLists.txt
+++ b/viewer/CMakeLists.txt
@@ -71,7 +71,7 @@ if(BUILD_WEWEB)
         POSITION_INDEPENDENT_CODE ON
         CXX_SCAN_FOR_MODULES ON
         BUILD_RPATH   "\$ORIGIN"
-        INSTALL_RPATH "\$ORIGIN"
+        INSTALL_RPATH "\$ORIGIN:\$ORIGIN/../cef:\$ORIGIN/.."
         BUILD_WITH_INSTALL_RPATH ON)
-    weweb_stage_cef_runtime(WebViewer)
+    SET_LIBRARY_TARGET_PROPERTIES(WebViewer)
 endif()
diff --git a/viewer/WebViewer/WebViewer.cpp b/viewer/WebViewer/WebViewer.cpp
index 654e62d..e73f26d 100644
--- a/viewer/WebViewer/WebViewer.cpp
+++ b/viewer/WebViewer/WebViewer.cpp
@@ -205,8 +205,8 @@ int main(int argc, char** argv) {
     auto exe_dir = viewer::ExecutableDir(argv[0]);
 
     weweb::BrowserHost::InitOptions opts;
-    opts.resources_dir = exe_dir;
-    opts.locales_dir   = exe_dir / "locales";
+    opts.resources_dir = std::filesystem::path("/usr/lib/cef");
+    opts.locales_dir   = opts.resources_dir / "locales";
     if (int port = args.remote_debugging_port.to_primitive(); port > 0) {
         opts.enable_remote_debugging = true;
         opts.remote_debugging_port   = port;
diff --git a/waywallen/CMakeLists.txt b/waywallen/CMakeLists.txt
index a08935e..8a2e3a7 100644
--- a/waywallen/CMakeLists.txt
+++ b/waywallen/CMakeLists.txt
@@ -84,11 +84,6 @@ install(TARGETS waywallen-wescene-renderer
 # both share the workspace `install/` prefix and the same Lua source
 # component advertises both wp_types.
 if(BUILD_WEWEB)
-    weweb_get_cef_runtime(
-        _OWE_CEF_BINARY_DIR
-        _OWE_CEF_BINARY_FILES
-        _OWE_CEF_RESOURCE_DIR
-        _OWE_CEF_RESOURCE_FILES)
 
     # Headless Vulkan producer device (DMA-BUF import + bridge-slot blit).
     add_library(waywallen-web-producer-device STATIC)
@@ -123,6 +118,7 @@ if(BUILD_WEWEB)
     target_compile_features(waywallen-weweb-renderer PRIVATE cxx_std_20)
     set_target_properties(waywallen-weweb-renderer PROPERTIES
         CXX_SCAN_FOR_MODULES ON
+        INSTALL_RPATH "\$ORIGIN:\$ORIGIN/../lib/cef:\$ORIGIN/../lib"
     )
     target_include_directories(waywallen-weweb-renderer
         PRIVATE
@@ -141,7 +137,6 @@ if(BUILD_WEWEB)
             rstd::rstd
             rstd.cppstd
     )
-    weweb_stage_cef_runtime(waywallen-weweb-renderer)
 
     install(TARGETS waywallen-weweb-renderer
         RUNTIME DESTINATION ${_OWE_WEWEB_INSTALL_DIR}
diff --git a/waywallen/web_entry.cpp b/waywallen/web_entry.cpp
index ae75c19..afc8737 100644
--- a/waywallen/web_entry.cpp
+++ b/waywallen/web_entry.cpp
@@ -704,8 +704,8 @@ int run(int argc, char** argv) {
     // BrowserHost::Init wants resources / locales relative to argv[0].
     auto                            exe_dir = executable_dir(argv[0]);
     weweb::BrowserHost::InitOptions ho;
-    ho.resources_dir = exe_dir;
-    ho.locales_dir   = exe_dir / "locales";
+    ho.resources_dir = std::filesystem::path("/usr/lib/cef");
+    ho.locales_dir   = ho.resources_dir / "locales";
     ho.cache_dir     = derive_cache_dir(opts.workshop_id);
     if (opts.remote_debugging_port > i32()) {
         ho.enable_remote_debugging = true;
-- 
2.55.0

