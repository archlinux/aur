#!/bin/sh
set -euo pipefail

KDIALOG_OPTS=(
    --title "CachyOS EAC Reboot Helper"
)

if kdialog "${KDIALOG_OPTS[@]}" --warningcontinuecancel "Are you sure you want to <b>reboot</b> into CachyOS's EAC kernel."; then
    if ! EAC_BOOT_LOG=$(pkexec eac-setup boot); then
        kdialog "${KDIALOG_OPTS[@]}" --error "Could not reboot using the <tt>eac-setup</tt> tool :(<br>Run <tt>eac-setup</tt> from the terminal and/or check the <a href='https://wiki.cachyos.org/configuration/easy_anti_cheat'>CachyOS EAC wiki page</a>."
    fi
else
    exit 1
fi
