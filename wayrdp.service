# Run wayrdp as a user service so remote sessions survive shell restarts.

[Unit]
Description=Remote desktop over RDP for this Wayland session
# Start after the compositor's graphical session is ready.
After=graphical-session.target
PartOf=graphical-session.target
# Limit retries when configuration, such as the password, is missing.
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
# Support both local source installations and distribution packages.
ExecStart=wayrdp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
