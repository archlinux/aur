# Wires up NSS and the QR greeter, the same way the Debian postinst and RPM
# scriptlets do. Unlike them, this AUR package leaves PAM to the administrator:
# 'aad-tool configure-pam' puts pam_himmelblau first in the auth stack, so a
# successful Entra sign-in skips pam_shells, pam_nologin and pam_faillock there.
# Upstream's GDM keyring prelude ends gdm-password's auth stack the same way, so
# it is not applied either.
#
# Enabling units, reloading systemd and replaying tmpfiles are left to the
# pacman hooks shipped by systemd, so this script does not do any of that.

_configure_nss() {
    local conf=/etc/nsswitch.conf

    [ -f "$conf" ] || return 0

    sed -i '/^passwd:/ {/himmelblau/! s/$/ himmelblau/}' "$conf"
    sed -i '/^group:/ {/himmelblau/! s/$/ himmelblau/}' "$conf"
    sed -i '/^shadow:/ {/himmelblau/! s/$/ himmelblau/}' "$conf"
    sed -i '/^initgroups:/ {/himmelblau/! s/$/ himmelblau/}' "$conf"
}

_enable_extension() {
    cat > "$1" <<'EOF'
[org/gnome/shell]
enabled-extensions=['qr-greeter@himmelblau-idm.org']
EOF
}

_enable_greeter() {
    # The QR greeter is a GNOME Shell extension, and an extension stays inert
    # until it is named in the dconf databases the greeter and the session read.
    command -v dconf >/dev/null 2>&1 || return 0

    install -d /etc/dconf/profile

    if getent passwd gdm >/dev/null 2>&1; then
        if [ ! -f /etc/dconf/profile/gdm ]; then
            printf '%s\n' 'user-db:user' 'system-db:gdm' \
                'file-db:/usr/share/gdm/greeter-dconf-defaults' \
                > /etc/dconf/profile/gdm
        fi

        install -d /etc/dconf/db/gdm.d
        _enable_extension /etc/dconf/db/gdm.d/01-himmelblau-qr-greeter
    fi

    # The same extension draws the QR code on the lock screen of a running
    # session, which reads the local database instead of the greeter one.
    if [ ! -f /etc/dconf/profile/user ]; then
        printf '%s\n' 'user-db:user' 'system-db:local' > /etc/dconf/profile/user
    fi

    install -d /etc/dconf/db/local.d
    _enable_extension /etc/dconf/db/local.d/01-himmelblau-qr-greeter

    dconf update || echo "warning: 'dconf update' failed, the QR greeter is not enabled"
}

_disable_greeter() {
    rm -f /etc/dconf/db/gdm.d/01-himmelblau-qr-greeter \
        /etc/dconf/db/local.d/01-himmelblau-qr-greeter

    if command -v dconf >/dev/null 2>&1; then
        dconf update || :
    fi
}

_system_changes() {
    cat <<'EOF'
This package changes system configuration:
  - /etc/nsswitch.conf: himmelblau added to passwd, group, shadow, initgroups
  - dconf (if installed): enables the QR greeter GNOME extension
  - /etc/ssh/sshd_config.d/30-himmelblau.conf: keyboard-interactive login,
    effective when sshd restarts
  - Chrome/Chromium managed policy: force-installs the Entra SSO extension
To opt out of the sshd or browser changes, edit those files rather than
deleting them (an empty policy is {}); pacman keeps your edits on upgrade.

PAM is not configured. Preview the change, then apply it:
    aad-tool configure-pam
    aad-tool configure-pam --really
It puts pam_himmelblau first in system-auth and system-login, so a successful
Entra sign-in skips pam_shells, pam_nologin and pam_faillock in the auth stage.
Review /etc/pam.d afterwards.
EOF
}

post_install() {
    _configure_nss
    _enable_greeter

    _system_changes
    cat <<'EOF'

Set your Entra ID domain in /etc/himmelblau/himmelblau.conf, then start the
daemons:

    systemctl enable --now himmelblaud himmelblaud-tasks
EOF
}

post_upgrade() {
    _configure_nss
    _enable_greeter

    # Versions before 4.0.8 had no install script, so these edits are new.
    if [ "$(vercmp "$2" 4.0.8)" -lt 0 ]; then
        _system_changes
        echo "Upgrades repeat the nsswitch and dconf steps."
        echo
    fi

    echo "Restart the daemons to run the new version:"
    echo "    systemctl try-restart himmelblaud himmelblaud-tasks"
}

post_remove() {
    _disable_greeter

    echo "The pam_himmelblau.so lines in /etc/pam.d and the himmelblau entries in"
    echo "/etc/nsswitch.conf are left in place, remove them by hand if Entra ID"
    echo "logon is no longer wanted."
}
