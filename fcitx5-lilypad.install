post_install() {
  echo ":: ==================================================================="
  echo ":: [fcitx5-lilypad] KÍCH HOẠT DỊCH VỤ / SERVICE ACTIVATION (1-TIME):"
  echo ":: Vui lòng chạy lệnh sau để bật daemon xóa uinput và nạp lại Fcitx5:"
  echo "::"
  echo "::   sudo systemctl enable --now fcitx5-lilypad-server@\$USER.service"
  echo "::   fcitx5 -r -d"
  echo ":: ==================================================================="
}

post_upgrade() {
  echo ":: [fcitx5-lilypad] Cập nhật hoàn tất! Khởi động lại daemon và Fcitx5 nếu cần:"
  echo "::   sudo systemctl restart fcitx5-lilypad-server@\$USER.service"
  echo "::   fcitx5 -r -d"
}
