post_install() {
    cat <<EOF

==> Hyprland users: Perssua's transparent overlay triggers backdrop blur,
    making content underneath look fuzzy. To disable blur for Perssua only,
    add the following line to your hyprland.conf:

        source = /usr/share/perssua/hyprland-perssua.conf

EOF
}

post_upgrade() {
    post_install
}
