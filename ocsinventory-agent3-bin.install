post_install() {
    echo "Point the agent to your OCS Inventory 3.x server: set url, username,"
    echo "password and mode (1 or 2) in /etc/ocsinventory-agent/config.json."
    echo "Then start the daemon:"
    echo "    systemctl enable --now ocsinventory-agent3.service"
    echo
    echo "The server has no inventory template for Arch Linux, and mode 1 needs"
    echo "one. /usr/share/ocsinventory-agent3/ holds two: linux-arch-template.json"
    echo "for the usual inventory, and linux-arch-extended-template.json, which"
    echo "adds processes, cron tasks, firewall rules, certificates, uptime and"
    echo "TeamViewer. Copy one to the computer you browse the web console from,"
    echo "then, once, under Configurations:"
    echo "  - Templates: import the file as a new template;"
    echo "  - Software mapping: map the NAME, PUBLISHER, VERSION, MAJOR, MINOR"
    echo "    and PATCH fields of its SOFTWARES section;"
    echo "  - Rules: assign it to the assets whose osname matches (?i)(Arch)."
}
