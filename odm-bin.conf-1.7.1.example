# /etc/odm/config.conf
# Global default configuration for ODM (Oryn Download Manager).
#
# Key names match the CLI long-flags without the leading `--`.
# Format: key = value, one option per line, `#` starts a comment.
# Precedence: CLI flags > ~/.config/odm/config.conf > this
# file > hardcoded defaults. Copy to /etc/odm/config.conf (root:root, 0644) to
# install as the system config, or to ~/.config/odm/config.conf per-user.

# --- Balancer ----------------------------------------------------------
connections        = 5          # total parallel-connection budget (-c)
max-connections    = 32         # ceiling; exceeding warns, doesn't error
split-file         =            # connections per file in batch mode (unset = 1 each)

# --- Inputs / output --------------------------------------------------------
# dir                 = /home/user/Downloads   # destination directory (-d)
# output              = <only single-file mode>

# --- HTTP / network ---------------------------------------------------------
max-redirect        = 5          # redirect hops to follow
retry                = 3          # retries per segment on failure
retry-wait           = 2          # delay between retries (seconds)
timeout              = 30         # dial+headers timeout (seconds)
# user-agent          = odm/1.0
# header              = Key: value    # repeatable; or use -H on the CLI
# load-cookies        = ~/cookies.txt # Netscape cookies.txt → Cookie header
# referer             =
# proxy               =              # http/https/socks5
check-certificate    = true       # verify TLS

# --- Integrity / rate ------------------------------------------------------
# checksum              = sha256:<hex>   # verify md5/sha1/sha256
# checksum-url          = https://host/file.sha256   # fetch the digest from a sidecar URL
# mirror                = https://mirror.example/same-file.iso  # repeatable; same file, chunks rotate
# limit-rate            =              # global speed limit, e.g. 5M or 500K
# limit-rate-per-task   =              # per-task speed cap (stacked on global), e.g. 2M
# chunk-size            = 4M           # work-stealing chunk size

# --- Engine profile ---------------------------------------------------------
# profile             = odm        # odm | aria2c | both | smart
# split               = 5          # aria2c: segments per file (--split)
# min-split-size      = 20M        # aria2c: don't split ranges < 2x this
# max-connection-per-server = 1    # aria2c (-x): per-server cap in h1 fallback

# --- Behaviour -------------------------------------------------------------
continue             = true       # resume via the .odm control file (-x)
quiet                = false      # disable the progress bar (cron/scripts)
# dry-run             = true       # probe + show the plan, download nothing
# auto-rename         = true       # existing destination → name.<N>.ext (exclusive with skip-existing)
# skip-existing       =            # skip files already present with a matching size
# session-log         = /tmp/odm-session.jsonl   # JSONL progress/summary events for wrappers

# --- RPC -------------------------------------------------------------
rpc                  = false      # run as the RPC server (daemon)
rpc-listen-port      = 6900
rpc-listen-all       = false      # bind 0.0.0.0 (default 127.0.0.1)
rpc-secret           =            # auth token; pair with --rpc-listen-all
# rpc-tls-cert       = /etc/odm/odm.crt   # TLS cert (PEM); enables HTTPS
# rpc-tls-key        = /etc/odm/odm.key   # TLS key (PEM); requires --rpc-tls-cert

# --- Logging ---------------------------------------------------------------
# log                  = /var/log/odm.log
log-level            = info       # debug / info / warn / error
