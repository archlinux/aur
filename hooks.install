post_install() {
    modprobe uinput

    udevadm control --reload-rules
    udevadm trigger

    YELLOW='\e[1;33m'
    RESET='\e[0m'
    echo -e "\n${YELLOW}IMPORTANT${RESET}: start service after install: systemctl --user enable --now xr-driver.service\n"
}

post_upgrade() {
    udevadm control --reload-rules
    udevadm trigger
}
