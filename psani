#!/bin/sh
#
# Skript na spousteni programu psani-profi
#
# Program pracuje vyhradne v kodovani ISO-8859-2. Na UTF-8 terminalech
# se proto spousti pres luit, ktery prevadi vystup i vstup mezi
# ISO-8859-2 a UTF-8. Program navic potrebuje, aby byla v systemu
# vygenerovana locale cs_CZ nebo sk_SK v kodovani ISO-8859-2.

prog=/usr/lib/psani-profi/psani-profi

lang=$(locale -a | grep -m1 -iE '^(cs_CZ|sk_SK)\.iso-?8859-?2$')
if [ -z "$lang" ]; then
  echo "Chybi locale cs_CZ.ISO-8859-2 (nebo sk_SK.ISO-8859-2)." >&2
  echo "Odkomentujte radek 'cs_CZ ISO-8859-2' v /etc/locale.gen" >&2
  echo "a spustte (jako root) prikaz locale-gen." >&2
  exit 1
fi

unset LANGUAGE
export LC_ALL="$lang"

case $(LC_ALL= locale charmap 2>/dev/null) in
  ISO-8859-2) exec "$prog" "$@" ;;
  *)          exec luit -encoding ISO-8859-2 -- "$prog" "$@" ;;
esac
