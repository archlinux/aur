
## arg 1:  the new package version
post_install() {
  cat <<EOF

-----------------------------------------------------------------------------
oama version 0.13

redirect_uri can be configured on a per service basis.
The default is http://localhost:8080

-----------------------------------------------------------------------------

EOF
}

# arg 1:  the new package version
# arg 2:  the old package version
post_upgrade() {
	post_install
}

