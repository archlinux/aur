
## arg 1:  the new package version
post_install() {
  cat <<EOF

-----------------------------------------------------------------------------
oama version 0.13.1

The redirect_uri automatically generated as localhost with a free random
portnumber. There is no default redirect_uri but it is still can be configured
if a fixed portnumber is needed for whatever reason.

-----------------------------------------------------------------------------

EOF
}

# arg 1:  the new package version
# arg 2:  the old package version
post_upgrade() {
	post_install
}

