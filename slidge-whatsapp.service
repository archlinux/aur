[Unit]
Description=Whatsapp XMPP gateway
After=network.target
Wants=network.target
#Requires=prosody.service

[Service]
Type=simple
User=slidge
Group=slidge
UMask=0027
DynamicUser=yes
RuntimeDirectory=slidge-whatsapp
StateDirectory=slidge-whatsapp

Environment=PYTHONPATH=/opt/slidge-whatsapp/usr/lib/python3.14/site-packages/
ExecStart=/opt/slidge-whatsapp/usr/bin/slidge-whatsapp -c /etc/slidge-whatsapp.ini

StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateTmp=true
MountFlags=private
NoNewPrivileges=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
