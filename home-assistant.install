
post_upgrade() {
  if [ "$(vercmp "$2" 1:2026.7.1-2)" -le 0 ]; then
    echo "==> Note: To prevent errors caused by stale dependencies, the systemd"
    echo "==> service will now automatically recreate the Python virtual"
    echo "==> environment (/var/lib/hass/.venv) upon major Home Assistant"
    echo "==> version upgrades (YYYY.MM). The first startup after a major"
    echo "==> upgrade may take slightly longer to download dependencies."
  fi

  if [ "$(vercmp "$2" 1:2026.7.2-3)" -lt 0 ]; then
    for dir in /var/lib/hass /var/log/hass; do
      if [ -d "$dir" ]; then
        chmod -R g-w,o-rwx "$dir"
      fi
    done
    echo "==> Note: permissions on /var/lib/hass and /var/log/hass have been"
    echo "==> tightened so other local users can no longer read Home Assistant"
    echo "==> credentials, logs and history data. If you read these files as"
    echo "==> another user, add that user to the 'hass' group."
  fi

  return 0
}
