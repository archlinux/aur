[Unit]
Description=Qingjian Input Method Server (Rust Backend)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qingjian-linux-server
Restart=on-failure
RestartSec=2
Environment=QINGJIAN_RESOURCES=/usr/share/qingjian/resources

[Install]
WantedBy=graphical-session.target
