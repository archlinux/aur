From 39a0f9077daca21a62adaa975eb6a03bda499f27 Mon Sep 17 00:00:00 2001
From: josephsellers <6892567+josephsellers@users.noreply.github.com>
Date: Thu, 17 Sep 2026 13:19:25 +0100
Subject: [PATCH 2/2] fix: GNOME 51 St.BoxLayout orientation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GNOME 51 removed St.BoxLayout:vertical (gnome-shell !3614). Add
boxLayoutOrientation() so 51 constructs with orientation and 46–50
keep vertical. Declare shell-version 51.

A failed empty-state constructor previously rejected _buildMenu()
with no catch, so the clipboard listener never started.

[Used Grok Build 🤖]
---
 compat.js        | 25 +++++++++++++++++++++++++
 confirmDialog.js |  7 +++----
 extension.js     |  7 ++++---
 metadata.json    |  3 ++-
 4 files changed, 34 insertions(+), 8 deletions(-)
 create mode 100644 compat.js

diff --git a/compat.js b/compat.js
new file mode 100644
index 00000000..83522d7d
--- /dev/null
+++ b/compat.js
@@ -0,0 +1,25 @@
+import Clutter from 'gi://Clutter';
+import * as Config from 'resource:///org/gnome/shell/misc/config.js';
+
+const SHELL_VERSION = Number.parseInt(Config.PACKAGE_VERSION.split('.')[0], 10);
+
+/**
+ * Constructor props for a vertical or horizontal St.BoxLayout.
+ *
+ * GNOME 51 removed St.BoxLayout:vertical in favour of :orientation
+ * (gnome-shell !3614). Keep `vertical` on 46–50 so those shells still
+ * construct.
+ *
+ * @param {boolean} [vertical=true]
+ * @returns {object}
+ */
+export function boxLayoutOrientation(vertical = true) {
+    if (SHELL_VERSION >= 51) {
+        return {
+            orientation: vertical
+                ? Clutter.Orientation.VERTICAL
+                : Clutter.Orientation.HORIZONTAL,
+        };
+    }
+    return { vertical };
+}
