post_install() {
    echo ":: NOTE: upstream renamed 'deepseek' to 'codewhale' (v0.9.0)."
    echo "   If present, you may remove old binaries:"
    echo "     rm /usr/bin/deepseek /usr/bin/deepseek-tui"
    echo "   and old completions:"
    echo "     rm /usr/share/bash-completion/completions/deepseek"
    echo "     rm /usr/share/zsh/site-functions/_deepseek"
    echo "     rm /usr/share/fish/vendor_completions.d/deepseek.fish"
}

post_upgrade() {
    post_install
}
