# The syslog receiver (docs/syslog.md) as a systemd service, configured in
# /etc/openchronology/syslog.env (Debian and RPM packages).
[Unit]
Description=OpenChronology syslog receiver
Documentation=file:///usr/share/doc/openchronology-server/README.Debian
After=network.target openchronology.service

[Service]
Type=simple
User=openchronology
Group=openchronology
EnvironmentFile=/etc/openchronology/syslog.env
Environment=NODE_ENV=production
WorkingDirectory=/usr/lib/openchronology
ExecStart=/usr/lib/openchronology/node/bin/node server/syslog-receiver.mjs
Restart=on-failure
# Node exits with 128 + SIGTERM when stopped; that is a clean stop, not a failure.
SuccessExitStatus=143
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
