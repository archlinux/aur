## 监听端口号，按需修改，默认8080
#PORT=8080

## 访问密钥，按需配置，若部署在本地则没有配置的必要
#TOKEN=""

## 数据库服务地址，按需配置。
## 默认使用file::memory:?cache=shared为参数的sqlite内存模式，但是数据非永久。
## 当传入的是文件名（如library.db）等字符串时，则会使用sqlite作为数据库引擎。
## 如果传入的是^postgres(ql)?://开头的链接，则会使用postgres作为数据库引擎。
#DSN=""

## 最大空闲数据库连接数，建议使用默认值
#DB_MAX_IDLE_CONNS=0

## 	最大数据库连接数，建议使用默认值
#DB_MAX_OPEN_CONNS=0

## Prepared Statement，建议使用默认值
#DB_PREPARED_STMT=false

## 该选项会自动创建数据表，第一次使用时需要设置为true，第二次及以后启动请务必修改为默认值false
#DB_AUTO_MIGRATE=false

## 请求超时时长，默认一分钟
#REQUEST_TIMEOUT=1m
