# systemd unit for a bare-binary install.
#
#   install -m 0755 tephro-<version>-linux-amd64 /usr/local/bin/tephro-server
#   useradd --system --home /var/lib/tephro --create-home --shell /usr/sbin/nologin tephro
#   install -m 0644 tephro-server.service /etc/systemd/system/
#   systemctl enable --now tephro-server
#
# AmbientCapabilities grants the bind to port 443 without setcap on the
# binary, so replacing the binary on upgrade does not lose it. Set
# TEPHRO_LISTEN or edit /var/lib/tephro/tephro.toml to listen elsewhere.
# `systemctl reload tephro-server` re-reads tephro.toml for the settings that can
# change live (the log names the rest, which need a restart).
# `sudo tephro-server admin upgrade` replaces /usr/local/bin/tephro-server with the newest
# signed release and the service re-executes it in place, same main PID.
# `tephro-server admin restart` does the re-exec on its own. ProtectSystem=strict
# is why the swap runs outside the unit.

[Unit]
Description=Tephro server
Documentation=https://gitlab.com/encenillo/tephro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tephro
Group=tephro
Environment=TEPHRO_DATA_DIR=/var/lib/tephro
Environment=TEPHRO_LISTEN=0.0.0.0:443
ExecStart=/usr/local/bin/tephro-server serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tephro
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
