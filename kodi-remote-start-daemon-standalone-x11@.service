[Unit]
Description=Daemon for starting the kodi-x11 standalone service from remote control apps like KORE, Kodi Remote, or Yatse (Port %i)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/kodi-remote-start-daemon %i kodi-x11.service
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
