[Unit]
Description=dropwatch
Documentation=https://github.com/carnager/dropwatch
Wants=network-online.target
After=network-online.target

[Service]
Environment=DROPWATCH_ADDR=127.0.0.1:8080
EnvironmentFile=-/etc/dropwatch.env
ExecStart=/usr/bin/dropwatch -addr ${DROPWATCH_ADDR} -db /var/lib/dropwatch/dropwatch.db -dump-dir /var/lib/dropwatch/dumps
User=dropwatch
Group=dropwatch
StateDirectory=dropwatch
StateDirectoryMode=0750
WorkingDirectory=/var/lib/dropwatch
Restart=on-failure
RestartSec=5

CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateUsers=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
UMask=0027

[Install]
WantedBy=multi-user.target
