From 64f1338f6dbbdca71ccc16559eb6e6ab80f01f68 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Sun, 12 Jul 2026 21:33:17 +0800
Subject: [PATCH 4/6] cmake: Use system quickjs-ng

---
 CMakeLists.txt |  1 +
 deps.json      | 12 ------------
 2 files changed, 1 insertion(+), 12 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 848fca3..c60e711 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -37,6 +37,7 @@ find_package(PkgConfig REQUIRED)
 find_package(Threads REQUIRED)
 find_package(Eigen3 3.4.0 REQUIRED)
 find_package(argparse REQUIRED)
+find_package(qjs REQUIRED) # >= 0.14.0 in deps.json, but version is not supported in extra/quickjs-ng
 
 if(CMAKE_USE_PTHREADS_INIT)
     # Clang records pthread support in C++ module BMIs; keep all module targets compatible.
diff --git a/deps.json b/deps.json
index 115aa3c..c7cae1c 100644
--- a/deps.json
+++ b/deps.json
@@ -42,17 +42,5 @@
       "name": "wavsen",
       "exclude_from_all": true
     }
-  },
-  {
-    "dest": "build/_flatpak_deps/quickjs-src",
-    "disable-shallow-clone": false,
-    "tag": "v0.14.0",
-    "commit": "3c051980ab7e783dfbfb1c70c014ce5e05ecf24c",
-    "type": "git",
-    "url": "https://github.com/quickjs-ng/quickjs.git",
-    "x-cmake": {
-      "name": "quickjs",
-      "exclude_from_all": true
-    }
   }
 ]
