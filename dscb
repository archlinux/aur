TOKEN_SPECIFICATION = [
    ('COMMENT_BLOCK', r'/\*[\s\S]*?\*/'),
    ('COMMENT_LINE',  r'(//|#)[^\n]*'),
    ('STRING',        r'"""[\s\S]*?"""|\'\'\'[\s\S]*?\'\'\'|"(?:[^"\\]|\\.)*"|\'(?:[^\'\\]|\\.)*\''),
    ('ARROW',         r'=>'),
    ('EQ_COMPARE',    r'=='),
    ('NE_COMPARE',    r'!='),
    ('LTE',           r'<='),
    ('GTE',           r'>='),
    ('PLUSEQ',        r'\+='),
    ('MINUSEQ',       r'-='),
    ('AMP_AMP',       r'&&'),
    ('PIPE_PIPE',     r'\|\|'),
    ('HEX_NUMBER',    r'0x[0-9a-fA-F]+'),
    ('FLOAT_NUMBER',  r'\d+\.\d+'),
    ('INT_NUMBER',    r'\d+'),
    ('KEYWORD',       r'\b(command|slash|on|task|embed|var|let|fn|func|function|if|else|while|for|in|break|continue|return|reply|send|kick|ban|unban|mute|timeout|unmute|purge|dm|sleep|python|py|true|false|null|none|and|or|not)\b'),
    ('IDENTIFIER',    r'[a-zA-Z_][a-zA-Z0-9_]*'),
    ('EQUALS',        r'='),
    ('PLUS',          r'\+'),
    ('MINUS',         r'-'),
    ('STAR',          r'\*'),
    ('SLASH',         r'/'),
    ('PERCENT',       r'%'),
    ('LT',            r'<'),
    ('GT',            r'>'),
    ('BANG',          r'!'),
    ('DOT',           r'\.'),
    ('COMMA',         r','),
    ('COLON',         r':'),
    ('SEMICOLON',     r';'),
    ('LPAREN',        r'\('),
    ('RPAREN',        r'\)'),
    ('LBRACE',        r'\{'),
    ('RBRACE',        r'\}'),
    ('LBRACKET',      r'\['),
    ('RBRACKET',      r'\]'),
    ('NEWLINE',       r'\n'),
    ('WHITESPACE',    r'[ \t\r\xa0]+'),
    ('MISMATCH',      r'.'),
]

class Token:
    def __init__(self, type_name, value, line, column):
        self.type, self.value, self.line, self.column = type_name, value, line, column
    def __repr__(self): return f"Token({self.type}, {repr(self.value)}, L{self.line}:C{self.column})"

class Lexer:
    def __init__(self, source_code):
        cleaned = source_code.replace('“', '"').replace('”', '"').replace('‘', "'").replace('’', "'").replace('—', '-').replace('–', '-')
        self.source_code, self.tokens = cleaned, []

    def tokenize(self):
        pos, line_number, line_start = 0, 1, 0
        master_pattern = re.compile('|'.join(f'(?P<{name}>{pattern})' for name, pattern in TOKEN_SPECIFICATION))
        py_block_pattern = re.compile(r'\b(python|py)\s*\{')

        while pos < len(self.source_code):
            py_match = py_block_pattern.match(self.source_code, pos)
            if py_match:
                col_number = pos - line_start + 1
                search_pos = py_match.end()
                start_code = search_pos
                brace_depth = 1
                in_quote = None
                while search_pos < len(self.source_code) and brace_depth > 0:
                    ch = self.source_code[search_pos]
                    if in_quote:
                        if ch == '\\': search_pos += 2; continue
                        elif self.source_code.startswith(in_quote, search_pos):
                            search_pos += len(in_quote); in_quote = None; continue
                    else:
                        if self.source_code.startswith(('"""', "'''"), search_pos):
                            in_quote = self.source_code[search_pos:search_pos+3]; search_pos += 3; continue
                        elif ch in ('"', "'"): in_quote = ch
                        elif ch == '{': brace_depth += 1
                        elif ch == '}':
                            brace_depth -= 1
                            if brace_depth == 0: break
                    search_pos += 1

                raw_python_code = self.source_code[start_code:search_pos]
                self.tokens.append(Token('PYTHON_BLOCK', raw_python_code, line_number, col_number))
                newlines = self.source_code[pos:search_pos+1].count('\n')
                line_number += newlines
                if newlines > 0: line_start = self.source_code.rfind('\n', pos, search_pos+1) + 1
                pos = search_pos + 1
                continue

            match = master_pattern.match(self.source_code, pos)
            if not match: pos += 1; continue
            token_type, token_value = match.lastgroup, match.group()
            col_number = match.start() - line_start + 1

            if token_type == 'NEWLINE':
                line_number += 1; line_start = match.end(); pos = match.end(); continue
            elif token_type in ('WHITESPACE', 'COMMENT_LINE', 'COMMENT_BLOCK'):
                if '\n' in token_value:
                    newlines = token_value.count('\n')
                    line_number += newlines
                    line_start = match.end() - len(token_value.split('\n')[-1])
                pos = match.end(); continue
            elif token_type == 'STRING':
                if token_value.startswith(('"""', "'''")): token_value = token_value[3:-3]
                elif token_value.startswith(('"', "'")): token_value = token_value[1:-1]
                token_value = bytes(token_value, "utf-8").decode("unicode_escape", errors="ignore")
            elif token_type == 'MISMATCH': pos = match.end(); continue

            self.tokens.append(Token(token_type, token_value, line_number, col_number))
            pos = match.end()
        return self.tokens

