class ReturnSignal(Exception):
    def __init__(self, value): self.value = value

class BreakSignal(Exception): pass
class ContinueSignal(Exception): pass

# ==============================================================================
# SECTION 1: PERSISTENT STORAGE ENGINE
# ==============================================================================
class DSLDatabase:
    def __init__(self, db_path="/tmp/dscb_database.json"):
        self.db_path = db_path
        self._lock = asyncio.Lock()
        self.data = self._load_from_disk()

    def _load_from_disk(self):
        if os.path.exists(self.db_path):
            try:
                with open(self.db_path, "r", encoding="utf-8") as f: return json.load(f)
            except Exception: return {}
        return {}

    def save(self):
        try:
            with open(self.db_path, "w", encoding="utf-8") as f: json.dump(self.data, f, indent=4, ensure_ascii=False)
        except Exception as err: print(f"[DB ERROR] Failed to save database: {err}")

    def get(self, key, default=None): return self.data.get(str(key), default)
    def set(self, key, value): self.data[str(key)] = value; self.save()
    def delete(self, key):
        if str(key) in self.data:
            del self.data[str(key)]
            self.save()
            return True
        return False
    def all(self): return self.data.copy()

