Subject: [PATCH] fix(service): use the global path

---
 contrib/wtfi-record.service | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/contrib/wtfi-record.service b/contrib/wtfi-record.service
index 766f482..69d3ae9 100644
--- a/contrib/wtfi-record.service
+++ b/contrib/wtfi-record.service
@@ -3,7 +3,7 @@ Description=wtfi background recorder
 After=network.target
 
 [Service]
-ExecStart=%h/.cargo/bin/wtfi --record --every 30s
+ExecStart=/usr/bin/wtfi --record --every 30s
 StandardOutput=null
 Restart=always
 RestartSec=10
