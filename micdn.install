post_install() {
  if [ ! -f /etc/micdn/micdn.xml ]; then
    install -dm755 /etc/micdn
    cp /usr/share/micdn/micdn.xml.default /etc/micdn/micdn.xml
    chmod 0644 /etc/micdn/micdn.xml
  fi

  systemd-sysusers micdn.conf 2>/dev/null || :
  systemd-tmpfiles --create micdn.conf 2>/dev/null || :

  # 兜底：sysusers 解析失败或未生效时，确保服务依赖的 micdn/beangle 存在
  if ! getent group beangle >/dev/null 2>&1; then
    groupadd -r beangle 2>/dev/null || :
  fi
  if ! getent passwd micdn >/dev/null 2>&1; then
    useradd -r -g beangle -d /var/lib/micdn -s /usr/sbin/nologin \
      -c "Micdn CDN server" micdn 2>/dev/null || :
  fi

  if [ -d /var/lib/micdn ]; then
    chown -R micdn:beangle /var/cache/micdn /var/lib/micdn /var/log/micdn 2>/dev/null || :
    chmod 2775 /var/cache/micdn /var/cache/micdn/asset /var/cache/micdn/www 2>/dev/null || :
    chmod 2775 /var/lib/micdn /var/lib/micdn/blob /var/lib/micdn/maven \
      /var/lib/micdn/npm /var/lib/micdn/local 2>/dev/null || :
    chmod 2775 /var/log/micdn 2>/dev/null || :
  fi

  systemctl daemon-reload 2>/dev/null || :
}

post_upgrade() {
  post_install

  if [ -f /etc/micdn/micdn.xml ] && grep -q 'doc location=' /etc/micdn/micdn.xml 2>/dev/null; then
    echo "注意: v0.2.3 起 www <doc> 改为 name + npm|dir|zip 属性，并可选 try-file。"
    echo "      请对照 docs/release-v0.2.3.md 或 CHANGELOG 手动迁移 /etc/micdn/micdn.xml"
  fi

  if [ -f /etc/micdn/micdn.xml ] && grep -qE '<doc[^>]*dir="|<doc[^>]*try-file="[^"]*/' /etc/micdn/micdn.xml 2>/dev/null; then
    echo "注意: v0.3.0 起 www <doc> 不再支持 dir 挂载，try-file 不接受含 / 的路径（重复 doc name 会报错）。"
    echo "      请对照 docs/release-v0.3.0.md 迁移 /etc/micdn/micdn.xml 后重启服务"
  fi
}

pre_remove() {
  if [ "$1" -eq 0 ]; then
    systemctl stop micdn.service 2>/dev/null || :
  fi
}

post_remove() {
  systemctl daemon-reload 2>/dev/null || :
}
