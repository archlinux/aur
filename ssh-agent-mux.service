[Unit]
Description=Combine keys from multiple SSH agents into a single unified socket
Documentation=https://github.com/overhacked/ssh-agent-mux
After=gpg-agent.socket ssh-agent.socket

[Service]
Type=simple
# ssh-agent-mux usuwa socket przy gracznym wyjściu (SIGTERM), ale jeśli proces
# zginął nieczysto (SIGKILL/crash/OOM), stale socket zostaje i kolejne restarty
# failują na bind() z "Address already in use" -> restart-loop. Usuń przed startem.
# Dotyczy domyślnej ścieżki; przy własnym listen_path dostosuj poniższą linię.
ExecStartPre=-/usr/bin/rm -f %h/.ssh/ssh-agent-mux.sock
ExecStart=/usr/bin/ssh-agent-mux
# Restart=always (nie on-failure): mux potrafi zakończyć się czystym exit 0
# (np. race przy starcie sesji), a on-failure NIE podnosi go po exit 0.
# Jako daemon-multiplekser mux ma zawsze żyć — always podnosi go z każdego
# padnięcia, a ExecStartPre powyżej czyści stale socket przed bind().
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
