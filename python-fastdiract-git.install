post_install() {
	echo 'To enable fastdiract, add the following to your ~/.bashrc:'
	echo '  source /usr/share/fastdiract-git/definitions'
	echo 'fastactions and fastvim require Python; fzf is required for context switching.'
	echo 'If you are upgrading from an older version, run migrate.sh from /usr/share/fastdiract-git/.'
	echo 'Customization: /usr/share/doc/fastdiract-git/README.md'
}
