post_install() {
  cat <<'MSG'
==> Scuffed Stat Tracker installed.
==> 1. Add yourself to the input group for the Tab hotkey, then log out and in:
==>      sudo usermod -aG input "$USER"
==> 2. Start it and turn on autostart (as your user, not root):
==>      systemctl --user daemon-reload
==>      systemctl --user enable --now scuffed-stat-tracker.service
==> 3. Open "Scuffed Stat Tracker" from the app menu.
==> Updates come through your AUR helper. Ignore the in-app curl update command.
MSG
}

post_upgrade() {
  cat <<'MSG'
==> Restart the tracker to use the new version:
==>      systemctl --user daemon-reload
==>      systemctl --user restart scuffed-stat-tracker.service
MSG
}
