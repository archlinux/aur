[Desktop Entry]
Name=Teams for Linux (School)
Exec=/usr/bin/env bash -c "/opt/teams-for-linux/teams-for-linux --class=teams-work --user-data-dir=$HOME/.config/teams-profile-school --appIcon=/usr/share/icons/hicolor/512x512/apps/teams-for-linux-school-profile.png"
Terminal=false
Type=Application
Icon=teams-for-linux-school-profile
StartupWMClass=teams-school
Comment=Unofficial Microsoft Teams client for Linux using Electron. It uses the Web App and wraps it as a standalone application using Electron.
MimeType=x-scheme-handler/msteams;
Categories=Chat;Network;Office;
