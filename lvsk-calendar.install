#!/usr/bin/env bash

post_install() {
    cat <<'EOF'

                       |               |
                       | \ \   /  __|  |  /
                       |  \ \ / \__ \    <
                      _|   \_/  ____/ _|\_\

    ─────────────────────────────────────────────────────────

     lvsk-calendar
     minimalist terminal calendar

    ─────────────────────────────────────────────────────────

    🚀 Quick Start

       lvsk-calendar              → open in current terminal
       lvsk-calendar-launcher     → floating window (Hyprland)
       lvsk-calendar --help       → CLI options

    ⌨️  Navigation

       ↑↓←→  or  hjkl    → navigate
       [  ]              → previous/next month
       {  }              → previous/next year
       t                 → jump to today
       a / e / d         → add / edit / delete event
       q                 → quit

    📚 Resources

       Repository: github.com/Gianluska/lvsk-calendar
       Issues: github.com/Gianluska/lvsk-calendar/issues

    ─────────────────────────────────────────────────────────

                    Made with ❤️ from Brazil

    ─────────────────────────────────────────────────────────

EOF
}

post_upgrade() {
    cat <<'EOF'

                       |               |
                       | \ \   /  __|  |  /
                       |  \ \ / \__ \    <
                      _|   \_/  ____/ _|\_\

    ─────────────────────────────────────────────────────────

     ✨ lvsk-calendar updated

     💡 Tip: Check ~/.config/lvsk-calendar/config for new
        customization options, and `lvsk-calendar --version`
        for the installed version.

    ─────────────────────────────────────────────────────────

EOF
}

post_remove() {
    cat <<'EOF'

                       |               |
                       | \ \   /  __|  |  /
                       |  \ \ / \__ \    <
                      _|   \_/  ____/ _|\_\

    ─────────────────────────────────────────────────────────

     lvsk-calendar has been removed

    ─────────────────────────────────────────────────────────

     Your data is still preserved at:
     ~/.config/lvsk-calendar/       (configuration)
     ~/.local/share/lvsk-calendar/  (your events)
     ~/.cache/lvsk-calendar/        (holiday cache)

     To completely remove all files:
     rm -rf ~/.config/lvsk-calendar \
            ~/.local/share/lvsk-calendar \
            ~/.cache/lvsk-calendar

    ─────────────────────────────────────────────────────────

     Thanks for using lvsk-calendar! 🙏

    ─────────────────────────────────────────────────────────

EOF
}

# vim:set ts=4 sw=4 et:
