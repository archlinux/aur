post_install() {
    cat <<'EOF'
haraltr installed!

Start the daemon with:
sudo systemctl enable --now haraltrd.service

EOF
}

post_remove() {
    echo "/etc/haraltr/config.toml may remain — remove manually if no longer needed."
    echo "If you added pam_haraltr.so to files under /etc/pam.d/, remove those lines."
}
