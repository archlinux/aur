post_install() {
    echo "Setting capabilities on sing-box binary to allow tunnel creation without sudo..."
    setcap cap_net_admin=eip /opt/happ-desktop/usr/bin/tun/sing-box
    if [ $? -eq 0 ]; then
        echo "Capabilities set successfully on /opt/happ-desktop/usr/bin/tun/sing-box"
    else
        echo "Warning: Failed to set capabilities on sing-box binary"
        echo "You may need to run manually: sudo setcap cap_net_admin=eip /opt/happ-desktop/usr/bin/tun/sing-box"
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "Removing capabilities from sing-box binary..."
    setcap -r /opt/happ-desktop/usr/bin/tun/sing-box 2>/dev/null || true
}