post_install() {
    echo "Setting permissions for routing directory..."
    chmod -R 1777 /opt/happ/bin/core/routing/
    
    echo "Enabling and starting happd service..."
    systemctl daemon-reload
    systemctl enable happd.service
    systemctl start happd.service
    echo "happd service has been enabled and started"
}

post_upgrade() {
    echo "Setting permissions for routing directory..."
    chmod -R 1777 /opt/happ/bin/core/routing/
    
    echo "Restarting happd service..."
    systemctl daemon-reload
    systemctl restart happd.service
    echo "happd service has been restarted"
}

pre_remove() {
    echo "Stopping and disabling happd service..."
    systemctl stop happd.service
    systemctl disable happd.service
    echo "happd service has been stopped and disabled"
}