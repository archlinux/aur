post_install() {
  desktop-file-edit --add-category="Game" /usr/share/applications/PD2\ Trader.desktop #missing Category
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  update-desktop-database -q
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  update-desktop-database -q
}
