+const HAS_SHADER_SOURCE = 'set_shader_source' in Clutter.ShaderEffect.prototype;
+let snippet = null;
+
+function getSnippet() {
+    if (!snippet) {
+        snippet = Cogl.Snippet.new(Cogl.SnippetHook.FRAGMENT, UNIFORMS, null);
+        snippet.set_post('cogl_color_out *= coverage();');
+    }
+    return snippet;
+}
