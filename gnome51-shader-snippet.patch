+// GNOME 46 to 50: the whole fragment shader, set per instance.
+const SHADER = `
+uniform sampler2D tex;
+${UNIFORMS}
+void main() {
+    cogl_color_out = texture2D(tex, cogl_tex_coord_in[0].xy) * coverage();
