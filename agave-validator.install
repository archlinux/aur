post_install() {
  setcap 'cap_net_raw,cap_net_admin,cap_bpf,cap_perfmon=ep' /usr/bin/agave-validator 2>/dev/null || true

  cat <<'EOF'

==> agave-validator: XDP capabilities have been set on the binary.
    For full XDP support you will also need to enable it at runtime.
    See: https://www.anza.xyz/blog/agave-xdp-setup-guide (You do not
    need to run setcap again.)

EOF
}

post_upgrade() {
  post_install
}
