_ainput_refresh_uinput() {
    # Load the module (it may not be in use yet) so the device exists, then
    # reload the rules and re-trigger the device. TAG+="uaccess" is applied by
    # systemd-logind at that point; `getfacl /dev/uinput` should then list a
    # `user:<you>:rw-` entry for the active local session.
    modprobe uinput >/dev/null 2>&1 || true
    udevadm control --reload >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput >/dev/null 2>&1 || true
}

post_install() {
    # /dev/uinput is a static node, and the rule that grants it to local
    # sessions (70-ainput-uinput.rules) was just installed. Reload udev so the
    # current session gets access without a reboot.
    _ainput_refresh_uinput
    echo "==> Ainput: defaults are built in. Settings live in fcitx5-configtool"
    echo "==> (Addons -> Ainput) and are stored in ~/.config/fcitx5/conf/ainput.conf."
    echo "==> Cloud providers: put your API key into ~/.config/ainput/qwen.json"
    echo "==> or doubao.json; the files are created on first start and are"
    echo "==> plaintext, so chmod 600 is recommended."
    printf '\033[1;31m==> Ainput: Local ASR models (zipformer/fire-red) must be downloaded separately.\033[0m\n'
    echo "==> See setup instructions: https://github.com/xander-lin/ainput#local-models-optional"
    echo "==> CapsLock restore uses /dev/uinput; restart fcitx5 to pick it up: fcitx5 -r"
}

post_upgrade() {
    post_install
}
