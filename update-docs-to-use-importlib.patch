From dc1186cc329008bcd29a2bdde034e9730a0180b4 Mon Sep 17 00:00:00 2001
From: Jason Straw <jason.straw@rackspace.com>
Date: Wed, 11 Dec 2024 15:43:38 -0600
Subject: [PATCH] Update docs to use importlib

---
 docs/conf.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/docs/conf.py b/docs/conf.py
index bebadd5..12e8596 100644
--- a/docs/conf.py
+++ b/docs/conf.py
@@ -1,7 +1,7 @@
 # -*- coding: utf-8 -*-
 from datetime import datetime
 
-import pkg_resources
+import importlib.metadata
 import sys
 import os
 
@@ -22,7 +22,7 @@ master_doc = "index"
 
 project = "pypuppetdb"
 copyright = "2013-%s, Vox Pupuli" % datetime.now().year
-version = pkg_resources.get_distribution(project).version
+version = importlib.metadata.version("pypuppetdb")
 release = version
 
 language = "en"
-- 
2.50.1

