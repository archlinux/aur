+def is_numpy_typing_ndarray(hint: object) -> bool:
+    '''
+    :data:`True` only if the passed object is the NumPy-specific
+    :obj:`numpy.typing.NDArray` type hint factory or a subscription of that
+    factory produced by NumPy >= 2.5.0.
+
+    NumPy >= 2.5.0 reimplemented this factory as a PEP 695-compliant type alias.
+    This tester intentionally avoids importing NumPy, which is an optional and
+    comparatively expensive dependency.
+    '''
+
+    hint_alias = hint
+    hint_alias_type = hint_alias.__class__
+    if not (
+        hint_alias_type.__qualname__ == 'TypeAliasType' and
+        hint_alias_type.__module__ in ('typing', 'typing_extensions')
+    ):
+        hint_alias = getattr(hint, '__origin__', None)
+
+        if hint_alias is None:
+            return False
+
+        hint_alias_type = hint_alias.__class__
+
+    return (
+        hint_alias_type.__qualname__ == 'TypeAliasType' and
+        hint_alias_type.__module__ in ('typing', 'typing_extensions') and
+        getattr(hint_alias, '__name__', None) == 'NDArray' and
+        getattr(hint_alias, '__module__', '').startswith('numpy.') and
+        repr(getattr(hint_alias, '__value__', None)).startswith(
+            'numpy.ndarray[')
+    )
 
