#!/usr/bin/python3
"""Launch one immutable VS Code release while coordinating with its updater."""
from contextlib import ExitStack
import fcntl
import os
from pathlib import Path
import subprocess
import sys

BUNDLED = Path('/usr/lib/visual-studio-code-autoupdate/bundled')
ROOT = Path('/var/lib/visual-studio-code-autoupdate')


def main():
    if os.geteuid() == 0:
        raise SystemExit('Do not run VS Code as root.')
    with ExitStack() as stack:
        try:
            lock = stack.enter_context((ROOT / '.update.lock').open('rb'))
        except FileNotFoundError:
            release = BUNDLED.resolve(strict=True)
        else:
            fcntl.flock(lock, fcntl.LOCK_SH)
            current = ROOT / 'current'
            release = (current if (current / 'bin/code').is_file() else BUNDLED).resolve(strict=True)
        environment = os.environ.copy()
        environment['ELECTRON_RUN_AS_NODE'] = '1'
        # Popen returns after exec: /proc now exposes this release's executable.
        # close_fds prevents --wait or an editor child from retaining our lock.
        child = subprocess.Popen(
            [str(release / 'code'), str(release / 'resources/app/out/cli.js'), *sys.argv[1:]],
            env=environment, close_fds=True,
        )
    try:
        status = child.wait()
    except KeyboardInterrupt:
        return 130
    return status if status >= 0 else 128 - status


if __name__ == '__main__':
    sys.exit(main())
