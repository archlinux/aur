+    if (open == NULL)
+        goto fail;
+    open_end = strchr(open, '>');
+    if (open_end == NULL || open_end[-1] == '/' ||
+        (gsize)(open_end - contents->str) >= scope_end)
+        goto fail;
+    close = g_strstr_len(open_end + 1, scope_end - (gsize)(open_end + 1 - contents->str),
+                         close_tag);
+    if (close == NULL)
