+static gboolean element_content_bounds_by_attr(GString *contents, xmlNodePtr node,
+                                               const char *attr_name,
+                                               gsize *start, gsize *end)
+{
+    xmlChar *value;
+    char *open_tag;
+    char *double_attr;
+    char *single_attr;
+    char *close_tag;
+    char *search;
+
+    if (node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
+    value = xmlGetProp(node, BAD_CAST attr_name);
+    if (value == NULL)
+        return FALSE;
+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    double_attr = g_strdup_printf("%s=\"%s\"", attr_name, (const char *)value);
+    single_attr = g_strdup_printf("%s='%s'", attr_name, (const char *)value);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    for (search = contents->str; ; search++) {
+        char *open = g_strstr_len(search, contents->len - (gsize)(search - contents->str), open_tag);
+        char *open_end;
+        char *close;
+
+        if (open == NULL)
+            break;
+        open_end = strchr(open, '>');
+        if (open_end == NULL)
+            break;
+        if (g_strstr_len(open, open_end - open, double_attr) == NULL &&
+            g_strstr_len(open, open_end - open, single_attr) == NULL) {
+            search = open;
+            continue;
+        }
+        if (open_end[-1] == '/')
+            break;
+        close = g_strstr_len(open_end + 1,
+                             contents->len - (gsize)(open_end + 1 - contents->str),
+                             close_tag);
+        if (close == NULL)
+            break;
+        *start = (gsize)(open_end + 1 - contents->str);
+        *end = (gsize)(close - contents->str);
+        xmlFree(value);
+        g_free(open_tag);
+        g_free(double_attr);
+        g_free(single_attr);
+        g_free(close_tag);
+        return TRUE;
+    }
+    xmlFree(value);
+    g_free(open_tag);
+    g_free(double_attr);
+    g_free(single_attr);
+    g_free(close_tag);
+    return FALSE;
+}
