+static gboolean scoped_element_content_bounds(GString *contents,
+                                              xmlNodePtr scope,
+                                              xmlNodePtr node,
+                                              gsize *start, gsize *end)
+{
+    char *open_tag;
+    char *close_tag;
+    char *open;
+    char *open_end;
+    char *close;
+    gsize scope_start;
+    gsize scope_end;
+
+    if (scope == NULL || node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
