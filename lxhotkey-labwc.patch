+#include "xml_compat.h"
+
+#include <libxml/parser.h>
+#include <libxml/tree.h>
+
+#include <string.h>
+
+struct _FmXmlFileItem {
+    FmXmlFile *file;
+    xmlNodePtr node;
+};
+
+typedef struct {
+    char *name;
+    FmXmlFileHandler handler;
+} FmXmlTagDef;
+
+typedef struct {
+    xmlNodePtr node;
+    xmlNodePtr scope;
+    char *text;
+    gboolean whole_node;
+    gboolean owns_node;
+} FmXmlTextReplacement;
+
+struct _FmXmlFile {
+    GPtrArray *tags;
+    GHashTable *tag_by_name;
+    xmlDocPtr doc;
