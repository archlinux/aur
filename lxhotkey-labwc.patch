+    open = g_strstr_len(contents->str + offset, contents->len - offset, open_tag);
+    if (open == NULL)
+        open = g_strstr_len(contents->str, contents->len, open_tag);
+    if (open == NULL)
+        goto fail;
+    open_end = strchr(open, '>');
+    if (open_end == NULL)
+        goto fail;
+    if (open_end[-1] == '/') {
+        *start = (gsize)(open - contents->str);
+        *end = (gsize)(open_end + 1 - contents->str);
+        g_free(open_tag);
+        g_free(close_tag);
+        return TRUE;
