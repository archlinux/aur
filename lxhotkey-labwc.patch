     return get_options_from_template(parent, data);
 }
 
+/* case-insensitive substring match for the action-name completion; GtkEntry
+   completion passes 'key' already normalized + case-folded, so only fold col 0 */
+static gboolean action_completion_match(GtkEntryCompletion *completion,
+                                        const gchar *key, GtkTreeIter *iter,
+                                        gpointer user_data)
+{
+    GtkTreeModel *model = gtk_entry_completion_get_model(completion);
+    gchar *name = NULL, *folded;
+    gboolean match = FALSE;
+
+    (void)user_data;
+    if (model == NULL)
+        return FALSE;
+    gtk_tree_model_get(model, iter, 0, &name, -1);
+    if (name != NULL)
+    {
+        folded = g_utf8_casefold(name, -1);
+        match = (key[0] == '\0' || strstr(folded, key) != NULL);
+        g_free(folded);
+        g_free(name);
+    }
+    return match;
+}
+
+/* when the user picks a completion, mirror it onto the combo's active row so
+   the "changed" signal fires and the hint/parameter widgets refresh */
+static gboolean on_action_completion_match_selected(GtkEntryCompletion *completion,
+                                                    GtkTreeModel *model,
+                                                    GtkTreeIter *iter,
+                                                    gpointer user_data)
+{
+    PluginData *data = user_data;
+
+    (void)completion;
+    (void)model;
+    gtk_combo_box_set_active_iter(data->edit_actions, iter);
+    return FALSE; /* let the default handler also set the entry text */
+}
+
+/* resolve a typed (not dropdown-picked) action name to its model row via an
+   exact case-insensitive match on the shown name (col 0) or raw name (col 1) */
+static gboolean find_action_row_by_name(GtkTreeModel *model, const char *typed,
+                                        GtkTreeIter *iter)
+{
+    gchar *key;
+    gboolean found = FALSE;
+
+    if (typed == NULL || typed[0] == '\0')
+        return FALSE;
+    if (!gtk_tree_model_get_iter_first(model, iter))
+        return FALSE;
+    key = g_utf8_casefold(typed, -1);
+    do {
+        gchar *n0 = NULL, *n1 = NULL, *c0, *c1;
+
+        gtk_tree_model_get(model, iter, 0, &n0, 1, &n1, -1);
+        c0 = n0 ? g_utf8_casefold(n0, -1) : NULL;
+        c1 = n1 ? g_utf8_casefold(n1, -1) : NULL;
+        if ((c0 && g_strcmp0(c0, key) == 0) || (c1 && g_strcmp0(c1, key) == 0))
+            found = TRUE;
+        g_free(n0);
+        g_free(n1);
+        g_free(c0);
+        g_free(c1);
+        if (found)
+            break;
+     } while (gtk_tree_model_iter_next(model, iter));
+    g_free(key);
+    return found;
+}
+
+/* pressing Enter in the typed action name confirms it as a selection, so the
+   hint + parameter widgets refresh (they only track the combo's active row) */
+static void on_action_entry_activate(GtkEntry *entry, gpointer user_data)
+{
+    PluginData *data = user_data;
+    GtkTreeModel *model = gtk_combo_box_get_model(data->edit_actions);
+    GtkTreeIter iter;
+
+    if (model != NULL &&
+        find_action_row_by_name(model, gtk_entry_get_text(entry), &iter))
+        gtk_combo_box_set_active_iter(data->edit_actions, &iter);
+}
