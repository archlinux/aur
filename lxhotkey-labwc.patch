+    char *original;
+    gsize original_len;
+    GPtrArray *text_replacements;
+};
+
+static void free_tag_def(gpointer data)
+{
+    FmXmlTagDef *tag = data;
+
+    if (tag == NULL)
+        return;
+    g_free(tag->name);
+    g_free(tag);
+}
+
+static void free_text_replacement(gpointer data)
+{
+    FmXmlTextReplacement *replacement = data;
+
+    if (replacement == NULL)
+        return;
+    if (replacement->owns_node)
+        xmlFreeNode(replacement->node);
+    g_free(replacement->text);
+    g_free(replacement);
+}
+
+static GQuark lxhotkey_xml_error_quark(void)
+{
+    return g_quark_from_static_string("lxhotkey-xml-error");
+}
+
+static void init_registry(FmXmlFile *file)
+{
+    FmXmlTagDef *tag;
+
+    file->tags = g_ptr_array_new_with_free_func(free_tag_def);
+    file->tag_by_name = g_hash_table_new(g_str_hash, g_str_equal);
+    file->text_replacements = g_ptr_array_new_with_free_func(free_text_replacement);
+
+    g_ptr_array_add(file->tags, NULL);
+
+    tag = g_new0(FmXmlTagDef, 1);
+    tag->name = g_strdup("#text");
+    g_ptr_array_add(file->tags, tag);
+}
+
+static FmXmlFileItem *wrap_node(FmXmlFile *file, xmlNodePtr node)
+{
+    FmXmlFileItem *item;
+
+    if (node == NULL)
+        return NULL;
+    item = node->_private;
+    if (item != NULL)
+        return item;
+    item = g_new0(FmXmlFileItem, 1);
+    item->file = file;
+    item->node = node;
+    node->_private = item;
+    return item;
+}
+
+static void free_wrappers(xmlNodePtr node)
+{
+    xmlNodePtr child;
+    xmlNodePtr next;
+
+    for (child = node ? node->children : NULL; child; child = next) {
+        next = child->next;
+        free_wrappers(child);
+    }
+    if (node && node->_private) {
+        g_free(node->_private);
+        node->_private = NULL;
+    }
+}
+
+static void free_doc(FmXmlFile *file)
+{
+    if (file->text_replacements != NULL)
+        g_ptr_array_set_size(file->text_replacements, 0);
+    if (file->doc != NULL) {
+        free_wrappers(xmlDocGetRootElement(file->doc));
+        xmlFreeDoc(file->doc);
+        file->doc = NULL;
+    }
+    g_free(file->xml_decl);
+    file->xml_decl = NULL;
+    g_free(file->original);
+    file->original = NULL;
+    file->original_len = 0;
+}
+
+static char *copy_xml_decl(const char *contents, gsize len)
+{
+    const char *end;
+
+    if (contents == NULL || len < 5 || strncmp(contents, "<?xml", 5) != 0)
+        return NULL;
+    end = g_strstr_len(contents, len, "?>");
+    if (end == NULL)
+        return NULL;
+    return g_strndup(contents, (end + 2) - contents);
+}
+
+static char *normalize_dump(FmXmlFile *file, const char *data)
+{
+    GString *out = g_string_new(NULL);
+    const char *p = data;
+    gsize i;
+    gsize len;
+
+    if (file->xml_decl != NULL && g_str_has_prefix(p, "<?xml")) {
+        const char *end = strstr(p, "?>");
+
+        if (end != NULL) {
+            g_string_append(out, file->xml_decl);
+            p = end + 2;
+            if (g_str_has_prefix(p, "\n\n<"))
+                p++;
+        }
+    }
+
+    len = strlen(p);
+    for (i = 0; i < len; i++) {
+        if (i + 2 < len && p[i] == ' ' && p[i + 1] == '/' && p[i + 2] == '>')
+            continue;
+        g_string_append_c(out, p[i]);
+    }
+    return g_string_free(out, FALSE);
+}
+
+static gsize offset_for_line(const char *contents, gsize len, long line)
+{
+    gsize i;
+    long current = 1;
+
+    if (line <= 1)
+        return 0;
+    for (i = 0; i < len; i++) {
+        if (contents[i] == '\n') {
+            current++;
+            if (current == line)
+                return i + 1;
+        }
+    }
+    return 0;
+}
+
