+static gboolean text_is_blank(xmlNodePtr node)
+{
+    const xmlChar *content;
+
+    if (node == NULL || node->type != XML_TEXT_NODE)
+        return FALSE;
+    content = node->content;
+    if (content == NULL)
+        return TRUE;
+    for (; *content; content++)
+        if (!g_ascii_isspace(*content))
+            return FALSE;
+    return TRUE;
+}
