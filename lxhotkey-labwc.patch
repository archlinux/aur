+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    offset = offset_for_line(contents->str, contents->len, xmlGetLineNo(node));
+    open = g_strstr_len(contents->str + offset, contents->len - offset, open_tag);
+    if (open == NULL)
+        open = g_strstr_len(contents->str, contents->len, open_tag);
+    if (open == NULL)
+        goto fail;
+    open_end = strchr(open, '>');
+    if (open_end == NULL || open_end[-1] == '/')
+        goto fail;
+    close = g_strstr_len(open_end + 1, contents->len - (gsize)(open_end + 1 - contents->str), close_tag);
+    if (close == NULL)
+        goto fail;
+    *start = (gsize)(open_end + 1 - contents->str);
+    *end = (gsize)(close - contents->str);
+    g_free(open_tag);
+    g_free(close_tag);
+    return TRUE;
+
+fail:
+    g_free(open_tag);
+    g_free(close_tag);
+    return FALSE;
+}
+
+static gboolean element_bounds(GString *contents, xmlNodePtr node,
+                               gsize *start, gsize *end)
+{
+    char *open_tag;
+    char *close_tag;
+    char *open;
+    char *open_end;
+    char *close;
+    gsize offset;
+
+    if (node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    offset = offset_for_line(contents->str, contents->len, xmlGetLineNo(node));
+    open = g_strstr_len(contents->str + offset, contents->len - offset, open_tag);
+    if (open == NULL)
+        open = g_strstr_len(contents->str, contents->len, open_tag);
+    if (open == NULL)
+        goto fail;
+    open_end = strchr(open, '>');
+    if (open_end == NULL)
+        goto fail;
+    if (open_end[-1] == '/') {
+        *start = (gsize)(open - contents->str);
+        *end = (gsize)(open_end + 1 - contents->str);
+        g_free(open_tag);
+        g_free(close_tag);
+        return TRUE;
+    }
+    close = g_strstr_len(open_end + 1, contents->len - (gsize)(open_end + 1 - contents->str), close_tag);
+    if (close == NULL)
+        goto fail;
+    *start = (gsize)(open - contents->str);
+    *end = (gsize)(close + strlen(close_tag) - contents->str);
+    g_free(open_tag);
+    g_free(close_tag);
+    return TRUE;
+
+fail:
+    g_free(open_tag);
+    g_free(close_tag);
+    return FALSE;
+}
+
+static gboolean element_content_bounds_by_attr(GString *contents, xmlNodePtr node,
+                                               const char *attr_name,
+                                               gsize *start, gsize *end)
+{
+    xmlChar *value;
+    char *open_tag;
+    char *double_attr;
+    char *single_attr;
+    char *close_tag;
+    char *search;
+
+    if (node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
+    value = xmlGetProp(node, BAD_CAST attr_name);
+    if (value == NULL)
+        return FALSE;
+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    double_attr = g_strdup_printf("%s=\"%s\"", attr_name, (const char *)value);
+    single_attr = g_strdup_printf("%s='%s'", attr_name, (const char *)value);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    for (search = contents->str; ; search++) {
+        char *open = g_strstr_len(search, contents->len - (gsize)(search - contents->str), open_tag);
+        char *open_end;
+        char *close;
+
+        if (open == NULL)
+            break;
+        open_end = strchr(open, '>');
+        if (open_end == NULL)
+            break;
+        if (g_strstr_len(open, open_end - open, double_attr) == NULL &&
+            g_strstr_len(open, open_end - open, single_attr) == NULL) {
+            search = open;
+            continue;
+        }
+        if (open_end[-1] == '/')
+            break;
+        close = g_strstr_len(open_end + 1,
+                             contents->len - (gsize)(open_end + 1 - contents->str),
+                             close_tag);
+        if (close == NULL)
+            break;
+        *start = (gsize)(open_end + 1 - contents->str);
+        *end = (gsize)(close - contents->str);
+        xmlFree(value);
+        g_free(open_tag);
+        g_free(double_attr);
+        g_free(single_attr);
+        g_free(close_tag);
+        return TRUE;
+    }
+    xmlFree(value);
+    g_free(open_tag);
+    g_free(double_attr);
+    g_free(single_attr);
+    g_free(close_tag);
+    return FALSE;
+}
+
+static gboolean element_bounds_by_attr(GString *contents, xmlNodePtr node,
+                                       const char *attr_name,
+                                       gsize *start, gsize *end)
+{
+    xmlChar *value;
+    char *open_tag;
+    char *double_attr;
+    char *single_attr;
+    char *close_tag;
+    char *search;
+
+    if (node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
+    value = xmlGetProp(node, BAD_CAST attr_name);
+    if (value == NULL)
+        return FALSE;
+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    double_attr = g_strdup_printf("%s=\"%s\"", attr_name, (const char *)value);
+    single_attr = g_strdup_printf("%s='%s'", attr_name, (const char *)value);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    for (search = contents->str; ; search++) {
+        char *open = g_strstr_len(search, contents->len - (gsize)(search - contents->str), open_tag);
+        char *open_end;
+        char *close;
+
+        if (open == NULL)
+            break;
+        open_end = strchr(open, '>');
+        if (open_end == NULL)
+            break;
+        if (g_strstr_len(open, open_end - open, double_attr) == NULL &&
+            g_strstr_len(open, open_end - open, single_attr) == NULL) {
+            search = open;
+            continue;
+        }
+        if (open_end[-1] == '/') {
+            *start = (gsize)(open - contents->str);
+            *end = (gsize)(open_end + 1 - contents->str);
+        } else {
+            close = g_strstr_len(open_end + 1,
+                                 contents->len - (gsize)(open_end + 1 - contents->str),
+                                 close_tag);
+            if (close == NULL)
+                break;
+            *start = (gsize)(open - contents->str);
+            *end = (gsize)(close + strlen(close_tag) - contents->str);
+        }
+        xmlFree(value);
+        g_free(open_tag);
+        g_free(double_attr);
+        g_free(single_attr);
+        g_free(close_tag);
+        return TRUE;
+    }
+    xmlFree(value);
+    g_free(open_tag);
+    g_free(double_attr);
+    g_free(single_attr);
+    g_free(close_tag);
+    return FALSE;
+}
+
+static gboolean scoped_element_content_bounds(GString *contents,
+                                              xmlNodePtr scope,
+                                              xmlNodePtr node,
+                                              gsize *start, gsize *end)
+{
+    char *open_tag;
+    char *close_tag;
+    char *open;
+    char *open_end;
+    char *close;
+    gsize scope_start;
+    gsize scope_end;
+
+    if (scope == NULL || node == NULL || node->type != XML_ELEMENT_NODE)
+        return FALSE;
+    if (!element_content_bounds_by_attr(contents, scope, "key", &scope_start, &scope_end) &&
+        !element_content_bounds(contents, scope, &scope_start, &scope_end))
+        return FALSE;
+    open_tag = g_strdup_printf("<%s", (const char *)node->name);
+    close_tag = g_strdup_printf("</%s>", (const char *)node->name);
+    open = g_strstr_len(contents->str + scope_start, scope_end - scope_start,
+                        open_tag);
+    if (open == NULL)
+        goto fail;
+    open_end = strchr(open, '>');
+    if (open_end == NULL || open_end[-1] == '/' ||
+        (gsize)(open_end - contents->str) >= scope_end)
+        goto fail;
+    close = g_strstr_len(open_end + 1, scope_end - (gsize)(open_end + 1 - contents->str),
+                         close_tag);
+    if (close == NULL)
+        goto fail;
+    *start = (gsize)(open_end + 1 - contents->str);
+    *end = (gsize)(close - contents->str);
+    g_free(open_tag);
+    g_free(close_tag);
+    return TRUE;
+
+fail:
+    g_free(open_tag);
+    g_free(close_tag);
+    return FALSE;
+}
+
+static char *apply_text_replacements(FmXmlFile *file, gsize *len)
+{
+    GString *contents;
+    guint i;
+
+    if (file->original == NULL || file->text_replacements == NULL ||
+        file->text_replacements->len == 0)
+        return NULL;
+    contents = g_string_new_len(file->original, file->original_len);
+    for (i = 0; i < file->text_replacements->len; i++) {
+        FmXmlTextReplacement *replacement = g_ptr_array_index(file->text_replacements, i);
+        char *escaped;
+        gsize start;
+        gsize end;
+
+        if (replacement->whole_node) {
+            if (!element_bounds_by_attr(contents, replacement->node, "key", &start, &end) &&
+                !element_bounds(contents, replacement->node, &start, &end)) {
+                g_string_free(contents, TRUE);
+                return NULL;
+            }
+        } else if (replacement->scope != NULL && replacement->scope != replacement->node) {
+            if (!scoped_element_content_bounds(contents, replacement->scope,
+                                               replacement->node, &start, &end)) {
+                g_string_free(contents, TRUE);
+                return NULL;
+            }
+        } else if (!element_content_bounds(contents, replacement->node, &start, &end)) {
+            g_string_free(contents, TRUE);
+            return NULL;
+        }
+        g_string_erase(contents, start, end - start);
+        if (replacement->whole_node)
+            g_string_insert(contents, start, replacement->text);
+        else {
+            escaped = g_markup_escape_text(replacement->text, -1);
+            g_string_insert(contents, start, escaped);
+            g_free(escaped);
+        }
+    }
+    if (len)
+        *len = contents->len;
+    return g_string_free(contents, FALSE);
+}
+
+static void record_text_replacement(FmXmlFileItem *scope, FmXmlFileItem *item,
+                                    const char *text)
+{
+    FmXmlTextReplacement *replacement;
+    guint i;
+
+    if (item == NULL || item->file == NULL || item->node == NULL ||
+        item->file->text_replacements == NULL)
+        return;
+    for (i = 0; i < item->file->text_replacements->len; i++) {
+        replacement = g_ptr_array_index(item->file->text_replacements, i);
+        if (replacement->node == item->node &&
+            replacement->scope == (scope ? scope->node : NULL)) {
+            g_free(replacement->text);
+            replacement->text = g_strdup(text);
+            return;
+        }
+    }
+    replacement = g_new0(FmXmlTextReplacement, 1);
+    replacement->node = item->node;
+    replacement->scope = scope ? scope->node : NULL;
+    replacement->text = g_strdup(text);
+    g_ptr_array_add(item->file->text_replacements, replacement);
+}
+
+static char *node_to_data(FmXmlFileItem *item)
+{
+    xmlBufferPtr buffer;
+    char *copy;
+
+    if (item == NULL || item->node == NULL || item->file == NULL)
+        return NULL;
+    buffer = xmlBufferCreate();
+    if (buffer == NULL)
+        return NULL;
+    xmlNodeDump(buffer, item->file->doc, item->node, 0, 0);
+    copy = normalize_dump(item->file, (const char *)xmlBufferContent(buffer));
+    xmlBufferFree(buffer);
+    return copy;
+}
+
+static void record_node_replacement(FmXmlFileItem *item, const char *text)
+{
+    FmXmlTextReplacement *replacement;
+
+    if (item == NULL || item->file == NULL || item->node == NULL ||
+        item->file->text_replacements == NULL)
+        return;
+    replacement = g_new0(FmXmlTextReplacement, 1);
+    replacement->node = item->node;
+    replacement->text = g_strdup(text ? text : "");
+    replacement->whole_node = TRUE;
+    replacement->owns_node = TRUE;
+    g_ptr_array_add(item->file->text_replacements, replacement);
+}
+
+static FmXmlTagDef *get_tag_def(FmXmlFile *file, FmXmlFileTag tag)
+{
+    if (file == NULL || tag >= file->tags->len)
+        return NULL;
+    return g_ptr_array_index(file->tags, tag);
+}
+
+static FmXmlFileTag get_tag_by_name(FmXmlFile *file, const char *name)
+{
+    gpointer value;
+
+    if (name == NULL)
+        return FM_XML_FILE_TAG_NOT_HANDLED;
+    value = g_hash_table_lookup(file->tag_by_name, name);
+    if (value == NULL)
+        return FM_XML_FILE_TAG_NOT_HANDLED;
+    return GPOINTER_TO_UINT(value);
+}
+
+static gboolean text_is_blank(xmlNodePtr node)
+{
+    const xmlChar *content;
+
+    if (node == NULL || node->type != XML_TEXT_NODE)
+        return FALSE;
+    content = node->content;
+    if (content == NULL)
+        return TRUE;
+    for (; *content; content++)
+        if (!g_ascii_isspace(*content))
+            return FALSE;
+    return TRUE;
+}
+
+static GList *node_children(FmXmlFile *file, xmlNodePtr node)
+{
+    GList *children = NULL;
+    xmlNodePtr child;
+
+    for (child = node ? node->children : NULL; child; child = child->next) {
+        if (child->type != XML_ELEMENT_NODE && child->type != XML_TEXT_NODE)
+            continue;
+        if (text_is_blank(child))
+            continue;
+        children = g_list_append(children, wrap_node(file, child));
+    }
+    return children;
+}
+
+static gboolean run_handlers(FmXmlFile *file, xmlNodePtr node, GError **error,
+                             gpointer user_data)
+{
+    xmlNodePtr child;
+    xmlNodePtr next;
+    FmXmlFileItem *item;
+    FmXmlTagDef *tag;
+    FmXmlFileTag tag_id;
+    GList *children;
+    char **attr_names = NULL;
+    char **attr_values = NULL;
+    guint n_attrs = 0;
+    guint i = 0;
+    xmlAttrPtr attr;
+
+    if (node == NULL)
+        return TRUE;
+    for (child = node->children; child; child = next) {
+        next = child->next;
+        if (child->type == XML_ELEMENT_NODE) {
+            if (!run_handlers(file, child, error, user_data))
+                return FALSE;
+        }
+    }
+    if (node->type != XML_ELEMENT_NODE)
+        return TRUE;
+
+    tag_id = get_tag_by_name(file, (const char *)node->name);
+    tag = get_tag_def(file, tag_id);
+    if (tag == NULL || tag->handler == NULL)
+        return TRUE;
+
+    for (attr = node->properties; attr; attr = attr->next)
+        n_attrs++;
+    if (n_attrs > 0) {
+        attr_names = g_new0(char *, n_attrs + 1);
+        attr_values = g_new0(char *, n_attrs + 1);
+        for (attr = node->properties; attr; attr = attr->next, i++) {
+            xmlChar *value = xmlNodeListGetString(node->doc, attr->children, 1);
+
+            attr_names[i] = g_strdup((const char *)attr->name);
+            attr_values[i] = g_strdup((const char *)(value ? value : BAD_CAST ""));
+            if (value)
+                xmlFree(value);
+        }
+    }
+
+    item = wrap_node(file, node);
+    children = node_children(file, node);
+    if (!tag->handler(item, children, attr_names, attr_values, n_attrs,
+                      (gint)xmlGetLineNo(node), 0, error, user_data)) {
+        g_list_free(children);
+        g_strfreev(attr_names);
+        g_strfreev(attr_values);
+        return FALSE;
+    }
+    g_list_free(children);
+    g_strfreev(attr_names);
+    g_strfreev(attr_values);
+    return TRUE;
+}
+
+FmXmlFile *fm_xml_file_new(FmXmlFile *other)
+{
+    FmXmlFile *file = g_new0(FmXmlFile, 1);
+    guint i;
+
+    init_registry(file);
+    if (other == NULL)
+        return file;
+    for (i = 2; i < other->tags->len; i++) {
+        FmXmlTagDef *old = g_ptr_array_index(other->tags, i);
+        FmXmlTagDef *tag = g_new0(FmXmlTagDef, 1);
+
+        tag->name = g_strdup(old->name);
+        tag->handler = old->handler;
+        g_ptr_array_add(file->tags, tag);
+        g_hash_table_insert(file->tag_by_name, tag->name, GUINT_TO_POINTER(i));
+    }
+    return file;
+}
+
+void fm_xml_file_free(FmXmlFile *file)
+{
+    if (file == NULL)
+        return;
+    free_doc(file);
+    g_ptr_array_free(file->tags, TRUE);
+    g_hash_table_destroy(file->tag_by_name);
+    g_free(file);
+}
+
+FmXmlFileTag fm_xml_file_set_handler(FmXmlFile *file, const char *name,
+                                     FmXmlFileHandler handler, gboolean recursive,
+                                     gpointer unused)
+{
+    FmXmlFileTag tag_id;
+    FmXmlTagDef *tag;
+
+    (void)recursive;
+    (void)unused;
+
+    tag_id = get_tag_by_name(file, name);
+    if (tag_id != FM_XML_FILE_TAG_NOT_HANDLED) {
+        tag = get_tag_def(file, tag_id);
+        tag->handler = handler;
+        return tag_id;
+    }
+
+    tag = g_new0(FmXmlTagDef, 1);
+    tag->name = g_strdup(name);
+    tag->handler = handler;
+    tag_id = file->tags->len;
+    g_ptr_array_add(file->tags, tag);
+    g_hash_table_insert(file->tag_by_name, tag->name, GUINT_TO_POINTER(tag_id));
+    return tag_id;
+}
+
+const char *fm_xml_file_get_tag_name(FmXmlFile *file, FmXmlFileTag tag)
+{
+    FmXmlTagDef *tag_def = get_tag_def(file, tag);
+
+    return tag_def ? tag_def->name : NULL;
+}
+
+gboolean fm_xml_file_parse_data(FmXmlFile *file, const char *contents, gsize len,
+                                GError **error, gpointer user_data)
+{
+    xmlNodePtr root;
+
+    free_doc(file);
+    file->xml_decl = copy_xml_decl(contents, len);
+    file->original = g_strndup(contents, len);
+    file->original_len = len;
+    xmlResetLastError();
+    file->doc = xmlReadMemory(contents, (int)len, NULL, NULL, XML_PARSE_NONET);
+    if (file->doc == NULL) {
+        const xmlError *xml_error = xmlGetLastError();
+
+        g_set_error(error, lxhotkey_xml_error_quark(), 0,
+                    "%s", xml_error && xml_error->message ? xml_error->message
+                                                             : "Failed to parse XML.");
+        return FALSE;
+    }
+    root = xmlDocGetRootElement(file->doc);
+    if (root == NULL) {
+        g_set_error_literal(error, lxhotkey_xml_error_quark(), 0,
+                            "Failed to parse XML.");
+        return FALSE;
+    }
+    wrap_node(file, root);
+    return run_handlers(file, root, error, user_data);
+}
+
+FmXmlFileItem *fm_xml_file_finish_parse(FmXmlFile *file, GError **error)
+{
+    (void)error;
+    return wrap_node(file, xmlDocGetRootElement(file->doc));
+}
+
+char *fm_xml_file_to_data(FmXmlFile *file, gsize *len, GError **error)
+{
+    xmlChar *buffer = NULL;
+    int size = 0;
+    char *copy;
+
+    (void)error;
+    copy = apply_text_replacements(file, len);
+    if (copy != NULL)
+        return copy;
+    xmlDocDumpFormatMemoryEnc(file->doc, &buffer, &size, "UTF-8", 0);
+    if (buffer == NULL)
+        return NULL;
+    copy = normalize_dump(file, (const char *)buffer);
+    xmlFree(buffer);
+    if (len)
+        *len = (gsize)strlen(copy);
+    return copy;
+}
+
+FmXmlFileTag fm_xml_file_item_get_tag(FmXmlFileItem *item)
+{
+    if (item == NULL || item->node == NULL)
+        return FM_XML_FILE_TAG_NOT_HANDLED;
+    if (item->node->type == XML_TEXT_NODE)
+        return FM_XML_FILE_TEXT;
+    return get_tag_by_name(item->file, (const char *)item->node->name);
+}
+
+const char *fm_xml_file_item_get_tag_name(FmXmlFileItem *item)
+{
+    if (item == NULL || item->node == NULL)
+        return NULL;
+    if (item->node->type == XML_TEXT_NODE)
+        return "#text";
+    return (const char *)item->node->name;
+}
+
+GList *fm_xml_file_item_get_children(FmXmlFileItem *item)
+{
+    if (item == NULL)
+        return NULL;
+    return node_children(item->file, item->node);
+}
+
+FmXmlFileItem *fm_xml_file_item_get_parent(FmXmlFileItem *item)
+{
+    if (item == NULL || item->node == NULL || item->node->parent == NULL)
+        return NULL;
+    if (item->node->parent->type == XML_DOCUMENT_NODE)
+        return NULL;
+    return wrap_node(item->file, item->node->parent);
+}
+
+FmXmlFileItem *fm_xml_file_item_find_child(FmXmlFileItem *item, FmXmlFileTag tag)
+{
+    xmlNodePtr child;
+
+    if (item == NULL)
+        return NULL;
+    for (child = item->node->children; child; child = child->next) {
+        FmXmlFileItem *wrapped;
+
+        if (child->type != XML_ELEMENT_NODE && child->type != XML_TEXT_NODE)
+            continue;
+        if (text_is_blank(child))
+            continue;
+        wrapped = wrap_node(item->file, child);
+        if (fm_xml_file_item_get_tag(wrapped) == tag)
+            return wrapped;
+    }
+    return NULL;
+}
+
+const char *fm_xml_file_item_get_data(FmXmlFileItem *item, gpointer unused)
+{
+    (void)unused;
+    if (item == NULL || item->node == NULL)
+        return NULL;
+    return (const char *)item->node->content;
+}
+
+FmXmlFileItem *fm_xml_file_item_new(FmXmlFile *file, FmXmlFileTag tag)
+{
+    const char *name = fm_xml_file_get_tag_name(file, tag);
+    xmlNodePtr node;
+
+    if (name == NULL || tag == FM_XML_FILE_TEXT)
+        return NULL;
+    node = xmlNewNode(NULL, BAD_CAST name);
+    return wrap_node(file, node);
+}
+
+void fm_xml_file_item_set_attribute(FmXmlFileItem *item, const char *name,
+                                    const char *value)
+{
+    if (item == NULL || item->node == NULL)
+        return;
+    xmlSetProp(item->node, BAD_CAST name, BAD_CAST value);
+}
+
+void fm_xml_file_item_set_text(FmXmlFileItem *item, const char *text)
+{
+    if (item == NULL || item->node == NULL || text == NULL)
+        return;
+    record_text_replacement(NULL, item, text);
+    xmlNodeSetContent(item->node, BAD_CAST text);
+}
+
+void fm_xml_file_item_set_scoped_text(FmXmlFileItem *scope, FmXmlFileItem *item,
+                                      const char *text)
+{
+    if (item == NULL || item->node == NULL || text == NULL)
+        return;
+    record_text_replacement(scope, item, text);
+    xmlNodeSetContent(item->node, BAD_CAST text);
+}
+
+void fm_xml_file_item_replace_with(FmXmlFileItem *item, FmXmlFileItem *replacement)
+{
+    char *text;
+    xmlNodePtr old_node;
+    xmlNodePtr new_node;
+
+    if (item == NULL || item->node == NULL || replacement == NULL ||
+        replacement->node == NULL)
+        return;
+    text = node_to_data(replacement);
+    record_node_replacement(item, text);
+    g_free(text);
+    old_node = item->node;
+    new_node = replacement->node;
+    xmlReplaceNode(old_node, new_node);
+    old_node->_private = NULL;
+    free_wrappers(old_node);
+    new_node->_private = item;
+    item->node = new_node;
+    g_free(replacement);
+}
+
+void fm_xml_file_item_append_text(FmXmlFileItem *item, const char *text, gssize len,
+                                  gboolean escaped)
+{
+    xmlNodePtr node;
+
+    (void)escaped;
+    if (item == NULL || item->node == NULL)
+        return;
+    if (len < 0)
+        len = (gssize)strlen(text);
+    node = xmlNewTextLen(BAD_CAST text, (int)len);
+    xmlAddChild(item->node, node);
+    wrap_node(item->file, node);
+}
+
+void fm_xml_file_item_append_child(FmXmlFileItem *item, FmXmlFileItem *child)
+{
+    if (item == NULL || child == NULL)
+        return;
+    xmlAddChild(item->node, child->node);
+}
+
+void fm_xml_file_item_destroy(FmXmlFileItem *item)
+{
+    if (item == NULL || item->node == NULL)
+        return;
+    record_node_replacement(item, "");
+    xmlUnlinkNode(item->node);
+    free_wrappers(item->node);
+}
