+static gboolean key_is_empty(const char *key)
+{
+    return key == NULL || key[0] == '\0';
+}
+
+static gboolean key_equal(const char *left, const char *right)
+{
+    char *left_ob;
+    char *right_ob;
+    gboolean ret;
+
+    if (key_is_empty(left) || key_is_empty(right))
+        return key_is_empty(left) && key_is_empty(right);
+    if (g_strcmp0(left, right) == 0)
+        return TRUE;
+    left_ob = key_to_obkey(left);
+    right_ob = key_to_obkey(right);
+    ret = g_strcmp0(left_ob, right_ob) == 0;
+    g_free(left_ob);
+    g_free(right_ob);
+    return ret;
+}
+
+static gboolean key_matches(const char *left, const char *right)
+{
+    if (key_is_empty(left) || key_is_empty(right))
+        return FALSE;
+    return key_equal(left, right);
+}
+
+static void set_execute_command(FmXmlFileItem *binding, const char *exec)
+{
+    FmXmlFileItem *action;
+    FmXmlFileItem *command;
+
+    if (binding == NULL)
+        return;
+    action = fm_xml_file_item_find_child(binding, ObXmlFile_action);
+    if (action == NULL)
+        return;
+    command = fm_xml_file_item_find_child(action, ObXmlFile_command);
+    if (command == NULL)
+        command = fm_xml_file_item_find_child(action, ObXmlFile_execute);
+    if (command != NULL)
+        fm_xml_file_item_set_scoped_text(binding, command, exec);
+}
+
+static void replace_exec(FmXmlFileItem *data1, FmXmlFileItem *data2,
+                         const char *exec, char **eptr)
+{
+    set_execute_command(data1, exec);
+    set_execute_command(data2, exec);
+    g_free(*eptr);
+    *eptr = g_strdup(exec);
+}
+
+static void replace_wm_actions(ObXmlFile *cfg, LXHotkeyGlobal *act,
+                               LXHotkeyGlobal *data)
+{
+    FmXmlFileItem *binding;
+    GList *actions = NULL;
+
+    if (act == NULL || data == NULL || act->data1 == NULL || data->accel1 == NULL)
+        return;
+    binding = make_new_xml_binding(cfg, data->actions, data->accel1, &actions, NULL);
+    fm_xml_file_item_replace_with(act->data1, binding);
+    if (act->data2 != NULL && act->accel2 != NULL) {
+        binding = make_new_xml_binding(cfg, data->actions, act->accel2, NULL, NULL);
+        fm_xml_file_item_replace_with(act->data2, binding);
+    }
+    free_options(act->actions);
+    act->actions = actions;
+}
