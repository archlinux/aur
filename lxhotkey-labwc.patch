+static GList *node_children(FmXmlFile *file, xmlNodePtr node)
+{
+    GList *children = NULL;
+    xmlNodePtr child;
+
+    for (child = node ? node->children : NULL; child; child = child->next) {
+        if (child->type != XML_ELEMENT_NODE && child->type != XML_TEXT_NODE)
+            continue;
+        if (text_is_blank(child))
+            continue;
+        children = g_list_append(children, wrap_node(file, child));
+    }
+    return children;
+}
