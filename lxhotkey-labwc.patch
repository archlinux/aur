+    for (i = 0; i < item->file->text_replacements->len; i++) {
+        replacement = g_ptr_array_index(item->file->text_replacements, i);
+        if (replacement->node == item->node &&
+            replacement->scope == (scope ? scope->node : NULL)) {
+            g_free(replacement->text);
+            replacement->text = g_strdup(text);
+            return;
+        }
+    }
+    replacement = g_new0(FmXmlTextReplacement, 1);
+    replacement->node = item->node;
+    replacement->scope = scope ? scope->node : NULL;
+    replacement->text = g_strdup(text);
+    g_ptr_array_add(item->file->text_replacements, replacement);
