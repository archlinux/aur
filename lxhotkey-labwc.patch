+static char *apply_text_replacements(FmXmlFile *file, gsize *len)
+{
+    GString *contents;
+    guint i;
+
+    if (file->original == NULL || file->text_replacements == NULL ||
+        file->text_replacements->len == 0)
+        return NULL;
+    contents = g_string_new_len(file->original, file->original_len);
+    for (i = 0; i < file->text_replacements->len; i++) {
+        FmXmlTextReplacement *replacement = g_ptr_array_index(file->text_replacements, i);
+        char *escaped;
+        gsize start;
+        gsize end;
+
+        if (replacement->whole_node) {
+            if (!element_bounds_by_attr(contents, replacement->node, "key", &start, &end) &&
+                !element_bounds(contents, replacement->node, &start, &end)) {
+                g_string_free(contents, TRUE);
+                return NULL;
+            }
+        } else if (replacement->scope != NULL && replacement->scope != replacement->node) {
+            if (!scoped_element_content_bounds(contents, replacement->scope,
+                                               replacement->node, &start, &end)) {
+                g_string_free(contents, TRUE);
+                return NULL;
+            }
+        } else if (!element_content_bounds(contents, replacement->node, &start, &end)) {
+            g_string_free(contents, TRUE);
+            return NULL;
+        }
+        g_string_erase(contents, start, end - start);
+        if (replacement->whole_node)
+            g_string_insert(contents, start, replacement->text);
+        else {
+            escaped = g_markup_escape_text(replacement->text, -1);
+            g_string_insert(contents, start, escaped);
+            g_free(escaped);
+        }
+    }
+    if (len)
+        *len = contents->len;
+    return g_string_free(contents, FALSE);
+}
