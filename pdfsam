#!/bin/sh
exec archlinux-java-run --feature 'javafx' --min 25 --max 25 -- \
    --enable-native-access=javafx.graphics --enable-preview \
    --module-path "/usr/share/java/pdfsam" \
    --module org.pdfsam.basic/org.pdfsam.basic.App -Xmx512M \
    -splash:/usr/share/pdfsam/splash.png -Dapp.name=pdfsam-basic \
    -Dapp.pid="$$" -Dprism.lcdtext=false "$@"
