-				       MTK_FW_ROM_PATCH_SEC_MAP_SIZE * i +
+				       (size_t)MTK_FW_ROM_PATCH_SEC_MAP_SIZE * i +
 				       MTK_SEC_MAP_COMMON_SIZE,
 				       MTK_SEC_MAP_NEED_SEND_SIZE);

