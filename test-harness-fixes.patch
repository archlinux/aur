 # Telemetry hot-path microbenchmark (NVBug 5876558). The cases are DISABLED_ so
 # they never run in the normal 'gtest' suite; this dedicated entry opts them in.
--- a/test/unit/plugins/posix/nixl_posix_uring_test.cpp
+++ b/test/unit/plugins/posix/nixl_posix_uring_test.cpp
@@ -222,6 +222,8 @@
     if (probe_ret < 0) {
         std::cerr << "io_uring backend test requires a usable ring: " << std::strerror(-probe_ret)
                   << " (" << probe_ret << ")" << std::endl;
+        // Meson recognizes 77 as an unavailable-platform skip. Other errors fail.
+        if (probe_ret == -EPERM || probe_ret == -ENOSYS || probe_ret == -EACCES) return 77;
         return 1;
     }
     io_uring_queue_exit(&probe_ring);
