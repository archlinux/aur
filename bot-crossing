#!/usr/bin/env bash
set -euo pipefail

PORT="${PORT:-5274}"
HOST="${BOT_CROSSING_HOST:-127.0.0.1}"
export BOT_CROSSING_DATA="${BOT_CROSSING_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/bot-crossing}"
URL="http://${HOST}:${PORT}"

EXIT_ALREADY_RUNNING=75
OPEN_WAIT_TRIES=50

usage() {
    cat <<USAGE
Usage: bot-crossing [--open] [--help]

Serve Bot Crossing on ${URL}.

  --open      Open ${URL} in the default browser, starting the server
              first if nothing is listening on the port.
  -h, --help  Show this help.

Environment:
  PORT               Port to bind (default 5274)
  BOT_CROSSING_HOST  Address to bind (default 127.0.0.1)
  BOT_CROSSING_DATA  Where colony.json lives
                     (default \${XDG_DATA_HOME:-~/.local/share}/bot-crossing)

Exit status:
  0  Server exited normally, or --open reused a running server.
  1  Bad arguments.
  ${EXIT_ALREADY_RUNNING}  Something is already listening on ${URL}.
USAGE
}

listening() {
    timeout 1 bash -c "exec 3<>/dev/tcp/${HOST}/${PORT}" 2>/dev/null
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    --open)
        if listening; then
            exec xdg-open "${URL}"
        fi
        (
            for ((i = 0; i < OPEN_WAIT_TRIES; i++)); do
                if listening; then
                    exec xdg-open "${URL}"
                fi
                sleep 0.2
            done
        ) &
        ;;
    "") ;;
    *)
        usage >&2
        exit 1
        ;;
esac

if listening; then
    echo "bot-crossing: something is already listening on ${URL}; not starting a second server." >&2
    echo "bot-crossing: stop it first, or set PORT to serve elsewhere." >&2
    exit "${EXIT_ALREADY_RUNNING}"
fi

mkdir -p "${BOT_CROSSING_DATA}"
exec node /usr/lib/bot-crossing/server/serve.mjs
