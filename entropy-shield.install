post_install() {
    echo ""
    echo "  Entropy Shield installed successfully."
    echo ""
    echo "  Launch the GUI:"
    echo "    entropy-shield"
    echo ""
    echo "  Headless / server mode (Tor + DNSCrypt, no GUI):"
    echo "    systemctl enable --now entropy-shield"
    echo ""
    echo "  To enable passwordless connect/disconnect, open the app"
    echo "  and go to Settings -> General -> Auth Mode."
    echo ""
}

post_upgrade() {
    post_install
}
