diff -rU1 nmeap.orig/Makefile nmeap.buildfilefix/Makefile
--- nmeap.orig/Makefile	2025-11-13 21:18:22.590492683 +0100
+++ nmeap.buildfilefix/Makefile	2025-11-13 21:21:55.351846077 +0100
@@ -1,4 +1,7 @@
-# rules
-export CC=gcc
-export CDEFS = -DNDEBUG
+# Set default compiler and compiler options if not already specified by environment
+export CC ?= gcc
+export CFLAGS ?= -DNDEBUG -g -O0 -Werror -Wall
+
+# Version. Use the digits of the source file name.
+export LIBVER = 01
 
@@ -11,3 +14,3 @@
 
-all :
+all : $(LIB)
 	cd $(SRC) && $(MAKE) all
@@ -16,2 +19,5 @@
 
+$(LIB) :
+	mkdir -p $(LIB)
+
 clean :
@@ -19,2 +25,3 @@
 	cd $(TST) && $(MAKE) clean
+	rm -f $(LIB)/*
 	
diff -rU1 nmeap.orig/src/Makefile nmeap.buildfilefix/src/Makefile
--- nmeap.orig/src/Makefile	2025-11-13 21:18:22.591098044 +0100
+++ nmeap.buildfilefix/src/Makefile	2025-11-13 21:25:00.604712182 +0100
@@ -1,8 +1,7 @@
-# specify compiler flags
-CFLAGS = -I $(INC) $(CDEFS) -g -O0 -Werror -Wall
-
 # set library name
 LIBNAME  = libnmeap.a
+SHAREDLIBNAME  = libnmeap.so
+SHAREDSONAME   = $(SHAREDLIBNAME).$(LIBVER)
 
-COBJ     = nmeap01.o
+COBJ     = nmeap$(LIBVER).o
 
@@ -11,3 +10,3 @@
 # build everything
-all : $(LIB)/$(LIBNAME)
+all : $(LIB)/$(LIBNAME) $(LIB)/$(SHAREDLIBNAME)
 
@@ -16,3 +15,7 @@
 	-$(RM) $(LIB)/$(LIBNAME)
-	$(AR)  -q $(LIB)/$(LIBNAME) $(COBJ)
+	$(AR)  rcs $(LIB)/$(LIBNAME) $(COBJ)
+
+$(LIB)/$(SHAREDLIBNAME) : $(COBJ)
+	-$(RM) $(LIB)/$(SHAREDLIBNAME)
+	$(CC) -shared $(LDFLAGS) -Wl,-soname=$(SHAREDSONAME) -o $(LIB)/$(SHAREDLIBNAME)  $(COBJ)
 
@@ -20,3 +23,3 @@
 $(COBJ): %.o: %.c
-	$(CC) -c $(CFLAGS) $(SRC)/$< -o $@	
+	$(CC) -c $(CFLAGS) -I $(INC) $(SRC)/$< -o $@	
 
