diff -rU1 nmeap.orig/Makefile nmeap.makefix/Makefile
--- nmeap.orig/Makefile	2025-11-12 22:49:43.836433424 +0100
+++ nmeap.makefix/Makefile	2025-11-13 20:32:07.301758407 +0100
@@ -1,4 +1,4 @@
-# rules
-export CC=gcc
-export CDEFS = -DNDEBUG
+# Set default compiler and compiler options if not already specified by environment
+export CC ?= gcc
+export CFLAGS ?= -DNDEBUG -g -O0 -Werror -Wall
 
@@ -11,3 +11,3 @@
 
-all :
+all : $(LIB)
 	cd $(SRC) && $(MAKE) all
@@ -16,2 +16,5 @@
 
+$(LIB) :
