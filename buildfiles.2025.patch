diff -rU1 nmeap.orig/src/Makefile nmeap.makefix/src/Makefile
--- nmeap.orig/src/Makefile	2025-11-12 22:49:43.836997347 +0100
+++ nmeap.makefix/src/Makefile	2025-11-13 20:32:21.862719750 +0100
@@ -1,6 +1,4 @@
-# specify compiler flags
-CFLAGS = -I $(INC) $(CDEFS) -g -O0 -Werror -Wall
-
 # set library name
 LIBNAME  = libnmeap.a
+SHAREDLIBNAME  = libnmeap.so
 
@@ -11,3 +9,3 @@
 # build everything
-all : $(LIB)/$(LIBNAME)
+all : $(LIB)/$(LIBNAME) $(LIB)/$(SHAREDLIBNAME)
 
@@ -16,3 +14,7 @@
 	-$(RM) $(LIB)/$(LIBNAME)
-	$(AR)  -q $(LIB)/$(LIBNAME) $(COBJ)
+	$(AR)  rcs $(LIB)/$(LIBNAME) $(COBJ)
+
+$(LIB)/$(SHAREDLIBNAME) : $(COBJ)
+	-$(RM) $(LIB)/$(SHAREDLIBNAME)
+	$(CC) -shared $(LDFLAGS) -o $(LIB)/$(SHAREDLIBNAME)  $(COBJ)
 
@@ -20,3 +22,3 @@
 $(COBJ): %.o: %.c
-	$(CC) -c $(CFLAGS) $(SRC)/$< -o $@	
+	$(CC) -c $(CFLAGS) -I $(INC) $(SRC)/$< -o $@	
 
