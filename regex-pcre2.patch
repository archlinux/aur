+	case PCRE2_ERROR_NULL: return PCRE_ERROR_NULL;
+	case PCRE2_ERROR_BADOPTION: return PCRE_ERROR_BADOPTION;
+	case PCRE2_ERROR_BADMAGIC: return PCRE_ERROR_BADMAGIC;
+	case PCRE2_ERROR_NOMEMORY: return PCRE_ERROR_NOMEMORY;
+	case PCRE2_ERROR_NOSUBSTRING: return PCRE_ERROR_NOSUBSTRING;
+	case PCRE2_ERROR_MATCHLIMIT: return PCRE_ERROR_MATCHLIMIT;
+	case PCRE2_ERROR_CALLOUT: return PCRE_ERROR_CALLOUT;
+	case PCRE2_ERROR_BADUTFOFFSET: return PCRE_ERROR_BADUTF8_OFFSET;
+	case PCRE2_ERROR_PARTIAL: return PCRE_ERROR_PARTIAL;
+	case PCRE2_ERROR_DFA_UITEM: return PCRE_ERROR_DFA_UITEM;
+	case PCRE2_ERROR_DFA_UCOND: return PCRE_ERROR_DFA_UCOND;
+	case PCRE2_ERROR_DFA_WSSIZE: return PCRE_ERROR_DFA_WSSIZE;
+	case PCRE2_ERROR_DFA_RECURSE: return PCRE_ERROR_DFA_RECURSE;
+	/* PCRE2 limits the depth and the heap where PCRE limited the recursion (the stack) */
+	case PCRE2_ERROR_DEPTHLIMIT: return PCRE_ERROR_RECURSIONLIMIT;
+	case PCRE2_ERROR_HEAPLIMIT: return PCRE_ERROR_RECURSIONLIMIT;
+	case PCRE2_ERROR_BADOFFSET: return PCRE_ERROR_BADOFFSET;
+	case PCRE2_ERROR_RECURSELOOP: return PCRE_ERROR_RECURSELOOP;
+	case PCRE2_ERROR_JIT_STACKLIMIT: return PCRE_ERROR_JIT_STACKLIMIT;
+	case PCRE2_ERROR_BADMODE: return PCRE_ERROR_BADMODE;
+	case PCRE2_ERROR_DFA_BADRESTART: return PCRE_ERROR_DFA_BADRESTART;
+	case PCRE2_ERROR_JIT_BADOPTION: return PCRE_ERROR_JIT_BADOPTION;
+	default: return PCRE_ERROR_INTERNAL;
+	}
+}
+
+// PCRE's option bits (pcre.h of PCRE 8.45), which regex.inc defines and plugins pass
+enum : uint32_t {
+	PCRE_CASELESS = 0x00000001,
+	PCRE_MULTILINE = 0x00000002,
+	PCRE_DOTALL = 0x00000004,
+	PCRE_EXTENDED = 0x00000008,
+	PCRE_ANCHORED = 0x00000010,
+	PCRE_DOLLAR_ENDONLY = 0x00000020,
+	PCRE_EXTRA = 0x00000040,
+	PCRE_NOTBOL = 0x00000080,
+	PCRE_NOTEOL = 0x00000100,
+	PCRE_UNGREEDY = 0x00000200,
+	PCRE_NOTEMPTY = 0x00000400,
+	PCRE_UTF8 = 0x00000800,
+	PCRE_NO_AUTO_CAPTURE = 0x00001000,
+	PCRE_NO_UTF8_CHECK = 0x00002000,
+	PCRE_AUTO_CALLOUT = 0x00004000,
+	PCRE_NEVER_UTF = 0x00010000,
+	PCRE_NO_AUTO_POSSESS = 0x00020000,
+	PCRE_FIRSTLINE = 0x00040000,
+	PCRE_DUPNAMES = 0x00080000,
+	PCRE_NEWLINE_MASK = 0x00700000,
+	PCRE_NEWLINE_CR = 0x00100000,
+	PCRE_NEWLINE_LF = 0x00200000,
+	PCRE_NEWLINE_CRLF = 0x00300000,
+	PCRE_NEWLINE_ANY = 0x00400000,
+	PCRE_NEWLINE_ANYCRLF = 0x00500000,
+	PCRE_BSR_ANYCRLF = 0x00800000,
+	PCRE_BSR_UNICODE = 0x01000000,
+	PCRE_JAVASCRIPT_COMPAT = 0x02000000,
+	PCRE_NO_START_OPTIMIZE = 0x04000000,
+	PCRE_NOTEMPTY_ATSTART = 0x10000000,
+	PCRE_UCP = 0x20000000,
+};
+
+struct PcreOptions
+{
+	uint32_t compile;
+	uint32_t match;
+	uint32_t newline;
+	uint32_t bsr;
+	bool unknownEscapeIsLiteral;
+};
+
+// PCRE's flags -> PCRE2's compile, extra and match options, newline and \R conventions. False for
+// bits that are no options (or PCRE's partial matching, whose results the natives don't handle).
+static inline bool TranslatePcreFlags(uint32_t flags, PcreOptions &options)
+{
+	static const struct { uint32_t pcre; uint32_t pcre2; } compile[] = {
+		{PCRE_CASELESS, PCRE2_CASELESS},
+		{PCRE_MULTILINE, PCRE2_MULTILINE},
+		{PCRE_DOTALL, PCRE2_DOTALL},
+		{PCRE_EXTENDED, PCRE2_EXTENDED},
+		{PCRE_ANCHORED, PCRE2_ANCHORED},
+		{PCRE_DOLLAR_ENDONLY, PCRE2_DOLLAR_ENDONLY},
+		{PCRE_UNGREEDY, PCRE2_UNGREEDY},
+		{PCRE_UTF8, PCRE2_UTF},
+		{PCRE_NO_AUTO_CAPTURE, PCRE2_NO_AUTO_CAPTURE},
+		{PCRE_NO_UTF8_CHECK, PCRE2_NO_UTF_CHECK},
+		{PCRE_AUTO_CALLOUT, PCRE2_AUTO_CALLOUT},
+		{PCRE_NEVER_UTF, PCRE2_NEVER_UTF},
+		{PCRE_NO_AUTO_POSSESS, PCRE2_NO_AUTO_POSSESS},
+		{PCRE_FIRSTLINE, PCRE2_FIRSTLINE},
+		{PCRE_DUPNAMES, PCRE2_DUPNAMES},
+		/* What PCRE2 replaced JavaScript compatibility with */
+		{PCRE_JAVASCRIPT_COMPAT, PCRE2_ALT_BSUX | PCRE2_ALLOW_EMPTY_CLASS | PCRE2_MATCH_UNSET_BACKREF},
+		{PCRE_NO_START_OPTIMIZE, PCRE2_NO_START_OPTIMIZE},
+		{PCRE_UCP, PCRE2_UCP},
+	};
+	/* PCRE only took these when matching; regex.inc documents PCRE_NOTEMPTY for compiling */
+	static const struct { uint32_t pcre; uint32_t pcre2; } match[] = {
+		{PCRE_NOTBOL, PCRE2_NOTBOL},
+		{PCRE_NOTEOL, PCRE2_NOTEOL},
+		{PCRE_NOTEMPTY, PCRE2_NOTEMPTY},
+		{PCRE_NOTEMPTY_ATSTART, PCRE2_NOTEMPTY_ATSTART},
+	};
+
+	options = PcreOptions();
+	uint32_t known = PCRE_EXTRA | PCRE_NEWLINE_MASK | PCRE_BSR_ANYCRLF | PCRE_BSR_UNICODE;
+	for (const auto &option : compile)
+	{
+		known |= option.pcre;
+		if (flags & option.pcre)
+			options.compile |= option.pcre2;
+	}
+	for (const auto &option : match)
+	{
+		known |= option.pcre;
+		if (flags & option.pcre)
+			options.match |= option.pcre2;
+	}
+	if (flags & ~known)
+		return false;
+
+	/* PCRE2 always rejects unknown escapes, as PCRE did with PCRE_EXTRA; without it, PCRE took them
+	   as the literal character (see RegEx::Compile) */
+	options.unknownEscapeIsLiteral = !(flags & PCRE_EXTRA);
+
+	switch (flags & PCRE_NEWLINE_MASK)
+	{
+	case 0: break;
+	case PCRE_NEWLINE_CR: options.newline = PCRE2_NEWLINE_CR; break;
+	case PCRE_NEWLINE_LF: options.newline = PCRE2_NEWLINE_LF; break;
+	case PCRE_NEWLINE_CRLF: options.newline = PCRE2_NEWLINE_CRLF; break;
+	case PCRE_NEWLINE_ANY: options.newline = PCRE2_NEWLINE_ANY; break;
+	case PCRE_NEWLINE_ANYCRLF: options.newline = PCRE2_NEWLINE_ANYCRLF; break;
+	default: return false;
+	}
+
+	if ((flags & PCRE_BSR_ANYCRLF) && (flags & PCRE_BSR_UNICODE))
+		return false;
+	if (flags & PCRE_BSR_ANYCRLF)
+		options.bsr = PCRE2_BSR_ANYCRLF;
+	if (flags & PCRE_BSR_UNICODE)
+		options.bsr = PCRE2_BSR_UNICODE;
+
+	return true;
+}
