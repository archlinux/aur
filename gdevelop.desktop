[Desktop Entry]
Name=GDevelop 5
Comment=A full featured, open source game engine, allowing to create HTML5 with powerful visual scripting.
Exec=/usr/bin/gdevelop
Icon=/usr/share/pixmaps/gdevelop.png
Categories=Development;
Type=Application
