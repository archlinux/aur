{
    "distSpecVersion": "1.0.1",
    "storage": {
        "rootDirectory": "/var/lib/zot",
        "commit": true,
        "dedupe": true,
        "gc": true,
        "gcDelay": "1h",
        "gcInterval": "24h"
    },
    "http": {
        "address": "127.0.0.1",
        "port": "8080"
    },
    "log": {
        "level": "info"
    },
    "extensions": {
      "metrics": {
        "enable": true
      },
      "sync": {
        "enable": true
      },
      "search": {
        "enable": true
      },
      "scrub": {
        "enable": true
      },
      "lint": {
        "enable": true
      },
      "trust": {
        "enable": true,
        "cosign": true,
        "notation": true
      },
      "ui": {
        "enable": true
      }
    }
}
