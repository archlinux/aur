#!/bin/sh
# Tower of Atum: the game opens on its play screen (offline, host online, or join a game from the lobby) and starts
# its own server when it needs one. Installed by pacman, so the game never updates itself (the AUR package does
# that). The game's log goes to $XDG_STATE_HOME/towerofatum; progress and the server's log are under
# ~/.config/unity3d. Extra arguments go to the game (for example --name Alex).
state="${XDG_STATE_HOME:-$HOME/.local/state}/towerofatum"
mkdir -p "$state"
exec /opt/towerofatum/TowerOfAtum -logFile "$state/client.log" "$@"
