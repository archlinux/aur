_tray_behavior_notice() {
  printf '%s\n' \
    ':: ChatGPT Desktop now follows the upstream Linux tray behavior:' \
    '   - Closing the last window hides it in the system tray; Electron remains running.' \
    '   - Launching ChatGPT Desktop again restores and focuses the existing instance.' \
    '   - Use Quit from the tray menu to fully exit and stop the local webview bridge.'
}

post_install() {
  [[ $1 == '26.727.51351-1' ]] && _tray_behavior_notice
}

post_upgrade() {
  [[ $1 == '26.727.51351-1' ]] && _tray_behavior_notice
}
