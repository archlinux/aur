 .../settings/browser/browser.component.html   | 24 +++++++++++++++----
 src/app/services/settings.service.ts          | 15 ++++++++++--
 src/assets/i18n/de.json                       |  6 +++--
 src/assets/i18n/el.json                       |  6 +++--
 src/assets/i18n/en.json                       |  6 +++--
 src/assets/i18n/es.json                       |  6 +++--
 src/assets/i18n/fr.json                       |  6 +++--
 src/assets/i18n/it.json                       |  6 +++--
 9 files changed, 66 insertions(+), 20 deletions(-)

diff --git a/app/handlers/sessions/browser-session.ts b/app/handlers/sessions/browser-session.ts
index 5138b66..d651e05 100644
--- a/app/handlers/sessions/browser-session.ts
+++ b/app/handlers/sessions/browser-session.ts
@@ -25,7 +25,7 @@ export class BrowserSession {
                 partition: this._session_name
             }
         });
-        
+
         this.applySettings(settings);
 
         this.view.webContents.on('did-start-loading', () => {
@@ -90,6 +90,13 @@ export class BrowserSession {
         if (settings && settings.use_proxy) {
             ses.setProxy({proxyRules:settings.proxy_settings})
         }
+
+        if (settings && settings.use_doh) {
+            app.configureHostResolver({
+                secureDnsMode: 'secure',
+                secureDnsServers: [ settings.doh ]
+            })
+        }
     }
 
     async create() {
@@ -204,4 +211,4 @@ export class BrowserSession {
     get mainWindow(){
         return this._mainWindow;
     }
-}
\ No newline at end of file
+}
diff --git a/src/app/modules/others/settings/browser/browser.component.html b/src/app/modules/others/settings/browser/browser.component.html
index f1a5326..a11d78f 100644
--- a/src/app/modules/others/settings/browser/browser.component.html
+++ b/src/app/modules/others/settings/browser/browser.component.html
@@ -13,14 +13,18 @@
         {{ 'settings.developer_tools' | translate }}</mat-slide-toggle><br> <br>
     <mat-slide-toggle (change)="settingService.setItem('use_proxy', $event.checked)" [(ngModel)]="settingService.settings.use_proxy"
         color="primary">
-        {{ 'settings.use_proxy' | translate }}</mat-slide-toggle>
+        {{ 'settings.use_proxy' | translate }}</mat-slide-toggle><br> <br>
+
+    <mat-slide-toggle (change)="settingService.setItem('use_doh', $event.checked)" [(ngModel)]="settingService.settings.use_doh"
+                      color="primary">
+        {{ 'settings.use_doh' | translate }}</mat-slide-toggle>
 </div>
 
-<div 
+<div
 *ngIf="settingService.settings.use_proxy"
 class="content" style="max-width: 800px; margin-top: 56px;">
     <div class="header">{{ 'settings.proxy_settings_header' | translate }}</div>
-    <mat-form-field 
+    <mat-form-field
     appearance="fill" style="width:100%">
             <mat-label>{{ 'settings.proxy_settings' | translate }}</mat-label>
             <input (input)="settingService.setProxySettings($event.target)" matInput type="text"
@@ -36,4 +40,16 @@ class="content" style="max-width: 800px; margin-top: 56px;">
         <input (input)="settingService.setUserAgent($event.target)" matInput type="text"
             [(ngModel)]="settingService.settings.useragent">
     </mat-form-field>
-</div>
\ No newline at end of file
+</div>
+
+<div
+        *ngIf="settingService.settings.use_doh"
+        class="content" style="max-width: 800px; margin-top: 56px;">
+    <div class="header">{{ 'settings.doh' | translate }}</div>
+    <mat-form-field
+            appearance="fill" style="width:100%">
+        <mat-label>{{ 'settings.doh' | translate }}</mat-label>
+        <input (input)="settingService.setDoH($event.target)" matInput type="text"
+               [(ngModel)]="settingService.settings.doh">
+    </mat-form-field>
+</div>
diff --git a/src/app/services/settings.service.ts b/src/app/services/settings.service.ts
index 5a8dfac..7a9d575 100644
--- a/src/app/services/settings.service.ts
+++ b/src/app/services/settings.service.ts
@@ -40,11 +40,13 @@ export class SettingsService {
     client_id:"",
     client_secret:"",
     use_proxy : false,
-    proxy_settings: ""
+    proxy_settings: "",
+    use_doh: false,
+    doh: ""
   }
 
   constructor(
-  ) { 
+  ) {
     const server_url = localStorage.getItem('server_url');
     const client_id = localStorage.getItem('client_id');
     const client_secret = localStorage.getItem('client_secret');
@@ -52,6 +54,7 @@ export class SettingsService {
     const test_ssl_location = localStorage.getItem('test_ssl_location');
     const proxy_settings = localStorage.getItem('proxy_settings');
     const setAgent = localStorage.getItem('useragent');
+    const doh = localStorage.getItem('doh')
     this._settings.useragent = setAgent == null || setAgent == "" ? this.detaultUserAgent  : setAgent;
     this._settings.dnt = localStorage.getItem('DNT') == 'true'? true : false ;
     this._settings.testssl = localStorage.getItem('testssl') == 'true'? true : false ;
@@ -73,6 +76,8 @@ export class SettingsService {
     this._settings.client_secret = client_secret != null ? client_secret : "";
     this._settings.use_proxy = localStorage.getItem('use_proxy') == 'true'? true : false ;
     this._settings.proxy_settings = proxy_settings != null ? proxy_settings : "";
+    this._settings.use_doh = localStorage.getItem('use_doh') == 'true'? true : false ;
+    this._settings.doh = doh? doh : "";
   }
   setItem(key :string, value:any):void{
     localStorage.setItem(key, value);
@@ -95,6 +100,12 @@ export class SettingsService {
     localStorage.setItem('test_ssl_location', location);
   }
 
+  setDoH(event:any) {
+    if (event) {
+      localStorage.setItem('doh', event.value);
+    }
+  }
+
   get settings(){
     return this._settings;
   }
