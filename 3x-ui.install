post_install() {
  echo "Downloading latest geo files..."

  repos=(
    "Loyalsoldier/v2ray-rules-dat"
    "chocolate4u/Iran-v2ray-rules:_IR"
    "runetfreedom/russia-v2ray-rules-dat:_RU"
  )

  for repo in "${repos[@]}"; do
    user_suffix="${repo%%:*}"
    suffix="${repo#*:}"
    [ "$suffix" = "$repo" ] && suffix=""

    for f in geoip geosite; do
      curl -fSL "https://github.com/$user_suffix/releases/latest/download/$f.dat" \
        -o "/usr/share/x-ui/bin/${f}${suffix}.dat" || echo "Failed to fetch $f from $user_suffix"
    done
  done
}

post_upgrade() {
  post_install
}

pre_remove() {
  rm -f /usr/share/x-ui/bin/geo{ip,site}{,_IR,_RU}.dat
}
