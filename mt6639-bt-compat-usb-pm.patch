Bluetooth: btusb: balance MediaTek reset runtime PM references

Release the interface PM reference after both reset paths; clear the
reset guard if acquiring the PM reference fails before reset starts.
Keep the GPIO reset guard latched pending disconnect as upstream does.

Source: Linux 7.2 drivers/bluetooth/btusb.c
SPDX-License-Identifier: GPL-2.0-or-later

--- a/btusb.c
+++ b/btusb.c
@@ -2908,8 +2908,10 @@
 	}

 	err = usb_autopm_get_interface(data->intf);
-	if (err < 0)
+	if (err < 0) {
+		clear_bit(BTMTK_HW_RESET_ACTIVE, &btmtk_data->flags);
 		return err;
+	}

 	/* Release MediaTek ISO data interface */
 	btusb_mtk_release_iso_intf(hdev);
@@ -2927,12 +2929,14 @@
 		gpiod_set_value_cansleep(data->reset_gpio, 1);
 		msleep(200);
 		gpiod_set_value_cansleep(data->reset_gpio, 0);
+		usb_autopm_put_interface(data->intf);
 		return 0;
 	}

 	err = btmtk_usb_subsys_reset(hdev, btmtk_data->dev_id);

 	usb_queue_reset_device(data->intf);
+	usb_autopm_put_interface(data->intf);
 	clear_bit(BTMTK_HW_RESET_ACTIVE, &btmtk_data->flags);

 	return err;
--- a/btmtk.c
+++ b/btmtk.c
@@ -716,8 +716,10 @@
 		goto err_free_wc;
 	}

-	if (data->evt_skb == NULL)
+	if (data->evt_skb == NULL) {
+		err = -EIO;
 		goto err_free_wc;
+	}

 	wmt_evt = skb_pull_data(data->evt_skb, sizeof(*wmt_evt));
 	if (!wmt_evt) {
@@ -772,6 +774,7 @@
 	kfree_skb(data->evt_skb);
 	data->evt_skb = NULL;
 err_free_wc:
+	clear_bit(BTMTK_TX_WAIT_VND_EVT, &data->flags);
 	kfree(wc);
 	return err;
 }
