    case `ps --no-headers -o comm 1` in
        dinit)
            echo "::: Detected `dinit` Installing dinit service file"
            echo "::: Installing dinit service description file"
            ln -s /opt/technitium-dns-server/service/technitium-dns-server.dinit /etc/dinit.d/technitium-dns-server
            echo "::: Reloading dinit service description file"
