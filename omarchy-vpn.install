_get_user_home() {
    local real_user="${SUDO_USER:-$(logname 2>/dev/null)}"
    [ -z "$real_user" ] && return 1
    eval echo "~$real_user"
}

_run_as_user() {
    local home real_user uid
    home=$(_get_user_home) || return
    real_user="${SUDO_USER:-$(logname 2>/dev/null)}"
    [ -z "$real_user" ] && return
    uid=$(id -u "$real_user") || return
    # Run as the installing user so plugin files are owned correctly and a
    # live omarchy-shell can be told to rescan.
    sudo -u "$real_user" HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" "$@"
}

post_install() {
    _run_as_user omarchy-vpn --setup >/dev/null 2>&1
}

post_upgrade() {
    _run_as_user omarchy-vpn --remove >/dev/null 2>&1
    _run_as_user omarchy-vpn --setup >/dev/null 2>&1
}

pre_remove() {
    _run_as_user omarchy-vpn --remove >/dev/null 2>&1
}
