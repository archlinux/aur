+        const auto presetOutputIt = presetOutputsMap.find(currentOutput->name());
+        if (presetOutputIt != presetOutputsMap.end()) {
+            applyPresetToOutput(outputModel, outputIndex, currentOutput, currentConfig, *presetOutputIt);
