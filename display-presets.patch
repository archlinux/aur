+QVariantList KScreenDaemon::getPresets()
+{
+    QVariantList presets;
+
+    if (!m_presetApplier) {
+        return presets;
+    }
+
+    updatePresetScreenConfiguration();
+
+    for (int i = 0; i < m_presetApplier->rowCount(); ++i) {
+        const QModelIndex index = m_presetApplier->index(i, 0);
+        QVariantMap preset;
+
+        const QString presetId = m_presetApplier->data(index, Presets::IdRole).toString();
+        preset[QStringLiteral("presetId")] = presetId;
+        preset[QStringLiteral("name")] = m_presetApplier->data(index, Presets::NameRole);
+        preset[QStringLiteral("description")] = m_presetApplier->data(index, Presets::DescriptionRole);
+        preset[QStringLiteral("lastUsed")] = m_presetApplier->data(index, Presets::LastUsedRole);
+        preset[QStringLiteral("outputCount")] = m_presetApplier->data(index, Presets::OutputCountRole);
+        preset[QStringLiteral("shortcut")] = m_presetApplier->data(index, Presets::ShortcutRole);
+        preset[QStringLiteral("configuration")] = m_presetApplier->data(index, Presets::ConfigurationRole);
+        preset[QStringLiteral("isCurrent")] = m_presetApplier->isPresetCurrent(presetId);
+
+        presets.append(preset);
+    }
+
+    return presets;
