 PresetApplier::PresetApplier(QObject *parent)
     : Presets(parent)
 {
+    // Initialize shortcuts when presets are loaded or changed
+    connect(this, &Presets::countChanged, this, &PresetApplier::initShortcuts);
+    connect(this, &Presets::presetStatusChanged, this, &PresetApplier::initShortcuts);
+}
+
+void PresetApplier::initShortcuts()
+{
+    // Clear existing shortcuts
+    for (auto action : m_shortcutActions) {
+        KGlobalAccel::self()->removeAllShortcuts(action);
+        action->deleteLater();
+    }
+    m_shortcutActions.clear();
+
+    // Register shortcuts for all presets
+    for (const auto &preset : m_presets) {
+        if (!preset.shortcut.isEmpty()) {
+            registerShortcut(preset.id, preset.shortcut);
+        }
+    }
 }
 
 void PresetApplier::applyPreset(const QString &presetId)
@@ -83,4 +104,48 @@ void PresetApplier::applyPresetToOutput(const KScreen::OutputPtr &output, const
     if (presetOutputMap[QStringLiteral("primary")].toBool()) {
         config->setPrimaryOutput(output);
     }
+}
+
+void PresetApplier::registerShortcut(const QString &presetId, const QKeySequence &shortcut)
+{
+    if (shortcut.isEmpty()) {
+        return;
+    }
+
+    // Create action for this preset
+    QAction *action = new QAction(this);
+    action->setProperty("componentName", QStringLiteral("kscreen"));
+    action->setObjectName(QStringLiteral("activate-preset-%1").arg(presetId));
+
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &p) {
+        return p.id == presetId;
+    });
+
+    if (it != m_presets.end()) {
+        action->setText(i18n("Activate Display Preset: %1", it->name));
+    }
+
+    // Register the shortcut
+    KGlobalAccel::self()->setShortcut(action, {shortcut}, KGlobalAccel::NoAutoloading);
+
+    // Store action for later cleanup
+    m_shortcutActions[presetId] = action;
+
+    // Connect to trigger preset activation
+    connect(action, &QAction::triggered, this, [this, presetId]() {
+        applyPreset(presetId);
+    });
+}
+
+void PresetApplier::unregisterShortcut(const QString &presetId)
+{
+    if (m_shortcutActions.contains(presetId)) {
+        QAction *action = m_shortcutActions.take(presetId);
+
+        // Remove global shortcut
+        KGlobalAccel::self()->removeAllShortcuts(action);
+
+        // Delete the action
+        action->deleteLater();
+    }
 }
