+void KCMKScreen::savePreset(const QString &name, const QString &description)
+{
+    qDebug() << "KCMKScreen::savePreset called with name:" << name;
+
+    if (!m_configHandler || !m_configHandler->config()) {
+        qDebug() << "Error: No config handler or config available";
+        return;
+    }
+
+    qDebug() << "Calling PresetManager::savePreset";
+    m_presetManager->savePreset(name, description, m_configHandler->config());
+}
+
+void KCMKScreen::loadPreset(const QString &presetId)
+{
+    if (!m_configHandler) {
+        return;
+    }
+
+    connect(
+        m_presetManager,
+        &PresetManager::presetLoaded,
+        this,
+        [this](KScreen::ConfigPtr config) {
+            if (config) {
+                m_configHandler->setConfig(config);
+                checkConfig();
+                settingsChanged();
+                Q_EMIT changed();
+            }
+        },
+        Qt::SingleShotConnection);
+
+    m_presetManager->loadPreset(presetId);
+}
+
+void KCMKScreen::deletePreset(const QString &presetId)
+{
+    m_presetManager->deletePreset(presetId);
+}
