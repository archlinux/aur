+PresetModel::PresetModel(QDBusInterface *kscreenInterface, QObject *parent)
+    : QAbstractListModel(parent)
+    , m_kscreenInterface(kscreenInterface)
+{
+    // Connect to D-Bus signal for preset availability changes
+    if (m_kscreenInterface && m_kscreenInterface->isValid()) {
+        qDebug() << "PresetModel: D-Bus interface is valid, connecting signal and loading presets";
+        QDBusConnection::sessionBus().connect(QStringLiteral("org.kde.kded6"),
+                                              QStringLiteral("/modules/kscreen"),
+                                              QStringLiteral("org.kde.KScreen"),
+                                              QStringLiteral("presetAvailabilityChanged"),
+                                              this,
+                                              SLOT(onPresetAvailabilityChanged()));
+
+        // Load initial presets
+        refreshPresets();
+    } else {
+        qWarning() << "PresetModel: D-Bus interface is NOT valid!"
+                   << "Interface exists:" << (m_kscreenInterface != nullptr) << "Is valid:" << (m_kscreenInterface ? m_kscreenInterface->isValid() : false);
+    }
+}
+
+int PresetModel::rowCount(const QModelIndex &parent) const
+{
+    Q_UNUSED(parent)
+    return m_presets.count();
+}
+
+QVariant PresetModel::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() >= m_presets.count()) {
+        return QVariant();
+    }
+
+    const QVariant &presetVariant = m_presets.at(index.row());
+    if (index.row() == 0 && role == Qt::DisplayRole) {
+        qDebug() << "PresetModel::data - first preset type:" << presetVariant.typeName() << "canConvert to map:" << presetVariant.canConvert<QVariantMap>();
+    }
+    const QVariantMap preset = presetVariant.toMap();
+
+    switch (role) {
+    case IdRole:
+        return preset[QStringLiteral("presetId")];
+    case NameRole:
+        return preset[QStringLiteral("name")];
+    case DescriptionRole:
+        return preset[QStringLiteral("description")];
+    case LastUsedRole:
+        return preset[QStringLiteral("lastUsed")];
+    case OutputCountRole:
+        return preset[QStringLiteral("outputCount")];
+    case ShortcutRole:
+        return preset[QStringLiteral("shortcut")];
+    case ConfigurationRole:
+        return preset[QStringLiteral("configuration")];
+    case IsCurrentRole:
+        return preset[QStringLiteral("isCurrent")];
+    default:
+        return QVariant();
+    }
+}
+
+QHash<int, QByteArray> PresetModel::roleNames() const
+{
+    QHash<int, QByteArray> roles;
+    roles[IdRole] = "presetId";
+    roles[NameRole] = "name";
+    roles[DescriptionRole] = "description";
+    roles[LastUsedRole] = "lastUsed";
+    roles[OutputCountRole] = "outputCount";
+    roles[ShortcutRole] = "shortcut";
+    roles[ConfigurationRole] = "configuration";
+    roles[IsCurrentRole] = "isCurrent";
+    return roles;
+}
+
+bool PresetModel::isPresetAvailable(const QString &presetId)
+{
+    if (!m_kscreenInterface || !m_kscreenInterface->isValid()) {
+        return false;
+    }
+
+    QDBusReply<bool> reply = m_kscreenInterface->call(QStringLiteral("isPresetAvailable"), presetId);
+    return reply.isValid() ? reply.value() : false;
+}
+
+void PresetModel::refreshPresets()
+{
+    if (!m_kscreenInterface || !m_kscreenInterface->isValid()) {
+        qWarning() << "PresetModel::refreshPresets() - interface not valid";
+        return;
+    }
+
+    qDebug() << "PresetModel::refreshPresets() - calling getPresets via D-Bus";
+    QDBusReply<QVariantList> reply = m_kscreenInterface->call(QStringLiteral("getPresets"));
+    if (reply.isValid()) {
+        QVariantList presets;
+        const QVariantList &rawPresets = reply.value();
+        qDebug() << "PresetModel::refreshPresets() - got" << rawPresets.count() << "raw presets";
+
+        // Convert QDBusArgument to QVariantMap for each preset
+        for (const QVariant &rawPreset : rawPresets) {
+            if (rawPreset.canConvert<QDBusArgument>()) {
+                QDBusArgument arg = rawPreset.value<QDBusArgument>();
+                QVariantMap preset;
+                arg >> preset;
+                presets.append(preset);
+            } else if (rawPreset.canConvert<QVariantMap>()) {
+                presets.append(rawPreset.toMap());
+            }
+        }
+
+        qDebug() << "PresetModel::refreshPresets() - converted to" << presets.count() << "presets";
+        if (!presets.isEmpty()) {
+            QVariantMap firstPreset = presets.first().toMap();
+            qDebug() << "First preset keys:" << firstPreset.keys();
+            qDebug() << "First preset name:" << firstPreset[QStringLiteral("name")];
+        }
+
+        beginResetModel();
+        m_presets = presets;
+        endResetModel();
+    } else {
+        qWarning() << "PresetModel::refreshPresets() - D-Bus call failed:" << reply.error().message();
+    }
+}
+
+void PresetModel::onPresetAvailabilityChanged()
+{
+    refreshPresets();
+}
