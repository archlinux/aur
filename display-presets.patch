+class PresetManager : public QAbstractListModel
+{
+    Q_OBJECT
+    Q_PROPERTY(int count READ rowCount NOTIFY countChanged)
+    Q_PROPERTY(bool hasPresets READ hasPresets NOTIFY countChanged)
+
+public:
