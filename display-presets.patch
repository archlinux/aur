+bool Presets::isPresetCurrent(const QString &presetId) const
+{
+    if (!m_screenConfiguration) {
+        return false;
+    }
+
+    const auto preset = getPreset(presetId);
+    if (preset.id.isEmpty()) {
+        return false;
+    }
+
+    // Compare current configuration with preset configuration
+    const auto presetOutputsList = preset.configuration[QStringLiteral("outputs")].toList();
+    const auto currentOutputs = m_screenConfiguration->outputs();
+
+    // Build current configuration map for comparison
+    QHash<QString, QVariantMap> currentOutputsMap;
+    for (const auto &output : currentOutputs) {
+        if (!output->isConnected()) {
+            continue;
+        }
+
+        QVariantMap outputMap;
+        outputMap[QStringLiteral("enabled")] = output->isEnabled();
+        outputMap[QStringLiteral("primary")] = output->isPrimary();
+        outputMap[QStringLiteral("priority")] = output->priority();
+        outputMap[QStringLiteral("scale")] = output->scale();
+        outputMap[QStringLiteral("rotation")] = static_cast<int>(output->rotation());
+        outputMap[QStringLiteral("pos")] = QVariantMap{{QStringLiteral("x"), output->pos().x()}, {QStringLiteral("y"), output->pos().y()}};
+
+        if (output->currentMode()) {
+            QVariantMap modeMap;
+            modeMap[QStringLiteral("id")] = output->currentModeId();
+            modeMap[QStringLiteral("width")] = output->currentMode()->size().width();
+            modeMap[QStringLiteral("height")] = output->currentMode()->size().height();
+            modeMap[QStringLiteral("refreshRate")] = output->currentMode()->refreshRate();
+            outputMap[QStringLiteral("mode")] = modeMap;
+        }
+
+        currentOutputsMap[output->name()] = outputMap;
+    }
+
+    // Compare each preset output with current configuration
+    for (const auto &presetOutputVariant : presetOutputsList) {
+        const auto presetOutputMap = presetOutputVariant.toMap();
+        const QString outputName = presetOutputMap[QStringLiteral("name")].toString();
+
+        const auto currentOutputIt = currentOutputsMap.find(outputName);
+        if (currentOutputIt == currentOutputsMap.end()) {
+            // Output not found in current config, check if preset expects it to be disabled
+            if (presetOutputMap[QStringLiteral("enabled")].toBool()) {
+                return false; // Preset expects enabled output that's not present
+            }
+            continue;
+        }
+
+        const auto &currentOutputMap = *currentOutputIt;
+
+        // Compare key properties
+        if (presetOutputMap[QStringLiteral("enabled")].toBool() != currentOutputMap[QStringLiteral("enabled")].toBool()) {
+            return false;
+        }
+
+        // Only compare other properties if output is enabled
+        if (presetOutputMap[QStringLiteral("enabled")].toBool()) {
+            if (presetOutputMap[QStringLiteral("primary")].toBool() != currentOutputMap[QStringLiteral("primary")].toBool()
+                || presetOutputMap[QStringLiteral("priority")].toInt() != currentOutputMap[QStringLiteral("priority")].toInt()
+                || qAbs(presetOutputMap[QStringLiteral("scale")].toReal() - currentOutputMap[QStringLiteral("scale")].toReal()) > 0.01
+                || presetOutputMap[QStringLiteral("rotation")].toInt() != currentOutputMap[QStringLiteral("rotation")].toInt()) {
+                return false;
+            }
+
+            // Compare position
+            const auto presetPos = presetOutputMap[QStringLiteral("pos")].toMap();
+            const auto currentPos = currentOutputMap[QStringLiteral("pos")].toMap();
+            if (presetPos[QStringLiteral("x")].toInt() != currentPos[QStringLiteral("x")].toInt()
+                || presetPos[QStringLiteral("y")].toInt() != currentPos[QStringLiteral("y")].toInt()) {
+                return false;
+            }
+
+            // Compare mode
+            const auto presetMode = presetOutputMap[QStringLiteral("mode")].toMap();
+            const auto currentMode = currentOutputMap[QStringLiteral("mode")].toMap();
+            if (presetMode[QStringLiteral("id")].toString() != currentMode[QStringLiteral("id")].toString()) {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
