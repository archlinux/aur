+++ b/kcm/ui/PresetScreenLayout.qml
@@ -0,0 +1,165 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+import QtQuick 2.15
+import QtQuick.Layouts 1.15
+import QtQuick.Controls 2.15 as QQC2
+import org.kde.kirigami 2.20 as Kirigami
+
+Item {
+    id: presetScreenLayout
+
+    property var outputs: []
+
+    // Calculate bounds for real positioning
+    property var bounds: {
+        if (!outputs || outputs.length === 0) {
+            return { minX: 0, minY: 0, maxX: 1920, maxY: 1080 };
+        }
+
+        var minX = 999999, minY = 999999, maxX = -999999, maxY = -999999;
+
+        for (var i = 0; i < outputs.length; i++) {
+            var output = outputs[i];
+            if (!output.enabled) continue;
+
+            var pos = output.pos || { x: 0, y: 0 };
+            var mode = output.mode || { width: 1920, height: 1080 };
+            var scale = output.scale || 1;
+
+            var w = mode.width / scale;
+            var h = mode.height / scale;
+            var x = pos.x || 0;
+            var y = pos.y || 0;
+
+            minX = Math.min(minX, x);
+            minY = Math.min(minY, y);
+            maxX = Math.max(maxX, x + w);
+            maxY = Math.max(maxY, y + h);
+        }
+
+        if (minX === 999999) {
+            return { minX: 0, minY: 0, maxX: 1920, maxY: 1080 };
+        }
+
+        return { minX: minX, minY: minY, maxX: maxX, maxY: maxY };
+    }
+
+    property real layoutWidth: bounds.maxX - bounds.minX
+    property real layoutHeight: bounds.maxY - bounds.minY
+
+    // Scale to fit container
+    property real scaleFactor: {
+        if (layoutWidth <= 0 || layoutHeight <= 0 || width <= 0 || height <= 0) {
+            return 0.1;
+        }
+        var margin = 5;
+        var scaleX = (width - margin * 2) / layoutWidth;
+        var scaleY = (height - margin * 2) / layoutHeight;
+        var finalScale = Math.min(scaleX, scaleY);
+
+        // For very wide layouts, use a minimum scale to ensure visibility
+        if (finalScale < 0.05) {
+            finalScale = 0.05;
+        }
+
+        return finalScale;
+    }
+
+    property real xOffset: (width - layoutWidth * scaleFactor) / 2
+    property real yOffset: (height - layoutHeight * scaleFactor) / 2
+
+    // Real positioned monitors
+    Repeater {
+        model: outputs
+
+        Rectangle {
+            property var output: modelData
+            property var pos: output.pos || { x: 0, y: 0 }
+            property var mode: output.mode || { width: 1920, height: 1080 }
+            property real scale: output.scale || 1
+            property real monitorWidth: mode.width / scale
+            property real monitorHeight: mode.height / scale
+
+            visible: output.enabled !== false
+            x: ((pos.x || 0) - bounds.minX) * scaleFactor + xOffset
+            y: ((pos.y || 0) - bounds.minY) * scaleFactor + yOffset
+            width: monitorWidth * scaleFactor
+            height: monitorHeight * scaleFactor
+
+            radius: 2
+            color: Kirigami.Theme.backgroundColor
+            border.color: output.primary ? Kirigami.Theme.highlightColor : Kirigami.Theme.textColor
+            border.width: 2
+
+            // Simple bottom bar as orientation indicator
+            Rectangle {
+                anchors {
+                    left: parent.left
+                    right: parent.right
+                    bottom: parent.bottom
+                    margins: 1
+                }
+                height: 2
+                color: parent.border.color
+            }
+
+            // Monitor info text - responsive to scaled size
+            Column {
+                anchors.centerIn: parent
+                spacing: Math.max(1, parent.height / 15)
+
+                Text {
+                    anchors.horizontalCenter: parent.horizontalCenter
+                    text: {
+                        var name = output.name || "Monitor";
+                        return name.replace("eDP-", "L").replace("DP-", "M").replace("HDMI-", "H");
+                    }
+                    color: Kirigami.Theme.textColor
+                    font.pixelSize: Math.max(6, Math.min(12, parent.parent.height / 5))
+                    font.bold: output.primary
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    visible: parent.parent.height > 15
+                }
+
+                Text {
+                    anchors.horizontalCenter: parent.horizontalCenter
+                    text: {
+                        var res = (mode.width || 1920) + "×" + (mode.height || 1080);
+                        var refresh = Math.round(mode.refreshRate || 60) + "Hz";
+                        return res + " " + refresh;
+                    }
+                    color: Kirigami.Theme.textColor
+                    font.pixelSize: Math.max(4, Math.min(8, parent.parent.height / 8))
+                    opacity: 0.8
+                    horizontalAlignment: Text.AlignHCenter
+                    elide: Text.ElideRight
+                    visible: parent.parent.height > 20
+                }
+
+                Text {
+                    anchors.horizontalCenter: parent.horizontalCenter
+                    text: "HDR"
+                    color: Kirigami.Theme.positiveTextColor
+                    font.pixelSize: Math.max(4, Math.min(8, parent.parent.height / 8))
+                    font.bold: true
+                    horizontalAlignment: Text.AlignHCenter
+                    visible: output.hdr && parent.parent.height > 25
+                }
+            }
+        }
+    }
+
+    // Placeholder when no outputs
+    Kirigami.Icon {
+        anchors.centerIn: parent
+        width: Math.min(parent.width * 0.5, Kirigami.Units.iconSizes.medium)
+        height: width
+        source: "computer"
+        opacity: 0.3
+        visible: !outputs || outputs.length === 0
+    }
+}
