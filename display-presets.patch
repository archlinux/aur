+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "preset_applier.h"
+
+#include <KScreen/Config>
+#include <KScreen/Mode>
+#include <KScreen/Output>
+#include <KScreen/SetConfigOperation>
+
+#include <KLocalizedString>
+
+#include <QDebug>
+
+PresetApplier::PresetApplier(QObject *parent)
+    : Presets(parent)
+{
+}
+
+void PresetApplier::applyPreset(const QString &presetId)
+{
+    if (!m_screenConfiguration) {
+        Q_EMIT errorOccurred(i18n("No screen configuration available"));
+        return;
+    }
+
+    const auto preset = getPreset(presetId);
+    if (preset.id.isEmpty()) {
+        Q_EMIT errorOccurred(i18n("Preset not found"));
+        return;
+    }
+
+    // Clone the configuration to avoid modifying the original
+    auto configToApply = m_screenConfiguration->clone();
+
+    // Build lookup map for preset outputs
+    const auto presetOutputsList = preset.configuration[QStringLiteral("outputs")].toList();
+    QHash<QString, QVariantMap> presetOutputsMap;
+    for (const auto &presetOutputVariant : presetOutputsList) {
+        const auto presetOutputMap = presetOutputVariant.toMap();
+        const QString outputName = presetOutputMap[QStringLiteral("name")].toString();
+        presetOutputsMap[outputName] = presetOutputMap;
+    }
+
+    // Apply preset to cloned config
+    for (const auto &currentOutput : configToApply->outputs()) {
+        const auto presetOutputIt = presetOutputsMap.find(currentOutput->name());
+        if (presetOutputIt != presetOutputsMap.end()) {
+            const auto &presetOutputMap = *presetOutputIt;
+
+            currentOutput->setEnabled(presetOutputMap[QStringLiteral("enabled")].toBool());
+            currentOutput->setPriority(presetOutputMap[QStringLiteral("priority")].toInt());
+            currentOutput->setScale(presetOutputMap[QStringLiteral("scale")].toReal());
+
+            const auto newRotation = static_cast<KScreen::Output::Rotation>(presetOutputMap[QStringLiteral("rotation")].toInt());
+            currentOutput->setRotation(newRotation);
+
+            const auto pos = presetOutputMap[QStringLiteral("pos")].toMap();
+            const QPoint newPos(pos[QStringLiteral("x")].toInt(), pos[QStringLiteral("y")].toInt());
+            currentOutput->setPos(newPos);
+
+            const auto mode = presetOutputMap[QStringLiteral("mode")].toMap();
+            const QString modeId = mode[QStringLiteral("id")].toString();
+            currentOutput->setCurrentModeId(modeId);
+
+            if (presetOutputMap[QStringLiteral("priority")].toInt() == 1) {
+                configToApply->setPrimaryOutput(currentOutput);
+            }
+        } else {
+            currentOutput->setEnabled(false);
+        }
+    }
+
+    // Apply cloned configuration
+    auto setConfigOp = new KScreen::SetConfigOperation(configToApply);
+    connect(setConfigOp, &KScreen::ConfigOperation::finished, this, [this, presetId]() {
+        updateLastUsed(presetId);
+        Q_EMIT presetApplied(presetId);
+    });
+
+    setConfigOp->exec();
+}
