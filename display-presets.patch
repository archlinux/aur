From 0ad0bde0e04ab397cca66ce3d4de2c48705f30e8 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jerzy=20Ko=C5=82osowski?= <jerzy@kolosowscy.pl>
Date: Mon, 15 Sep 2025 13:45:26 +0200
Subject: [PATCH 03/15] Refactor preset preview architecture to match
 ScreenView/Output pattern

Architecture Changes:
- Split PresetScreenLayout.qml into modular PresetView.qml + PresetOutput.qml
- PresetView.qml follows ScreenView.qml pattern with Repeater + delegate architecture
- PresetOutput.qml mirrors Output.qml structure for consistency and maintainability
- Unified property naming and code organization across all view components

Code Organization:
- PresetView handles layout calculations (bounds, scaling, positioning)
- PresetOutput handles individual monitor rendering and availability state
- Clean separation of concerns between container and item components
- Consistent with existing KScreen codebase architecture patterns

Benefits:
- Better code maintainability and consistency with main interface
- Modular architecture allows independent enhancement of components
- Easier to understand and debug with familiar patterns
- Follows established Qt/QML best practices for delegate-based views
---
 kcm/ui/PresetOutput.qml       | 160 ++++++++++++++++++++++++
 kcm/ui/PresetPage.qml         |   2 +-
 kcm/ui/PresetScreenLayout.qml | 226 ----------------------------------
 kcm/ui/PresetView.qml         | 100 +++++++++++++++
 4 files changed, 261 insertions(+), 227 deletions(-)
 create mode 100644 kcm/ui/PresetOutput.qml
 delete mode 100644 kcm/ui/PresetScreenLayout.qml
 create mode 100644 kcm/ui/PresetView.qml

diff --git a/kcm/ui/PresetOutput.qml b/kcm/ui/PresetOutput.qml
new file mode 100644
index 00000000..c395114f
--- /dev/null
+++ b/kcm/ui/PresetOutput.qml
@@ -0,0 +1,160 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    Based on Output.qml by Roman Gilg, Dan Vratil, and Kai Uwe Broulik
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+import QtQuick 2.15
+import QtQuick.Layouts 1.15
+import QtQuick.Controls 2.15 as QQC2
+import org.kde.kirigami 2.20 as Kirigami
+
+Item {
+    id: presetOutput
+
+    property var outputData: null
+    property var kcm: null
+    property real scaleFactor: 1.0
+    property real xOffset: 0
+    property real yOffset: 0
+    property var bounds: ({ minX: 0, minY: 0, maxX: 1920, maxY: 1080 })
+
+    readonly property var pos: outputData?.pos || { x: 0, y: 0 }
+    readonly property var mode: outputData?.mode || { width: 1920, height: 1080 }
+    readonly property real scale: outputData?.scale || 1
+    readonly property real monitorWidth: mode.width / scale
+    readonly property real monitorHeight: mode.height / scale
+    readonly property bool outputAvailable: !kcm || kcm.isOutputCurrentlyConnected(outputData?.id || "")
+
+    visible: outputData?.enabled !== false
+    x: ((pos.x || 0) - bounds.minX) * scaleFactor + xOffset
+    y: ((pos.y || 0) - bounds.minY) * scaleFactor + yOffset
+    width: monitorWidth * scaleFactor
+    height: monitorHeight * scaleFactor
+    opacity: outputAvailable ? 1.0 : 0.4
+
+    Rectangle {
+        id: outline
+        anchors.centerIn: parent
+        width: parent.width
+        height: parent.height
+        radius: 2
+        color: outputAvailable ? Kirigami.Theme.backgroundColor : Kirigami.Theme.disabledTextColor
+        border.color: outputAvailable ? Kirigami.Theme.textColor : Kirigami.Theme.disabledTextColor
+        border.width: 2
+
+        // Simple bottom bar as orientation indicator
+        Rectangle {
+            anchors {
+                left: parent.left
+                right: parent.right
+                bottom: parent.bottom
+                margins: 1
+            }
+            height: 2
+            color: parent.border.color
+        }
+
+        // Priority number in top-right corner
+        Rectangle {
+            anchors {
+                top: parent.top
+                right: parent.right
+                margins: 2
+            }
+            width: priorityText.width + 4
+            height: priorityText.height + 2
+            radius: 2
+            color: Kirigami.Theme.highlightColor
+            visible: parent.width > 30 && parent.height > 20
+
+            Text {
+                id: priorityText
+                anchors.centerIn: parent
+                text: presetOutput.outputData?.priority || "1"
+                color: Kirigami.Theme.highlightedTextColor
+                font.pixelSize: Math.max(6, Math.min(10, parent.parent.parent.height / 8))
+                font.bold: true
+            }
+        }
+
+        // Monitor info text - responsive to scaled size
+        Column {
+            anchors.centerIn: parent
+            spacing: Math.max(1, parent.height / 15)
+
+            Text {
+                anchors.horizontalCenter: parent.horizontalCenter
+                width: parent.parent.width - 4
+                text: {
+                    // Use same logic as Utils::outputName()
+                    var name = "";
+                    var vendor = presetOutput.outputData?.vendor || "";
+                    var model = presetOutput.outputData?.model || "";
+
+                    if (vendor) {
+                        name = vendor + " ";
+                    }
+                    if (model) {
+                        name += model + " ";
+                    }
+
+                    if (name.trim()) {
+                        return name.trim();
+                    }
+
+                    return presetOutput.outputData?.name || i18nc("@label default monitor name", "Monitor");
+                }
+                color: Kirigami.Theme.textColor
+                font.pixelSize: Math.max(6, Math.min(12, parent.parent.height / 5))
+                font.bold: false
+                horizontalAlignment: Text.AlignHCenter
+                wrapMode: Text.Wrap
+                maximumLineCount: 2
+                visible: parent.parent.height > 15
+            }
+
+            Text {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: {
+                    var res = (mode.width || 1920) + "×" + (mode.height || 1080);
+                    var refresh = Math.round(mode.refreshRate || 60) + "Hz";
+                    var extras = [];
+
+                    if (presetOutput.outputData?.hdr) {
+                        extras.push(i18nc("@label HDR indicator", "HDR"));
+                    }
+                    if (presetOutput.outputData?.edr_policy && presetOutput.outputData.edr_policy !== 0) {
+                        extras.push(i18nc("@label EDR indicator", "EDR"));
+                    }
+
+                    var result = res + " " + refresh;
+                    if (extras.length > 0) {
+                        result += " " + extras.join(" ");
+                    }
+
+                    return result;
+                }
+                color: Kirigami.Theme.textColor
+                font.pixelSize: Math.max(5, Math.min(10, parent.parent.height / 6))
+                opacity: 0.8
+                horizontalAlignment: Text.AlignHCenter
+                elide: Text.ElideRight
+                visible: parent.parent.height > 20
+            }
+
+            Text {
+                anchors.horizontalCenter: parent.horizontalCenter
+                text: {
+                    var scale = presetOutput.outputData?.scale || 1;
+                    return i18nc("@info monitor scale factor", "Scale: %1%", Math.round(scale * 100));
+                }
+                color: Kirigami.Theme.textColor
+                font.pixelSize: Math.max(5, Math.min(9, parent.parent.height / 7))
+                opacity: 0.7
+                horizontalAlignment: Text.AlignHCenter
+                visible: parent.parent.height > 25
+            }
+        }
+    }
+}
\ No newline at end of file
