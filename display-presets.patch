+PresetManager::PresetManager(QObject *parent)
+    : QAbstractListModel(parent)
+{
+    loadPresetsFromDisk();
+}
+
+int PresetManager::rowCount(const QModelIndex &parent) const
+{
+    Q_UNUSED(parent)
+    return m_presets.count();
+}
+
+QVariant PresetManager::data(const QModelIndex &index, int role) const
+{
+    if (!index.isValid() || index.row() >= m_presets.count()) {
+        return QVariant();
+    }
+
+    const DisplayPreset &preset = m_presets.at(index.row());
+
+    switch (role) {
+    case IdRole:
+        return preset.id;
+    case NameRole:
+        return preset.name;
+    case DescriptionRole:
+        return preset.description;
+    case CreatedRole:
+        return preset.created;
+    case LastUsedRole:
+        return preset.lastUsed;
+    case OutputCountRole:
+        return preset.outputIds.count();
+    case ConfigurationRole:
+        return preset.configuration;
+    default:
+        return QVariant();
+    }
+}
+
+QHash<int, QByteArray> PresetManager::roleNames() const
+{
+    return {
+        {IdRole, "presetId"},
+        {NameRole, "name"},
+        {DescriptionRole, "description"},
+        {CreatedRole, "created"},
+        {LastUsedRole, "lastUsed"},
+        {OutputCountRole, "outputCount"},
+        {ConfigurationRole, "configuration"},
+    };
+}
+
+bool PresetManager::hasPresets() const
+{
+    return !m_presets.isEmpty();
+}
+
+void PresetManager::savePreset(const QString &name, const QString &description, KScreen::ConfigPtr config)
+{
+    qDebug() << "PresetManager::savePreset called with name:" << name << "description:" << description;
+
+    if (!config) {
+        qDebug() << "Error: Invalid configuration";
+        Q_EMIT errorOccurred(i18n("Invalid configuration"));
+        return;
+    }
+
+    qDebug() << "Config has" << config->outputs().count() << "outputs";
+
+    DisplayPreset preset;
+    preset.id = generatePresetId();
+    preset.name = name.isEmpty() ? i18n("Unnamed Preset") : name;
+    preset.description = description;
+    preset.created = QDateTime::currentDateTime();
+    preset.lastUsed = QDateTime();
+    preset.configuration = configToVariantMap(config);
+
+    for (const auto &output : config->outputs()) {
+        if (output->isEnabled()) {
+            preset.outputIds.append(output->hashMd5());
+        }
+    }
+
+    qDebug() << "Adding preset to model with" << preset.outputIds.count() << "output IDs";
+
+    beginInsertRows(QModelIndex(), m_presets.count(), m_presets.count());
+    m_presets.append(preset);
+    endInsertRows();
+
+    qDebug() << "Saving presets to disk...";
+    savePresetsToDisk();
+
+    qDebug() << "Preset saved successfully with ID:" << preset.id;
+    Q_EMIT presetSaved(preset.id);
+    Q_EMIT countChanged();
+}
+
+void PresetManager::loadPreset(const QString &presetId)
+{
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &preset) {
+        return preset.id == presetId;
+    });
+
+    if (it == m_presets.end()) {
+        Q_EMIT errorOccurred(i18n("Preset not found"));
+        return;
+    }
+
+    it->lastUsed = QDateTime::currentDateTime();
+    savePresetsToDisk();
+
+    KScreen::ConfigPtr config = variantMapToConfig(it->configuration);
+    if (config) {
+        Q_EMIT presetLoaded(config);
+    } else {
+        Q_EMIT errorOccurred(i18n("Failed to load preset configuration"));
+    }
+}
+
+void PresetManager::deletePreset(const QString &presetId)
+{
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &preset) {
+        return preset.id == presetId;
+    });
+
+    if (it == m_presets.end()) {
+        Q_EMIT errorOccurred(i18n("Preset not found"));
+        return;
+    }
+
+    int row = std::distance(m_presets.begin(), it);
+    beginRemoveRows(QModelIndex(), row, row);
+    m_presets.erase(it);
+    endRemoveRows();
+
+    savePresetsToDisk();
+    Q_EMIT presetDeleted(presetId);
+    Q_EMIT countChanged();
+}
+
+void PresetManager::renamePreset(const QString &presetId, const QString &newName)
+{
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &preset) {
+        return preset.id == presetId;
+    });
+
+    if (it == m_presets.end()) {
+        Q_EMIT errorOccurred(i18n("Preset not found"));
+        return;
+    }
+
+    it->name = newName;
+    int row = std::distance(m_presets.begin(), it);
+    Q_EMIT dataChanged(index(row, 0), index(row, 0), {NameRole});
+
+    savePresetsToDisk();
+}
+
+void PresetManager::updatePresetDescription(const QString &presetId, const QString &newDescription)
+{
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &preset) {
+        return preset.id == presetId;
+    });
+
+    if (it == m_presets.end()) {
+        Q_EMIT errorOccurred(i18n("Preset not found"));
+        return;
+    }
+
+    it->description = newDescription;
+    int row = std::distance(m_presets.begin(), it);
+    Q_EMIT dataChanged(index(row, 0), index(row, 0), {DescriptionRole});
+
+    savePresetsToDisk();
+}
+
+DisplayPreset PresetManager::getPreset(const QString &presetId) const
+{
+    auto it = std::find_if(m_presets.begin(), m_presets.end(), [&presetId](const DisplayPreset &preset) {
+        return preset.id == presetId;
+    });
+
+    if (it != m_presets.end()) {
+        return *it;
+    }
+
+    return DisplayPreset();
+}
+
+bool PresetManager::presetExists(const QString &name) const
+{
+    return std::any_of(m_presets.begin(), m_presets.end(), [&name](const DisplayPreset &preset) {
+        return preset.name == name;
+    });
+}
+
+void PresetManager::loadPresetsFromDisk()
+{
+    QFile file(presetsFilePath());
+    if (!file.open(QIODevice::ReadOnly)) {
+        return;
+    }
+
+    QJsonDocument doc = QJsonDocument::fromJson(file.readAll());
+    if (doc.isNull() || !doc.isObject()) {
+        return;
+    }
+
+    QJsonObject root = doc.object();
+    QJsonArray presetsArray = root[QStringLiteral("presets")].toArray();
+
+    m_presets.clear();
+    for (const QJsonValue &value : presetsArray) {
+        QJsonObject obj = value.toObject();
+        DisplayPreset preset;
+        preset.id = obj[QStringLiteral("id")].toString();
+        preset.name = obj[QStringLiteral("name")].toString();
+        preset.description = obj[QStringLiteral("description")].toString();
+        preset.created = QDateTime::fromString(obj[QStringLiteral("created")].toString(), Qt::ISODate);
+        preset.lastUsed = QDateTime::fromString(obj[QStringLiteral("lastUsed")].toString(), Qt::ISODate);
+        preset.configuration = obj[QStringLiteral("configuration")].toObject().toVariantMap();
+
+        QJsonArray outputIdsArray = obj[QStringLiteral("outputIds")].toArray();
+        for (const QJsonValue &outputId : outputIdsArray) {
+            preset.outputIds.append(outputId.toString());
+        }
+
+        m_presets.append(preset);
+    }
+}
+
+void PresetManager::savePresetsToDisk()
+{
+    qDebug() << "PresetManager::savePresetsToDisk() - saving" << m_presets.count() << "presets";
+
+    QJsonArray presetsArray;
+    for (const DisplayPreset &preset : m_presets) {
+        QJsonObject obj;
+        obj[QStringLiteral("id")] = preset.id;
+        obj[QStringLiteral("name")] = preset.name;
+        obj[QStringLiteral("description")] = preset.description;
+        obj[QStringLiteral("created")] = preset.created.toString(Qt::ISODate);
+        obj[QStringLiteral("lastUsed")] = preset.lastUsed.toString(Qt::ISODate);
+        obj[QStringLiteral("configuration")] = QJsonObject::fromVariantMap(preset.configuration);
+
+        QJsonArray outputIdsArray;
+        for (const QString &outputId : preset.outputIds) {
+            outputIdsArray.append(outputId);
+        }
+        obj[QStringLiteral("outputIds")] = outputIdsArray;
+
+        presetsArray.append(obj);
+    }
+
+    QJsonObject root;
+    root[QStringLiteral("presets")] = presetsArray;
+    root[QStringLiteral("version")] = 1;
+
+    QJsonDocument doc(root);
+    QString filePath = presetsFilePath();
+    qDebug() << "Saving presets to file:" << filePath;
+
+    QFile file(filePath);
+    if (!file.open(QIODevice::WriteOnly)) {
+        qDebug() << "Failed to open file for writing:" << file.errorString();
+        Q_EMIT errorOccurred(i18n("Failed to save presets to disk"));
+        return;
+    }
+
+    qint64 bytesWritten = file.write(doc.toJson());
+    qDebug() << "Wrote" << bytesWritten << "bytes to preset file";
+    file.close();
+}
+
+QString PresetManager::generatePresetId() const
+{
+    return QUuid::createUuid().toString(QUuid::WithoutBraces);
+}
+
+QVariantMap PresetManager::configToVariantMap(KScreen::ConfigPtr config) const
+{
+    QVariantMap map;
+    if (!config) {
+        return map;
+    }
+
+    map[QStringLiteral("features")] = static_cast<int>(config->supportedFeatures());
+    map[QStringLiteral("tabletModeEngaged")] = config->tabletModeEngaged();
+
+    QVariantList outputsList;
+    for (const auto &output : config->outputs()) {
+        QVariantMap outputMap;
+        outputMap[QStringLiteral("id")] = output->hashMd5();
+        outputMap[QStringLiteral("name")] = output->name();
+        outputMap[QStringLiteral("enabled")] = output->isEnabled();
+        outputMap[QStringLiteral("primary")] = output->isPrimary();
+        outputMap[QStringLiteral("priority")] = output->priority();
+
+        QVariantMap pos;
+        pos[QStringLiteral("x")] = output->pos().x();
+        pos[QStringLiteral("y")] = output->pos().y();
+        outputMap[QStringLiteral("pos")] = pos;
+
+        outputMap[QStringLiteral("rotation")] = static_cast<int>(output->rotation());
+        outputMap[QStringLiteral("scale")] = output->scale();
+        outputMap[QStringLiteral("explicitLogicalSize")] = output->explicitLogicalSize().isValid();
+
+        if (output->explicitLogicalSize().isValid()) {
+            QVariantMap logicalSize;
+            logicalSize[QStringLiteral("width")] = output->explicitLogicalSize().width();
+            logicalSize[QStringLiteral("height")] = output->explicitLogicalSize().height();
+            outputMap[QStringLiteral("logicalSize")] = logicalSize;
+        }
+
+        if (output->currentMode()) {
+            QVariantMap mode;
+            mode[QStringLiteral("id")] = output->currentMode()->id();
+            mode[QStringLiteral("width")] = output->currentMode()->size().width();
+            mode[QStringLiteral("height")] = output->currentMode()->size().height();
+            mode[QStringLiteral("refreshRate")] = output->currentMode()->refreshRate();
+            outputMap[QStringLiteral("mode")] = mode;
+        }
+
+        outputMap[QStringLiteral("overscan")] = output->overscan();
+        outputMap[QStringLiteral("vrrPolicy")] = static_cast<int>(output->vrrPolicy());
+        outputMap[QStringLiteral("rgbRange")] = static_cast<int>(output->rgbRange());
+        // Optional HDR and color management fields (may not be available in all versions)
+        if (output->metaObject()->indexOfProperty("brightness") != -1) {
+            outputMap[QStringLiteral("brightness")] = output->brightness();
+        }
+        if (output->metaObject()->indexOfProperty("hdrEnabled") != -1) {
+            outputMap[QStringLiteral("hdr")] = output->isHdrEnabled();
+        }
+        if (output->metaObject()->indexOfProperty("sdrBrightness") != -1) {
+            outputMap[QStringLiteral("sdr_brightness")] = output->sdrBrightness();
+        }
+        if (output->metaObject()->indexOfProperty("sdrGamutWideness") != -1) {
+            outputMap[QStringLiteral("sdr_gamut_wideness")] = output->sdrGamutWideness();
+        }
+        if (output->metaObject()->indexOfProperty("wcgEnabled") != -1) {
+            outputMap[QStringLiteral("wide_color_gamut")] = output->isWcgEnabled();
+        }
+        if (output->metaObject()->indexOfProperty("autoRotatePolicy") != -1) {
+            outputMap[QStringLiteral("auto_rotate_policy")] = static_cast<int>(output->autoRotatePolicy());
+        }
+        if (output->metaObject()->indexOfProperty("iccProfilePath") != -1) {
+            outputMap[QStringLiteral("icc_profile_path")] = output->iccProfilePath();
+        }
+
+        outputsList.append(outputMap);
+    }
+
+    map[QStringLiteral("outputs")] = outputsList;
+    return map;
+}
+
+KScreen::ConfigPtr PresetManager::variantMapToConfig(const QVariantMap &map) const
+{
+    KScreen::ConfigPtr config = KScreen::ConfigPtr::create();
+
+    if (map.contains(QStringLiteral("features"))) {
+        config->setSupportedFeatures(static_cast<KScreen::Config::Features>(map[QStringLiteral("features")].toInt()));
+    }
+
+    if (map.contains(QStringLiteral("tabletModeEngaged"))) {
+        config->setTabletModeEngaged(map[QStringLiteral("tabletModeEngaged")].toBool());
+    }
+
+    QVariantList outputsList = map[QStringLiteral("outputs")].toList();
+    for (const QVariant &outputVariant : outputsList) {
+        QVariantMap outputMap = outputVariant.toMap();
+
+        KScreen::OutputPtr output = KScreen::OutputPtr::create();
+
+        output->setName(outputMap[QStringLiteral("name")].toString());
+        output->setEnabled(outputMap[QStringLiteral("enabled")].toBool());
+        output->setPrimary(outputMap[QStringLiteral("primary")].toBool());
+        output->setPriority(outputMap[QStringLiteral("priority")].toInt());
+
+        QVariantMap pos = outputMap[QStringLiteral("pos")].toMap();
+        output->setPos(QPoint(pos[QStringLiteral("x")].toInt(), pos[QStringLiteral("y")].toInt()));
+
+        output->setRotation(static_cast<KScreen::Output::Rotation>(outputMap[QStringLiteral("rotation")].toInt()));
+        output->setScale(outputMap[QStringLiteral("scale")].toDouble());
+
+        if (outputMap[QStringLiteral("explicitLogicalSize")].toBool()) {
+            QVariantMap logicalSize = outputMap[QStringLiteral("logicalSize")].toMap();
+            output->setExplicitLogicalSize(QSizeF(logicalSize[QStringLiteral("width")].toDouble(), logicalSize[QStringLiteral("height")].toDouble()));
+        }
+
+        if (outputMap.contains(QStringLiteral("mode"))) {
+            QVariantMap modeMap = outputMap[QStringLiteral("mode")].toMap();
+            KScreen::ModePtr mode = KScreen::ModePtr::create();
+            mode->setId(modeMap[QStringLiteral("id")].toString());
+            mode->setSize(QSize(modeMap[QStringLiteral("width")].toInt(), modeMap[QStringLiteral("height")].toInt()));
+            mode->setRefreshRate(modeMap[QStringLiteral("refreshRate")].toDouble());
+            output->setCurrentModeId(mode->id());
+
+            KScreen::ModeList modeList;
+            modeList[mode->id()] = mode;
+            output->setModes(modeList);
+        }
+
+        output->setOverscan(outputMap[QStringLiteral("overscan")].toInt());
+        output->setVrrPolicy(static_cast<KScreen::Output::VrrPolicy>(outputMap[QStringLiteral("vrrPolicy")].toInt()));
+        output->setRgbRange(static_cast<KScreen::Output::RgbRange>(outputMap[QStringLiteral("rgbRange")].toInt()));
+
+        // Optional HDR and color management fields (may not be available in all versions)
+        if (outputMap.contains(QStringLiteral("brightness"))) {
+            if (output->metaObject()->indexOfProperty("brightness") != -1) {
+                output->setBrightness(outputMap[QStringLiteral("brightness")].toDouble());
+            }
+        }
+        if (outputMap.contains(QStringLiteral("hdr"))) {
+            if (output->metaObject()->indexOfProperty("hdrEnabled") != -1) {
+                output->setHdrEnabled(outputMap[QStringLiteral("hdr")].toBool());
+            }
+        }
+        if (outputMap.contains(QStringLiteral("sdr_brightness"))) {
+            if (output->metaObject()->indexOfProperty("sdrBrightness") != -1) {
+                output->setSdrBrightness(outputMap[QStringLiteral("sdr_brightness")].toDouble());
+            }
+        }
+        if (outputMap.contains(QStringLiteral("sdr_gamut_wideness"))) {
+            if (output->metaObject()->indexOfProperty("sdrGamutWideness") != -1) {
+                output->setSdrGamutWideness(outputMap[QStringLiteral("sdr_gamut_wideness")].toDouble());
+            }
+        }
+        if (outputMap.contains(QStringLiteral("wide_color_gamut"))) {
+            if (output->metaObject()->indexOfProperty("wcgEnabled") != -1) {
+                output->setWcgEnabled(outputMap[QStringLiteral("wide_color_gamut")].toBool());
+            }
+        }
+        if (outputMap.contains(QStringLiteral("auto_rotate_policy"))) {
+            if (output->metaObject()->indexOfProperty("autoRotatePolicy") != -1) {
+                output->setAutoRotatePolicy(static_cast<KScreen::Output::AutoRotatePolicy>(outputMap[QStringLiteral("auto_rotate_policy")].toInt()));
+            }
+        }
+        if (outputMap.contains(QStringLiteral("icc_profile_path"))) {
+            if (output->metaObject()->indexOfProperty("iccProfilePath") != -1) {
+                output->setIccProfilePath(outputMap[QStringLiteral("icc_profile_path")].toString());
+            }
+        }
+
+        config->addOutput(output);
+    }
+
+    return config;
+}
+
+QString PresetManager::presetsFilePath() const
+{
+    QString dirPath = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + QStringLiteral("/kscreen");
+    QDir dir(dirPath);
+    if (!dir.exists()) {
+        dir.mkpath(dirPath);
+    }
+    return dirPath + QStringLiteral("/display_presets.json");
+}
