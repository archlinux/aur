# Local Linux release settings for apps/desktop (read by loadDesktopPackageEnvironment).
# Copy of apps/desktop/.env.macos.example with the settings Linux actually needs:
# the build is unsigned and publishes no update feed or mandatory-policy origin.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
