 dnl AC_CHECK_HEADERS([drm/drm_fourcc.h libdrm/drm_fourcc.h], have_drm="true")
 
+AM_CONDITIONAL(HAVE_DRM, test x$have_drm = xtrue)
+
 if test "x$have_drm" = "xtrue"; then
