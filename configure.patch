@@ -68,8 +68,8 @@ AC_C_BIGENDIAN(,,AC_MSG_ERROR("Cannot detect endianness"))
 
 LIBGAVL_CFLAGS=""
 case "$host_os" in 
-        darwin*)
-        LIBGAVl_LIBS=""
+        darwin*|mingw*)
+        LIBGAVL_LIBS="-liconv"
         ;;
         *)
         LIBGAVL_LIBS="-lrt"
@@ -142,11 +142,11 @@ AC_CHECK_FUNCS([memalign posix_memalign strdup vasprintf isatty sched_setaffinit
 dnl
 dnl getaddrinfo_a
 dnl
-ANL_LIBS=""
