-LIBS=$OLD_LIBS
+dnl ANL_LIBS=""
+dnl OLD_LIBS=$LIBS
+dnl LIBS="$LIBS -lanl"
+dnl AC_CHECK_FUNC(getaddrinfo_a, LIBGAVL_LIBS="${LIBGAVL_LIBS} -lanl", AC_MSG_ERROR("getaddrinfo_a not found in libanl"))
+dnl LIBS=$OLD_LIBS
 
 
 
@@ -158,10 +158,12 @@ AH_TEMPLATE([HAVE_DRM], [Is libdrm available?])
 
 have_drm="false"
 
-PKG_CHECK_MODULES(DRM, libdrm, have_drm="true")
