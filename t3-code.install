# pacman .install hook for t3-code-docker packages.
#
# post_install / post_upgrade:
#   1. docker load the shipped image.
#   2. For each provider URL configured in /etc/<pkgname>/providers.env,
#      parse the port and add a UFW rule allowing docker0 → that port
#      (if UFW is running and the target host is localhost, 127.0.0.1, or
#      host.docker.internal — i.e., the provider is on this machine).
#   3. Print next-steps instructions.
#
# pre_remove:
#   Stop + remove the docker container.
#   If this is the last t3-code-* package being removed, also prune the
#   shared docker image.
#
# T3_CODE_DOCKER_SKIP_UFW=1 pacman -U <pkg> to suppress firewall touches.

_skip_ufw() {
  [ "${T3_CODE_DOCKER_SKIP_UFW:-0}" = "1" ] && return 0
  command -v ufw >/dev/null 2>&1 || return 0
  ufw status >/dev/null 2>&1 || return 0  # UFW installed but inactive
  return 1
}

_is_local_target() {
  local url="$1"
  case "$url" in
    http://localhost:*|http://127.0.0.1:*|http://host.docker.internal:*)
      return 0 ;;
    *)
      return 1 ;;
  esac
}

_url_to_port() {
  echo "${1}" | sed -E 's|^.*://[^/:]+:([0-9]+)/?.*|\1|'
}

_ensure_ufw_rules() {
  local pkgname="$1"
  local providers_env="/etc/${pkgname}/providers.env"

  _skip_ufw && return

  [ -r "${providers_env}" ] || return

  while IFS='=' read -r key value; do
    [ -n "${key}" ] || continue
    [ -n "${value}" ] || continue

    _is_local_target "${value}" || continue

    local port
    port=$(_url_to_port "${value}")
    [ -n "${port}" ] || continue

    # Idempotent: don't add if rule already exists
    if ufw status 2>/dev/null | grep -qE "^${port}/tcp.*docker0"; then
      continue
    fi

    echo "==> Adding UFW rule: docker0 → :${port}/tcp for ${key}"
    ufw allow in on docker0 to any port "${port}" proto tcp \
      comment "${pkgname} bridge→host" >/dev/null || \
      echo "    (ufw allow failed; add rule manually: ufw allow in on docker0 to any port ${port})"
  done < "${providers_env}"
}

_load_image() {
  local pkgname="$1"
  local tarball="/usr/share/${pkgname}/image.tar.zst"

  if [[ ! -r "${tarball}" ]]; then
    echo "warning: image tarball not found at ${tarball}; skipping docker load"
    return
  fi

  if ! command -v docker >/dev/null 2>&1; then
    echo "warning: docker not on PATH; skipping image load"
    return
  fi

  echo "==> Loading docker image from ${tarball}"
  if zstd -dc "${tarball}" | docker load; then
    echo "    image loaded"
  else
    echo "    docker load failed — is the docker daemon running?"
    echo "    Retry manually: zstd -dc ${tarball} | docker load"
  fi
}

_print_next_steps() {
  local pkgname="$1"
  cat <<EOF

==> ${pkgname} installed.

Next steps (as the user who will run this instance):

    # 1. Ensure your user is in the 'docker' group:
    #      sudo usermod -aG docker \$USER    # then log out / back in

    # 2. Enable + start the service:
    #      systemctl --user daemon-reload
    #      systemctl --user enable --now ${pkgname}.service

    # 3. Get a browser pairing URL:
    #      ${pkgname}-ctl pair

    # 4. Open the Desktop URL in your browser, complete pairing.
    #    Provider serverUrls are already pre-configured.

Docs: /usr/share/${pkgname}/README.md

EOF
}

_detect_pkgname() {
  for candidate in /usr/share/t3-code-*/image.tar.zst; do
    [[ -e "$candidate" ]] || continue
    basename "$(dirname "$candidate")"
  done
}

post_install() {
  local pkgname
  for pkgname in $(_detect_pkgname); do
    _load_image "${pkgname}"
    _ensure_ufw_rules "${pkgname}"
    _print_next_steps "${pkgname}"
  done
}

post_upgrade() {
  post_install
}

pre_remove() {
  # Stop container(s) for the package being removed
  local pkgname
  for pkgname in $(_detect_pkgname); do
    echo "==> Removing ${pkgname} — stopping any running container"
    docker rm -f "${pkgname}" 2>/dev/null || true
  done

  # Only prune the shared t3-code image if no other t3-code-* packages
  # will remain after this removal transaction.
  local remaining
  remaining=$(pacman -Qq 2>/dev/null | grep -c '^t3-code-' || echo 0)
  if [ "${remaining}" -le 1 ]; then
    echo "==> Removing shared docker image (last t3-code-* instance)"
    docker rmi "t3-code:${pkgver}" 2>/dev/null || true
  fi

  cat <<EOF

Note: user data (bearer sessions, projects) stays under \$HOME/.t3/.
      Docker images tagged t3-code:* remain cached until 'docker image prune'.
      UFW rules are NOT auto-removed (operator may have other services using the port).
      Remove manually if desired: sudo ufw delete allow in on docker0 to any port <port> proto tcp

EOF
}
