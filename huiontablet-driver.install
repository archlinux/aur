post_install() {
    echo ":: HuionTablet: Reloading udev rules..."
    udevadm control --reload-rules
    udevadm trigger
    echo ":: HuionTablet: Installation complete."
    echo "Access the software on your application menu, search for HuionTablet. Re-plug your tablet if the application does not detect it."
}
pre_upgrade() {
    echo ":: HuionTablet: Stopping running processes before upgrade..."
    killall huiontablet huionCore 2>/dev/null || true
    echo ":: Done."
}

post_upgrade() {
    echo ":: HuionTablet: Reloading udev rules after upgrade..."
    udevadm control --reload-rules
    udevadm trigger
    echo ":: Done."
}

post_remove() {
    echo ":: HuionTablet: Cleaning up leftover files..."
    rm -f /home/*/.HuionCore.pid /home/*/.DriverUI.pid
    echo ":: Done."
}
