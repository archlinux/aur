# netbird-dashboard configuration, consumed by netbird-dashboard-generate.
# After filling this in, run: netbird-dashboard-generate
# The result appears in OUTPUT_DIR (default /var/lib/netbird-dashboard) —
# point your web server root there. On package upgrades the generation runs
# automatically (alpm hook) as long as this file is filled in.
#
# The values below suit the combined netbird-server with its embedded IdP.
# For an external IdP (Zitadel/Keycloak/Auth0 etc.) see the NetBird docs.

# Required
#NETBIRD_MGMT_API_ENDPOINT=https://netbird.example.com
#AUTH_AUTHORITY=https://netbird.example.com/oauth2
#AUTH_CLIENT_ID=netbird-dashboard

# Recommended (defaults for the embedded IdP)
#AUTH_AUDIENCE=netbird-dashboard
#AUTH_SUPPORTED_SCOPES="openid profile email groups"
#AUTH_REDIRECT_URI=/nb-auth
#AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
#USE_AUTH0=false

# Optional
#NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbird.example.com
#NETBIRD_TOKEN_SOURCE=accessToken
#OUTPUT_DIR=/var/lib/netbird-dashboard
