#!/usr/bin/env bash
#
# /usr/bin/openjiuwen-channel-runner
#
# Wrapper that activates the package venv and runs the channel-adapter host.
# Configuration lives under /etc/openjiuwen-connect/ (see README).

set -euo pipefail

VENV=/usr/lib/openjiuwen-connect/venv
SRC=/usr/share/openjiuwen-connect/src
CONFIG_DIR=${OPENJIUWEN_CONNECT_CONFIG:-/etc/openjiuwen-connect}

if [ ! -d "${VENV}" ]; then
    echo "openjiuwen-connect venv missing at ${VENV} — reinstall the package." >&2
    exit 1
fi

# shellcheck disable=SC1091
source "${VENV}/bin/activate"
export PYTHONPATH="${SRC}:${PYTHONPATH:-}"

cd "${SRC}"
exec python -m connect.adapters.channels.run \
    --config "${CONFIG_DIR}/channels.yaml" \
    "$@"