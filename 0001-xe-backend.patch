+//? Intel GPU support for cards bound to the xe kernel driver
+
+#ifdef GPU_SUPPORT
+
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <linux/perf_event.h>
+#include <drm/xe_drm.h>
+
+#include <fmt/format.h>
+
+#include "../btop_config.hpp"
+#include "../btop_log.hpp"
