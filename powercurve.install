post_install() {
  systemctl daemon-reload

  # Generate a fan config tailored to this machine's hardware, then validate
  # it so any problems surface at install time (matches the .deb postinst).
  local config="/etc/powercurve/fan.toml"
  if [ ! -f "$config" ]; then
    mkdir -p /etc/powercurve
    if powercurve fan-detect --generate > "$config" 2>/dev/null; then
      powercurve config || true
    fi
  fi

  systemctl enable --now com.vintagetechie.PowerCurve.service

  echo ""
  echo "powercurve is running. optional user services:"
  echo ""
  echo "  desktop notifications for thermal events and fan stalls:"
  echo "    systemctl --user enable --now powercurve-monitor.service"
  echo ""
  echo "  auto-switch profiles based on running processes:"
  echo "    systemctl --user enable --now powercurve-watcher.service"
  echo "    (configure at ~/.config/powercurve/watcher.toml)"
  echo ""
}

post_upgrade() {
  systemctl daemon-reload
  systemctl enable com.vintagetechie.PowerCurve.service
  systemctl try-restart com.vintagetechie.PowerCurve.service
}

pre_remove() {
  systemctl stop com.vintagetechie.PowerCurve.service || true
  systemctl disable com.vintagetechie.PowerCurve.service || true
}

post_remove() {
  systemctl daemon-reload
  rm -rf /etc/powercurve
  rm -rf /var/lib/powercurve
}
