post_install() {
    # Reload udev rules to apply permissions immediately
    if type -P udevadm >/dev/null; then
        udevadm control --reload-rules && udevadm trigger
    fi

    # Refresh launcher/app cache so Cosmic Launcher and other launchers pick up the entry
    if type -P update-desktop-database >/dev/null; then
        update-desktop-database -q /usr/share/applications
    fi
    if type -P gtk-update-icon-cache >/dev/null; then
        gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
    fi

    echo "==> NATIVMIX INSTALLATION NOTES:"
    echo " "
    echo "  HARDWARE ACCESS:"
    echo "     Permissions have been configured via udev (uaccess tag)."
    echo "     Your user should have access to the Arduino without manual group changes."
    echo " "
    echo "  GLOBAL HOTKEYS:"
    echo "     To toggle mute via a shortcut (e.g., in KDE Plasma), use:"
    echo "     sh -c '/usr/bin/nativmix --toggle-mute [channel]'"
    echo " "
    echo "     Replace [channel] with the fader number (1-indexed: 1 = first channel, 2 = second...)"
    echo " "
}

post_upgrade() {
    # Remove legacy system-wide XDG autostart entry if present.
    # Autostart is now opt-in via KDE settings or systemd user service.
    rm -f /etc/xdg/autostart/nativmix.desktop

    # Migrate nativmix.service → app-nativmix.service (renamed for KDE System Monitor).
    # Find all users who have the old unit enabled (symlink in their user unit dirs).
    while IFS= read -r -d '' symlink; do
        local username
        username=$(awk -F/ '{print $3}' <<< "$symlink")
        [ -z "$username" ] && continue
        local uid
        uid=$(id -u "$username" 2>/dev/null) || continue

        echo "==> Migrating systemd unit: nativmix.service → app-nativmix.service (user: $username)"
        systemctl --user -M "${username}@.host" disable nativmix.service 2>/dev/null || true
        systemctl --user -M "${username}@.host" daemon-reload 2>/dev/null || true
        systemctl --user -M "${username}@.host" enable app-nativmix.service 2>/dev/null || true

        # Restart if user has an active D-Bus session
        if [ -S "/run/user/$uid/bus" ]; then
            runuser -u "$username" -- \
                env XDG_RUNTIME_DIR="/run/user/$uid" \
                    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
                systemctl --user restart app-nativmix.service 2>/dev/null || true
        fi
    done < <(find /home -maxdepth 6 -path "*/.config/systemd/user/*/nativmix.service" -type l -print0 2>/dev/null)

    post_install
}