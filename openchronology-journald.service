# The journald follower (docs/journald.md) as a systemd service, configured in
# /etc/openchronology/journald.env (Debian and RPM packages).
[Unit]
Description=OpenChronology journald follower
Documentation=file:///usr/share/doc/openchronology-server/README.Debian
After=network.target openchronology.service systemd-journald.service

[Service]
Type=simple
# Its own user (#501): it cannot read the server's configuration or log in to its database.
# Reading the system journal (journalctl) needs the systemd-journal group, which the syslog
# receiver (also openchronology-logs) does not have. As this process's main group, it also
# keeps the receiver from tracing it or reading its memory (that needs the same groups); its
# configuration's group, openchronology-logs, is supplementary.
User=openchronology-logs
Group=systemd-journal
SupplementaryGroups=openchronology-logs
EnvironmentFile=/etc/openchronology/journald.env
Environment=NODE_ENV=production
WorkingDirectory=/usr/lib/openchronology
ExecStart=/usr/lib/openchronology/node/bin/node server/journald-receiver.mjs
# The cursor of the last entry sent (and, over SSH, the hosts seen): kept across restarts.
StateDirectory=openchronology-journald
Restart=on-failure
# Node exits with 128 + SIGTERM when stopped; that is a clean stop, not a failure.
SuccessExitStatus=143
RestartSec=10
# Hardening: no privileges, devices, kernel or clock changes, namespaces or foreign system
# calls, and files it creates private to it. AF_NETLINK is for Node's network interface list.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Other users' processes are hidden from it.
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
