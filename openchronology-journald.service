# The journald follower (docs/journald.md) as a systemd service, configured in
# /etc/openchronology/journald.env (Debian and RPM packages).
[Unit]
Description=OpenChronology journald follower
Documentation=file:///usr/share/doc/openchronology-server/README.Debian
After=network.target openchronology.service systemd-journald.service

[Service]
Type=simple
User=openchronology
Group=openchronology
# Reading the system journal (journalctl) needs this group.
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/openchronology/journald.env
Environment=NODE_ENV=production
WorkingDirectory=/usr/lib/openchronology
ExecStart=/usr/lib/openchronology/node/bin/node server/journald-receiver.mjs
# The cursor of the last entry sent (and, over SSH, the hosts seen): kept across restarts.
StateDirectory=openchronology-journald
Restart=on-failure
# Node exits with 128 + SIGTERM when stopped; that is a clean stop, not a failure.
SuccessExitStatus=143
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
