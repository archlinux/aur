-      rxRows: braille(series(31, 90, 0.45, 0.35, 0.12), 64, 4, 'fill'), txRows: braille(series(37, 90, 0.2, 0.25, 0.2), 64, 3, 'down')
-    };
-  }
-}
-</script>
