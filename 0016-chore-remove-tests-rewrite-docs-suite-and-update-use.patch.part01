-      .map(function (r, i) { r.lab = i === 0 ? '100%' : i === 4 ? ' 50%' : i === 7 ? '  0%' : ''; return r; });
-    return {
-      vars: themeVars(this.props.theme ?? 'tokyo-night'),
-      rows: rows, host: host, cpuRows: cpuRows,
