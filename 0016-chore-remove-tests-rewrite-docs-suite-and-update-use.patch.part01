-    const isos = ir.map(function (x, i) { return { m: x[0], rest: x[1], size: x[2], date: x[3], ns: i === 0 ? 'font-weight: 700' : 'color: var(--fg2)', rowStyle: i === 0 ? 'background: var(--sel); border-radius: 4px' : '' }; });
