-    });
-    const ir = [
-      ['arch', 'linux-2026.10.01-x86_64.iso', '1.2G', '5 days ago'],
-      ['arch', 'linux-2026.09.01-x86_64.iso', '1.2G', '5 weeks ago'],
-      ['Arch', 'craft-Linux-2026.08-desktop.iso', '3.4G', '2 months ago']
