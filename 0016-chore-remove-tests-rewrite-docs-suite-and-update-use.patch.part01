-    const cpuRows = grad(braille(series(5, 120, 0.38, 0.2, 0.08), 92, 6, 'fill'), HOT)
-      .map(function (r, i) { r.lab = i === 0 ? '100%' : i === 3 ? ' 50%' : i === 5 ? '  0%' : ''; return r; });
-    const r = rng(99);
-    const threads = [];
-    for (let i = 0; i < 32; i++) {
-      const v = Math.min(0.98, Math.max(0.03, (i % 4 === 0 ? 0.7 : 0.25) + (r() - 0.5) * 0.6));
-      const rows = sparkRows([v, v], 2, 3);
-      threads.push({ n: String(i).padStart(2), rows: rows.map(function (t, j) { return { t: t, c: ['var(--red)', 'var(--blue)', 'var(--cyan)'][j] }; }) });
-    }
-    const PAL = ['var(--orange)', 'var(--blue)', 'var(--magenta)', 'var(--cyan)', 'var(--green)', 'var(--yellow)', 'var(--teal)', 'var(--red)', 'var(--fg2)'];
-    const mem = [['win11-gaming', 16.4], ['arch-dev', 9.8], ['truenas-scale', 6.1], ['k8s-worker-01', 3.2], ['k8s-cp-01', 2.4], ['haos', 1.1], ['k8s-worker-02', 0.9], ['other (5)', 1.3]];
-    const W = 62;
