-    const domRaw = [
-      ['win11-gaming', 12, 0.87, '16.4G', 0.9, '84.1M', '22.0M', '312M', '18.4M', 3],
-      ['k8s-worker-02', 4, 0.61, '0.9G', 0.3, '41.6M', '12.1M', '22.0M', '4.1M', 7],
-      ['k8s-worker-01', 4, 0.55, '3.2G', 0.8, '6.2M', '9.8M', '18.7M', '6.3M', 11],
-      ['arch-dev', 8, 0.42, '9.8G', 0.78, '12.4M', '3.1M', '6.0M', '0.8M', 13],
-      ['k8s-cp-01', 4, 0.23, '2.4G', 0.64, '1.1M', '4.4M', '9.3M', '9.0M', 17],
-      ['truenas-scale', 4, 0.12, '6.1G', 0.88, '0.4M', '61.2M', '48.0M', '2.2M', 19],
