post_install() {
    echo '  ==> Enable the per-user daemon:'
    echo '      systemctl --user enable --now docker-secrets-engine-shim.service'
    echo ''
    echo '  ==> To resolve se:// inside containers, wire up the dockerd NRI plugin:'
    echo '      sudo install -d /etc/docker/nri/conf.d'
    echo '      echo "uid: $(id -u)" | sudo tee /etc/docker/nri/conf.d/10-secrets-engine.conf'
    echo "      echo '{\"nri-opts\":{\"enable\":true,\"plugin-path\":\"/usr/lib/docker/nri-plugins\"}}' |"
    echo '          sudo tee /etc/docker/daemon.json # merge with any existing file'
    echo '      sudo systemctl restart docker'
}

post_upgrade() {
    echo '  ==> Restart the daemon to pick up the new binary:'
    echo '      systemctl --user restart docker-secrets-engine-shim.service'
}

post_remove() {
    echo '  ==> If you wired up dockerd NRI, undo it and restart docker:'
    echo '      sudo rm /etc/docker/nri/conf.d/10-secrets-engine.conf'
    echo '      remove "nri-opts" from /etc/docker/daemon.json'
    echo '      sudo systemctl restart docker'
}
