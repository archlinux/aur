post_install() {
    local BLUE='\e[1;34m'
    local GREEN='\e[1;32m'
    local YELLOW='\e[1;33m'
    local RESET='\e[0m'

    echo -e "${BLUE}==>${GREEN} MotionPro GUI 已安装完成。${RESET}"
    echo -e "${BLUE}  ->${RESET} 中文输入提示："
    echo -e "${BLUE}  ->${RESET} 如果使用 fcitx5 无法输入中文，添加${YELLOW} QT_IM_MODULE=fcitx ${RESET}参数"
    echo -e ""
}

post_upgrade() {
    post_install "$1"
}