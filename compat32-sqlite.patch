diff --git a/PKGBUILD b/PKGBUILD
index e36001d..8e2b3a9 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -14,7 +14,7 @@ arch=('x86_64')
 license=('LicenseRef-Sqlite')
 url="https://www.sqlite.org/"
 makedepends=('tcl' 'lib32-readline' 'sqlite')
-options=('!emptydirs')
+options=('!emptydirs' staticlibs '!lto')
 source=(https://www.sqlite.org/2026/sqlite-src-${_srcver}.zip
         license.txt)
 # upstream now switched to sha3sums - currently not supported by makepkg
@@ -49,11 +49,14 @@ build() {

   export CC="gcc -m32"
   export CXX="g++ -m32"
+  export CFLAGS+=" -fPIC"
+  export CXXFLAGS+=" -fPIC"
   export PKG_CONFIG="i686-pc-linux-gnu-pkg-config"

   ./configure --prefix=/usr \
 	--libdir=/usr/lib32 \
-	--disable-static \
+	--disable-shared \
+	--disable-readline \
     --enable-session \
     --enable-fts3 \
 	--fts4 \
@@ -75,7 +78,7 @@ package_lib32-sqlite() {
   cd sqlite-src-$_srcver
   make DESTDIR="${pkgdir}" install

-  rm -r "${pkgdir}"/usr/{bin,include,share/man}
+  rm -rf "${pkgdir}"/usr/{bin,share/man}

   # license
   install -D -m644 "${srcdir}"/license.txt "${pkgdir}"/usr/share/licenses/${pkgname}/license.txt
