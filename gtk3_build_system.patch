diff -ru chemtool-1.6.14.orig/configure.ac chemtool-1.6.14/configure.ac
--- chemtool-1.6.14.orig/configure.ac	2026-07-21 23:40:21.794972566 -0400
+++ chemtool-1.6.14/configure.ac	2026-07-21 23:41:40.565310659 -0400
@@ -25,29 +25,22 @@
 
