post_install() {
    echo ""
    echo ">>> Add your user to the input group:"
    echo "      sudo usermod -aG input \$USER"
    echo "    Then log out and back in."
    echo ""
    echo ">>> To start KayZeer as a user service:"
    echo "      systemctl --user enable --now kayzeer.service"
    echo ""
    echo ">>> If you use keyd, start it AFTER KayZeer so it reads"
    echo "    from KayZeer's forwarding keyboard."
    echo ""
}

post_upgrade() {
    post_install
}
