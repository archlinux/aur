post_install() {

cat <<- 'EOF'
#-------------------------------------------------------------------

    USAGE:
        after install, add line:
            source /usr/share/gentoo-color-bash/10-gentoo-color.bash
        to global: /etc/bash.bashrc
        or
        to user's: ~/.bashrc and to system: /etc/skel/.bashrc

#-------------------------------------------------------------------
EOF

}

post_upgrade() {
  post_install ${1}
}
