post_install() {
  echo ":: Nexa has been installed successfully."
  echo ":: To enable the media daemon for your user, run:"
  echo "   systemctl --user enable --now nexad.service"
}

post_upgrade() {
  echo ":: Nexa has been updated. Reloading user units..."
  systemctl --user daemon-reload
  echo ":: If the daemon is already running, you may need to restart it:"
  echo "   systemctl --user restart nexad.service"
}

post_remove() {
  echo ":: Cleaning up Nexa user services..."
  # This doesn't stop the process but cleans up the systemd state
  systemctl --user daemon-reload
}
