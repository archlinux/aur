post_install() {
	cat << 'EOF'

supermemory-server has been installed successfully!

To get started:

1. Set up your API key(s):
   mkdir -p ~/.supermemory
   echo 'OPENAI_API_KEY=sk-...' >> ~/.supermemory/env
   chmod 600 ~/.supermemory/env

   Available providers:
   - OPENAI_API_KEY       (OpenAI)
   - ANTHROPIC_API_KEY    (Anthropic)
   - GEMINI_API_KEY       (Google Gemini)

2. Start the server:
   systemctl --user start supermemory-server

3. Enable on login:
   systemctl --user enable supermemory-server

4. View logs:
   journalctl --user -u supermemory-server -f

5. Visit the web interface:
   http://localhost:3000 (default)

Documentation: https://github.com/supermemoryai/supermemory

EOF
}

post_upgrade() {
	post_install
}

pre_remove() {
	systemctl --user stop supermemory-server 2>/dev/null || true
	systemctl --user disable supermemory-server 2>/dev/null || true
}
