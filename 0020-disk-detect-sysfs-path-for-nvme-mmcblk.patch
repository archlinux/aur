 static const char *fstype_ignore_list[] = { "rootfs", "smbfs", "nfs", "cifs", "fuse.", NULL };
 
 
+//NOTE: cutting the name at the first digit only works for sdX/hdX: nvme0n1p2
+//became prefix "nvme" and mmcblk0p1 became "mmcblk", the sysfs path never
+//opened and those disks were silently skipped. Ask sysfs instead of guessing.
+static gboolean
+disk_sysfs_stat_path (const char *device, char *path, size_t path_size)
+{
+	char parent[20];
+	size_t i;
+
+	//NOTE: loop devices repeat I/O that is already counted on the disk holding
+	//the image file, so they stay out, exactly as they were before
+	if (strncmp(device, "loop", 4) == 0)
+		return FALSE;
+
+	g_snprintf(path, path_size, "/sys/block/%s/stat", device);
+	if (access(path, R_OK) == 0)
+		return TRUE; // whole device: sda, nvme0n1, mmcblk0, md0, dm-0
+
+	g_strlcpy(parent, device, sizeof(parent));
+	for (i=strlen(parent); i>0 && isdigit(parent[i-1]); i--)
+		; // strip the partition number
+	if (i>1 && parent[i-1] == 'p' && isdigit(parent[i-2]))
+		i--; // nvme0n1p2, mmcblk0p1, loop0p1
+
+	parent[i] = '\0';
+	g_snprintf(path, path_size, "/sys/block/%s/%s/stat", parent, device);
+
+	return TRUE;
+}
