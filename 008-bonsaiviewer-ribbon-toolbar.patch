@@ -414,7 +416,21 @@ void MainWindow::setupRibbon() {
     connect(ribbon_tabs_, &components::TabBar::currentChanged,
             ribbon_pages_, &QStackedWidget::setCurrentIndex);
 
-    setMenuWidget(shell);
+    // Host the ribbon in a toolbar rather than in the menu-widget slot.
+    // QMainWindow::menuBar() deletes a custom menu widget when it is called,
+    // and the Breeze style calls it while polishing the window, which removed
+    // the whole ribbon on KDE. Toolbars are not affected by that path.
+    auto* ribbon_bar = new QToolBar(this);
+    ribbon_bar->setObjectName("ribbonBar");
+    ribbon_bar->setMovable(false);
+    ribbon_bar->setFloatable(false);
+    ribbon_bar->setContentsMargins(0, 0, 0, 0);
+    shell->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+    ribbon_bar->addWidget(shell);
+    addToolBar(Qt::TopToolBarArea, ribbon_bar);
+
+    // KDE creates an empty menu bar; keep it from adding a blank strip.
+    menuBar()->hide();
 }
 
