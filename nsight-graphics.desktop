Exec=/opt/nsight-graphics/latest/host/linux-desktop-nomad-x64/ngfx-ui
TryExec=/opt/nsight-graphics/latest/host/linux-desktop-nomad-x64/ngfx-ui

Keywords=3d;debugging;graphics;nvidia;profiling;rendering;
X-AppInstall-Keywords=3d;debugging;graphics;nvidia;profiling;rendering;
X-GNOME-Keywords=3d;debugging;graphics;nvidia;profiling;rendering;

Terminal=false
Categories=Development;Profiling;Graphics

