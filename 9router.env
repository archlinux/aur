# 9Router Configuration Template
# Copy this to ~/.config/9router/.env and customize

PORT=20128
NODE_ENV=production
DATA_DIR=~/.local/share/9router
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Enable free providers (set to y or n)
OPEN_KIRO_AI=y
OPEN_OPECODE_FREE=y

# Add your API keys below:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# DEEPSEEK_API_KEY=...
# COHERE_API_KEY=...
# MISTRAL_API_KEY=...
# PERPLEXITY_API_KEY=...
