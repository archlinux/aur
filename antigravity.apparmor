# AppArmor profile for Antigravity IDE
# This profile provides Mandatory Access Control (MAC) security
# Location: /etc/apparmor.d/antigravity
#
# To enable:
#   sudo cp antigravity.apparmor /etc/apparmor.d/antigravity
#   sudo apparmor_parser -r /etc/apparmor.d/antigravity
#
# To enforce:
#   sudo aa-enforce /etc/apparmor.d/antigravity

#include <tunables/global>

/opt/antigravity/Antigravity {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/fonts>
  #include <abstractions/X>
  #include <abstractions/freedesktop.org>
  #include <abstractions/user-tmp>
  #include <abstractions/audio>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/dbus-accessibility-strict>

  # Antigravity installation directory (read-only)
  /opt/antigravity/** r,
  /opt/antigravity/Antigravity ix,
  /opt/antigravity/antigravity ix,
  /opt/antigravity/chrome-sandbox cx -> chrome_sandbox,

  # User home directory access
  owner @{HOME}/.config/Antigravity/** rwk,
  owner @{HOME}/.cache/Antigravity/** rwk,
  owner @{HOME}/.local/share/Antigravity/** rwk,
  
  # Workspace and project files
  owner @{HOME}/** rw,
  owner @{HOME}/**/.git/** rw,

  # System libraries and resources
  /usr/lib/** rm,
  /usr/share/** r,
  /etc/fonts/** r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,

  # Proc and sys access
  @{PROC}/sys/kernel/random/uuid r,
  @{PROC}/sys/fs/inotify/max_user_watches r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/@{pid}/task/*/stat r,
  /sys/devices/system/cpu/** r,

  # Network access (required for agentic AI features, updates)
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  # IPC and shared memory
  /dev/shm/** rw,
  owner /run/user/*/antigravity-* rw,

  # Terminal and shell access (for integrated terminal)
  /usr/bin/bash ix,
  /usr/bin/zsh ix,
  /usr/bin/fish ix,
  /bin/bash ix,
  /bin/zsh ix,

  # Git and development tools
  /usr/bin/git ix,
  /usr/bin/node ix,
  /usr/bin/python* ix,
  /usr/bin/npm ix,

  # Deny access to sensitive system files
  deny /boot/** rw,
  deny /sys/firmware/** rw,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /root/** rw,

  # Chrome sandbox child profile
  profile chrome_sandbox {
    #include <abstractions/base>
    
    capability sys_admin,
    capability sys_chroot,
    capability setuid,
    capability setgid,
    
    /opt/antigravity/chrome-sandbox mr,
    /opt/antigravity/** r,
    
    # Namespace operations
    @{PROC}/@{pid}/setgroups w,
    @{PROC}/@{pid}/uid_map w,
    @{PROC}/@{pid}/gid_map w,
    
    owner /dev/shm/** rw,
    /dev/null rw,
  }
}
