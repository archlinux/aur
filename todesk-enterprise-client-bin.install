post_install() {
  echo "==> ToDesk 企业版服务默认【不启动、不开机自启】"
  echo "    手动启动: sudo systemctl start todesk_client"
  echo "    手动停止: sudo systemctl stop todesk_client"
  echo "    开机自启(可选): sudo systemctl enable todesk_client"
  echo "    启动后运行 'todesk_client' 打开主控界面"
}

post_upgrade() {
  post_install
}
