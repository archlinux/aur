+QuickSceneAnimationDriver::QuickSceneAnimationDriver()
+    : QAnimationDriver(nullptr), interval(1)
+{
+    connect(this, &QAnimationDriver::started, this, &QuickSceneAnimationDriver::startTimer);
+    connect(this, &QAnimationDriver::stopped, this, &QuickSceneAnimationDriver::stopTimer);
+}
+
+QuickSceneAnimationDriver::~QuickSceneAnimationDriver()
+{
+    disconnect(this, &QAnimationDriver::started, this, &QuickSceneAnimationDriver::startTimer);
+    disconnect(this, &QAnimationDriver::stopped, this, &QuickSceneAnimationDriver::stopTimer);
+}
+
+void QuickSceneAnimationDriver::timerEvent(QTimerEvent *e)
+{
+    Q_ASSERT(e->id() == m_timer.id());
+    Q_UNUSED(e); // if the assertions are disabled
+    advance();
+}
+
+void QuickSceneAnimationDriver::startTimer()
+{
+    // always use a precise timer to drive animations
+    m_timer.start(interval, Qt::PreciseTimer, this);
+}
+
+void QuickSceneAnimationDriver::stopTimer()
+{
+    m_timer.stop();
+}
+
+void QuickSceneAnimationDriver::setInterval(int ms)
+{
+    interval = ms;
+    if (m_timer.isActive())
+    {
+        stopTimer();
+        startTimer();
+    }
+}
+
+int QuickSceneAnimationDriver::getInterval()
+{
+    return interval;
+}
+
+QuickSceneAnimationDriver *QuickSceneAnimationDriver::instance()
+{
+    QuickSceneAnimationDriver *inst;
+    static thread_local std::unique_ptr<QuickSceneAnimationDriver> animationDriver;
+    if (!animationDriver) {
+        inst = new QuickSceneAnimationDriver;
+        animationDriver.reset(inst);
+        animationDriver->install();
+    } else {
+        inst = animationDriver.get();
+    }
+    return inst;
+}
+
