# llama-websearch settings.
# This is a shell file: keep the NAME="value" form, no spaces around '='.
# Your copy lives in ~/.config/llama-websearch/config; edit that one, then restart llama-websearch.

# --- folders ---
MODEL_DIR="$HOME/.cache/llama.cpp"        # downloaded GGUF models (llama.cpp's own default, so models are shared)

# --- model ---
MODEL="unsloth/Qwen3.5-9B-GGUF:Q4_K_M"     # Hugging Face repo:quant, downloaded on first run (~5.3 GB)
MODEL_FILE=""                              # or a local .gguf path; when set, MODEL is ignored
CTX=16384                                  # context length; 32768 fits on 8 GB if the card isn't also driving monitors
GPU_LAYERS=99                              # layers offloaded to the GPU; 99 means all of them
THINKING="yes"                             # "no" skips Qwen's <think> step: faster answers, weaker reasoning
TEMP=0.6
TOP_P=0.95
TOP_K=20
EXTRA_LLAMA_ARGS=""                        # anything else for llama-server, e.g. "--cache-type-k q8_0 --cache-type-v q8_0"

# --- network (everything listens on localhost only) ---
LLAMA_HOST="127.0.0.1"                     # the chat UI has no login; only widen this on a network you trust
LLAMA_PORT=8001
SEARXNG_PORT=8888
MCP_PORT=3000

# --- how much search text reaches the model ---
# Every character here is prompt the GPU has to read before answering; on an RX 590
# that is roughly 200 tokens per second, so smaller numbers mean faster replies.
SEARCH_MAX_RESULTS=5                       # results per search (1-20)
SEARCH_MAX_RESULT_CHARS=500                # snippet length per result
PAGE_READ_MAX_CHARS=4000                   # default cap when the model opens a page
LITE_TOOLS="true"                          # short tool descriptions, which saves context on small models

# --- system prompt ({DATE} becomes today's date at each start) ---
SYSTEM_PROMPT="You are a helpful assistant. Today's date is {DATE}. For anything current, or anything you are not sure of, use the web search tool first, then answer and list the URLs you used."
