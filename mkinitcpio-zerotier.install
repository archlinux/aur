post_install(){
 mkinitcpio -H zerotier
}

post_upgrade(){
 if (( $(vercmp "$2" 1.2) < 0 )); then
  cat <<INFO

mkinitcpio-zerotier now supports systemd-based initramfs, and adds the "tun" module on its own.
Run 'check-initcpio-zerotier' as root to verify your setup, then 'mkinitcpio -P' to rebuild your initramfs.
For the full instructions, run 'mkinitcpio -H zerotier'.

INFO
 fi
}
