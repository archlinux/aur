post_install() {
	echo 'To enable Navita, add this line to your ~/.bashrc or ~/.zshrc:'
	echo '  source /usr/share/navita/navita.sh'
	echo 'By default, it replaces the "cd" command. Configure it using the'
	echo 'NAVITA_* environment variables (see /usr/share/doc/navita/README.md) BEFORE the "source" line.'
}
