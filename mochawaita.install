post_install() {
    echo ":: To enable the theme for your user:  mochawaita apply [accent]"
    echo "   Accents: rosewater flamingo pink mauve red maroon peach yellow"
    echo "            green teal sky sapphire blue lavender"
}

pre_remove() {
    # generated by the hook, not owned by the package
    rm -rf /usr/share/icons/Mochawaita /usr/share/icons/.Mochawaita.tmp
    echo ":: If it was active, each user can go back with gsettings, or by"
    echo "   running 'mochawaita revert' BEFORE removing the package."
}
