post_install() {
  cat << EOF

╔════════════════════════════════════════════════════════════════════════════╗
║              ANTIGRAVITY-BIN-HARDENED SECURITY NOTICE                      ║
╚════════════════════════════════════════════════════════════════════════════╝

🛡️  OPTIONAL SECURITY ENHANCEMENTS (AppArmor):

   This package includes an AppArmor profile for enhanced security.
   It is NOT enabled by default to ensure compatibility.

   To enable AppArmor protection:
   
     1. Install AppArmor:
        sudo pacman -S apparmor

     2. Install the profile:
        sudo cp /usr/share/apparmor/antigravity.apparmor /etc/apparmor.d/antigravity

     3. Load the profile:
        sudo apparmor_parser -r /etc/apparmor.d/antigravity

     4. Enforce the profile:
        sudo aa-enforce /etc/apparmor.d/antigravity

   To disable later:
     sudo aa-disable /etc/apparmor.d/antigravity

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  cat << EOF

🧹 CLEANUP RECOMMENDATIONS:

  If you enabled AppArmor, you may want to remove the profile:
    sudo rm /etc/apparmor.d/antigravity
    sudo systemctl reload apparmor

EOF
}
