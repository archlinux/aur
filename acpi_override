#!/bin/bash

build() {
    # 将 /etc/initcpio/acpi_override/ 下的 dsdt.aml 添加到 initramfs 的 /kernel/firmware/acpi/ 路径下
    # Linux 内核会在启动早期从这个路径加载 ACPI 表覆盖
    if [ -f "/etc/initcpio/acpi_override/dsdt.aml" ]; then
        add_file "/etc/initcpio/acpi_override/dsdt.aml" "/kernel/firmware/acpi/dsdt.aml"
        msg "ACPI Override: Added dsdt.aml to initramfs"
    else
        warning "ACPI Override: /etc/initcpio/acpi_override/dsdt.aml not found!"
    fi
}

help() {
    cat <<HELPEOF
This hook adds a custom DSDT table to the initramfs to override the system firmware.
It looks for files in /etc/initcpio/acpi_override/dsdt.aml.
HELPEOF
}