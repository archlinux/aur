[Desktop Entry]
Version=1.4
Type=Application
Name=FS2 Open
Comment=Open-source engine reviving FreeSpace 2 with modern fixes, higher resolutions, and mod support.
GenericName=FreeSpace 2 engine
Exec=/usr/bin/fs2_open %F
