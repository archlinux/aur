post_install() {
    # 定义颜色变量
    local green='\e[1;32m'
    local yellow='\e[1;33m'
    local cyan='\e[1;36m'
    local reset='\e[0m'

    # 检测语言环境
    if [[ $LANG == zh_CN* ]]; then
        # 中文文本
        local msg_updating="正在更新桌面与 MIME 数据库..."
        local msg_wps_cloud="WPS 云服务后台进程默认已禁用。"
        local msg_wps_enable="如果你需要使用云文档/协作功能，请运行以下命令启用："
        local msg_suggest=" --- 建议始终添加以下内容，而非仅在无法启动时 !!! "
        local msg_fix="如果安装后无法启动，请添加以下内容到"
    else
        # 英文文本 (默认)
        local msg_updating="Updating desktop and MIME database..."
        local msg_wps_cloud="WPS cloud service background process is disabled by default."
        local msg_wps_enable="If you need cloud docs/collaboration, run the following command to enable:"
        local msg_suggest=" --- It is suggested to ALWAYS add the following, not just when it fails to start !!! "
        local msg_fix="If it fails to start after installation, add the following to"
    fi

    # 刷新桌面缓存
    echo -e "${green}>>> --- ${msg_updating} ${reset}"
    update-desktop-database -q
    update-mime-database /usr/share/mime
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor

    # WPS 相关提示
    echo -e "${green}>>> ${msg_wps_cloud}${reset}"
    echo -e "${green}>>> ${msg_wps_enable}${reset}"
    echo -e "    sudo chmod +x /opt/kingsoft/wps-office/office6/wpscloudsvr"

    echo -e "${yellow}>>> --- ${msg_suggest} ~/.config/Kingsoft/Office.conf：${reset}"
    echo -e "${yellow}>>> ${msg_fix} ~/.config/Kingsoft/Office.conf：${reset}"
    echo -e "${cyan}    [6.0]${reset}"
    echo -e "${cyan}    wpsoffice\\Application%20Settings\\AppComponentMode=prome_independ${reset}"
}

post_upgrade() {
    post_install
}
