[Unit]
Description=Update Microsoft Visual Studio Code

[Service]
Type=oneshot
User=vscode-autoupdate
Group=vscode-autoupdate
StateDirectory=visual-studio-code-autoupdate
StateDirectoryMode=0755
UMask=0022
ExecStart=/usr/lib/visual-studio-code-autoupdate/vscode-update
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
