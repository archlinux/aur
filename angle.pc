prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib

Name: angle
Description: A conformant OpenGL ES implementation for Windows, Mac, Linux, iOS and Android.
Version: 7258
Libs: -L${libdir} -lEGL-ANGLE -lEGL_vulkan_secondaries-ANGLE -lGLESv1_CM-ANGLE -lGLESv2-ANGLE -lGLESv2_vulkan_secondaries-ANGLE -lGLESv2_with_capture-ANGLE -lVkICD_mock_icd-ANGLE -lfeature_support-ANGLE
Cflags: -I${includedir}
