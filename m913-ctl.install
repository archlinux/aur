post_install() {
    echo "==> m913-ctl: udev rule installed to /usr/lib/udev/rules.d/."
    echo "==> Replug the mouse receiver, or run:"
    echo "==>   sudo udevadm trigger"
}

post_upgrade() {
    echo "==> m913-ctl: udev rule updated."
    echo "==> Replug the mouse, or run:"
    echo "==>   sudo udevadm trigger"
}