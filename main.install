pre_install() {
	useradd -d /var/opt/inventree/ inventree
	install -o inventree -Dm755 -d /var/opt/inventree/
	install -o inventree -Dm755 -d /var/opt/inventree/config
	# this is written to during `invoke install`. don't ask me, fam
	install -o inventree -Dm644 /dev/null /opt/inventree/src/backend/InvenTree/InvenTree/licenses.txt
}

post_install() {
	echo 'running inventree "installer"…'
	su -Plc 'cd /opt/inventree/ && invoke install --skip-plugins' inventree
	echo 'running frontend build…'
	# ↓ must be run as root because it modifies /opt/inventree
	(
		cd /opt/inventree/ &&
		source /var/opt/inventree/.bashrc &&
		HOME='/var/opt/inventree/' invoke int.frontend-compile
	)
	echo 'generating static files…'
	su -Plc 'cd /opt/inventree/ && invoke static' inventree
	cat <<PENIS
Please follow the instructions on the page linked below to set up your database and such:
	https://docs.inventree.org/en/stable/start/install/#create-database
some notes:
	- 'invoke update' will try to update your read-only files - use 'invoke migrate' instead
	- sqlite3 expects a filename in the database.name field - I recommend putting it in /var/opt/inventree/
PENIS
}

post_remove() {
	rm -dr /opt/inventree
	echo "don't forget to clean up /var/opt/inventree as well as your database(s)"
}

pre_upgrade() {
	: # TODO: check that server isn't running? but how…
}

post_upgrade() {
	# NOTE: can't run migrations on upgrade because that depends on DB setup, which we don't touch.
	echo "don't forget to run migrations if necessary."
}
