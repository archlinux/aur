post_install() {
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
}
