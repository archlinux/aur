post_install() {
  echo ":: SonarQube is installed in /usr/share/webapps/sonarqube"
  echo ":: Configuration: /etc/webapps/sonarqube/sonar.properties"
  echo ""
  echo ":: To start the service:"
  echo "   systemctl start sonarqube"
  echo "   systemctl enable sonarqube"
  echo ""
  echo ":: Access the web interface at http://localhost:9000"
  echo ":: Default credentials: admin / admin"
  echo ""
}

post_upgrade() {
  if systemctl is-active --quiet sonarqube; then
    systemctl restart sonarqube
    echo ":: sonarqube.service restarted"
  fi
  echo ":: After a major version upgrade, navigate to http://localhost:9000/setup to run database migration"
}

pre_remove() {
  if systemctl is-active --quiet sonarqube; then
    systemctl stop sonarqube
  fi
  if systemctl is-enabled --quiet sonarqube; then
    systemctl disable sonarqube
  fi
}
