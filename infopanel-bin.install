_trigger_lcds() {
  [ -S /run/udev/control ] || return 0
  udevadm control --reload-rules || :
  # Apply permissions to already-connected Valkyrie/shared MS9132 LCDs.
  # Reloading rules alone only affects the next plug-in event.
  for device in /sys/bus/usb/devices/*; do
    [ -r "$device/idVendor" ] && [ -r "$device/idProduct" ] || continue
    vendor="$(cat "$device/idVendor")"
    product="$(cat "$device/idProduct")"
    case "$vendor:$product" in
      345f:9132|374a:a021)
        udevadm trigger --action=change "$device" || :
        udevadm trigger --action=change --subsystem-match=hidraw --parent-match="$(readlink -f "$device")" || :
        ;;
    esac
  done
  udevadm settle --timeout=5 || :
}

post_install() {
  _trigger_lcds
  cat <<'EOF'
==> InfoPanel setup:
    USB panels: replug the panel once (or run: udevadm trigger) so the
    installed udev rules apply. No group membership is needed.

    SMART drive health sensors (optional, needs smartmontools):
      systemctl enable --now infopanel-smart.timer

    Intel iGPU engine utilization (optional):
      echo 'kernel.perf_event_paranoid=-1' | sudo tee /etc/sysctl.d/99-infopanel-perf.conf
      sudo sysctl --system
EOF
}

post_upgrade() {
  _trigger_lcds
}
