Icon=io.github.Bitpainter75.FerrumPlay
Exec=ferrumplay %U
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/wav;audio/x-wav;audio/x-wavpack;audio/x-ape;audio/x-ms-wma;audio/x-musepack;audio/aiff;audio/x-aiff;audio/x-dsf;audio/mp2;inode/directory;
