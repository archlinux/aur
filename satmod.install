# shellcheck shell=bash

post_install() {
    printf '%s\n' \
        'Run as your ordinary user (not with sudo) to install or check the MSVC toolchain:' \
        '  satmod setup --json' \
        'This downloads Microsoft MSVC/Windows SDK tools under their license terms:' \
        'https://visualstudio.microsoft.com/license-terms/ and https://developer.microsoft.com/windows/downloads/windows-sdk/' || :
    return 0
}
post_upgrade() {
    post_install
}
