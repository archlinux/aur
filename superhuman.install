# Pacman install hooks for Superhuman Linux
# Icon and desktop database caches are refreshed by the gtk-update-icon-cache
# and update-desktop-database pacman hooks, so they are not handled here.

post_install() {
    cat << 'MSG'

  Superhuman installed.

  To start automatically on login:
    cp /etc/xdg/autostart/superhuman.desktop ~/.config/autostart/
    sed -i 's/Hidden=true/Hidden=false/' ~/.config/autostart/superhuman.desktop

  To make Superhuman your default mail client:
    xdg-mime default superhuman.desktop x-scheme-handler/mailto

MSG
}

post_upgrade() {
    if [ -f /opt/superhuman/VERSION ]; then
        echo "  Superhuman upgraded to $(cat /opt/superhuman/VERSION)"
    fi
}
