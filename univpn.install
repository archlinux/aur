post_upgrade() {
  local old=/usr/local/UniVPN new=/opt/UniVPN dir src
  [[ $(vercmp "$2" '10781.21.0.0831-4') == -1 ]] || return 0
  [[ -d $old && ! -L $old ]] || return 0

  # Only copy from and to directories that ordinary users cannot modify.
  for dir in /usr /usr/local "$old" /opt "$new"; do
    if ! _univpn_trusted_dir "$dir"; then
      printf 'UniVPN: unsafe directory %s; legacy certificates were left in place.\n' "$dir" >&2
      return 0
    fi
  done

  _univpn_copy_cert "$old/certinfo.txt" "$new/certinfo.txt"
  if [[ ! -e $old/certificate && ! -L $old/certificate ]]; then
    return 0
  fi
  if ! _univpn_trusted_dir "$old/certificate" ||
     ! { [[ -e $new/certificate || -L $new/certificate ]] || mkdir -m 0755 -- "$new/certificate"; } ||
     ! _univpn_trusted_dir "$new/certificate"; then
    printf 'UniVPN: unsafe or inaccessible certificate directory; legacy certificates were left in place.\n' >&2
    return 0
  fi
  for src in "$old/certificate/"* "$old/certificate/".[!.]* "$old/certificate/"..?*; do
    _univpn_copy_cert "$src" "$new/certificate/${src##*/}"
  done
}

_univpn_trusted_dir() {
  [[ -d $1 && ! -L $1 ]] && _univpn_trusted_mode "$1"
}

_univpn_trusted_mode() {
  local info owner mode
  info=$(stat -c '%u %a' -- "$1") || return 1
  read -r owner mode <<< "$info"
  [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] && (( (8#$mode & 07022) == 0 ))
}

_univpn_copy_cert() {
  local src=$1 dst=$2
  [[ -e $src || -L $src ]] || return 0
  if [[ -L $src || ! -f $src ]] || ! _univpn_trusted_mode "$src"; then
    printf 'UniVPN: skipped non-regular or untrusted legacy file %s\n' "$src" >&2
  elif [[ -e $dst || -L $dst ]]; then
    printf 'UniVPN: kept existing %s; legacy original remains at %s\n' "$dst" "$src"
  elif ! _univpn_publish_cert "$src" "$dst"; then
    printf 'UniVPN: copy failed for %s; legacy original was not removed.\n' "$src" >&2
  fi
}

_univpn_publish_cert() (
  local src=$1 dst=$2 tmp
  tmp=$(mktemp -- "${dst%/*}/.univpn-migrate.XXXXXXXX") || return 1
  trap 'rm -f -- "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  cp --no-dereference -- "$src" "$tmp" || return 1
  chmod --reference="$src" -- "$tmp" || return 1
  # The target appears only after copying completes; never replace an entry.
  if ! ln -T -- "$tmp" "$dst"; then
    [[ -e $dst || -L $dst ]] || return 1
    printf 'UniVPN: kept existing %s; legacy original remains at %s\n' "$dst" "$src"
  fi
)
