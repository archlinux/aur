post_install() {
    echo "==> Creating greeter user..."
    if ! id greeter &>/dev/null; then
        useradd -M -G video -s /usr/bin/nologin greeter
    fi

    echo "==> Setting permissions..."
    chown -R greeter:greeter /var/cache/sysc-greet
    chown -R greeter:greeter /var/lib/greeter
    chmod 755 /var/lib/greeter

    echo "==> Configuring greetd..."
    if [ ! -f /etc/greetd/config.toml ]; then
        cat > /etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "niri -c /etc/greetd/niri-greeter-config.kdl"
user = "greeter"
EOF
        echo "  Created /etc/greetd/config.toml"
    else
        echo "  /etc/greetd/config.toml already exists (not modified)"
        echo "  You may need to manually update it to use sysc-greet"
    fi

    echo ""
    echo "==> sysc-greet installed successfully!"
    echo ""
    echo "                       ▄▀▀▀▀ █   █ ▄▀▀▀▀ ▄▀▀▀▀    ▄▀    ▄▀"
    echo "                        ▀▀▀▄ ▀▀▀▀█  ▀▀▀▄ █      ▄▀    ▄▀"
    echo "                       ▀▀▀▀  ▀▀▀▀▀ ▀▀▀▀   ▀▀▀▀ ▀     ▀"
    echo "                      //  SEE YOU SPACE COWBOY //"
    echo ""
    echo "To use sysc-greet:"
    echo "  1. Enable greetd service (if not already enabled):"
    echo "     systemctl enable greetd.service"
    echo ""
    echo "  2. Reboot to see sysc-greet"
    echo ""
    echo "If you had a different greeter configured, check /etc/greetd/config.toml"
    echo ""
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "==> Disabling greetd service..."
    systemctl disable greetd.service 2>/dev/null || true
}
