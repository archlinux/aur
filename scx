description="Start scx_scheduler"
supervisor=supervise-daemon
required_files="/etc/conf.d/scx"

command="/usr/bin/scxctl"
command_args="start -s $SCX_SCHEDULER $SCX_FLAGS"
command_user="${SCX_USER:-root}:${SCX_GROUP:-root}"

