post_install() {
    echo ":: To enable the Discord last.fm RPC service for your user, run:"
    echo "   systemctl --user enable --now lastfm-rpc.service"
}

post_upgrade() {
    echo ":: To apply the update, restart the user service:"
    echo "   systemctl --user daemon-reload"
    echo "   systemctl --user restart lastfm-rpc.service"
}
