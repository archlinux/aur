# 由 PKGBUILD 的 install= 引入，pacman 安装/升级后以 root 执行。
# 只应用设备权限；启动用户服务留给当前图形会话用户。

apply_udev_permissions() {
    # 离线安装时没有运行中的 udev；下一次启动按已安装规则自然放权。
    if systemd-detect-virt --chroot --quiet || [ ! -S /run/udev/control ]; then
        echo "==> 当前没有运行中的设备管理器，udev 权限将在系统启动时生效。"
        return 0
    fi

    udevadm control --reload || return 1
    udevadm trigger --action=change --settle --subsystem-match=iio --attr-match=name=prox || return 1

    # 只触发 MZPROC/HOD；按型号识别，集合编号可跨启动漂移。
    local device model
    for device in /sys/bus/platform/devices/HID-SENSOR-2000e1.*; do
        [ -r "$device/feature-8-200306/feature-8-200306-value" ] || continue
        IFS= read -r model < "$device/feature-8-200306/feature-8-200306-value"
        case "$model" in
            '77 90 80 82 79 67 '*|'86 76 53 51 77 90 95 72 79 68 '*)
                udevadm trigger --action=change --settle "$device" || return 1
                ;;
        esac
    done

    # 重放 uaccess，为已登录的活跃图形会话分配 hidraw ACL。
    for device in /sys/bus/hid/devices/001F:8087:0AC2.*/hidraw/hidraw*; do
        [ -e "$device/uevent" ] || continue
        udevadm trigger --action=change --settle "$device" || return 1
    done
    echo "==> presenced 的 udev 规则已重载，现有传感器权限已应用。"
}

post_install() {
    if ! apply_udev_permissions; then
        echo "==> udev 权限初始化失败，请按 /usr/share/doc/presenced/README.md 的权限修复步骤处理。" >&2
        return 1
    fi
    echo "==> 在图形会话中启动：systemctl --user start presenced"
    echo "==> 跟随登录自动启动：systemctl --user enable presenced"
}

post_upgrade() {
    post_install || return 1
    echo "==> 如果旧实例正在运行，执行：systemctl --user restart presenced"
}

pre_remove() {
    echo "==> 卸载前请停止用户服务：systemctl --user disable --now presenced"
}
