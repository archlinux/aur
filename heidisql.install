msg() {
    printf "%b" "\e[1;31m==> WARNING: This package now provides the native Linux version of HeidiSQL. To copy your settings you can use the old version (heidisql-wine on the AUR). Click on File > Export settings (to .txt file) there and then in the new version File > Import settings \n\e[0m"
}

post_upgrade() {
  msg
}
