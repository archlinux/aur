# The engine needs root capabilities and ships its service unit generated by
# `ProxyBridge --print-unit`. The group gates who may drive that root service;
# add users with: sudo usermod -aG proxybridge <user>

post_install() {
  getent group proxybridge >/dev/null || groupadd -r proxybridge 2>/dev/null || true
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    if /usr/bin/ProxyBridge --print-unit /usr/bin/ProxyBridge > /etc/systemd/system/proxybridge.service.new; then
      install -m 0644 /etc/systemd/system/proxybridge.service.new /etc/systemd/system/proxybridge.service
      rm -f /etc/systemd/system/proxybridge.service.new
      systemctl daemon-reload || true
      echo '==> Enable and start the engine with: systemctl enable --now proxybridge.service'
      echo '==> Then add your user to the proxybridge group to use the GUI without root.'
    fi
  fi
  echo '==> Profiles (including proxy passwords) live in /etc/proxybridge, mode 700.'
}

post_upgrade() {
  if [ -f /etc/systemd/system/proxybridge.service ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl try-restart proxybridge.service || true
  fi
}

pre_remove() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now proxybridge.service 2>/dev/null || true
  fi
}

post_remove() {
  rm -f /etc/systemd/system/proxybridge.service
  command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload || true
}
