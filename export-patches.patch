+		QTimer::singleShot(int(kFilePartTimeout), [=] {
+			const auto strong = instance.get();
+			const auto online = strong
+				&& (strong->dcstate() == MTP::ConnectedState);
+			runner([=] {
+				filePartStalled(offset, randomId, requestId, online);
+			});
+		});
+	});
