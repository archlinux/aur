[Unit]
Description=Convenience update service for sabnzbd-podman.service
After=network.target
Before=sabnzbd-podman.service

[Service]
EnvironmentFile=/opt/podman-sabnzbd/default.env
EnvironmentFile=%h/.podman-sabnzbd.env
Environment="PUID=%U"
Environment="PGID=%G"
Type=oneshot
ExecStartPre=/bin/bash /opt/podman-sabnzbd/render-compose.sh %h/.podman-sabnzbd.env /tmp/sabnzbd-podman-update-compose-%U.yaml
ExecStart=podman-compose -f /tmp/sabnzbd-podman-update-compose-%U.yaml pull
