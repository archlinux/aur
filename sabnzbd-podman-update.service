[Unit]
Description=Convenience update service for sabnzbd-podman.service
After=network.target
Before=sabnzbd-podman.service

[Service]
EnvironmentFile=/opt/podman-sabnzbd/default.env
EnvironmentFile=%h/.podman-sabnzbd.env
Environment="PUID=%U"
Environment="PGID=%G"
Type=oneshot
ExecStart=podman-compose -f /tmp/podman-compose-processed.yaml pull
