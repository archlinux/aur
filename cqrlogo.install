#!/bin/sh

post_install() {
  cat <<-EOM
	 > Configuration files for apache and lighttpd have been installed
	 > with this package.
	 > For apache make sure mod_alias and either of mod_fastcgi and
	 > mod_fcgid is loaded.
	 > For lighttpd just include the config file conf.d/cqrlogo.conf
	 > in main configuration.
	EOM
}
