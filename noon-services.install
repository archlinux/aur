post_install() {
    echo "==> Enabling system services..."

    systemctl enable sddm.service
    systemctl enable NetworkManager.service
    systemctl enable bluetooth.service
    systemctl enable ufw.service
    systemctl enable tlp.service
    systemctl enable ananicy-cpp.service
    systemctl enable polkit-kde-agent.service
    systemctl enable upower.service

    echo "==> Services enabled. Reboot to start them."
    echo "==> Run 'noon install' to deploy dotfiles"
}

pre_remove() {
    echo "==> Disabling services..."
    systemctl disable sddm.service
    systemctl disable NetworkManager.service
    systemctl disable bluetooth.service
    systemctl disable ufw.service
    systemctl disable tlp.service
    systemctl disable ananicy-cpp.service
    systemctl disable polkit-kde-agent.service
    systemctl disable upower.service

}
