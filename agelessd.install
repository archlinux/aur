post_install() {
    echo "[agelessd] post_install fired"
    /usr/bin/become-ageless --accept || true
}

post_upgrade() {
    echo "[agelessd] post_upgrade fired"
    /usr/bin/become-ageless --accept || true
}

post_remove() {
    echo "[agelessd] removing ageless modifications..."

    # Restore os-release if backup exists
    if [[ -f /etc/os-release.pre-ageless ]]; then
        cp /etc/os-release.pre-ageless /etc/os-release
        echo "[agelessd] restored /etc/os-release"
    else
        echo "[agelessd] no backup found, skipping os-release restore"
    fi

    # Remove ageless files
    rm -f /etc/ageless/ab1043-compliance.txt
    rm -f /etc/ageless/age-verification-api.sh

    echo "[agelessd] cleanup complete"
}
