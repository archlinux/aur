#!/bin/sh
unset JFXPATH

if [ -e /usr/lib/jvm/java-21-openjfx/lib/javafx.base.jar ]; then
        JFXPATH=/usr/lib/jvm/java-21-openjfx/lib
else
        JFXPATH=/usr/lib/jvm/java-21-openjdk/lib
fi

CP="/opt/bluej-preview/boot.jar"
JAVAFXJARS=`ls -1 $JFXPATH/javafx* | paste -sd ":" -`
CP="$CP:$JAVAFXJARS"

archlinux-java-run -a 21 -b 21 -- \
        -Xmx512M \
	-Duser.home="${HOME}/.bluej-preview" \
        -cp "$CP" bluej.Boot \
        "$@"
