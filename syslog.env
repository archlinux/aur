# OpenChronology syslog receiver: /etc/openchronology/syslog.env
# See /usr/share/doc/openchronology-server/syslog.md. Then:
#   sudo systemctl enable --now openchronology-syslog

# The platform on this machine (its HOST and PORT in openchronology.env).
OCH_API_URL=http://127.0.0.1:5173
# A read/write API key (Account -> API keys) of an account that can write the routed timelines.
OCH_API_KEY=
# Routing rules: which messages go to which timeline.
SYSLOG_ROUTES=/etc/openchronology/syslog-routes.json
# Address and port for both UDP and TCP. Ports below 1024 need extra privileges; relay
# port 514 from rsyslog instead.
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514
# Classic BSD timestamps carry no time zone: read them in this one (UTC, +02:00, Europe/Berlin).
SYSLOG_TIMEZONE=UTC
