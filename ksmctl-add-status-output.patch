diff -U1 cachyos-ksm-settings.orig/ksmctl cachyos-ksm-settings/ksmctl
--- cachyos-ksm-settings.orig/ksmctl	2025-05-03 14:08:02.680058941 +0200
+++ cachyos-ksm-settings/ksmctl	2025-05-03 14:24:42.044893799 +0200
@@ -9,9 +9,10 @@
 conf_path="/etc/tmpfiles.d/ksm.conf"
-save="y"
+save="y" # Actually, any non-empty string will be interpreted as 'true'.
 
 if [ "$#" -eq 0 ]; then
-  echo "Usage: $0 [--unsave|-u] {--enable|-e|--disable|-d}"
+  echo "Usage: $0 [--unsave|-u] {--enable|-e|--disable|-d|--status|-s}"
   echo "  --enable , -e :  Enable KSM"
-  echo "  --disable, -d : Disable KSM"
-  echo "  --unsave, -u : Do not save choice to config files"
+  echo "  --disable, -d :  Disable KSM"
+  echo "  --status , -s :  Display the current status"
+  echo "  --unsave , -u :  Do not save choice to config files"
   exit 1
@@ -29,2 +30,6 @@
         ;;
+      --status | -s)
+        new_state="s"
+        shift
+        ;;
       -u | --unsave)
@@ -34,3 +39,4 @@
       *)
-        echo "Error: Invalid argument. Use --enable, -e, --disable, or -d." >&2
+        echo "Error: Invalid argument. Use --enable / -e, --disable / -d, or --status / -s." >&2
+        echo "Run without arguments for full help text." >&2
         exit 1
@@ -41,3 +47,4 @@
 if [ -z "$new_state" ]; then
-    echo "Error: Missing action. Use --enable, -e, --disable, or -d." >&2
+    echo "Error: Missing action. Use --enable / -e, --disable / -d, or --status / -s." >&2
+    echo "Run without arguments for full help text." >&2
     exit 1
@@ -45,13 +52,44 @@
 
-if [ "$new_state" -gt 0 ]; then
-    echo "Enabling Kernel Samepage Merging..."
-    echo "1" > "$file_path"
+if [ "$new_state" == "s" ]; then
+    kernel_setting="$(cat "$file_path")"
+    config_setting="$(awk '{print $7}' "$conf_path")"
+    case $kernel_setting in
+        '0')
+            kernel_verbose="KSM disabled, already merged tables kept."
+        ;;
+        '1')
+            kernel_verbose="KSM enabled."
+        ;;
+        '2')
+            kernel_verbose="KSM disabled, already merged tables unmerged."
+        ;;
+        *)
+            kernel_verbose="Unknown state '$kernel_setting'."
+        ;;
+    esac
+    case $config_setting in
+        '0')
+            config_verbose="KSM to be disabled."
+        ;;
+        '1')
+            config_verbose="KSM to be enabled."
+        ;;
+        *)
+            config_verbose="Unknown state '$config_setting'."
+        ;;
+    esac
+    echo "Current kernel setting ('$file_path'): ${kernel_verbose}"
+    echo "Current config save ('$conf_path'): ${config_verbose}"
 else
-    echo "Disabling Kernel Samepage Merging..."
-    echo "2" > "$file_path"
-
-fi
-
-if [ -n "$save" ]; then
-    echo "w! /sys/kernel/mm/ksm/run - - - - $new_state" > "$conf_path"
+    if [ "$new_state" -gt 0 ]; then
+        echo "Enabling Kernel Samepage Merging..."
+        echo "1" > "$file_path"
+    else
+        echo "Disabling Kernel Samepage Merging..."
+        echo "2" > "$file_path"
+    fi
+
+    if [ -n "$save" ]; then
+        echo "w! $file_path - - - - $new_state" > "$conf_path"
+    fi
 fi
