[Desktop Entry]
Type=Application
Name=hitokoto
GenericName=Markdown Editor
Comment=A native, single-file hybrid Markdown editor
Exec=hitokoto %f
Icon=hitokoto
Terminal=false
Categories=Office;WordProcessor;
MimeType=text/markdown;text/x-markdown;
StartupNotify=true
StartupWMClass=hitokoto
Keywords=markdown;editor;notes;text;
