post_install() {
    echo "==> Configure:  install -Dm600 /usr/share/doc/ears-stt/env.example ~/.config/ears-stt/env"
    echo "==> Start:      systemctl --user enable --now ears-stt"
    echo "==> GPU: uses Vulkan; needs your card's Vulkan driver (nvidia-utils, vulkan-radeon, vulkan-intel). The first start downloads the model."
}
