--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -185,10 +185,19 @@
 
 # ggml
 
+option(GGML_USE_SYSTEM_BASE "ggml: use system-installed libggml-base instead of building it" OFF)
 if (GGML_BACKEND_DL AND NOT BUILD_SHARED_LIBS)
     message(FATAL_ERROR "GGML_BACKEND_DL requires BUILD_SHARED_LIBS")
 endif()
 
+if (GGML_USE_SYSTEM_BASE)
+    find_library(GGML_SYSTEM_BASE_LIBRARY ggml-base REQUIRED)
+    add_library(ggml::ggml-base UNKNOWN IMPORTED)
+    set_target_properties(ggml::ggml-base PROPERTIES IMPORTED_LOCATION "${GGML_SYSTEM_BASE_LIBRARY}")
+    add_library(ggml-base INTERFACE)
+    target_link_libraries(ggml-base INTERFACE ggml::ggml-base)
+    set(GGML_OPENMP_ENABLED "OFF" CACHE INTERNAL "")
+else()
 add_library(ggml-base
             ../include/ggml.h
             ../include/ggml-alloc.h
@@ -238,6 +247,7 @@
     target_compile_definitions(ggml-base PRIVATE GGML_USE_OPENMP)
     target_link_libraries(ggml-base PRIVATE OpenMP::OpenMP_C OpenMP::OpenMP_CXX)
 endif()
+endif()
 
 add_library(ggml
             ggml-backend-dl.cpp
@@ -488,6 +498,7 @@
 ggml_add_backend(ZenDNN)
 ggml_add_backend(OPENVINO)
 
+if (NOT GGML_USE_SYSTEM_BASE)
 foreach (target ggml-base ggml)
     target_include_directories(${target} PUBLIC    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../include> $<INSTALL_INTERFACE:include>)
     target_compile_features   (${target} PRIVATE c_std_11 cxx_std_17) # don't bump
@@ -516,3 +527,4 @@
         target_compile_definitions(${target} PUBLIC  GGML_SHARED)
     endforeach()
 endif()
+endif()
