[Unit]
Description=MeshBeacon Queue Worker
After=network.target

[Service]
Type=simple
User=meshbeacon
Group=meshbeacon
WorkingDirectory=/usr/share/webapps/meshbeacon
ExecStart=/usr/bin/php artisan queue:work --queue=sync,default --tries=5 --timeout=0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
