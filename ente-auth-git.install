post_install() {
	gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
	ln -s /usr/share/enteauth/enteauth /usr/bin/enteauth
	chmod +x /usr/bin/enteauth
	update-desktop-database -q
}

post_upgrade() {
	post_install
}

post_remove() {
	gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
	rm /usr/bin/enteauth
	update-desktop-database -q
}
