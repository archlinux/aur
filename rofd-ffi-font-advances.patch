+        let matched = text_match(search, 0);
+        assert!((matched.rect_mm.x_mm - (1.0 + 2.432)).abs() < 1e-3);
+        rofd_text_search_free(search);
+        rofd_text_layout_free(layout);
+        rofd_page_free(page);
+    }
