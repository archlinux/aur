[Unit]
Description=MDCz WebUI server (system)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mdcz
WorkingDirectory=/usr/lib/mdcz/server
EnvironmentFile=-/etc/conf.d/mdcz
Environment=MDCZ_HOME=/var/lib/mdcz
Environment=MDCZ_WEB_DIST_DIR=/usr/lib/mdcz/server/web
ExecStart=/usr/bin/node /usr/lib/mdcz/server/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
