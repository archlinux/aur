diff --git a/src/ui/widgets/whichkey.rs b/src/ui/widgets/whichkey.rs
index 4983f8820d3d31cb424431ca0efb13d72d6f62ae..aa5e258d418bd06097866ab4d5ba6dbd40ecf3a7 100644
