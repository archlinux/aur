## owlry .install hook
##
## Keep package hooks informational: pacman runs them as root, so they must
## never inspect or modify user home directories. Migration conflicts are
## handled declaratively by PKGBUILD's replaces/conflicts arrays.

post_upgrade() {
    local old_pkgver="$2"
    case "$old_pkgver" in
        0.*|1.*)
            cat <<'EOF'

  owlry 2.x migration notes:
    - The `owlryd` binary was replaced by `owlry -d`.
    - User units are now `owlry.service` and `owlry.socket`.
    - Remove stale units from ~/.config/systemd/user/ if they override the
      package units in /usr/lib/systemd/user/.
    - Replace remaining `owlryd` references in compositor autostart configs.

  Then reload and start the packaged service as your regular user:
      systemctl --user daemon-reload
      systemctl --user enable --now owlry.service

EOF
            ;;
        *)
            cat <<'EOF'

  Active packaged sockets are migrated automatically when the running daemon
  uses an older executable. Healthy sockets and deliberately inactive units
  are left alone. Check pacman output for migration failures.

  If migration was interrupted, retry as the affected user:
      systemctl --user start owlry-user-migrate.service

  If you use only owlry.service without socket activation, restart it yourself:
      systemctl --user restart owlry.service

  For a manually started daemon, stop the old process and start it again.

EOF
            ;;
    esac
}

post_install() {
    cat <<'EOF'

  owlry installed. Start the daemon with:
      systemctl --user enable --now owlry.service

  Or run ad-hoc:
      owlry -d &
      owlry

  Configuration: ~/.config/owlry/config.toml
  Diagnostics:   owlry doctor

EOF
}

post_remove() {
    echo "  owlry removed. Configuration in ~/.config/owlry remains intact."
}
