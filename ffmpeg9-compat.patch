                 helper->bsf = av_bsf_get_by_name("h264_mp4toannexb");
@@ -1288,12 +1305,13 @@ static int append_extradata_if_new(lwindex_helper_t* helper, AVCodecContext* ctx
     if (current.extradata == ctx->extradata) {
