diff --git a/common/lwlibav_video.c b/common/lwlibav_video.c
index 55fa516..8bb4d88 100644
--- a/common/lwlibav_video.c
+++ b/common/lwlibav_video.c
@@ -1147,10 +1147,21 @@ static uint32_t lwlibav_vfr2cfr(lwlibav_video_decode_handler_t* vdhp, lwlibav_vi
 static void handle_decoder_pix_fmt(AVCodecParameters* codecpar, const AVCodec* codec, enum AVPixelFormat pix_fmt)
 {
     assert(codecpar && codec);
+#if LIBAVCODEC_VERSION_MAJOR >= 62
+    /* AVCodec.pix_fmts was removed in favor of avcodec_get_supported_config(). */
+    const void* supported_pix_fmts = NULL;
+    if (avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_PIX_FORMAT, 0, &supported_pix_fmts, NULL) < 0)
+        supported_pix_fmts = NULL;
+    if (supported_pix_fmts)
+        codecpar->format = (int)avcodec_find_best_pix_fmt_of_list((const enum AVPixelFormat*)supported_pix_fmts, pix_fmt, 1, NULL);
+    else
+        codecpar->format = (int)pix_fmt;
+#else
     if (codec->pix_fmts)
         codecpar->format = (int)avcodec_find_best_pix_fmt_of_list(codec->pix_fmts, pix_fmt, 1, NULL);
     else
         codecpar->format = (int)pix_fmt;
+#endif
 }
 
