+/* AVCodecParser.split was removed from the public API in FFmpeg 9 (libavcodec 63).
+ * Parsers stopped providing it in FFmpeg 5.1, when the functionality moved to the
+ * remove_extradata bitstream filter, so on newer FFmpeg it is simply unavailable. */
+#if LIBAVCODEC_VERSION_MAJOR >= 63
+static int (*lw_parser_get_split(const AVCodecParserContext* parser_ctx))(AVCodecContext*, const uint8_t*, int)
+{
+    (void)parser_ctx;
+    return NULL;
+}
+#else
+static int (*lw_parser_get_split(const AVCodecParserContext* parser_ctx))(AVCodecContext*, const uint8_t*, int)
+{
+    return parser_ctx->parser ? parser_ctx->parser->split : NULL;
+}
+#endif
