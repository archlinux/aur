post_install() {
    echo "------------------------------------------------------"
    echo "Note from Asteria author:"
    echo "Asteria is designed for the light Adwaita theme."
    echo "Users of dark system themes can force light mode with:"
    echo "QT_STYLE_OVERRIDE=adwaita Asteria"
    echo "------------------------------------------------------"
}

post_upgrade() {
    post_install
}
