[Unit]
Description=VMware VMBLOCK FUSE file system
Documentation=https://github.com/vmware/open-vm-tools
ConditionVirtualization=vmware
After=vmtoolsd.service
Requires=vmtoolsd.service
Before=dracut-pre-mount.service

[Service]
Type=forking
ExecStartPre=/usr/bin/mkdir -p /run/vmblock-fuse
ExecStart=/usr/bin/vmware-vmblock-fuse \
    -o subtype=vmware-vmblock \
    -o default_permissions \
    -o allow_other \
    /run/vmblock-fuse
ExecStop=/usr/bin/fusermount3 -uz /run/vmblock-fuse
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
