post_install() {
    echo "==> reth-gnosis installed!"
    echo ""
    echo "  FIRST RUN SETUP:"
    echo ""
    echo "  1. Generate a JWT secret (shared auth between execution + consensus clients):"
    echo "     sudo openssl rand -hex 32 | sudo tee /var/lib/reth-gnosis/jwt.hex > /dev/null"
    echo "     sudo chmod 644 /var/lib/reth-gnosis/jwt.hex"
    echo ""
    echo "  2. Point your consensus client (Lighthouse, Lodestar, Teku, etc.) at the"
    echo "     SAME jwt.hex file. For example with Lighthouse:"
    echo "     lighthouse bn --execution-jwt /var/lib/reth-gnosis/jwt.hex ..."
    echo ""
    echo "  3. Start the service:"
    echo "     sudo systemctl enable --now reth-gnosis"
    echo ""
    echo "  On first start, reth-gnosis downloads and imports the Gnosis post-merge"
    echo "  state (~2GB download). This is a one-time operation and may take several"
    echo "  minutes."
    echo ""
    echo "  4. Check status:"
    echo "     systemctl status reth-gnosis"
    echo "     journalctl -u reth-gnosis -f"
    echo ""
    echo "  Config: /usr/lib/systemd/system/reth-gnosis.service"
    echo "  Data:   /var/lib/reth-gnosis/"
    echo "  Logs:   /var/lib/reth-gnosis/logs/"
    echo "  JWT:    /var/lib/reth-gnosis/jwt.hex"
}

post_upgrade() {
    echo "==> reth-gnosis upgraded!"
    echo "  Restart the service: sudo systemctl restart reth-gnosis"
}
