post_install() {
    echo ""
    echo "ClaraVerse has been successfully installed!"
    echo ""
    echo "You can now launch ClaraVerse from your applications menu"
    echo "or by running 'clara-verse' in your terminal."
    echo ""
    echo "First-time setup:"
    echo "  • ClaraVerse will download necessary AI models on first run"
    echo "  • ComfyUI integration requires Docker to be running"
    echo "  • For local LLM support, install 'ollama' package"
    echo ""
    echo "Learn more: https://github.com/badboysm890/ClaraVerse"
    echo "Join community: https://discord.gg/j633fsrAne"
    echo ""
}

post_upgrade() {
    echo ""
    echo "ClaraVerse has been updated successfully!"
    echo "Please restart the application to use the new version."
    echo ""
}

post_remove() {
    echo ""
    echo "ClaraVerse has been removed."
    echo "Note: Your AI models and configurations may still be in your home directory."
    echo ""
}
