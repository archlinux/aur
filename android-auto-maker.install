post_install() {
  cat <<'EOF'
==> Android Auto Maker installed to /opt/android-auto-maker.
    1. Fetch the SDK build-tools once (zipalign, apksigner, libc++):
         # android-auto-maker-setup
       (needs network; Android SDK license applies to those binaries)
    2. Enable the service:
         systemctl --user enable --now android-auto-maker.service
    3. Open http://127.0.0.1:4173
    Keys are kept in /opt/android-auto-maker/tools/keys - back it up
    to keep update-installs working.
EOF
}

post_upgrade() {
  post_install
}
