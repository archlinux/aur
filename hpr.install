post_install() {
    _hpr_install_config
}

post_upgrade() {
    _hpr_install_config
}

pre_remove() {
    echo ""
    echo "================================================"
    echo "  HPR Removal Notice"
    echo "================================================"
    echo ""
    echo "  Your personal configuration at ~/.config/HPR/"
    echo "  has NOT been removed."
    echo ""
    echo "  To fully clean up, run:"
    echo "    rm -rf ~/.config/HPR"
    echo ""
    echo "================================================"
}

_hpr_install_config() {
    REAL_USER="${SUDO_USER:-$USER}"
    USER_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"

    CONFIG_DIR="$USER_HOME/.config/HPR"
    DATA_DIR="$USER_HOME/.local/share/HPR"
    SCRIPT_DIR="/usr/share/hpr"

    echo ""
    echo "================================================"
    echo "       HPR Configuration Setup"
    echo "================================================"
    echo ""

    echo ">> Creating config directories if they don't exist..."
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$DATA_DIR"
    echo "   Config dir : $CONFIG_DIR"
    echo "   Data dir   : $DATA_DIR"
    echo ""

    # aliases.csv — copy only if missing, never overwrite
    if [[ ! -f "$CONFIG_DIR/aliases.csv" ]]; then
        cp "$SCRIPT_DIR/aliases.csv" "$CONFIG_DIR/aliases.csv"
        echo ">> aliases.csv copied."
    else
        echo "   aliases.csv already exists. Preserving your edits."
    fi

    # tabAliases.csv — copy only if missing, never overwrite
    if [[ ! -f "$CONFIG_DIR/tabAliases.csv" ]]; then
        cp "$SCRIPT_DIR/tabAliases.csv" "$CONFIG_DIR/tabAliases.csv"
        echo ">> tabAliases.csv copied."
    else
        echo "   tabAliases.csv already exists. Preserving your edits."
    fi

    # projectAliases.csv — copy only if missing, never overwrite
    if [[ ! -f "$CONFIG_DIR/projectAliases.csv" ]]; then
        cp "$SCRIPT_DIR/projectAliases.csv" "$CONFIG_DIR/projectAliases.csv"
        echo ">> projectAliases.csv copied."
    else
        echo "   projectAliases.csv already exists. Preserving your edits."
    fi

    # config.csv — copy only if missing, never overwrite
    if [[ ! -f "$CONFIG_DIR/config.csv" ]]; then
        cp "$SCRIPT_DIR/config.csv" "$CONFIG_DIR/config.csv"
        echo ">> config.csv copied."
    else
        echo "   config.csv already exists. Preserving your edits."
    fi

    # ui-REFERENCEONLY — always overwrite silently (this is just a reference, not user-edited)
    rm -rf "$CONFIG_DIR/ui-REFERENCEONLY"
    cp -r "$SCRIPT_DIR/ui" "$CONFIG_DIR/ui-REFERENCEONLY"
    echo ">> ui-REFERENCEONLY/ updated to latest defaults."

    # ui/ — copy only if missing, never overwrite (user may have customized)
    if [[ ! -d "$CONFIG_DIR/ui" ]]; then
        cp -r "$SCRIPT_DIR/ui" "$CONFIG_DIR/ui"
        echo ">> ui/ folder copied."
    else
        echo "   ui/ already exists. Preserving your customizations."
        echo "   Latest default UI is always available at:"
        echo "   $CONFIG_DIR/ui-REFERENCEONLY/"
    fi

    # assets/ — always replace silently (not user-editable)
    rm -rf "$CONFIG_DIR/assets"
    cp -r "$SCRIPT_DIR/assets" "$CONFIG_DIR/"
    echo ">> assets/ updated to latest."

    chown -R "$REAL_USER:$REAL_USER" "$CONFIG_DIR"
    chown -R "$REAL_USER:$REAL_USER" "$DATA_DIR"

    # Refresh desktop integration caches
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor &>/dev/null || true
    update-desktop-database /usr/share/applications &>/dev/null || true

    echo ""
    echo "================================================"
    echo "  HPR setup complete! You can now run: hpr"
    echo ""
    echo "  Your configuration is at:"
    echo "  $CONFIG_DIR"
    echo ""
    echo "  GNOME Wayland users — to enable window tracking,"
    echo "  run: /usr/share/hpr/installWindowCallsExtension.sh"
    echo "================================================"
    echo ""
}
