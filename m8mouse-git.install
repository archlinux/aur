post_install() {
  echo "Reloading udev rules..."
  udevadm control --reload-rules && udevadm trigger
}

post_upgrade() {
  echo "Reloading udev rules..."
  udevadm control --reload-rules && udevadm trigger
}

post_remove() {
  echo "Removing udev rules..."
  udevadm control --reload-rules && udevadm trigger
}
