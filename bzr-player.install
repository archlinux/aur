bold=$'\e[1m'
bold_reset=$'\e[0m'

post_install() {
  echo
  echo "==> In case of issues try to delete the ${bold}~/.bzr-player${bold_reset} folder for triggering it's recreation"
  echo "==> You may want to preserve the ${bold}~/.bzr-player/user${bold_reset} folder since contains the user settings"
  echo
}

post_upgrade() {
  post_install $1
}