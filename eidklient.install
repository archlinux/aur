checkpcscd() {
    if [ "`systemctl is-enabled pcscd.socket`" != "enabled" -a \
         "`systemctl is-enabled pcscd.service`" != "enabled" ] ; then

        cat <<-EOF
		>>> pcscd is required for a proper function of eidklient
		>>> You can enable it by issuing:
		>>>
		>>> sudo systemctl enable --now pcscd.socket
	EOF
    fi
}

pre_install() {
    rm -f /opt/eidklient/lib/patched/*
}

## arg 1:  the new package version
post_install() {
    /opt/eidklient/patch-qt

    checkpcscd
}

pre_remove() {
    rm -f /opt/eidklient/lib/patched/* /usr/lib/eID_klient/libQt6*
}

pre_upgrade() {
    rm -f /opt/eidklient/lib/patched/*
}

## arg 1:  the new package version
## arg 2:  the old package version
post_upgrade() {
    /opt/eidklient/patch-qt

    checkpcscd
}

