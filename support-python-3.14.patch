From 79adf62647f436c8686f8d4fb71972880c4e9469 Mon Sep 17 00:00:00 2001
From: Kwieeciol <64413721+Kwieeciol@users.noreply.github.com>
Date: Tue, 21 Oct 2025 16:40:41 +0200
Subject: [PATCH 1/2] support python 3.14 by using ast.Constant instead of
 ast.Str/ast.Num

---
 setup.py | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/setup.py b/setup.py
index 41cce7d7..9ecefd02 100644
--- a/setup.py
+++ b/setup.py
@@ -17,16 +17,14 @@ def version():
                 name = node.targets[0]
                 if isinstance(name, ast.Name) and name.id in ('__version__', '__version_info__', 'VERSION'):
                     v = node.value
-                    if isinstance(v, ast.Str):
-                        return v.s
+                    if isinstance(v, ast.Constant):
+                        return v.value
 
                     if isinstance(v, ast.Tuple):
                         r = []
                         for e in v.elts:
-                            if isinstance(e, ast.Str):
-                                r.append(e.s)
-                            elif isinstance(e, ast.Num):
-                                r.append(str(e.n))
+                            if isinstance(e, ast.Constant):
+                                r.append(str(e.value))
                         return '.'.join(r)
 
 

From 18d5d5e053e3c7a256218ad34bf81709435bfea3 Mon Sep 17 00:00:00 2001
From: Kwieeciol <64413721+Kwieeciol@users.noreply.github.com>
Date: Tue, 21 Oct 2025 23:00:01 +0200
Subject: [PATCH 2/2] ensure version is returned as string

---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 9ecefd02..636d31f2 100644
--- a/setup.py
+++ b/setup.py
@@ -18,7 +18,7 @@ def version():
                 if isinstance(name, ast.Name) and name.id in ('__version__', '__version_info__', 'VERSION'):
                     v = node.value
                     if isinstance(v, ast.Constant):
-                        return v.value
+                        return str(v.value)
 
                     if isinstance(v, ast.Tuple):
                         r = []
