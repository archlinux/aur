[Unit]
Description=High-performance Telegram MTProto proxy written in Zig
After=network.target network-online.target

[Service]
Type=simple
User=mtproto-proxy
Group=mtproto-proxy
ExecStart=/usr/bin/mtproto-proxy /etc/mtproto-proxy.toml
Restart=always
RestartSec=10
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=131582
TasksMax=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
