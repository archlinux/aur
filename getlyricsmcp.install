post_install() {
    cat <<'EOF'

  ######################################################################
  #                                                                    #
  #  getlyricsmcp installed                                            #
  #                                                                    #
  #  Register the MCP server with Claude Code:                         #
  #      $ claude mcp add getlyricsmcp -- getlyricsmcp                 #
  #      $ claude mcp add -s user getlyricsmcp -- getlyricsmcp         #
  #                                                                    #
  #  Other MCP clients: stdio transport, no arguments, no env.         #
  #                                                                    #
  #  Tools: search_lyrics(artist, title), get_lyrics(id)               #
  #  Docs:  man getlyricsmcp                                           #
  #                                                                    #
  ######################################################################

EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    cat <<'EOF'

  getlyricsmcp removed. MCP client configs that still reference it
  (e.g. ~/.claude.json, or a project .mcp.json) will fail to spawn the
  server until the entries are cleaned up:

      $ claude mcp remove getlyricsmcp

EOF
}
