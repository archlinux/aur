[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = unreal-engine-src-5.8

[Action]
Description = Leaving only one unreal-engine-src-5.8 package in cache to save storage space...
Depends = pacman-contrib
When = PostTransaction
Exec = /bin/sh -c '/usr/bin/paccache -rvk1 unreal-engine-src-5.8'
