post_install() {
    local _pkgname="linuxqq-clipsync-git"
    local _cmdname="${_pkgname%-git}"

    if [[ "${LANG}" == zh_* ]]; then
        echo -e "\n\e[1;33m+----------------------------------------------------------------------+\e[0m"
        echo -e "\e[1;33m| \e[1;32m[ linuxqq-clipsync 安装提示 ]\e[1;33m                                        |\e[0m"
        echo -e "\e[1;33m+----------------------------------------------------------------------+\e[0m"
        echo -e "  启动命令："
        echo -e "    - Systemd 服务:  \e[1;36msystemctl --user start ${_cmdname}\e[0m"
        echo -e "    - 终端直接运行:  \e[1;36m${_cmdname}\e[0m"
        echo -e ""
        echo -e "  设置开机自启："
        echo -e "    \e[1;36msystemctl --user enable ${_cmdname}\e[0m"
        echo -e "\e[1;33m+----------------------------------------------------------------------+\e[0m\n"
    else
        echo -e "\n\e[1;33m+----------------------------------------------------------------------+\e[0m"
        echo -e "\e[1;33m| \e[1;32m[ linuxqq-clipsync Installation Notes ]\e[1;33m                              |\e[0m"
        echo -e "\e[1;33m+----------------------------------------------------------------------+\e[0m"
        echo -e "  Usage:"
        echo -e "    - Systemd service:  \e[1;36msystemctl --user start ${_cmdname}\e[0m"
        echo -e "    - Run manually:     \e[1;36m${_cmdname}\e[0m"
        echo -e ""
        echo -e "  Enable on startup:"
        echo -e "    \e[1;36msystemctl --user enable ${_cmdname}\e[0m"
        echo -e "\e[1;33m+----------------------------------------------------------------------+\e[0m\n"
    fi
}

post_upgrade() {
    post_install
}
