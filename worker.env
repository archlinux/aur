# Sample config, tune it to your needs according to upstream

AUDIOMUSE_ROLE=worker
SERVICE_TYPE=worker

APP_DATA_DIR=/var/lib/audiomuse-ai-worker
TEMP_DIR=/var/tmp/audiomuse-ai-worker
PLUGINS_DIR=/var/lib/audiomuse-ai-worker/plugins

NUMBA_CACHE_DIR=/var/cache/audiomuse-ai-worker/numba

# Optional: point AudioMuse at an existing shared Hugging Face cache.
# HF_HOME=/path/to/huggingface/cache

# Optional: force Hugging Face/Transformers to use cached files only.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

EMBEDDING_MODEL_PATH=/usr/share/audiomuse-ai/worker/musicnn_embedding.onnx
PREDICTION_MODEL_PATH=/usr/share/audiomuse-ai/worker/musicnn_prediction.onnx

CLAP_AUDIO_MODEL_PATH=/usr/share/audiomuse-ai/worker/model_epoch_36.onnx
CLAP_TEXT_MODEL_PATH=/usr/share/audiomuse-ai/clap/clap_text_model.onnx
CLAP_OTHER_FEATURES_CACHE_DIR=/var/cache/audiomuse-ai-worker/clap

LYRICS_MODEL_DIR=/var/lib/audiomuse-ai-worker/models
LYRICS_WHISPER_MODEL_DIR=/var/lib/audiomuse-ai-worker/models/whisper-small-onnx
SILERO_VAD_ONNX_PATH=/usr/share/silero-vad/silero_vad.onnx
LYRICS_GTE_ONNX_PATH=/usr/share/audiomuse-ai/gte/gte-multilingual-base-int8.onnx
LYRICS_GTE_TOKENIZER_DIR=/usr/share/audiomuse-ai/gte/gte-multilingual-base

NEURAL_FINGERPRINT_MODEL_PATH=/usr/share/audiomuse-ai/neural-fingerprint/neural_fingerprint.onnx
NEURAL_FINGERPRINT_CODEBOOK_PATH=/usr/share/audiomuse-ai/neural-fingerprint/neural_fingerprint_pq.npz

SUPERVISORCTL_CMD=/usr/bin/supervisorctl
SUPERVISOR_CONF=/etc/audiomuse-ai/worker-supervisord.conf

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=audiomuse
POSTGRES_PASSWORD=
POSTGRES_DB=audiomusedb
