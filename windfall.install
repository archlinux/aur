post_install() {
  echo "==> Windfall is an app: launch it from your application menu (or run: windfall)."
  echo "    It detects the session at launch: Hyprland gets full window/bar integration; Plasma Wayland and X11 get"
  echo "    transparent screen-edge effects. It starts through XDG autostart; running it again opens the controller."
}

post_upgrade() {
  # Older versions ran Windfall as a systemd user service: remove that for good.
  systemctl --global disable windfalld.service >/dev/null 2>&1 || true
  rm -f /etc/systemd/user/graphical-session.target.wants/windfalld.service
}
