post_install() {
    echo ""
    echo "==> toff installed successfully!"
    echo ""
    echo "==> On systemd (default Arch Linux), no extra configuration is needed."
    echo "    The active console user can poweroff without sudo via logind."
    echo ""
    echo "==> On non-systemd systems (OpenRC, runit, s6, SysV):"
    echo "    To avoid sudo password prompts, add the following via visudo:"
    echo ""
    echo "    %wheel ALL=(ALL) NOPASSWD: /usr/bin/poweroff, /usr/bin/shutdown, /usr/bin/halt"
    echo ""
    echo "==> Quick start:"
    echo "    toff 1.30                          # shutdown in 1h 30m"
    echo "    toff https://youtu.be/VIDEO_ID     # shutdown after video ends"
    echo "    toff --cancel                      # cancel pending shutdown"
    echo ""
}

post_upgrade() {
    post_install
}
