post_install() {
    echo ""
    echo "zerobrew has been installed!"
    echo ""
    echo "To initialize zerobrew, run:"
    echo "    zb init"
    echo ""
    echo "This will set up the zerobrew data directories."
    echo "See 'zb --help' for more information."
    echo ""
}

post_upgrade() {
    post_install
}
