#!/bin/bash

CONFIG_DIR="${HOME}/.config"
ADVANCELY_CONFIG_DIRECTORY="${ADVANCELY_CONFIG_DIRECTORY-${CONFIG_DIR}/advancely}"

if [[ ! -d "${ADVANCELY_CONFIG_DIRECTORY}" ]]; then
  mkdir -p "${ADVANCELY_CONFIG_DIRECTORY}"
fi

cd "${ADVANCELY_CONFIG_DIRECTORY}" || exit 1
/usr/share/advancely/Advancely --disable-updater --settings-file "${ADVANCELY_CONFIG_DIRECTORY}/settings.json"
