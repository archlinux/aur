post_install() {
    cat << "MSG"
:: Moore Threads MTT S30 userland graphics and compute driver installed.
:: 
:: Tips for KDE Plasma 6 (Wayland) & Xwayland:
::  - Desktop hints are placed in /etc/environment.d/10-mtt-s30.conf
::  - Device access rules are placed in /usr/lib/udev/rules.d/70-mtgpu.rules
::  - To verify GPU status and temperature, run:
::      mthreads-gmi
::  - Documentation and issue tracker:
::      https://github.com/cont1nu1ty/mtt-s30-arch
MSG
}

post_upgrade() {
    post_install
}
