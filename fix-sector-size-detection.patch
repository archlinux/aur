--- a/udf_discop.c	2026-05-31 02:33:57.255581207 +0700
+++ udf_discop.c	2026-05-31 02:34:14.012572232 +0700
@@ -365,7 +365,30 @@
 	/* check if its a regular file */
 	fstat(disc->dev->fhandle, &stat);
 	if (S_ISREG(stat.st_mode)) {
+		uint8_t probe[6];
+		uint32_t detected_sector_size = DISC_SECTOR_SIZE;
+
 		UDF_VERBOSE(printf("UDF device %s is a regular file\n", disc->dev->dev_name));
+
+		/* auto-detect sector size by probing for ISO 9660 / UDF signatures.
+		 * ISO 9660 PVD has "CD001" at byte offset 1 within sector 16.
+		 * UDF VRS has "BEA01" at byte offset 1 within sector 16.
+		 * Sector 16 at 2048 bytes = file offset 32769..32773.
+		 * Try 2048 first since virtually all disc images use that sector size.
+		 */
+		if (pread(disc->dev->fhandle, probe, 5, 16 * 2048 + 1) == 5) {
+			if (memcmp(probe, "CD001", 5) == 0 || memcmp(probe, "BEA01", 5) == 0)
+				detected_sector_size = 2048;
+		}
+		if (detected_sector_size == DISC_SECTOR_SIZE) {
+			if (pread(disc->dev->fhandle, probe, 5, 16 * 512 + 1) == 5) {
+				if (memcmp(probe, "CD001", 5) == 0 || memcmp(probe, "BEA01", 5) == 0)
+					detected_sector_size = 512;
+			}
+		}
+		if (detected_sector_size != DISC_SECTOR_SIZE)
+			UDF_VERBOSE(printf("UDF device %s auto-detected sector size %d\n", disc->dev->dev_name, detected_sector_size));
+
 		disc->devdrv_class     = UDF_DEVDRV_CLASS_FILE;
 		disc->sequential       = 0;	/* full r/w		*/
 		disc->recordable       = 1;	/* assuming rw access	*/
@@ -374,7 +397,7 @@
 		disc->packet           = 0;
 		disc->blockingnr       = 1;
 		disc->strict_overwrite = 0;
-		disc->sector_size      = DISC_SECTOR_SIZE;
+		disc->sector_size      = detected_sector_size;
 		return 0;
 	}
 
