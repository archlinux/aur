_patch_zcode_responses_annotations() {
  local bundle='/opt/ZCode/resources/glm/zcode.cjs'

  [[ -f "${bundle}" ]] || return 0

  perl -0pi -e 's/let n=await t\.text\(\),i=await Zu\(\{text:n,schema:e\}\),a=aT\(t\);/let n=await t.text(),i=await Zu({text:(()=>{try{let o=JSON.parse(n);if(Array.isArray(o?.output)){let changed=!1;for(let item of o.output){let content=item?.content;if(!Array.isArray(content))continue;for(let part of content){if(part&&part.type==="output_text"&&!Array.isArray(part.annotations)){part.annotations=[];changed=!0}}}if(changed)return JSON.stringify(o)}}catch{}return n})(),schema:e}),a=aT(t);/' "${bundle}" || true

  if ! grep -Fq 'part.type==="output_text"&&!Array.isArray(part.annotations)' "${bundle}"; then
    echo "zcode-desktop-bin: failed patch Responses annotations compatibility" >&2
    return 1
  fi
}

post_install() {
  _patch_zcode_responses_annotations
}

post_upgrade() {
  _patch_zcode_responses_annotations
}
