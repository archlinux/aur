+//NOTE: one-shot options must not survive a restart: -p would reopen the
+//dialog every time and -r would wipe the settings on every restart
+static const char *one_shot[] = {
+	"-a", "--about", "-p", "--preferences", "-r", "--reset", NULL
+};
+
+static void
+indicator_restart(void)
+{
+	GPtrArray *args = g_ptr_array_new();
+	gchar *exe;
+	guint i, j;
+
+	for (i=0; saved_argv[i] != NULL; i++) {
+		gboolean skip = FALSE;
+
+		for (j=0; i > 0 && one_shot[j] != NULL; j++) {
+			if (strcmp(saved_argv[i], one_shot[j]) == 0) {
+				skip = TRUE;
+				break;
+			}
+		}
+
+		if (!skip)
+			g_ptr_array_add(args, saved_argv[i]);
+	}
+	g_ptr_array_add(args, NULL);
+
+	//NOTE: exec the resolved path, not /proc/self/exe, otherwise the kernel
+	//sets the process name to "exe" and pgrep/pkill stop finding it
+	exe = g_file_read_link("/proc/self/exe", NULL);
+	execv(exe ? exe : "/proc/self/exe", (char **)args->pdata);
+
+	g_warning("Cannot restart: %s", g_strerror(errno));
+	g_free(exe);
+	g_ptr_array_free(args, TRUE);
+}
+
+//NOTE: a hidden graph leaves its tray item registered as Passive, and panels
+//may keep an empty slot for it. Enabling works live, so restart only when the
+//set of graphs shrinks. Runs on dialog destroy, after multiload_ui_save().
+static void
+indicator_prefs_destroy_cb(GtkWidget *dialog, MultiloadPlugin *ma)
+{
+	guint i;
+
+	//NOTE: compare against live indicators, not against the set seen when the
+	//dialog opened: a graph enabled and disabled within one session also leaves
+	//a Passive item behind, and panels may keep an empty slot for it
+	for (i=0; i<GRAPH_MAX; i++) {
+		if (split_ind[i] != NULL && !ma->graph_config[i].visible) {
+			g_message("Graph removed, restarting to drop its tray icon");
+			indicator_restart();
+			return;
+		}
+	}
+}
