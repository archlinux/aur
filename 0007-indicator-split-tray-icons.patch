+static void build_menu_for(MultiloadPlugin *ma, AppIndicator *target, gint only_id, gboolean full);
+static void indicator_connection_changed_cb (AppIndicator *indicator, gboolean connected, MultiloadPlugin *ma);
+
+static void
+indicator_create_split(MultiloadPlugin *ma, guint i)
+{
+	gchar *id = g_strdup_printf("indicator-multiload-ng-%s", graph_types[i].name);
+	split_ind[i] = app_indicator_new (id, about_data_icon, APP_INDICATOR_CATEGORY_HARDWARE);
+	g_free(id);
+
+	app_indicator_set_status (split_ind[i], APP_INDICATOR_STATUS_ACTIVE);
+	g_signal_connect (G_OBJECT(split_ind[i]), "connection-changed", G_CALLBACK(indicator_connection_changed_cb), ma);
+	g_object_get(G_OBJECT(split_ind[i]), "connected", &indicator_connected, NULL);
+
+	// полное меню (с Quit) держит ровно один значок
+	gboolean full = (split_full_menu_owner < 0);
+	build_menu_for (ma, split_ind[i], (gint)i, full);
+	if (full)
+		split_full_menu_owner = (gint)i;
+}
+
+//NOTE: visibility can change at runtime through Preferences, which only starts
+//or stops the graph timer. At least one graph is always visible, so this sweep
+//always has a live timer to run on.
+static void
+indicator_sync_split(MultiloadPlugin *ma)
+{
+	guint i;
+
+	for (i=0; i<GRAPH_MAX; i++) {
+		gboolean vis = ma->graph_config[i].visible;
+
+		if (vis && split_ind[i] == NULL)
+			indicator_create_split (ma, i);
+
+		if (split_ind[i] != NULL)
+			app_indicator_set_status (split_ind[i],
+					vis ? APP_INDICATOR_STATUS_ACTIVE : APP_INDICATOR_STATUS_PASSIVE);
+	}
+
+	// владелец полного меню скрыт - передать Quit другому видимому значку
+	if (split_full_menu_owner >= 0 && !ma->graph_config[split_full_menu_owner].visible) {
+		gint prev = split_full_menu_owner;
+		split_full_menu_owner = -1;
+
+		for (i=0; i<GRAPH_MAX; i++) {
+			if (split_ind[i] != NULL && ma->graph_config[i].visible) {
+				build_menu_for (ma, split_ind[i], (gint)i, TRUE);
+				split_full_menu_owner = (gint)i;
+				break;
+			}
+		}
+
+		// снять Quit с прежнего владельца, иначе после его повторного
+		// показа пунктов Quit стало бы два
+		if (split_full_menu_owner != prev && split_ind[prev] != NULL)
+			build_menu_for (ma, split_ind[prev], prev, FALSE);
+	}
+}
+
+static void
+indicator_update_pixbuf_single(LoadGraph *g)
+{
+	MultiloadPlugin *ma = g->multiload;
+	guint id = g->id;
+	cairo_surface_t *surface;
+	cairo_t *cr;
+
+	if (split_ind[id] == NULL)
+		return;
+
+	surface = cairo_image_surface_create (CAIRO_FORMAT_ARGB32,
+			g->draw_width + 2*ma->padding, g->draw_height + 2*ma->padding);
+	g_assert (surface != NULL);
+	cr = cairo_create (surface);
+	cairo_set_antialias (cr, CAIRO_ANTIALIAS_NONE);
+
+	cairo_set_source_surface (cr, g->surface, ma->padding, ma->padding);
+	cairo_paint (cr);
+
+	if (cairo_surface_write_to_png (surface, split_filename[id][split_current_index[id]]) == CAIRO_STATUS_SUCCESS)
+		app_indicator_set_icon (split_ind[id], split_filename[id][split_current_index[id]]);
+
+	split_current_index[id] = 1 - split_current_index[id];
+	cairo_surface_destroy (surface);
+	cairo_destroy (cr);
+}
