#!/bin/sh
# Independent X11 session via TigerVNC's foreground vncsession.
set -eu
exec 2>&1

config=/etc/conf.d/tigervnc-runit
if [ ! -r "$config" ]; then
    echo "tigervnc: missing $config" >&2
    exit 1
fi
# The config file is a root-controlled POSIX shell fragment.
. "$config"

if [ "$(id -u)" -ne 0 ]; then
    echo 'tigervnc: vncsession must be started as root' >&2
    exit 1
fi

if [ -z "${VNC_USER:-}" ] || ! id "$VNC_USER" >/dev/null 2>&1; then
    echo 'tigervnc: set VNC_USER to an existing Linux account' >&2
    exit 1
fi
if [ "$(id -u "$VNC_USER")" -eq 0 ]; then
    echo 'tigervnc: VNC_USER must not be root' >&2
    exit 1
fi

# A dedicated virtual display (:1, :2, ...); :0 is deliberately rejected.
case "${VNC_DISPLAY:-}" in
    :[1-9]*)
        case "${VNC_DISPLAY#:}" in
            *[!0-9]*)
                echo 'tigervnc: VNC_DISPLAY must be :1, :2, ...' >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo 'tigervnc: VNC_DISPLAY must be :1, :2, ...' >&2
        exit 1
        ;;
esac

# vncsession has no Xvnc argument passthrough. Check its configuration in
# upstream precedence order, and fail closed rather than auto-opening the GPU.
# Match vncsession's normal HOME-based config lookup, including legacy ~/.vnc.
unset XDG_CONFIG_HOME
home=$(getent passwd "$VNC_USER" | cut -d: -f6)
case "$home" in
    /*) ;;
    *) echo 'tigervnc: cannot determine VNC_USER home directory' >&2; exit 1 ;;
esac
userdir="$home/.config/tigervnc"
if [ ! -e "$userdir" ] && [ -e "$home/.vnc" ]; then
    userdir="$home/.vnc"
fi
set --
for file in /etc/tigervnc/vncserver-config-defaults \
    "$userdir/config" /etc/tigervnc/vncserver-config-mandatory; do
    if [ -e "$file" ]; then
        if [ ! -r "$file" ]; then
            echo "tigervnc: cannot read $file" >&2
            exit 1
        fi
        set -- "$@" "$file"
    fi
done
# No input files must not make awk wait on the service's stdin.
if ! awk '
    /^[[:space:]]*#/ { next }
    {
        line = $0
        sub(/^[[:space:]]*/, "", line)
        if (tolower(line) ~ /^rendernode[[:space:]]*=/) {
            sub(/^[^=]*=[[:space:]]*/, "", line)
            seen = 1
            safe = (line == "")
        } else if (tolower(line) ~ /^rendernode([[:space:]]|$)/) {
            seen = 1
            safe = 0
        }
    }
    END { exit !(seen && safe) }
' /dev/null "$@"; then
    echo "tigervnc: refusing GPU auto-selection; set rendernode= (empty, no quotes) in $userdir/config" >&2
    echo 'tigervnc: check system overrides too; use tigervnc-share for the local desktop' >&2
    sleep 10
    exit 1
fi

exec /usr/bin/vncsession -D "$VNC_USER" "$VNC_DISPLAY"
