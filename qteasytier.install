# AUR 安装钩子：与 deb 包的 postinst/prerm 行为保持一致。

post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable qtet-daemon.service >/dev/null 2>&1 || true
  systemctl start qtet-daemon.service >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl stop qtet-daemon.service >/dev/null 2>&1 || true
  systemctl disable qtet-daemon.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
