# post_install: Executado após a instalação do pacote.
post_install() {
  # Redireciona toda a saída (stdout e stderr) para um arquivo de log
  exec 1>/tmp/navegadorpytech_postinstall.log 2>&1
  set -ex # Ativa o rastreamento de comandos e saída em caso de erro

  echo "--- INICIANDO post_install para $pkgname ---"

  echo "Verificando se /usr/bin/python3 existe..."
  if [ ! -x "/usr/bin/python3" ]; then
    echo "Erro: /usr/bin/python3 não encontrado ou não é executável. Instale python ou python3."
    exit 1
  fi
  echo "/usr/bin/python3 encontrado."

  # Padroniza para /opt/navegadorpytech/ (usando $pkgname)
  echo "Verificando se /opt/$pkgname existe..."
  mkdir -p "/opt/$pkgname" || { echo "Erro: Não foi possível criar /opt/$pkgname. Verifique permissões."; exit 1; }
  echo "/opt/$pkgname criado/verificado."

  echo "Criando ambiente virtual Python em /opt/$pkgname/venv..."
  /usr/bin/python3 -m venv "/opt/$pkgname/venv" || { echo "Erro: Falha ao criar venv. Verifique se python3 e python3-venv estão instalados e acessíveis."; exit 1; }
  echo "Venv criado em /opt/$pkgname/venv."

  echo "Verificando o executável python no venv..."
  if [ ! -f "/opt/$pkgname/venv/bin/python" ]; then
    echo "Erro: O executável python não foi encontrado em /opt/$pkgname/venv/bin/python após a criação do venv."
    exit 1
  fi
  echo "Executável python no venv encontrado."

  echo "Atualizando pip, setuptools e wheel no venv..."
  "/opt/$pkgname/venv/bin/pip" install --upgrade pip setuptools wheel || { echo "Erro: Falha ao atualizar pip/setuptools/wheel no venv."; exit 1; }
  echo "pip e ferramentas básicas atualizadas."

  echo "Instalando dependências (PyQt6, PyQt6-WebEngine) no venv..."
  # Instala as dependências PyQt6
  "/opt/$pkgname/venv/bin/pip" install PyQt6 PyQt6-WebEngine || { echo "Erro: Falha ao instalar dependências PyQt6 no venv. Pode não haver versões compatíveis com o Python do seu sistema."; exit 1; }
  echo "Dependências PyQt6 instaladas."

  echo "Ambiente virtual e dependências instaladas com sucesso."
  /usr/bin/update-desktop-database -q || true # O || true é para garantir que o script não falhe se o comando falhar
  echo "--- FIM post_install ---"
}

# post_upgrade: Executado após a atualização do pacote.
post_upgrade() {
  post_install "$1"
}

# pre_remove: Executado antes da remoção do pacote.
pre_remove() {
  exec 1>/tmp/${pkgname}_preremove.log 2>&1
  echo "--- INICIANDO pre_remove para $pkgname ---"
  set -ex
  echo "Removendo ambiente virtual Python em /opt/$pkgname/venv..."
  # O '|| true' impede que o script falhe se o venv já não existir (o que aconteceria se a criação falhou antes)
  rm -rf "/opt/$pkgname/venv" || true
  echo "Ambiente virtual removido (ou não existia)."
  /usr/bin/update-desktop-database -q || true
  echo "--- FIM pre_remove ---"
}

# post_remove: Executado após a remoção do pacote.
post_remove() {
  /usr/bin/update-desktop-database -q || true
}
