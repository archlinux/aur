diff --git a/src/platform/xdg_paths.h b/src/platform/xdg_paths.h
new file mode 100644
index 000000000..66b9c5488
--- /dev/null
+++ b/src/platform/xdg_paths.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// User-owned paths for the Linux system package. Pharaoh's installation is
+// read-only input; Akhenaten's own saves and settings live outside it.
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+
+#include <pwd.h>
+#include <unistd.h>
+
+namespace akhenaten_xdg {
+
+inline bool game_data_path(const char* path) {
+    if (!path) return false;
+    auto matches = [path](const char* folder, size_t length) {
+        return std::strncmp(path, folder, length) == 0 &&
+            (path[length] == '\0' || path[length] == '/' || path[length] == '\\');
+    };
+    return matches("Save", 4) || matches("Maps", 4);
+}
+
+inline std::filesystem::path user_home() {
+    if (const char* home = std::getenv("HOME")) {
+        if (std::filesystem::path(home).is_absolute()) return home;
+    }
+    if (const passwd* pw = getpwuid(getuid())) {
+        if (pw->pw_dir && std::filesystem::path(pw->pw_dir).is_absolute()) return pw->pw_dir;
+    }
+    return {};
+}
+
+inline std::filesystem::path directory(const char* variable, const char* fallback) {
+    if (const char* value = std::getenv(variable)) {
+        if (std::filesystem::path(value).is_absolute()) return std::filesystem::path(value) / "akhenaten";
+    }
+    const auto home = user_home();
+    return home.empty() ? home : home / fallback / "akhenaten";
+}
+
+inline std::filesystem::path data_directory() {
+    return directory("XDG_DATA_HOME", ".local/share");
+}
+
+inline std::filesystem::path config_directory() {
+    return directory("XDG_CONFIG_HOME", ".config");
+}
+
+inline std::filesystem::path state_directory() {
+    return directory("XDG_STATE_HOME", ".local/state");
+}
+
+inline const std::string& imgui_ini_path() {
+    static const std::string path = [] {
+        const auto dir = config_directory();
+        if (dir.empty()) return std::string{};
+        std::error_code ec;
+        std::filesystem::create_directories(dir, ec);
+        return (dir / "imgui.ini").string();
+    }();
+    return path;
+}
+
+} // namespace akhenaten_xdg
