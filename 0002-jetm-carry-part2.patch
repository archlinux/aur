From 57ca4823938e5602aea91b9d72069d30572cf697 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 13:51:33 -0600
Subject: [PATCH 06/35] chore: fix clippy lints flagged by a newer toolchain

Clippy 1.99 rejects the tree under `-D warnings` at more sites than
the dist-specific commit covers: collapsible_if in
src/bin/sccache-dist/token_check.rs, and irregular_braces on the
`vec!(...)` calls inside the stringvec!, ovec! and pathvec! macros of
src/test/utils.rs and the vec_from! macro of tests/system.rs.

I collapsed the nested if into a let-chain and wrote the macro bodies as
`vec![...]`. Behaviour is unchanged.

The pre-commit rust-clippy hook now also allows
clippy::double_must_use. It fires on async_trait's macro expansion in
clippy 1.99 at every async trait in the crate, and there is no source
line to fix; the flag sits on the command line, next to the other -A
flags, so no allow attribute is added to the code.

Signed-off-by: Javier Tia <floss@jetm.me>
Signed-off-by: Javier Tia <javier@peridio.com>
---
 .pre-commit-config.yaml             | 2 +-
 src/bin/sccache-dist/token_check.rs | 8 ++++----
 src/test/utils.rs                   | 6 +++---
 tests/system.rs                     | 2 +-
 4 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
index 5347052c..f7986a43 100644
--- a/.pre-commit-config.yaml
+++ b/.pre-commit-config.yaml
@@ -18,7 +18,7 @@ repos:
       - id: rust-clippy
         name: cargo clippy
         description: Lint all targets with warnings denied.
-        entry: cargo clippy --locked --all-targets --features all,dist-server -- -D warnings -A unknown-lints -A clippy::type_complexity -A clippy::new-without-default
+        entry: cargo clippy --locked --all-targets --features all,dist-server -- -D warnings -A unknown-lints -A clippy::type_complexity -A clippy::new-without-default -A clippy::double_must_use
         pass_filenames: false
         types: [file, rust]
         language: system
diff --git a/src/bin/sccache-dist/token_check.rs b/src/bin/sccache-dist/token_check.rs
index 93fabf02..2591076c 100644
--- a/src/bin/sccache-dist/token_check.rs
+++ b/src/bin/sccache-dist/token_check.rs
@@ -113,10 +113,10 @@ impl ProxyTokenCheck {
         if let Some(ref auth_cache) = self.maybe_auth_cache {
             let mut auth_cache = auth_cache.lock().unwrap();
             let (ref mut auth_cache, cache_duration) = *auth_cache;
-            if let Some(cached_at) = auth_cache.get(token) {
-                if cached_at.elapsed() < cache_duration {
-                    return Ok(());
-                }
+            if let Some(cached_at) = auth_cache.get(token)
+                && cached_at.elapsed() < cache_duration
+            {
+                return Ok(());
             }
             auth_cache.remove(token);
         }
diff --git a/src/test/utils.rs b/src/test/utils.rs
index 3809abc9..0df30f52 100644
--- a/src/test/utils.rs
+++ b/src/test/utils.rs
@@ -31,21 +31,21 @@ use crate::jobserver::Client;
 /// Return a `Vec` with each listed entry converted to an owned `String`.
 macro_rules! stringvec {
     ( $( $x:expr ),* ) => {
-        vec!($( $x.to_owned(), )*)
+        vec![$( $x.to_owned(), )*]
     };
 }
 
 /// Return a `Vec` with each listed entry converted to an owned `OsString`.
 macro_rules! ovec {
     ( $( $x:expr ),* ) => {
-        vec!($( ::std::ffi::OsString::from($x), )*)
+        vec![$( ::std::ffi::OsString::from($x), )*]
     };
 }
 
 /// Return a `Vec` with each listed entry converted to an owned `PathBuf`.
 macro_rules! pathvec {
     ( $( $x:expr ),* ) => {
-        vec!($( ::std::path::PathBuf::from($x), )*)
+        vec![$( ::std::path::PathBuf::from($x), )*]
