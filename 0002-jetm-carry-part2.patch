+                        } else {
+                            !returned_outputs.contains(dist)
+                        }
+                    })
         {
             bail!(
                 "distributed compile on {} did not return expected output {}; recompiling locally",
@@ -3944,6 +3968,253 @@ LLVM version: 6.0",
