From 6509485d09d584111c179555d796937e4cb8d1ed Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Thu, 5 Nov 2026 11:01:14 -0600
Subject: [PATCH 35/35] compiler/c: Use ? for the .include prefix fallthrough

clippy::question_mark on Rust 1.99 flags the else branch of
asm_dependency_at that strips INCLUDE_DIRECTIVE and returns None
otherwise, and the pre-push clippy gate fails on it under -D warnings.

Taking the prefix with ? in the else branch keeps the same two-way
dispatch and the same None for any other text, so no behaviour changes.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/c.rs | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/src/compiler/c.rs b/src/compiler/c.rs
index 71f10854..4e11c3b7 100644
--- a/src/compiler/c.rs
+++ b/src/compiler/c.rs
@@ -989,10 +989,9 @@ fn asm_dependency_at(slice: &[u8]) -> Option<(AsmDependency, usize)> {
     let (wrap, directive_len, after_directive): (fn(Vec<u8>) -> AsmDependency, _, _) =
         if let Some(rest) = slice.strip_prefix(INCBIN_DIRECTIVE) {
             (AsmDependency::Embedded, INCBIN_DIRECTIVE.len(), rest)
-        } else if let Some(rest) = slice.strip_prefix(INCLUDE_DIRECTIVE) {
-            (AsmDependency::Source, INCLUDE_DIRECTIVE.len(), rest)
         } else {
-            return None;
+            let rest = slice.strip_prefix(INCLUDE_DIRECTIVE)?;
+            (AsmDependency::Source, INCLUDE_DIRECTIVE.len(), rest)
         };
 
     Some(match parse_file_operand(after_directive)? {
