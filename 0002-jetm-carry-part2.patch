From d4144f0d66822b72d05c864573d57de9cac927ac Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Fri, 30 Oct 2026 17:44:42 -0600
Subject: [PATCH 21/35] compiler: report a dropped dist output when the
 fallback switch is off

With `[dist] fallback = false` the returned-versus-declared output check
was skipped, so a build server that exited 0 without returning a
declared output went unnoticed. If an object from an earlier build sat
at that path, the client zipped that stale file, cached it under the new
key and reported success: a wrong object served from the compile cache
to every later hit.

The check now runs in both modes. With the switch on it still triggers a
local recompile. With the switch off it removes the outputs just
written, so no stale file can be mistaken for the result, and returns a
dedicated error that the recompile handler passes through as it does an
HTTP client error. A non-zero remote exit keeps its own report path.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/compiler.rs | 207 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 203 insertions(+), 4 deletions(-)

diff --git a/src/compiler/compiler.rs b/src/compiler/compiler.rs
index 2c0bc83b..cdbdb4ec 100644
--- a/src/compiler/compiler.rs
+++ b/src/compiler/compiler.rs
@@ -906,6 +906,22 @@ impl Drop for InflightGuard {
     }
 }
 
+/// A distributed compile succeeded without returning a declared output while the
+/// `[dist] fallback` switch is off, so it is reported instead of recompiled.
+#[cfg(feature = "dist-client")]
+#[derive(Debug)]
+pub(crate) struct DistOutputMissing(pub String);
+
+#[cfg(feature = "dist-client")]
+impl std::error::Error for DistOutputMissing {}
+
+#[cfg(feature = "dist-client")]
+impl fmt::Display for DistOutputMissing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}", self.0)
+    }
+}
+
 #[cfg(feature = "dist-client")]
 async fn dist_or_local_compile<T>(
     service: &server::SccacheService<T>,
@@ -1175,7 +1191,12 @@ where
         // distribution artifact and fall back to a local recompile via the
         // or_else below, which reproduces the full output set. Compiles whose
         // dist output set is complete are unaffected.
-        if fallback_enabled
+        //
