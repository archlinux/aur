From 2df26335ab392b39a7e7b1737a244100b419a52c Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Tue, 27 Oct 2026 20:08:50 -0600
Subject: [PATCH 11/35] pre-commit: Format with rustfmt at the crate edition

The rust-fmt hook ran `cargo +nightly fmt -- <files>`. With explicit
file arguments that invokes rustfmt directly, and rustfmt then parses
at its default 2015 edition instead of the crate's, so it rejects the
let-chains the tree already uses and the hook fails on files nobody
touched.

Call rustfmt with --edition 2024, the crate edition, so the hook
formats what the compiler accepts.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 .pre-commit-config.yaml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
index f7986a43..b552a2fb 100644
--- a/.pre-commit-config.yaml
+++ b/.pre-commit-config.yaml
@@ -6,7 +6,7 @@ repos:
       - id: rust-fmt
         name: cargo fmt
         description: Format Rust sources included in the commit.
-        entry: cargo +nightly fmt --
+        entry: rustfmt +nightly --edition 2024
         pass_filenames: true
         types: [file, rust]
         language: system
-- 
Javier Tia


From cad1b61e89a83e2f4d95c8624836ff14b7d00e86 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Tue, 27 Oct 2026 20:07:18 -0600
Subject: [PATCH 12/35] compiler/c: Test that the task env reaches the
 toolchain packager's compiler

The toolchain packager asks the compiler where its sub-tools live with
-print-prog-name and -print-file-name, and the answer depends on
COMPILER_PATH and GCC_EXEC_PREFIX from the compile task. Nothing tested
that those variables reach the compiler process: dropping the .envs()
call would package the build host's assembler for an OE cross toolchain
and no test would fail.

The call sat in a closure inside write_pkg, which needs a real compiler
and a full toolchain to run. It is now print_named_path, a free function
with the same cfg gate as its only caller. Two tests drive it with a
throwaway shell script as the compiler: one proves a variable set only
in the task env shows up in the answer, the other pairs a failing script
with an identical succeeding one so a spawn failure cannot pass for a
non-zero exit.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/c.rs | 163 +++++++++++++++++++++++++++++++++++++---------
 1 file changed, 134 insertions(+), 29 deletions(-)

diff --git a/src/compiler/c.rs b/src/compiler/c.rs
index bf4cf611..8bfc2b70 100644
--- a/src/compiler/c.rs
+++ b/src/compiler/c.rs
@@ -1462,6 +1462,56 @@ fn resolve_prog_in_path(raw: PathBuf, path_env: Option<&OsStr>) -> Option<PathBu
     }
 }
 
+/// Ask the compiler where one of its own files or programs lives, via
+/// `-print-file-name=<name>` or `-print-prog-name=<name>` (`kind` is `file` or
+/// `prog`). The compiler runs with the compile task's environment, because
+/// variables such as COMPILER_PATH and GCC_EXEC_PREFIX change the answer. A bare
+/// answer is resolved against `path_env`, the task's PATH, or against the daemon's own
+/// PATH when `path_env` is `None`. Returns `None` when the compiler cannot run, exits
+/// non-zero, or names a program that is not on the PATH it is resolved against.
+#[cfg(feature = "dist-client")]
+#[cfg(all(
+    target_os = "linux",
+    any(target_arch = "x86_64", target_arch = "aarch64")
+))]
+fn print_named_path(
+    executable: &Path,
+    env_vars: &[(OsString, OsString)],
+    path_env: Option<&OsStr>,
+    kind: &str,
+    name: &str,
+) -> Option<PathBuf> {
+    use std::os::unix::ffi::OsStringExt;
+
+    let mut output = process::Command::new(executable)
+        .arg(format!("-print-{}-name={}", kind, name))
+        .envs(env_vars.iter().cloned())
+        .output()
+        .ok()?;
+    debug!(
+        "find named {} {} output:\n{}\n===\n{}",
+        kind,
+        name,
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr),
+    );
+    if !output.status.success() {
+        debug!("exit failure");
+        return None;
+    }
+
+    // Remove the trailing newline (if present)
+    if output.stdout.last() == Some(&b'\n') {
+        output.stdout.pop();
+    }
+
+    // Create our PathBuf from the raw bytes.  Relative paths are resolved against
+    // the compile task's PATH, falling back to the daemon's PATH when none was
+    // captured.
+    let path: PathBuf = OsString::from_vec(output.stdout).into();
+    resolve_prog_in_path(path, path_env)
+}
+
