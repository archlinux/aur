From 8d36f344a14b41076bab7a440e766ae9cc119b39 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Fri, 30 Oct 2026 17:35:25 -0600
Subject: [PATCH 18/35] dist/server: verify an uploaded toolchain's hash before
 it enters the cache

The upload was grafted into the cache first and hashed afterwards, so a
forged or corrupt upload evicted valid toolchains to make room for
content that was then thrown away, and the re-hash ran under the global
cache lock, stalling every other cache user for the length of a
multi-gigabyte read.

The receiver now hashes the bytes as they stream to the temporary file,
compares the digest with the archive id before touching the cache, and
drops a mismatch without evicting anything. A match takes the lock only
to rename the file in, through a new insert that does not re-hash. The
existing hashing insert and its test stay for callers that have not
verified the content.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/bin/sccache-dist/main.rs | 113 ++++++++++++++++++++++++++++++++++-
 src/dist/cache.rs            |  15 ++++-
 2 files changed, 122 insertions(+), 6 deletions(-)

diff --git a/src/bin/sccache-dist/main.rs b/src/bin/sccache-dist/main.rs
index 0faef02d..97206353 100644
--- a/src/bin/sccache-dist/main.rs
+++ b/src/bin/sccache-dist/main.rs
@@ -1339,6 +1339,19 @@ fn store_toolchain(
     result
 }
 
+struct HashingReader<'a> {
+    inner: &'a mut dyn io::Read,
+    digest: sccache::util::Digest,
+}
+
+impl io::Read for HashingReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let n = self.inner.read(buf)?;
+        self.digest.update(&buf[..n]);
+        Ok(n)
+    }
+}
+
 fn receive_toolchain(
     cache: &Mutex<TcCache>,
     tc: &Toolchain,
@@ -1358,15 +1371,24 @@ fn receive_toolchain(
     let Ok(mut tmpfile) = tempfile::NamedTempFile::new_in(&tc_cache_dir) else {
         return SubmitToolchainResult::CannotCache;
     };
-    if io::copy(tc_rdr, tmpfile.as_file_mut()).is_err() {
+    // Hash while copying so verification costs no lock and no second read, and a
+    // forged upload is dropped before it can evict anything.
+    let mut hashing = HashingReader {
+        inner: tc_rdr,
+        digest: sccache::util::Digest::default(),
+    };
+    if io::copy(&mut hashing, tmpfile.as_file_mut()).is_err() {
+        return SubmitToolchainResult::CannotCache;
+    }
+    if hashing.digest.finish() != tc.archive_id {
         return SubmitToolchainResult::CannotCache;
     }
     let temp_path = tmpfile.into_temp_path();
-    // Re-acquire the cache lock ONLY to graft the finished file into the cache.
+    // Re-acquire the cache lock ONLY to rename the verified file into the cache.
     cache
         .lock()
         .unwrap()
-        .insert_at(tc, &temp_path)
+        .insert_verified_at(tc, &temp_path)
         .map(|_| SubmitToolchainResult::Success)
         .unwrap_or(SubmitToolchainResult::CannotCache)
 }
@@ -2671,6 +2693,91 @@ mod scheduler_tests {
         }
     }
 
