+    if digest != tc.archive_id {
+        warn!(
+            "Rejected toolchain upload for {}: content hashes to {}",
+            tc.archive_id, digest
+        );
         return SubmitToolchainResult::CannotCache;
     }
     let temp_path = tmpfile.into_temp_path();
