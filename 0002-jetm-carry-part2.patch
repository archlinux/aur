From ef1710d34d65f9a992281c2fac1e736878bad83b Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 15:55:24 -0600
Subject: [PATCH 07/35] compiler: keep the server annotation on a reported
 remote failure

With the dist fallback switch off, the remote result is meant to reach
the client as release 0.19.0 returns it. The switch commit kept the
exit code and the compiler's stderr but dropped the line 0.19.0 puts at
the top of that stderr naming the server the job failed on, which is
the only hint that a failure belongs to one host, for example flaky
hardware.

Restore the annotation on the reported-failure path. It cannot run with
the switch on, because a non-zero remote result has already turned into
a local recompile by then. The test for the switch-off mode now asserts
that the stderr starts with the annotation as well as ending with the
remote compiler's output; upstream's own failed-compile test only checks
the end, which is why the loss went unnoticed.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/compiler.rs | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/compiler/compiler.rs b/src/compiler/compiler.rs
index e325829a..f8fc821a 100644
--- a/src/compiler/compiler.rs
+++ b/src/compiler/compiler.rs
@@ -1056,7 +1056,7 @@ where
                 )
             })?;
 
-        let jc = match jres {
+        let mut jc = match jres {
             dist::RunJobResult::Complete(jc) => jc,
             dist::RunJobResult::JobNotFound => bail!("Job {} not found on server", job_id),
         };
@@ -1169,6 +1169,17 @@ where
             );
         }
 
+        if jc.output.code != 0 {
+            // Reached only with the fallback switch off, where the remote result is
+            // reported to the client as release 0.19.0 does.
+            // Add server info to help diagnose host-specific failures, e.g. due to flaky hardware.
+            // Failed builds are not cached so this tampering should not cause too much trouble.
+            let server_info = format!("sccache: Job failed on server {}:\n", server_id.addr());
+            jc.output
+                .stderr
+                .splice(0..0, server_info.as_bytes().to_vec());
+        }
+
         let ms_run_fetch = t_run.elapsed().as_millis();
         info!(
             "[{}]: dist-job done on {} in {}ms (preprocess {}ms, put_tc {}ms, alloc {}ms, submit {}ms, run+fetch {}ms, in_flight {})",
@@ -3929,6 +3940,8 @@ LLVM version: 6.0",
         }
         assert_eq!(res.status.code(), Some(1));
         assert!(res.stderr.ends_with(b"remote stderr"));
+        // As in 0.19.0, a reported remote failure names the server that produced it.
+        assert!(res.stderr.starts_with(b"sccache: Job failed on server "));
     }
 
     #[test_case(true ; "with preprocessor cache")]
-- 
Javier Tia


From 4e3def9704d7eddeed5b8c8d3dd1311d6267e2e1 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 17:54:55 -0600
Subject: [PATCH 08/35] compiler/rust: ship sysroot rlibs whose name has no
 hash suffix

The inputs packager skips a hashless library when rustc dependency
names are unavailable, because a name such as libz.so is then
indistinguishable from a Rust artifact. That skip ran before the
exemption for a target rustlib directory, so a non-cargo build never
shipped the sysroot's libstd.rlib. The remote rustc then lacked std
and every std-dependent crate fell back to a local recompile.

Apply the rustlib exemption to the skip as well. A hashless file
outside a rustlib directory is still skipped, which a second test
pins.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/rust.rs | 66 +++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 65 insertions(+), 1 deletion(-)

diff --git a/src/compiler/rust.rs b/src/compiler/rust.rs
index 26436d45..86bff5ed 100644
--- a/src/compiler/rust.rs
+++ b/src/compiler/rust.rs
@@ -2706,7 +2706,8 @@ impl pkg::InputsPackager for RustInputsPackager {
                     };
                     // Without rustc dependency names, a hashless native library such as
                     // libz.so is indistinguishable from a hashless Rust artifact.
-                    if hashless && rlib_dep_reader_and_names.is_none() {
+                    // A target rustlib dir is exempt: its hashless libstd.rlib is a Rust crate.
+                    if hashless && !ship_all && rlib_dep_reader_and_names.is_none() {
                         continue;
                     }
                     if let Some((_, ref dep_crate_names)) = rlib_dep_reader_and_names {
@@ -4962,6 +4963,69 @@ foo.rs:
         )));
     }
 
+    #[cfg(feature = "dist-client")]
+    fn shipped_lib_names(libdir: &Path) -> Vec<String> {
+        let packager = Box::new(RustInputsPackager {
+            env_vars: vec![],
+            crate_link_paths: vec![libdir.to_path_buf()],
+            crate_types: CrateTypes {
+                rlib: false,
+                staticlib: false,
+            },
+            inputs: vec![],
+            path_transformer: dist::PathTransformer::new(),
+            rlib_dep_reader: None,
+        });
+        let mut buf = vec![];
+        pkg::InputsPackager::write_inputs(packager, &mut buf).unwrap();
+        let mut archive = tar::Archive::new(buf.as_slice());
+        let mut names: Vec<String> = archive
+            .entries()
+            .unwrap()
+            .map(|e| {
+                let e = e.unwrap();
+                let path = e.path().unwrap();
+                path.file_name().unwrap().to_string_lossy().into_owned()
+            })
+            .collect();
+        names.sort();
+        names
+    }
+
+    // With no rustc dependency names (a non-cargo build) a target sysroot still has
+    // to ship its hashless libstd.rlib, or every std-dependent crate fails remotely.
+    #[cfg(feature = "dist-client")]
+    #[test]
+    fn test_inputs_packager_ships_hashless_sysroot_rlib_without_dep_names() {
+        let td = tempfile::Builder::new()
+            .prefix("sccache_test_rustlib")
+            .tempdir()
+            .unwrap();
+        let libdir = td.path().join("rustlib/aarch64-linux-gnu/lib");
+        fs::create_dir_all(&libdir).unwrap();
+        fs::write(libdir.join("libstd.rlib"), b"std").unwrap();
+        fs::write(libdir.join("libcore-0123456789abcdef.rlib"), b"core").unwrap();
+        assert_eq!(
+            vec!["libcore-0123456789abcdef.rlib", "libstd.rlib"],
+            shipped_lib_names(&libdir)
+        );
+    }
+
+    // Outside a target rustlib dir a hashless library is a native library such as
+    // libz.so and must stay out of the inputs when no dependency names are known.
+    #[cfg(feature = "dist-client")]
+    #[test]
+    fn test_inputs_packager_skips_hashless_native_lib_outside_rustlib() {
+        let td = tempfile::Builder::new()
+            .prefix("sccache_test_nativelib")
+            .tempdir()
+            .unwrap();
+        let libdir = td.path().join("usr/lib");
+        fs::create_dir_all(&libdir).unwrap();
+        fs::write(libdir.join("libz.so"), b"z").unwrap();
+        assert!(shipped_lib_names(&libdir).is_empty());
+    }
+
     #[cfg(feature = "dist-client")]
     #[test]
     fn test_is_rustlib_target_libdir() {
-- 
Javier Tia


From 3c0c7a4a2f2d04c068debc22527618b309251889 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 17:57:25 -0600
Subject: [PATCH 09/35] dist: compare returned outputs, not path existence,
 after a remote compile

After a successful remote compile the client fell back to a local
recompile only when a declared output path did not exist. A stale
object from an earlier build sits at that path, so a server that
dropped the output still passed the check and the stale file was
cached as the result of the new compile.

Match each declared output against the set the server returned. gcc's
dependency file is the exception: the local preprocessor writes it and
the server never returns it, so it keeps the existence check. Without
that exemption every -MD compile would fall back locally.

Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/compiler/compiler.rs | 321 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 316 insertions(+), 5 deletions(-)

diff --git a/src/compiler/compiler.rs b/src/compiler/compiler.rs
index f8fc821a..993eb7f8 100644
--- a/src/compiler/compiler.rs
+++ b/src/compiler/compiler.rs
@@ -973,11 +973,24 @@ where
         // finishes. Captured before `compilation` is moved into the packagers
         // below so a remote compile that drops a declared output can be detected
         // and salvaged (see the missing-output check after the run completes).
-        let expected_output_paths: Vec<PathBuf> = compilation
+        //
+        // Each entry pairs the output's dist path with its local path. The dist
+        // path is matched against what the server returned, because a stale file
+        // from an earlier build at the local path would pass a bare existence
+        // check. gcc's dependency file (key `d`) is written by the local
+        // preprocessor and the server never returns it, so it keeps the
+        // existence check.
+        let expected_outputs: Vec<(String, PathBuf, bool)> = compilation
             .outputs()
             .filter(|output| !output.optional)
-            .map(|output| cwd.join(output.path))
-            .collect();
+            .map(|output| {
+                let local = cwd.join(output.path);
+                path_transformer
+                    .as_dist_abs(&local)
+                    .map(|dist| (dist, local, output.key == "d"))
+            })
+            .collect::<Option<_>>()
+            .context("Failed to adapt an output path for distributed compile")?;
         let (inputs_packager, toolchain_packager, outputs_rewriter) =
             compilation.into_dist_packagers(path_transformer)?;
 
@@ -1088,6 +1101,8 @@ where
             }};
         }
 
+        let returned_outputs: std::collections::HashSet<String> =
+            jc.outputs.iter().map(|(p, _)| p.clone()).collect();
         for (path, output_data) in jc.outputs {
             let len = output_data.lens().actual;
             let local_path = try_or_cleanup!(
@@ -1160,7 +1175,16 @@ where
         // or_else below, which reproduces the full output set. Compiles whose
         // dist output set is complete are unaffected.
         if fallback_enabled
-            && let Some(missing) = expected_output_paths.iter().find(|p| !p.exists())
+            && let Some((_, missing, _)) =
+                expected_outputs
+                    .iter()
