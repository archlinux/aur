post_install() {
  cat << 'MSG'

  Cangjie Nightly toolchain installed.

  - SDK root:        /opt/cangjie-nightly
  - Compiler:        /usr/bin/cjc
  - Package manager: /usr/bin/cjpm
  - Debugger:        /usr/bin/cjdb

  /usr/bin/cjc auto-adds --set-runtime-rpath so compiled programs
  find runtime libraries without ldconfig or LD_LIBRARY_PATH.

  To set CANGJIE_HOME, log out and back in, or run:

      source /etc/profile.d/cangjie-nightly.sh

  If you use VSCode, set the SDK path in extension settings to:

      /opt/cangjie-nightly

MSG
}

post_upgrade() {
  :
}

pre_remove() {
  :
}

post_remove() {
  :
}
