post_install() {
    echo
    echo '---------- atrium post-install ----------'
    echo 'Enable the service to start at boot:'
    echo '  sudo systemctl disable display-manager.service'
    echo '  sudo systemctl enable atrium.service'
    echo
    echo 'See /etc/atrium.conf and /etc/atrium-greeter.conf for configuration.'
    echo '-----------------------------------------'
    echo
}

post_upgrade() {
    echo
    echo '---------- atrium post-upgrade ----------'
    echo '/etc/atrium.conf and /etc/atrium-greeter.conf may have new options -'
    echo 'review before restarting the service.'
    echo '-----------------------------------------'
    echo
}
