post_install() {
    printf '\n\033[1m---------- atrium post-install ----------\033[0m\n'
    printf 'Enable the service to start at boot:\n'
    printf '  sudo systemctl disable display-manager.service\n'
    printf '  sudo systemctl enable atrium.service\n'
    printf '\nSee /etc/atrium.conf and /etc/atrium-greeter.conf for configuration.\n'
    printf '\033[1m-----------------------------------------\033[0m\n\n'
}

post_upgrade() {
    printf '\n\033[1m---------- atrium post-install ----------\033[0m\n'
    printf '/etc/atrium.conf and /etc/atrium-greeter.conf may have new options -\n'
    printf 'review before restarting the service.\n'
    printf '\033[1m-----------------------------------------\033[0m\n\n'
}
