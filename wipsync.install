post_install() {
  cat <<'MSG'
==> Set wipsync up, then start its service for your user (not as root):
      wipsync init
      systemctl --user enable --now wipsync
MSG
}

post_upgrade() {
  cat <<'MSG'
==> If the wipsync service runs, restart it for the new version (as your user):
      systemctl --user restart wipsync
MSG
}
