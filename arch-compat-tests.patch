@@ -0,0 +1,123 @@
+"""Regression coverage for the rolling-distribution dependency stack."""
+
+import hashlib
+import json
+import secrets
+from types import SimpleNamespace
+
+import cbor2
+import pytest
+from cryptography.hazmat.primitives import hashes
+from cryptography.hazmat.primitives.asymmetric import ec
+from webauthn.helpers import base64url_to_bytes, bytes_to_base64url
+
+from app.pw_models import PasswordOracle
+from app.webauthn_utils import (
+    authentication_options,
+    registration_options,
+    verify_registration,
+    verify_authentication,
+)
+
+
+def test_bcrypt_legacy_long_password():
+    oracle = PasswordOracle()
+    oracle.set_password("é" * 50)
+    assert oracle.check_password("é" * 50)
+    assert not oracle.check_password("wrong")
+    # bcrypt <5 silently truncated UTF-8 bytes at 72, including existing hashes.
+    assert oracle.check_password("é" * 36 + "suffix")
+
+
+def test_webauthn_registration_and_authentication():
+    rp_id = "localhost"
+    origin = "http://localhost"
+    challenge = secrets.token_urlsafe(32)
+    private_key = ec.generate_private_key(ec.SECP256R1())
+    numbers = private_key.public_key().public_numbers()
+    cose = cbor2.dumps(
+        {1: 2, 3: -7, -1: 1, -2: numbers.x.to_bytes(32), -3: numbers.y.to_bytes(32)}
+    )
+    credential_id = secrets.token_bytes(32)
+    user = SimpleNamespace(email="test@example.com", name="Test")
+    options = registration_options(user, "user-uuid", [], challenge, rp_id)
+    assert base64url_to_bytes(options["challenge"]) == base64url_to_bytes(challenge)
+    assert base64url_to_bytes(options["user"]["id"]) == b"user-uuid"
+    assert options["excludeCredentials"] == []
+    client_data = json.dumps(
+        {"type": "webauthn.create", "challenge": challenge, "origin": origin}
+    ).encode()
+    auth_data = (
+        hashlib.sha256(rp_id.encode()).digest()
+        + b"\x41"
+        + (0).to_bytes(4)
+        + bytes(16)
+        + len(credential_id).to_bytes(2)
+        + credential_id
+        + cose
+    )
+    payload = {
+        "id": bytes_to_base64url(credential_id),
+        "rawId": bytes_to_base64url(credential_id),
+        "type": "public-key",
+        "clientData": bytes_to_base64url(client_data),
+        "attObj": bytes_to_base64url(
+            cbor2.dumps({"fmt": "none", "attStmt": {}, "authData": auth_data})
+        ),
+    }
+    result = verify_registration(payload, challenge, rp_id, origin)
+    key = SimpleNamespace(
+        credential_id=bytes_to_base64url(result.credential_id),
+        public_key=bytes_to_base64url(result.credential_public_key),
+        sign_count=result.sign_count,
+    )
+    options = authentication_options([key], challenge, rp_id)
+    assert options["allowCredentials"][0]["id"] == payload["id"]
+    assert (
+        authentication_options([key], challenge, rp_id, user_verification="required")[
+            "userVerification"
+        ]
+        == "required"
+    )
+    client_data = json.dumps(
+        {"type": "webauthn.get", "challenge": challenge, "origin": origin}
+    ).encode()
+    auth_data = hashlib.sha256(rp_id.encode()).digest() + b"\x01" + (1).to_bytes(4)
+    signature = private_key.sign(
+        auth_data + hashlib.sha256(client_data).digest(), ec.ECDSA(hashes.SHA256())
+    )
+    payload.update(
+        clientData=bytes_to_base64url(client_data),
+        authData=bytes_to_base64url(auth_data),
+        signature=signature.hex(),
+    )
+    assert verify_authentication(payload, key, challenge, rp_id, origin) == 1
+    for bad_challenge, bad_rp, bad_origin in [
+        (secrets.token_urlsafe(32), rp_id, origin),
+        (challenge, "wrong.example", origin),
+        (challenge, rp_id, "https://wrong.example"),
+    ]:
+        with pytest.raises(Exception):
+            verify_authentication(payload, key, bad_challenge, bad_rp, bad_origin)
+    key.sign_count = 1
+    with pytest.raises(Exception):
+        verify_authentication(payload, key, challenge, rp_id, origin)
+
+
+@pytest.mark.parametrize(
+    "agent, expected",
+    [
+        ("Mozilla/5.0 Chrome/120.0 Safari/537.36", "Chrome"),
+        ("Mozilla/5.0 Chrome/120.0 Safari/537.36 Edg/120.0", "Edge"),
+        ("Mozilla/5.0 Firefox/120.0", "Firefox"),
+        ("Mozilla/5.0 (Android) Chrome/120.0 Mobile", "Other"),
+        ("Mozilla/5.0 (iPhone) AppleWebKit/605.1.15", "Other"),
+        ("Mozilla/5.0 Safari/605.1.15", "Other"),
+        ("", "Other"),
+    ],
+)
+def test_browser_detection(flask_app, agent, expected):
+    from app.onboarding.utils import get_browser
+
+    with flask_app.test_request_context(headers={"User-Agent": agent}):
+        assert get_browser().name == expected
