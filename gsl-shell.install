post_install() {
    echo "---------------------------------------------------------------"
    echo "Packager's notes:"
    echo "Patching up the GSL-SHELL was a LOT of work."
    echo "Since the mainstream project is in such a (relative) bad shape,"
    echo "it is probably better to stick with the static binary version"
    echo "(i.e. the package AUR/gsl-shell-bin - which is also mine)."
    echo "---------------------------------------------------------------"
}

post_upgrade() {
    post_install
}
