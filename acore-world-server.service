[Unit]
Description=AzerothCore MMORPG World Server
After=network.target azerothcore-auth.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/bin/tmux new-session -d -s acore-world /usr/share/azerothcore/acore.sh run-worldserver
ExecStop=/usr/bin/tmux kill-session -t acore-world || true

[Install]
WantedBy=multi-user.target
