[Unit]
Description=AzerothCore MMORPG World Server
After=network.target acore-auth-server.service

[Service]
Type=simple
User=azerothcore
Group=acore-admin
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/share/azerothcore/bin/worldserver
Restart=on-failure

[Install]
WantedBy=multi-user.target
