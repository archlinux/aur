+[ -f "$FP_DIR/Libraries/libgtk-3.so.0" ] && export GDK_PIXBUF_MODULE_FILE="$FP_DIR/Libraries/loader.cache" GSETTINGS_SCHEMA_DIR="$FP_DIR/Libraries" LD_LIBRARY_PATH="$FP_DIR/Libraries" LIBGL_DRIVERS_PATH="$FP_DIR/Libraries" && if [ -d "$FP_DIR/FPSoftware/Wine/bin" ]; then export PATH="$FP_DIR/Libraries"; else export PATH="$FP_DIR/Libraries:$PATH"; fi
 
 # Set the Wine prefix, so it doesn't potentially mess with the default one.
