+# Check for correct ownership
+if [[ "$(stat -c %U "$FP_DIR/Data/flashpoint.sqlite")" != "$USER" ]]; then
+	echo -e "WARNING: Flashpoint directory is not owned by current user! Expect issues.
+Run \"sudo USER=\$USER chown -R \$USER $FP_DIR\" to correct this."
+fi
 
