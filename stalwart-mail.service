[Unit]
Description=Stalwart Mail and Collaboration Server
Documentation=https://stalw.art/docs/get-started
Conflicts=postfix.service sendmail.service exim4.service
ConditionPathExists=/etc/stalwart-mail/config.toml
After=network-online.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=~CAP_BLOCK_SUSPEND CAP_BPF CAP_FOWNER CAP_IPC_OWNER CAP_IPC_LOCK CAP_KILL CAP_LINUX_IMMUTABLE CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_SYS_ADMIN CAP_SYS_BOOT CAP_SYS_CHROOT CAP_SYS_PACCT CAP_SYS_PTRACE CAP_SYS_TTY_CONFIG
ConfigurationDirectory=stalwart-mail
Environment=STALWART_PATH=/var/lib/stalwart-mail
# use drop-in file to configure this environment or direct edit config file in '/etc/stalwart-mail/config.toml'
# Environment=ADMIN_SECRET=<get from `openssl passwd -6`>
ExecStart=/usr/bin/stalwart --config=/etc/stalwart-mail/config.toml
User=stalwart-mail
Group=stalwart-mail
LimitNOFILE=65536
LockPersonality=true
LogsDirectory=stalwart-mail
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=noaccess
ProtectSystem=full
ReadWritePaths=/var/lib/stalwart-mail
Restart=on-failure
RestartSec=5
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=~cgroup
RestrictNamespaces=~ipc
RestrictNamespaces=~mnt
RestrictNamespaces=~net
RestrictNamespaces=~pid
RestrictNamespaces=~user
RestrictNamespaces=~uts
RestrictRealtime=true
RestrictSUIDSGID=true
SyslogIdentifier=stalwart-mail
SystemCallArchitectures=native
SystemCallFilter=~@clock
SystemCallFilter=~@cpu-emulation
SystemCallFilter=~@debug
SystemCallFilter=~@module
SystemCallFilter=~@mount
SystemCallFilter=~@obsolete
SystemCallFilter=~@raw-io
SystemCallFilter=~@reboot
SystemCallFilter=~@resources
SystemCallFilter=~@swap

[Install]
WantedBy=multi-user.target
