# ramsleuth.install — pacman hooks for ramsleuth.service (STABLE source package)
#
# All systemctl calls are guarded (2>/dev/null || true) so install,
# upgrade, and removal never fail the transaction (no-panic contract):
# missing systemd or a failed service start is non-fatal.
# The daemon degrades gracefully without the ryzen_smu module
# (N/A (DriverMissing), exit 0, no panic) and is not removed from
# unit files on upgrade.
# post_install is informative (the hook cannot be interactive — the AUR-parity offer).
# and zero-touch (plan E, C21-11): a sudo-invoked install additionally
# grants the invoking user group membership + current-session socket
# access — every step guarded, idempotent, never fatal.

pre_install() {
    # The daemon unit uses Group=ramsleuth; the group must exist on the
    # target system or the service fails to start. Create it idempotently.
    getent group ramsleuth >/dev/null 2>&1 || groupadd -r ramsleuth
}

pre_upgrade() {
    getent group ramsleuth >/dev/null 2>&1 || groupadd -r ramsleuth
}

post_install() {
    systemctl daemon-reload 2>/dev/null || true
    # polkit: this (re)installs the one-click policy
    # (/usr/share/polkit-1/actions/90-ramsleuth-setup.policy). A polkitd
    # that started before the file landed may keep serving a stale action
    # pool (its inotify hot-reload is not reliable for it — observed
    # 2026-09-25), which would make the GUI's one-click prompt show the
    # generic "run a program in a different context" dialog instead of
    # RamSleuth's branded message. Restart it so the branded
    # org.freedesktop.ramsleuth.setup action is live without a reboot.
    # Guarded like every other call here: non-fatal, never fails the
    # transaction.
    systemctl restart polkit 2>/dev/null || true
    if ! systemctl enable --now ramsleuth.service 2>/dev/null; then
        echo "ramsleuth: ramsleuth.service not started (non-fatal);" \
             "run: systemctl enable --now ramsleuth" >&2
    fi

    # Zero-touch (plan E, C21-11): when the install ran under sudo, grant
    # the invoking user unprivileged access NOW — group membership
    # (persistent; effective at the next login) + the C21-01 state-file
    # seed (current-session socket access, no re-login). The username is
    # validated like the ramsleuth-setup helper does (existing user,
    # line-safe charset) so no value can corrupt the state file.
    if [ -n "${SUDO_USER:-}" ]; then
        case "$SUDO_USER" in
            [A-Za-z_][A-Za-z0-9_-]*) : ;;
            *) SUDO_USER="" ;;
        esac
    fi
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ] \
        && id -u "$SUDO_USER" >/dev/null 2>&1; then
        if ! id -nG "$SUDO_USER" 2>/dev/null | tr ' ' '\n' | grep -qx -- ramsleuth; then
            usermod -aG ramsleuth "$SUDO_USER" 2>/dev/null || true
            echo "ramsleuth: ${SUDO_USER} added to group 'ramsleuth' (persistent; effective at next login)"
        fi
        # C21-01 state-file contract: dir 0755, file 0644, one username
        # per line (LF, no comments, no duplicates). The daemon re-applies
        # a per-user socket ACL from it on every (re)start (C21-03).
        install -d -m 0755 /etc/ramsleuth 2>/dev/null || true
        if ! grep -qx -F -- "$SUDO_USER" /etc/ramsleuth/authorized-users 2>/dev/null; then
            printf '%s\n' "$SUDO_USER" >> /etc/ramsleuth/authorized-users 2>/dev/null || true
            echo "ramsleuth: ${SUDO_USER} seeded in /etc/ramsleuth/authorized-users (current-session access, no re-login)"
        fi
        chmod 0644 /etc/ramsleuth/authorized-users 2>/dev/null || true
        # Restart so the daemon applies the ACL for the CURRENT session
        # immediately (non-fatal — the state file survives any failure).
        systemctl restart ramsleuth.service 2>/dev/null || true
    fi

    # Informative block (non-interactive, non-fatal):
    # the binary names + the optional pinned ryzen_smu DKMS offer.
    echo "ramsleuth: installed — start the GUI with \`ramsleuth\` (the TUI with \`ramsleuth-tui\`)"
    if grep -q "AuthenticAMD" /proc/cpuinfo 2>/dev/null; then
        echo "ramsleuth: AMD host — full telemetry: sudo ramsleuth-install-ryzen-smu-dkms"
        echo "ramsleuth:   (pinned upstream, shown + confirmed before any build; or: yay -S ryzen-smu-dkms)"
        echo "ramsleuth:   RamSleuth runs without it — the AMD section reads N/A (DriverMissing)"
    else
        echo "ramsleuth: Intel host — live Intel subtimings: sudo ramsleuth-install-intel-dkms"
        echo "ramsleuth:   (optional in-repo DKMS module; or one-click: sudo ramsleuth-setup --with-dkms)"
        echo "ramsleuth:   RamSleuth runs without it — /dev/mem fallback where available, else the Intel section reads N/A (DriverMissing)"
    fi

    # One-click setup (C21-01 helper + polkit policy — this package
    # installs both, C21-12): the GUI first-run strip offers it; the CLI
    # equivalent is the same single privileged entrypoint.
    echo "ramsleuth: one-click setup — 'Set up RamSleuth' in the GUI, or: sudo ramsleuth-setup"
    echo "ramsleuth:   AMD driver included: sudo ramsleuth-setup --with-dkms"
}

post_upgrade() {
    systemctl daemon-reload 2>/dev/null || true
    # Same stale-pool reason as post_install (the policy file may have
    # changed with the package): make the branded org.freedesktop.
    # ramsleuth.setup action live without a reboot. Guarded: non-fatal.
    systemctl restart polkit 2>/dev/null || true
}

pre_remove() {
    systemctl stop ramsleuth.service 2>/dev/null || true
}

post_remove() {
    systemctl disable ramsleuth.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
}
