[Unit]
Description=T3 Code (Docker) — @PKGNAME@
Documentation=file:///usr/share/@PKGNAME@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Seed settings.json on first run (never overwrites existing).
# `-e` in sh prevents the ExecStartPre from marking the unit as failed.
ExecStartPre=-/bin/sh -c 'test -f %h/.t3/userdata/settings.json || (mkdir -p %h/.t3/userdata && cp /usr/share/@PKGNAME@/settings-seed.json %h/.t3/userdata/settings.json)'

# Remove stale container from prior run.
ExecStartPre=-/usr/bin/sg docker -c "docker rm -f @PKGNAME@"

# Docker bridge networking. The container sees its own loopback; socat
# inside routes 127.0.0.1:4096 → the real provider URL via host.docker.internal.
# T3 serves on 0.0.0.0:3773 inside; docker -p maps that to @T3_PORT@ on the host.
# Provider URLs are loaded from /etc/@PKGNAME@/providers.env (via EnvironmentFile=).
ExecStart=/usr/bin/sg docker -c "docker run --rm --name @PKGNAME@ --network bridge -p @T3_PORT@:3773 --add-host=host.docker.internal:host-gateway --user %U:%G -e HOME=%h -w %h -v %h:%h:rw --env-file /etc/@PKGNAME@/providers.env @IMAGE_TAG@"
ExecStop=/usr/bin/sg docker -c "docker stop -t 5 @PKGNAME@"

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
