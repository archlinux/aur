+/* Epoch cohort join window: a request created within this span of the epoch's formation joins
+ * its cohort with full membership. Owner-specified value (2026-11-20): a spawn burst whose
+ * sessions stagger sub-5s must form ONE epoch, not a solo burst followed by a second epoch for
+ * the rest. Hard-coded -- no config knob until the owner asks. The window is anchored at
+ * formation and never re-anchored by a joiner, so an epoch's cohort is fixed 5 s after its
+ * formation instant: the anti-indefinite-precedence bound survives. */
+static constexpr int64_t kEpochCohortJoinWindowMs = 5000;
+
 /* Formation: the leader is the oldest active request (head_slot_locked's rule), the epoch class
  * is its current class -- a waiting leader enters as a prefill, the head_class_prefill rule --
  * and the cohort is every request of that class present in running_ or waiting_: queued
@@ -128,9 +144,49 @@ void Scheduler::epoch_form_locked() {
     }
     epoch_live_ = true;
     epoch_start_step_ = step_;
+    epoch_formation_us_ = mono_us();            /* the join window's anchor; never moved again */
     ++m_.epochs;
 }
 
+/* The join window's predicate: an arrival after formation (one created before it is cohort
+ * under OD2, and one the window excludes keeps today's mid-arrival semantics), not revoked by
+ * a preemption [OD1], created within the window of formation, and of the epoch's governing
+ * class at this moment. mu_ held. */
+bool Scheduler::epoch_joinable_locked(const SchedReq& s) const {
+    if (!epoch_live_ || s.epoch_revoked) return false;
+    if (s.arrived_us < epoch_formation_us_) return false;
+    if (s.arrived_us - epoch_formation_us_ > kEpochCohortJoinWindowMs * 1000) return false;
+    return req_class_prefill(s) == epoch_class_prefill_;
+}
+
+/* A join is a full membership: the drain waits for the joiner (that is the point -- the epoch
+ * closes at the last member's phase completion, joined ones included), it is not a
+ * midarrival_cut, and preemption revokes it like any membership [OD1]. The member vector is
+ * sized at formation; a joiner can hold a newer slot. */
+void Scheduler::epoch_join_locked(int32_t slot) {
+    if (epoch_member_.size() < reqs_.size()) epoch_member_.resize(reqs_.size(), false);
+    epoch_member_[(size_t)slot] = true;
+    ++epoch_drain_;
+    ++m_.epoch_cohort_joins;
+}
+
+/* The window's second evaluation point: a request that arrived inside it while class-mismatched
+ * joins when its class flips into the epoch's. The scan runs every planning pass; arrivals that
+ * match at once joined at add_locked already (a new request is prefill-class, so a PREFILL
+ * epoch's in-window arrivals all join there and the scan is a no-op). mu_ held. */
+void Scheduler::epoch_join_scan_locked() {
+    for (int32_t slot : running_) {
+        const SchedReq& s = *reqs_[(size_t)slot];
+        if (!s.req || !s.running || epoch_member_at(slot)) continue;
+        if (epoch_joinable_locked(s)) epoch_join_locked(slot);
+    }
+    for (int32_t slot : waiting_) {
+        const SchedReq& s = *reqs_[(size_t)slot];
+        if (!s.req || epoch_member_at(slot)) continue;
+        if (epoch_joinable_locked(s)) epoch_join_locked(slot);
+    }
+}
