+void DebayerCpuThread::maskInput(uint8_t *data)
+{
+	if (!debayer_->inputMask_)
+		return;
+
+	uint32_t *input = reinterpret_cast<uint32_t *>(data);
+	uint32_t *end = reinterpret_cast<uint32_t *>(data + lineBufferLength_);
+	while (input < end)
+		*input++ &= debayer_->inputMask_;
+}
