post_install() {
cat << EOF
==============================================================================
In order to use clvk, please either log out and log back into your environment
or source /etc/profile.d/clvk-git.sh in the terminal you want to use clvk in.

Go to https://github.com/kpet/clvk to view more environmental variables
==============================================================================
EOF
}

post_upgrade() {
cat << EOF
==============================================================================
In order to use clvk, please either log out and log back into your environment
or source /etc/profile.d/clvk-git.sh in the terminal you want to use clvk in.

Go to https://github.com/kpet/clvk to view more environmental variables
==============================================================================
EOF
}
