post_install() {
  cat <<'MSG'
==> nimdow-wl desktop installed.
  1. Enable networking:      sudo systemctl enable --now NetworkManager
  2. Start the desktop from a TTY with:   river -c nimdow-wl
     or install a login manager (sddm, greetd-tuigreet) and pick "nimdow-wl".
  Press super+/ to see all key bindings.
  On first run nimdow-wl copies /etc/xdg/nimdow-wl/config.toml and nimdow-wl-status copies
  status.toml to ~/.config/nimdow-wl/ (existing files are kept); edit those copies.
  All config keys: /usr/share/nimdow-wl/config.default.toml, man nimdow-wl.
MSG
}
