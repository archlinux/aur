post_install() {
  cat <<'MSG'
==> nimdow-wl desktop installed.
  1. Enable networking:      sudo systemctl enable --now NetworkManager
  2. Start the desktop from a TTY with:   river -c nimdow-wl
     or install a login manager (sddm, greetd-tuigreet) and pick "nimdow-wl".
  The default configs (/etc/xdg/nimdow-wl/config.toml and status.toml) are copied to
  ~/.config/nimdow-wl/ on first login; edit those copies.
MSG
}
