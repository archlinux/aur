post_install() {
    echo ""
    echo "==> claude-monitor installed."
    echo "==> Run the one-time setup to configure tmux and start the daemon:"
    echo ""
    echo "      claude-monitor init"
    echo ""
    echo "==> This will patch your tmux config, enable the systemd user service,"
    echo "==> and verify your Claude credentials automatically."
    echo ""
}

post_upgrade() {
    systemctl --user try-restart claude-monitor 2>/dev/null || true
}
