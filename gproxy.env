# Configuration for the gproxy.service systemd unit.
# See: https://gproxy.leenhawk.com/reference/configuration/
#
# This file is sourced as an EnvironmentFile by systemd, so entries are
# plain KEY=VALUE pairs (no quoting, no "export").

# Listen address (defaults to 127.0.0.1:8787 if unset).
#GPROXY_HOST=127.0.0.1
#GPROXY_PORT=8787

# Standard-base64 32-byte key used to encrypt stored credentials/API keys.
# Without it, secrets are kept in plaintext in the database. Generate one
# with: openssl rand -base64 32
# Do not change this after the database has secrets in it without following
# the documented key-rotation procedure.
#GPROXY_MASTER_KEY=

# Setting these resets the given administrator account on every service
# start. Remove them again after using them to recover access.
#GPROXY_ADMIN_USER=admin
#GPROXY_ADMIN_PASSWORD=

# Persistence backend: sqlite (default), libsql, postgres or mysql.
#GPROXY_PERSISTENCE=sqlite
#GPROXY_DSN=

# Default outbound proxy for upstream requests.
#GPROXY_UPSTREAM_PROXY_URL=
