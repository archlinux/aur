_bldtype=Release
_mozc_commit=ba70ee30b664b79b1268a9839268734d330a9ed7
_bcr_commit=a23aad4ccaffae8667989c9ef499321d1d1ba862
_branch=fcitx

## follow the submodule commits in https://github.com/fcitx/mozc/tree/fcitx/src/third_party
