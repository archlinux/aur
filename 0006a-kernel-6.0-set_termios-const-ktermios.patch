diff -pNaru5 a/ptyx/ptym.c b/ptyx/ptym.c
--- a/ptyx/ptym.c	2025-09-11 15:17:28.000000000 -0400
+++ b/ptyx/ptym.c	2026-11-04 22:47:05.244539773 -0500
@@ -671,11 +671,15 @@ out:
 		 		line, tty, retval, jiffies));
 
 	return retval;
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,1,0)
+static void ptyx_master_set_termios(struct tty_struct *tty, struct ktermios *old_termios)
+#else
 static void ptyx_master_set_termios(struct tty_struct *tty, const struct ktermios *old_termios)
+#endif
 {
 	
 	ptyx_print(PTYX_DEBUG_TERMIOS, ("ptyx_master_set_termios: called current->state=%lx\n",current->state));
 	tty->termios.c_cflag &= ~(CSIZE | PARENB);
 	tty->termios.c_cflag |= (CS8 | CREAD);
