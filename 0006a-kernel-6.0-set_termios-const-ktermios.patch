+#if LINUX_VERSION_CODE < KERNEL_VERSION(6,1,0)
+static void ptyx_slave_set_termios(struct tty_struct *tty, struct ktermios *old_termios)
+#else
 static void ptyx_slave_set_termios(struct tty_struct *tty, const struct ktermios *old_termios)
+#endif
 {
 	struct ptyx_struct *ptyx_info = (struct ptyx_struct *)tty->driver_data;
