post_install() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║                 VoiceType Installed!                       ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""
    echo "📋 REQUIRED SETUP:"
    echo ""
    echo "  1. Add yourself to the 'input' group (for F12 hotkey):"
    echo "     sudo usermod -a -G input \$USER"
    echo "     Then log out and back in"
    echo ""
    echo "🚀 TO START:"
    echo ""
    echo "  Enable the hold-to-speak daemon:"
    echo "     systemctl --user enable --now voicetype-daemon"
    echo ""
    echo "  Or use one-shot mode:"
    echo "     voicetype-input"
    echo ""
    echo "📦 MODEL INCLUDED:"
    echo ""
    echo "  The whisper model is already installed - ready to use!"
    echo ""
    echo "🔧 OPTIONAL DEPENDENCIES:"
    echo ""
    echo "  • ydotool - for auto-paste (recommended)"
    echo "      sudo pacman -S ydotool"
    echo "      systemctl --user enable --now ydotool"
    echo ""
    echo "  • wl-clipboard - for Wayland clipboard"
    echo "      sudo pacman -S wl-clipboard"
    echo ""
    echo "📖 Documentation: https://github.com/aldervall/Voicetype"
    echo ""
}

post_upgrade() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║                 VoiceType Upgraded!                        ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    # Auto-restart daemon if running (for each logged-in user)
    for uid in $(loginctl list-users --no-legend | awk '{print $1}'); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        if systemctl --user -M "${user}@" is-active voicetype-daemon &>/dev/null; then
            echo "🔄 Restarting daemon for user: $user"
            systemctl --user -M "${user}@" restart voicetype-daemon
        fi
    done
    echo ""
}

post_remove() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║                 VoiceType Removed                          ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""
    echo "🧹 Optional cleanup:"
    echo ""
    echo "  Stop and disable daemon:"
    echo "     systemctl --user disable --now voicetype-daemon"
    echo ""
    echo "  Remove downloaded models (~142MB):"
    echo "     rm -rf ~/.local/share/voicetype/models"
    echo ""
    echo "  Remove configuration:"
    echo "     rm -rf ~/.config/voicetype"
    echo ""
}
