[Unit]
Description = IYUU Auto Reseed Plus Daemon.
Wants       = network-online.target php-fpm.service mariadb.service
After       = network-online.target php-fpm.service mariadb.service

[Service]
User = iyuuplus
Group = iyuuplus
Restart = on-failure
ExecStart = /srv/iyuuplus/start.php start

[Install]
WantedBy = multi-user.target
