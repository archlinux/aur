_update_caches() {
  for theme in Linox Linox-Blue Linox-Green Linox-Orange Linox-Pink \
               Linox-Purple Linox-Red Linox-Slate Linox-Teal Linox-Yellow Linox-Yaru; do
    gtk-update-icon-cache -q -t -f "/usr/share/icons/${theme}" 2>/dev/null || true
  done
}

post_install() {
  _update_caches
}

post_upgrade() {
  _update_caches
}

post_remove() {
  _update_caches
}
