post_install() {
  cat <<'MSG'
==> tda-dsc-signer installed. This package never runs sudo and bundles no token driver.
==> Next, as your normal user:
      tda-dsc-signer doctor          # checks pcscd, USB, CCID list, vendor driver; prints any sudo fix to run yourself
      tda-dsc-signer trust install   # optional: pinned CCA India trust bundle in a dedicated NSS db
==> Install your token vendor's PKCS#11 driver separately (see optional dependencies) and,
    if it is not auto-detected, register it with p11-kit, e.g. ~/.config/pkcs11/modules/NAME.module:
      module: /path/to/vendor-pkcs11.so
MSG
}

post_upgrade() {
  post_install
}
