+/// Logical tray-icon target size in device-independent pixels. Linux AppIndicator panels
+/// render at their own fixed size (22–24px typical, up to 48px), so feeding the Windows
+/// 16px base makes the panel upscale it — the upscale is what blurs. Supersampling on Linux
+/// (32px x scale) guarantees the panel downscales instead, which stays crisp.
+#[cfg(target_os = "linux")]
+fn tray_icon_target_size(scale: f64) -> u32 {
+    ((32.0 * scale).round() as u32).clamp(32, 128)
+}
+
+#[cfg(not(target_os = "linux"))]
+fn tray_icon_target_size(scale: f64) -> u32 {
+    ((16.0 * scale).round() as u32).clamp(16, 64)
