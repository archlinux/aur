post_install() {
    echo ""
    echo "═══════════════════════════════════════════════════════════════════"
    echo "  OpenHamClock — Modern Web-Based Amateur Radio Dashboard"
    echo "═══════════════════════════════════════════════════════════════════"
    echo ""
    echo "  🚀 1. Desktop & Application Menu:"
    echo "     • OpenHamClock is available in your Application Menu under:"
    echo "       → Ham Radio / Amateur Radio"
    echo "       → Utility / Accessories"
    echo ""
    echo "  💻 2. Command Line / Interactive:"
    echo "     • Start server and open browser:"
    echo "       openhamclock --browser"
    echo "     • Custom port:"
    echo "       openhamclock --port 3000"
    echo ""
    echo "  ⚙️  3. Background Service (systemd):"
    echo "     • User Session (Recommended):"
    echo "       systemctl --user enable --now openhamclock"
    echo "       systemctl --user status openhamclock"
    echo "       systemctl --user stop openhamclock"
    echo ""
    echo "     • System-Wide (Boot with OS):"
    echo "       sudo systemctl enable --now openhamclock"
    echo "       sudo systemctl status openhamclock"
    echo "       sudo systemctl stop openhamclock"
    echo ""
    echo "  📝 4. Configuration (Callsign & Locator):"
    echo "     • User config:   ~/.config/openhamclock/openhamclock.env"
    echo "     • System config: /etc/openhamclock/openhamclock.env"
    echo ""
    echo "  🌐 Default Web Dashboard: http://localhost:3001"
    echo "═══════════════════════════════════════════════════════════════════"
    echo ""
}

post_upgrade() {
    post_install
}
