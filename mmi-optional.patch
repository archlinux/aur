+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+
+namespace Microsoft.PowerShell.DesiredStateConfiguration.Internal
+{
+    /// <summary>
+    /// Stands in for the DSC class cache when PowerShell is built without Microsoft.Management.Infrastructure
+    /// (see PowerShell.Common.props), which the cache needs for the classes of DSC resources. Modules built
+    /// against System.Management.Automation with MMI may still refer to it, e.g. PSScriptAnalyzer looks up its
+    /// ImportClasses method and handles it not being there.
+    /// </summary>
+    public static class DscClassCache
+    {
+        /// <summary>
+        /// Initializes the cache, which has no classes without MMI.
+        /// </summary>
+        public static void Initialize()
+        {
+        }
+
+        /// <summary>
+        /// Initializes the cache, which has no classes without MMI.
+        /// </summary>
+        /// <param name="errors">Collection of any errors encountered while initializing the cache.</param>
+        /// <param name="modulePathList">List of module paths to search for DSC resources.</param>
+        public static void Initialize(Collection<Exception> errors, List<string> modulePathList)
+        {
+        }
+
+        /// <summary>
+        /// Clears the cache, which has no classes without MMI.
+        /// </summary>
+        public static void ClearCache()
+        {
+        }
+    }
+}
