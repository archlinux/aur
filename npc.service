[Unit]
Description=Nps Client Service
ConditionFileIsExecutable=/usr/bin/npc
After=network.target

[Service]
Type=simple
LimitNOFILE=65536
StartLimitInterval=5
StartLimitBurst=10
Restart=always
RestartSec=120
ExecStart=/usr/bin/npc -config=/etc/nps/conf/npc.conf

[Install]
WantedBy=multi-user.target
