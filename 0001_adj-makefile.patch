--- a/woodland-2.1.1/Makefile.in
+++ b/woodland-2.1.1/Makefile.in
@@ -1,5 +1,5 @@
 CC = gcc
-CFLAGS = -Wall -flto -Wextra -Wpedantic -march=native -funroll-loops -export-dynamic -fomit-frame-pointer
+CFLAGS = -Wall -flto -Wextra -Wpedantic -funroll-loops -export-dynamic -fomit-frame-pointer
 CFLAGS += $(shell pkg-config --cflags dbus-1)
 CFLAGS += $(shell pkg-config --cflags glib-2.0)
 CFLAGS += $(shell pkg-config --cflags librsvg-2.0)
@@ -10,7 +10,7 @@
 CFLAGS += $(shell pkg-config --cflags libinput)
 CFLAGS += $(shell pkg-config --cflags xkbcommon)
 CFLAGS += $(shell pkg-config --cflags wayland-server)
-CFLAGS += $(shell pkg-config --cflags stb)
+CFLAGS += -I/usr/include/stb
 CFLAGS += -Isrc
 CFLAGS += -Iinclude
 CFLAGS += -DWLR_USE_UNSTABLE
@@ -23,7 +23,6 @@
 LDFLAGS += $(shell pkg-config --libs pixman-1)
 LDFLAGS += $(shell pkg-config --libs xkbcommon)
 LDFLAGS += $(shell pkg-config --libs wayland-server)
-LDFLAGS += $(shell pkg-config --libs stb)
 SRCFILES = src/menu.c src/panel.c src/applauncher.c src/texttobuff.c src/generate-icon-cache.c src/windowlist.c src/dbus-network-management.c src/getxkbkeyname.c src/getvaluefromconf.c src/runcmd.c src/woodland.c
 OBJFILES = $(patsubst src/%.c, %.o, $(SRCFILES))
 TARGET = woodland
