################################################
# Note: this file is not replaced during updates
################################################

######################
# AUR package defaults 
######################

CONFIG_PATH=/etc/librechat/librechat.yaml
NODE_ENV=production
# Where upstream persists auto-generated credentials (CREDS_KEY, JWT_SECRET, ...).
# Must be writable by the librechat user and survive restarts.
LIBRECHAT_TEMP_CREDENTIALS_PATH=/var/lib/librechat/.env.temp

#################################################################
# Upstream defaults follow
# see /etc/librechat/librechat.example.env for current defaults
#################################################################

