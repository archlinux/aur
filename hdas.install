post_install() {
    echo
    echo "==> HDAS installed successfully!"
    echo
    echo "systemd:  sudo systemctl enable --now hdas@\$USER"
    echo "Other init systems (dinit, OpenRC, runit, s6): see"
    echo "  https://github.com/adelmonte/hdas/tree/master/init"
    echo
}

post_upgrade() {
    systemctl daemon-reload 2>/dev/null || true
    echo
    echo "==> HDAS upgraded. Restart the hdas service if running."
    echo
}

pre_remove() {
    echo "==> Stop and disable the hdas service before removal."
}
