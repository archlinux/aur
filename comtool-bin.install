# Upstream's README tells you to join "dialout", which is the Debian/Ubuntu
# name for this group. Arch assigns serial ports to "uucp" instead, see
# /usr/lib/udev/rules.d/50-udev-default.rules.

post_install() {
    echo ":: Add yourself to the uucp group to access the serial ports:"
    echo "   sudo usermod -a -G uucp \$USER"
    echo "   sudo udevadm control --reload-rules"
}

pre_upgrade() {
    post_install
}
