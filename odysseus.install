post_install() {
    if ! getent group odysseus &>/dev/null; then
        groupadd --system odysseus
    fi
    if ! getent passwd odysseus &>/dev/null; then
        useradd --system \
            --gid odysseus \
            --home-dir /var/lib/odysseus \
            --shell /usr/bin/nologin \
            --comment "Odysseus AI workspace" \
            odysseus
    fi

    chown -R odysseus:odysseus /var/lib/odysseus
    chown -R odysseus:odysseus /var/log/odysseus
    chmod 750 /etc/odysseus
    chown root:odysseus /etc/odysseus
    chown root:odysseus /etc/odysseus/odysseus.env

    echo "==> Installing Python dependencies..."
    pip install --break-system-packages -r /opt/odysseus-ai-git/requirements.txt --quiet

    systemctl daemon-reload
    systemctl enable --now odysseus

    echo ""
    echo "==> Odysseus installed and started."
    echo "    Running at http://127.0.0.1:7000"
    echo "    Config: /etc/odysseus/odysseus.env"
    echo ""
}

post_upgrade() {
    pip install --break-system-packages -r /opt/odysseus-ai-git/requirements.txt --quiet
    systemctl daemon-reload
    systemctl restart odysseus
}

pre_remove() {
    systemctl stop odysseus 2>/dev/null || true
    systemctl disable odysseus 2>/dev/null || true
}

post_remove() {
    # Remove pip-installed packages
    echo "==> Removing Python dependencies..."
    pip uninstall --break-system-packages -y \
        fastapi uvicorn python-multipart python-dotenv httpx \
        pydantic pydantic-settings SQLAlchemy pypdf beautifulsoup4 \
        charset-normalizer numpy chromadb-client fastembed \
        youtube-transcript-api markdown nh3 icalendar python-dateutil \
        caldav cryptography bcrypt mcp pyotp qrcode croniter 2>/dev/null || true

    # Remove system user and group
    userdel odysseus 2>/dev/null || true
    groupdel odysseus 2>/dev/null || true

    # Remove app files
    rm -rf /opt/odysseus-ai-git

    # Remove data, logs, config
    rm -rf /var/lib/odysseus
    rm -rf /var/log/odysseus
    rm -rf /etc/odysseus

    systemctl daemon-reload

    echo ""
    echo "==> Odysseus fully removed."
    echo ""
}
