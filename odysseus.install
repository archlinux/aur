post_install() {
    echo ""
    echo "==> Odysseus installed to /opt/odysseus-ai-git"
    echo ""
    echo "    First-time setup (run this once as your user):"
    echo ""
    echo "      cd /opt/odysseus-ai-git"
    echo "      python setup.py"
    echo ""
    echo "    This will create data dirs, copy .env.example → .env,"
    echo "    and ask you to set an admin username + password."
    echo ""
    echo "    Then enable and start the service for your user:"
    echo ""
    echo "      systemctl --user enable --now odysseus"
    echo ""
    echo "    Open: http://localhost:7000"
    echo ""
}

post_upgrade() {
    cd /opt/odysseus-ai-git
    venv/bin/pip install -r requirements.txt --quiet
    echo "==> Restart the service: systemctl --user restart odysseus"
}

pre_remove() {
    systemctl --user stop odysseus 2>/dev/null || true
    systemctl --user disable odysseus 2>/dev/null || true
}

post_remove() {
    rm -rf /opt/odysseus-ai-git

    echo ""
    echo "==> Odysseus removed."
    echo "    Your data in /opt/odysseus-ai-git/data was removed with the app."
    echo "    If you had the data dir elsewhere, remove it manually."
    echo ""
}
