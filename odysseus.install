post_install() {
    REAL_USER="${SUDO_USER:-$USER}"

    echo "==> Setting ownership of /opt/odysseus-ai-git to $REAL_USER..."
    chown -R "$REAL_USER:$REAL_USER" /opt/odysseus-ai-git

    echo "==> Creating Python virtual environment..."
    sudo -u "$REAL_USER" python -m venv /opt/odysseus-ai-git/venv

    echo "==> Installing Python dependencies (this may take a few minutes)..."
    sudo -u "$REAL_USER" \
        /opt/odysseus-ai-git/venv/bin/pip install \
        -r /opt/odysseus-ai-git/requirements.txt --quiet

    echo "==> Running first-time setup as $REAL_USER..."
    sudo -u "$REAL_USER" -i \
        ODYSSEUS_SKIP_RUN_HINT=1 \
        /opt/odysseus-ai-git/venv/bin/python /opt/odysseus-ai-git/setup.py

    echo "==> Enabling and starting Odysseus service..."
    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" \
        systemctl --user enable --now odysseus

    echo ""
    echo "==> Odysseus is running at http://localhost:7000"
    echo "    Log in with the credentials you just set."
    echo ""
}

post_upgrade() {
    REAL_USER="${SUDO_USER:-$USER}"

    chown -R "$REAL_USER:$REAL_USER" /opt/odysseus-ai-git

    echo "==> Updating Python dependencies..."
    sudo -u "$REAL_USER" \
        /opt/odysseus-ai-git/venv/bin/pip install \
        -r /opt/odysseus-ai-git/requirements.txt --quiet

    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" \
        systemctl --user daemon-reload

    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" \
        systemctl --user restart odysseus

    echo "==> Odysseus updated and restarted."
}

pre_remove() {
    REAL_USER="${SUDO_USER:-$USER}"

    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" \
        systemctl --user stop odysseus 2>/dev/null || true

    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="/run/user/$(id -u "$REAL_USER")" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u "$REAL_USER")/bus" \
        systemctl --user disable odysseus 2>/dev/null || true
}

post_remove() {
    rm -rf /opt/odysseus-ai-git

    echo ""
    echo "==> Odysseus removed."
    echo "    Your data was inside /opt/odysseus-ai-git/data — already gone."
    echo "    To keep data next time, back up that folder before removing."
    echo ""
}
