+    fn reset_task_options(&mut self, options: ConversionOptions) {
+        self.task_options = options;
+        self.task_slide_inputs_pending = true;
+    }
+
+    fn sync_task_slide_inputs(&mut self, window: &mut Window, cx: &mut Context<Self>) {
+        if !std::mem::take(&mut self.task_slide_inputs_pending) {
+            return;
+        }
+        for (field, value) in [
+            (Field::SampleInterval, self.task_options.sample_interval),
+            (Field::Cooldown, self.task_options.cooldown),
+            (Field::Similarity, self.task_options.similarity),
+            (Field::StableSecs, self.task_options.stable_secs),
+        ] {
+            self.inputs[&field].update(cx, |state, cx| {
+                state.set_value(value.to_string(), window, cx)
+            });
+        }
+    }
+
+    fn resolve_task_slide_options(
+        &self,
+        source: String,
+        cx: &App,
+    ) -> anyhow::Result<course2md::config::PipelineConfig> {
+        let parse = |field, label| {
+            self.value(field, cx)
+                .parse::<f64>()
+                .map_err(|_| anyhow::anyhow!("{label}不是有效数字，请重新输入。"))
+        };
+        let options = course2md::cli::RunOpts {
+            slide_mode: Some(self.task_options.slide_mode),
+            sample_interval: Some(parse(Field::SampleInterval, "采样间隔")?),
+            cooldown: Some(parse(Field::Cooldown, "截图冷却时间")?),
+            similarity: Some(parse(Field::Similarity, "相似度阈值")?),
+            // first does not use the hidden draft. Keep it for a later switch to stable.
+            stable_secs: Some(
+                if self.task_options.slide_mode == course2md::config::SlideMode::Stable {
+                    parse(Field::StableSecs, "稳定等待时间")?
+                } else {
+                    self.task_options.stable_secs
+                },
+            ),
+            formats: Some(
+                [
+                    course2md::config::OutputFormat::Md,
+                    course2md::config::OutputFormat::Html,
+                    course2md::config::OutputFormat::Json,
+                ]
+                .into_iter()
+                .zip(self.task_options.formats)
+                .filter(|(_, selected)| *selected)
+                .map(|(format, _)| format)
+                .collect(),
+            ),
+            ..Default::default()
+        };
+        let config = course2md::options::resolve(source, &options, &self.config)?;
+        config.validate()?;
+        Ok(config)
+    }
