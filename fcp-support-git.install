post_install() {
    systemctl daemon-reload
    udevadm control --reload-rules

    echo ""
    echo "==> Focusrite Control Protocol Server installed."
    echo ""
    echo "    If your Scarlett 4th Gen device (16i16/18i16/18i20) is connected,"
    echo "    trigger udev to start the service:"
    echo "      udevadm trigger --action=add --subsystem-match=sound --attr-match=idVendor=1235"
    echo ""
    echo "    Make sure you are in the 'audio' group:"
    echo "      sudo usermod -a -G audio \$USER"
    echo "      (then log out and back in)"
    echo ""
    echo "    Check service status: systemctl status fcp-server@*"
    echo "    View logs: journalctl -u 'fcp-server@*' -f"
    echo ""
}

post_upgrade() {
    systemctl daemon-reload
    udevadm control --reload-rules

    echo ""
    echo "==> fcp-support has been updated."
    echo "    Service status: systemctl status fcp-server@*"
    echo ""
}

pre_remove() {
    echo "==> Stopping fcp-server services..."
    systemctl stop 'fcp-server@*' 2>/dev/null || true
}

post_remove() {
    systemctl daemon-reload
    udevadm control --reload-rules
}
