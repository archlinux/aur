post_install() {
    cat <<'EOF'
==> makepkg-jail-local installed.
    Load both AppArmor profiles:
      sudo apparmor_parser -r /etc/apparmor.d/makepkg-jail-setup
      sudo apparmor_parser -r /etc/apparmor.d/makepkg-jail-build

    To enable the traur pre-build scan hook:
      sudo ln -s /usr/share/makepkg-jail/hooks/traur \
        /etc/makepkg-jail/pre-fetch.d/50-traur

    After testing, set in paru.conf under [bin]:
      Makepkg = /usr/bin/paru-makepkg-jail
EOF
}

post_upgrade() {
    cat <<'EOF'
==> makepkg-jail-local upgraded.
    Check for /etc/apparmor.d/makepkg-jail-*.pacnew, then reload profiles:
      sudo apparmor_parser -r /etc/apparmor.d/makepkg-jail-setup
      sudo apparmor_parser -r /etc/apparmor.d/makepkg-jail-build
EOF
}

post_remove() {
    cat <<'EOF'
==> Remove the paru.conf Makepkg override for paru-makepkg-jail.
    Loaded AppArmor profiles are not unloaded automatically.
    Remove the traur hook symlink if present:
      sudo rm -f /etc/makepkg-jail/pre-fetch.d/50-traur
EOF
}
