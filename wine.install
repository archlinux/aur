post_install() {
  post_upgrade
}

post_upgrade() {
  inform_patches
  setcap cap_sys_nice+ep /opt/wine-osu-spectator/bin/wineserver
}

inform_patches() {
  echo "For interesting environment variables, see https://github.com/whrvt/wine-osu-patches"
  echo ""
  echo "A minimal wine launcher is now installed to use directly as 'wine-osu', no need to specify a path"
  echo "It will automatically set a realtime priority of 25 for wineserver, set STAGING_RT_PRIORITY_SERVER=# to customize, or 0 to disable"
}
