post_install() {
  cat <<EOF

winmiddle-git installed.

  Required once per user session (enables KWin focus script + service):
       winmiddle --setup
  Or open: winmiddle-ui  → Setup

  The daemon also tries to load the KWin script on start, but --setup still
  handles paste-kill, udev, and enabling the user service.

  Status / logs:
       systemctl --user status winmiddle
       journalctl --user -u winmiddle -f

Settings: winmiddle-ui
Config:   ~/.config/winmiddle/config.toml
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --user disable --now winmiddle.service 2>/dev/null || true
}
