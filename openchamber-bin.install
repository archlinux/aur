
_configure_sandbox() {
  local sandbox='/opt/OpenChamber/chrome-sandbox'

  [[ -x "$sandbox" ]] || return 0

  # Follow upstream Debian sandbox configuration.
  if [[ -L /proc/self/ns/user ]] && unshare --user true 2>/dev/null; then
    chmod 0755 "$sandbox"
  else
    chmod 4755 "$sandbox"
  fi
}

post_install() {
  _configure_sandbox
}

post_upgrade() {
  _configure_sandbox
}
