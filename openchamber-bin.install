
_configure_sandbox() {
  local sandbox='/opt/openchamber/chrome-sandbox'

  [[ -x "$sandbox" ]] || return 0

  # Root can always unshare; probe user namespaces as an unprivileged user.
  if setpriv --reuid=nobody --regid=nobody --clear-groups \
      unshare --user true 2>/dev/null; then
    chmod 0755 "$sandbox"
  else
    chmod 4755 "$sandbox"
  fi
}

post_install() {
  _configure_sandbox
}

post_upgrade() {
  _configure_sandbox
}
