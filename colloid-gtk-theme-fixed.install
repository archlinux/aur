post_install() {
  echo ""
  echo "Libadwaita apps use their own style; to give them Colloid's gtk-4.0 theme, link it into your"
  echo "config folder (replace Colloid-Dark with the variant you use):"
  echo ""
  echo "  mkdir -p ~/.config/gtk-4.0"
  echo "  ln -sf /usr/share/themes/Colloid-Dark/gtk-4.0/{assets,gtk.css,gtk-dark.css} ~/.config/gtk-4.0/"
  echo ""
}

post_upgrade() {
  post_install
}
