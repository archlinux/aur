# Qwen 3.6 27B Text-only NVFP4-MTP — per-instance env override.
#
# This checkpoint is missing preprocessor_config.json upstream. The
# cache-fixup helper (wired via sglang@.service ExecStartPre) injects a
# stub. HF Hub honors injected files only in offline mode; in online
# mode it hits the HF API, gets 404, and ignores the local file. Hence
# HF_HUB_OFFLINE=1 below — required for SGLang to load this model.
#
# Implications:
# - All files (config, tokenizer, weights, ...) must already be in the
#   /var/lib/sglang/hub cache before the service starts. Run once as
#   root before first start:
#
#     sudo -u sglang HOME=/var/lib/sglang HF_HOME=/var/lib/sglang \
#       huggingface-cli download sakamakismile/Qwen3.6-27B-Text-NVFP4-MTP
#
# - After upstream pushes new revisions you must repeat the download
#   with HF_HUB_OFFLINE temporarily unset, then re-enable offline mode.
HF_HUB_OFFLINE=1
