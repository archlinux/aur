+        core = find_direct_child(root, "core");
+        desktops = find_direct_child(core, "desktops");
+    }
+    if (!desktops)
+        desktops = find_first_named(root->children, "desktops");
+
+    if (!desktops)
+        return FALSE;
+
+    number = find_direct_child(desktops, "number");
+    if (number) {
+        value = xmlNodeGetContent(number);
+        if (value) {
+            gboolean ok = parse_int_text(value, out);
+            xmlFree(value);
+            if (ok)
+                return TRUE;
+        }
+    }
+
+    value = xmlGetProp(desktops, (const xmlChar*)"number");
+    if (value) {
+        gboolean ok = parse_int_text(value, out);
+        xmlFree(value);
+        if (ok)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+void tree_set_desktops_number(gint value)
+{
+    xmlNodePtr desktops;
+    xmlNodePtr core;
+    xmlNodePtr number;
+    gchar *s;
+
+    s = g_strdup_printf("%d", value);
+
+    desktops = root ? find_direct_child(root, "desktops") : NULL;
+    if (!desktops && root) {
+        core = find_direct_child(root, "core");
+        desktops = find_direct_child(core, "desktops");
+    }
+    if (!desktops && root)
+        desktops = find_first_named(root->children, "desktops");
+
+    if (!desktops)
+        desktops = tree_get_node("desktops", NULL);
+
+    xmlSetProp(desktops, (const xmlChar*)"number", (const xmlChar*)s);
+
+    number = find_direct_child(desktops, "number");
+    if (!number)
+        number = xmlNewTextChild(desktops, NULL, (const xmlChar*)"number", NULL);
+    xmlNodeSetContent(number, (const xmlChar*)s);
+
+    g_free(s);
+    lxappearance_changed();
 }
