+static xmlNodePtr find_child_with_attrs(xmlNodePtr parent, const gchar *name, gchar **attrs)
+{
+    xmlNodePtr c;
+
+    for (c = parent ? parent->children : NULL; c; c = c->next) {
+        gboolean ok = TRUE;
+        gint i;
+
+        if (c->type != XML_ELEMENT_NODE)
+            continue;
+        if (xmlStrcmp(c->name, (const xmlChar*)name) != 0)
+            continue;
+
+        for (i = 1; attrs[i]; ++i) {
+            gchar **eq = g_strsplit(attrs[i], "=", 2);
+            if (eq[1]) {
+                xmlChar *prop = xmlGetProp(c, (const xmlChar*)eq[0]);
+                if (!prop || g_strcmp0((const gchar*)prop, eq[1]) != 0)
+                    ok = FALSE;
+                if (prop)
+                    xmlFree(prop);
+            }
+            g_strfreev(eq);
+            if (!ok)
+                break;
+        }
+
+        if (ok)
+            return c;
+    }
+
+    return NULL;
+}
+
+static xmlNodePtr find_node(const gchar *path)
+{
+    xmlNodePtr n, c;
+    gchar **nodes;
+    gchar **it;
+
+    n = root;
