+static gchar* layout_to_legacy_letters(const gchar *layout)
+{
+    gchar **parts;
+    gchar **it;
+    GString *out;
+
+    if (!layout || !*layout)
+        return g_strdup("NIMC");
+
+    if (!strchr(layout, ':') && !strchr(layout, ','))
+        return g_strdup(layout);
+
+    out = g_string_new(NULL);
+    parts = g_strsplit_set(layout, ":,", -1);
+    for (it = parts; *it; ++it)
+    {
+        char *token = g_strstrip(*it);
+
+        if (!*token)
+            continue;
+        if (g_strcmp0(token, "icon") == 0)
+            g_string_append_c(out, 'N');
+        else if (g_strcmp0(token, "iconify") == 0)
+            g_string_append_c(out, 'I');
+        else if (g_strcmp0(token, "max") == 0)
+            g_string_append_c(out, 'M');
+        else if (g_strcmp0(token, "close") == 0)
+            g_string_append_c(out, 'C');
+        else if (g_strcmp0(token, "shade") == 0)
+            g_string_append_c(out, 'S');
+        else if (g_strcmp0(token, "desk") == 0)
+            g_string_append_c(out, 'D');
+    }
+    g_strfreev(parts);
+
+    if (out->len == 0)
+        g_string_assign(out, "NIMC");
+
+    return g_string_free(out, FALSE);
+}
+
+static gchar* layout_to_labwc(const gchar *letters)
+{
+    const gchar *it;
+    gboolean icon = FALSE, iconify = FALSE, max = FALSE;
+    gboolean close = FALSE, shade = FALSE, desk = FALSE;
+    GString *left = g_string_new(NULL);
+    GString *right = g_string_new(NULL);
+
+    for (it = letters; it && *it; ++it)
+    {
+        switch (*it)
+        {
+        case 'N':
+            icon = TRUE;
+            break;
+        case 'I':
+            iconify = TRUE;
+            break;
+        case 'M':
+            max = TRUE;
+            break;
+        case 'C':
+            close = TRUE;
+            break;
+        case 'S':
+            shade = TRUE;
+            break;
+        case 'D':
+            desk = TRUE;
+            break;
+        default:
+            break;
+        }
+    }
+
+    if (icon)
+        g_string_append(left, "icon,");
+    if (iconify)
+        g_string_append(right, "iconify,");
+    if (max)
+        g_string_append(right, "max,");
+    if (close)
+        g_string_append(right, "close,");
+    if (shade)
+        g_string_append(right, "shade,");
+    if (desk)
+        g_string_append(right, "desk,");
+
+    if (right->len == 0)
+        g_string_assign(right, "iconify,max,close");
+    else if (right->str[right->len - 1] == ',')
+        g_string_truncate(right, right->len - 1);
+
+    if (left->len > 0 && left->str[left->len - 1] == ',')
+        g_string_truncate(left, left->len - 1);
+
+    g_string_append_c(left, ':');
+    g_string_append(left, right->str);
+    g_string_free(right, TRUE);
+    return g_string_free(left, FALSE);
+}
 
