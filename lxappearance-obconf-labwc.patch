+
+        attrs = g_strsplit(*it, ":", 0);
+        c = find_child_with_attrs(n, attrs[0], attrs);
+        g_strfreev(attrs);
+
+        if (!c) {
+            g_strfreev(nodes);
+            return NULL;
+        }
+
+        n = c;
+    }
+
+    g_strfreev(nodes);
+    return n;
+}
