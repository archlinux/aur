[Unit]
Description=Wyoming Server for OpenWakeWord
Wants=network.target

[Service]
Restart=on-failure
User=wyoming-openwakeword
Group=wyoming-openwakeword
DynamicUser=true

EnvironmentFile=/etc/conf.d/wyoming-openwakeword
ExecStart=/usr/bin/wyoming-openwakeword \
    --uri $URI \
    --threshold $THRESHOLD \
    --trigger-level $TRIGGER_LEVEL \
    $EXTRA_ARGS

[Install]
WantedBy=multi-user.target
