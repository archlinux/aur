post_install() {
    echo
    echo "Please restart your laptop to apply all changes to enable Battery Charge Limit."
    echo
    echo "In case something's wrong, please CHECK the following:"
    echo "- Check here if your Acer laptop model is listed here:"
    echo "-- https://github.com/frederik-h/acer-wmi-battery/blob/main/MODELS.md"
    echo ""
    echo "- Check & report problems here:"
    echo "-- https://github.com/frederik-h/acer-wmi-battery/issues"
    echo
    echo "Loading. Please wait in 5 seconds..."
    sleep 5
}