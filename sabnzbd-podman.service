[Unit]
Description=Convenience launch service for Sabnzd, Nzbhydra2 and Sonarr in podman
After=network.target
After=sabnzbd-podman-update.service
PartOf=sabnzbd-podman-update.service

[Service]
EnvironmentFile=/opt/podman-sabnzbd/default.env
EnvironmentFile=%h/.podman-sabnzbd.env
Environment="PUID=%U"
Environment="PGID=%G"
ExecStartPre=/bin/bash -c '\
  set -a && \
  source /opt/podman-sabnzbd/default.env && \
  source /opt/podman-sabnzbd/.env && \
  source %h/.podman-sabnzbd.env && \
  set +a && \
  envsubst < /opt/podman-sabnzbd/docker-compose.yaml > /tmp/sabnzbd-podman-compose-%U.yaml'
ExecStart=podman-compose -f /tmp/sabnzbd-podman-compose-%U.yaml up
ExecStop=podman-compose -f /tmp/sabnzbd-podman-compose-%U.yaml down

[Install]
WantedBy=default.target
