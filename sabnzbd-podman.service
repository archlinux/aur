[Unit]
Description=Convenience launch service for Sabnzd, Nzbhydra2 and Sonarr in podman
After=network.target
After=sabnzbd-podman-update.service
PartOf=sabnzbd-podman-update.service

[Service]
RuntimeDirectory=sabnzbd-podman
RuntimeDirectoryMode=0700
EnvironmentFile=/opt/podman-sabnzbd/default.env
EnvironmentFile=%h/.podman-sabnzbd.env
Environment="PUID=%U"
Environment="PGID=%G"
ExecStartPre=/bin/bash /opt/podman-sabnzbd/render-compose.sh %h/.podman-sabnzbd.env %t/sabnzbd-podman/compose.yaml
ExecStart=podman-compose -p sabnzbd-podman -f %t/sabnzbd-podman/compose.yaml up
ExecStop=podman-compose -p sabnzbd-podman -f %t/sabnzbd-podman/compose.yaml down

[Install]
WantedBy=default.target
