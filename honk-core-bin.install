pre_remove() {
  systemctl disable --now honk-core.service 2>/dev/null || true
}

post_remove() {
  # A clean stop deletes this table; a crashed honk-core leaves it behind.
  if pgrep -x honk-core >/dev/null 2>&1; then
    echo "warning: honk-core is still running outside systemd; skipped nftables cleanup."
  elif command -v nft >/dev/null 2>&1; then
    nft delete table inet honk_nfqueue 2>/dev/null || true
  fi
}

post_install() {
  echo "Review /etc/honk/config.dae, then run: systemctl enable --now honk-core"
}
