post_install() {
  cat <<'EOF'
honk-core requires Linux 6.12+ with BPF/BTF and cgroup v2. eBPF maps are
pinned on bpffs, so mount it first if it is not persistent across boots:

    sudo mount -t bpf bpf /sys/fs/bpf

Review /etc/honk/config.dae, then start (or enable) the service:

    sudo systemctl enable --now honk-core
EOF
}

post_upgrade() {
  post_install
}
