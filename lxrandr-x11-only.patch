+        gtk_combo_box_set_active(GTK_COMBO_BOX(m->rate_combo), m->try_rate);
+        if (m->pos_combo)
+            gtk_combo_box_set_active(GTK_COMBO_BOX(m->pos_combo), m->try_placement);
+#else
+        gtk_combo_box_set_active(m->res_combo, m->try_mode);
+        gtk_combo_box_set_active(m->rate_combo, m->try_rate);
+        if (m->pos_combo)
+            gtk_combo_box_set_active(m->pos_combo, m->try_placement);
+#endif
+        if (use_wlr_randr)
+        {
+            if (m->scale_spin)
+                gtk_spin_button_set_value(GTK_SPIN_BUTTON(m->scale_spin), m->try_scale);
+            if (m->pos_x_spin)
+                gtk_spin_button_set_value(GTK_SPIN_BUTTON(m->pos_x_spin), (gdouble)m->try_pos_x);
+            if (m->pos_y_spin)
+                gtk_spin_button_set_value(GTK_SPIN_BUTTON(m->pos_y_spin), (gdouble)m->try_pos_y);
+            if (m->transform_combo)
+                gtk_combo_box_set_active(GTK_COMBO_BOX(m->transform_combo), m->try_transform);
+        }
+    }
+}
