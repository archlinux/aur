+static void restore_GUI_from_try_values()
+{
+    GSList *l;
+
+    for (l = monitors; l; l = l->next)
+    {
+        Monitor *m = (Monitor*)l->data;
+
+        gtk_toggle_button_set_active(GTK_TOGGLE_BUTTON(m->enable), m->try_mode >= 0);
