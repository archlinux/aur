+static gboolean get_wlr_randr_info()
+{
+    gchar **lines, **line;
+    char* output = NULL;
+    int status;
+    Monitor* m = NULL;
+    int imode = 0;
+    gboolean in_modes = FALSE;
+
+    if (!g_spawn_command_line_sync("wlr-randr", &output, NULL, &status, NULL) || status)
+    {
+        g_free(output);
+        return FALSE;
+    }
+
+    lines = g_strsplit(output, "\n", -1);
+    for (line = lines; *line; ++line)
+    {
+        GRegex* regex;
+        GMatchInfo* match = NULL;
+
+        if (!**line)
+            continue;
+
+        regex = g_regex_new("^([-.a-zA-Z]+[-.0-9]*) +\"([^\"]*)\"", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            gchar* model;
+
+            m = g_new0(Monitor, 1);
+            m->scale = 1.0;
+            m->try_scale = 1.0;
+            m->active_mode = m->active_rate = -1;
+            m->pref_mode = m->pref_rate = -1;
+            m->placement = PLACEMENT_DEFAULT;
+            m->name = g_match_info_fetch(match, 1);
+            model = g_match_info_fetch(match, 2);
+            m->display_name = model && *model ? g_strdup(model) : NULL;
+            g_free(model);
+
+            if (!LVDS && (g_str_has_prefix(m->name, "eDP") ||
+                          g_str_has_prefix(m->name, "LVDS") ||
+                          g_str_has_prefix(m->name, "PANEL")))
+                LVDS = m;
+
+            monitors = g_slist_append(monitors, m);
+            imode = 0;
+            in_modes = FALSE;
+
+            g_match_info_free(match);
+            g_regex_unref(regex);
+            continue;
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+
+        if (!m)
+            continue;
+
+        regex = g_regex_new("^  Enabled: +(yes|no)$", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            gchar* enabled = g_match_info_fetch(match, 1);
+            if (g_strcmp0(enabled, "yes") != 0)
+            {
+                m->active_mode = -1;
+                m->active_rate = -1;
+            }
+            g_free(enabled);
+            in_modes = FALSE;
+            g_match_info_free(match);
+            g_regex_unref(regex);
+            continue;
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+
+        if (g_strcmp0(*line, "  Modes:") == 0)
+        {
+            in_modes = TRUE;
+            continue;
+        }
+
+        regex = g_regex_new("^  Position: +(-?[0-9]+),(-?[0-9]+)$", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            gchar* sx = g_match_info_fetch(match, 1);
+            gchar* sy = g_match_info_fetch(match, 2);
+            int x = (int)g_ascii_strtoll(sx, NULL, 10);
+            int y = (int)g_ascii_strtoll(sy, NULL, 10);
+
+            if (x < 0 || y < 0 || (x == 0 && y == 0))
+                m->placement = PLACEMENT_DEFAULT;
+            else if (x == 0)
+                m->placement = PLACEMENT_BELOW;
+            else if (y == 0)
+                m->placement = PLACEMENT_RIGHT;
+
+            m->pos_x = x;
+            m->pos_y = y;
+
+            g_free(sx);
+            g_free(sy);
+            in_modes = FALSE;
+            g_match_info_free(match);
+            g_regex_unref(regex);
+            continue;
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+
+        regex = g_regex_new("^  Scale: +([0-9.]+)$", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            gchar* s = g_match_info_fetch(match, 1);
+            m->scale = g_ascii_strtod(s, NULL);
+            if (m->scale <= 0.0)
+                m->scale = 1.0;  /* guard against malformed output */
+            g_free(s);
+            in_modes = FALSE;
+            g_match_info_free(match);
+            g_regex_unref(regex);
+            continue;
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+
+        regex = g_regex_new("^  Transform: +(normal|90|180|270)$", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            static const char* const transform_tokens[] = { "normal", "90", "180", "270" };
+            gchar* t = g_match_info_fetch(match, 1);
+            int i;
+            for (i = 0; i < 4; i++)
+            {
+                if (g_strcmp0(t, transform_tokens[i]) == 0)
+                {
+                    m->transform = i;
+                    break;
+                }
+            }
+            g_free(t);
+            in_modes = FALSE;
+            g_match_info_free(match);
+            g_regex_unref(regex);
+            continue;
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+
+        if (!in_modes)
+            continue;
+
+        regex = g_regex_new("^    ([0-9]+x[0-9]+) px(?:, +([0-9.]+) Hz)?(?: +\\(([^)]*)\\))?$", 0, 0, NULL);
+        if (g_regex_match(regex, *line, 0, &match))
+        {
+            gchar* resolution = g_match_info_fetch(match, 1);
+            gchar* rate = g_match_info_fetch(match, 2);
+            gchar* flags = g_match_info_fetch(match, 3);
+            char** strv = g_new0(char*, 3);
+
+            strv[0] = g_strdup(resolution);
+            strv[1] = rate && *rate ? g_strdup(rate) : g_strdup("0");
+
+            m->mode_lines = g_slist_append(m->mode_lines, strv);
+
+            if (flags && g_strstr_len(flags, -1, "preferred"))
+            {
+                m->pref_mode = imode;
+                m->pref_rate = 0;
+            }
+            if (flags && g_strstr_len(flags, -1, "current"))
+            {
+                m->active_mode = imode;
+                m->active_rate = 0;
+            }
+
+            imode++;
+
+            g_free(resolution);
+            g_free(rate);
+            g_free(flags);
+        }
+        g_match_info_free(match);
+        g_regex_unref(regex);
+    }
+
+    g_strfreev(lines);
+    g_free(output);
+
+    return monitors != NULL;
+}
