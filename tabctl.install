post_install() {
    echo "==> Register the native-messaging host for your browsers (as your user):"
    echo "==>   tabctl install"
    echo "==> "
    echo "==> Then install the browser extension from its store and restart the browser:"
    echo "==>   Firefox / Zen:  https://addons.mozilla.org/en-US/firefox/addon/tabctl1/"
    echo "==>   Chrome / Chromium / Brave / Helium:"
    echo "==>     https://chromewebstore.google.com/detail/tabctl/baomblllgemcgbignhpbipgiofmjdhpn"
}

post_upgrade() {
    echo "==> Restart your browsers so they launch the upgraded tabctl-mediator."
    echo "==> 'tabctl status' reports the running mediator and extension versions."
}

post_remove() {
    echo "==> Native-messaging manifests are per user and are left in place."
    echo "==> Run 'tabctl uninstall' before removing next time, or delete them with:"
    echo "==>   find ~/.mozilla ~/.zen ~/.config -name tabctl_mediator.json -delete"
}
