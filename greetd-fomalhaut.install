post_install() {
  cat <<'EOF'
:: Fomalhaut is a greeter for greetd; it does not switch display managers automatically.
   1. Review and merge the example configuration:
      /usr/share/doc/greetd-fomalhaut/greetd-config.toml
      into /etc/greetd/config.toml.
   2. Disable your existing display manager, then enable greetd:
      sudo systemctl disable <existing-display-manager>.service
      sudo systemctl enable greetd.service
   3. Reboot, or start greetd only after it is safe to end the current graphical session.
   Do not enable greetd and another display manager at the same time.
EOF
}

post_upgrade() {
  post_install
}
