    "id": "linux-package-metadata",
    "language": "Json",
    "files": ["package.json"],
    "metadata": {"expectedMatches": "1"},
    "rule": {
      "kind": "object",
      "all": [
        {"has": {"pattern": {"context": "{\"name\": \"$NAME\"}", "selector": "pair"}, "stopBy": "end"}},
        {"has": {"pattern": {"context": "{\"version\": \"$VERSION\"}", "selector": "pair"}, "stopBy": "end"}},
        {"has": {"pattern": {"context": "{\"main\": \"$MAIN\"}", "selector": "pair"}, "stopBy": "end"}},
        {"has": {"pattern": {"context": "{\"author\": \"$AUTHOR\"}", "selector": "pair"}, "stopBy": "end"}},
        {"has": {"pattern": {"context": "{\"license\": \"$LICENSE\"}", "selector": "pair"}, "stopBy": "end"}}
      ]
    },
    "fix": "{\n  \"name\": \"$NAME\",\n  \"version\": \"$VERSION\",\n  \"description\": \"Google Gemini desktop client with Linux integration\",\n  \"main\": \"$MAIN\",\n  \"private\": true,\n  \"author\": \"$AUTHOR\",\n  \"license\": \"$LICENSE\",\n  \"desktopName\": \"com.google.Gemini.desktop\",\n  \"productName\": \"Gemini\"\n}"
  },
