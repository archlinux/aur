[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = rtl8852cu-9m2pju-dkms-git

[Action]
Description = Showing rtl8852cu-9m2pju-dkms-git install message...
When = PostTransaction
Exec = /bin/sh -c 'echo ":: The rtl8852cu kernel module (9M2PJU DKMS git) has been installed."; echo ":: Reboot or replug your USB WiFi adapter to load the driver."; echo ":: 73 from 9M2PJU, https://hamradio.my"'
