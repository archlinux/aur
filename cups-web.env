## CUPS host and port.
CUPS_HOST="localhost:631"

## CUPS administrator username and password.
## Please set a password for the 'cups-web' user to access CUPS administration features: passwd cups-web
## Note: This user must have the necessary permissions to manage printers and jobs in CUPS.
## Note: You can modify the 'SystemGroup' line in '/etc/cups/cups-files.conf' and add 'cups-web' at the end of the line, such as: SystemGroup sys root wheel cups-web
CUPSADMIN="cups-web"
CUPSPASSWORD="password for cups-web user"

## Listen address for cups-web.
LISTEN_ADDR=":8080"
