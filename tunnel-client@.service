[Unit]
Description=OpenAI tunnel client (%i)
Documentation=https://github.com/openai/tunnel-client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=-/etc/tunnel-client/%i.env
ExecStart=/usr/bin/tunnel-client run --profile-file /etc/tunnel-client/%i.yaml
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
UMask=0077
CapabilityBoundingSet=
LockPersonality=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictRealtime=yes
# This keeps the service on the native syscall ABI. If you ever need a 32-bit
# MCP server, clear it in a systemd override with: SystemCallArchitectures=
SystemCallArchitectures=native
StateDirectory=tunnel-client
WorkingDirectory=/var/lib/tunnel-client

[Install]
WantedBy=multi-user.target
