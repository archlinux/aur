From 6a82977d0726c7027597eb80bce3d752acc76534 Mon Sep 17 00:00:00 2001
From: Claudia Pellegrino <claui@users.noreply.github.com>
Date: Thu, 2 Oct 2025 20:16:57 +0200
Subject: [PATCH 1/4] Work around missing `assertNotEmpty` method

---
 tests/test_collections.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/tests/test_collections.py b/tests/test_collections.py
index e721c0b..cae5a72 100644
--- a/tests/test_collections.py
+++ b/tests/test_collections.py
@@ -26,8 +26,8 @@ class Iterable(MatcherTestCase):
     def test_some_generator(self):
         gen = (x for x in [1, 2, 5])
         self.assert_match(gen)
-        self.assertNotEmpty(
-            gen, msg="matcher shouldn't have iterated over the generator")
+        self.assertEqual(
+            next(gen), 1, msg="matcher shouldn't have iterated over the generator")
 
     test_some_object = lambda self: self.assert_no_match(object())
 
@@ -59,8 +59,8 @@ class Generator(MatcherTestCase):
     def test_some_generator(self):
         gen = (x for x in [1, 2, 5])
         self.assert_match(gen)
-        self.assertNotEmpty(
-            gen, msg="matcher shouldn't have iterated over the generator")
+        self.assertEqual(
+            next(gen), 1, msg="matcher shouldn't have iterated over the generator")
 
     test_some_object = lambda self: self.assert_no_match(object())
 
-- 
2.51.0


From e2d1363e55f80e421e89e7ad5d0cdb6f7afc369a Mon Sep 17 00:00:00 2001
From: Claudia Pellegrino <claui@users.noreply.github.com>
Date: Thu, 2 Oct 2025 20:17:39 +0200
Subject: [PATCH 2/4] Fix errors in portable `getargspec` shim

- Fix call site that was meant to invoke the shim

- Fix erroneous usage of `Signature` object
---
 callee/_compat.py | 2 +-
 callee/base.py    | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/callee/_compat.py b/callee/_compat.py
index 2bd1711..2dc321f 100644
--- a/callee/_compat.py
+++ b/callee/_compat.py
@@ -98,7 +98,7 @@ def getargspec(obj):
     argnames = []
     varargname, kwargname = None, None
     defaults = []
-    for name, param in inspect.signature(obj):
+    for name, param in inspect.signature(obj).parameters.items():
         if param.kind == inspect.Parameter.VAR_POSITIONAL:
             varargname = name
         elif param.kind == inspect.Parameter.VAR_KEYWORD:
diff --git a/callee/base.py b/callee/base.py
index 523e3f9..701a8ce 100644
--- a/callee/base.py
+++ b/callee/base.py
@@ -4,7 +4,7 @@ Base classes for argument matchers.
 import inspect
 from operator import itemgetter
 
-from callee._compat import IS_PY3, metaclass
+from callee._compat import getargspec, IS_PY3, metaclass
 
 
 __all__ = [
@@ -158,7 +158,7 @@ class Matcher(BaseMatcher):
         # check if the matcher class has a parametrized constructor
         has_argful_ctor = False
         if '__init__' in self.__class__.__dict__:
-            argnames, vargargs, kwargs, _ = inspect.getargspec(
+            argnames, vargargs, kwargs, _ = getargspec(
                 self.__class__.__init__)
             has_argful_ctor = bool(argnames[1:] or vargargs or kwargs)
 
-- 
2.51.0


