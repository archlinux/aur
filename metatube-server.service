[Unit]
Description = MetaTube Server
After = network.target

[Service]
Restart = on-failure
User = metatube-server
Environment = HOME=/var/lib/metatube-server
EnvironmentFile = -/etc/conf.d/metatube-server.env
WorkingDirectory = /var/lib/metatube-server
ExecStart = /usr/bin/metatube-server

[Install]
WantedBy = multi-user.target
