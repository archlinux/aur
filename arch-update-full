# MÓDULO DE VERIFICAÇÃO DE CONECTIVIDADE // CONNECTIVITY VERIFICATION MODULE
VERIFICAR_CONECTIVIDADE() {
    
    local TEXTO_NET=" ESTABLISHING UPLINK: CHECKING SECTOR NETWORK"
    local TAM_TEXTO=${#TEXTO_NET}
    local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))
    local MIRROR_ALVO
    local TARGET_1
    local TARGET_2="archlinux.org"
    local PING_RES
    local LATENCY

    echo -e "${NEON_BLUE}(LANG: PT-BR) Verificando conectividade de rede...${NC}"
    echo -e "${NEON_BLUE}(LANG: EN-US) Checking network connectivity...${NC}"
    echo ""
   
    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${YELLOW_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_NET" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
    
    echo ""
    echo "(LANG: PT-BR): Isso pode levar alguns segundos dependendo da sua conexão. Por favor, aguarde..."
    echo "(LANG: EN-US): This may take a few seconds depending on your connection. Please wait..."
    echo ""

    # Extrai o primeiro mirror ativo da lista do usuário // Extracts the first active mirror from the user's list
    MIRROR_ALVO=$(sed -n '/^[[:space:]]*Server[[:space:]]*=/ { s|.*https?://\([^/:]*\).*|\1|p; q }' /etc/pacman.d/mirrorlist)
    TARGET_1=${MIRROR_ALVO:-"archlinux.org"} # Se a lista estiver vazia por algum bug, assume o oficial // If the list is empty due to some bug, defaults to the official site

    # TENTATIVA 1: Testa a rota do Mirror local // ATTEMPT 1: Tests the route of the local Mirror
    if PING_RES=$(ping -c 3 -W 13 "$TARGET_1" 2>/dev/null); then
        LATENCY=$(echo "$PING_RES" | awk -F'/' '/^rtt/ {print $5}')
        LATENCY=${LATENCY:-0.00}
        
        echo -e "${GREEN_NEON}(LANG: PT-BR): [SUCESSO] CONEXÃO OK (Mirror) | LATÊNCIA: ${LATENCY}ms${NC}"
        echo -e "${GREEN_NEON}(LANG: EN-US): [SUCCESS] CONNECTION OK (Mirror) | LATENCY: ${LATENCY}ms${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"

    # TENTATIVA 2: Se o Mirror falhar, tenta o site oficial do Arch // ATTEMPT 2: If the Mirror fails, tries the official Arch site
    elif PING_RES=$(ping -c 3 -W 13 "$TARGET_2" 2>/dev/null); then
        LATENCY=$(echo "$PING_RES" | awk -F'/' '/^rtt/ {print $5}')
        LATENCY=${LATENCY:-0.00}
        
        echo -e "${GREEN_NEON}(LANG: PT-BR): [SUCESSO] CONEXÃO OK (Arch.org) | LATÊNCIA: ${LATENCY}ms${NC}"
        echo -e "${GREEN_NEON}(LANG: EN-US): [SUCCESS] CONNECTION OK (Arch.org) | LATENCY: ${LATENCY}ms${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"

    # FALHA TOTAL: Sem internet ou rotas caídas // TOTAL FAILURE: No internet or down routes
    else
        echo -e "${RED_NEON}(LANG: PT-BR): [ERRO] SEM CONEXÃO COM A INTERNET${NC}"
        echo -e "${RED_NEON}(LANG: EN-US): [ERROR] NO INTERNET CONNECTION${NC}"
        echo ""
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [!] Nenhuma conexão com a internet disponível, protocolo abortado.${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [!] Sentinel Protocol aborted. Please check your network connection.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        exit 1
    fi
}


# fazer checa de espaço em disco antes de iniciar a atualização // check disk space before starting the update
BOX_ERROR() {

    local TEXTO="$1"

    local LARGURA=${LARGURA_BOX:-86} 
    local INTERNO=$((LARGURA - 4))
    
    echo -e "\n${RED_NEON}╔$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╗${NC}"
    
    
    echo "$TEXTO" | fold -s -w "$INTERNO" | while IFS= read -r LINHA; do
        printf "${RED_NEON}║${NC} ${RED_NEON}%-${INTERNO}s${NC} ${RED_NEON}║${NC}\n" "$LINHA"
    done
    
    echo -e "${RED_NEON}╚$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╝${NC}"
}

CHECK_DISK_SPACE() {

    local TEXTO_DISK=" ANALYZING STORAGE: CHECKING DISK INTEGRITY RESERVE"
    local TAM_TEXTO=${#TEXTO_DISK}
    local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))
    local FREE_SPACE
    local MENSAGEM_ERRO

    echo -e "${NEON_BLUE}(LANG: PT-BR) Verificando espaço em disco disponível...${NC}"
    echo -e "${NEON_BLUE}(LANG: EN-US) Checking available disk space...${NC}"
    echo ""

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_DISK" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
    
    echo ""
    echo "(LANG: PT-BR): Analisando partições e espaço de segurança..."
    echo "(LANG: EN-US): Analyzing partitions and safety space..."
    echo ""
    sleep 0.7
    # Captura espaço livre na raiz (/) // Captures free space in root (/)
    FREE_SPACE=$(df -BG / | awk 'NR==2 {print $4}' | sed 's/G//')
    
    if [ "$FREE_SPACE" -lt 5 ]; then
        
        MENSAGEM_ERRO="[FATAL ERROR] Insufficient space (${FREE_SPACE}GB). Aborting to prevent corruption. Sentinel Protocol requires at least 5GB free. | [ERRO FATAL] pt-br: (${FREE_SPACE}GB) O Protocolo exige pelo menos 5GB livres. Libere espaço e tente novamente."
        
        BOX_ERROR "$MENSAGEM_ERRO"
        
        # Proteção caso a variável do LOG ainda não esteja inicializada // Protection in case the LOG variable is not yet initialized
        if [[ -n "$LOG_ATUAL" ]]; then
            echo "[LOG] Aborting due to insufficient space (${FREE_SPACE}GB) on $(date)" >> "$LOG_ATUAL"   
        fi
        
        echo -e "${YELLOW_NEON}--------------------------------------------------------------------------------------${NC}"
        exit 1
    else
        echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Reserva de disco confirmada: ${FREE_SPACE}GB disponíveis.${NC}"
        echo -e "${GREEN_NEON}(LANG: EN-US): [OK] Disk reserve confirmed: ${FREE_SPACE}GB available.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    fi
}


# MÓDULO DE NOTÍCIAS OFICIAIS DO ARCH LINUX // ARCH LINUX NEWS MODULE
EXIBIR_NOTICIAS_ARCH() {

    echo -e "${NEON_BLUE}(LANG: PT-BR) Gostaria de verificar a última notícia oficial do Arch (Arch News)?${NC}"
    echo -e "${NEON_BLUE}(LANG: EN-US) Would you like to check the latest official Arch news (Arch News)?${NC}"
    echo ""

    TEXTO_NEWS=" CHECKING ARCH LINUX OFFICIAL NEWS"
    TAM_TEXTO=${#TEXTO_NEWS}
    ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_NEWS" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
    
    echo ""
    echo "(LANG: PT-BR): Recomendado para verificar intervenções manuais em atualizações."
    echo "(LANG: EN-US): Recommended to check for manual interventions during updates."
    echo ""

    echo "(LANG: PT-BR) Exibir notícia? (S/N):"
    read -rp "(LANG: EN-US) Show news? (Y/N): " OPCAO_NOTICIA
    echo ""
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""

    if [[ "$OPCAO_NOTICIA" =~ ^[SsYy]$ ]]; then
        echo -e "${YELLOW_NEON}(LANG: PT-BR): Buscando feed oficial de archlinux.org...${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): Fetching official feed from archlinux.org...${NC}"
        echo ""
        echo "(LANG: PT-BR): Isso pode levar alguns segundos dependendo da sua conexão. Por favor, aguarde..."
        echo "(LANG: EN-US): This may take a few seconds depending on your connection. Please wait..."
        echo ""

        FEED_RAW=$(curl -s --max-time 7 https://archlinux.org/feeds/news/)

        if [ -z "$FEED_RAW" ]; then
            echo -e "${RED_NEON}(LANG: PT-BR): [ERRO] Não foi possível conectar ao servidor.${NC}"
            echo -e "${RED_NEON}(LANG: EN-US): [ERROR] Could not connect to the server.${NC}"
            echo ""
            echo -e "${YELLOW_NEON}(LANG: PT-BR): [WARN] Continuando para a verificação do sistema...${NC}"
            echo -e "${YELLOW_NEON}(LANG: EN-US): [WARN] Continuing to system check...${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            echo ""
            return 0
        fi

    
        FORMATTED_FEED="${FEED_RAW//>/\>}"
        
        NEWS_TITLE=$(echo "$FORMATTED_FEED" | awk '/<item>/{f=1} f && /<title>/{print; exit}' | sed -e 's/<[^>]*>//g' -e 's/^[ \t]*//' -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g')
        NEWS_DATE=$(echo "$FORMATTED_FEED" | awk '/<item>/{f=1} f && /<pubDate>/{print; exit}' | sed -e 's/<[^>]*>//g' -e 's/^[ \t]*//' | cut -d' ' -f1-4)
        NEWS_LINK=$(echo "$FORMATTED_FEED" | awk '/<item>/{f=1} f && /<link>/{print; exit}' | sed -e 's/<[^>]*>//g' -e 's/^[ \t]*//')

        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo -e "${PINK_NEON}[ARCH LINUX NEWS] - Data: ${WHITE_NEON}$NEWS_DATE${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        
        echo -e "${WHITE_NEON}$NEWS_TITLE${NC}"
        
        echo ""
        echo -e "${YELLOW_NEON}Link: ${WHITE_NEON}$NEWS_LINK${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""

        echo -e "${YELLOW_NEON}(LANG: PT-BR) Gostaria de prosseguir com a atualização do sistema?${NC}"
        
        TEXTO_PROCEED=" PROCEED WITH SYSTEM UPDATE?"
        TAM_PROCEED=${#TEXTO_PROCEED}
        ESPACOS_PROCEED=$((LARGURA_BOX - TAM_PROCEED - 2))

        echo -e "${YELLOW_NEON}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
        printf "${YELLOW_NEON}║${NC}${RED_NEON}%s%*s${NC}${YELLOW_NEON}║${NC}\n" "$TEXTO_PROCEED" "$ESPACOS_PROCEED" ""
        echo -e "${YELLOW_NEON}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
        
        echo "(LANG: PT-BR) Atualizar agora? (S/N):"
        read -rp "(LANG: EN-US) Update now? (Y/N): " RESPOSTA_UPDATE
        echo ""

        if [[ "$RESPOSTA_UPDATE" =~ ^[Nn]$ ]]; then
            echo -e "${RED_NEON}(LANG: PT-BR): [CANCELADO] Atualização interrompida pelo operador.${NC}"
            echo -e "${RED_NEON}(LANG: EN-US): [CANCELLED] Update aborted by operator.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            exit 0
            
        fi
        
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [OK] Confirmado. Iniciando sincronização de pacotes...${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [OK] Confirmed. Starting package synchronization...${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        
    else
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [SKIPPED] Leitura de notícias ignorada pelo usuário.${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [SKIPPED] News reading skipped by user.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
       
    fi
}

#OTIMIZAÇÃO DE ESPELHOS (MIRRORS) // MIRRORS OPTIMIZATION ------------------------------------------------------------------------------<<<
OTIMIZAR_ESPELHOS() {
    # Verifica primeiro se o reflector está instalado // First, check if reflector is installed
    if command -v reflector &> /dev/null; then
        echo -e "${NEON_BLUE}(LANG: PT-BR) Gostaria de otimizar os espelhos de rede (Reflector)?${NC}"
        echo -e "${NEON_BLUE}(LANG: EN-US) Would you like to optimize the network mirrors (Reflector)?${NC}" 
        echo ""

        TEXTO_REFLECTOR=" OPTIMIZING NETWORK MIRRORS"
        TAM_TEXTO=${#TEXTO_REFLECTOR}
        ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

        echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
        printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_REFLECTOR" "$ESPACOS" ""
        echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
        
        echo ""
        echo "(LANG: PT-BR): Busca os 7 espelhos mais rápidos. Pode demorar alguns segundos/minutos."
        echo "(LANG: EN-US): Searches for the 7 fastest mirrors. May take a few seconds/minutes."
        echo ""

        
        echo "(LANG: PT-BR) Iniciar otimização de rede? (S/N):"
        read -rp "(LANG: EN-US) Start network optimization? (Y/N):" OPCAO_REFLECTOR
        echo ""

        
        case "$OPCAO_REFLECTOR" in
            [SsYy]* )
                echo -e "${YELLOW_NEON}(LANG: PT-BR): [BUSCANDO] Selecionando e salvando os 7 espelhos HTTPS mais rápidos...${NC}"
                echo -e "${YELLOW_NEON}(LANG: EN-US): [SEARCHING] Selecting and saving the 7 fastest HTTPS mirrors...${NC}"
                echo ""
                echo "(LANG: PT-BR): Isso pode levar alguns segundos/ minutos dependendo da sua conexão. Por favor, aguarde..."
                echo "(LANG: EN-US): This may take a few seconds/minutes depending on your connection. Please wait..."
                echo ""

                # Comando otimizado: Pega os 20 mais atualizados, testa e salva os 7 mais rápidos // Optimized command: Takes the 20 most updated, tests and saves the 7 fastest
                sudo reflector --protocol https --latest 20 --fastest 7 --sort rate --save /etc/pacman.d/mirrorlist
                
                echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Otimização concluída com sucesso!${NC}"
                echo -e "${GREEN_NEON}(LANG: EN-US): [OK] Optimization completed successfully!${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                ;;
            
            [Nn]* | * )
                echo -e "${YELLOW_NEON}(LANG: PT-BR): [SKIPPED] Otimização de rede pulada pelo usuário.${NC}"
                echo -e "${YELLOW_NEON}(LANG: EN-US): [SKIPPED] Network optimization skipped by user.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                ;;
        esac

    else
        #Retorno visual caso a pessoa não tenha o reflector instalado // Visual return if the person does not have reflector installed
        echo -e "${NEON_BLUE}(LANG: PT-BR) Otimização de espelhos de rede indisponível.${NC}"
        
        TEXTO_REFLECTOR=" NETWORK MIRROR OPTIMIZATION"
        TAM_TEXTO=${#TEXTO_REFLECTOR}
        ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

        echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
        printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_REFLECTOR" "$ESPACOS" ""
        echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

        echo ""
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [WARNING] Reflector não detectado. Pulando setor de otimização.${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [WARNING] Reflector not detected. Skipping network optimization sector.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
    fi
}

#REPOSITÓRIOS OFICIAIS (PACMAN) // OFFICIAL REPOSITORIES (PACMAN) -----------------------------------------------------------------------------<<<

SINCRONIZAR_PACMAN() {

    local TEXTO_PACMAN=" CORE SYSTEM SYNCHRONIZATION (PACMAN-UPDATES)"
    local TAM_TEXTO=${#TEXTO_PACMAN}
    local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

   
    echo -e "${NEON_BLUE}(LANG: PT-BR) Sincronizando repositórios oficiais (Pacman)...${NC}"
    echo -e "${NEON_BLUE}(LANG: EN-US) Synchronizing official repositories (Pacman)...${NC}"
    echo ""

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${YELLOW_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_PACMAN" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    echo ""
    echo -e "${RED_NEON}(LANG: PT-BR): [INTERAÇÃO NECESSÁRIA] Confirme as atualizações e resolva dependências quando solicitado.${NC}"
    echo -e "${RED_NEON}(LANG: EN-US): [USER INTERACTION REQUIRED] Confirm updates and resolve dependencies when prompted.${NC}"
    echo ""
    sleep 1.5

    # TENTATIVA 1: Atualização padrão (-Syu) // ATTEMPT 1: Standard update (-Syu)
    if sudo pacman -Syu; then
        echo ""
        echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Sincronização concluída com sucesso.${NC}"
        echo -e "${GREEN_NEON}(LANG: EN-US): [OK] Synchronization completed successfully.${NC}"
    else
        # TENTATIVA forçando a base de dados (-Syyu) em caso de espelho dessincronizado // ATTEMPT forcing the database (-Syyu) in case of unsynchronized mirror
        echo ""
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [!] Falha na sincronização padrão. Tentando forçar atualização (Syyu)...${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [!] Standard sync failed. Attempting forced refresh (Syyu)...${NC}"
        sleep 1
        
        if sudo pacman -Syyu; then
            echo ""
            echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Sincronização concluída via atualização forçada.${NC}"
            echo -e "${GREEN_NEON}(LANG: EN-US): [OK] Synchronization completed via forced refresh.${NC}"
        else
            # FALHA TOTAL // TOTAL FAILURE
            echo ""
            echo -e "${RED_NEON}(LANG: PT-BR): [ERRO FATAL] Falha na sincronização do sistema mesmo com forçamento.${NC}"
            echo -e "${RED_NEON}(LANG: EN-US): [FATAL ERROR] System synchronization failed even with forced refresh.${NC}"
            
            # Proteção para garantir que o script não quebre caso a variável não exista // Protection to ensure the script doesn't break if the variable doesn't exist
            if [[ -n "$LOG_ATUAL" ]]; then
                echo "[LOG] Critical sync failure on $(date)" >> "$LOG_ATUAL"
            fi
            
            echo -e "${CYAN_NEON}--------------------------------------------------------------------------------------${NC}"
            exit 1
        fi
    fi
    
    echo -e "${CYAN_NEON}--------------------------------------------------------------------------------------${NC}"
}

#ATUALIZAÇÃO DO AUR (DETECÇÃO INTELIGENTE)// AUR (Smart Detection) Update --------------------------------------------------------------------<<<
ATUALIZAR_AUR() {

    local YAY_INSTALLED PARU_INSTALLED PIKAUR_INSTALLED
    YAY_INSTALLED=$(command -v yay)
    PARU_INSTALLED=$(command -v paru)
    PIKAUR_INSTALLED=$(command -v pikaur)
    
    local INSTALLED_HELPERS=()
    local AUR_HELPER=""
    local AUR_CHOICE=""
    local AUR_MODE=""

    
    echo -e "${NEON_BLUE}(LANG: PT-BR) Detectando e configurando helpers do AUR...${NC}"
    echo -e "${NEON_BLUE}(LANG: EN-US) Detecting and configuring AUR helpers...${NC}"
    echo ""

    
    local TEXTO_AUR=" AUR_SUBSYSTEM_DETECTION: SCANNING FOR HELPERS"
    local TAM_TEXTO=${#TEXTO_AUR}
    local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_AUR" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    # Mapeia helpers instalados // Maps installed helpers
    [[ -n "$YAY_INSTALLED" ]] && INSTALLED_HELPERS+=("yay")
    [[ -n "$PARU_INSTALLED" ]] && INSTALLED_HELPERS+=("paru")
    [[ -n "$PIKAUR_INSTALLED" ]] && INSTALLED_HELPERS+=("pikaur")

    local TOTAL_HELPERS=${#INSTALLED_HELPERS[@]}

    # Decisão baseada na quantidade de helpers encontrados // Decision based on the number of helpers found
    if [ "$TOTAL_HELPERS" -eq 0 ]; then
        echo ""
        echo -e "${YELLOW_NEON}(LANG: PT-BR): [!] Nenhum helper AUR (yay, paru, pikaur) detectado. Pulando setor de atualização do AUR.${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): [!] No AUR helper (yay, paru, pikaur) detected. Skipping AUR update sector.${NC}"
        echo -e "${CYAN_NEON}--------------------------------------------------------------------------------------${NC}"
        return 0
    elif [ "$TOTAL_HELPERS" -eq 1 ]; then
        AUR_HELPER="${INSTALLED_HELPERS[0]}"
        echo ""
        echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Helper AUR detectado: ${AUR_HELPER^^}${NC}"
        echo -e "${GREEN_NEON}(LANG: EN-US): [OK] AUR helper detected: ${AUR_HELPER^^}${NC}"
    else
        # Múltiplos helpers detectados - Menu Dinâmico // Multiple helpers detected - Dynamic Menu
        echo ""
        echo -e "${YELLOW_NEON}(LANG: PT-BR): Detectamos múltiplos helpers do AUR (${TOTAL_HELPERS} encontrados).${NC}"
        echo -e "${YELLOW_NEON}(LANG: EN-US): Multiple AUR helpers detected (${TOTAL_HELPERS} found).${NC}"
        echo ""
        echo -e "${NEON_BLUE}(LANG: PT-BR): Qual você deseja utilizar para esta sessão?${NC}"
        echo -e "${NEON_BLUE}(LANG: EN-US): Which one do you want to use for this session?${NC}"
        echo ""

        for i in "${!INSTALLED_HELPERS[@]}"; do
            echo -e "  ${PINK_NEON}($((i+1)))${NC} ${INSTALLED_HELPERS[$i]^^}"
        done
        echo ""

        read -rn 1 -p "  [ESCOLHA / CHOICE 1-$TOTAL_HELPERS]: " AUR_CHOICE
        echo ""

        if [[ "$AUR_CHOICE" =~ ^[1-9]$ ]] && [ "$AUR_CHOICE" -le "$TOTAL_HELPERS" ]; then
            AUR_HELPER="${INSTALLED_HELPERS[$((AUR_CHOICE-1))]}"
        else
            AUR_HELPER="${INSTALLED_HELPERS[0]}"
            echo -e "${YELLOW_NEON}(LANG: PT-BR): [!] Opção inválida. Usando ${AUR_HELPER^^} por padrão.${NC}"
            echo -e "${YELLOW_NEON}(LANG: EN-US): [!] Invalid selection. Defaulting to ${AUR_HELPER^^}.${NC}"
        fi
    fi

    echo ""
    local TEXTO_EXEC=" INJECTING AUR DATA STREAMS: UPDATING VIA ${AUR_HELPER^^}"
    local TAM_EXEC=${#TEXTO_EXEC}
    local ESPACOS_EXEC=$((LARGURA_BOX - TAM_EXEC - 2))

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_EXEC" "$ESPACOS_EXEC" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    # Menu de seleção de modo
    echo -e "${CYAN_NEON}--------------------------------------------------------------------------------------${NC}"
    echo -e "${YELLOW_NEON}(LANG: PT-BR): SELECIONE O MODO DE ATUALIZAÇÃO DO AUR:${NC}"
    echo -e "${YELLOW_NEON}(LANG: EN-US): SELECT AUR UPDATE MODE:${NC}"
    echo ""
    echo -e "  ${PINK_NEON}(1)${NC} Automático / Automatic (--noconfirm, pula leitura de PKGBUILDs // skips reading PKGBUILDs)"
    echo -e "  ${PINK_NEON}(2)${NC} Manual / Interactive (Interativo, permite ler PKGBUILDs e revisar // Allows reading PKGBUILDs and reviewing)"
    echo ""
    read -rn 1 -p "  [ESCOLHA / CHOICE]: " AUR_MODE
    echo -e "\n"

        case "$AUR_MODE" in
        1)
            echo -e "${BLUE_NEON}(LANG: PT-BR): Executando em modo automático...${NC}"
            echo -e "${BLUE_NEON}(LANG: EN-US): Executing in automatic mode...${NC}"
            echo ""
            $AUR_HELPER -Syu --noconfirm
            ;;
        2|*)
            if [[ "$AUR_MODE" != "2" ]]; then
                echo -e "${YELLOW_NEON}(LANG: PT-BR): [!] Opção não reconhecida. Executando modo manual por segurança.${NC}"
                echo -e "${YELLOW_NEON}(LANG: EN-US): [!] Unrecognized option. Executing manual mode for safety.${NC}"
                echo ""
                sleep 1.5
            fi
            echo -e "${GREEN_NEON}(LANG: PT-BR): Executando em modo manual... INTERAÇÃO NECESSÁRIA.${NC}"
            echo -e "${GREEN_NEON}(LANG: EN-US): Executing in manual mode... USER INTERACTION REQUIRED.${NC}"
            echo ""
            $AUR_HELPER -Syu
            ;;
    esac

    echo ""
    echo -e "${GREEN_NEON}(LANG: PT-BR): [OK] Processo do AUR finalizado.${NC}"
    echo -e "${GREEN_NEON}(LANG: EN-US): [OK] AUR process finished.${NC}"
    echo -e "${CYAN_NEON}--------------------------------------------------------------------------------------${NC}"
}

