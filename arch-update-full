}

#LIMPEZA DE PACOTES ÓRFÃOS // CLEANING UP ORPHANED PACKAGES ------------------------------<<<
LIMPAR_ORFAOS() {

    echo -e "${NEON_BLUE}[LANG: PT-BR] Verificando por pacotes órfãos...${NC}"
    echo -e "${NEON_BLUE}[LANG: EN-US] Checking for orphaned packages...${NC}"
    echo ""

    local texto_orfao
    texto_orfao="PURGING RESIDUAL FRAGMENTS (ORPHANS)"
    local TAM_TEXTO
    TAM_TEXTO=${#texto_orfao}
    local ESPACOS
    ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${YELLOW_NEON} %s%*s${NC}${NEON_BLUE}║${NC}\n" "$texto_orfao" "$((ESPACOS-1))" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    local -a ORPHANS_LIST
    mapfile -t ORPHANS_LIST < <(pacman -Qdtq 2>/dev/null)

    local -a ORPHANS_CLEAN=()
    for pkg in "${ORPHANS_LIST[@]}"; do
        [[ -n "$pkg" ]] && ORPHANS_CLEAN+=("$pkg")
    done
    ORPHANS_LIST=("${ORPHANS_CLEAN[@]}")
    unset ORPHANS_CLEAN

    if [ ${#ORPHANS_LIST[@]} -gt 0 ]; then
        echo "" 
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Pacotes órfãos detectados. Eliminando resíduos...${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] Orphan packages detected. Wiping them out...${NC}"

        sudo pacman -Rns "${ORPHANS_LIST[@]}" --noconfirm

        echo -e "${GREEN_NEON}[LANG: PT-BR] Fragmentos residuais eliminados com sucesso.${NC}"
        echo -e "${GREEN_NEON}[LANG: EN-US] Residual data erased.${NC}"
        echo ""
    else
        echo ""
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Nenhum fragmento encontrado nos setores.${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] No fragments found in sectors.${NC}"
        echo "" 
    fi

    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
}

#LIMPEZA DO CACHE // CLEARING THE CACHE ---------------------------------------------------------------------------------------------<<<<
LIMPAR_CACHE() {
   
    echo -e "${NEON_BLUE}[LANG: PT-BR] Procurando e limpando o cache de pacotes...${NC}"
    echo -e "${NEON_BLUE}[LANG: EN-US] Searching and cleaning package cache...${NC}"
    echo ""

    local texto_cache
    texto_cache="STABILIZING_CACHE_RESERVES (PACCACHE)"
    local TAM_TEXTO
    TAM_TEXTO=${#texto_cache}
    local ESPACOS
    ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${YELLOW_NEON} %s%*s${NC}${NEON_BLUE}║${NC}\n" "$texto_cache" "$((ESPACOS-1))" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    if command -v paccache &> /dev/null; then
        echo ""
        echo -e "${GREEN_NEON}[LANG: PT-BR]${NC} Paccache detectado. Procurando caches e mantendo as 3 últimas versões..."
        echo -e "${GREEN_NEON}[LANG: EN-US]${NC} Paccache detected. Searching for caches and retaining the last 3 versions..."
        echo ""
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
        sudo paccache -rk3
        echo "" 
    else
        echo ""
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Comando paccache não encontrado!${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] paccache command not found!${NC}"
        echo "" 
        echo -e "${RED_NEON}[LANG: PT-BR] [⚠️ ALERTA] pacman -Sc mantém APENAS a versão atual instalada (1 versão).${NC}"
        echo -e "${RED_NEON}[LANG: EN-US] [⚠️ ALERT] pacman -Sc keeps ONLY the currently installed version (1 version).${NC}"
        echo -e ""
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Deseja prosseguir com pacman -Sc?${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] Do you want to proceed with pacman -Sc?${NC}"
        echo -e ""
        echo -e "${PINK_NEON}(1)${NC} [LANG: PT-BR] Sim, limpar mesmo assim!"
        echo -e "${PINK_NEON}(1)${NC} [LANG: EN-US] Yes, clean it anyway!"
        echo -e ""
        echo -e "${PINK_NEON}(2)${NC} [LANG: PT-BR] Não, pular limpeza de cache"
        echo -e "${PINK_NEON}(2)${NC} [LANG: EN-US] No, skip cache cleaning!"
        echo -e ""
        echo -ne "${CYAN_NEON}[LANG: PT-BR] Escolha uma opção [1-2]: ${NC}"
        echo -ne "${CYAN_NEON}[LANG: EN-US] Choose an option [1-2]: ${NC}"
        echo ""
        
        local CACHE_CHOICE
        read -r CACHE_CHOICE

        case "$CACHE_CHOICE" in
            1)
                echo -e "${RED_NEON}[LANG: PT-BR] Limpando cache antigo...${NC}"
                echo -e "${RED_NEON}[LANG: EN-US] Wiping old cache streams...${NC}"
                sudo pacman -Sc --noconfirm
                ;;

            2 | *)
                echo -e "${GREEN_NEON}[LANG: PT-BR] Limpeza de cache pulada por segurança.${NC}"
                echo -e "${GREEN_NEON}[LANG: EN-US] Cache cleaning skipped for safety.${NC}"
                ;;
        esac
    fi
    echo ""
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
}

#AUDITORIA DE INTEGRIDADE (OPCIONAL) // INTEGRITY AUDIT (OPTIONAL) -----------------------------------------------------------------------------<<<
AUDITAR_INTEGRIDADE() {

    echo -e "${NEON_BLUE}[LANG: PT-BR] Deseja auditar a integridade dos arquivos do sistema?(Isso pode Levar alguns minutos) ${NC}"
    echo -e "${NEON_BLUE}[LANG: EN-US] Do you want to audit system files integrity?(This may take a few minutes) ${NC}"
    echo ""

    local TEXTO_AUDIT
    TEXTO_AUDIT=" INTEGRITY SCAN: DO YOU WANT TO AUDIT SYSTEM FILES?"
    local TAM_TEXTO
    TAM_TEXTO=${#TEXTO_AUDIT}
    local ESPACOS
    ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "${YELLOW_NEON}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${YELLOW_NEON}║${NC}${NEON_BLUE}%s%*s${NC}${YELLOW_NEON}║${NC}\n" "$TEXTO_AUDIT" "$ESPACOS" ""
    echo -e "${YELLOW_NEON}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    echo "" 

    local escolha_auditoria
    while true; do
        echo -e "${CYAN_NEON}[LANG: PT-BR] Escolha: deseja auditar os arquivos do sistema? [Ss/Nn]: ${NC}"
        echo -ne "${CYAN_NEON}[LANG: EN-US] Choose: do you want to audit system files? [Yy/Nn]: ${NC}"
        read -r escolha_auditoria

        echo ""
        case "$escolha_auditoria" in
            [SsYy])
                echo -e "${NEON_BLUE}[LANG: PT-BR] [+] Iniciando auditoria de integridade do sistema...${NC}"
                echo -e "${NEON_BLUE}[LANG: EN-US] [+] Starting system integrity audit...${NC}"
                echo ""
                sleep 0.5
                echo -e "${YELLOW_NEON}[LANG: PT-BR] The Seventh está verificando as digitais do Arch...${NC}"
                echo -e "${YELLOW_NEON}[LANG: EN-US] The Seventh is verifying Arch's fingerprints...${NC}"
                echo ""

                local lista_real
                lista_real=$(LANG=C sudo pacman -Qkk 2>&1 | grep -E "mismatch|[1-9][0-9]* altered")
                
                if [ -n "$lista_real" ]; then
                    echo -e "${PINK_NEON}[LANG: PT-BR] [ALERTA] Foi detectado que arquivos foram alterados:${NC}"
                    echo -e "${PINK_NEON}[LANG: EN-US] [WARNING] The Seventh has detected that files have been modified:${NC}"
                    echo ""
                    echo -e "${CYAN_NEON}--------------------------------------------------------${NC}"
                    echo -e "${YELLOW_NEON}$lista_real${NC}"
                    echo -e "${CYAN_NEON}--------------------------------------------------------${NC}"
                    echo ""
                    echo -e "${NEON_BLUE}[LANG: PT-BR] [DICA] Verifique se são configurações ou binários do sistema.${NC}"
                    echo -e "${NEON_BLUE}[LANG: EN-US] [TIP] The Seventh recommends checking if these are system configurations or binaries.${NC}"
                else
                    echo -e "${CYAN_NEON}[LANG: PT-BR] [LIMPO] Integridade 100%. Nenhuma alteração suspeita.${NC}"
                    echo -e "${CYAN_NEON}[LANG: EN-US] [CLEAN] Integrity 100%. No suspicious alterations found.${NC}"
                fi
                break
                ;;
            [Nn])
                echo -e "${RED_NEON}[LANG: PT-BR] [PULADO] Auditoria de integridade ignorada pelo operador.${NC}"
                echo -e "${RED_NEON}[LANG: EN-US] [SKIPPED] Integrity audit skipped by the operator.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                break
                ;;
            *)
                echo -e "${RED_NEON}[LANG: PT-BR] [ERRO] Comando não reconhecido. Tente novamente.${NC}"
                echo -e "${RED_NEON}[LANG: EN-US] [ERROR] Command not recognized. Try again.${NC}"
                echo ""
                ;;
        esac
    done
}

