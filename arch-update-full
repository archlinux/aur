# --- FUNÇÃO DE ERRO PADRONIZADA (CAIXA VERMELHA) // STANDARDIZED ERROR FUNCTION ------------------------------------------------------------------------------<<<

BOX_ERROR() {
    local TEXTO="$1"
    local LARGURA=64
    local INTERNO=$((LARGURA - 4))
    
    echo -e "\n${RED_NEON}╔$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╗${NC}"
    
    echo "$TEXTO" | fold -s -w "$INTERNO" | while IFS= read -r LINHA; do
        printf "${RED_NEON}║${NC} %-${INTERNO}s ${RED_NEON}║${NC}\n" "$LINHA"
    done
    
    echo -e "${RED_NEON}╚$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╝${NC}"
}

# ---  VERIFICAÇÃO DE ESPAÇO EM DISCO // DISK SPACE CHECK  --------------------------------------------------------------------------------------------------<<<

CHECK_DISK_SPACE() {

    echo -e "${NEON_BLUE}[LANG: PT-BR] Verificando integridade do armazenamento...${NC}"

    TEXTO_DISK=" ANALYZING STORAGE: CHECKING DISK INTEGRITY RESERVE"
    TAM_TEXTO=${#TEXTO_DISK}
    ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

    echo -e "\n${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_DISK" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

    FREE_SPACE=$(df -BG / | awk 'NR==2 {print $4}' | sed 's/G//')

    if [ "$FREE_SPACE" -lt 5 ]; then
       
        MENSAGEM="${RED_NEON}[FATAL ERROR] Insufficient space (${FREE_SPACE}GB). Aborting to prevent corruption. [!] Sentinel Protocol requires at least 5GB free. Clear some space and try again. ${NC}\n${RED_NEON}[ERRO FATAL] [!]pt-br: (${FREE_SPACE}GB) O Protocolo Sentinela exige pelo menos 5GB livres. Libere algum espaço e tente novamente.${NC}"
        
        BOX_ERROR "$MENSAGEM"
        
        echo "[LOG] Aborting due to insufficient space (${FREE_SPACE}GB) on $(date)" >> "$LOG_ATUAL"
        echo -e "${YELLOW_NEON}--------------------------------------------------------------------------------------${NC}"
        exit 1
    else
        echo -e "${GREEN_NEON}[OK]${NC} Disk reserve confirmed: ${FREE_SPACE}GB available."
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    fi
}

