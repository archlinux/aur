#VERIFICAÇÃO DE NECESSIDADE DE REINICIALIZAÇÃO // REBOOT CHECK -----------------------------------------------------------------------------<<<

CHECK_REBOOT_NEEDED() {
   local CRITICAL_PACKAGES="linux|linux-firmware|ucode|nvidia|nouveau|mesa|vulkan|amdgpu|radeon|amdvlk|rocm|intel|i915|xe|onevpl|wayland|xorg|wlroots|systemd|grub|limine|refind|syslinux|efibootmgr"
    
    local BOOT_TIME
    BOOT_TIME=$(uptime -s)
    local BOOT_TIMESTAMP
    BOOT_TIMESTAMP=$(date -d "$BOOT_TIME" +%s)

    REBOOT_REQUIRED=false
    REBOOT_REASON=""

    while read -r line; do
        local UPDATE_TIME
        UPDATE_TIME=$(echo "$line" | awk '{print $1}' | tr -d '[]')
        local UPDATE_TIMESTAMP
        UPDATE_TIMESTAMP=$(date -d "$UPDATE_TIME" +%s 2>/dev/null) || continue
        
        if [[ -n "$UPDATE_TIMESTAMP" && "$UPDATE_TIMESTAMP" -gt "$BOOT_TIMESTAMP" ]]; then
            local PKG_NAME
            PKG_NAME=$(echo "$line" | awk '{print $4}')
            REBOOT_REASON+="$PKG_NAME "
            REBOOT_REQUIRED=true
        fi
    done < <(grep "$(date "+%Y-%m-%d")" /var/log/pacman.log | grep -E "upgraded.*($CRITICAL_PACKAGES)")

    if [ "$REBOOT_REQUIRED" = true ]; then
        echo -e "${RED_NEON}╔══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${RED_NEON}║ [⚠️  INTEGRITY ALERT // [LANG: PT-BR] ALERTA DE INTEGRIDADE]  ║${NC}"
        echo -e "${RED_NEON}╚══════════════════════════════════════════════════════════════╝${NC}"
        echo ""
        echo -e "          ${BLUE}.--.${NC}"
        echo -e "         ${BLUE}|${WHITE}o_o ${BLUE}|${NC}"
        echo -e "         ${BLUE}|${YELLOW}:_/${BLUE} |${NC}    ${RED_NEON}KERNEL MANAGEMENT SYSTEM${NC}"
        echo -e "        ${BLUE}//   \\\\${NC}"
        echo -e "       ${BLUE}(|  ${WHITE}   ${BLUE}|)${NC}"
        echo -e "      ${BLUE}/'\\\\_${YELLOW}   ${BLUE}_/\\\`\\\\${NC}"
        echo -e "      ${BLUE}\\\\___)${YELLOW}=${BLUE}(___/${NC}"
        echo ""
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Componentes críticos foram alterados; o reboot do sistema é necessário e recomendado:${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] Critical components have been altered; a system reboot is necessary and recommended.${NC}"
