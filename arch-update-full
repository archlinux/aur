            echo -e "  ${PINK_NEON}($((i+1)))${NC} ${INSTALLED_HELPERS[$i]^^}"
        done
        echo ""

        read -rn 1 -p "  [ESCOLHA / CHOICE 1-$TOTAL_HELPERS]: " AUR_CHOICE
