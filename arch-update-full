# --- [SISTEMA] NOTIFICAÇÃO E AUDITORIA FINAL // [SYSTEM] FINAL NOTIFICATION AND AUDIT -----------------------------------------------------<<<
MENU_ENCERRAMENTO() {
    CHECK_REBOOT_NEEDED
    sleep 0.7
     
    echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"
    echo -e "${NEON_BLUE}[LANG: PT-BR]          MENU DE ENCERRAMENTO ${NC}"
    echo -e "${NEON_BLUE}[LANG: EN-US]          CLOSING MENU         ${NC}" 
    echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"

    echo -e "${MAGENTA_NEON}(A)${NC} ${WHITE}[LANG: PT-BR] Encerrar sessão e fechar terminal${NC}\n${WHITE}[LANG: EN-US] Close terminal ${NC} ${CYAN_NEON}(Kill Switch)${NC}"
    echo -e ""
    echo -e "${MAGENTA_NEON}(B)${NC} ${WHITE}[LANG: PT-BR] Encerrar sessão (Modo Leitura)${NC}\n${WHITE}[LANG: EN-US] Close session (Read-only Mode) ${NC} ${CYAN_NEON}(Security Buffer)${NC}"
    echo -e ""
    echo -e "${MAGENTA_NEON}(C)${NC} ${WHITE}[LANG: PT-BR] Continuar na sessão${NC}\n${WHITE}[LANG: EN-US] Continue in session ${NC} ${CYAN_NEON}(Return to Prompt)${NC}"
    echo -e ""

    if [ "$REBOOT_REQUIRED" = true ]; then
        echo -e "${RED_NEON}(D) [LANG: PT-BR] [RECOMENDADO] Reiniciar o sistema ${NC}\n${RED_NEON}(D) [LANG: EN-US] [RECOMMENDED] Reboot system (Reboot Protocol)${NC}"
    else
        echo -e "${MAGENTA_NEON}(D)${NC} ${WHITE}[LANG: PT-BR] Reiniciar o sistema ${NC}\n${WHITE}[LANG: EN-US] Reboot system ${NC} ${CYAN_NEON}(Reboot Protocol)${NC}"
    fi

    echo ""
    echo -ne "${CYAN_NEON}[ESCOLHA]:${NC} "
    
    local OPCAO
    read -rn 1 OPCAO
    echo ""

    case $OPCAO in
        [Aa])
            echo -e "${RED_NEON}[!][LANG: PT-BR] Encerrando conexão e fechando hardware...${NC}"
            echo -e "${RED_NEON}[!][LANG: EN-US] Closing connection and shutting down hardware...${NC}"
            echo -e ""
            for i in {3..1}; do
                printf "\r${RED_NEON}[CLOSING IN] ${CYAN_NEON}%d seconds...${NC}" "$i"
                sleep 1
            done
            echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"
            kill -9 "$(ps -o ppid= -p $$)"
            ;;

        [Bb])
            echo -e "${YELLOW_NEON}[!][LANG: PT-BR] Sessão em modo leitura. Analise os logs.${NC}"
            echo -e "${YELLOW_NEON}[!][LANG: EN-US] Session in read-only mode. Analyze the logs.${NC}"
            echo -e ""
            echo -e "${WHITE}[LANG: PT-BR] Pressione ${MAGENTA_NEON}[ENTER]${NC} para encerrar o terminal...${NC}"
            echo -ne "${WHITE}[LANG: EN-US] Press ${MAGENTA_NEON}[ENTER]${NC} to close the terminal...${NC}"
            echo -e ""

            while true; do
                local input
                read -rs input
                
                if [ -z "$input" ]; then
                    break
                else
                    echo -e "${RED_NEON}[!][LANG: PT-BR] Entrada inválida. Pressione APENAS o [ENTER] vazio!${NC}"
                    echo -e "${RED_NEON}[!][LANG: EN-US] Invalid input. Press ONLY empty [ENTER]!${NC}"
                    echo -e ""
                fi
            done

            echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"
            sleep 0.5
            exec "$SHELL"
            ;;

        [Cc])
            echo -e "${GREEN_NEON}[!][LANG: PT-BR] Protocolo encerrado. Invocando Shell persistente...${NC}"
            echo -e "${GREEN_NEON}[!][LANG: EN-US] Protocol closed. Invoking persistent Shell...${NC}"
            echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"
            exec "$SHELL"
            ;;

        [Dd])
            echo -e "${RED_NEON}[!][LANG: PT-BR] INICIANDO PROTOCOLO DE REBOOT...${NC}"
            echo -e "${RED_NEON}[!][LANG: EN-US] INITIATING REBOOT PROTOCOL...${NC}"
            echo -e ""
            for i in {5..1}; do
                printf "\r${RED_NEON}[REBOOTING IN] ${CYAN_NEON}%d seconds...${NC}" "$i"
                sleep 1
            done
            echo -e "${CYAN_NEON}------------------------------------------------------------${NC}"
            sudo reboot
            ;;

        *)
            echo -e "${RED_NEON}[!][LANG: PT-BR] Opção inválida. Retornando ao prompt por segurança.${NC}"
            echo -e "${RED_NEON}[!][LANG: EN-US] Invalid option. Returning to prompt for safety.${NC}"
            sleep 1.5
            exec "$SHELL"
            ;;
    esac
}

