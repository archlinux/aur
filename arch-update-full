# Função para Limpeza logs (FIFO - Keep 13) // Log cleanup function (FIFO - Keep 13)

rotate_logs() {
    local LOG_COUNT
    local OLD_LOG

    LOG_COUNT=$(find "$LOG_DIR" -maxdepth 1 -name "update_*.log" 2>/dev/null | wc -l)
    
    if [ "$LOG_COUNT" -ge 13 ]; then
        OLD_LOG=$(find "$LOG_DIR" -maxdepth 1 -name "update_*.log" -type f -printf '%T@ %p\n' | sort -n | head -n 1 | cut -d' ' -f2-)
        
        if [ -n "$OLD_LOG" ]; then
            rm "$OLD_LOG"
            echo -e "${RED_NEON}[LOG_SYSTEM] Ciclo de rotação ativo. Log antigo removido: $(basename "$OLD_LOG")${NC}"
        fi
    fi
}

rotate_logs

exec > >(tee -i "$LOG_ATUAL") 2>&1

echo -e "${PINK_NEON}--- INICIANDO REGISTRO DE SESSÃO: $DATA_LOG ---${NC}"


