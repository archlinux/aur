#VERIFICAÇÃO DE NECESSIDADE DE REINICIALIZAÇÃO // REBOOT CHECK -----------------------------------------------------------------------------<<<

CHECK_REBOOT_NEEDED() {
   local CRITICAL_PACKAGES="linux|nvidia|mesa|ucode|systemd|wayland|xorg|amdgpu|radeon|vulkan-radeon|amd-ucode|intel|i915|vulkan-intel|intel-media-driver|onevpl-intel-gpu|intel-ucode"
    
    local BOOT_TIME
    BOOT_TIME=$(uptime -s)
    local BOOT_TIMESTAMP
    BOOT_TIMESTAMP=$(date -d "$BOOT_TIME" +%s)

    REBOOT_REQUIRED=false
    REBOOT_REASON=""

    while read -r line; do
        local UPDATE_TIME
        UPDATE_TIME=$(echo "$line" | awk '{print $1}' | tr -d '[]')
        local UPDATE_TIMESTAMP
        UPDATE_TIMESTAMP=$(date -d "$UPDATE_TIME" +%s 2>/dev/null) || continue
        
        if [[ -n "$UPDATE_TIMESTAMP" && "$UPDATE_TIMESTAMP" -gt "$BOOT_TIMESTAMP" ]]; then
            local PKG_NAME
            PKG_NAME=$(echo "$line" | awk '{print $4}')
            REBOOT_REASON+="$PKG_NAME "
            REBOOT_REQUIRED=true
        fi
    done < <(grep "$(date "+%Y-%m-%d")" /var/log/pacman.log | grep -E "upgraded.*($CRITICAL_PACKAGES)")

    if [ "$REBOOT_REQUIRED" = true ]; then
        echo -e "${RED_NEON}╔══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "${RED_NEON}║ [⚠️  INTEGRITY ALERT // [LANG: PT-BR] ALERTA DE INTEGRIDADE]  ║${NC}"
        echo -e "${RED_NEON}╚══════════════════════════════════════════════════════════════╝${NC}"
        echo ""

        echo -e "${YELLOW_NEON}[LANG: PT-BR] Componentes críticos foram alterados; o reboot do sistema é necessário e recomendado:${NC}"
