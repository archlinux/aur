#OTIMIZAÇÃO DE ESPELHOS (MIRRORS) // MIRRORS OPTIMIZATION ------------------------------------------------------------------------------<<<
OTIMIZAR_ESPELHOS() {
    # Verifica primeiro se o reflector está instalado // First, check if reflector is installed
    if command -v reflector &> /dev/null; then
        echo -e "${NEON_BLUE}[LANG: PT-BR] Gostaria de otimizar os espelhos de rede (Reflector)?${NC}"
        echo -e "${NEON_BLUE}[LANG: EN-US] Would you like to optimize the network mirrors (Reflector)?${NC}" 
        echo ""

        local TEXTO_REFLECTOR=" OPTIMIZING NETWORK MIRRORS"
        local TAM_TEXTO=${#TEXTO_REFLECTOR}
        local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

        echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
        printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_REFLECTOR" "$ESPACOS" ""
        echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
        
        echo ""
        echo -e "${NEON_BLUE}[LANG: PT-BR] Busca os 7 espelhos mais rápidos. Pode demorar alguns segundos/minutos.${NC}"
        echo -e "${NEON_BLUE}[LANG: EN-US] Searches for the 7 fastest mirrors. May take a few seconds/minutes.${NC}"
        echo ""
        
        local OPCAO_REFLECTOR
        echo -e "${YELLOW_NEON}[LANG: PT-BR] Iniciar otimização de rede? (S/N):${NC}"
        read -rp "[LANG: EN-US] Start network optimization? (Y/N): " OPCAO_REFLECTOR
        echo ""

        case "$OPCAO_REFLECTOR" in
            [SsYy]* )
                echo -e "${YELLOW_NEON}[LANG: PT-BR] [BUSCANDO] Selecionando e salvando os 7 espelhos HTTPS mais rápidos...${NC}"
                echo -e "${YELLOW_NEON}[LANG: EN-US] [SEARCHING] Selecting and saving the 7 fastest HTTPS mirrors...${NC}"
                echo ""
                echo -e "${NEON_BLUE}[LANG: PT-BR] Isso pode levar alguns segundos/minutos dependendo da sua conexão. Por favor, aguarde...${NC}"
                echo -e "${NEON_BLUE}[LANG: EN-US] This may take a few seconds/minutes depending on your connection. Please wait...${NC}"
                echo ""

                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                # Comando otimizado: Pega os 20 mais atualizados, testa e salva os 7 mais rápidos // Optimized command: Gets the 20 most updated, tests and saves the 7 fastest
                if sudo reflector --protocol https --latest 20 --fastest 7 --sort rate --save /etc/pacman.d/mirrorlist; then
                    echo -e "${GREEN_NEON}[LANG: PT-BR] [OK] Otimização concluída com sucesso!${NC}"
                    echo -e "${GREEN_NEON}[LANG: EN-US] [OK] Optimization completed successfully!${NC}"
                    echo ""

                    # --- NOVO BLOCO VISUAL COM PING (MS) ---
                    echo -e "${CYAN_NEON}Lista de espelhos mais rápidos // List of fastest mirrors:${NC}"
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"

                    local rank=1
                    local line
                    local url
                    local domain
                    local ping_time
                    local total_espelhos=0
                    local espelhos_ok=0

                    # Lê apenas as 7 primeiras linhas de Server no arquivo // Reads only the first 7 Server lines in the file
                    while IFS= read -r line; do
                        # Extrai apenas a URL (ex: https://mirror.ufpr.br/...) // Extracts only the URL
                        url=$(echo "$line" | awk '{print $3}')

                        # Extrai apenas o domínio para poder pingar (ex: mirror.ufpr.br) // Extracts only the domain to ping
                        domain=$(echo "$url" | awk -F/ '{print $3}')

                        # Dispara 1 único pacote de ping e pega a latência média (ms). Se falhar, retorna "N/A" // 1 ping packet, average latency; "N/A" on failure
                        ping_time=$(ping -c 1 -W 1 "$domain" 2>/dev/null | awk -F'/' 'END{ print (/^rtt/ ? $5" ms" : "N/A") }')

                        total_espelhos=$((total_espelhos + 1))
                        if [[ "$ping_time" == "N/A" ]]; then
                            printf "  ${YELLOW_NEON}[#%d]${NC} ${NEON_BLUE}%s${NC} ${RED_NEON}(sem resposta / no response)${NC}\n" "$rank" "$url"
                        else
                            printf "  ${YELLOW_NEON}[#%d]${NC} ${NEON_BLUE}%s${NC} ${PINK_NEON}(%s)${NC}\n" "$rank" "$url" "$ping_time"
                            espelhos_ok=$((espelhos_ok + 1))
                        fi

                        ((rank++))
                    done < <(grep '^Server' /etc/pacman.d/mirrorlist | head -n 7)

                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    echo ""
                    # --- FIM DO BLOCO VISUAL ---

                    if (( espelhos_ok < total_espelhos )); then
                        echo -e "${YELLOW_NEON}[LANG: PT-BR] [AVISO] ${espelhos_ok} de ${total_espelhos} espelhos selecionados estão respondendo agora.${NC}"
                        echo -e "${YELLOW_NEON}[LANG: PT-BR] Isso indica instabilidade em alguns espelhos no momento — não é um erro do script.${NC}"
                        echo -e "${YELLOW_NEON}[LANG: EN-US] [NOTICE] ${espelhos_ok} of ${total_espelhos} selected mirrors are responding right now.${NC}"
                        echo -e "${YELLOW_NEON}[LANG: EN-US] This indicates temporary instability in some mirrors — not a script error.${NC}"
                        echo ""
                    fi
                else
                    echo -e "${RED_NEON}[LANG: PT-BR] [ERRO] Não foi possível otimizar os espelhos.${NC}"
                    echo -e "${RED_NEON}[LANG: PT-BR] Isso geralmente indica falha de conexão ou espelhos indisponíveis no momento — não é um erro do script.${NC}"
                    echo ""
                    echo -e "${RED_NEON}[LANG: EN-US] [ERROR] Could not optimize the mirrors.${NC}"
                    echo -e "${RED_NEON}[LANG: EN-US] This usually indicates a connection issue or mirrors being unavailable right now — not a script error.${NC}"
                    echo ""
                fi
                    ;; 
            
            [Nn]* | * )
                echo -e "${YELLOW_NEON}[LANG: PT-BR] [SKIPPED] Otimização de rede pulada pelo usuário.${NC}"
                echo -e "${YELLOW_NEON}[LANG: EN-US] [SKIPPED] Network optimization skipped by user.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                ;;
        esac

    else
        #Retorno visual caso a pessoa não tenha o reflector instalado // Visual return if the person does not have reflector installed
        echo -e "${NEON_BLUE}[LANG: PT-BR] Otimização de espelhos de rede indisponível.${NC}"
        
        local TEXTO_REFLECTOR=" NETWORK MIRROR OPTIMIZATION"
        local TAM_TEXTO=${#TEXTO_REFLECTOR}
        local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))

        echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
        printf "${NEON_BLUE}║${NC}${PINK_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_REFLECTOR" "$ESPACOS" ""
        echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"

        echo ""
        echo -e "${YELLOW_NEON}[LANG: PT-BR] [WARNING] Reflector não detectado. Pulando setor de otimização.${NC}"
        echo -e "${YELLOW_NEON}[LANG: EN-US] [WARNING] Reflector not detected. Skipping network optimization sector.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        echo ""
    fi
}
