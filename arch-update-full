CAMINHO_SENTINELA="/usr/bin/arch-update-full-sentinela" 

REPROGRAMAR_SENTINELA() {
    local SERVICE_DIR="$HOME/.config/systemd/user"
    
    mkdir -p "$SERVICE_DIR"

    # Cria o arquivo de Serviço apontando para o script isolado do Sentinela
    cat <<EOF > "$SERVICE_DIR/arch-sentinel.service"
[Unit]
Description=Sentinela de Atualizações Arch Update Full
After=network-online.target

[Service]
Type=oneshot
ExecStart=$CAMINHO_SENTINELA --check
EOF

    # Cria o arquivo de Timer (Roda 7 min após o boot, e de 3 em 3 horas)
    cat <<EOF > "$SERVICE_DIR/arch-sentinel.timer"
[Unit]
Description=Roda o Sentinela a cada 3 horas

[Timer]
OnBootSec=7min
OnUnitActiveSec=3h
Persistent=true

[Install]
WantedBy=timers.target
EOF

    # Recarrega o daemon e ativa o timer de forma 100% invisível
    systemctl --user daemon-reload >/dev/null 2>&1
    systemctl --user enable --now arch-sentinel.timer >/dev/null 2>&1
}

VERIFICAR_SENTINELA() {
    local SERVICE_FILE="$HOME/.config/systemd/user/arch-sentinel.service"
    local PRECISA_REPROGRAMAR=0

    # 1. Checa se o arquivo NÃO existe ou se ainda aponta para o script velho (sem o "-sentinela")
    if [ ! -f "$SERVICE_FILE" ] || ! grep -q "arch-update-full-sentinela" "$SERVICE_FILE"; then
        PRECISA_REPROGRAMAR=1
    fi

    # 2. Checa se o timer está desabilitado ou parado
    if ! systemctl --user is-enabled --quiet arch-sentinel.timer 2>/dev/null || ! systemctl --user is-active --quiet arch-sentinel.timer 2>/dev/null; then
        PRECISA_REPROGRAMAR=1
    fi

    # 3. Se encontrou qualquer problema acima, ele limpa e reconfigura silenciosamente
    if [ "$PRECISA_REPROGRAMAR" -eq 1 ]; then
        # Para o antigo por segurança antes de sobrescrever
        systemctl --user stop arch-sentinel.timer 2>/dev/null
        
        # Chama a sua função de criação (que você já fez e está perfeita)
        REPROGRAMAR_SENTINELA
    fi
}

