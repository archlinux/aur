IMMICH_URL=http://localhost:2283
# The proxy's public URL, NOT the upload service's own URL
PUBLIC_BASE_URL=https://photos.example.com
# Must differ from the proxy, which also defaults to 3000
IPP_PORT=3001

# Settings belong in /etc/immich-public-proxy-upload/config.json.
# Do NOT set CONFIG here: if it is set, no config file is read at all.

