[Unit]
Description=AzerothCore MMORPG World Server
After=network.target azerothcore-auth.service
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/share/azerothcore/acore.sh run-worldserver

[Install]
WantedBy=multi-user.target
