diff --git a/makefile.gcc b/makefile.gcc
index 787652e..a1d0ecd 100644
--- a/makefile.gcc
+++ b/makefile.gcc
@@ -29,17 +29,16 @@ MV = mv
 RM = rm -f
 
 # flags
-CFLAGS = $(DEFINES) $(TFLAG) $(CDEBUG) -c -Wall -Wextra
+CFLAGS += $(DEFINES) -c -Wall -Wextra
 INSTALLBINFLAGS = -m 755
 INSTALLDATAFLAGS = -m 644
-LDFLAGS = $(LDEBUG)
 LNFLAGS = -sf
 RMRECURFLAGS = -rf
 
 # directories
 BINDIR = /usr/bin
 LIBDIR = lib
-MANDIR = /usr/man/man1
+MANDIR = /usr/share/man/man1
 
 # filenames
 FROMDOS = fromdos
@@ -67,12 +66,12 @@ clobber: clean
 	$(RM) $(FROMDOS) $(TODOS)
 
 install: installman
-	$(INSTALL) $(INSTALLBINFLAGS) $(FROMDOS) $(BINDIR)
-	($(CD) $(BINDIR) ; $(LN) $(LNFLAGS) fromdos todos)
+	$(INSTALL) -Dm755 $(FROMDOS) -t $(DESTDIR)$(BINDIR)
+	($(CD) $(DESTDIR)$(BINDIR) ; $(LN) $(LNFLAGS) fromdos todos)
 
 installman: $(FROMDOSMAN)
-	$(INSTALL) $(INSTALLDATAFLAGS) $(FROMDOSMAN) $(MANDIR)
-	($(CD) $(MANDIR) ; $(LN) $(LNFLAGS) fromdos.1 todos.1)
+	$(INSTALL) -Dm644 $(FROMDOSMAN) -t $(DESTDIR)$(MANDIR)
+	($(CD) $(DESTDIR)$(MANDIR) ; $(LN) $(LNFLAGS) fromdos.1 todos.1)
 
 
 # real rules
