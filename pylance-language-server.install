post_install() {
    cat <<'EOF'
  ┌──────────────────────────────────────────────────────────┐
  │  the beast is slain. the oracle breathes. the gates      │
  │  remain open until someone decides to rebuild them.      │
  │                                                          │
  │  invoke via: pylance-language-server --stdio             │
  │  (standard LSP stdio transport)                          │
  │                                                          │
  │  installed at /opt/pylance-language-server               │
  └──────────────────────────────────────────────────────────┘
EOF
}

post_upgrade() {
    :
}

post_remove() {
    rm -rf /opt/pylance-language-server
}
