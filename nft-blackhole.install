post_upgrade() {
  # Notify about configuration location and format change when upgrading from <= 1.4.1 to >= 1.5.0
  if (( $(vercmp "$2" "1.5.0") < 0 )); then
    echo ":: WARNING: Configuration file location and format has changed in v1.5.0."
    echo "   New location: /etc/nft-blackhole/config.yaml"
    echo "   WHITELIST and BLACKLIST sections now support: static, file, and url."
    echo "   Please migrate your settings from /etc/nft-blackhole.conf to /etc/nft-blackhole/config.yaml."
  fi
}
