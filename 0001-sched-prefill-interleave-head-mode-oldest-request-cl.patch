+/* --prefill-interleave head: the oldest active request governs the step. Its slot is the older
+ * of the waiting queue's front and the first live running entry (both queues are sorted by
+ * ahead_of); -1 when the engine holds nothing. mu_ held. */
+int32_t Scheduler::head_slot_locked() const {
+    int32_t w = -1, r = -1;
+    for (int32_t slot : waiting_)
+        if (reqs_[(size_t)slot]->req) { w = slot; break; }
+    for (int32_t slot : running_) {
+        const SchedReq& s = *reqs_[(size_t)slot];
+        if (s.req && s.running) { r = slot; break; }
+    }
+    if (w < 0) return r;
+    if (r < 0) return w;
+    return ahead_of(w, r) ? w : r;
+}
+
+/* Its class: true when the governing step is a prefill's. A waiting head always governs
+ * prefill -- it enters the step as a prefill entry, even when an admission attempt with a
+ * full-prompt prefix hit left it reading decode-class (admit_one keeps n_computed = reuse on
+ * an attention-only refusal). An empty engine governs prefill. mu_ held. */
+bool Scheduler::head_class_prefill() const {
+    const int32_t h = head_slot_locked();
+    if (h < 0) return true;
+    for (int32_t slot : waiting_)
+        if (slot == h) return true;
+    const SchedReq& s = *reqs_[(size_t)h];
+    const Request& r = *s.req;
+    return r.n_computed < (int64_t)r.prompt.size() || r.n_computed + 1 < s.seq_len();
+}
