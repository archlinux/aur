function post_install() {
#!/bin/sh
# SPDX-FileCopyrightText: 2026 Gundu Labs
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

insert_profile_db() {
    profile="$1"
    db="system-db:$2"
    after="$3"
    required="$4"

    grep -qxF "$db" "$profile" && return 0

    if ! grep -qxF "$after" "$profile"; then
        [ "$required" = "required" ] || return 0
        printf '%s\n' "$db" >>"$profile"
        return 0
    fi

    tmp="${profile}.gaze-tmp"
    if awk -v db="$db" -v after="$after" '
        { print }
        $0 == after && !inserted { print db; inserted = 1 }
    ' "$profile" >"$tmp"; then
        cat "$tmp" >"$profile"
    fi
    rm -f "$tmp"
}

ensure_greeter_dconf_profile() {
    name="$1"
    fallback="$2"
    profile="/etc/dconf/profile/$name"
    vendor="/usr/share/dconf/profile/$name"

    if [ ! -f "$profile" ]; then
        if [ -f "$vendor" ]; then
            seed="$vendor"
        elif [ -n "$fallback" ] && [ -f "$fallback" ]; then
            seed="$fallback"
        else
            return 0
        fi
        mkdir -p /etc/dconf/profile
        cat "$seed" >"$profile"
        chmod 0644 "$profile"
    fi

    insert_profile_db "$profile" gdm user-db:user required
    [ -d /etc/dconf/db/distro.d ] && insert_profile_db "$profile" distro system-db:gdm optional

    return 0
}

ensure_greeter_dconf_profile gdm /usr/share/gaze/dconf-profile-gdm || true
ensure_greeter_dconf_profile Debian-gdm "" || true

if [ -d /run/systemd/system ]; then
    dconf update >/dev/null 2>&1 || true
    glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true

    if command -v semodule >/dev/null 2>&1; then
        if ! semodule -i /usr/share/gaze/gaze-gdm-camera.pp >/dev/null 2>&1; then
            echo "gaze: failed to load the gaze-gdm-camera SELinux policy;" >&2
            echo "gaze: face auth at the GDM login screen will not work until you run" >&2
            echo "gaze:   sudo semodule -i /usr/share/gaze/gaze-gdm-camera.pp" >&2
        fi
    fi
fi

}

function post_remove() {
#!/bin/sh
# SPDX-FileCopyrightText: 2026 Gundu Labs
# SPDX-License-Identifier: GPL-3.0-or-later

set -e

case "${1:-}" in
    1|2|upgrade|failed-upgrade) ;;
    *) rm -f /etc/dconf/db/gdm.d/99-gaze* 2>/dev/null || true ;;
esac

if [ -d /run/systemd/system ]; then
    dconf update >/dev/null 2>&1 || true
    glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true
fi

}

