#!/bin/bash

post_install() {
    pacman -Qs docker >/dev/null 2>&1 || \
        echo -e "\033[33mWarning:\033[0m Docker is not installed. Most 1Panel services will not work without it."

    pacman -Qs docker-compose >/dev/null 2>&1 || \
        echo -e "\033[33mWarning:\033[0m docker-compose is not installed. The 1Panel app store will not work without it."

    echo -e "\033[31mDo not use the default username and password.\033[0m"
    echo -e "After installation, update the credentials in \033[34m/etc/1panel.conf\033[0m before using 1Panel."
    echo -e "The configuration file has moved from \033[34m1pctl\033[0m to \033[34m/etc/1panel.conf\033[0m."
}

pre_remove() {
    echo "Stopping systemd services..."
    systemctl disable --now 1panel-agent
    systemctl disable --now 1panel-core
}

post_remove() {
    echo -e "Please back up and remove \033[34m/var/lib/1p/1panel\033[0m manually."
}

pre_upgrade() {
    export no_need_start="false"

    systemctl is-active --quiet 1panel-core && {
        echo "1panel-core is running, stopping it temporarily..."
        systemctl stop 1panel-core
        export _restart_1panel_core_service=true
    }

    systemctl is-active --quiet 1panel-agent && {
        echo "1panel-agent is running, stopping it temporarily..."
        systemctl stop 1panel-agent
        export _restart_1panel_agent_service=true
    }
}

post_upgrade() {
    # Update the recorded original version in the configuration file.
    # If the version field is missing from the configuration, 1Panel may fail to start.
    conf_file="/etc/1panel.conf"

    [ ! -f "$conf_file" ] || \
        sed -i "s/^ORIGINAL_VERSION=.*/ORIGINAL_VERSION=v${pkgver}/" "$conf_file"

    # Update the version stored in the internal database.
    # This command is not officially documented upstream, but it is used internally by 1Panel.
    # Adjust this only if upstream changes the way version checks are handled.
    1panel update version "v${pkgver}"

    [ -z "${_restart_1panel_agent_service+x}" ] || {
        echo "Restarting 1panel-agent..."
        systemctl daemon-reload
        systemctl start 1panel-agent
        unset _restart_1panel_agent_service
    }

    [ -z "${_restart_1panel_core_service+x}" ] || {
        echo "Restarting 1panel-core..."
        systemctl daemon-reload
        systemctl start 1panel-core
        unset _restart_1panel_core_service
    }
}