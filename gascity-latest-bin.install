post_install() {
    printf '\n'
    printf '  Gas City (gc) installed.\n'
    printf '  Verify with:   gc version\n'
    printf '  Docs:          https://docs.gascityhall.com\n'
    printf '\n'
    printf '  The "bd" (Beads) dependency is provided only by AUR packages\n'
    printf '  (beads / beads-bin / beads-git). If you installed gc with a plain\n'
    printf '  makepkg, install one of those from the AUR; an AUR helper such as\n'
    printf '  yay or paru pulls it in automatically.\n'
    printf '\n'
}

post_upgrade() {
    local _new="$1"
    printf '  Gas City upgraded to %s — run `gc version` to confirm.\n' "$_new"
}
