#!/bin/sh

post_install() {
    echo ">"
    echo "> If you wish to use the zrok2 agent, please 'zrok2 enable <your_account_token>' first (to create your home .zrok2 directory)"
    echo ">"
    echo "> Then, do 'systemctl enable --now --user zrok2-agent'"
    echo ">"
    echo "> More information on the zrok agent can be found here: 'https://docs.zrok.io/docs/guides/agent'"
	echo ">"
}
