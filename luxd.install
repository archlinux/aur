post_install() {
	cat <<-EOF
	==> luxd is installed but not configured or running yet.

	    Set up your config:
	        mkdir -p ~/.config/luxd
	        cp /usr/share/doc/luxd/config.example.toml ~/.config/luxd/config.toml
	        \$EDITOR ~/.config/luxd/config.toml

	    Then enable the user service:
	        systemctl --user enable --now luxd.service

	EOF
}

post_upgrade() {
	post_install
}
