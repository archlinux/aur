+static int get_boottime_usec(uint64_t *value)
+{
+#ifdef CLOCK_BOOTTIME
+	struct timespec now;
+	uint64_t seconds, usec;
+
+	if (value == NULL)
+		return -EINVAL;
+	if (clock_gettime(CLOCK_BOOTTIME, &now) < 0)
+		return -errno;
+	if (now.tv_sec < 0 || now.tv_nsec < 0 ||
+			now.tv_nsec >= SPA_NSEC_PER_SEC)
+		return -EIO;
+
+	seconds = (uint64_t)now.tv_sec;
+	usec = (uint64_t)now.tv_nsec /
+		(uint64_t)SPA_NSEC_PER_USEC;
+	if (seconds > (UINT64_MAX - usec) /
+			(uint64_t)SPA_USEC_PER_SEC)
+		return -EOVERFLOW;
+	*value = seconds * (uint64_t)SPA_USEC_PER_SEC + usec;
+	return 0;
+#else
+	(void)value;
+	return -ENOTSUP;
+#endif
