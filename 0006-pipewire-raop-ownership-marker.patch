+static void test_command_parser_and_admission(void)
+{
+	static const char valid[] =
+		"{\"command.id\":\"raop-source-marker-rotate\","
+		"\"marker.sequence\":\"42\","
+		"\"gate.sequence\":\"7\","
+		"\"gate.nonce\":\"0123456789abcdef\"}";
+	struct raop_source_marker_rotate_command command;
+	struct raop_source_marker marker = {
+		.state = RAOP_SOURCE_MARKER_CONFIRMED,
+		.sequence = 42,
+		.value = "stpw1:0123456789abcdef0123456789abcdef",
+	};
+	struct raop_safety_gate gate;
+
+	spa_assert_se(source_marker_parse_rotate_command(valid, &command) == 0);
+	spa_assert_se(command.marker_sequence == 42);
+	spa_assert_se(command.gate_sequence == 7);
+	spa_assert_se(command.gate_nonce == TEST_GATE_NONCE);
+
+	raop_safety_gate_init(&gate, TEST_GATE_NONCE);
+	gate.sequence = 7;
+	gate.reasons = RAOP_SAFETY_GATE_ACTIVATION;
+	spa_assert_se(source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+	gate.reasons = RAOP_SAFETY_GATE_MUTE;
+	spa_assert_se(!source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+	gate.reasons = RAOP_SAFETY_GATE_ACTIVATION;
+	command.marker_sequence++;
+	spa_assert_se(!source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+	command.marker_sequence--;
+	command.gate_sequence++;
+	spa_assert_se(!source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+	command.gate_sequence--;
+	gate.reasons |= RAOP_SAFETY_GATE_ERROR;
+	spa_assert_se(!source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+	gate.reasons = 0;
+	spa_assert_se(!source_marker_rotate_command_matches(
+			&marker, &command, &gate));
+
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"other\"}", &command) == -ENOENT);
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"raop-source-marker-rotate\","
+			"\"marker.sequence\":\"18446744073709551615\","
+			"\"gate.sequence\":\"18446744073709551615\","
+			"\"gate.nonce\":\"ffffffffffffffff\"}",
+			&command) == 0);
+	spa_assert_se(command.marker_sequence == UINT64_MAX);
+	spa_assert_se(command.gate_sequence == UINT64_MAX);
+	spa_assert_se(command.gate_nonce == UINT64_MAX);
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"raop-source-marker-rotate\","
+			"\"marker.sequence\":42,"
+			"\"gate.sequence\":\"7\","
+			"\"gate.nonce\":\"0123456789abcdef\"}",
+			&command) == -EINVAL);
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"raop-source-marker-rotate\","
+			"\"marker.sequence\":\"0\","
+			"\"gate.sequence\":\"7\","
+			"\"gate.nonce\":\"0123456789abcdef\"}",
+			&command) == -EINVAL);
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"raop-source-marker-rotate\","
+			"\"marker.sequence\":\"42\","
+			"\"gate.sequence\":\"7\","
+			"\"gate.nonce\":\"0123456789abcdeF\"}",
+			&command) == -EINVAL);
+	spa_assert_se(source_marker_parse_rotate_command(
+			"{\"command.id\":\"raop-source-marker-rotate\","
+			"\"marker.sequence\":\"42\","
+			"\"gate.sequence\":\"7\","
+			"\"gate.nonce\":\"0123456789abcdef\","
+			"\"extra\":\"forbidden\"}",
+			&command) == -EINVAL);
+}
+
+static void test_release_marker_binding(void)
+{
+	static const uint8_t first[16] = {
+		0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+		0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+	};
+	static const uint8_t second[16] = {
+		0xf0, 0xe1, 0xd2, 0xc3, 0xb4, 0xa5, 0x96, 0x87,
+		0x78, 0x69, 0x5a, 0x4b, 0x3c, 0x2d, 0x1e, 0x0f,
+	};
+	struct raop_safety_gate_command proof_a = { 0 }, proof_b = { 0 };
+	struct raop_safety_gate gate;
+	struct raop_source_marker marker;
+
+	raop_safety_gate_init(&gate, TEST_GATE_NONCE);
+	raop_safety_gate_hold(&gate, RAOP_SAFETY_GATE_ACTIVATION);
+	source_marker_init(&marker);
+	spa_assert_se(source_marker_begin(&marker, first) == 0);
+	spa_assert_se(source_marker_confirm(&marker, marker.sequence));
+	proof_a.sequence = gate.sequence;
+	proof_a.nonce = gate.nonce;
+	proof_a.marker_sequence = marker.sequence;
+	memcpy(proof_a.marker_value, marker.value,
+			sizeof(proof_a.marker_value));
+	spa_assert_se(source_marker_release_command_matches(
+			&marker, &proof_a));
+
+	/* Rotating A to B does not alter the safety-gate generation. A release
+	 * authorized by proof A must nevertheless stop matching immediately. */
+	spa_assert_se(source_marker_begin(&marker, second) == 0);
+	spa_assert_se(source_marker_confirm(&marker, marker.sequence));
+	spa_assert_se(gate.sequence == proof_a.sequence);
+	spa_assert_se(gate.nonce == proof_a.nonce);
+	spa_assert_se(!source_marker_release_command_matches(
+			&marker, &proof_a));
+
+	proof_b = proof_a;
+	proof_b.marker_sequence = marker.sequence;
+	memcpy(proof_b.marker_value, marker.value,
+			sizeof(proof_b.marker_value));
+	spa_assert_se(source_marker_release_command_matches(
+			&marker, &proof_b));
+
+	proof_b.marker_sequence++;
+	spa_assert_se(!source_marker_release_command_matches(
+			&marker, &proof_b));
+	proof_b.marker_sequence--;
+	proof_b.marker_value[sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1] =
+		proof_b.marker_value[sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1] == '0'
+			? '1' : '0';
+	spa_assert_se(!source_marker_release_command_matches(
+			&marker, &proof_b));
+	marker.state = RAOP_SOURCE_MARKER_PENDING;
+	spa_assert_se(!source_marker_release_command_matches(
+			&marker, &proof_a));
+}
+
+int main(void)
+{
+	test_state_machine();
+	test_value_validation();
+	test_error_validation_and_properties();
+	test_client_node_full_dict_tombstones();
+	test_rtp_info_request_headers();
+	test_dmap_encoding();
+	test_command_parser_and_admission();
+	test_release_marker_binding();
+	return 0;
+}
