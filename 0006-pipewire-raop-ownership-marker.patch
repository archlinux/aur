+static void test_dmap_encoding(void)
+{
+	static const char marker[] =
+		"stpw1:0123456789abcdef0123456789abcdef";
+	uint8_t dmap[RAOP_SOURCE_MARKER_DMAP_SIZE];
+	size_t size = 0, offset;
+
+	memset(dmap, 0xcc, sizeof(dmap));
+	spa_assert_se(source_marker_encode_dmap(marker, dmap,
+			sizeof(dmap), &size) == 0);
+	spa_assert_se(size == RAOP_SOURCE_MARKER_DMAP_SIZE);
+	spa_assert_se(memcmp(dmap, "mlit", 4) == 0);
+	spa_assert_se(get_be32(dmap + 4) == size - 8);
+
+	offset = 8;
+	spa_assert_se(memcmp(dmap + offset, "minm", 4) == 0);
+	spa_assert_se(get_be32(dmap + offset + 4) == strlen(marker));
+	spa_assert_se(memcmp(dmap + offset + 8, marker,
+			strlen(marker)) == 0);
+	offset += 8 + strlen(marker);
+
+	spa_assert_se(memcmp(dmap + offset, "asar", 4) == 0);
+	spa_assert_se(get_be32(dmap + offset + 4) ==
+			strlen(RAOP_SOURCE_MARKER_ARTIST));
+	spa_assert_se(memcmp(dmap + offset + 8,
+			RAOP_SOURCE_MARKER_ARTIST,
+			strlen(RAOP_SOURCE_MARKER_ARTIST)) == 0);
+	offset += 8 + strlen(RAOP_SOURCE_MARKER_ARTIST);
+
+	spa_assert_se(memcmp(dmap + offset, "asal", 4) == 0);
+	spa_assert_se(get_be32(dmap + offset + 4) == strlen(marker));
+	spa_assert_se(memcmp(dmap + offset + 8, marker,
+			strlen(marker)) == 0);
+	offset += 8 + strlen(marker);
+	spa_assert_se(offset == size);
+
+	spa_assert_se(source_marker_encode_dmap(marker, dmap,
+			sizeof(dmap) - 1, &size) == -ENOSPC);
+	spa_assert_se(source_marker_encode_dmap("invalid", dmap,
+			sizeof(dmap), &size) == -EINVAL);
+}
