+static void test_state_machine(void)
+{
+	static const uint8_t first[16] = {
+		0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+		0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+	};
+	static const uint8_t second[16] = {
+		0xf0, 0xe1, 0xd2, 0xc3, 0xb4, 0xa5, 0x96, 0x87,
+		0x78, 0x69, 0x5a, 0x4b, 0x3c, 0x2d, 0x1e, 0x0f,
+	};
+	struct raop_source_marker marker;
+	uint64_t sequence;
+
+	source_marker_init(&marker);
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_NONE);
+	spa_assert_se(spa_streq(source_marker_state_name(marker.state), "none"));
+	spa_assert_se(marker.sequence == 1);
+	spa_assert_se(marker.value[0] == '\0');
+	spa_assert_se(marker.error[0] == '\0');
+
+	spa_assert_se(source_marker_begin(&marker, first) == 0);
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_PENDING);
+	spa_assert_se(marker.sequence == 2);
+	spa_assert_se(spa_streq(marker.value,
+			"stpw1:000102030405060708090a0b0c0d0e0f"));
+	spa_assert_se(marker.error[0] == '\0');
+	sequence = marker.sequence;
+	spa_assert_se(source_marker_begin(&marker, second) == -EBUSY);
+	spa_assert_se(!source_marker_confirm(&marker, sequence + 1));
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_PENDING);
+	spa_assert_se(source_marker_confirm(&marker, sequence));
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_CONFIRMED);
+
+	spa_assert_se(source_marker_begin(&marker, first) == -EALREADY);
+	spa_assert_se(marker.sequence == sequence);
+	spa_assert_se(source_marker_begin(&marker, second) == 0);
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_PENDING);
+	spa_assert_se(marker.sequence == sequence + 1);
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_ERROR,
+			"RAOP source marker RTSP status 400"));
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_ERROR);
+	spa_assert_se(marker.sequence == sequence + 2);
+	spa_assert_se(marker.value[0] == '\0');
+	spa_assert_se(spa_streq(marker.error,
+			"RAOP source marker RTSP status 400"));
+	spa_assert_se(source_marker_begin(&marker, first) == -EPERM);
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_NONE, NULL));
+	spa_assert_se(marker.state == RAOP_SOURCE_MARKER_NONE);
+	spa_assert_se(marker.sequence == sequence + 3);
+	spa_assert_se(marker.error[0] == '\0');
+	spa_assert_se(!source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_NONE, NULL));
+
+	marker.sequence = UINT64_MAX;
+	spa_assert_se(source_marker_begin(&marker, first) == 0);
+	spa_assert_se(marker.sequence == 1);
+}
