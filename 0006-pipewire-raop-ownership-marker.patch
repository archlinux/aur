+			&SPA_DICT_INIT(items, SPA_N_ELEMENTS(items))) > 0);
+	spa_assert_se(pw_properties_update(remote, &local->dict) > 0);
+	spa_assert_se(spa_streq(pw_properties_get(remote,
+			"raop.source.marker.state"), "confirmed"));
+	spa_assert_se(spa_streq(pw_properties_get(remote,
+			"raop.source.marker.value"), marker.value));
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_NONE, NULL));
+	source_marker_format_properties(&marker, sequence, items);
+	spa_assert_se(pw_properties_update(local,
+			&SPA_DICT_INIT(items, SPA_N_ELEMENTS(items))) > 0);
+	spa_assert_se(pw_properties_update(remote, &local->dict) > 0);
+	spa_assert_se(spa_streq(pw_properties_get(remote,
+			"raop.source.marker.state"), "none"));
