+static void test_error_validation_and_properties(void)
+{
+	static const char exact[] = "RAOP source marker RTSP status 400";
+	char max_error[RAOP_SOURCE_MARKER_ERROR_SIZE];
+	char long_error[RAOP_SOURCE_MARKER_ERROR_SIZE + 1];
+	char sequence[32];
+	struct spa_dict_item items[5];
+	struct raop_source_marker marker;
+	struct spa_dict dict;
+
+	spa_assert_se(source_marker_error_valid(exact));
+	spa_assert_se(!source_marker_error_valid(NULL));
+	spa_assert_se(!source_marker_error_valid(""));
+	spa_assert_se(!source_marker_error_valid("line one\nline two"));
+	memset(max_error, 'x', sizeof(max_error) - 1);
+	max_error[sizeof(max_error) - 1] = '\0';
+	spa_assert_se(source_marker_error_valid(max_error));
+	memset(long_error, 'x', sizeof(long_error) - 1);
+	long_error[sizeof(long_error) - 1] = '\0';
+	spa_assert_se(!source_marker_error_valid(long_error));
+
+	source_marker_init(&marker);
+	source_marker_format_properties(&marker, sequence, items);
+	dict = SPA_DICT_INIT(items, SPA_N_ELEMENTS(items));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.state"), "none"));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.value"), ""));
+	spa_assert_se(spa_dict_lookup(&dict,
+			"raop.source.marker.error") == NULL);
+
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_ERROR, exact));
+	source_marker_format_properties(&marker, sequence, items);
+	dict = SPA_DICT_INIT(items, SPA_N_ELEMENTS(items));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.state"), "error"));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.error"), exact));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.value"), ""));
+	spa_assert_se(!source_marker_can_cleanup(&marker));
+
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_ERROR, long_error));
+	spa_assert_se(spa_streq(marker.error,
+			RAOP_SOURCE_MARKER_ERROR_FALLBACK));
+	spa_assert_se(source_marker_invalidate(&marker,
+			RAOP_SOURCE_MARKER_NONE, NULL));
+	spa_assert_se(source_marker_can_cleanup(&marker));
+	source_marker_format_properties(&marker, sequence, items);
+	dict = SPA_DICT_INIT(items, SPA_N_ELEMENTS(items));
+	spa_assert_se(spa_streq(spa_dict_lookup(&dict,
+			"raop.source.marker.value"), ""));
+	spa_assert_se(spa_dict_lookup(&dict,
+			"raop.source.marker.error") == NULL);
+}
