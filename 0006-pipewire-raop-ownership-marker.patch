+struct data_loop_invoke {
+	rtp_stream_data_loop_func_t func;
+	void *data;
+};
+
+static int do_invoke_data_loop(struct spa_loop *loop, bool async,
+		uint32_t seq, const void *data, size_t size, void *user_data)
+{
+	const struct data_loop_invoke *invoke = data;
+
+	(void)loop;
+	(void)async;
+	(void)seq;
+	(void)user_data;
+
+	if (invoke == NULL || size != sizeof(*invoke) || invoke->func == NULL)
+		return -EINVAL;
+	return invoke->func(invoke->data);
+}
+
+int rtp_stream_invoke_data_loop(struct rtp_stream *s,
+		rtp_stream_data_loop_func_t func, void *data)
+{
+	struct impl *impl = (struct impl*)s;
+	const struct data_loop_invoke invoke = {
+		.func = func,
+		.data = data,
+	};
+
+	if (impl == NULL || func == NULL || impl->data_loop == NULL)
+		return -EINVAL;
+	if (impl->stream == NULL ||
+			pw_stream_get_data_loop(impl->stream) != impl->data_loop)
+		return -EXDEV;
+	/*
+	 * With no separate data loop, the control callback already serializes
+	 * against packet callbacks. Otherwise take the target loop's recursive
+	 * dispatch lock; this cannot leave a queued callback behind on failure.
+	 */
+	if (pw_loop_check(impl->data_loop) > 0)
+		return func(data);
+	return pw_loop_locked(impl->data_loop, do_invoke_data_loop, 0,
+			&invoke, sizeof(invoke), NULL);
+}
