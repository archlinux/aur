+#define RAOP_SOURCE_MARKER_CONTRACT	"1"
+#define RAOP_SOURCE_MARKER_ROTATE_COMMAND	"raop-source-marker-rotate"
+#define RAOP_SOURCE_MARKER_PREFIX	"stpw1:"
+#define RAOP_SOURCE_MARKER_HEX_LENGTH	32
+#define RAOP_SOURCE_MARKER_LENGTH	\
+	(sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1 + RAOP_SOURCE_MARKER_HEX_LENGTH)
+#define RAOP_SOURCE_MARKER_VALUE_SIZE	(RAOP_SOURCE_MARKER_LENGTH + 1)
+#define RAOP_SOURCE_MARKER_ERROR_MAX_LENGTH	160
+#define RAOP_SOURCE_MARKER_ERROR_SIZE	\
+	(RAOP_SOURCE_MARKER_ERROR_MAX_LENGTH + 1)
+#define RAOP_SOURCE_MARKER_ERROR_FALLBACK	\
+	"RAOP source marker failure reason unavailable"
+#define RAOP_SOURCE_MARKER_ARTIST	"soundtouch-pipewire"
+#define RAOP_SOURCE_MARKER_DMAP_SIZE	\
+	(8 + (8 + RAOP_SOURCE_MARKER_LENGTH) + \
+	 (8 + sizeof(RAOP_SOURCE_MARKER_ARTIST) - 1) + \
+	 (8 + RAOP_SOURCE_MARKER_LENGTH))
+
+enum raop_source_marker_state {
+	RAOP_SOURCE_MARKER_NONE,
+	RAOP_SOURCE_MARKER_PENDING,
+	RAOP_SOURCE_MARKER_CONFIRMED,
+	RAOP_SOURCE_MARKER_ERROR,
+};
+
+struct raop_source_marker {
+	enum raop_source_marker_state state;
+	uint64_t sequence;
+	char value[RAOP_SOURCE_MARKER_VALUE_SIZE];
+	char error[RAOP_SOURCE_MARKER_ERROR_SIZE];
+};
+
+struct raop_source_marker_rotate_command {
+	uint64_t marker_sequence;
+	uint64_t gate_sequence;
+	uint64_t gate_nonce;
+};
+
+static uint64_t source_marker_next_sequence(uint64_t sequence)
+{
+	if (++sequence == 0)
+		sequence++;
+	return sequence;
+}
+
+static const char *source_marker_state_name(
+		enum raop_source_marker_state state)
+{
+	switch (state) {
+	case RAOP_SOURCE_MARKER_NONE:
+		return "none";
+	case RAOP_SOURCE_MARKER_PENDING:
+		return "pending";
+	case RAOP_SOURCE_MARKER_CONFIRMED:
+		return "confirmed";
+	case RAOP_SOURCE_MARKER_ERROR:
+		return "error";
+	}
+	return "error";
+}
+
+static bool source_marker_value_valid(const char *value)
+{
+	const unsigned char *p;
+
+	if (value == NULL || strlen(value) != RAOP_SOURCE_MARKER_LENGTH ||
+			strncmp(value, RAOP_SOURCE_MARKER_PREFIX,
+				sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1) != 0)
+		return false;
+	p = (const unsigned char *)value +
+		sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1;
+	for (; *p != '\0'; p++)
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'f')))
+			return false;
+	return true;
+}
+
+static bool source_marker_error_valid(const char *error)
+{
+	const unsigned char *p;
+	size_t length;
+
+	if (error == NULL || (length = strlen(error)) == 0 ||
+			length > RAOP_SOURCE_MARKER_ERROR_MAX_LENGTH)
+		return false;
+	for (p = (const unsigned char *)error; *p != '\0'; p++)
+		if (*p < 0x20 || *p > 0x7e)
+			return false;
+	return true;
+}
+
+static void source_marker_init(struct raop_source_marker *marker)
+{
+	marker->state = RAOP_SOURCE_MARKER_NONE;
+	marker->sequence = 1;
+	marker->value[0] = '\0';
+	marker->error[0] = '\0';
+}
+
+static int source_marker_begin(struct raop_source_marker *marker,
+		const uint8_t random[16])
+{
+	static const char hex[] = "0123456789abcdef";
+	char value[RAOP_SOURCE_MARKER_VALUE_SIZE];
+	uint32_t i;
+
+	if (marker == NULL || random == NULL)
+		return -EINVAL;
+	if (marker->state == RAOP_SOURCE_MARKER_PENDING)
+		return -EBUSY;
+	if (marker->state == RAOP_SOURCE_MARKER_ERROR)
+		return -EPERM;
+
+	memcpy(value, RAOP_SOURCE_MARKER_PREFIX,
+			sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1);
+	for (i = 0; i < 16; i++) {
+		value[sizeof(RAOP_SOURCE_MARKER_PREFIX) - 1 + 2 * i] =
+			hex[random[i] >> 4];
+		value[sizeof(RAOP_SOURCE_MARKER_PREFIX) + 2 * i] =
+			hex[random[i] & 0x0f];
+	}
+	value[RAOP_SOURCE_MARKER_LENGTH] = '\0';
+	if (spa_streq(value, marker->value))
+		return -EALREADY;
+
+	marker->sequence = source_marker_next_sequence(marker->sequence);
+	marker->state = RAOP_SOURCE_MARKER_PENDING;
+	memcpy(marker->value, value, sizeof(value));
+	marker->error[0] = '\0';
+	return 0;
+}
+
+static bool source_marker_confirm(struct raop_source_marker *marker,
+		uint64_t sequence)
+{
+	if (marker == NULL ||
+			marker->state != RAOP_SOURCE_MARKER_PENDING ||
+			marker->sequence != sequence)
+		return false;
+	marker->state = RAOP_SOURCE_MARKER_CONFIRMED;
+	return true;
+}
+
+static bool source_marker_invalidate(struct raop_source_marker *marker,
+		enum raop_source_marker_state state, const char *reason)
+{
+	const char *error = "";
+	size_t error_size = 1;
+
+	if (marker == NULL ||
+			(state != RAOP_SOURCE_MARKER_NONE &&
+			 state != RAOP_SOURCE_MARKER_ERROR))
+		return false;
+	if (state == RAOP_SOURCE_MARKER_ERROR) {
+		error = source_marker_error_valid(reason) ? reason :
+			RAOP_SOURCE_MARKER_ERROR_FALLBACK;
+		error_size = strlen(error) + 1;
+	}
+	if (marker->state == state && marker->value[0] == '\0' &&
+			spa_streq(marker->error, error))
+		return false;
+	marker->sequence = source_marker_next_sequence(marker->sequence);
+	marker->state = state;
+	marker->value[0] = '\0';
+	memcpy(marker->error, error, error_size);
+	return true;
+}
+
+static bool source_marker_can_cleanup(const struct raop_source_marker *marker)
+{
+	return marker != NULL &&
+		marker->state != RAOP_SOURCE_MARKER_ERROR;
+}
+
+static void source_marker_format_properties(
+		const struct raop_source_marker *marker,
+		char sequence[32], struct spa_dict_item items[5])
+{
+	const char *value = "", *error = NULL;
+
+	spa_scnprintf(sequence, 32, "%" PRIu64, marker->sequence);
+	if (marker->state == RAOP_SOURCE_MARKER_PENDING ||
+			marker->state == RAOP_SOURCE_MARKER_CONFIRMED)
+		value = marker->value;
+	else if (marker->state == RAOP_SOURCE_MARKER_ERROR)
+		error = marker->error;
+	items[0] = SPA_DICT_ITEM_INIT("raop.source.marker.contract",
+			RAOP_SOURCE_MARKER_CONTRACT);
+	items[1] = SPA_DICT_ITEM_INIT("raop.source.marker.state",
+			source_marker_state_name(marker->state));
+	items[2] = SPA_DICT_ITEM_INIT("raop.source.marker.sequence",
+			sequence);
+	items[3] = SPA_DICT_ITEM_INIT("raop.source.marker.value", value);
+	items[4] = SPA_DICT_ITEM_INIT("raop.source.marker.error", error);
+}
+
+static struct pw_properties *source_marker_request_headers(
+		const struct spa_dict *base_headers, uint32_t rtptime)
+{
+	struct pw_properties *headers;
+
+	headers = base_headers != NULL ?
+		pw_properties_new_dict(base_headers) :
+		pw_properties_new(NULL, NULL);
+	if (headers == NULL)
+		return NULL;
+	if (pw_properties_setf(headers, "RTP-Info",
+			"rtptime=%" PRIu32, rtptime) < 0) {
+		pw_properties_free(headers);
+		return NULL;
+	}
+	return headers;
+}
+
+static void source_marker_put_be32(uint8_t *p, uint32_t value)
+{
+	p[0] = (uint8_t)(value >> 24);
+	p[1] = (uint8_t)(value >> 16);
+	p[2] = (uint8_t)(value >> 8);
+	p[3] = (uint8_t)value;
+}
+
+static uint8_t *source_marker_put_dmap_tag(uint8_t *p, const char tag[4],
+		const void *value, uint32_t length)
+{
+	memcpy(p, tag, 4);
+	source_marker_put_be32(p + 4, length);
+	memcpy(p + 8, value, length);
+	return p + 8 + length;
+}
+
+static int source_marker_encode_dmap(const char *marker,
+		uint8_t *buffer, size_t size, size_t *encoded_size)
+{
+	const uint32_t marker_length = RAOP_SOURCE_MARKER_LENGTH;
+	const uint32_t artist_length =
+		sizeof(RAOP_SOURCE_MARKER_ARTIST) - 1;
+	uint8_t *p;
+
+	if (!source_marker_value_valid(marker) ||
+			buffer == NULL || encoded_size == NULL)
+		return -EINVAL;
+	if (size < RAOP_SOURCE_MARKER_DMAP_SIZE)
+		return -ENOSPC;
+
+	memcpy(buffer, "mlit", 4);
+	source_marker_put_be32(buffer + 4,
+			RAOP_SOURCE_MARKER_DMAP_SIZE - 8);
+	p = source_marker_put_dmap_tag(buffer + 8, "minm",
+			marker, marker_length);
+	p = source_marker_put_dmap_tag(p, "asar",
+			RAOP_SOURCE_MARKER_ARTIST, artist_length);
+	p = source_marker_put_dmap_tag(p, "asal",
+			marker, marker_length);
+	*encoded_size = p - buffer;
+	return *encoded_size == RAOP_SOURCE_MARKER_DMAP_SIZE ? 0 : -EIO;
+}
+
+static bool source_marker_parse_json_string(const char *value, int len,
+		char *buffer, size_t size)
+{
+	return len > 0 && spa_json_is_string(value, len) &&
+		spa_json_parse_stringn(value, len, buffer, size) > 0;
+}
+
+static bool source_marker_decimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (*p == '\0')
+		return false;
+	for (; *p != '\0'; p++)
+		if (*p < '0' || *p > '9')
+			return false;
+	return true;
+}
+
+static bool source_marker_lowercase_hex_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (strlen(value) != 16)
+		return false;
+	for (; *p != '\0'; p++)
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'f')))
+			return false;
+	return true;
+}
+
+static int source_marker_parse_rotate_command(const char *json,
+		struct raop_source_marker_rotate_command *command)
+{
+	struct spa_json top, iter;
+	const char *object, *value;
+	char key[64], id[64], marker_sequence[32], gate_sequence[32],
+		gate_nonce[19];
+	bool have_id = false, have_marker_sequence = false;
+	bool have_gate_sequence = false, have_gate_nonce = false;
+	bool have_unknown = false;
+	int object_len, len;
+
+	if (json == NULL || command == NULL)
+		return -EINVAL;
+	spa_json_init(&top, json, strlen(json));
+	object_len = spa_json_next(&top, &object);
+	if (object_len <= 0 || !spa_json_is_object(object, object_len))
+		return -EINVAL;
+	object_len = spa_json_container_len(&top, object, object_len);
+	if (object_len <= 0 ||
+			spa_json_next(&top, &value) != 0 ||
+			spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+
+	while ((len = spa_json_object_next(&iter, key, sizeof(key),
+			&value)) > 0) {
+		if (spa_streq(key, "command.id")) {
+			if (have_id || !source_marker_parse_json_string(value,
+					len, id, sizeof(id)))
+				return -EINVAL;
+			have_id = true;
+		} else if (spa_streq(key, "marker.sequence")) {
+			if (have_marker_sequence ||
+					!source_marker_parse_json_string(value, len,
+						marker_sequence,
+						sizeof(marker_sequence)))
+				return -EINVAL;
+			have_marker_sequence = true;
+		} else if (spa_streq(key, "gate.sequence")) {
+			if (have_gate_sequence ||
+					!source_marker_parse_json_string(value, len,
+						gate_sequence,
+						sizeof(gate_sequence)))
+				return -EINVAL;
+			have_gate_sequence = true;
+		} else if (spa_streq(key, "gate.nonce")) {
+			if (have_gate_nonce ||
+					!source_marker_parse_json_string(value, len,
+						gate_nonce,
+						sizeof(gate_nonce)))
+				return -EINVAL;
+			have_gate_nonce = true;
+		} else {
+			have_unknown = true;
+		}
+	}
+	if (len < 0 || !have_id)
+		return -EINVAL;
+	if (!spa_streq(id, RAOP_SOURCE_MARKER_ROTATE_COMMAND))
+		return -ENOENT;
+	if (!have_marker_sequence || !have_gate_sequence ||
+			!have_gate_nonce || have_unknown ||
+			!source_marker_decimal_string(marker_sequence) ||
+			!source_marker_decimal_string(gate_sequence) ||
+			!source_marker_lowercase_hex_string(gate_nonce) ||
+			!spa_atou64(marker_sequence,
+				&command->marker_sequence, 10) ||
+			command->marker_sequence == 0 ||
+			!spa_atou64(gate_sequence,
+				&command->gate_sequence, 10) ||
+			command->gate_sequence == 0 ||
+			!spa_atou64(gate_nonce, &command->gate_nonce, 16) ||
+			command->gate_nonce == 0)
+		return -EINVAL;
+	return 0;
+}
+
+static bool source_marker_rotate_command_matches(
+		const struct raop_source_marker *marker,
+		const struct raop_source_marker_rotate_command *command,
+		const struct raop_safety_gate *gate)
+{
+	return marker != NULL && command != NULL && gate != NULL &&
+		marker->state == RAOP_SOURCE_MARKER_CONFIRMED &&
+		command->marker_sequence == marker->sequence &&
+		command->gate_sequence == gate->sequence &&
+		command->gate_nonce == gate->nonce &&
+		raop_safety_gate_is_closed(gate) &&
+		(gate->reasons & RAOP_SAFETY_GATE_ACTIVATION) != 0 &&
+		(gate->reasons & RAOP_SAFETY_GATE_ERROR) == 0;
+}
+
+static bool source_marker_release_command_matches(
+		const struct raop_source_marker *marker,
+		const struct raop_safety_gate_command *command)
+{
+	return marker != NULL && command != NULL &&
+		marker->state == RAOP_SOURCE_MARKER_CONFIRMED &&
+		command->marker_sequence == marker->sequence &&
+		spa_streq(command->marker_value, marker->value);
+}
