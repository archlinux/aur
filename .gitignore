# Ignore the package build files and intermediate files
*.tar.zst
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar

# Ignore the compiled package (.pkg) files
*.pkg.*

# Ignore the output of `makepkg` (log and temp files)
*.log
*.pacnew
*.pacsave

# Ignore files from version control systems
.DS_Store
Thumbs.db
.git/

# Ignore backup and swap files
*~
*.swp
*.bak

# Ignore folders and files generated by the build process
src/
pkg/
clustertool.LICENSE
