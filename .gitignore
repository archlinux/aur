# makepkg working directories
/src/
/pkg/

# upstream source clone (from the source=("ffmpeg::git+...") VCS source)
/ffmpeg/

# built packages and their signatures (any compression makepkg supports)
*.pkg.tar
*.pkg.tar.gz
*.pkg.tar.xz
*.pkg.tar.zst
*.pkg.tar*.sig

# stale source tarballs and VCS sources downloaded into the AUR repo
*.tar.gz
*.tar.xz
*.tar.bz2
*.tar.zst
*.tar

# makepkg --log output (build/check/package/prepare/pkgver logs)
*.log

# patch / merge leftovers and editor backups
*.orig
*.rej
*.bak
*~
*.swp
*.swo
