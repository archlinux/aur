# Ignore everything by default
*

# Whitelist the essentials
!.gitignore
!.SRCINFO
!PKGBUILD

# Whitelist auxiliary files
!*.install
!*.patch
!*.diff
!*.service
!*.conf
!*.sysusers
!*.tmpfiles
!LICENSE
!README.md
!CHANGELOG.md
!*.ini
!*.txt

# Downloaded source files (downloaded by PKGBUILD)
logo.png
icon.png
opentrace.desktop
opentrace-bin-*
