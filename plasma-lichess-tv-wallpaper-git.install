post_install() {
  cat <<EOF

plasma-lichess-tv-wallpaper-git is installed.

Next steps:
  1. Desktop settings → Wallpaper → choose "Lichess TV"
  2. Optionally add the "Lichess TV Controller" panel widget
  3. Optionally enable smart pause (does not run as root):
       lichess-tv-wallpaperctl enable-smart-pause

This package is unofficial and unaffiliated with Lichess or KDE.

EOF
}

# Best-effort cleanup of leftovers from a prior `sudo cmake --install`.
# Note: pacman checks file conflicts *before* scriptlets run, so a one-time
# manual remove or `--overwrite` may still be needed for the first upgrade
# after a developer /usr install. This cleans orphans when the script does run.
_lichesstv_remove_unowned() {
  local path
  for path in "$@"; do
    if [[ -e "$path" ]] && ! pacman -Qo "$path" &>/dev/null; then
      rm -f "$path"
    fi
  done
}

pre_install() {
  _lichesstv_remove_unowned \
    /usr/share/plasma/wallpapers/io.github.yummiergravy.LichessTvWallpaper/contents/ui/GameMetaPanel.qml \
    /usr/share/plasma/wallpapers/io.github.yummiergravy.LichessTvWallpaper/contents/ui/PlayersBar.qml \
    /usr/share/plasma/wallpapers/io.github.yummiergravy.LichessTvWallpaper/contents/ui/PlayerCard.qml
}

pre_upgrade() {
  pre_install
}

post_upgrade() {
  post_install
}
