post_install() {
    cat <<'EOF'

forge-code-bin installed

Binaries
  forge              canonical CLI
  forge-code         symlink to forge
  forge-code-launcher  non-TTY / desktop entry helper

This package (vs bare forgecode / forgecode-bin)
  zsh plugin         /usr/share/zsh/plugins/forge-code/forge-code.zsh
  bash completion    /usr/share/bash-completion/completions/forge-code
  desktop entry      forge-code.desktop
  AppArmor profile   /usr/share/apparmor/profiles/forge-code.apparmor
  version check      /usr/share/forge-code-bin/check-version.sh
  fzf / bat / fd     optional (optdepends), not hard dependencies

First run
  forge provider login
  forge

ZSH (: prefix commands)
  source /usr/share/zsh/plugins/forge-code/forge-code.zsh
  # or with oh-my-zsh: plugins+=(forge-code) after linking/copying the plugin dir

AppArmor (optional)
  sudo cp /usr/share/apparmor/profiles/forge-code.apparmor /etc/apparmor.d/forge-code
  sudo aa-enforce /etc/apparmor.d/forge-code

Docs
  forge --help
  https://forgecode.dev/

EOF
}

post_upgrade() {
    post_install
    cat <<'EOF'
Upgrade note: config and conversations under ~/.forge are left alone.
If the CLI misbehaves after upgrade:
  rm -rf ~/.forge/cache

EOF
}

post_remove() {
    cat <<'EOF'

forge-code-bin removed

ZSH: drop forge-code from plugins=() or remove any source line for
  /usr/share/zsh/plugins/forge-code/forge-code.zsh

User data (optional wipe):
  rm -rf ~/.forge ~/.config/forge-code

EOF
}
