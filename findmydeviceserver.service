[Unit]
Description=Official server for the FindMyDevice (FMD) android app
After=network.target

[Service]
User=findmydevice
Group=findmydevice
ExecStart=/usr/bin/fmdserver serve -c /etc/fmdserver/config.yml -w /usr/share/webapps/fmdserver/ -d /var/lib/fmdserver/db
Restart=on-abort

[Install]
WantedBy=multi-user.target
