post_install() {
    echo -e "\e[1;36m===========================================================\e[0m"
    echo -e "\e[1;32m SerphhEnv installed successfully!\e[0m"
    echo -e "\e[1;36m===========================================================\e[0m"
    echo -e " To enable automatic environment activation, run this command"
    echo -e " once as your normal user:"
    echo -e ""
    echo -e "   \e[1;33mserphhenv --setup\e[0m"
    echo -e ""
    echo -e "\e[1;36m===========================================================\e[0m"
}

post_upgrade() {
    post_install
}
