#!/usr/bin/env python3

import os
import subprocess
import sys

def main():
    # 检查当前目录是否包含 PKGBUILD 文件
    if not os.path.exists('PKGBUILD'):
        print("No PKGBUILD file found. Skipping .SRCINFO update.")
        return 0

    try:
        # 执行 makepkg 命令生成 .SRCINFO
        result = subprocess.run(
            ['makepkg', '--printsrcinfo'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if result.returncode != 0:
            print(f"Error running makepkg: {result.stderr}")
            return 1

        # 写入 .SRCINFO 文件
        with open('.SRCINFO', 'w') as srcinfo_file:
            srcinfo_file.write(result.stdout)

        print(".SRCINFO updated successfully.")

        # 将 .SRCINFO 添加到提交中
        add_result = subprocess.run(
            ['git', 'add', '.SRCINFO'],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )

        if add_result.returncode != 0:
            print(f"Error adding .SRCINFO to commit: {add_result.stderr}")
            return 1

        print(".SRCINFO added to commit.")
        return 0

    except Exception as e:
        print(f"Unexpected error: {e}")
        return 1

if __name__ == "__main__":
    sys.exit(main())

