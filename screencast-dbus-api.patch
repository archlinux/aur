+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
+"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node>
+  <interface name="org.kde.KWin.ScreenCast.Output">
+    <annotation name="org.gtk.GDBus.DocString" value="Additional interface for output/monitor screencast streams (Type='output')"/>
+
+    <property name="OutputName" type="s" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Name of the output device (e.g., 'HDMI-1', 'eDP-1', 'DP-2')"/>
+    </property>
+
+    <property name="X" type="d" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Output X position in global screen coordinates"/>
+    </property>
+
+    <property name="Y" type="d" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Output Y position in global screen coordinates"/>
+    </property>
+
+    <property name="Width" type="i" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Output width in pixels. Updated when output resolution changes."/>
+    </property>
+
+    <property name="Height" type="i" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Output height in pixels. Updated when output resolution changes."/>
+    </property>
+  </interface>
+</node>
