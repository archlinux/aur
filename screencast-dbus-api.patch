+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QObject>
+
+namespace KWin
+{
+
+class ScreenCastStream;
+
+class ScreenCastStreamDBusWrapper : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.kde.KWin.ScreenCast")
+
+    // Common properties (org.kde.KWin.ScreenCast)
+    Q_PROPERTY(QString Identifier READ identifier CONSTANT)
+    Q_PROPERTY(QString Type READ type CONSTANT)
+    Q_PROPERTY(QString State READ state NOTIFY stateChanged)
+    Q_PROPERTY(QString ConsumerApp READ consumerApp NOTIFY consumerChanged)
+    Q_PROPERTY(quint32 ConsumerPID READ consumerPID NOTIFY consumerChanged)
+
+    // Window properties (org.kde.KWin.ScreenCast.Window)
+    Q_PROPERTY(QString WindowId READ windowId CONSTANT)
+    Q_PROPERTY(QString WindowClass READ windowClass CONSTANT)
+    Q_PROPERTY(QString ResourceName READ resourceName CONSTANT)
+    Q_PROPERTY(QString Caption READ caption NOTIFY captionChanged)
+
+    // Output properties (org.kde.KWin.ScreenCast.Output)
+    Q_PROPERTY(QString OutputName READ outputName CONSTANT)
+
+    // Shared geometry properties (Window/Output/Region)
+    Q_PROPERTY(double X READ x NOTIFY rectChanged)
+    Q_PROPERTY(double Y READ y NOTIFY rectChanged)
+    Q_PROPERTY(double Width READ width NOTIFY rectChanged)
+    Q_PROPERTY(double Height READ height NOTIFY rectChanged)
+
+    // Region properties (org.kde.KWin.ScreenCast.Region)
+    Q_PROPERTY(double Scale READ scale CONSTANT)
+
+public:
+    explicit ScreenCastStreamDBusWrapper(ScreenCastStream *stream, QObject *parent = nullptr);
+    ~ScreenCastStreamDBusWrapper() override;
+
+    ScreenCastStream *stream() const
+    {
+        return m_stream;
+    }
+
+    QString identifier() const;
+    QString type() const;
+    QString state() const;
+    QString consumerApp() const;
+    quint32 consumerPID() const;
+
+    // Window-specific accessors (used by WindowStreamAdaptor)
+    QString windowId() const;
+    QString windowClass() const;
+    QString resourceName() const;
+    QString caption() const;
+
+    // Output-specific accessor (used by OutputStreamAdaptor)
+    QString outputName() const;
+
+    // Shared geometry accessors (used by Window/Output/Region adaptors)
+    double x() const;
+    double y() const;
+    double width() const;
+    double height() const;
+
+    // Region-specific accessor (used by RegionStreamAdaptor)
+    double scale() const;
+
+public Q_SLOTS:
+    void Stop();
+
+Q_SIGNALS:
+    void stateChanged();
+    void consumerChanged();
+    void captionChanged();
+    void rectChanged();
+    void geometryChanged();
+
+private:
+    ScreenCastStream *m_stream;
+};
+
+} // namespace KWin
