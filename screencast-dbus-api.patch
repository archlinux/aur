diff --git a/src/plugins/screencast/screencaststreamwrapper.cpp b/src/plugins/screencast/screencaststreamwrapper.cpp
new file mode 100644
index 0000000000..3af1e1ea92
--- /dev/null
+++ b/src/plugins/screencast/screencaststreamwrapper.cpp
@@ -0,0 +1,187 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencaststreamwrapper.h"
+#include "outputscreencastsource.h"
+#include "regionscreencastsource.h"
+#include "screencastsource.h"
+#include "screencaststream.h"
+#include "windowscreencastsource.h"
+
+namespace KWin
+{
+
+ScreenCastStreamDBusWrapper::ScreenCastStreamDBusWrapper(ScreenCastStream *stream, QObject *parent)
+    : QObject(parent)
+    , m_stream(stream)
+{
+    connect(m_stream, &ScreenCastStream::stateChanged, this, &ScreenCastStreamDBusWrapper::stateChanged);
+    connect(m_stream, &ScreenCastStream::consumerConnected, this, &ScreenCastStreamDBusWrapper::consumerChanged);
+    connect(m_stream, &ScreenCastStream::consumerDisconnected, this, &ScreenCastStreamDBusWrapper::consumerChanged);
+
+    ScreenCastSource *source = m_stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        connect(windowSource, &WindowScreenCastSource::rectChanged, this, &ScreenCastStreamDBusWrapper::rectChanged);
+        connect(windowSource, &WindowScreenCastSource::captionChanged, this, &ScreenCastStreamDBusWrapper::captionChanged);
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        connect(outputSource, &OutputScreenCastSource::geometryChanged, this, &ScreenCastStreamDBusWrapper::geometryChanged);
+    }
+}
+
+ScreenCastStreamDBusWrapper::~ScreenCastStreamDBusWrapper() = default;
+
+QString ScreenCastStreamDBusWrapper::identifier() const
+{
+    return QString::number(m_stream->objectSerial());
+}
+
+QString ScreenCastStreamDBusWrapper::type() const
+{
+    ScreenCastSource *source = m_stream->source();
+    if (!source) {
+        return QString();
+    }
+
+    if (qobject_cast<WindowScreenCastSource *>(source)) {
+        return QStringLiteral("window");
+    } else if (qobject_cast<OutputScreenCastSource *>(source)) {
+        return QStringLiteral("output");
+    } else if (qobject_cast<RegionScreenCastSource *>(source)) {
+        return QStringLiteral("region");
+    }
+    return QStringLiteral("unknown");
+}
+
+QString ScreenCastStreamDBusWrapper::state() const
+{
+    return m_stream->streamState();
+}
+
+QString ScreenCastStreamDBusWrapper::consumerApp() const
+{
+    return m_stream->consumerApp();
+}
+
+quint32 ScreenCastStreamDBusWrapper::consumerPID() const
+{
+    return m_stream->consumerPID();
+}
+
+void ScreenCastStreamDBusWrapper::Stop()
+{
+    m_stream->close();
+}
+
+// Window-specific accessors
+
+QString ScreenCastStreamDBusWrapper::windowId() const
+{
+    if (auto *source = qobject_cast<WindowScreenCastSource *>(m_stream->source())) {
+        return source->windowId();
+    }
+    return QString();
+}
+
+QString ScreenCastStreamDBusWrapper::windowClass() const
+{
+    if (auto *source = qobject_cast<WindowScreenCastSource *>(m_stream->source())) {
+        return source->windowClass();
+    }
+    return QString();
+}
+
+QString ScreenCastStreamDBusWrapper::resourceName() const
+{
+    if (auto *source = qobject_cast<WindowScreenCastSource *>(m_stream->source())) {
+        return source->resourceName();
+    }
+    return QString();
+}
+
+QString ScreenCastStreamDBusWrapper::caption() const
+{
+    if (auto *source = qobject_cast<WindowScreenCastSource *>(m_stream->source())) {
+        return source->caption();
+    }
+    return QString();
+}
+
+// Output-specific accessor
+
+QString ScreenCastStreamDBusWrapper::outputName() const
+{
+    if (auto *source = qobject_cast<OutputScreenCastSource *>(m_stream->source())) {
+        return source->outputName();
+    }
+    return QString();
+}
+
+// Shared geometry accessors
+
+double ScreenCastStreamDBusWrapper::x() const
+{
+    ScreenCastSource *source = m_stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        return windowSource->x();
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        return outputSource->x();
+    } else if (auto *regionSource = qobject_cast<RegionScreenCastSource *>(source)) {
+        return regionSource->x();
+    }
+    return 0;
+}
+
+double ScreenCastStreamDBusWrapper::y() const
+{
+    ScreenCastSource *source = m_stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        return windowSource->y();
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        return outputSource->y();
+    } else if (auto *regionSource = qobject_cast<RegionScreenCastSource *>(source)) {
+        return regionSource->y();
+    }
+    return 0;
+}
+
+double ScreenCastStreamDBusWrapper::width() const
+{
+    ScreenCastSource *source = m_stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        return windowSource->width();
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        return outputSource->width();
+    } else if (auto *regionSource = qobject_cast<RegionScreenCastSource *>(source)) {
+        return regionSource->width();
+    }
+    return 0;
+}
+
+double ScreenCastStreamDBusWrapper::height() const
+{
+    ScreenCastSource *source = m_stream->source();
+    if (auto *windowSource = qobject_cast<WindowScreenCastSource *>(source)) {
+        return windowSource->height();
+    } else if (auto *outputSource = qobject_cast<OutputScreenCastSource *>(source)) {
+        return outputSource->height();
+    } else if (auto *regionSource = qobject_cast<RegionScreenCastSource *>(source)) {
+        return regionSource->height();
+    }
+    return 0;
+}
+
+// Region-specific accessor
+
+double ScreenCastStreamDBusWrapper::scale() const
+{
+    if (auto *source = qobject_cast<RegionScreenCastSource *>(m_stream->source())) {
+        return source->scale();
+    }
+    return 1.0;
+}
+
+} // namespace KWin
+
+#include "moc_screencaststreamwrapper.cpp"
