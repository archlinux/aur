+#include <QObject>
+
+namespace KWin
+{
+
+class ScreencastManager;
+class ScreenCastStream;
+class ScreenCastStreamDBusWrapper;
+
+/**
+ * Implements org.freedesktop.DBus.ObjectManager for active screencast streams.
+ */
+class ScreencastDBusInterface : public QObject, public QDBusContext
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.freedesktop.DBus.ObjectManager")
+
+public:
+    explicit ScreencastDBusInterface(ScreencastManager *manager);
+    ~ScreencastDBusInterface() override;
+
+public Q_SLOTS:
+    QVariantMap GetManagedObjects();
+
+Q_SIGNALS:
+    void InterfacesAdded(const QDBusObjectPath &objectPath, const QVariantMap &interfacesAndProperties);
+    void InterfacesRemoved(const QDBusObjectPath &objectPath, const QStringList &interfaces);
+
+private Q_SLOTS:
+    void onStreamAdded(ScreenCastStream *stream);
+    void onStreamRemoved(ScreenCastStream *stream);
+
+private:
+    QString streamObjectPath(ScreenCastStream *stream) const;
+    QVariantMap streamInterfaces(ScreenCastStream *stream) const;
+    QStringList streamInterfaceNames(ScreenCastStream *stream) const;
+
+    ScreenCastStreamDBusWrapper *createStreamWrapper(ScreenCastStream *stream);
+    bool registerStreamOnDBus(const QString &path, ScreenCastStreamDBusWrapper *wrapper);
+    void connectStreamPropertySignals(ScreenCastStream *stream, const QString &path,
+                                      ScreenCastStreamDBusWrapper *wrapper);
+
+    QHash<ScreenCastStream *, QDBusObjectPath> m_streamPaths;
+    QSet<ScreenCastStream *> m_streamsAnnouncedOnDBus;
+    QHash<ScreenCastStream *, ScreenCastStreamDBusWrapper *> m_streamWrappers;
+    // Interface names captured at registration (while the source is still alive),
+    // so InterfacesRemoved announces exactly what InterfacesAdded did -- by removal
+    // time the stream's source has already been reset.
+    QHash<ScreenCastStream *, QStringList> m_streamInterfaceNames;
+};
+
+} // namespace KWin
