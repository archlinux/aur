diff --git a/src/plugins/screencast/pipewireconsumertracker.cpp b/src/plugins/screencast/pipewireconsumertracker.cpp
new file mode 100644
index 0000000000..6897b95a81
--- /dev/null
+++ b/src/plugins/screencast/pipewireconsumertracker.cpp
@@ -0,0 +1,508 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "pipewireconsumertracker.h"
+
+#include "kwinscreencast_logging.h"
+
+#include <QQueue>
+#include <QVariantMap>
+
+#include <pipewire/keys.h>
+
+#include <algorithm>
+
+namespace KWin
+{
+
+static QVariantMap spaDictToMap(const spa_dict *dict)
+{
+    QVariantMap map;
+    if (!dict) {
+        return map;
+    }
+
+    for (uint32_t i = 0; i < dict->n_items; ++i) {
+        const spa_dict_item &item = dict->items[i];
+        if (!item.key || !item.value) {
+            continue;
+        }
+
+        QString key = QString::fromUtf8(item.key);
+        QString value = QString::fromUtf8(item.value);
+
+        if (!key.isEmpty() && !value.isEmpty()) {
+            map[key] = value;
+        }
+    }
+    return map;
+}
+
+static quint32 parsePID(const QString &pidStr)
+{
+    if (pidStr.isEmpty()) {
+        return 0;
+    }
+    bool ok;
+    quint32 pid = pidStr.toUInt(&ok);
+    return (ok && pid != 0) ? pid : 0;
+}
+
+// PipeWire uses different property keys for PID across versions
+static QString extractPIDString(const QVariantMap &props)
+{
+    QString pidStr = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_ID)).toString();
+    if (pidStr.isEmpty()) {
+        pidStr = props.value(QStringLiteral("application.process.id")).toString();
+    }
+    if (pidStr.isEmpty()) {
+        pidStr = props.value(QStringLiteral("pipewire.sec.pid")).toString();
+    }
+    return pidStr;
+}
+
+struct NodeListenerData
+{
+    PipeWireConsumerTracker *tracker;
+    pw_node *proxy;
+    spa_hook listener;
+    uint32_t nodeId;
+};
+
+struct ClientListenerData
+{
+    PipeWireConsumerTracker *tracker;
+    pw_client *proxy;
+    spa_hook listener;
+    uint32_t clientId;
+};
+
+PipeWireConsumerTracker::PipeWireConsumerTracker(pw_core *core, uint32_t nodeId, QObject *parent)
+    : QObject(parent)
+    , m_core(core)
+    , m_nodeId(nodeId)
+{
+    setupRegistry();
+}
+
+PipeWireConsumerTracker::~PipeWireConsumerTracker()
+{
+    {
+        QMutexLocker lock(&m_clientListenersMutex);
+        for (auto &[clientId, listenerData] : m_clientListeners) {
+            if (listenerData && listenerData->proxy) {
+                spa_hook_remove(&listenerData->listener);
+                pw_proxy_destroy(reinterpret_cast<pw_proxy *>(listenerData->proxy));
+            }
+        }
+        m_clientListeners.clear();
+    }
+
+    cleanupRegistry();
+}
+
+void PipeWireConsumerTracker::setupRegistry()
+{
+    if (!m_core) {
+        qCWarning(KWIN_SCREENCAST) << "Cannot setup registry: no PipeWire core";
+        return;
+    }
+
+    m_registry = pw_core_get_registry(m_core, PW_VERSION_REGISTRY, 0);
+    if (!m_registry) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to get PipeWire registry";
+        return;
+    }
+
+    static const pw_registry_events registryEvents = {
+        .version = PW_VERSION_REGISTRY_EVENTS,
+        .global = [](void *data, uint32_t id, uint32_t permissions, const char *type,
+                     uint32_t version, const spa_dict *props) {
+        auto tracker = static_cast<PipeWireConsumerTracker *>(data);
+        tracker->onRegistryGlobal(id, permissions, type, version, props);
+    },
+        .global_remove = [](void *data, uint32_t id) {
+        auto tracker = static_cast<PipeWireConsumerTracker *>(data);
+        tracker->onRegistryGlobalRemove(id);
+    }};
+
+    pw_registry_add_listener(m_registry, &m_registryListener, &registryEvents, this);
+}
+
+void PipeWireConsumerTracker::cleanupRegistry()
+{
+    {
+        QMutexLocker locker(&m_nodeListenersMutex);
+        for (auto &[nodeId, listenerData] : m_nodeListeners) {
+            spa_hook_remove(&listenerData->listener);
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(listenerData->proxy));
+        }
+        m_nodeListeners.clear();
+    }
+
+    m_allLinks.clear();
+    m_clientNodes.clear();
+    m_visitedNodes.clear();
+
+    if (m_registry) {
+        spa_hook_remove(&m_registryListener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(m_registry));
+        m_registry = nullptr;
+    }
+}
+
+void PipeWireConsumerTracker::onRegistryGlobal(uint32_t id, uint32_t /*permissions*/,
+                                               const char *type, uint32_t /*version*/,
+                                               const spa_dict *props)
+{
+    QString typeStr = QString::fromUtf8(type);
+    QVariantMap propsMap = spaDictToMap(props);
+
+    QMetaObject::invokeMethod(this, [this, id, typeStr, propsMap]() {
+        handleRegistryGlobal(id, typeStr, propsMap);
+    }, Qt::QueuedConnection);
+}
+
+void PipeWireConsumerTracker::handleRegistryGlobal(uint32_t id, QString type, QVariantMap props)
+{
+    if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Link)) {
+        QString inputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_INPUT_NODE)).toString();
+        QString outputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_OUTPUT_NODE)).toString();
+
+        if (!inputNodeStr.isEmpty() && !outputNodeStr.isEmpty()) {
+            bool okInput, okOutput;
+            uint32_t inputNode = inputNodeStr.toUInt(&okInput);
+            uint32_t outputNode = outputNodeStr.toUInt(&okOutput);
+
+            if (okInput && okOutput) {
+                m_allLinks[id] = LinkInfo{inputNode, outputNode};
+            }
+        }
+
+        checkLinkForConsumer(id, props);
+    } else if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Node)) {
+        QString nodeIdStr = props.value(QString::fromUtf8(PW_KEY_OBJECT_ID)).toString();
+        if (!nodeIdStr.isEmpty()) {
+            bool ok;
+            uint32_t nodeId = nodeIdStr.toUInt(&ok);
+            if (!ok) {
+                qCWarning(KWIN_SCREENCAST) << "Invalid node ID string:" << nodeIdStr;
+                return;
+            }
+            const bool isConsumerNode = std::any_of(m_links.cbegin(), m_links.cend(),
+                                                    [nodeId](uint32_t consumerNodeId) {
+                return consumerNodeId == nodeId;
+            });
+            if (isConsumerNode) {
+                queryNodeProperties(nodeId);
+            }
+        }
+    } else if (type == QString::fromUtf8(PW_TYPE_INTERFACE_Client)) {
+        QString appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+        QString appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+
+        if (!appName.isEmpty() || !appBinary.isEmpty()) {
+            ClientInfo clientInfo;
+            clientInfo.appName = appName;
+            clientInfo.appBinary = appBinary;
+            clientInfo.pid = parsePID(extractPIDString(props));
+            m_clientNodes[id] = clientInfo;
+        }
+    }
+}
+
+void PipeWireConsumerTracker::onRegistryGlobalRemove(uint32_t id)
+{
+    QMetaObject::invokeMethod(this, [this, id]() {
+        handleRegistryGlobalRemove(id);
+    }, Qt::QueuedConnection);
+}
+
+void PipeWireConsumerTracker::handleRegistryGlobalRemove(uint32_t id)
+{
+    if (m_links.contains(id)) {
+        m_links.remove(id);
+        m_allLinks.remove(id);
+
+        if (m_links.isEmpty()) {
+            m_consumerApp.clear();
+            m_consumerPID = 0;
+            Q_EMIT consumerDisconnected();
+        }
+    }
+
+    m_clientNodes.remove(id);
+
+    auto it = m_nodeListeners.find(id);
+    if (it != m_nodeListeners.end()) {
+        auto data = std::move(it->second);
+        m_nodeListeners.erase(it);
+        spa_hook_remove(&data->listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(data->proxy));
+    }
+
+    // A client global can disappear before its info callback fired, leaving an
+    // outstanding listener + bound proxy that would otherwise leak until teardown.
+    auto clientIt = m_clientListeners.find(id);
+    if (clientIt != m_clientListeners.end()) {
+        auto data = std::move(clientIt->second);
+        m_clientListeners.erase(clientIt);
+        spa_hook_remove(&data->listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(data->proxy));
+    }
+}
+
+void PipeWireConsumerTracker::checkLinkForConsumer(uint32_t linkId, const QVariantMap &props)
+{
+    if (props.isEmpty() || m_nodeId == 0) {
+        return;
+    }
+
+    QString outputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_OUTPUT_NODE)).toString();
+    if (outputNodeStr.isEmpty()) {
+        return;
+    }
+
+    bool ok;
+    uint32_t outputNodeId = outputNodeStr.toUInt(&ok);
+    if (!ok) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid output node ID string:" << outputNodeStr;
+        return;
+    }
+    if (outputNodeId != m_nodeId) {
+        return;
+    }
+
+    QString inputNodeStr = props.value(QString::fromUtf8(PW_KEY_LINK_INPUT_NODE)).toString();
+    if (inputNodeStr.isEmpty()) {
+        return;
+    }
+
+    uint32_t consumerNodeId = inputNodeStr.toUInt(&ok);
+    if (!ok) {
+        qCWarning(KWIN_SCREENCAST) << "Invalid input node ID string:" << inputNodeStr;
+        return;
+    }
+    m_links[linkId] = consumerNodeId;
+
+    queryNodeProperties(consumerNodeId);
+}
+
+void PipeWireConsumerTracker::queryNodeProperties(uint32_t nodeId)
+{
+    auto nodeProxy = static_cast<pw_node *>(
+        pw_registry_bind(m_registry, nodeId, PW_TYPE_INTERFACE_Node, PW_VERSION_NODE, 0));
+
+    if (!nodeProxy) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to bind to consumer node" << nodeId;
+        return;
+    }
+
+    auto listenerData = std::make_unique<NodeListenerData>(NodeListenerData{this, nodeProxy, {}, nodeId});
+    NodeListenerData *listenerDataPtr = nullptr;
+
+    {
+        QMutexLocker locker(&m_nodeListenersMutex);
+        if (m_nodeListeners.contains(nodeId)) {
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(nodeProxy));
+            return;
+        }
+        m_nodeListeners[nodeId] = std::move(listenerData);
+        listenerDataPtr = m_nodeListeners[nodeId].get();
+    }
+
+    static const pw_node_events nodeEvents = {
+        .version = PW_VERSION_NODE_EVENTS,
+        .info = [](void *data, const pw_node_info *info) {
+        auto *ld = static_cast<NodeListenerData *>(data);
+
+        if (!info || !info->props) {
+            return;
+        }
+
+        QVariantMap propsMap = spaDictToMap(info->props);
+        uint32_t nodeId = ld->nodeId;
+        QPointer<PipeWireConsumerTracker> tracker = ld->tracker;
+
+        QMetaObject::invokeMethod(ld->tracker, [tracker, nodeId, propsMap]() {
+            if (!tracker) {
+                return;
+            }
+            tracker->handleNodeInfo(nodeId, propsMap);
+        }, Qt::QueuedConnection);
+    }};
+
+    // Must be outside mutex -- PipeWire may call the callback immediately
+    pw_node_add_listener(nodeProxy, &listenerDataPtr->listener, &nodeEvents, listenerDataPtr);
+}
+
+void PipeWireConsumerTracker::queryClientProperties(uint32_t clientId)
+{
+    // Bind to get CURRENT properties -- the portal updates client properties
+    // from "xdg-desktop-portal" to the real app name after authentication
+    auto clientProxy = static_cast<pw_client *>(
+        pw_registry_bind(m_registry, clientId, PW_TYPE_INTERFACE_Client, PW_VERSION_CLIENT, 0));
+
+    if (!clientProxy) {
+        qCWarning(KWIN_SCREENCAST) << "Failed to bind to client" << clientId;
+        if (m_clientNodes.contains(clientId)) {
+            const ClientInfo &clientInfo = m_clientNodes[clientId];
+            QString app = clientInfo.appName.isEmpty() ? clientInfo.appBinary : clientInfo.appName;
+            m_consumerApp = app;
+            m_consumerPID = clientInfo.pid;
+            Q_EMIT consumerConnected(app, clientInfo.pid);
+        } else {
+            Q_EMIT consumerConnected(QString(), 0);
+        }
+        return;
+    }
+
+    auto listenerData = std::make_unique<ClientListenerData>(ClientListenerData{this, clientProxy, {}, clientId});
+    ClientListenerData *listenerDataPtr = nullptr;
+
+    {
+        QMutexLocker locker(&m_clientListenersMutex);
+        if (m_clientListeners.contains(clientId)) {
+            pw_proxy_destroy(reinterpret_cast<pw_proxy *>(clientProxy));
+            return;
+        }
+        m_clientListeners[clientId] = std::move(listenerData);
+        listenerDataPtr = m_clientListeners[clientId].get();
+    }
+
+    static const pw_client_events clientEvents = {
+        .version = PW_VERSION_CLIENT_EVENTS,
+        .info = [](void *data, const pw_client_info *info) {
+        auto *ld = static_cast<ClientListenerData *>(data);
+
+        if (!info || !info->props) {
+            return;
+        }
+
+        QVariantMap propsMap = spaDictToMap(info->props);
+        uint32_t clientId = ld->clientId;
+        QPointer<PipeWireConsumerTracker> tracker = ld->tracker;
+
+        QMetaObject::invokeMethod(ld->tracker, [tracker, clientId, propsMap]() {
+            if (!tracker) {
+                return;
+            }
+            tracker->handleClientInfo(clientId, propsMap);
+        }, Qt::QueuedConnection);
+    }};
+
+    // Must be outside mutex -- PipeWire may call the callback immediately
+    pw_client_add_listener(clientProxy, &listenerDataPtr->listener, &clientEvents, listenerDataPtr);
+}
+
+void PipeWireConsumerTracker::handleNodeInfo(uint32_t nodeId, QVariantMap props)
+{
+    QString appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+    QString appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+    QString consumerApp = appName.isEmpty() ? appBinary : appName;
+
+    if (!consumerApp.isEmpty()) {
+        quint32 pid = parsePID(props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_ID)).toString());
+        m_consumerApp = consumerApp;
+        m_consumerPID = pid;
+        qCDebug(KWIN_SCREENCAST) << "Consumer detected for node" << m_nodeId
+                                 << "app=" << consumerApp << "pid=" << pid;
+        Q_EMIT consumerConnected(consumerApp, pid);
+    } else {
+        QString clientIdStr = props.value(QString::fromUtf8(PW_KEY_CLIENT_ID)).toString();
+        if (!clientIdStr.isEmpty()) {
+            bool ok;
+            uint32_t clientId = clientIdStr.toUInt(&ok);
+            if (ok && clientId != 0) {
+                queryClientProperties(clientId);
+            } else {
+                qCWarning(KWIN_SCREENCAST) << "Invalid client.id string:" << clientIdStr;
+            }
+        } else {
+            // No app info on this node -- follow links downstream. The downstream
+            // node properties are queried asynchronously, so the consumer (if any)
+            // is resolved on a later event-loop iteration via handleNodeInfo(), not
+            // here. We therefore do not emit a "no consumer" signal at this point:
+            // ConsumerApp simply stays empty until a real consumer is resolved.
+            m_visitedNodes.clear();
+            m_visitedNodes.insert(nodeId);
+            followLinksDownstream(nodeId);
+        }
+    }
+
+    cleanupNodeListener(nodeId);
+}
+
+void PipeWireConsumerTracker::handleClientInfo(uint32_t clientId, QVariantMap props)
+{
+    QString appName = props.value(QString::fromUtf8(PW_KEY_APP_NAME)).toString();
+    QString appBinary = props.value(QString::fromUtf8(PW_KEY_APP_PROCESS_BINARY)).toString();
+    QString consumerApp = appName.isEmpty() ? appBinary : appName;
+    quint32 pid = parsePID(extractPIDString(props));
+
+    if (!consumerApp.isEmpty()) {
+        m_consumerApp = consumerApp;
+        m_consumerPID = pid;
+        qCDebug(KWIN_SCREENCAST) << "Consumer detected for node" << m_nodeId
+                                 << "app=" << consumerApp << "pid=" << pid;
+        Q_EMIT consumerConnected(consumerApp, pid);
+    } else {
+        Q_EMIT consumerConnected(QString(), 0);
+    }
+
+    {
+        QMutexLocker lock(&m_clientListenersMutex);
+        m_clientListeners.erase(clientId);
+    }
+}
+
+void PipeWireConsumerTracker::cleanupNodeListener(uint32_t nodeId)
+{
+    QMutexLocker locker(&m_nodeListenersMutex);
+    auto it = m_nodeListeners.find(nodeId);
+    if (it != m_nodeListeners.end()) {
+        // Keep the listener data alive until both the hook is removed and the proxy
+        // is destroyed. This runs in a queued event-loop slot (not inside a PipeWire
+        // callback), so synchronous destruction is safe -- matching the teardown in
+        // handleRegistryGlobalRemove() and the destructor.
+        auto data = std::move(it->second);
+        m_nodeListeners.erase(it);
+        spa_hook_remove(&data->listener);
+        pw_proxy_destroy(reinterpret_cast<pw_proxy *>(data->proxy));
+    }
+}
+
+void PipeWireConsumerTracker::followLinksDownstream(uint32_t startNodeId)
+{
+    QQueue<uint32_t> queue;
+    queue.enqueue(startNodeId);
+
+    while (!queue.isEmpty()) {
+        uint32_t nodeId = queue.dequeue();
+
+        for (auto it = m_allLinks.constBegin(); it != m_allLinks.constEnd(); ++it) {
+            const LinkInfo &link = it.value();
+            if (link.outputNode != nodeId) {
+                continue;
+            }
+
+            uint32_t downstreamNode = link.inputNode;
+            if (m_visitedNodes.contains(downstreamNode)) {
+                continue;
+            }
+            m_visitedNodes.insert(downstreamNode);
+
+            // queryNodeProperties() resolves asynchronously, so m_consumerApp is
+            // not updated within this loop. We query every reachable downstream
+            // node; whichever resolves to an application last wins (best-effort
+            // detection for multi-hop filter chains).
+            queryNodeProperties(downstreamNode);
+
+            queue.enqueue(downstreamNode);
+        }
+    }
+}
+
+} // namespace KWin
diff --git a/src/plugins/screencast/pipewireconsumertracker.h b/src/plugins/screencast/pipewireconsumertracker.h
new file mode 100644
index 0000000000..dff6d39618
--- /dev/null
+++ b/src/plugins/screencast/pipewireconsumertracker.h
@@ -0,0 +1,107 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QHash>
+#include <QMutex>
+#include <QObject>
+#include <QPointer>
+#include <QSet>
+
+#include <memory>
+#include <unordered_map>
+
+#include <pipewire/pipewire.h>
+#include <spa/utils/hook.h>
+
+namespace KWin
+{
+
+struct NodeListenerData;
+struct ClientListenerData;
+
+/**
+ * Tracks PipeWire consumer applications for screencast streams.
+ *
+ * Monitors the PipeWire graph to detect which application is consuming
+ * a screencast stream. Uses the PipeWire registry to watch for Link objects
+ * connecting the stream's output node to a consumer's input node, then
+ * queries the consumer node properties to extract application name and PID.
+ */
+class PipeWireConsumerTracker : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit PipeWireConsumerTracker(pw_core *core, uint32_t nodeId, QObject *parent = nullptr);
+    ~PipeWireConsumerTracker() override;
+
+    QString consumerApp() const
+    {
+        return m_consumerApp;
+    }
+
+    quint32 consumerPID() const
+    {
+        return m_consumerPID;
+    }
+
+Q_SIGNALS:
+    void consumerConnected(const QString &appName, quint32 pid);
+    void consumerDisconnected();
+
+private:
+    struct LinkInfo
+    {
+        uint32_t inputNode;
+        uint32_t outputNode;
+    };
+
+    struct ClientInfo
+    {
+        QString appName;
+        QString appBinary;
+        quint32 pid = 0;
+    };
+
+    void setupRegistry();
+    void cleanupRegistry();
+
+    void onRegistryGlobal(uint32_t id, uint32_t permissions, const char *type,
+                          uint32_t version, const spa_dict *props);
+    void onRegistryGlobalRemove(uint32_t id);
+
+    void handleRegistryGlobal(uint32_t id, QString type, QVariantMap props);
+    void handleRegistryGlobalRemove(uint32_t id);
+    void handleNodeInfo(uint32_t nodeId, QVariantMap props);
+
+    void checkLinkForConsumer(uint32_t linkId, const QVariantMap &props);
