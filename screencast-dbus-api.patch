diff --git a/src/plugins/screencast/screencastdbusinterface.cpp b/src/plugins/screencast/screencastdbusinterface.cpp
new file mode 100644
index 0000000000..7acb0f5a48
--- /dev/null
+++ b/src/plugins/screencast/screencastdbusinterface.cpp
@@ -0,0 +1,323 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "screencastdbusinterface.h"
+#include "kwinscreencast_logging.h"
+#include "outputscreencastsource.h"
+#include "regionscreencastsource.h"
+#include "screencastmanager.h"
+#include "screencaststream.h"
+#include "screencaststreamwrapper.h"
+#include "windowscreencastsource.h"
+
+#include "outputstreamadaptor.h"
+#include "regionstreamadaptor.h"
+#include "screencastadaptor.h"
+#include "windowstreamadaptor.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+
+namespace KWin
+{
+
+static void emitPropertiesChanged(const QString &path, const QString &interface,
+                                  const QVariantMap &properties)
+{
+    QDBusMessage signal = QDBusMessage::createSignal(
+        path,
+        QStringLiteral("org.freedesktop.DBus.Properties"),
+        QStringLiteral("PropertiesChanged"));
+    signal << interface << properties << QStringList();
+    QDBusConnection::sessionBus().send(signal);
+}
+
+ScreencastDBusInterface::ScreencastDBusInterface(ScreencastManager *manager)
+    : QObject(manager)
+{
+    QDBusConnection::sessionBus().registerObject(
+        QStringLiteral("/org/kde/KWin/ScreenCast"),
+        QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+        this,
+        QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllSignals);
+
+    connect(manager, &ScreencastManager::streamAdded,
+            this, &ScreencastDBusInterface::onStreamAdded);
+    connect(manager, &ScreencastManager::streamRemoved,
+            this, &ScreencastDBusInterface::onStreamRemoved);
+}
+
+ScreencastDBusInterface::~ScreencastDBusInterface()
+{
+    for (const QDBusObjectPath &path : m_streamPaths.values()) {
+        QDBusConnection::sessionBus().unregisterObject(path.path());
+    }
+    qDeleteAll(m_streamWrappers.values());
+
+    QDBusConnection::sessionBus().unregisterObject(
+        QStringLiteral("/org/kde/KWin/ScreenCast"));
+}
+
+QString ScreencastDBusInterface::streamObjectPath(ScreenCastStream *stream) const
+{
+    if (!stream) {
+        return QString();
+    }
+    // Use the PipeWire object serial rather than the node id: the node id is
+    // prone to reuse (the zkde-screencast protocol deprecated it for that reason),
+    // which could collide object paths between a destroyed and a fresh stream.
+    return QStringLiteral("/org/kde/KWin/ScreenCast/%1").arg(stream->objectSerial());
+}
+
+QStringList ScreencastDBusInterface::streamInterfaceNames(ScreenCastStream *stream) const
+{
+    QStringList interfaces;
+    interfaces << QStringLiteral("org.kde.KWin.ScreenCast");
+
+    ScreenCastSource *source = stream->source();
+    if (source) {
+        if (qobject_cast<WindowScreenCastSource *>(source)) {
+            interfaces << QStringLiteral("org.kde.KWin.ScreenCast.Window");
+        } else if (qobject_cast<OutputScreenCastSource *>(source)) {
+            interfaces << QStringLiteral("org.kde.KWin.ScreenCast.Output");
+        } else if (qobject_cast<RegionScreenCastSource *>(source)) {
+            interfaces << QStringLiteral("org.kde.KWin.ScreenCast.Region");
+        }
+    }
+
+    return interfaces;
+}
+
+QVariantMap ScreencastDBusInterface::streamInterfaces(ScreenCastStream *stream) const
+{
+    QVariantMap interfaces;
+    if (!stream || !m_streamWrappers.contains(stream)) {
+        return interfaces;
+    }
+
+    ScreenCastStreamDBusWrapper *wrapper = m_streamWrappers[stream];
+
+    // Common interface properties
+    QVariantMap commonProps;
+    commonProps[QStringLiteral("Identifier")] = wrapper->identifier();
+    commonProps[QStringLiteral("Type")] = wrapper->type();
+    commonProps[QStringLiteral("State")] = wrapper->state();
+    commonProps[QStringLiteral("ConsumerApp")] = wrapper->consumerApp();
+    commonProps[QStringLiteral("ConsumerPID")] = wrapper->consumerPID();
+    interfaces[QStringLiteral("org.kde.KWin.ScreenCast")] = commonProps;
+
+    // Type-specific interface properties
+    ScreenCastSource *source = stream->source();
+    if (qobject_cast<WindowScreenCastSource *>(source)) {
+        QVariantMap props;
+        props[QStringLiteral("WindowId")] = wrapper->windowId();
+        props[QStringLiteral("WindowClass")] = wrapper->windowClass();
+        props[QStringLiteral("ResourceName")] = wrapper->resourceName();
+        props[QStringLiteral("Caption")] = wrapper->caption();
+        props[QStringLiteral("X")] = wrapper->x();
+        props[QStringLiteral("Y")] = wrapper->y();
+        props[QStringLiteral("Width")] = wrapper->width();
+        props[QStringLiteral("Height")] = wrapper->height();
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Window")] = props;
+    } else if (qobject_cast<OutputScreenCastSource *>(source)) {
+        QVariantMap props;
+        props[QStringLiteral("OutputName")] = wrapper->outputName();
+        props[QStringLiteral("X")] = wrapper->x();
+        props[QStringLiteral("Y")] = wrapper->y();
+        props[QStringLiteral("Width")] = wrapper->width();
+        props[QStringLiteral("Height")] = wrapper->height();
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Output")] = props;
+    } else if (qobject_cast<RegionScreenCastSource *>(source)) {
+        QVariantMap props;
+        props[QStringLiteral("X")] = wrapper->x();
+        props[QStringLiteral("Y")] = wrapper->y();
+        props[QStringLiteral("Width")] = wrapper->width();
+        props[QStringLiteral("Height")] = wrapper->height();
+        props[QStringLiteral("Scale")] = wrapper->scale();
+        interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Region")] = props;
+    }
+
+    return interfaces;
+}
+
+QVariantMap ScreencastDBusInterface::GetManagedObjects()
+{
+    QVariantMap objects;
+
+    // Only report streams that have been registered on the bus (i.e. those for
+    // which InterfacesAdded was emitted). This keeps GetManagedObjects symmetric
+    // with the InterfacesAdded/InterfacesRemoved signals, so an ObjectManager
+    // client builds a consistent model regardless of which it relies on.
+    for (auto it = m_streamPaths.constBegin(); it != m_streamPaths.constEnd(); ++it) {
+        objects[it.value().path()] = streamInterfaces(it.key());
+    }
+
+    return objects;
+}
+
+void ScreencastDBusInterface::onStreamAdded(ScreenCastStream *stream)
+{
+    if (!stream || !stream->source()) {
+        return;
+    }
+
+    QPointer<ScreenCastStream> streamPtr(stream);
+    connect(stream, &ScreenCastStream::ready, this, [this, streamPtr]() {
+        if (!streamPtr) {
+            return;
+        }
+
+        ScreenCastStream *stream = streamPtr.data();
+        QString path = streamObjectPath(stream);
+        if (path.isEmpty()) {
+            qCWarning(KWIN_SCREENCAST) << "Failed to generate D-Bus path for stream";
+            return;
+        }
+
+        QDBusObjectPath objectPath(path);
+        m_streamPaths[stream] = objectPath;
+
+        ScreenCastStreamDBusWrapper *wrapper = createStreamWrapper(stream);
+        m_streamWrappers[stream] = wrapper;
+
+        registerStreamOnDBus(path, wrapper);
+        connectStreamPropertySignals(stream, path, wrapper);
+
+        // Capture the interface list now, while the source is still alive: by the
+        // time onStreamRemoved() runs the stream's source has been reset, so it must
+        // not be recomputed there (it would drop the type-specific interface).
+        m_streamInterfaceNames[stream] = streamInterfaceNames(stream);
+
+        // Announce the stream as soon as it is on the bus, independent of consumer
+        // detection. Consumer identity (if any) arrives later via PropertiesChanged.
+        Q_EMIT InterfacesAdded(objectPath, streamInterfaces(stream));
+        m_streamsAnnouncedOnDBus.insert(stream);
+    }, Qt::SingleShotConnection);
+}
+
+void ScreencastDBusInterface::onStreamRemoved(ScreenCastStream *stream)
+{
+    if (!m_streamPaths.contains(stream)) {
+        return;
+    }
+
+    QDBusObjectPath objectPath = m_streamPaths.take(stream);
+    m_streamsAnnouncedOnDBus.remove(stream);
+    const QStringList interfaces = m_streamInterfaceNames.take(stream);
+
+    delete m_streamWrappers.take(stream);
+
+    QDBusConnection::sessionBus().unregisterObject(objectPath.path());
+    Q_EMIT InterfacesRemoved(objectPath, interfaces);
+}
+
+ScreenCastStreamDBusWrapper *ScreencastDBusInterface::createStreamWrapper(ScreenCastStream *stream)
+{
+    auto *wrapper = new ScreenCastStreamDBusWrapper(stream);
+
+    // Common adaptor — always present
+    new ScreenCastAdaptor(wrapper);
+
+    // Type-specific adaptor — only the one matching the stream source
+    ScreenCastSource *source = stream->source();
+    if (qobject_cast<WindowScreenCastSource *>(source)) {
+        new WindowStreamAdaptor(wrapper);
+    } else if (qobject_cast<OutputScreenCastSource *>(source)) {
+        new OutputStreamAdaptor(wrapper);
+    } else if (qobject_cast<RegionScreenCastSource *>(source)) {
+        new RegionStreamAdaptor(wrapper);
+    }
+
+    return wrapper;
+}
+
+bool ScreencastDBusInterface::registerStreamOnDBus(const QString &path, ScreenCastStreamDBusWrapper *wrapper)
+{
+    return QDBusConnection::sessionBus().registerObject(
+        path,
+        wrapper,
+        QDBusConnection::ExportAdaptors);
+}
+
+void ScreencastDBusInterface::connectStreamPropertySignals(ScreenCastStream *stream, const QString &path,
+                                                           ScreenCastStreamDBusWrapper *wrapper)
+{
+    QPointer<ScreenCastStream> streamPtr(stream);
+    QPointer<ScreenCastStreamDBusWrapper> wrapperPtr(wrapper);
+
+    connect(wrapper, &ScreenCastStreamDBusWrapper::consumerChanged, this, [this, streamPtr, wrapperPtr, path]() {
+        if (!streamPtr || !wrapperPtr) {
+            return;
+        }
+        ScreenCastStream *stream = streamPtr.data();
+        ScreenCastStreamDBusWrapper *wrapper = wrapperPtr.data();
+
+        if (!m_streamsAnnouncedOnDBus.contains(stream)) {
+            return;
+        }
+
+        QVariantMap changedProps;
+        changedProps[QStringLiteral("ConsumerApp")] = wrapper->consumerApp();
+        changedProps[QStringLiteral("ConsumerPID")] = wrapper->consumerPID();
+        emitPropertiesChanged(path, QStringLiteral("org.kde.KWin.ScreenCast"), changedProps);
+    });
+
+    connect(wrapper, &ScreenCastStreamDBusWrapper::stateChanged, this, [wrapperPtr, path]() {
+        if (!wrapperPtr) {
+            return;
+        }
+        ScreenCastStreamDBusWrapper *wrapper = wrapperPtr.data();
+
+        QVariantMap changedProps;
+        changedProps[QStringLiteral("State")] = wrapper->state();
+        emitPropertiesChanged(path, QStringLiteral("org.kde.KWin.ScreenCast"), changedProps);
+    });
+
+    // Type-specific property change signals
+    ScreenCastSource *source = stream->source();
+    if (qobject_cast<WindowScreenCastSource *>(source)) {
+        connect(wrapper, &ScreenCastStreamDBusWrapper::rectChanged, this, [wrapperPtr, path]() {
+            if (!wrapperPtr) {
+                return;
+            }
+            ScreenCastStreamDBusWrapper *wrapper = wrapperPtr.data();
+
+            QVariantMap changedProps;
+            changedProps[QStringLiteral("X")] = wrapper->x();
+            changedProps[QStringLiteral("Y")] = wrapper->y();
+            changedProps[QStringLiteral("Width")] = wrapper->width();
+            changedProps[QStringLiteral("Height")] = wrapper->height();
+            emitPropertiesChanged(path, QStringLiteral("org.kde.KWin.ScreenCast.Window"), changedProps);
+        });
+        connect(wrapper, &ScreenCastStreamDBusWrapper::captionChanged, this, [wrapperPtr, path]() {
+            if (!wrapperPtr) {
+                return;
+            }
+            ScreenCastStreamDBusWrapper *wrapper = wrapperPtr.data();
+
+            QVariantMap changedProps;
+            changedProps[QStringLiteral("Caption")] = wrapper->caption();
+            emitPropertiesChanged(path, QStringLiteral("org.kde.KWin.ScreenCast.Window"), changedProps);
+        });
+    } else if (qobject_cast<OutputScreenCastSource *>(source)) {
+        connect(wrapper, &ScreenCastStreamDBusWrapper::geometryChanged, this, [wrapperPtr, path]() {
+            if (!wrapperPtr) {
+                return;
+            }
+            ScreenCastStreamDBusWrapper *wrapper = wrapperPtr.data();
+
+            QVariantMap changedProps;
+            changedProps[QStringLiteral("X")] = wrapper->x();
+            changedProps[QStringLiteral("Y")] = wrapper->y();
+            changedProps[QStringLiteral("Width")] = wrapper->width();
+            changedProps[QStringLiteral("Height")] = wrapper->height();
+            emitPropertiesChanged(path, QStringLiteral("org.kde.KWin.ScreenCast.Output"), changedProps);
+        });
+    }
+}
+
+} // namespace KWin
+
+#include "moc_screencastdbusinterface.cpp"
