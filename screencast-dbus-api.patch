+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
+"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<!--
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+-->
+<node>
+  <interface name="org.kde.KWin.ScreenCast">
+    <annotation name="org.gtk.GDBus.DocString" value="Common interface present on all screencast stream objects"/>
+
+    <property name="Identifier" type="s" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
+      <annotation name="org.gtk.GDBus.DocString" value="PipeWire object serial as string. Matches the last component of the object path. Stable for the lifetime of the stream and not subject to node-id reuse."/>
+    </property>
+
+    <property name="Type" type="s" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Stream type: 'window', 'output', or 'region'"/>
+    </property>
+
+    <property name="State" type="s" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Stream state: 'idle', 'paused', or 'streaming'"/>
+    </property>
+
+    <property name="ConsumerApp" type="s" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Name of the application consuming this stream (e.g., 'obs', 'firefox'). May be empty if consumer is unknown or not yet connected. Updated asynchronously."/>
+    </property>
+
+    <property name="ConsumerPID" type="u" access="read">
+      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
+      <annotation name="org.gtk.GDBus.DocString" value="Process ID of the consumer application. Zero if unknown or not yet connected. Updated asynchronously when consumer connects."/>
