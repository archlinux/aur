diff --git a/autotests/integration/screencast_dbus_test.cpp b/autotests/integration/screencast_dbus_test.cpp
new file mode 100644
index 0000000000..485ff73ccd
--- /dev/null
+++ b/autotests/integration/screencast_dbus_test.cpp
@@ -0,0 +1,291 @@
+/*
+    SPDX-FileCopyrightText: 2025 Jerzy Kołosowski <jerzy@kolosowscy.pl>
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "generic_scene_opengl_test.h"
+#include "wayland_server.h"
+#include "window.h"
+#include "workspace.h"
+
+#include <KWayland/Client/output.h>
+#include <KWayland/Client/surface.h>
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingReply>
+#include <QProcess>
+#include <QSignalSpy>
+
+namespace KWin
+{
+
+/**
+ * Helper to extract a nested QVariantMap from a QVariant that may contain
+ * a QDBusArgument rather than a native QVariantMap.
+ */
+static QVariantMap variantToMap(const QVariant &v)
+{
+    if (v.canConvert<QDBusArgument>()) {
+        return qdbus_cast<QVariantMap>(v);
+    }
+    return v.toMap();
+}
+
+class ScreencastDbusTest : public GenericSceneOpenGLTest
+{
+    Q_OBJECT
+
+public:
+    ScreencastDbusTest()
+        : GenericSceneOpenGLTest(QByteArrayLiteral("O2"))
+    {
+        // Make sure a PipeWire instance is available so streams can be created and
+        // appear on D-Bus. Only under CI: launching PipeWire on a developer machine
+        // would interfere with the running session (mirrors ScreencastingTest). This
+        // test inspects D-Bus metadata only and does not consume frames, so it is not
+        // affected by the PipeWire 1.2 frame-callback issue that ScreencastingTest skips.
+        if (qgetenv("KDECI_BUILD") == "TRUE") {
+            auto launch = [this](const QString &program, const QStringList &arguments = {}) {
+                QProcess *process = new QProcess(this);
+                process->setProcessChannelMode(QProcess::MergedChannels);
+                process->setProgram(program);
+                process->setArguments(arguments);
+                connect(this, &QObject::destroyed, process, [process] {
+                    process->terminate();
+                    process->waitForFinished();
+                    process->kill();
+                });
+                process->start();
+            };
+            launch(QStringLiteral("pipewire"));
+            launch(QStringLiteral("dbus-launch"), {QStringLiteral("wireplumber")});
+        }
+    }
+
+private Q_SLOTS:
+    void init();
+
+    void testGetManagedObjectsEmpty();
+    void testWindowStreamProperties();
+    void testOutputStreamProperties();
+    void testStreamRemoval();
+    void testStopMethod();
+
+private:
+    struct ManagedObject
+    {
+        // interface name -> { property name -> value }
+        QHash<QString, QVariantMap> interfaces;
+    };
+
+    QHash<QString, ManagedObject> getManagedObjects();
+    bool waitForStream(Test::ScreencastingStreamV1 *stream, quint64 &objectSerial);
+};
+
+void ScreencastDbusTest::init()
+{
+    QVERIFY(Test::setupWaylandConnection(Test::AdditionalWaylandInterface::ScreencastingV1));
+    QVERIFY(KWin::Test::screencasting());
+    Cursors::self()->hideCursor();
+}
+
+QHash<QString, ScreencastDbusTest::ManagedObject> ScreencastDbusTest::getManagedObjects()
+{
+    QHash<QString, ManagedObject> result;
+
+    auto msg = QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"),
+        QStringLiteral("/org/kde/KWin/ScreenCast"),
+        QStringLiteral("org.freedesktop.DBus.ObjectManager"),
+        QStringLiteral("GetManagedObjects"));
+    QDBusMessage reply = QDBusConnection::sessionBus().call(msg);
+    if (reply.type() == QDBusMessage::ErrorMessage || reply.arguments().isEmpty()) {
+        return result;
+    }
+
+    // Top level: a{sv} where keys are object paths, values are nested maps
+    QVariantMap objects = qdbus_cast<QVariantMap>(reply.arguments().first());
+
+    for (auto it = objects.constBegin(); it != objects.constEnd(); ++it) {
+        ManagedObject obj;
+        // Level 1: interface name -> properties map
+        QVariantMap interfaces = variantToMap(it.value());
+        for (auto ifIt = interfaces.constBegin(); ifIt != interfaces.constEnd(); ++ifIt) {
+            // Level 2: property name -> value
+            obj.interfaces[ifIt.key()] = variantToMap(ifIt.value());
+        }
+        result[it.key()] = obj;
+    }
+
+    return result;
+}
+
+bool ScreencastDbusTest::waitForStream(Test::ScreencastingStreamV1 *stream, quint64 &objectSerial)
+{
+    QSignalSpy createdSpy(stream, &Test::ScreencastingStreamV1::created);
+    QSignalSpy failedSpy(stream, &Test::ScreencastingStreamV1::failed);
+
+    if (!createdSpy.wait() && failedSpy.isEmpty()) {
+        return false;
+    }
+    if (!failedSpy.isEmpty()) {
+        return false;
+    }
+
+    // The created() signal carries the PipeWire object serial (the stable
+    // identifier the D-Bus object path and Identifier property are built from).
+    objectSerial = createdSpy.first().first().toULongLong();
+    return objectSerial > 0;
+}
+
+void ScreencastDbusTest::testGetManagedObjectsEmpty()
+{
+    auto objects = getManagedObjects();
+    QVERIFY(objects.isEmpty());
+}
+
+void ScreencastDbusTest::testWindowStreamProperties()
+{
+    Test::XdgToplevelWindow window;
+    QVERIFY(window.show(QSize(100, 50), Qt::red));
+
+    auto stream = KWin::Test::screencasting()->createWindowStream(
+        window.m_window->internalId().toString(),
+        QtWayland::zkde_screencast_unstable_v1::pointer_hidden);
+
+    quint64 objectSerial = 0;
+    if (!waitForStream(stream, objectSerial)) {
+        QSKIP("PipeWire not available");
+    }
+
+    QString expectedPath = QStringLiteral("/org/kde/KWin/ScreenCast/%1").arg(objectSerial);
+    auto objects = getManagedObjects();
+    QVERIFY(objects.contains(expectedPath));
+
+    const ManagedObject &obj = objects[expectedPath];
+
+    // Verify main ScreenCast interface
+    QVERIFY(obj.interfaces.contains(QStringLiteral("org.kde.KWin.ScreenCast")));
+    QVariantMap mainProps = obj.interfaces[QStringLiteral("org.kde.KWin.ScreenCast")];
+    QCOMPARE(mainProps[QStringLiteral("Identifier")].toString(), QString::number(objectSerial));
+    QCOMPARE(mainProps[QStringLiteral("Type")].toString(), QStringLiteral("window"));
+    QString state = mainProps[QStringLiteral("State")].toString();
+    QVERIFY(state == QStringLiteral("idle") || state == QStringLiteral("streaming") || state == QStringLiteral("paused"));
+
+    // Verify Window-specific interface
+    QVERIFY(obj.interfaces.contains(QStringLiteral("org.kde.KWin.ScreenCast.Window")));
+    QVariantMap windowProps = obj.interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Window")];
+    QCOMPARE(windowProps[QStringLiteral("WindowId")].toString(), window.m_window->internalId().toString());
+    QCOMPARE(windowProps[QStringLiteral("Width")].toInt(), window.m_window->width());
+    QCOMPARE(windowProps[QStringLiteral("Height")].toInt(), window.m_window->height());
+
+    // Clean up stream before window is destroyed
+    QSignalSpy closedSpy(stream, &Test::ScreencastingStreamV1::closed);
+    stream->close();
+    closedSpy.wait();
+}
+
+void ScreencastDbusTest::testOutputStreamProperties()
+{
+    auto theOutput = KWin::Test::waylandOutputs().constFirst();
+
+    auto stream = KWin::Test::screencasting()->createOutputStream(
+        theOutput->output(),
+        QtWayland::zkde_screencast_unstable_v1::pointer_hidden);
+
+    quint64 objectSerial = 0;
+    if (!waitForStream(stream, objectSerial)) {
+        QSKIP("PipeWire not available");
+    }
+
+    QString expectedPath = QStringLiteral("/org/kde/KWin/ScreenCast/%1").arg(objectSerial);
+    auto objects = getManagedObjects();
+    QVERIFY(objects.contains(expectedPath));
+
+    const ManagedObject &obj = objects[expectedPath];
+
+    // Verify main interface
+    QVERIFY(obj.interfaces.contains(QStringLiteral("org.kde.KWin.ScreenCast")));
+    QVariantMap mainProps = obj.interfaces[QStringLiteral("org.kde.KWin.ScreenCast")];
+    QCOMPARE(mainProps[QStringLiteral("Type")].toString(), QStringLiteral("output"));
+
+    // Verify Output-specific interface
+    QVERIFY(obj.interfaces.contains(QStringLiteral("org.kde.KWin.ScreenCast.Output")));
+    QVariantMap outputProps = obj.interfaces[QStringLiteral("org.kde.KWin.ScreenCast.Output")];
+    QVERIFY(!outputProps[QStringLiteral("OutputName")].toString().isEmpty());
+    QVERIFY(outputProps[QStringLiteral("Width")].toInt() > 0);
+    QVERIFY(outputProps[QStringLiteral("Height")].toInt() > 0);
+
+    // Clean up stream
+    QSignalSpy closedSpy(stream, &Test::ScreencastingStreamV1::closed);
+    stream->close();
+    closedSpy.wait();
+}
+
+void ScreencastDbusTest::testStreamRemoval()
+{
+    Test::XdgToplevelWindow window;
+    QVERIFY(window.show(QSize(100, 50), Qt::blue));
+
+    auto stream = KWin::Test::screencasting()->createWindowStream(
+        window.m_window->internalId().toString(),
+        QtWayland::zkde_screencast_unstable_v1::pointer_hidden);
+
+    quint64 objectSerial = 0;
+    if (!waitForStream(stream, objectSerial)) {
+        QSKIP("PipeWire not available");
+    }
+
+    QString expectedPath = QStringLiteral("/org/kde/KWin/ScreenCast/%1").arg(objectSerial);
+
+    // Verify stream exists
+    QVERIFY(getManagedObjects().contains(expectedPath));
+
+    // Close the stream via Wayland
+    QSignalSpy closedSpy(stream, &Test::ScreencastingStreamV1::closed);
+    stream->close();
+    QVERIFY(closedSpy.wait());
+
+    // Verify stream is removed from D-Bus
+    QVERIFY(!getManagedObjects().contains(expectedPath));
+}
+
+void ScreencastDbusTest::testStopMethod()
+{
+    Test::XdgToplevelWindow window;
+    QVERIFY(window.show(QSize(100, 50), Qt::green));
+
+    auto stream = KWin::Test::screencasting()->createWindowStream(
+        window.m_window->internalId().toString(),
+        QtWayland::zkde_screencast_unstable_v1::pointer_hidden);
+
+    quint64 objectSerial = 0;
+    if (!waitForStream(stream, objectSerial)) {
+        QSKIP("PipeWire not available");
+    }
+
+    QString streamPath = QStringLiteral("/org/kde/KWin/ScreenCast/%1").arg(objectSerial);
+
+    // Call Stop() via D-Bus
+    QSignalSpy closedSpy(stream, &Test::ScreencastingStreamV1::closed);
+
+    auto msg = QDBusMessage::createMethodCall(
+        QStringLiteral("org.kde.KWin"),
+        streamPath,
+        QStringLiteral("org.kde.KWin.ScreenCast"),
+        QStringLiteral("Stop"));
+    QDBusConnection::sessionBus().asyncCall(msg);
+
+    // Verify the stream is closed
+    QVERIFY(closedSpy.wait());
+
+    // Verify stream is removed from D-Bus
+    QVERIFY(!getManagedObjects().contains(streamPath));
+}
+
+} // namespace KWin
+
+WAYLANDTEST_MAIN(KWin::ScreencastDbusTest)
+#include "screencast_dbus_test.moc"
