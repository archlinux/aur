+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QDBusContext>
+#include <QDBusObjectPath>
+#include <QElapsedTimer>
+#include <QObject>
+
+namespace KWin
+{
+
+class ScreencastManager;
+class ScreenCastStream;
+
+/**
+ * Implements org.freedesktop.DBus.ObjectManager for screencasts
+ * Root path: /org/kde/KWin/ScreenCast
+ * Per-stream objects: /org/kde/KWin/ScreenCast/node_<pipewire_node_id>
+ */
+class ScreencastDBusInterface : public QObject, protected QDBusContext
+{
+    Q_OBJECT
+    Q_DISABLE_COPY(ScreencastDBusInterface)
+    Q_CLASSINFO("D-Bus Interface", "org.freedesktop.DBus.ObjectManager")
+
+public:
+    explicit ScreencastDBusInterface(ScreencastManager *manager);
+    ~ScreencastDBusInterface() noexcept override;
+
+public Q_SLOTS:
+    // ObjectManager method
+    QVariantMap GetManagedObjects();
+
+Q_SIGNALS:
+    // ObjectManager signals
+    void InterfacesAdded(const QDBusObjectPath &objectPath, const QVariantMap &interfacesAndProperties);
+    void InterfacesRemoved(const QDBusObjectPath &objectPath, const QStringList &interfaces);
+
+private Q_SLOTS:
+    void onStreamAdded(ScreenCastStream *stream);
+    void onStreamRemoved(ScreenCastStream *stream);
+
+private:
+    QString streamObjectPath(ScreenCastStream *stream) const;
+    QVariantMap streamInterfaces(ScreenCastStream *stream) const;
+    QStringList streamInterfaceNames(ScreenCastStream *stream) const;
+    bool validateCaller();
+
