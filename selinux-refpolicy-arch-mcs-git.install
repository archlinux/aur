post_install() {
    # Configure /etc/selinux/config
    if [ -e /etc/selinux/config ]
    then
        echo ">>> In order to use this policy, set SELINUXTYPE=refpolicy-arch-git in /etc/selinux/config."
    else
        /usr/bin/ln -v -s config.refpolicy-arch-git /etc/selinux/config
    fi

    echo ">>> Building refpolicy-arch-git policy store. Please wait..."
    /usr/bin/semodule -s refpolicy-arch-git -i /usr/share/selinux/refpolicy-arch-git/*.pp
    echo ">>> Relabeling the filesystem may be needed."
    echo ">>> This can be done with: /usr/bin/restorecon -rF /"
}

post_upgrade() {
    post_install
}

post_remove() {
    # NOTE: deliberately does NOT `rm -rf /var/lib/selinux/refpolicy-arch-git`.
    # That directory is a libsemanage policy *store* — mutable runtime state
    # created by `semodule`, NOT part of this package's payload (`pacman -Qo`
    # reports it unowned). It is shared: besides this package's base modules it
    # also holds any LOCALLY loaded modules (e.g. priority-400/500 admin policy
    # from `semodule -i`). Blindly wiping it destroyed a database we don't own
    # and silently removed the admin's local modules — the postgres-data
    # antipattern (a package must not delete state it didn't create). Leave it;
    # tell the operator how to purge by hand if they truly want a clean slate.
    echo ">>> The SELinux policy store /var/lib/selinux/refpolicy-arch-git is kept"
    echo ">>> (it may hold locally-loaded modules). To purge it manually:"
    echo ">>>     rm -rf /var/lib/selinux/refpolicy-arch-git"

    if [ -L /etc/selinux/config ] && ! [ -e /etc/selinux/config ]
    then
        echo ">>> Removing now-broken symbolic link /etc/selinux/config"
        /usr/bin/rm /etc/selinux/config
    fi
}
