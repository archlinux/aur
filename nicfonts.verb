    w_register_font_replacement "Microsoft JhengHei UI" "Noto Sans CJK TC"
    w_register_font_replacement "MingLiU" "Noto Sans CJK TC"
    w_register_font_replacement "PMingLiU" "Noto Sans CJK TC"
    w_register_font_replacement "MingLiU-ExtB" "Noto Sans CJK TC"
