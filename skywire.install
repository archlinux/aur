#kill any instance that was running
#systemctl disable --now skywire.service
#}

post_install() {
  # File caps for VPN apps + low-port hypervisor binds. Survives
  # User= changes; required for the user-mode unit (which can't be
  # granted ambient caps).
  if command -v setcap >/dev/null 2>&1 ; then
    setcap 'cap_net_admin,cap_net_bind_service+eip' /opt/skywire/bin/skywire 2>/dev/null || true
  fi

  # _skywire user + /var/lib/skywire dir + /opt/skywire chown are
  # handled declaratively by /usr/lib/sysusers.d/skywire.conf and
  # /usr/lib/tmpfiles.d/skywire.conf. Pacman's systemd hooks run
  # systemd-sysusers and systemd-tmpfiles --create when the package
  # lands these files.

  # Generate the canonical /etc/skywire.conf template ONLY if it's
  # missing. Operator edits (SK, HYPERVISORPKS, SKYWIRE_USER, etc.)
  # are preserved by default across upgrades because the package no
  # longer ships the file — pacman has nothing to overwrite.
  [[ ! -f /etc/skywire.conf ]] && skywire cli config gen -pqQ /etc/skywire.conf

  # Run the Go-side autoconfig (which now reads /etc/skywire.conf
  # for PKGENV/USRENV/SKYWIRE_USER) instead of the legacy bash
  # autoconfig. The shell wrapper still ships at
  # /opt/skywire/scripts/skywire-autoconfig for back-compat with
  # any operator scripts that call it directly.
  skywire autoconfig "$@"
}

# The update channel (skywire-update) replaces /opt/skywire/bin/skywire with
# newer builds than any release, and pacman writes the package's copy over it.
# pre_upgrade saves the installed binary; post_upgrade puts it back when it is
# newer, so an upgrade never downgrades a visor unless /etc/skywire.conf sets
# ALLOW_PACKAGE_DOWNGRADE=1.
_kept=/var/lib/skywire/pkg-kept

# _ver_gt reports whether Go module version $1 is newer than $2, comparing the
# x.y.z part first and treating a pre-release as older than its release.
_ver_gt() {
  local a=${1#v} b=${2#v} ab bb ap bp
  ab=${a%%-*}; bb=${b%%-*}; ap=${a#"$ab"}; bp=${b#"$bb"}
  if [[ $ab != "$bb" ]]; then
    [[ $(printf '%s\n%s\n' "$ab" "$bb" | sort -V | tail -1) == "$ab" ]]
    return
  fi
  [[ -z $ap ]] && { [[ -n $bp ]]; return; }
  [[ -z $bp ]] && return 1
  [[ $ap != "$bp" && $(printf '%s\n%s\n' "$ap" "$bp" | sort -V | tail -1) == "$ap" ]]
}

pre_upgrade() {
  rm -rf "$_kept"
  [[ -x /opt/skywire/bin/skywire ]] || return 0
  mkdir -p "$_kept"
  cp -p /opt/skywire/bin/skywire "$_kept/skywire"
  for _f in skywire.wasm.gz skywire.wasm.json; do
    [[ -f /opt/skywire/bin/$_f ]] && cp -p "/opt/skywire/bin/$_f" "$_kept/$_f"
  done
  "$_kept/skywire" -b 2>/dev/null | head -1 | tr -d '[:space:]' > "$_kept/version"
  return 0
}

# _restore_newer puts the saved binary back when it is newer than the
# package's, and reports whether it did.
_restore_newer() {
  local _old _new
  [[ -f $_kept/version && -x $_kept/skywire ]] || return 1
  grep -qs '^ALLOW_PACKAGE_DOWNGRADE=1' /etc/skywire.conf && { rm -rf "$_kept"; return 1; }
  _old=$(<"$_kept/version")
  _new=$(/opt/skywire/bin/skywire -b 2>/dev/null | head -1 | tr -d '[:space:]')
  if [[ -z $_old || -z $_new ]] || ! _ver_gt "$_old" "$_new"; then
    rm -rf "$_kept"
    return 1
  fi
  echo "keeping the installed skywire $_old, newer than the package's $_new (ALLOW_PACKAGE_DOWNGRADE=1 in /etc/skywire.conf overrides)"
  install -m 0755 "$_kept/skywire" /opt/skywire/bin/skywire
  for _f in skywire.wasm.gz skywire.wasm.json; do
    [[ -f $_kept/$_f ]] && install -m 0644 "$_kept/$_f" "/opt/skywire/bin/$_f"
  done
  rm -rf "$_kept"
  return 0
}

post_upgrade() {
  # The running visor is already on the binary we kept, so write the config
  # with it and leave the services running.
  if _restore_newer; then
    post_install --no-restart
    return 0
  fi
  post_install
  # On upgrade, restart every package-shipped service that's
  # currently active. try-restart is a noop on inactive units, so
  # operators who haven't enabled every shipped unit don't see
  # spurious starts. autoconfig already touched skywire.service via
  # its restart-if-active path; try-restart on a just-restarted
  # service is harmless.
  for _unit in skywire.service skywire-autoconfig.service \
               skywire-sn.service skywire-ar.service \
               skywire-rf.service skywire-tpd.service \
               skywire-dmsgd.service skywire-dmsg.service \
               skywire-sd.service dmsgpty-tcp.socket ; do
    systemctl try-restart "$_unit" 2>/dev/null || true
  done
}

pre-remove() {
  systemctl disable --now skywire.service 2>/dev/null || true
}

post_remove() {
  rm -f /etc/systemd/system/skywire.service.d/skywire-user.conf
  rmdir --ignore-fail-on-non-empty /etc/systemd/system/skywire.service.d 2>/dev/null || true
  rm -rf /opt/skywire
  systemctl daemon-reload 2>/dev/null || true
}
