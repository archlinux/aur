post_install() {
  echo ">>> Ghidra MCP Server has been installed."
  echo ">>>"
  echo ">>> CONFIGURATION EXAMPLES"
  echo ">>> ----------------------"
  echo ""
  echo ">>> 1. Claude Desktop (claude_desktop_config.json)"
  echo "{"
  echo "  \"mcpServers\": {"
  echo "    \"ghidra-mcp\": {"
  echo "      \"command\": \"bridge-mcp-ghidra\","
  echo "      \"args\": [\"--transport\", \"stdio\"],"
  echo "      \"env\": {"
  echo "        \"GHIDRA_MCP_URL\": \"http://127.0.0.1:8089\""
  echo "      }"
  echo "    }"
  echo "  }"
  echo "}"
  echo ""
  echo ">>> 2. Cline (Manual Run)"
  echo "   First, start the MCP bridge in SSE mode:"
  echo "   $ bridge-mcp-ghidra --transport sse --mcp-host 127.0.0.1 --mcp-port 8081 --ghidra-server http://127.0.0.1:8089/"
  echo ""
  echo "   Then in Cline -> MCP Servers -> Remote Servers:"
  echo "   Server URL: http://127.0.0.1:8081/sse"
  echo ""
  echo ">>> 3. 5ire"
  echo "   Tool Key: ghidra"
  echo "   Name: GhidraMCP"
  echo "   Command: bridge-mcp-ghidra"
  echo ""
  echo ">>> Don't forget to enable the extension in Ghidra (File > Install Extensions)!"
  echo ">>> Default Ghidra Server Port: 8089 (configurable in Tool Options)"
}

post_upgrade() {
  post_install
}
