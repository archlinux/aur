From: mndza <diego.hdmp@gmail.com>
Date: Tue, 25 Jun 2024 13:55:58 +0200
Subject: [PATCH] cli: extend argument parsing to fix new apollo commands

---
 cynthion/python/src/commands/cli.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/cynthion/python/src/commands/cli.py b/cynthion/python/src/commands/cli.py
index 7b45e284..de6c3461 100644
--- a/cynthion/python/src/commands/cli.py
+++ b/cynthion/python/src/commands/cli.py
@@ -51,7 +51,10 @@ def main():
         cmd_parser = sub_parsers.add_parser(command.name, aliases=command.alias, help=command.help)
         cmd_parser.set_defaults(func=command.handler)
         for arg in command.args:
-            cmd_parser.add_argument(arg)
+            if isinstance(arg, tuple):
+                cmd_parser.add_argument(*arg[0], **arg[1])
+            else:
+                cmd_parser.add_argument(arg)
 
     args = parser.parse_args()
     if not args.command:
