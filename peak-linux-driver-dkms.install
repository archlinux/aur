post_install() {
  echo -e "======================================================================="
  echo -e " PEAK-System pcan driver has been installed"
  echo -e ""
  echo -e " \e[1;33m==> IMPORTANT\e[0m"
  echo -e "  The in-kernel peak_usb driver may still be loaded."
  echo -e "  Reboot, or switch to pcan now:"
  echo -e "\e[1;32m    sudo modprobe -r peak_usb && sudo modprobe pcan\e[0m"
  echo -e "======================================================================="
}

post_upgrade() {
  post_install
}
