post_install() {
    echo
    echo "==> music-tui installed."
    echo
    echo "On first launch open the Settings tab (the last one), set your music"
    echo "directory (e), then scan it (r)."
    echo
    echo "For the Spotify and Explore tabs, install yt-dlp and ffmpeg."
    echo
    echo "Optional, for full visuals:"
    echo "  - a Nerd Font for the transport icons"
    echo "  - kitty >= 0.40 for album art and 2x transport icons"
    echo "    (other terminals run fine; those two features degrade gracefully)"
    echo
}

post_upgrade() {
    echo "==> music-tui upgraded. Restart the app to pick up the new version."
}
