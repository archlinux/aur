post_install() {
	cat <<'EOF'
:: qsgreeter-hyprland: point greetd at the Hyprland config in /etc/greetd/config.toml:

   [default_session]
   command = "start-hyprland -- --config /etc/greetd/qsgreeter-hyprland.lua"
   user = "greeter"

   Colours and layout: /etc/xdg/quickshell/qsgreeter/{colorscheme,style}.json
EOF
}

post_upgrade() {
	post_install
}
