[Unit]
Description=fetch-github-hosts service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Restart=on-failure
RestartSec=5s
ExecStart=sh -c 'sed -i "/## Generated by hosts-generator start/Q" /etc/hosts && curl https://gitee.com/if-the-wind/github-hosts/raw/main/hosts > /etc/hosts'

[Install]
WantedBy=multi-user.target
