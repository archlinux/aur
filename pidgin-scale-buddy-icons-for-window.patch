2.x.y: Scale buddy icons used as window icons

Pidgin uses the active IM buddy icon as the GTK window icon. Large buddy icons
are exported by GTK on X11 through _NET_WM_ICON, where a 512x512 ARGB icon can
exceed the default maximum request size. Some taskbar implementations then keep
showing the previous icon after switching conversation tabs.

Scale buddy icons used as window icons to the same maximum size used by the
conversation buddy icon UI. Also desaturate offline buddy icons on the scaled
copy instead of modifying the animation's static pixbuf in place.

Testing Done:
Built pidgin/gtkconv.o in an Arch makepkg build tree.

--- a/pidgin/gtkconv.c
+++ b/pidgin/gtkconv.c
@@ -213,6 +213,41 @@
 	return node;
 }
 
+static GdkPixbuf *
+pidgin_conv_create_window_icon(GdkPixbuf *pixbuf, gboolean offline)
+{
+	GdkPixbuf *window_icon = NULL;
+	int height, max_size, scaled_height, scaled_width, width;
+
+	g_return_val_if_fail(pixbuf != NULL, NULL);
+
+	width = gdk_pixbuf_get_width(pixbuf);
+	height = gdk_pixbuf_get_height(pixbuf);
+	max_size = BUDDYICON_SIZE_MAX;
+
+	/* Keep _NET_WM_ICON small enough for X11 and taskbar implementations. */
+	if (width <= max_size && height <= max_size) {
+		window_icon = offline ? gdk_pixbuf_copy(pixbuf) : g_object_ref(pixbuf);
+	} else if (width >= height) {
+		scaled_width = max_size;
+		scaled_height = MAX(1, height * scaled_width / width);
+		window_icon = gdk_pixbuf_scale_simple(pixbuf, scaled_width,
+		                                      scaled_height,
+		                                      GDK_INTERP_BILINEAR);
+	} else {
+		scaled_height = max_size;
+		scaled_width = MAX(1, width * scaled_height / height);
+		window_icon = gdk_pixbuf_scale_simple(pixbuf, scaled_width,
+		                                      scaled_height,
+		                                      GDK_INTERP_BILINEAR);
+	}
+
+	if (window_icon != NULL && offline)
+		gdk_pixbuf_saturate_and_pixelate(window_icon, window_icon, 0.0, FALSE);
+
+	return window_icon;
+}
