post_install() {
    # Copy config to user directory if it doesn't exist
    if [ ! -f "$HOME/.config/rushfetch/config.toml" ]; then
        mkdir -p "$HOME/.config/rushfetch"
        cp /etc/rushfetch/config.toml "$HOME/.config/rushfetch/config.toml"
        echo "✓ Configuration copied to ~/.config/rushfetch/config.toml"
    fi

    cat << 'EOF'

╔════════════════════════════════════════════════════════════════╗
║              COMRADE! rushfetch is now installed!              ║
╚════════════════════════════════════════════════════════════════╝

Default configuration file location: /etc/rushfetch/config.toml
Your personal configuration: ~/.config/rushfetch/config.toml

FEATURES OF GLORIOUS RUSHFETCH:
  ☭ Multiple languages (english/russian)
  ☭ Custom color themes (like flag of motherland!)
  ☭ Configurable categories with subcategories
  ☭ Custom command fields (show anything you want!)
  ☭ GPU detection, network info, and more
  ☭ Written in Rust (BLAZING fast like Soyuz rocket!)

NOW RUN COMMAND, COMRADE:
    rushfetch

FOR RUSSIAN VERSION, EDIT CONFIG AND SET:
    language = "russian"

GLORY TO OPEN SOURCE, GLORY TO COMMUNISM!

EOF
}

post_upgrade() {
    cat << EOF

╔════════════════════════════════════════════════════════════════╗
║         COMRADE! rushfetch upgraded to version $1         ║
╚════════════════════════════════════════════════════════════════╝

Check /etc/rushfetch/config.toml for new features!
Your personal config at ~/.config/rushfetch/config.toml is safe.

to update the config to the current one, just run:
    cp /etc/rushfetch/config.toml ~/.config/rushfetch/

but this will erase your previous config

CONTINUE THE REVOLUTION!

EOF
}

