post_install() {
  cat <<'EOF'
==> gpu_unlock now loads ahead of nvidia in the initramfs but does nothing until
==> you opt in on the kernel command line:
==>   gpu_unlock.targets=all              every supported unbound card
==>   gpu_unlock.targets=0000:01:00.0     only these PCI addresses (comma-separated)
==> Remove the option in your bootloader to boot without the unlock.
==> Laptops: also set `options nvidia NVreg_DynamicPowerManagement=0x00`,
==> or the unlock is lost when the GPU powers down.
==> Rebuild the initramfs after install, upgrade and removal:
==>   mkinitcpio -P   (dracut users: dracut --regenerate-all --force)
==> See /usr/share/doc/gpu-unlock/README.md.
EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  echo "==> Rebuild the initramfs and remove gpu_unlock.targets= from the kernel command line."
}
