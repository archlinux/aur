# =============================================================================
# Odysseus AI — curated environment for the AUR package odysseus-ai-git
# -------------------------------------------------------------------
# Owned by the odysseus-ai-git package. Local edits survive upgrades.
# Backup: this file is in pacman's backup=(). Treat the whole file as secret.
#
# For the authoritative upstream env-var list, see
#   https://github.com/pewdiepie-archdaemon/odysseus/blob/main/.env.example
# Only the vars the app actually reads are listed here; upstream's
# .env.example contains 8+ dead vars (APP_BIND, CHROMADB_BIND, NTFY_*,
# RESEARCH_LLM_ENDPOINT, PUID, PGID, VLLM_USE_FLASHINFER_SAMPLER,
# CUDA_HOME) that are NOT honored at runtime.
#
# This file is mode 0640 root:odysseus so the systemd unit (running as
# the odysseus user) can read it; other local users cannot.
# =============================================================================


# -----------------------------------------------------------------------------
# --- SECURITY NOTICE — READ THIS FIRST ---
# -----------------------------------------------------------------------------
# Odysseus exposes an admin-only shell-execution surface:
#     POST /api/shell/exec      (arbitrary command, default timeout 30s)
#     POST /api/shell/stream    (arbitrary command, default timeout 120s,
#                                can be set to 0 = no timeout)
# Both run as the systemd service user with the service user's full $HOME
# and full inherited environment. They are not sandboxed.
#
# The upstream project acknowledges this in THREAT_MODEL.md "Known Gap #1":
#     "No shell/filesystem sandbox. The agent bash and read_file/write_file
#      tools run as the app process user with no network egress filtering
#      or filesystem confinement."
#
# Hardening recommendations:
#   1. Keep APP_BIND=127.0.0.1 (the default). Do not change to 0.0.0.0
#      without a reverse proxy that authenticates and rate-limits /api/shell/*.
#   2. AUTH_ENABLED=true (default). The AUR unit assumes this.
#   3. LOCALHOST_BYPASS=false (default). Set true ONLY on a single-user dev box.
#   4. SECURE_COOKIES=true when serving via trusted HTTPS reverse proxy.
#   5. Rotate the default admin password immediately after first login
#      (Settings -> Users).
#   6. If you don't use the Cookbook or the agent, consider a reverse
#      proxy that strips /api/shell/* and /api/cookbook/*.
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# --- 0. Admin password (first boot only) ---
# -----------------------------------------------------------------------------
# Auto-generated by post_install. Used once on first boot to seed the
# `admin` account. Subsequent boots ignore it. Change the password
# in Settings -> Users after first login.
# -----------------------------------------------------------------------------
ODYSSEUS_INTERNAL_TOKEN=""
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=""

# Skip the interactive admin prompt (we run setup.py non-interactively)
ODYSSEUS_SKIP_ADMIN_PROMPT=1


# -----------------------------------------------------------------------------
# --- 1. Web UI bind & auth (security posture) ---
# -----------------------------------------------------------------------------
# The systemd unit binds to 127.0.0.1:7000 by default. APP_PORT here is
# only read by the companion-bridge QR code generator; if you change
# APP_PORT, also edit the unit's ExecStart to match.
APP_PORT=7000
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000


# -----------------------------------------------------------------------------
# --- 2. Storage paths (need ReadWritePaths= in the unit) ---
# -----------------------------------------------------------------------------
DATA_DIR=/var/lib/odysseus-ai/data
DATABASE_URL=sqlite:////var/lib/odysseus-ai/data/app.db
FASTEMBED_CACHE_PATH=/var/cache/odysseus-ai/fastembed
ODYSSEUS_MAIL_ATTACHMENTS_DIR=/var/lib/odysseus-ai/data/mail-attachments


# -----------------------------------------------------------------------------
# --- 3. LLM providers (most keys configured in-app under
#        Settings -> Model Endpoints; this is the pre-seed escape hatch) ---
# -----------------------------------------------------------------------------
LLM_HOST=localhost
LLM_HOSTS=
# OPENAI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_URL=
LM_STUDIO_URL=
# LLM_CA_BUNDLE=/etc/odysseus-ai/ca/extra-roots.pem


# -----------------------------------------------------------------------------
# --- 4. Web search (SearXNG runs separately — see AUR README for compose) ---
# -----------------------------------------------------------------------------
SEARXNG_INSTANCE=http://localhost:8080
SEARXNG_GENERAL_ENGINES=bing,mojeek,presearch
# DATA_BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_PSE_CX=
# TAVILY_API_KEY=
# SERPER_API_KEY=


# -----------------------------------------------------------------------------
# --- 5. Embeddings ---
# -----------------------------------------------------------------------------
# EMBEDDING_URL=                       # auto: http://${LLM_HOST}:11434/v1/embeddings
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
EMBEDDING_BLOCK_PRIVATE_IPS=false
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2


# -----------------------------------------------------------------------------
# --- 6. ChromaDB (vector store) ---
# -----------------------------------------------------------------------------
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
CHROMADB_CONNECT_TIMEOUT=2.0


# -----------------------------------------------------------------------------
# --- 7. Email (IMAP / SMTP) ---
# -----------------------------------------------------------------------------
# Prefer the in-app Settings -> Email Accounts form; that stores creds
# Fernet-encrypted in data/app.db::email_accounts. The vars below are
# a legacy single-account fallback used ONLY when no EmailAccount row
# exists. Treat SMTP_PASSWORD and IMAP_PASSWORD as APP PASSWORDS.
#
# Gmail app passwords:    https://myaccount.google.com/apppasswords
# Microsoft app passwords: https://account.live.com/proofs/AppPassword
# Yahoo app passwords:    account security -> app password
# iCloud app passwords:   https://appleid.apple.com -> app-specific
# -----------------------------------------------------------------------------
# IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# IMAP_PASSWORD=
IMAP_SSL=false
IMAP_STARTTLS=true
# SMTP_HOST=
SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=
SMTP_SSL=true
SMTP_STARTTLS=false
# EMAIL_FROM=
ARCHIVE_FOLDER=Archive
TRASH_FOLDER=Trash
EMAIL_SOCKET_TIMEOUT=20
# ODYSSEUS_IMAP_TIMEOUT_SECONDS=


# -----------------------------------------------------------------------------
# --- 8. CardDAV (configured in-app) ---
# -----------------------------------------------------------------------------
# Prefer Settings -> Calendar. No env var for CalDAV credentials.
ODYSSEUS_ALLOW_PRIVATE_CALDAV=0


# -----------------------------------------------------------------------------
# --- 9. OAuth / public URL (MCP) ---
# -----------------------------------------------------------------------------
# Set to your public origin (no trailing slash) for LAN/HTTPS deployments.
# Defaults to http://localhost:7000 if unset.
# OAUTH_REDIRECT_BASE_URL=https://odysseus.example.com
# APP_PUBLIC_URL=


# -----------------------------------------------------------------------------
# --- 10. GitHub Copilot (device flow) ---
# -----------------------------------------------------------------------------
# Defaults are the public VS Code client. Override only if you registered
# your own allow-listed GitHub OAuth app.
ODYSSEUS_COPILOT_CLIENT_ID=01ab8ac9400c4e429b23
ODYSSEUS_COPILOT_API_VERSION=2026-06-01
ODYSSEUS_COPILOT_USER_AGENT=Odysseus/1.0
ODYSSEUS_COPILOT_INTEGRATION_ID=vscode-chat
ODYSSEUS_COPILOT_EDITOR_VERSION=Odysseus/1.0


# -----------------------------------------------------------------------------
# --- 11. HuggingFace (gated models, cookbook downloads) ---
# -----------------------------------------------------------------------------
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=


# -----------------------------------------------------------------------------
# --- 12. Feature flags ---
# -----------------------------------------------------------------------------
REQUEST_HARD_TIMEOUT=45
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
ODYSSEUS_INPROCESS_POLLERS=1
ODYSSEUS_INPROCESS_TASKS=1
ODYSSEUS_FALLBACK_OWNER=owner@localhost
ODYSSEUS_SINGLE_USER=1
ODYSSEUS_SCRIPT_HOST=localhost
ODYSSEUS_PERSONAL_UPLOAD_MAX_BYTES=26214400
ODYSSEUS_GALLERY_UPLOAD_MAX_BYTES=104857600
ODYSSEUS_GALLERY_TRANSFORM_UPLOAD_MAX_BYTES=26214400
ODYSSEUS_MEMORY_IMPORT_MAX_BYTES=10485760
EMBEDDING_BLOCK_PRIVATE_IPS=false
IMAGE_BLOCK_PRIVATE_IPS=false
REMINDER_WEBHOOK_BLOCK_PRIVATE_IPS=false
CARDDAV_BLOCK_PRIVATE_IPS=false


# -----------------------------------------------------------------------------
# --- 13. MCP ---
# -----------------------------------------------------------------------------
# ODYSSEUS_DISABLE_MCP=  # set to 1 to disable built-in MCP servers
