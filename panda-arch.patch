+} PandaDwarfLocdesc;
+
+typedef PandaDwarfLocdesc Dwarf_Locdesc;
+
+static int panda_dwarf_loclist_n(Dwarf_Attribute attr,
+        PandaDwarfLocdesc ***out, Dwarf_Signed *count, Dwarf_Error *err)
+{
+    Dwarf_Loc_Head_c head = 0;
+    Dwarf_Unsigned entry_count = 0;
+    int rc = dwarf_get_loclist_c(attr, &head, &entry_count, err);
+    if (rc != DW_DLV_OK) {
+        return rc;
+    }
+
+    PandaDwarfLocdesc **list =
+        (PandaDwarfLocdesc **)calloc(entry_count, sizeof(*list));
+    if (list == NULL) {
+        dwarf_dealloc_loc_head_c(head);
+        return DW_DLV_ERROR;
+    }
+
+    Dwarf_Unsigned i;
+    PandaDwarfLocdesc *desc = NULL;
+    for (i = 0; i < entry_count; i++) {
+        desc = NULL;
+        Dwarf_Small lle_value = 0;
+        Dwarf_Small loclist_source = 0;
+        Dwarf_Unsigned rawlowpc = 0;
+        Dwarf_Unsigned rawhighpc = 0;
+        Dwarf_Bool debug_addr_unavailable = FALSE;
+        Dwarf_Addr lowpc_cooked = 0;
+        Dwarf_Addr hipc_cooked = 0;
+        Dwarf_Unsigned op_count = 0;
+        Dwarf_Locdesc_c entry = 0;
+        Dwarf_Unsigned expression_offset = 0;
+        Dwarf_Unsigned locdesc_offset = 0;
+
+        rc = dwarf_get_locdesc_entry_d(head, i, &lle_value, &rawlowpc,
+                &rawhighpc, &debug_addr_unavailable, &lowpc_cooked,
+                &hipc_cooked, &op_count, &entry, &loclist_source,
+                &expression_offset, &locdesc_offset, err);
+        if (rc != DW_DLV_OK) {
+            goto fail;
+        }
+
+        desc = (PandaDwarfLocdesc *)calloc(1, sizeof(*desc));
+        if (desc == NULL) {
+            rc = DW_DLV_ERROR;
+            goto fail;
+        }
+        desc->ld_lopc = (loclist_source == DW_LKIND_expression) ? 0 : rawlowpc;
+        desc->ld_hipc = (loclist_source == DW_LKIND_expression) ?
+            (Dwarf_Addr)-1 : rawhighpc;
+        desc->ld_cents = op_count;
+        desc->ld_section_offset = locdesc_offset;
+
+        list[i] = desc;
+        desc->ld_s = (PandaDwarfLoc *)calloc(
+            op_count ? op_count : 1, sizeof(*desc->ld_s));
+        if (desc->ld_s == NULL) {
+            rc = DW_DLV_ERROR;
+            goto fail;
+        }
+
+        Dwarf_Unsigned j;
+        for (j = 0; j < op_count; j++) {
+            Dwarf_Small op = 0;
+            Dwarf_Unsigned operand1 = 0;
+            Dwarf_Unsigned operand2 = 0;
+            Dwarf_Unsigned operand3 = 0;
+            Dwarf_Unsigned offset_for_branch = 0;
+            rc = dwarf_get_location_op_value_c(entry, j, &op, &operand1,
+                    &operand2, &operand3, &offset_for_branch, err);
+            if (rc != DW_DLV_OK) {
+                goto fail;
+            }
+            desc->ld_s[j].lr_atom = op;
+            desc->ld_s[j].lr_number = operand1;
+            desc->ld_s[j].lr_number2 = operand2;
+            desc->ld_s[j].lr_offset = offset_for_branch;
+        }
+        continue;
+
+fail:
+        for (Dwarf_Unsigned k = 0; k <= i; k++) {
+            if (list[k] != NULL) {
+                free(list[k]->ld_s);
+                free(list[k]);
+            }
+        }
+        free(list);
+        dwarf_dealloc_loc_head_c(head);
+        return rc;
+    }
+
+    dwarf_dealloc_loc_head_c(head);
