+
+static void qcrypto_aes_set_encrypt_key(QCryptoNettleAES *ctx,
+                                        size_t key_size, const uint8_t *key)
+{
+    ctx->key_size = key_size;
+    switch (key_size) {
+    case 16:
+        aes128_set_encrypt_key(&ctx->enc.aes128, key);
+        break;
+    case 24:
+        aes192_set_encrypt_key(&ctx->enc.aes192, key);
+        break;
+    case 32:
+        aes256_set_encrypt_key(&ctx->enc.aes256, key);
+        break;
+    default:
+        abort();
+    }
+}
+
+static void qcrypto_aes_set_decrypt_key(QCryptoNettleAES *ctx,
+                                        size_t key_size, const uint8_t *key)
+{
+    ctx->key_size = key_size;
+    switch (key_size) {
+    case 16:
+        aes128_set_decrypt_key(&ctx->dec.aes128, key);
+        break;
+    case 24:
+        aes192_set_decrypt_key(&ctx->dec.aes192, key);
+        break;
+    case 32:
+        aes256_set_decrypt_key(&ctx->dec.aes256, key);
+        break;
+    default:
+        abort();
+    }
+}
+
+static void qcrypto_aes_encrypt(const QCryptoNettleAES *ctx,
+                                size_t length, uint8_t *dst,
+                                const uint8_t *src)
+{
+    switch (ctx->key_size) {
+    case 16:
+        aes128_encrypt(&ctx->enc.aes128, length, dst, src);
+        break;
+    case 24:
+        aes192_encrypt(&ctx->enc.aes192, length, dst, src);
+        break;
+    case 32:
+        aes256_encrypt(&ctx->enc.aes256, length, dst, src);
+        break;
+    default:
+        abort();
+    }
+}
+
+static void qcrypto_aes_decrypt(const QCryptoNettleAES *ctx,
+                                size_t length, uint8_t *dst,
+                                const uint8_t *src)
+{
+    switch (ctx->key_size) {
+    case 16:
+        aes128_decrypt(&ctx->dec.aes128, length, dst, src);
+        break;
+    case 24:
+        aes192_decrypt(&ctx->dec.aes192, length, dst, src);
+        break;
+    case 32:
+        aes256_decrypt(&ctx->dec.aes256, length, dst, src);
+        break;
+    default:
+        abort();
+    }
+}
