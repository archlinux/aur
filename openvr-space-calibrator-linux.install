post_install() {
    echo "Installing Space Calibrator driver to SteamVR..."
    /usr/bin/openvr-space-calibrator-install || true
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "Removing Space Calibrator driver from SteamVR..."
    
    STEAMVR_DRIVERS_DIR="$HOME/.local/share/SteamVR/drivers/01spacecalibrator"
    
    if [ -d "$STEAMVR_DRIVERS_DIR" ]; then
        rm -rf "$STEAMVR_DRIVERS_DIR"
    fi
    
    # Unregister driver
    VRPATHREG=""
    for path in \
        "$HOME/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrpathreg" \
        "$HOME/.steam/steam/steamapps/common/SteamVR/bin/linux64/vrpathreg" \
        "$HOME/.steam/root/steamapps/common/SteamVR/bin/linux64/vrpathreg"; do
        if [ -f "$path" ]; then
            VRPATHREG="$path"
            break
        fi
    done
    
    if [ -z "$VRPATHREG" ] && command -v vrpathreg &> /dev/null; then
        VRPATHREG="vrpathreg"
    fi
    
    if [ -n "$VRPATHREG" ] && [ -d "$STEAMVR_DRIVERS_DIR" ]; then
        if [ -f "$VRPATHREG" ]; then
            VRPATHREG_DIR="$(dirname "$VRPATHREG")"
            LD_LIBRARY_PATH="$VRPATHREG_DIR:$LD_LIBRARY_PATH" "$VRPATHREG" removedriver "$STEAMVR_DRIVERS_DIR" 2>/dev/null || true
        else
            "$VRPATHREG" removedriver "$STEAMVR_DRIVERS_DIR" 2>/dev/null || true
        fi
    fi
}

