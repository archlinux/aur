# makepkg 打包时会剥离 setuid 位，chrome-sandbox 的权限只能在安装后恢复。
# 与上游 electron-builder 的 .INSTALL 保持一致：内核支持 user namespace 时用 0755，
# 否则回退到 4755，避免 Electron 在沙箱检查阶段启动失败。
_zcode_open_fix_chrome_sandbox() {
  if [ -L /proc/self/ns/user ] && unshare --user true 2>/dev/null; then
    chmod 0755 /opt/ZCode/chrome-sandbox || true
  else
    chmod 4755 /opt/ZCode/chrome-sandbox || true
  fi
}

_zcode_open_update_caches() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
  if command -v update-mime-database >/dev/null 2>&1; then
    update-mime-database /usr/share/mime || true
  fi
}

post_install() {
  _zcode_open_fix_chrome_sandbox
  _zcode_open_update_caches
}

post_upgrade() {
  _zcode_open_fix_chrome_sandbox
  _zcode_open_update_caches
}

post_remove() {
  _zcode_open_update_caches
}
