post_upgrade() {
	echo "-------------------------------------------------------------------"
  echo ">>    要让此软件生效，您必须添加您的用户到 'wireshark' 群组。"
	echo ">>    可以运行以下命令："
	echo ""
  echo ">>    sudo usermod -aG wireshark \$USER"
	echo ""
  echo ">>    然后，注销并重新登录（或重启）以使其生效。"
  echo ">>    To use this software efficiently, you must add your user"
	echo ">>    to the 'wireshark' group."
	echo ">>    You can Run the following command:"
	echo ""
  echo ">>    sudo usermod -aG wireshark \$USER"
	echo ""
  echo ">>    Then, LOGOUT and LOGIN again (or restart) for it to take effect."
	echo "-------------------------------------------------------------------"
}

post_install() {
  post_upgrade
}
