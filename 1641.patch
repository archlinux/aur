+      #  run: |
+      #    echo '
+      #      cd "$GITHUB_WORKSPACE"
+      #      export CC=clang
+      #      meson setup build-clang-ci -Dxwayland=enabled -Db_sanitize=undefined --werror --force-fallback-for=wayland
+      #      meson compile -C build-clang-ci
+      #      scripts/ci/smoke-test.sh build-clang-ci
+      #    ' | $TARGET
 
       # Void-musl doesn't support sanitizer
       - name: Build with gcc - runtime test w/o sanitizer
@@ -215,7 +216,7 @@ jobs:
           echo '
             cd "$GITHUB_WORKSPACE"
             export CC=gcc
-            meson setup build-gcc-ci -Dxwayland=enabled --werror
+            meson setup build-gcc-ci -Dxwayland=enabled --werror --force-fallback-for=wayland
             meson compile -C build-gcc-ci
             LABWC_RUNS=20 scripts/ci/smoke-test.sh build-gcc-ci
           ' | $TARGET
