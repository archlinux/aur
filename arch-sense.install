# pacman scriptlets for arch-sense. They reload udev so the new rules reach the
# hardware right away, and say what to do next. pacman's own systemd hooks create
# the group and the state folder and reload units after the transaction.
# Boot Restore (arch-sense.service) is opt-in: nothing here enables it, and an
# upgrade from v1 (which enabled it unasked) switches it off.

_arch_sense_live() {
  # A booted system, not a chroot (e.g. arch-chroot during an install).
  systemd-notify --booted >/dev/null 2>&1 && ! systemd-detect-virt --chroot >/dev/null 2>&1
}

_arch_sense_apply_rules() {
  _arch_sense_live || return 0
  # udev can only hand out a group that exists; pacman's sysusers hook runs too late.
  systemd-sysusers arch-sense.conf >/dev/null 2>&1 || true
  udevadm control --reload >/dev/null 2>&1 || true
  udevadm trigger --action=change --subsystem-match=platform --sysname-match=acer-wmi >/dev/null 2>&1 || true
  udevadm trigger --action=change --subsystem-match=platform-profile >/dev/null 2>&1 || true
  udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=04f2 --attr-match=idProduct=0117 >/dev/null 2>&1 || true
}

_arch_sense_v1_leftovers() {
  if [ -e /etc/udev/rules.d/70-arch-sense.rules ] || [ -e /etc/systemd/system/arch-sense-permissions.service ]; then
    cat <<'EOF'
==> Arch-Sense v1 set up permissions by hand; the package handles that now.
    Remove the old files so they stop running a command that no longer exists:
      sudo systemctl disable arch-sense-permissions.service
      sudo rm -f /etc/udev/rules.d/70-arch-sense.rules /etc/systemd/system/arch-sense-permissions.service
EOF
  fi
}

post_install() {
  _arch_sense_apply_rules
  cat <<'EOF'
==> Arch-Sense: one step left to run it without sudo. Join the arch-sense group:
      sudo usermod -aG arch-sense $USER
    then log out and back in (group changes only reach new logins).
==> Optional Boot Restore, to reapply your Saved Lighting at every boot:
      sudo systemctl enable arch-sense.service
==> Something not working? Run: arch-sense doctor
EOF
  _arch_sense_v1_leftovers
}

_arch_sense_v1_boot_restore() {
  # v1's post_upgrade enabled Boot Restore for everyone; in v2 it is opt-in.
  systemctl --quiet is-enabled arch-sense.service >/dev/null 2>&1 || return 0
  systemctl --quiet --no-reload disable arch-sense.service >/dev/null 2>&1 || true
  echo "==> Boot Restore is opt-in now, so it has been switched off; keep it with: sudo systemctl enable arch-sense.service"
}

post_upgrade() {
  _arch_sense_apply_rules
  # $2 is the version being upgraded from.
  if [ "$(vercmp "$2" 2.0.0)" -lt 0 ]; then
    _arch_sense_v1_boot_restore
  fi
  _arch_sense_v1_leftovers
}

pre_remove() {
  # Boot Restore is the user's opt-in, but its enable symlink shouldn't outlive the unit.
  systemctl --quiet --no-reload disable arch-sense.service >/dev/null 2>&1 || true
}

post_remove() {
  # Only removes the state folder if it's empty; Saved Lighting is the user's data.
  rmdir /var/lib/arch-sense 2>/dev/null || true
  echo "==> Arch-Sense removed. Left behind on purpose, should you want them gone too:"
  if [ -d /var/lib/arch-sense ]; then
    echo "      sudo rm -r /var/lib/arch-sense    # your Saved Lighting"
  fi
  echo "      sudo groupdel arch-sense          # the group (pacman never deletes groups)"
}
