## Append args after start command in gcopy.service
## Must include: -app-key <key> -smtp-host <smtp_host> -smtp-password <smtp_password> -smtp-username <smtp_username>
## More info to run: gcopy -h
## For example: APPEND_ARGS="-app-key='abcdefghijklmn' -smtp-host='mail.example.com' -smtp-password='abcdefghijklmn' -smtp-username='user'"
APPEND_ARGS=""
