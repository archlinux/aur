## Append args after start command in gcopy.service, more info to run: gcopy -h
## 1. Email mode must include: -auth-mode=email -app-key=<key> -smtp-host=<smtp_host> -smtp-password=<smtp_password> -smtp-username=<smtp_username>
##    For example: APPEND_ARGS="-auth-mode=email -app-key='rqMrHprILwYintES4UeQc0wM/252SLy59y7LMYKXJE0=' -smtp-host='smtp.example.com' -smtp-password='your_password' -smtp-username='username@example.com'"
## 2. Token mode must include: -auth-mode=token -app-key=<key>
##    For example: APPEND_ARGS="-auth-mode=token -app-key='rqMrHprILwYintES4UeQc0wM/252SLy59y7LMYKXJE0='"
## In addition to the above parameters, please add other parameters as needed. For more parameters, please refer: gcopy -h

APPEND_ARGS=""
