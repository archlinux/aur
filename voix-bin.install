post_install() {
    echo ">>> Voix (pre-built) has ascended to your system."
    echo ">>> The runes of ordination are found at /etc/voix.conf"
    echo ">>> The Ritual of Proof (PAM) is handled at /etc/pam.d/voix"
    echo ">>> sudo and doas symlinks are provided at /usr/bin/"
}

post_upgrade() {
    echo ">>> The artifact has been reforged. Rites remain preserved."
    post_install
}
