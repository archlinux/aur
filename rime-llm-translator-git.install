post_install() {
    echo -e "\e[1;36m=======================================================================\e[0m"
    echo -e "\e[1;32m  Rime-LLM Translator 安装完成！欢迎使用 🎉\e[0m"
    echo -e "\e[1;36m=======================================================================\e[0m"
    echo -e "  \e[1;33m1. 前置要求:\e[0m"
    echo -e "     请确保您已经安装了 Rime 输入法及 \e[1m雾凇拼音 (rime-ice)\e[0m。"
    echo -e "     (如果您使用其他方案，需手动修改 custom.yaml 挂载)"
    echo -e ""
    echo -e "  \e[1;33m2. 自动初始化:\e[0m"
    echo -e "     请在\e[1;31m普通用户\e[0m下打开终端（切勿使用 sudo），运行以下命令："
    echo -e "     \e[1;34mrime-llm-config init\e[0m"
    echo -e "     该命令会自动修改 Rime 配置、打补丁，并尝试重启 Fcitx5 生效。"
    echo -e ""
    echo -e "  \e[1;33m3. 配置大模型:\e[0m"
    echo -e "     随时在终端运行配置工具进入图形界面："
    echo -e "     \e[1;34mrime-llm-config\e[0m"
    echo -e "     (默认自带的 opencode zen 公共节点仅供测通体验，建议尽快配置您自己的 API Key)"
    echo -e "\e[1;36m=======================================================================\e[0m"
}

post_upgrade() {
    post_install
    echo -e "  \e[1;33m升级提示:\e[0m"
    echo -e "     · 从 r58 之前升上来的话，触发键处理器要重新运行 \e[1;34mrime-llm-config init\e[0m 注册"
    echo -e "       （修复选候选 2 时 vv 残留），在此之前旧接法仍可用。"
    echo -e "     · 本版本新增 \e[1mmiyu:\e[0m 前缀，可以在输入法里直接跟 Miyu 对话（需装 Miyu 0.5.0 之后的版本）。"
    echo -e "       升级后跑一次 \e[1;34mrime-llm-config sync\e[0m 重新导出 config.lua 才会生效。"
    echo -e "     · \e[1mbase:\e[0m 前缀改由程序计算，不再让模型算 base64，结果不会再出错。"
}
