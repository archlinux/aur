[Unit]
Description=Dynamic Fn Lock Toggle based on Modifier Keys
Documentation=https://example.com/your-script-docs  # Optional: add if you host docs
After=multi-user.target
# Wait for the platform device providing fn_lock
Requires=VPC2004:00.device
After=VPC2004:00.device

[Service]
Type=simple
User=auto-fn-lock
Group=input
ExecStart=/usr/bin/python3 /usr/local/bin/auto_fn_lock.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=strict
DeviceAllow=/dev/input/event* r
ReadWritePaths=/sys/bus/platform/devices/VPC2004:00/fn_lock
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_NICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_SYS_NICE
StandardOutput=journal
StandardError=journal

# Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
