#!/bin/bash

SHELL=${SHELL:-/bin/bash}

#=========================================================================================
PINK_NEON='\033[1;35m'
YELLOW_NEON='\033[1;33m'
NC='\033[0m' 
RED_NEON='\033[1;31m'
#=========================================================================================


# os comentarios estão separados por//the comments are separated by ----------------------<<< para facilitar leitura dos blocos//to make the blocks easier to read

# --- [SISTEMA] MODO SENTINELA: APENAS CHECAGEM // [SYSTEM] SENTINEL MODE: CHECK ONLY ----------------------------------------------------------------<<<

LOG_SENTINEL_DIR="$HOME/.logs_sentinel_check"
mkdir -p "$LOG_SENTINEL_DIR"

ROTATE_SENTINEL_LOGS() {
    # Mantém apenas os 3 logs mais recentes da sentinela//Keeps only the 3 most recent sentinel logs
    local LOG_COUNT
LOG_COUNT=$(find "$LOG_SENTINEL_DIR" -maxdepth 1 -name "check_*.log" | wc -l)
    if [ "$LOG_COUNT" -ge 3 ]; then
        find "$LOG_SENTINEL_DIR" -maxdepth 1 -name "check_*.log" -type f -printf '%T@ %p\n' | sort -n | head -n 1 | cut -d' ' -f2- | xargs rm
    fi
}
#=========================================================================================

VERIFICAR_IDIOMA() {
    
    local sys_locale="${LC_ALL:-${LANG:-$LC_MESSAGES}}"
    
   
    local sys_lang="${sys_locale%%.*}"

    
    IDIOMA_SISTEMA=""

    echo -e "${CYAN_NEON}[LANG CHECK] Detectando idioma do sistema operacional...${NC}"

    case "$sys_lang" in
        pt*|PT*)
            IDIOMA_SISTEMA="PT_BR"
            if [[ "$sys_lang" == "pt_BR" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: PT-BR (Português Brasil)${NC}"
            else
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: PT-BR (Português Brasil)${NC}"
            fi
            ;;

        es*|ES*)
            IDIOMA_SISTEMA="ES_ES"
            if [[ "$sys_lang" == "es_ES" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: ES-ES (Español España)${NC}"
            else
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: ES-ES (Español España)${NC}"
            fi
            ;;

        en*|EN*)
            IDIOMA_SISTEMA="EN_US"
            if [[ "$sys_lang" == "en_US" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: EN-US (English United States)${NC}"
            else
                # Mapeia qualquer variação de inglês (en_CA, en_GB, en_AU, etc.) para EN-US
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: EN-US (English United States)${NC}"
            fi
            ;;

        *)
            IDIOMA_SISTEMA="EN_US"
            if [[ -n "$sys_lang" ]]; then
                # Idioma não suportado diretamente (ex: ja_JP, fr_FR) caindo no Fallback EN-US
                echo -e "${YELLOW_NEON}[LANG] Idioma não suportado: '$sys_lang' ===> Aplicando Fallback: EN-US (English United States)${NC}"
            else
                echo -e "${NEON_BLUE}[LANG] Nenhum locale definido no ambiente ===> Aplicando Padrão Global: EN-US${NC}"
            fi
            ;;
    esac
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""

}

VERIFICAR_IDIOMA

msg() {
    local pt_msg="$1"  # 1º argumento: Português (PT-BR)
    local en_msg="$2"  # 2º argumento: Inglês (EN-US)
    local es_msg="$3"  # 3º argumento: Espanhol (ES-ES)

    case "$IDIOMA_SISTEMA" in
        "PT_BR") echo -e "$pt_msg" ;;
        "EN_US") echo -e "$en_msg" ;;
        "ES_ES") echo -e "$es_msg" ;;
        *)       echo -e "$en_msg" ;; # Fallback padrão para Inglês
    esac
}

export -f msg

msg "Status: Modo Sentinela Ativo. Apenas checagem de atualizações." \
    "Status: Sentinel Mode Active. Check only for updates." \
    "Estado: Modo Centinela Activo. Solo comprobación de actualizaciones."

# MÓDULO SENTINELA: NOTIFICAÇÕES VISUAIS // SENTINEL VISUAL NOTIFICATIONS ------------------------

NOTIFICAR_SENTINELA(){
    local TOTAL_UPDATES="$1"
    ICON_DIR="/usr/share/arch-update-full/icons"
    export ICON_AZUL="$ICON_DIR/farol_azul_simbolo.png"
    export ICON_AMARELO="$ICON_DIR/farol_amarelo_simbolo.png"
    export ICON_VERMELHO="$ICON_DIR/farol_vermelho_simbolo.png"
    export ICON_KERNEL="$ICON_DIR/simbolo_tux_kernel_update.png"

    local CRITICO_DETECTADO=0
    local ICON_ESCOLHIDO="" URGENCIA="" TITULO="" MENSAGEM=""
    local ACAO_ESCOLHIDA="" NOTIF_EXIT=0

    # 1. Rastreia pacotes críticos (kernel/driver de vídeo)
    if command -v checkupdates &>/dev/null; then

    if checkupdates 2>/dev/null | grep -E -i \
        '^(linux|linux-lts|linux-zen|linux-firmware|amd-ucode|intel-ucode|nvidia|nvidia-open|nvidia-dkms|nvidia-open-dkms|nvidia-utils|mesa|vulkan-radeon|vulkan-intel|vulkan-nouveau|amdvlk|intel-media-driver|libva-mesa-driver|grub|limine|refind|syslinux|efibootmgr)[[:space:]]' \
        &>/dev/null; then

        CRITICO_DETECTADO=1

    fi

fi

    # 2. Define ícone/urgência SOMENTE pelo volume de pacotes
    if [[ "$TOTAL_UPDATES" -ge 34 ]]; then
        ICON_ESCOLHIDO="$ICON_VERMELHO"
        URGENCIA="critical"
        TITULO="🛡️ Sentinel: Maintenance Required!"
        MENSAGEM="<b>$TOTAL_UPDATES</b> pending updates.\n[!] High volume of packages detected."

    elif [[ "$TOTAL_UPDATES" -ge 18 ]] && [[ "$TOTAL_UPDATES" -le 33 ]]; then
        ICON_ESCOLHIDO="$ICON_AMARELO"
        URGENCIA="normal"
        TITULO="🛡️ Sentinel: Updates Accumulating"
        MENSAGEM="<b>$TOTAL_UPDATES</b> updates awaiting installation.\nRecommended to run the update soon."

    else
        ICON_ESCOLHIDO="$ICON_AZUL"
        URGENCIA="low"
        TITULO="🛡️ Sentinel: Updates Available"
        MENSAGEM="<b>$TOTAL_UPDATES</b> new packages in the repository.\nSystem stable, update when desired."
    fi

    # 3. Override: pacote crítico (kernel/driver) sempre usa o ícone Tux, independente do tier de volume
    if [[ "$CRITICO_DETECTADO" -eq 1 ]]; then
        ICON_ESCOLHIDO="$ICON_KERNEL"
        URGENCIA="critical"
        TITULO="🐧 Sentinel: Kernel/Driver Update Detected!"
        MENSAGEM="⚠️ Kernel or GPU driver update available.\n<b>$TOTAL_UPDATES</b> packages pending in total."
    fi

    echo "Status: Triggering notification ($URGENCIA) — waiting up to 37 min for operator..."

    # 37 minutos = 2220 segundos
    ACAO_ESCOLHIDA=$(timeout 2220 notify-send -w \
        -u "$URGENCIA" \
        -a "Arch Update Full" \
        -i "$ICON_ESCOLHIDO" \
        --action="run_update=Click to Launch App" \
        "$TITULO" \
        "$MENSAGEM" 2>/dev/null)
    NOTIF_EXIT=$?

    echo "[debug] NOTIF_EXIT=$NOTIF_EXIT | ACAO_ESCOLHIDA='$ACAO_ESCOLHIDA'"

    if [ "$NOTIF_EXIT" -eq 124 ]; then
        # timeout matou o notify-send após 37min sem clique
        echo "[info] 37-minute window expired. No action taken by operator."
    elif [[ "$ACAO_ESCOLHIDA" == "run_update" ]]; then
        # clique registrado
        FUNCTION_BOTAO
    else
        # usuário fechou/ignorou manualmente antes dos 37min
        echo "[info] Notification closed or dismissed. No action taken."
    fi
}
#============================================================================================================
FUNCTION_BOTAO() {
    echo "Status: Operator confirmed. Launching application..."
    echo "[debug] DISPLAY=$DISPLAY | WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
    echo "[debug] XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    echo "[debug] DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
    echo "[debug] XDG_CURRENT_DESKTOP=$XDG_CURRENT_DESKTOP"

    local LAUNCHER_PID LAUNCHER_OK=0

    if command -v gio &>/dev/null; then
        echo "[debug] usando gio"
        gio launch /usr/share/applications/arch-update-full.desktop &
        LAUNCHER_PID=$!
        sleep 0.8
        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            echo "[debug] gio pid=$LAUNCHER_PID vivo após 0.8s: OK"
            disown "$LAUNCHER_PID"
            LAUNCHER_OK=1
        else
            echo "[debug] gio encerrou em <0.8s (possível erro de ambiente)"
        fi

    elif command -v gtk-launch &>/dev/null; then
        echo "[debug] usando gtk-launch"
        gtk-launch arch-update-full.desktop &
        LAUNCHER_PID=$!
        sleep 0.8
        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            echo "[debug] gtk-launch pid=$LAUNCHER_PID vivo: OK"
            disown "$LAUNCHER_PID"
            LAUNCHER_OK=1
        else
            echo "[debug] gtk-launch encerrou em <0.8s (possível erro de ambiente)"
        fi

    elif command -v kioclient &>/dev/null; then
        echo "[debug] usando kioclient"
        kioclient exec /usr/share/applications/arch-update-full.desktop &
        LAUNCHER_PID=$!
        sleep 0.8
        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            disown "$LAUNCHER_PID"; LAUNCHER_OK=1
            echo "[debug] kioclient pid=$LAUNCHER_PID vivo: OK"
        else
            echo "[debug] kioclient encerrou em <0.8s (possível erro de ambiente)"
        fi

    elif command -v kioclient5 &>/dev/null; then
        echo "[debug] usando kioclient5"
        kioclient5 exec /usr/share/applications/arch-update-full.desktop &
        LAUNCHER_PID=$!
        sleep 0.8
        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            disown "$LAUNCHER_PID"; LAUNCHER_OK=1
            echo "[debug] kioclient5 pid=$LAUNCHER_PID vivo: OK"
        else
            echo "[debug] kioclient5 encerrou em <0.8s (possível erro de ambiente)"
        fi

    elif command -v dex &>/dev/null; then
        echo "[debug] usando dex"
        dex /usr/share/applications/arch-update-full.desktop &
        LAUNCHER_PID=$!
        sleep 0.8
        if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
            disown "$LAUNCHER_PID"; LAUNCHER_OK=1
            echo "[debug] dex pid=$LAUNCHER_PID vivo: OK"
        else
            echo "[debug] dex encerrou em <0.8s (possível erro de ambiente)"
        fi

    else
        echo "[debug] nenhum lançador padrão. Extraindo do .desktop..."
        local CMD_EXEC
        CMD_EXEC=$(awk '/^Exec=/ {sub(/^Exec=/, ""); gsub(/ *%[a-zA-Z]/, ""); print; exit}' \
            /usr/share/applications/arch-update-full.desktop)

        if [ -n "$CMD_EXEC" ]; then
            bash -c "$CMD_EXEC" &
            LAUNCHER_PID=$!
            sleep 0.8
            if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
                disown "$LAUNCHER_PID"; LAUNCHER_OK=1
                echo "[debug] cmd direto pid=$LAUNCHER_PID vivo: OK"
            else
                echo "[debug] cmd direto encerrou em <0.8s (possível erro de ambiente)"
            fi
        else
            echo "[warn] Falha ao extrair do .desktop. Tentando binário direto..."
            arch-update-full &
            LAUNCHER_PID=$!
            sleep 0.8
            if kill -0 "$LAUNCHER_PID" 2>/dev/null; then
                disown "$LAUNCHER_PID"; LAUNCHER_OK=1
                echo "[debug] binário direto pid=$LAUNCHER_PID vivo: OK"
            else
                echo "[debug] binário direto encerrou em <0.8s"
            fi
        fi
    fi

    
    if [ "$LAUNCHER_OK" -eq 0 ]; then
        echo "[warn] Nenhum lançador manteve processo vivo."
        echo "[warn] Verifique as variáveis de ambiente no log acima."
    fi
}
#=====================================================================================
CHECK_FOR_UPDATES() {
    ROTATE_SENTINEL_LOGS
    
    local LOG_FILE
    LOG_FILE="$LOG_SENTINEL_DIR/check_$(date '+%Y-%m-%d_%H-%M-%S').log"
    
    {
        echo "--- CHECK INICIADO EM / STARTED AT: $(date) ---"
        
        local AUR_H U_PACMAN U_AUR U_FLAT U_SNAP TOTAL
        
        AUR_H=$(command -v yay || command -v paru || command -v pikaur)
        
       
        if command -v checkupdates &>/dev/null; then
            U_PACMAN=$(checkupdates 2>/dev/null | wc -l | tr -d '[:space:]')
        else
            U_PACMAN=0
        fi
        : "${U_PACMAN:=0}"
        
      
        U_AUR=0
        if [[ -n "$AUR_H" ]]; then
            U_AUR=$($AUR_H -Qua 2>/dev/null | wc -l | tr -d '[:space:]')
        fi
        : "${U_AUR:=0}"
        
      
        U_FLAT=0
        if command -v flatpak &>/dev/null; then
            U_FLAT=$(flatpak remote-ls --updates 2>/dev/null | wc -l | tr -d '[:space:]')
        fi
        : "${U_FLAT:=0}"

        
        U_SNAP=0
        if command -v snap &>/dev/null; then
            U_SNAP=$(snap refresh --list 2>/dev/null | grep -c '^[^Name]' | tr -d '[:space:]')
        fi
        : "${U_SNAP:=0}"

       
        TOTAL=$(( U_PACMAN + U_AUR + U_FLAT + U_SNAP ))

        echo "Pacman: $U_PACMAN | AUR: $U_AUR | Flatpak: $U_FLAT | Snap: $U_SNAP"
        echo "Total: $TOTAL"
        
        if [ "$TOTAL" -gt 0 ]; then
            NOTIFICAR_SENTINELA "$TOTAL"
        else
            echo "Status: No pending updates detected. System is up to date."
            echo "Status: Sistema atualizado. Nenhuma ação necessária."
        fi

        echo "--- CHECK FINALIZADO EM / FINISHED AT: $(date) ---"

    } > "$LOG_FILE" 2>&1
}

#=================================================================================================
# --- [SISTEMA] PROTOCOLO DE AUTO-INSTALAÇÃO DA SENTINELA // Sentinel Self-Installation Protocol -------------------------------------------------------<<<

SETUP_SENTINEL() {
    local SERVICE_DIR="$HOME/.config/systemd/user"
    
    mkdir -p "$SERVICE_DIR"

    # Cria o arquivo de Serviço//Creates the Service file
    cat <<EOF > "$SERVICE_DIR/arch-sentinel.service"
[Unit]
Description=Sentinela de Atualizações Arch Update Full
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/arch-update-full-sentinela --check
EOF

    # Cria o arquivo de Timer (3 horas)//Creates the Timer file (3 hours)
    cat <<EOF > "$SERVICE_DIR/arch-sentinel.timer"
[Unit]
Description=Roda o Sentinela a cada 3 horas

[Timer]
OnBootSec=7min
OnUnitActiveSec=3h
Persistent=true

[Install]
WantedBy=timers.target
EOF

    # Recarrega e Ativa a Sentinela no Espaço do Usuário//Reloads and activates the sentinel in the user space
    systemctl --user daemon-reload
    systemctl --user enable --now arch-sentinel.timer >/dev/null 2>&1
}

# --- INTERCEPTADOR DE SINAL (MODO SENTINELA) //SIGNAL INTERCEPTOR -------------------------------------------------------------------<<
#nessa parte especifica mantive a verificaçao no google para apenas garantir conexao com a internet apenas checa se tem atualização não executa nada
#In this specific section, I kept the Google verification running only to ensure an internet connection; it just checks for updates and doesn't execute anything.
#==========================================================================================================
if [[ "$1" == "--check" ]]; then
    if ping -c 3 -W 7 8.8.8.8 &>/dev/null; then
        CHECK_FOR_UPDATES
    else
        echo -e "${YELLOW_NEON}[!][lang: PT-BR] Nenhuma conexão com a internet disponível, protocolo abortado. ${NC}"
        echo -e "${YELLOW_NEON}[!] Sentinel Protocol aborted. Please check your network connection ${NC}"
        exit 1
    fi
    exit 0

fi

SETUP_SENTINEL
#=======================================================================================================
# --- CONFIGURAÇÃO DE LOGS ROTATIVOS // ROTATING LOGS CONFIGURATION -----------------------------------------------------------------------------------<<<

LOG_DIR="$HOME/.logs_arch_update_full"
mkdir -p "$LOG_DIR"  

DATA_LOG=$(date "+%Y-%m-%d_%H-%M-%S")
LOG_ATUAL="$LOG_DIR/update_$DATA_LOG.log"

# Função para Limpeza logs (FIFO - Keep 13) // Log cleanup function (FIFO - Keep 13)

rotate_logs() {
    local LOG_COUNT
    local OLD_LOG

    LOG_COUNT=$(find "$LOG_DIR" -maxdepth 1 -name "update_*.log" 2>/dev/null | wc -l)
    
    if [ "$LOG_COUNT" -ge 13 ]; then
        OLD_LOG=$(find "$LOG_DIR" -maxdepth 1 -name "update_*.log" -type f -printf '%T@ %p\n' | sort -n | head -n 1 | cut -d' ' -f2-)
        
        if [ -n "$OLD_LOG" ]; then
            rm "$OLD_LOG"
            echo -e "${RED_NEON}[LOG_SYSTEM] Ciclo de rotação ativo. Log antigo removido: $(basename "$OLD_LOG")${NC}"
        fi
    fi
}

rotate_logs

exec > >(tee -i "$LOG_ATUAL") 2>&1

echo -e "${PINK_NEON}--- REGISTRO DE SESSÃO: $DATA_LOG ---${NC}"


exit 0