# Colored makepkg-like functions
msg_blue() {
  printf "${blue}==>${bold} $1${all_off}\n"
}

note() {
  printf "${blue}==>${yellow} NOTE:${bold} $1${all_off}\n"
}

all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
yellow="${bold}$(tput setaf 3)"

post_install() {
  note "Custom flags should be put directly in: ~/.config/bitwarden-flags.conf"
}

post_upgrade() {
  post_install

  # Check if user namespaces are supported by the kernel and working with a quick test:
  if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
    # Use SUID chrome-sandbox only on systems without user namespaces:
    chmod 4755 '/opt/Bitwarden/chrome-sandbox' || true
  else
    chmod 0755 '/opt/Bitwarden/chrome-sandbox' || true
  fi

  # Reload apparmor profile
  if [ -f "/usr/bin/apparmor_parser" ]; then
    apparmor_parser -r /etc/apparmor.d/bitwarden
  fi
}
