pkgname=hamster-time-tracker

post_install() {
  echo errorororororo 1>&2
  xdg-icon-resource forceupdate
}

pre_upgrade() {
  # gconf is no longer required in newer versions of hamster but try to uninstall in case the old version had it
  gconfpkg --uninstall $pkgname || echo "warning: gconf uninstall failed - manual cleanup may be necessary" 1>&2
}

post_upgrade() {
  post_install $1
}

post_remove() {
  xdg-icon-resource forceupdate
}
