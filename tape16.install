post_install() {
  cat <<'EOF'
==> TAPE 16 installed.

    Launchers:
      tape16-stable      — recommended (PipeWire/JACK profile)
      tape16             — direct launch / diagnostics
      tape16-lowlatency  — lower buffer size (profile-dependent)
      tape16-preflight   — runtime diagnostics
      tape16-plugin-doctor

    For low-latency audio, ensure your user is in the audio group:
      sudo usermod -aG audio $USER
    Then log out and back in (or reboot). This package also installs
    /etc/security/limits.d/99-tape16-audio.conf for @audio realtime limits.
    Consider installing realtime-privileges for a fuller setup.

    License/session data lives in ~/.config/TapeDAW/ and is preserved
    across upgrades and uninstalls.

    Note: tape16-system-check suggests Debian apt packages; on Arch the
    runtime dependencies are already pulled in by this package. Prefer
    tape16-preflight and the first-launch system check for diagnostics.

    Display profile: this build uses the upstream Wayland-tuned profile
    by default (edit _display_profile=x11 in the PKGBUILD and rebuild
    for a pure X11 session profile).
EOF

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'EOF'
==> TAPE 16 removed.
    User data under ~/.config/TapeDAW/ was kept (licenses, sessions, prefs).
EOF

  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
}
