#!/bin/bash
# s302 - Steamcommunity 302 控制命令
# 无参数 / ui      : 打开图形界面(AppImage,需图形会话)
# init             : 无图形界面时，为调用用户初始化 daemon 与配置
# start/stop/...   : 管理后端 daemon(systemd s302-*.service)+ 配置
# rule/dns 参考 ufw 风格:list/info/allow/deny/status
# GUI 由 AppImage 提供；headless 后端由包安装至 /usr/lib/steamcommunity302/
set -euo pipefail

APPIMAGE="/opt/steamcommunity302/steamcommunity302.AppImage"
DATA_DIR="/var/lib/Steamcommunity_302"
CFG="${DATA_DIR}/config.json"
HEADLESS_DIR="/usr/lib/steamcommunity302"
SERVICE_INSTALLER="${HEADLESS_DIR}/s302-service-installer"

# 规则库(含全部规则的 section 与中文名;版本目录按 daemon 实际版本)
# 注意:app/versions/ 可能不存在(首次安装、或 daemon 只落盘 rules/),
# 此时 glob 无匹配 -> ls 返回 2,pipefail 让整条管道失败 -> set -e 直接终止脚本,
# 且发生在 case 分发之前,表现为所有子命令(含 GUI)静默退出 2。故用 || true 兜底退出码。
# 空结果不进 RULES_INI:否则它会是 cwd 相对的 S302_rules.ini,可能被当前目录的同名文件截胡。
# 首次初始化会新落盘版本目录,故封装成函数,初始化后再算一次(见 init_first_run)。
resolve_rules_ini() {
    RULES_VERS="$( { ls -d "${DATA_DIR}/app/versions/"*/ 2>/dev/null || true; } | sort -V | tail -1 )"
    RULES_INI="${RULES_VERS:+${RULES_VERS}S302_rules.ini}"
    [[ -f "$RULES_INI" ]] || RULES_INI="${DATA_DIR}/rules/S302_rules.ini"
    [[ -f "$RULES_INI" ]] || RULES_INI="${DATA_DIR}/rules/active.ini"
}
resolve_rules_ini

# --- 探测 systemd 服务名(按机器 UID 生成:s302-<uid>.service) ---
find_svc() {
    local svc
    svc="$(systemctl list-unit-files 2>/dev/null | awk '/^s302-[0-9]+\.service/ {print $1; exit}')"
    if [[ -z "$svc" && -e /etc/systemd/system/s302-*.service ]]; then
        svc="$(basename /etc/systemd/system/s302-*.service)"
    fi
    echo "$svc"
}

die() { echo "错误: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "此操作需要 root;请用 root 执行或 sudo/pkexec: $0 $*"; }
need_svc() {
    SVC="$(find_svc)"
    [[ -n "$SVC" ]] || die "未找到 s302 systemd 服务。运行 's302 init' 完成无图形界面初始化，或在图形界面启动 s302。"
}
_run_upstream_installer() {
    local uid="$1"

    if [[ -n "${PKEXEC_UID:-}" ]]; then
        "$SERVICE_INSTALLER" install "$uid" var-lib
    else
        PKEXEC_UID="$uid" "$SERVICE_INSTALLER" install "$uid" var-lib
    fi
}

_headless_init_root() {
    local uid="$1" unit="s302-${1}.service" installer_failed=0

    [[ $EUID -eq 0 ]] || die "headless 初始化器必须以 root 身份运行。"
    [[ "$uid" =~ ^[0-9]+$ ]] || die "无效 UID: $uid"
    if [[ -n "${PKEXEC_UID:-}" && "${PKEXEC_UID}" != "$uid" ]]; then
        die "目标 UID 与 pkexec 调用用户不一致。"
    fi

    # Upstream's first install may create the unit but report failure because
    # the fresh unit is not enabled yet. Enable it, then rerun the installer so
    # it synchronizes the current versioned backend payload before restart.
    if ! _run_upstream_installer "$uid"; then
        installer_failed=1
        printf '%s\n' '上游安装器首次运行未完成；正在启用新建服务后继续同步。' >&2
    fi
    systemctl daemon-reload
    systemctl enable --now "$unit"
    if (( installer_failed )); then
        _run_upstream_installer "$uid"
    fi
    systemctl daemon-reload
    systemctl restart "$unit"
    systemctl is-active --quiet "$unit"
    printf '%s\n' "初始化完成：${unit} 已启动。"
}


# 首次运行(数据目录尚未生成)时的初始化:先给反馈,再运行 AppImage 让它释放文件
# (config.json、app/versions/<ver>/、rules/ 等),随后继续执行原命令。
# GUI 必须以普通用户运行(提权由程序自身的 pkexec/polkit 处理):以 root 运行会生成
# root 属主的数据文件,headless 下根本起不来 —— 这两种情况只提示、不启动。
init_first_run() {
    [[ -f "$CFG" ]] && return 0
    echo "数据目录尚未初始化:$DATA_DIR 为空(首次运行)。"
    if [[ $EUID -eq 0 ]]; then
        echo "请以普通用户运行 's302 init' 完成初始化；不要以 root 运行。" >&2
        return 1
    fi
    if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        echo "当前无图形会话；请运行 's302 init' 完成无图形界面初始化。" >&2
        return 1
    fi
    if [[ ! -x "$APPIMAGE" ]]; then
        echo "未找到可执行的 $APPIMAGE,无法自动初始化(请重装 steamcommunity302)。" >&2
        return 1
    fi
    echo "正在启动图形界面完成初始化(会释放 app/versions/、rules/ 等文件)…"
    "$APPIMAGE" || true
    if [[ -f "$CFG" ]]; then
        # 初始化新增了版本目录,规则库路径要按新落盘结果重算
        resolve_rules_ini
        echo "初始化完成,继续执行。"
        return 0
    fi
    echo "初始化未完成:$CFG 仍未生成。" >&2
    return 1
}

need_cfg() { [[ -f "$CFG" ]] || { init_first_run || die "未初始化；请先运行 's302 init'"; }; }

# --- 规则数据访问(经 python,处理 ini/json) ---
# 输出: 全部规则 <名称>\t<中文名>\t<Group>  (来自规则库,不含基础设施)
# 名称合法性校验也走这里
rules_db() {
    python3 - "$RULES_INI" <<'PY'
import configparser, sys
p = sys.argv[1]
c = configparser.ConfigParser()
c.read(p)
# 跳过基础设施(无 Title)与特殊段
for s in c.sections():
    if 'Title' not in c[s]:
        continue
    if s in ('Caddy_init', 'Caddy_end'):
        continue
    t = c[s].get('Title', s).strip()
    g = c[s].get('Group', '').strip()
    print(f'{s}\t{t}\t{g}')
PY
}

# 当前启用的规则(config.json 权威源)
rules_enabled() {
    python3 - "$CFG" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
print('\n'.join(d['settings']['rules']['enabled']))
PY
}

# 校验规则名存在
rule_valid() {
    local name="$1"
    rules_db | awk -F'\t' -v n="$name" '$1==n {found=1} END {exit !found}'
}

usage() {
    cat <<'EOF'
用法: s302 <命令> [参数]

界面:
  (无参数) / ui         打开图形界面(完整配置;首次使用请先运行)

无图形界面:
  init                  为当前用户安装并启动 daemon、生成初始配置
  init --sudo           通过 sudo 为当前 SSH 用户初始化
  init --user <用户名>  root 专用：为指定用户初始化

服务管理(需 root):
  start|stop|restart    启动/停止/重启 daemon+引擎
  status [verbose]      服务与配置状态(verbose: 含规则明细)
  enable|disable        设置/取消开机自启
  log [行数]            查看引擎日志(默认最近 50 行)

规则管理(ufw 风格,需 root):
  rules list            列出全部可用规则(*=启用, 含中文名)
  rules enable <名称>   启用规则(= allow)
  rules disable <名称>  停用规则(= deny)
  rules info <名称>     查看单条规则详情(名称/中文名/分组/状态)
  rules on|off <名称>   on/off 别名(向后兼容)

DNS 管理(需 root):
  dns status            查看 DNS 重定向状态
  dns on|off            启用/停用 DNS 重定向

其他:
  info                  服务与关键配置总览
  version               显示版本
  help                  显示本帮助
EOF
}

apply_cfg() {
    # $1 = python 代码, 操作 CFG 后重启服务
    need_root "$*"
    need_svc
    python3 - "$CFG" <<PY
import json, sys
p = sys.argv[1]
d = json.load(open(p))
$1
json.dump(d, open(p, 'w'), indent=2, ensure_ascii=False)
PY
    systemctl restart "$SVC"
    echo "✓ 已应用并重启 $SVC"
}

# 无参数 => GUI(与 desktop Exec=/usr/bin/s302 兼容)
if [[ $# -eq 0 ]]; then
    set -- ui
fi

case "$1" in
    ui)
        if [[ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
            echo "当前无图形会话(headless)。管理请用: s302 start/stop/status/rules/dns/info"
            echo "初始化配置: s302 init --sudo（SSH）或 s302 init（有 polkit 认证代理）"
            exit 0
        fi
        # 首次运行先给反馈,再交给 AppImage 初始化(桌面图标启动时看不到终端,终端调用能看到)。
        # 放在 headless 判断之后:无图形会话时并不启动 GUI,不能先声称"正在启动"。
        [[ -f "$CFG" ]] || echo "首次运行:数据目录尚未初始化,正在启动图形界面完成初始化(会释放 app/versions/、rules/ 等文件)。"
        exec "$APPIMAGE"
        ;;
    init)
        if [[ $EUID -eq 0 ]]; then
            [[ $# -eq 3 && "$2" == --user ]] || die "root 初始化用法: s302 init --user <用户名>"
            _target_uid="$(id -u "$3")" || die "未知用户: $3"
            _headless_init_root "$_target_uid"
        elif [[ "${2:-}" == --sudo ]]; then
            [[ $# -eq 2 ]] || die "用法: s302 init --sudo"
            command -v sudo >/dev/null 2>&1 || die "缺少 sudo；请安装 sudo 或使用 s302 init。"
            exec sudo "$0" init --user "$(id -un)"
        else
            [[ $# -eq 1 ]] || die "用法: s302 init [--sudo]"
            [[ -x "$SERVICE_INSTALLER" ]] || die "未找到 headless 安装器: $SERVICE_INSTALLER (请重装 steamcommunity302)。"
            command -v pkexec >/dev/null 2>&1 || die "缺少 pkexec；请安装 polkit。"
            exec pkexec --disable-internal-agent "$0" --headless-init-root "$UID"
        fi
        ;;

    --headless-init-root)
        [[ $# -eq 2 ]] || die "内部初始化参数错误。"
        _headless_init_root "$2"
        ;;

    start|stop|restart|enable|disable)
        need_root "$*"
        need_svc
        systemctl "$1" "$SVC"
        ;;

    status)
        need_svc
        systemctl status "$SVC" --no-pager
        if [[ "${2:-}" == "verbose" ]]; then
            echo
            echo "--- 已启用规则 ---"
            rules_enabled | sed 's/^/  /'
            echo "--- DNS ---"
            python3 -c "
import json
d = json.load(open('$CFG'))
print('  DNS:', '开' if d['settings']['dns']['enabled'] else '关')
"
        fi
        ;;

    log)
        need_root "$*"
        need_svc
        journalctl -u "$SVC" -n "${2:-50}" --no-pager
        ;;

    # ---------- 规则管理(ufw 风格) ----------
    rules)
        need_cfg
        sub="${2:-list}"
        case "$sub" in
            list)
                # 状态标记: 启用加 *
                en="$(rules_enabled)"
                rules_db | awk -F'\t' -v en="$en" '
                    function isen(n, a, i) { split(en, a, "\n"); for (i in a) if (a[i]==n) return 1; return 0 }
                    { mark = isen($1) ? "*" : " "; printf "%s %-28s %-10s %s\n", mark, $1, $3, $2 }
                '
                echo "---"
                echo "* = 启用 | 全部 $(rules_db | wc -l) 条, 已启用 $(rules_enabled | wc -l) 条"
                ;;
            enable|allow)
                [[ $# -ge 3 ]] || die "用法: s302 rules $sub <名称>"
                need_root "$*"
                need_cfg
                rule_valid "$3" || die "未知规则: $3 (s302 rules list 查看全部)"
                apply_cfg "
r = d['settings']['rules']['enabled']
if '$3' not in r: r.append('$3')
print('规则 $3 已启用')
"
                ;;
            disable|deny)
                [[ $# -ge 3 ]] || die "用法: s302 rules $sub <名称>"
                need_root "$*"
                need_cfg
                apply_cfg "
r = d['settings']['rules']['enabled']
r[:] = [x for x in r if x != '$3']
print('规则 $3 已停用')
"
                ;;
            on|off)
                # 向后兼容旧语法: s302 rules on <名称> / off
                [[ $# -ge 3 ]] || die "用法: s302 rules $sub <名称>"
                need_root "$*"
                need_cfg
                if [[ "$sub" == "on" ]]; then
                    rule_valid "$3" || die "未知规则: $3"
                    apply_cfg "
r = d['settings']['rules']['enabled']
if '$3' not in r: r.append('$3')
print('规则 $3 已启用')
"
                else
                    apply_cfg "
r = d['settings']['rules']['enabled']
r[:] = [x for x in r if x != '$3']
print('规则 $3 已停用')
"
                fi
                ;;
            info)
                [[ $# -ge 3 ]] || die "用法: s302 rules info <名称>"
                need_cfg
                rule_valid "$3" || die "未知规则: $3 (s302 rules list 查看全部)"
                en="$(rules_enabled | grep -x "$3" >/dev/null && echo 启用 || echo 停用)"
                rules_db | awk -F'\t' -v n="$3" -v st="$en" '
                    $1==n { printf "名称  : %s\n中文  : %s\n分组  : %s\n状态  : %s\n", $1, $2, $3, st }
                '
                ;;
            *)
                die "未知 rules 子命令: $sub (s302 help)"
                ;;
        esac
        ;;

    # 向后兼容旧语法: s302 rule <名称> on|off
    rule)
        [[ $# -eq 3 ]] || die "用法: s302 rule <名称> on|off (或 s302 rules enable/disable <名称>)"
        case "$3" in
            on)  exec "$0" rules enable "$2" ;;
            off) exec "$0" rules disable "$2" ;;
            *)   die "参数 op 只能是 on|off" ;;
        esac
        ;;

    # ---------- DNS ----------
    dns)
        need_cfg
        sub="${2:-status}"
        case "$sub" in
            status)
                python3 -c "
import json
d = json.load(open('$CFG'))
s = d['settings']['dns']
print('DNS 重定向:', '开' if s['enabled'] else '关')
print('模式      :', s.get('netfilterMode', '?'))
print('上游      :', ', '.join(s['upstreams']))
print('TTL       :', s.get('ttl', '?'))
"
                ;;
            on|off)
                need_root "$*"
                apply_cfg "
d['settings']['dns']['enabled'] = ('$sub' == 'on')
print('DNS $sub')
"
                ;;
            *)
                die "未知 dns 子命令: $sub (on|off|status)"
                ;;
        esac
        ;;

    info)
        need_cfg
        python3 -c "
import json
d = json.load(open('$CFG'))
s = d['settings']
print('数据目录 : $DATA_DIR')
print('HTTP/HTTPS:', s['engine']['httpPort'], '/', s['engine']['httpsPort'])
print('DNS      :', '开' if s['dns']['enabled'] else '关', f\"(upstream: {', '.join(s['dns']['upstreams'])})\")
print('规则数   :', len(s['rules']['enabled']), '| hosts 自动改:', s['hosts']['autoModify'])
"
        if SVC="$(find_svc)"; [[ -n "$SVC" ]]; then
            echo "服务状态 : $(systemctl is-active "$SVC" 2>/dev/null) ($SVC)"
        else
            echo "服务状态 : 未安装(运行 s302 ui 初始化)"
        fi
        ;;

    version)
        # AppImage type-2 runtime 把 --appimage-version 写到 stderr(stdout 为空,进程退出码仍是 0),
        # 原来的 2>/dev/null + exec 让这一行什么都不输出;这里合并 stderr 并给出包版本。
        # AppImage / pacman 包缺失都不能让 set -e 提前终止(管道退出码用 || true 兜住),
        # 缺什么就降级为 unknown,而不是静默死亡。
        av=""
        if [[ -x "$APPIMAGE" ]]; then
            av="$("$APPIMAGE" --appimage-version 2>&1 | tr -d '\n' || true)"
        fi
        pv="$(pacman -Q steamcommunity302 2>/dev/null | awk '{print $2}' || true)"
        echo "steamcommunity302: ${pv:-unknown}"
        echo "${av:-AppImage runtime: unknown}"
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        die "未知命令: $1 (s302 help 查看用法)"
        ;;
esac
