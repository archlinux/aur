[Desktop Entry]
Name=Fluxer Canary
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec="/usr/bin/fluxer-canary" --class=fluxer-canary %U
TryExec=/usr/bin/fluxer-canary
Icon=fluxer-canary
Terminal=false
Type=Application
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/fluxer-canary;
StartupWMClass=fluxer-canary
StartupNotify=true
