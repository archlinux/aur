#!/usr/bin/env bash

# --- 定义模板目录 ---
TEMPLATE_DIR="/usr/share/shorin-dms-niri-dotfiles"
FCITX5_TEMPLATE_DIR="/usr/share/shorin-fcitx5-config"

BASE_BACKUP_DIR="$HOME/.cache/shorin-dms-niri-dotfiles-backup"
BACKUP_DIR="$BASE_BACKUP_DIR/$(date +%Y%m%d_%H%M%S)"

# --- 文件同步与备份逻辑 ---

backup_and_copy() {
    local base_dir="$1"
    local rel_path="$2"
    local src_path="$base_dir/$rel_path"
    local dest_path="$HOME/$rel_path"
    local dest_dir
    dest_dir="$(dirname "$dest_path")"
    
    if [[ -e "$dest_path" || -L "$dest_path" ]]; then
        local backup_path="$BACKUP_DIR/$rel_path"
        mkdir -p "$(dirname "$backup_path")"
        cp -a "$dest_path" "$backup_path"
        echo "已备份: ~/$rel_path"
        rm -rf "$dest_path"
    fi
    
    mkdir -p "$dest_dir"
    cp -a "$src_path" "$dest_path"
    echo "已同步: ~/$rel_path"
}

process_dir_level() {
    local base_dir="$1"
    local target_dir="$2"
    local mode="$3" # --- 新增参数：接收当前运行模式 ---
    
    if [[ -d "$target_dir" ]]; then
        find "$target_dir" -mindepth 1 -maxdepth 1 -print0 | while IFS= read -r -d '' item; do
            local rel_path="${item#./}"
            
            # --- 新增逻辑：如果是 update 模式，跳过 gtk 主题配置 ---
            if [[ "$mode" == "update" ]]; then
                if [[ "$rel_path" == ".config/gtk-3.0" || "$rel_path" == ".config/gtk-4.0" ]]; then
                    echo ">> [跳过更新] 保持当前主题配置不变: ~/$rel_path"
                    continue
                fi
            fi
            
            backup_and_copy "$base_dir" "$rel_path"
        done
    fi
}

cleanup_old_backups() {
    if [[ -d "$BASE_BACKUP_DIR" ]]; then
        local backups=( "$BASE_BACKUP_DIR"/* )
        if [[ -e "${backups[0]}" ]]; then
            local count=${#backups[@]}
            if (( count > 2 )); then
                local remove_count=$(( count - 2 ))
                for (( i=0; i<remove_count; i++ )); do
                    rm -rf "${backups[i]}"
                    echo "已清理旧备份: ${backups[i]}"
                done
            fi
        fi
    fi
}

sync_from_dir() {
    local source_dir="$1"
    local mode="$2" # --- 新增参数：接收运行模式 ---
    
    if [[ ! -d "$source_dir" ]]; then
        echo "提示: 找不到模板目录 $source_dir，跳过同步。"
        return
    fi
    
    echo ">> 正在同步来源: $source_dir"
    cd "$source_dir" || return
    
    find . -maxdepth 1 -type f -print0 | while IFS= read -r -d '' f; do
        backup_and_copy "$source_dir" "${f#./}"
    done
    
    # 传递模式参数给子目录处理函数
    process_dir_level "$source_dir" ".config" "$mode"
    
    if [[ -d ".local" ]]; then
        find .local -mindepth 1 -maxdepth 1 -type d -print0 | while IFS= read -r -d '' local_sub; do
            process_dir_level "$source_dir" "${local_sub#./}" "$mode"
        done
    fi
}

sync_dotfiles() {
    local mode="$1" # --- 新增参数：接收 init 还是 update ---
    mkdir -p "$BACKUP_DIR"
    
    # 将模式参数继续往下传递
    sync_from_dir "$TEMPLATE_DIR" "$mode"
    echo "----------------------------------------"
    sync_from_dir "$FCITX5_TEMPLATE_DIR" "$mode"
    
    cleanup_old_backups
    
    echo "----------------------------------------"
    echo "配置文件同步完成！"
    echo "你的旧配置已统一备份至: $BACKUP_DIR"
    echo "如果需要恢复自己的修改，请前往上述目录查看。"
    echo "----------------------------------------"
}

# --- 隐藏桌面图标逻辑 ---

hide_desktop_file() {
    local source_file="$1"
    local filename=$(basename "$source_file")
    local user_dir="$HOME/.local/share/applications"
    local target_file="$user_dir/$filename"
    
    if [[ -f "$source_file" ]]; then
        mkdir -p "$user_dir"
        cp -f "$source_file" "$target_file"
        if grep -q "^NoDisplay=" "$target_file"; then
            sed -i 's/^NoDisplay=.*/NoDisplay=true/' "$target_file"
        else
            echo "NoDisplay=true" >> "$target_file"
        fi
    fi
}

run_hide_desktop_file() {
    local apps_to_hide=(
        "avahi-discover.desktop"
        "qv4l2.desktop"
        "qvidcap.desktop"
        "bssh.desktop"
        "org.fcitx.Fcitx5.desktop"
        "org.fcitx.fcitx5-migrator.desktop"
        "xgps.desktop"
        "xgpsspeed.desktop"
        "gvim.desktop"
        "kbd-layout-viewer5.desktop"
        "bvnc.desktop"
        "yazi.desktop"
        "btop.desktop"
        "vim.desktop"
        "nvim.desktop"
        "nvtop.desktop"
        "mpv.desktop"
        "org.gnome.Settings.desktop"
        "thunar-settings.desktop"
        "thunar-bulk-rename.desktop"
        "thunar-volman-settings.desktop"
        "clipse-gui.desktop"
        "waypaper.desktop"
        "xfce4-about.desktop"
        "cmake-gui.desktop"
        "assistant.desktop"
        "qdbusviewer.desktop"
        "linguist.desktop"
        "designer.desktop"
        "org.kde.drkonqi.coredump.gui.desktop"
        "org.kde.kwrite.desktop"
        "org.freedesktop.MalcontentControl.desktop"
        "org.gnome.Nautilus.desktop"
    )
    
    echo "正在隐藏不需要的桌面图标..."
    for app in "${apps_to_hide[@]}"; do
        hide_desktop_file "/usr/share/applications/$app"
    done
    echo "图标隐藏完成！"
}

# --- 用户环境配置 ---

apply_user_configs() {
    echo "正在应用首次初始化的用户环境设置..."
    
    mkdir -p "$HOME/.config"
    if ! grep -q "kitty.desktop" "$HOME/.config/xdg-terminals.list" 2>/dev/null; then
        echo 'kitty.desktop' >> "$HOME/.config/xdg-terminals.list"
    fi
    
    if command -v gsettings &>/dev/null; then
        gsettings set com.github.stunkymonkey.nautilus-open-any-terminal terminal kitty
    fi
    
    if [[ -f "$HOME/.config/gtk-3.0/bookmarks" ]]; then
        sed -i "s/shorin/$USER/g" "$HOME/.config/gtk-3.0/bookmarks"
    fi
    
    mkdir -p "$HOME/Templates"
    touch "$HOME/Templates/new"
    echo '#!/usr/bin/env bash' > "$HOME/Templates/new.sh"
    chmod +x "$HOME/Templates/new.sh"
    
    if command -v flatpak &>/dev/null; then
        flatpak override --user --filesystem=xdg-data/themes
        flatpak override --user --filesystem="$HOME/.themes"
        flatpak override --user --filesystem=xdg-config/gtk-4.0
        flatpak override --user --filesystem=xdg-config/gtk-3.0
        flatpak override --user --env=GTK_THEME=adw-gtk3-dark
        flatpak override --user --filesystem=xdg-config/fontconfig
    fi
    
    mkdir -p "$HOME/.local/share"
    ln -sfn /usr/share/themes "$HOME/.local/share/themes"
    
    mkdir -p "$HOME/.local/bin"
    if command -v kitty &>/dev/null; then
        ln -sfn /usr/bin/kitty "$HOME/.local/bin/xterm"
    fi
    
    run_hide_desktop_file
    
    echo "初始化环境配置完成！"
}

# --- shorin contrib init ---
shorin_contrib_init() {
    shorin link
}

# --- 命令路由 ---

case "$1" in
    init)
        echo "开始初始化 Shorin DMS Niri 环境..."
        # 传入 init 模式
        sync_dotfiles "init"
        apply_user_configs
    ;;
    update)
        echo "开始更新 Shorin DMS Niri 配置文件..."
        # 传入 update 模式
        sync_dotfiles "update"
    ;;
    hide-icons)
        run_hide_desktop_file
    ;;
    *)
        echo "用法: shorindms {init|update|hide-icons}"
        echo "  init       - 首次安装时运行，包含配置文件同步和环境初始化"
        echo "  update     - 日常更新使用，仅拉取最新的配置文件（跳过已设置的主题）"
        echo "  hide-icons - 仅执行隐藏不需要的桌面图标的操作"
        exit 1
    ;;
esac
