#!/usr/bin/openrc-run
# Copyright 2008-2016 Gentoo Foundation
# Distributed under the terms of the GNU General Public License v2 or later

USER=${RC_SVCNAME##*.}
: ${EMACS:=/usr/bin/emacs}
: ${EMACS_PIDFILE=/var/run/emacs.$USER.pid}
: ${EMACS_LOGFILE=/var/log/emacs.$USER.log}
: ${EMACS_OPTS:="--fg-daemon"}
: ${EMACS_TIMEOUT:=5}
SKIP_ARGB_VISUALS=1
description="Start an Emacs server running in the background"

checkconfig() {
    if [ "${RC_VERSION:-0}" = "0" ]; then
        eerror "This script cannot be used for baselayout-1."
        return 1
    fi

    if [ "${USER}" = "${RC_SVCNAME}" ]; then
          eerror "You have to create an init script for each user:"
          eerror "ln -s emacs /etc/init.d/emacs.<user>"
          return 1
    fi

    if [ ! -f "${EMACS_PIDFILE}" ]; then
        touch ${EMACS_PIDFILE}
        chown ${USER}:${USER} ${EMACS_PIDFILE}
    fi

    if [ ! -f "${EMACS_LOGFILE}" ]; then
        touch ${EMACS_LOGFILE}
        chown ${USER}:${USER} ${EMACS_LOGFILE}
    fi

    local has_daemon=$(${EMACS} -batch -q --no-site-file \
    --eval "(princ (fboundp 'daemonp))")
    if [ "${has_daemon}" != t ]; then
          eerror "${EMACS} does not support running as a daemon"
          return 1
    fi
}


start() {
    local HOME
    checkconfig || return 1

    eval HOME="~${USER}"

    # parsing files of session
    ebegin "Fetching dbus address..."
    for file in $(ls -d -1 $HOME/.dbus/session-bus/**-0)
    do
        echo $file
        cat $file
        source $file
    done

    export DBUS_SESSION_BUS_ADDRESS

    killall emacs
    ebegin "Starting Emacs daemon for user ${USER}"
    start-stop-daemon --start \
    --chdir ${HOME} \
    --user ${USER} \
    --pidfile ${EMACS_PIDFILE} \
    --stdout ${EMACS_LOGFILE} \
    --stderr ${EMACS_LOGFILE} \
    --background \
    --make-pidfile \
    --exec ${EMACS} -- ${EMACS_OPTS}

    eend $?
}

stop() {
    ebegin "Stopping Emacs daemon for user ${USER}"
    start-stop-daemon --stop \
    --retry "TERM/${EMACS_TIMEOUT}/KILL/5" \
    --user ${USER} \
    --pidfile ${EMACS_PIDFILE} \
    --exec ${EMACS} -- ${EMACS_OPTS}
    eend $?
}
