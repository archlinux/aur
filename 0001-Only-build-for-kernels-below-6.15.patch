Date: Fri, 28 Mar 2025 13:17:13 +0100
Subject: [PATCH] Only build for kernels below 6.15

---
 dkms.conf | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/dkms.conf b/dkms.conf
index 265757a..9cdb9b8 100644
--- a/dkms.conf
+++ b/dkms.conf
@@ -5,3 +5,5 @@ BUILT_MODULE_NAME[0]="hid_universal_pidff"
 DEST_MODULE_NAME[0]="hid_universal_pidff"
 DEST_MODULE_LOCATION[0]="/kernel/drivers/hid"
 AUTOINSTALL="yes"
+# Build only for kernels 5. and 6. and only below 6.15
+BUILD_EXCLUSIVE_KERNEL="^(5|(6\.([0-9]|1[0-4])\.))"
