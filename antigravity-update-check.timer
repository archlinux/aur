[Unit]
Description=Daily Antigravity update check
Requires=antigravity-update-check.service

[Timer]
# Run daily at 9 AM
OnCalendar=daily
OnCalendar=*-*-* 09:00:00

# Also run 5 minutes after boot
OnBootSec=5min

# If system was off during scheduled time, run on next boot
Persistent=true

[Install]
WantedBy=timers.target
