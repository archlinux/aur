post_install() {
    echo ""
    echo "==> omarchy-stt installation complete!"
    echo ""
    echo "==> Next steps:"
    echo ""
    echo "    1. Find your microphone device:"
    echo "       $ list-microphones"
    echo ""
    echo "    2. Copy example config and customize:"
    echo "       $ mkdir -p ~/.config/transcribe-rs"
    echo "       $ cp /usr/share/omarchy-stt/config.toml.example ~/.config/transcribe-rs/config.toml"
    echo ""
    echo "    3. Edit ~/.config/transcribe-rs/config.toml:"
    echo "       - Set your microphone device (from step 1)"
    echo "       - Model path is pre-configured: /usr/share/omarchy-stt/models/parakeet-tdt-0.6b-v3-int8"
    echo ""
    echo "    4. Enable and start daemons:"
    echo "       $ systemctl --user enable --now recording-daemon transcribe-daemon hotkey-daemon"
    echo ""
    echo "    5. Configure keyboard shortcut (IMPORTANT!):"
    echo "       The hotkey-daemon will register a global hotkey using XDG Desktop Portal."
    echo "       Default hotkey: Super+Shift+Space (can be changed in config.toml)"
    echo ""
    echo "       Alternative (manual keybinding in your DE):"
    echo "       - Hyprland: See /usr/share/doc/omarchy-stt-bin/SETUP.md"
    echo "       - GNOME/KDE: Keyboard settings → Custom shortcuts"
    echo ""
    echo "==> Optional: Enable LLM post-processing (Grammar corrections & tools)"
    echo ""
    echo "    1. Get a Groq API key (free): https://console.groq.com"
    echo "    2. Add to your environment:"
    echo "       $ echo 'export GROQ_API_KEY=\"your-key-here\"' >> ~/.bashrc"
    echo "    3. Enable in config.toml:"
    echo "       llm_processing = true"
    echo "    4. Restart services:"
    echo "       $ systemctl --user restart hotkey-daemon"
    echo ""
    echo "==> Documentation:"
    echo "    Full setup guide: /usr/share/doc/omarchy-stt-bin/SETUP.md"
    echo "    Example configs: /usr/share/omarchy-stt/"
    echo ""
    echo "==> Quick test:"
    echo "    $ transcribe-client /path/to/audio.wav"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> omarchy-stt upgraded to version $2"
    echo ""
    echo "==> Restart daemons to apply changes:"
    echo "    $ systemctl --user restart recording-daemon transcribe-daemon hotkey-daemon"
    echo ""
    echo "==> Check for config changes:"
    echo "    $ diff ~/.config/transcribe-rs/config.toml /usr/share/omarchy-stt/config.toml.example"
    echo ""
}

post_remove() {
    echo ""
    echo "==> omarchy-stt removed"
    echo ""
    echo "==> User configuration preserved in ~/.config/transcribe-rs/"
    echo "    Remove manually if desired:"
    echo "    $ rm -rf ~/.config/transcribe-rs/"
    echo ""
    echo "==> Systemd service symlinks removed automatically"
    echo ""
}
