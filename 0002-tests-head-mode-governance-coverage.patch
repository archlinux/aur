+/* The head-mode governance counters are counters beside it: the frozen decode lanes, the
+ * flips, and the liveness releases operators watch at ~0. */
+TEST(the_head_governance_counters_are_exported) {
+    Metrics m("m", 1024);
+    server::SchedMetrics s;
+    s.steps_held_decode = 4;
+    s.head_flips = 3;
+    s.head_freeze_releases = 1;
+    m.sample(s);
+    PromDoc d = parse_prom(m.render());
+    CHECK_EQ((int)d.errors.size(), 0);
+    CHECK_EQ(d.type["radiance:engine_steps_held_decode_total"], std::string("counter"));
+    CHECK_EQ(d.type["radiance:engine_head_flips_total"], std::string("counter"));
+    CHECK_EQ(d.type["radiance:engine_head_freeze_releases_total"], std::string("counter"));
+    const auto held = d.samples.find(
+        "radiance:engine_steps_held_decode_total{model_name=\"m\",engine=\"0\"}");
+    CHECK(held != d.samples.end() && held->second == 4.0);
+    const auto flips = d.samples.find(
+        "radiance:engine_head_flips_total{model_name=\"m\",engine=\"0\"}");
+    CHECK(flips != d.samples.end() && flips->second == 3.0);
+    const auto rel = d.samples.find(
+        "radiance:engine_head_freeze_releases_total{model_name=\"m\",engine=\"0\"}");
+    CHECK(rel != d.samples.end() && rel->second == 1.0);
+}
+
