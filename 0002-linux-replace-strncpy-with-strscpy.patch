Change-Id: I544cc248e2a248d1d3d6ebd167266e9ef680aa6a
---
 src/afs/LINUX/osi_machdep.h | 8 +++++---
 src/cf/linux-kernel-func.m4 | 8 ++++++++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/afs/LINUX/osi_machdep.h b/src/afs/LINUX/osi_machdep.h
index 263c8633c..435852859 100644
--- a/src/afs/LINUX/osi_machdep.h
+++ b/src/afs/LINUX/osi_machdep.h
@@ -498,7 +498,9 @@ do { \
 #  define __NR_ia32_unlink 10
 # endif
 #endif
-
-#define osi_procname(procname, size) strncpy(procname, current->comm, size)
-
+#if defined(HAVE_LINUX_STRSCPY)
+# define osi_procname(procname, size) strscpy(procname, current->comm, size)
+#else
+# define osi_procname(procname, size) strncpy(procname, current->comm, size)
+#endif
 #endif /* OSI_MACHDEP_H_ */
diff --git a/src/cf/linux-kernel-func.m4 b/src/cf/linux-kernel-func.m4
index 20f659da4..4000e5ce0 100644
--- a/src/cf/linux-kernel-func.m4
+++ b/src/cf/linux-kernel-func.m4
@@ -173,6 +173,14 @@ AC_CHECK_LINUX_FUNC([lru_cache_add_file],
                     [#include <linux/swap.h>],
                     [lru_cache_add_file(NULL);])
 
+dnl Linux 4.3 introduced strscpy()
+AC_CHECK_LINUX_FUNC([strscpy],
+		    [[#include <linux/string.h>
+		      char buff1[32];
+		      char buff2[32];]],
+		    [[static size_t code;
+		      code = strscpy(buff1, buff2, sizeof(buff1));]])
+
 dnl Linux 4.6 introduced in_compat_syscall as replacement for is_compat_task
 dnl for certain platforms.
 AC_CHECK_LINUX_FUNC([in_compat_syscall],
