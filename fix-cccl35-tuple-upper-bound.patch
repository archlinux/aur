+// Work around https://github.com/NVIDIA/cccl/issues/7855
+// The vector overload of thrust::upper_bound zips the value iterator with the output iterator
+// internally; the thrust::detail::tuple_of_iterator_references proxy of that zip does not compile
+// with CCCL 3.5 when the values are cuda::std::tuples. Perform one sequential upper_bound per value
+// instead, comparing the tuple elements individually.
+template <typename ExecutionPolicy,
+          typename PairIterator,
+          typename ValueIterator,
+          typename OutputIterator>
+void upper_bound_tuple_values(ExecutionPolicy&& exec,
+                              PairIterator pair_first,
+                              size_t num_pair_elements,
+                              ValueIterator value_first,
+                              size_t num_values,
+                              OutputIterator output_first)
+{
+  thrust::tabulate(
+    exec,
+    output_first,
+    output_first + num_values,
+    [pair_first, num_pair_elements, value_first] __device__(size_t i) {
+      return static_cast<size_t>(
+        thrust::upper_bound(
+          thrust::seq,
+          pair_first,
+          pair_first + num_pair_elements,
+          value_first[i],
+          [] __device__(auto const& lhs, auto const& rhs) {
+            return cuda::std::make_tuple(cuda::std::get<0>(lhs), cuda::std::get<1>(lhs)) <
+                   cuda::std::make_tuple(cuda::std::get<0>(rhs), cuda::std::get<1>(rhs));
+          }) -
+        pair_first);
+    });
+}
