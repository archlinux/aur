#!/bin/sh
# deveco-clt-url - build deveco-commandline-tools from the link in the clipboard
#
# 1. sign in at https://developer.huawei.com/consumer/cn/download/
# 2. start the Command Line Tools (Linux) download, then copy its link
#    (right click -> copy link address, or from DevTools)
# 3. run ./deveco-clt-url
set -eu
cd "$(dirname "$(readlink -f "$0")")"

get_clip() {
  if command -v wl-paste >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    wl-paste -n 2>/dev/null && return 0
  fi
  if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -o 2>/dev/null && return 0
  fi
  if command -v xsel >/dev/null 2>&1; then
    xsel --clipboard --output 2>/dev/null && return 0
  fi
  return 1
}

url="$(get_clip || true)"
case "$url" in
  *contentcenter*commandline-tools-linux-x64*.zip*)
    ;;
  *)
    printf '%s\n' "剪贴板里没有命中 CLT 下载链接。" >&2
    printf '%s\n' "请先在浏览器里登录 https://developer.huawei.com/consumer/cn/download/" >&2
    printf '%s\n' "点开 Command Line Tools (Linux) 的下载，复制下载链接后重试。" >&2
    exit 1
    ;;
esac

DEVECO_CLT_URL="$url" exec makepkg -si "$@"
