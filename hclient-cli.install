post_install() {
    echo ""
    echo "==> Start service / 启动服务："
    echo "      systemctl enable --now hclient-cli"
    echo ""
    echo "==> Add microserver / 添加微服："
    echo "      curl -X POST --get \\"
    echo "        --data-urlencode bname=\"<微服名/boxname>\" \\"
    echo "        --data-urlencode uid=\"<用户名/username>\" \\"
    echo "        --data-urlencode password=\"<密码/password>\" \\"
    echo "        http://127.0.0.1:7777/add_box"
    echo ""
    echo "==> Two-factor authentication / 如需两步验证："
    echo "      curl -X POST --get \\"
    echo "        --data-urlencode bname=\"<微服名/boxname>\" \\"
    echo "        --data-urlencode tfa=\"<验证码/2FA code>\" \\"
    echo "        http://127.0.0.1:7777/add_tfa"
    echo ""
    echo "==> List boxes / 列举微服："
    echo "      curl http://127.0.0.1:7777/box_list"
    echo ""
    echo "==> Delete box / 删除微服："
    echo "      curl -X DELETE --get --data-urlencode bname=\"<微服名/boxname>\" \\"
    echo "        http://127.0.0.1:7777/del_box"
    echo ""
}

post_upgrade() {
    post_install
}