# OpenChronology journald follower: /etc/openchronology/journald.env
# See /usr/share/doc/openchronology-server/journald.md. Then:
#   sudo systemctl enable --now openchronology-journald
# It runs as the openchronology-logs user: the files named here must be readable by it, for
# example owned by root:openchronology-logs with mode 0640.

# The platform on this machine (its HOST and PORT in openchronology.env).
OCH_API_URL=http://127.0.0.1:5173
# A read/write API key (Account -> API keys) of an account that can write the timelines.
OCH_API_KEY=
# The timeline every entry goes to, or routing rules in a file (as for the log importer).
JOURNALD_TIMELINE=
#JOURNALD_ROUTES=/etc/openchronology/journald-routes.json
# Only these systemd units (comma-separated), and/or journal matches (FIELD=value ...).
JOURNALD_UNITS=
#JOURNALD_MATCHES=SYSLOG_IDENTIFIER=forgejo
# Where the first run starts (journalctl --since): now, -1h, 2026-10-01 00:00:00. Later runs
# resume after the last entry sent.
JOURNALD_SINCE=now
# Another machine's journal, over SSH: its address, and the key (readable by the
# openchronology-logs user); its account there must be able to read the journal.
#JOURNALD_HOST=logs@forge.example.org
#JOURNALD_SSH_KEY=/etc/openchronology/journald_ssh_key
# The host's key, checked from the first connection (ssh-keyscan, then compare it with
# ssh-keygen -lf on that machine); without it, the key seen first is accepted.
#JOURNALD_KNOWN_HOSTS=/etc/openchronology/journald_known_hosts
