post_install() {
    echo ":: Packaging issues? Report at: https://github.com/orange-guo/aur-packages"
    echo ::\ Copy\ the\ example\ configuration\ before\ starting\ the\ service:
    echo \ \ \ install\ -Dm600\ /usr/share/doc/cpa-usage-keeper-bin/cpa-usage-keeper.env.example\ ~/.config/cpa-usage-keeper/cpa-usage-keeper.env
    echo \ \ \ \$EDITOR\ ~/.config/cpa-usage-keeper/cpa-usage-keeper.env
    echo ::\ CLIProxyAPI\ must\ publish\ usage\ events:\ set\ usage-statistics-enabled:\ true\ in\ CLIProxyAPI\ config.
    echo ::\ Dashboard\ listens\ on\ APP_PORT\ from\ ~/.config/cpa-usage-keeper/cpa-usage-keeper.env\,\ default\ 8318\ in\ the\ example.
    echo ::\ To\ start\ without\ an\ active\ login\ session\,\ enable\ linger:\ loginctl\ enable-linger\ \$USER
    echo ""
    echo ":: Service Management"
    echo "   > User Level (Recommended):"
    echo "     systemctl --user enable --now cpa-usage-keeper.service"
    echo "   > System Level:"
    echo "     (System Service is not available for this package)"
}

post_upgrade() {
    echo ":: Service Management"
    echo "   > User Level:"
    echo "     systemctl --user daemon-reload"
    echo "     systemctl --user restart cpa-usage-keeper.service"
    echo "   > System Level:"
    echo "     (System Service is not available for this package)"
}

post_remove() {
    echo ":: Service Management"
    echo "   > User Level:"
    echo "     The service file has been removed. Stop the service if running:"
    echo "     systemctl --user stop cpa-usage-keeper.service"
    echo "   > System Level:"
    echo "     (System Service is not available for this package)"
}
