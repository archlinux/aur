#ADDTEXT FUNCTION FINISH

#ALLINONE FUNCTION

function allinone() {
while true; do
	echo "'help' - help for allinone"
	
	read -e -p "AIO($AIOdir)/-> " AIOcmd
	if [ "$AIOcmd" = "help" ]; then
		echo ""
		echo "In first, create new directory via 'new'"
		echo ""
		echo -e "${BOLD}1. 'new' - Create a new folder${RESET}"
		echo -e "${BOLD}2. 'addmusic' - Add music in created folder${RESET}"
		echo -e "${BOLD}3. 'addcover' - Add cover in created folder${RESET}"
		echo -e "${BOLD}4. 'addtext' - Add text in created folder${RESET}"	
		echo -e "${BOLD}5. 'back' - Back to main menu ${RESET}"
	elif [ "$AIOcmd" = "new" ]; then
		read -e -p "Enter name for new folder: " AIOdir
			if [ ! -d "$AIOdir" ]; then
				mkdir "$AIOdir"
				echo ""
				echo -e "${GREEN}Success!${RESET}"
			else
				echo -e "${ERROR}Directory arleady exists. Try 'allinone' again.${RESET}"
				sleep 3
				clear
			fi

	elif [ "$AIOcmd" = "addmusic" ]; then
		addmusic
	elif [ "$AIOcmd" = "addcover" ]; then
		addcover
	elif [ "$AIOcmd" = "addtext" ]; then
		addtext
	elif [ "$AIOcmd" = "back" ]; then
		main
	else
		echo -e "${ERROR}Error! Unknown command. Try again.${RESET}"
	fi
done
}

#ALLINONE FUNCTION FINISH

#ZIP FUNCTION
function zip() {
while true; do
	echo "'help' - help for zip"

	read -e -p "ZIP($ZIPdir)/-> " ZIPcmd
	
	if [ "$ZIPcmd" = "help" ]; then
		echo ""
		echo -e "${BOLD}1. 'select' - Select need folder${RESET}"
		echo -e "${BOLD}2. 'archive' - Archive your selected folder${RESET}"
		echo -e "${BOLD}3. 'back' - Back to main menu ${RESET}"

	elif [ "$ZIPcmd" = "select" ]; then
		echo ""
		read -e -p "Move & drop here: " ZIPdir

	elif [ "$ZIPcmd" = "archive" ]; then
		echo "Your folder: $ZIPdir"
		read -e -p "Enter ZIP name: " ZIPname
		if [ -z "$ZIPname" ]; then
			ZIPname="tsl-amd-zip-$(date +%Y-%m-%d_%H%M%S)"
		fi
	tar -cf "${ZIPname}.zip" "$ZIPdir"
		if [ $? -eq 0 ]; then
			echo -e "${GREEN}Success!${RESET}"
		else
			echo -e "${ERROR}Error! Try again.${RESET}"
		fi

	elif [ "$ZIPcmd" = "back" ]; then
		main

	elif [ "$ZIPcmd" = "cancel" ]; then
		ZIPdir=""
		ZIPname=""
		zip
	else
		echo -e "${ERROR}Error! Unknown command. Try again.${RESET}"
	fi
done
}
#ZIP FUNCTION FINISH

mkdir ~/tsl-amd-session-$(date +%Y-%m-%d_%H%M%S)
cd ~/tsl-amd-session-$(date +%Y-%m-%d_%H%M%S)

echo ""
echo "\/\/\/ tsab.label - AMD \/\/\/"

main
