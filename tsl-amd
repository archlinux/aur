#!/bin/bash

BOLD='\e[1m'
GREEN='\e[32m'
YELLOW='\e[33m'
RESET='\e[0m'

ERROR='\e[31m'

#MAIN FUNCTION

function main() {
while true; do

echo ""
echo -e "${GREEN}NOW:${RESET} $(date)"
echo ""
echo "'help' - for help"
echo ""

read -e -p "-> " cmd
echo ""

if [ "$cmd" = "exit" ]; then
	exit

elif [ "$cmd" = "about" ]; then
	echo -e "${BOLD}tsab.label-Auto Music Distribution (tsl-AMD) - this is a useful program that helps create and upload music releases for tsab.label. The program's functionality will expand as development and updates progress."

elif [ "$cmd" = "clear" ]; then
	clear
	main

elif [ "$cmd" = "help" ]; then
	echo -e "${BOLD}1. 'allinone' - Collect audio, cover and text (optional) in one folder${RESET}"
	echo -e "${BOLD}2. 'zip' - Zip your folder${RESET}"
	echo -e "${BOLD}3. 'links' - Show tsab.label's links${RESET}"
	echo ""
	echo "---------------"
	echo ""
	echo -e "${YELLOW}EXTRAS:${RESET}"
	echo -e "${BOLD}${GREEN}1. 'exit' - Close the programm${RESET}"
	echo -e "${BOLD}${GREEN}2. 'about' - Show info about tsl-AMD${RESET}"
	echo -e "${BOLD}${GREEN}3. 'clear' - Clear last commands${RESET}"

elif [ "$cmd" = "allinone" ]; then
	allinone

elif [ "$cmd" = "zip" ]; then
	zip

elif [ "$cmd" = "links" ]; then
	echo ""
	echo -e "1. ${BOLD}VK${RESET} - https://vk.com/tsab.label"
	echo -e "2. ${BOLD}New Release form${RESET} - https://forms.yandex.ru/u/6a58eddb068ff0404efe2f2f"

else
	echo ""
	echo -e "${ERROR}Error! Unknown command. Try again.${RESET}"

fi

done
}

#MAIN FUNCTION FINISH

#ADDMUSIC FUNCTION
function addmusic() {
	while true; do 
		echo ""
		echo -e "${YELLOW}Move audio file here (mp3/wav): ${RESET}"
		echo "Or 'cancel' for back to AIO..."		
		read -e -p "Drop: " FILE_PATH
		if [ -f "$FILE_PATH" ]; then
			if [[ "$FILE_PATH" == *.mp3 || "$FILE_PATH" == *.wav || "$FILE_PATH" == *.MP3 || "$FILE_PATH" == *.WAV ]]; then
				cp "$FILE_PATH" "$AIOdir/"
				echo -e "${GREEN}Move success!${RESET}"
			else 
				echo -e "${ERROR}Error! Aviable only mp3/wav files or file arleady exists. Try 'addmusic' again.${RESET}"
				sleep 3
				clear
				allinone
			fi
		fi
		if [ "$FILE_PATH" == "cancel" ]; then
			clear
			echo -e "${GREEN}NOW: ${RESET} $(date)"
			echo ""
			allinone
		fi
	done
}
#ADDMUSIC FUNCTION FINISH

