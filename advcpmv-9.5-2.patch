+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+   GNU General Public License for more details.
+
+   You should have received a copy of the GNU General Public License
+   along with this program.  If not, see <https://www.gnu.org/licenses/>.  */
+
+#include <config.h>
+
+#include <math.h>
+#include <stdio.h>
+#include <sys/ioctl.h>
+
+#ifndef PROGRESS_EMBEDDED
+# include "system.h"
+#endif
+#include "gethrxtime.h"
+#include "human.h"
+#include "ignore-value.h"
+#include "progress.h"
+#include "quote.h"
+#include "xalloc.h"
+#include "xfts.h"
+
+enum { PROGRESS_RENDER_HZ = 8 };
+
+struct progress
+{
+  bool move_mode;
+  bool rendered;
+  bool current_complete;
+  xtime_t start_time;
+  xtime_t last_render;
+  uintmax_t total_files;
+  uintmax_t total_bytes;
+  uintmax_t completed_files;
+  uintmax_t completed_bytes;
+  char const *current_name;
+  uintmax_t current_total_bytes;
+  uintmax_t current_copied_bytes;
+};
+
+static uintmax_t
+progress_add (uintmax_t a, uintmax_t b)
+{
+  return UINTMAX_MAX - a < b ? UINTMAX_MAX : a + b;
+}
+
+static uintmax_t
+progress_stat_size (struct stat const *sb)
+{
+  return 0 < sb->st_size ? sb->st_size : 0;
+}
+
+static void
+progress_format_interval (char *buf, size_t bufsize, double seconds)
+{
+  if (seconds < 0 || ! isfinite (seconds))
+    {
+      snprintf (buf, bufsize, "--:--:--");
+      return;
+    }
+
+  uintmax_t total = seconds;
+  uintmax_t hours = total / 3600;
+  uintmax_t minutes = (total / 60) % 60;
+  uintmax_t secs = total % 60;
+  snprintf (buf, bufsize, "%02ju:%02ju:%02ju", hours, minutes, secs);
+}
+
+static char *
+progress_format_size (uintmax_t value, char *buf)
+{
+  int opts = (human_autoscale | human_base_1024 | human_SI | human_B
+              | human_space_before_unit | human_suppress_point_zero);
+  return human_readable (value, buf, opts, 1, 1);
+}
+
+static int
+progress_term_width (void)
+{
+  struct winsize ws;
+
+  if (ioctl (STDERR_FILENO, TIOCGWINSZ, &ws) == 0 && 40 <= ws.ws_col)
+    return ws.ws_col;
+
+  return 80;
+}
+
+static void
+progress_render (struct progress *progress, bool force)
+{
+  if (! progress)
+    return;
+
+  xtime_t now = gethrxtime ();
+  if (! force
+      && progress->last_render
+      && now - progress->last_render
+         < XTIME_PRECISION / PROGRESS_RENDER_HZ)
+    return;
+
+  if (! progress->start_time)
+    progress->start_time = now;
+  progress->last_render = now;
+
+  uintmax_t shown_bytes
+    = progress_add (progress->completed_bytes, progress->current_copied_bytes);
+  uintmax_t shown_files
+    = progress->completed_files + progress->current_complete;
+
+  if (progress->total_files == 0 && progress->total_bytes == 0)
+    return;
+
+  uintmax_t metric_done = progress->total_bytes ? shown_bytes : shown_files;
+  uintmax_t metric_total
+    = progress->total_bytes ? progress->total_bytes : progress->total_files;
+  double xtime_precision = XTIME_PRECISION;
+  double ratio = metric_total ? (double) metric_done / metric_total : 1.0;
+  if (ratio < 0)
+    ratio = 0;
+  if (1 < ratio)
+    ratio = 1;
+
+  double elapsed = (now - progress->start_time) / xtime_precision;
+  if (elapsed <= 0)
+    elapsed = 1.0 / PROGRESS_RENDER_HZ;
+
+  uintmax_t speed = shown_bytes / elapsed;
+  char eta_buf[64];
+  if (progress->total_bytes && speed)
+    progress_format_interval (eta_buf, sizeof eta_buf,
+                              (progress->total_bytes - shown_bytes)
+                              / (double) speed);
+  else
+    progress_format_interval (eta_buf, sizeof eta_buf, -1);
+
+  int width = progress_term_width ();
+  int bar_width = MIN (MAX (12, width / 5), 28);
+  char bar[64];
+  int filled = metric_total ? ratio * bar_width : bar_width;
+  for (int i = 0; i < bar_width; i++)
+    bar[i] = i < filled ? '=' : ' ';
+  if (0 < filled && filled < bar_width)
+    bar[filled - 1] = '>';
+  bar[bar_width] = '\0';
+
+  char tail[512];
+  if (progress->total_bytes)
+    {
+      char done_buf[LONGEST_HUMAN_READABLE + 1];
+      char total_buf[LONGEST_HUMAN_READABLE + 1];
+      char speed_buf[LONGEST_HUMAN_READABLE + 1];
+      char const *done = progress_format_size (shown_bytes, done_buf);
+      char const *total = progress_format_size (progress->total_bytes, total_buf);
+      char const *speed_s = progress_format_size (speed, speed_buf);
+      snprintf (tail, sizeof tail,
+                "%3d%% [%s] %s/%s %s/s ETA %s %ju/%ju",
+                metric_total ? (int) (ratio * 100.0 + 0.5) : 100,
+                bar, done, total, speed_s, eta_buf,
+                shown_files, progress->total_files);
+    }
+  else
+    {
+      snprintf (tail, sizeof tail,
+                "%3d%% [%s] %ju/%ju files",
+                metric_total ? (int) (ratio * 100.0 + 0.5) : 100,
+                bar, shown_files, progress->total_files);
+    }
+
+  char line[1024];
+  char const *verb = progress->move_mode ? _("moving") : _("copying");
+  char const *quoted_name = progress->current_name
+                            ? quoteaf (progress->current_name)
+                            : "";
+  int path_budget = width - strlen (tail) - strlen (verb) - 2;
+  if (path_budget < 0)
+    path_budget = 0;
+
+  if (path_budget && quoted_name[0])
+    {
+      size_t quoted_len = strlen (quoted_name);
+      if (quoted_len <= path_budget)
+        snprintf (line, sizeof line, "%s %.*s", verb, path_budget, quoted_name);
+      else if (3 < path_budget)
+        snprintf (line, sizeof line, "%s ...%.*s", verb, path_budget - 3,
+                  quoted_name + quoted_len - (path_budget - 3));
+      else
+        snprintf (line, sizeof line, "%s", verb);
+    }
+  else
+    snprintf (line, sizeof line, "%s", verb);
+
+  fprintf (stderr, "\r\033[K%s %s", line, tail);
+  fflush (stderr);
+  progress->rendered = true;
+}
+
+struct progress *
+progress_create (bool move_mode)
+{
+  if (! isatty (STDERR_FILENO))
+    return nullptr;
+
+  struct progress *progress = xzalloc (sizeof *progress);
+  progress->move_mode = move_mode;
+  return progress;
+}
+
+void
+progress_free (struct progress *progress)
+{
+  free (progress);
+}
+
+void
+progress_scan_paths (struct progress *progress, int n_paths, char **paths,
+                     int fts_options, bool recursive)
+{
+  if (! progress || n_paths <= 0)
+    return;
+
+  char **fts_paths = xnmalloc (n_paths + 1, sizeof *fts_paths);
+  for (int i = 0; i < n_paths; i++)
+    fts_paths[i] = paths[i];
+  fts_paths[n_paths] = nullptr;
+
+  FTS *fts = xfts_open (fts_paths, fts_options, nullptr);
+  free (fts_paths);
+
+  FTSENT *ent;
+  while ((ent = fts_read (fts)))
+    {
+      if (! recursive && ent->fts_info == FTS_D
+          && ent->fts_level == FTS_ROOTLEVEL)
+        {
+          fts_set (fts, ent, FTS_SKIP);
+          continue;
+        }
+
+      if ((ent->fts_info == FTS_F || ent->fts_info == FTS_DEFAULT)
+          && ent->fts_statp && S_ISREG (ent->fts_statp->st_mode))
+        {
+          progress->total_files++;
+          progress->total_bytes
+            = progress_add (progress->total_bytes,
+                            progress_stat_size (ent->fts_statp));
+        }
+    }
+
+  ignore_value (fts_close (fts));
+}
+
+void
+progress_begin_file (struct progress *progress, char const *src_name,
+                     uintmax_t total_bytes)
+{
+  if (! progress)
+    return;
+
+  if (progress->total_files <= progress->completed_files)
+    progress->total_files++;
+  if (progress->total_bytes < progress_add (progress->completed_bytes,
+                                            total_bytes))
+    progress->total_bytes = progress_add (progress->completed_bytes,
+                                          total_bytes);
+
+  progress->current_name = src_name;
+  progress->current_total_bytes = total_bytes;
+  progress->current_copied_bytes = 0;
+  progress->current_complete = false;
+  progress_render (progress, true);
+}
+
+void
+progress_update_file (struct progress *progress, uintmax_t copied_bytes)
+{
+  if (! progress || ! progress->current_name)
+    return;
+
+  if (progress->current_total_bytes < copied_bytes)
+    {
+      progress->total_bytes
+        = progress_add (progress->total_bytes,
+                        copied_bytes - progress->current_total_bytes);
+      progress->current_total_bytes = copied_bytes;
+    }
+
+  progress->current_copied_bytes = copied_bytes;
+  progress_render (progress, false);
+}
+
+void
+progress_finish_file (struct progress *progress, uintmax_t copied_bytes,
+                      bool success)
+{
+  if (! progress || ! progress->current_name)
+    return;
+
+  if (progress->current_total_bytes < copied_bytes)
+    {
+      progress->total_bytes
+        = progress_add (progress->total_bytes,
+                        copied_bytes - progress->current_total_bytes);
+      progress->current_total_bytes = copied_bytes;
+    }
+
+  progress->current_copied_bytes
+    = success ? MAX (copied_bytes, progress->current_total_bytes) : copied_bytes;
+  progress->current_complete = success;
+  progress_render (progress, true);
+
+  if (success)
+    {
+      progress->completed_files++;
+      progress->completed_bytes
+        = progress_add (progress->completed_bytes,
+                        progress->current_copied_bytes);
+    }
+
+  progress->current_name = nullptr;
+  progress->current_total_bytes = 0;
+  progress->current_copied_bytes = 0;
+  progress->current_complete = false;
+}
+
+void
+progress_complete_file (struct progress *progress, char const *src_name,
+                        uintmax_t total_bytes, bool success)
+{
+  if (! progress || ! success)
+    return;
+
+  if (progress->total_files <= progress->completed_files)
+    progress->total_files++;
+  if (progress->total_bytes < progress_add (progress->completed_bytes,
+                                            total_bytes))
+    progress->total_bytes = progress_add (progress->completed_bytes,
+                                          total_bytes);
+
+  progress->current_name = src_name;
+  progress->current_total_bytes = total_bytes;
+  progress->current_copied_bytes = total_bytes;
+  progress->current_complete = true;
+  progress_render (progress, true);
+
+  progress->completed_files++;
+  progress->completed_bytes
+    = progress_add (progress->completed_bytes, total_bytes);
+  progress->current_name = nullptr;
+  progress->current_total_bytes = 0;
+  progress->current_copied_bytes = 0;
+  progress->current_complete = false;
+}
+
+void
+progress_finish (struct progress *progress, bool ok)
+{
+  if (! progress)
+    return;
+
+  if (progress->current_name)
+    progress_finish_file (progress, progress->current_copied_bytes, ok);
+
+  if (progress->rendered)
+    fprintf (stderr, "\r\033[K");
+
+  if (progress->completed_files)
+    {
+      xtime_t end_time = gethrxtime ();
+      double xtime_precision = XTIME_PRECISION;
+      double elapsed = progress->start_time
+                       ? (end_time - progress->start_time) / xtime_precision
+                       : 0;
+      char elapsed_buf[64];
+      progress_format_interval (elapsed_buf, sizeof elapsed_buf, elapsed);
+
+      if (progress->completed_bytes)
+        {
+          uintmax_t speed = elapsed > 0 ? progress->completed_bytes / elapsed : 0;
+          char total_buf[LONGEST_HUMAN_READABLE + 1];
+          char speed_buf[LONGEST_HUMAN_READABLE + 1];
+          char const *total = progress_format_size (progress->completed_bytes,
+                                                    total_buf);
+          char const *speed_s = progress_format_size (speed, speed_buf);
+          fprintf (stderr,
+                   progress->move_mode
+                   ? ngettext ("%ju regular file moved (%s) in %s (%s/s)\n",
+                               "%ju regular files moved (%s) in %s (%s/s)\n",
+                               progress->completed_files)
+                   : ngettext ("%ju regular file copied (%s) in %s (%s/s)\n",
+                               "%ju regular files copied (%s) in %s (%s/s)\n",
+                               progress->completed_files),
+                   progress->completed_files, total, elapsed_buf,
+                   speed_s);
+        }
+      else
+        {
+          fprintf (stderr,
+                   progress->move_mode
+                   ? ngettext ("%ju regular file moved in %s\n",
+                               "%ju regular files moved in %s\n",
+                               progress->completed_files)
+                   : ngettext ("%ju regular file copied in %s\n",
+                               "%ju regular files copied in %s\n",
+                               progress->completed_files),
+                   progress->completed_files, elapsed_buf);
+        }
+    }
+}
