+
+struct progress;
+
+struct progress *progress_create (bool move_mode);
+void progress_free (struct progress *progress);
+
+void progress_scan_paths (struct progress *progress, int n_paths, char **paths,
+                          int fts_options, bool recursive);
+
+void progress_begin_file (struct progress *progress, char const *src_name,
+                          uintmax_t total_bytes);
+void progress_update_file (struct progress *progress, uintmax_t copied_bytes);
+void progress_finish_file (struct progress *progress, uintmax_t copied_bytes,
+                           bool success);
+void progress_complete_file (struct progress *progress, char const *src_name,
+                             uintmax_t total_bytes, bool success);
