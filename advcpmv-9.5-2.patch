+++ coreutils-9.5/src/progress.c	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,419 @@
+/* progress.c -- progress reporting for cp and mv
+   Copyright (C) 2024 Free Software Foundation, Inc.
+
