     try:
         with sync_playwright() as p:
-            p.chromium.launch()
+            p.chromium.launch(executable_path="/usr/bin/chromium")
             has_chromium = True
     except Exception:
         has_chromium = False
@@ -130,7 +130,7 @@ class Scraper:
 
         with sync_playwright() as p:
             try:
-                browser = p.chromium.launch()
