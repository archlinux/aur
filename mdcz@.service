[Unit]
Description=MDCz WebUI server for %I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/usr/lib/mdcz/server
EnvironmentFile=-%E/mdcz/mdcz.env
Environment=MDCZ_WEB_DIST_DIR=/usr/lib/mdcz/server/web
ExecStartPre=/usr/bin/mkdir -p %E/mdcz
ExecStartPre=/usr/bin/sh -c 'if [ ! -f %E/mdcz/mdcz.env ] ; then cp /usr/lib/mdcz/server/.env.example %E/mdcz/mdcz.env ; fi'
ExecStart=/usr/bin/node /usr/lib/mdcz/server/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
