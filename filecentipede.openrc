name="filec"
description="filec service, improves P2P stability and speed"

command="/opt/filecentipede/lib/filec"
command_args="__service__"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"
supervisor="supervise-daemon"
depend() {
    need net
    use dns
}

start_pre() {
    checkpath --directory --mode 0755 /var/run/${RC_SVCNAME}
}
