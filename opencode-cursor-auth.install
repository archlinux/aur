post_install() {
  echo "=========================================================================="
  echo "  Opencode Cursor Auth Plugin Installed"
  echo "=========================================================================="
  echo ""
  echo "To enable this plugin, add it to your opencode configuration file"
  echo "(e.g., ~/.config/opencode/config.json):"
  echo "{"
  echo "  \"plugin\": ["
  echo "    \"opencode-cursor-auth@1.0.16\""
  echo "  ],"
  echo "  \"provider\": {"
  echo "    \"cursor\": {"
  echo "      \"npm\": \"@ai-sdk/openai-compatible\","
  echo "      \"name\": \"Cursor Agent (local)\","
  echo "      \"options\": {"
  echo "        \"baseURL\": \"http://127.0.0.1:32123/v1\""
  echo "      },"
  echo "      \"models\": {"
  echo "        \"auto\": { \"name\": \"Cursor Agent Auto\" },"
  echo "        \"gpt-5\": { \"name\": \"Cursor Agent GPT-5 (alias → gpt-5.2)\" },"
  echo "        \"gpt-5.2\": { \"name\": \"Cursor Agent GPT-5.2\" },"
  echo "        \"gpt-5.1\": { \"name\": \"Cursor Agent GPT-5.1\" },"
  echo "        \"gpt-5.1-codex\": { \"name\": \"Cursor Agent GPT-5.1 Codex\" },"
  echo "        \"sonnet-4\": { \"name\": \"Cursor Agent Sonnet 4 (alias → sonnet-4.5)\" },"
  echo "        \"sonnet-4.5\": { \"name\": \"Cursor Agent Sonnet 4.5\" },"
  echo "        \"sonnet-4.5-thinking\": { \"name\": \"Cursor Agent Sonnet 4.5 Thinking\" }"
  echo "      }"
  echo "    }"
  echo "  }"
  echo "}"
  echo ""
  echo "Then run 'opencode auth login' to authenticate."
  echo "=========================================================================="
}

post_upgrade() {
  post_install
}
