# Copy this file to ~/.config/stably-orca/serve/<instance>.env.
# Example instance: ~/.config/stably-orca/serve/default.env

# GUI Electron launcher used when `orca serve` starts the packaged app runtime.
ORCA_APP_EXECUTABLE=/usr/bin/stably-orca

# Listener port. Orca currently listens on all interfaces; this does not set a
# bind address. Restrict access with a firewall, VPN policy, or reverse proxy.
ORCA_SERVE_PORT=6768

# Address advertised to clients. This may be a host, IP address, or wss:// URL.
# It does not change the listener bind address.
ORCA_SERVE_PAIRING_ADDRESS=

# runtime: regular runtime pairing
# mobile: mobile-scoped pairing
# disabled: do not publish a new pairing offer (recommended after setup)
ORCA_SERVE_PAIRING_MODE=runtime

# auto: use inherited DISPLAY, otherwise let Orca start Xvfb when available
# xvfb: discard inherited display variables and require xorg-server-xvfb
# external: require DISPLAY and validate it with xdpyinfo
ORCA_SERVE_DISPLAY_MODE=auto

# KWin virtual/Xwayland startup timeout, in seconds.
ORCA_KWIN_DISPLAY_TIMEOUT=20
