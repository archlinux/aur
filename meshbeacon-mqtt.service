[Unit]
Description=MeshBeacon MQTT Worker
After=network.target mosquitto.service

[Service]
Type=simple
User=meshbeacon
Group=meshbeacon
WorkingDirectory=/usr/share/webapps/meshbeacon
ExecStart=/usr/bin/php artisan app:mqtt-subscribe
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
