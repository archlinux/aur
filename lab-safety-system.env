APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080
# Replace DATABASE_URL and SECRET_KEY before starting in production.
DATABASE_URL=postgresql://lab_safety:change-me@127.0.0.1:5432/lab_safety
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
TOKEN_TTL_SECONDS=3600
STATIC_DIR=/usr/share/lab-safety-system/public
UPLOAD_DIR=/var/lib/lab-safety-system/uploads
SSO_ENABLED=false
OAUTH_ENABLED=false
SSO_LOGIN_URL=
OAUTH_LOGIN_URL=
FEDERATED_LOGIN_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=
