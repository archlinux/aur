# Account email delivery (Resend) as a systemd service, with the server's configuration
# (Debian and RPM packages).
[Unit]
Description=OpenChronology account email delivery (Resend)
Documentation=file:///usr/share/doc/openchronology-server/README.Debian
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=openchronology
Group=openchronology
EnvironmentFile=/etc/openchronology/openchronology.env
Environment=NODE_ENV=production
WorkingDirectory=/usr/lib/openchronology
ExecStart=/usr/lib/openchronology/node/bin/node server/mail-worker.mjs
Restart=on-failure
# Node exits with 128 + SIGTERM when stopped; that is a clean stop, not a failure.
SuccessExitStatus=143
RestartSec=10
# Hardening: no privileges, devices, kernel or clock changes, namespaces or foreign system
# calls, and files it creates private to it. AF_NETLINK is for Node's network interface list.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
