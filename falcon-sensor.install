pre_upgrade() {
  # Stop the service before upgrade to release file locks
  if systemctl is-active --quiet falcon-sensor; then
    printf "$(tput setaf 5)Stopping falcon-sensor service for upgrade...$(tput sgr0)\n"
    systemctl stop falcon-sensor
  fi

  # Remove runtime-generated files that may conflict with newer package versions
  # These files are created by the sensor after installation
  local runtime_files=(
    "/opt/CrowdStrike/falcon-flow"
  )

  for file in "${runtime_files[@]}"; do
    if [[ -e "$file" ]]; then
      printf "$(tput setaf 5)Removing runtime-generated file: %s$(tput sgr0)\n" "$file"
      rm -f "$file"
    fi
  done
}

post_install() {
  printf "$(tput setaf 4)Add your customer id and provisioning token to falcon by issuing:$(tput sgr0)\n"
  printf "$(tput setaf 6)sudo $(tput setaf 2)/opt/CrowdStrike/falconctl -s -f --cid=<CID> --provisioning-token=<PROVISIONING_TOKEN>$(tput sgr0)\n"
  printf "$(tput setaf 4)Start and enable falcon-sensor through systemd:$(tput sgr0)\n"
  printf "$(tput setaf 6)sudo $(tput setaf 2)systemctl enable --now falcon-sensor$(tput sgr0)\n"
}

post_upgrade() {
  # Restart the service if it was enabled
  if systemctl is-enabled --quiet falcon-sensor; then
    printf "$(tput setaf 4)Restarting falcon-sensor service...$(tput sgr0)\n"
    systemctl start falcon-sensor
  fi
}
