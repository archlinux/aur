+  const runtime = path.join(home, 'runtime')
+  fs.mkdirSync(runtime)
+  const script = path.join(runtime, 'install.sh')
+  fs.writeFileSync(script, '#!/bin/sh\n')
+  fs.writeFileSync(path.join(runtime, 'runtime-policy.patch'), 'patch fixture')
+  vi.stubEnv('HERMES_DESKTOP_PACKAGE_MANAGED_RUNTIME', '1')
+  vi.stubEnv('HERMES_DESKTOP_RESOURCES_PATH', home)
+  try {
+    const opts = {
+      installStamp: { commit: 'a'.repeat(40), branch: 'main' }, sourceRepoRoot: null,
+      hermesHome: home, emit: () => {},
+      _download: async () => { throw new Error('unexpected download') }
+    }
+    assert.deepEqual(await resolveInstallScript(opts), { path: script, source: 'package', kind: 'posix' })
+    fs.unlinkSync(script)
+    await assert.rejects(resolveInstallScript(opts), /ENOENT/)
+  } finally {
+    vi.unstubAllEnvs()
+    fs.rmSync(home, { recursive: true, force: true })
+  }
+})
+
+test('package readiness checks the applied patch, not only a saved receipt', () => {
+  const home = mkTmpHome()
+  try {
+    const root = path.join(home, 'agent')
+    const runtime = path.join(home, 'runtime')
+    fs.mkdirSync(runtime)
+    execFileSync('git', ['init', '-q', root])
+    const patch = '--- a/policy.txt\n+++ b/policy.txt\n@@ -1 +1 @@\n-upstream\n+packaged\n'
+    fs.writeFileSync(path.join(runtime, 'runtime-policy.patch'), patch)
+    fs.writeFileSync(path.join(root, '.git', 'hermes-desktop-runtime.patch'), patch)
+    fs.writeFileSync(path.join(root, 'policy.txt'), 'upstream\n')
+    assert.equal(isPackagedRuntimePatched(root, home), false)
+    execFileSync('git', ['apply', path.join(runtime, 'runtime-policy.patch')], { cwd: root })
+    assert.equal(isPackagedRuntimePatched(root, home), true)
+    fs.writeFileSync(path.join(root, 'policy.txt'), 'user changes\n')
+    assert.equal(isPackagedRuntimePatched(root, home), false)
+    assert.equal(fs.readFileSync(path.join(root, 'policy.txt'), 'utf8'), 'user changes\n')
+  } finally {
+    fs.rmSync(home, { recursive: true, force: true })
+  }
+})
