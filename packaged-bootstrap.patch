+function isPackagedRuntimePatched(activeRoot, resources = process.env.HERMES_DESKTOP_RESOURCES_PATH) {
+  if (!resources) return false
+  try {
+    const patch = path.join(resources, 'runtime', 'runtime-policy.patch')
+    const receipt = path.join(activeRoot, '.git', 'hermes-desktop-runtime.patch')
+    if (!fs.readFileSync(patch).equals(fs.readFileSync(receipt))) return false
+    execFileSync('git', ['apply', '--reverse', '--check', patch], {
+      cwd: activeRoot, stdio: 'ignore', timeout: 5000
+    })
+    return true
+  } catch {
+    return false
+  }
