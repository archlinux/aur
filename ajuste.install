post_install() {
  cat <<'MSG'
==> ajuste: the udev rule (/usr/lib/udev/rules.d/70-fractal-scape.rules) gives the
    logged-in user access to the Fractal Scape dongle. If it was already plugged in,
    replug it once.
==> To start ajuste in the tray at login:
      cp /usr/share/ajuste/ajuste-autostart.desktop ~/.config/autostart/
==> The tray icon needs a StatusNotifierItem host (KDE: built in; GNOME: the
    "AppIndicator and KStatusNotifierItem Support" extension).
MSG
}

post_upgrade() {
  post_install
}
