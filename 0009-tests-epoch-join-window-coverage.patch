index 04e1fe04..e56dc794 100644
--- a/tests/server_test.cpp
+++ b/tests/server_test.cpp
@@ -2641,7 +2641,8 @@ TEST(the_head_governance_counters_are_exported) {
 }
 
 /* The epoch-mode governance counters are counters beside them: the formations, the summed
- * closed-epoch length, the boundary cuts, and the revoked finish-guarantees. */
+ * closed-epoch length, the boundary cuts, the revoked finish-guarantees, and the cohort joins
+ * made inside the 5 s join window. */
 TEST(the_epoch_governance_counters_are_exported) {
     Metrics m("m", 1024);
     server::SchedMetrics s;
@@ -2649,6 +2650,7 @@ TEST(the_epoch_governance_counters_are_exported) {
     s.epoch_len_steps = 41;
     s.midarrival_cuts = 2;
     s.cohort_preempt_removals = 1;
+    s.epoch_cohort_joins = 3;
     m.sample(s);
     PromDoc d = parse_prom(m.render());
     CHECK_EQ((int)d.errors.size(), 0);
@@ -2656,6 +2658,7 @@ TEST(the_epoch_governance_counters_are_exported) {
     CHECK_EQ(d.type["radiance:engine_epoch_len_steps_total"], std::string("counter"));
     CHECK_EQ(d.type["radiance:engine_midarrival_cuts_total"], std::string("counter"));
     CHECK_EQ(d.type["radiance:engine_cohort_preempt_removals_total"], std::string("counter"));
+    CHECK_EQ(d.type["radiance:engine_epoch_cohort_joins_total"], std::string("counter"));
     const auto ep = d.samples.find(
         "radiance:engine_epochs_total{model_name=\"m\",engine=\"0\"}");
     CHECK(ep != d.samples.end() && ep->second == 5.0);
@@ -2668,6 +2671,9 @@ TEST(the_epoch_governance_counters_are_exported) {
     const auto pr = d.samples.find(
         "radiance:engine_cohort_preempt_removals_total{model_name=\"m\",engine=\"0\"}");
     CHECK(pr != d.samples.end() && pr->second == 1.0);
+    const auto jn = d.samples.find(
+        "radiance:engine_epoch_cohort_joins_total{model_name=\"m\",engine=\"0\"}");
+    CHECK(jn != d.samples.end() && jn->second == 3.0);
 }
 
