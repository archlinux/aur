diff --git a/tests/sched_test.cpp b/tests/sched_test.cpp
index 6d150e36..f8f1fd45 100644
--- a/tests/sched_test.cpp
+++ b/tests/sched_test.cpp
@@ -273,6 +273,11 @@ struct Fixture {
 
     /* Commit a step in which every sequence produced one token and none ended. */
     void commit_plain(int32_t token = 7) { CHECK_OK(commit(token)); }
+
+    /* Move the scheduler's monotonic clock (Scheduler::test_advance_clock_us): a submit after
+     * this reads `ms` later than one before it. The epoch tests use it to place an arrival
+     * inside or outside the 5 s cohort join window without sleeping. */
+    void advance_clock_ms(int64_t ms) { sch.test_advance_clock_us(ms * 1000); }
 };
 
 /* A uniformly random number of `e`'s drafts accepted, 0..n_spec, from an LCG. */
@@ -4209,8 +4214,11 @@ static Headed head_run(bool decoder_first, int steps) {
 /* --prefill-interleave: epoch. The oldest active request's class governs an epoch that forms at
  * epoch end and idle->busy only; the cohort -- every same-class request in running_ or waiting_
  * at formation -- is guaranteed that phase, and the epoch closes when the last one finishes it.
- * Mid-epoch arrivals run (right class) without a guarantee; preemption revokes membership.
- * These timelines run with the prefix cache off: the shapes below are the policy, not a hit. */
+ * Mid-epoch arrivals run (right class) without a guarantee; preemption revokes membership. A
+ * request created within 5 s of formation JOINS the live cohort with full membership (the W
+ * tests); timelines that want mid-arrival semantics advance the clock past the window before
+ * submitting. These timelines run with the prefix cache off: the shapes below are the policy,
+ * not a hit. */
 
 /* Commit the planned step with every row producing `token` and only the rows whose seq appears
  * in `ends` ending. */
@@ -4336,6 +4344,8 @@ TEST(epoch_E3_midarrival_runs_and_is_cut) {
     const uint64_t b = f.submit(128, 8);             /* short member: leaves budget beside it */
     CHECK(f.sch.step() != nullptr);                  /* PF epoch {a, b} */
     f.commit_plain(12);
+    /* Past the 5 s cohort join window: c must stay a mid-arrival, not join epoch {a, b}. */
+    f.advance_clock_ms(5001);
     const uint64_t c = f.submit(512, 8);             /* mid-arrival: same class, no membership */
     bool c_ran = false;
     for (int k = 0; k < 20; ++k) {                   /* run to the boundary */
@@ -4378,6 +4388,9 @@ TEST(epoch_E4a_midarrival_joins_the_decode_cohort) {
     const uint64_t b = f.submit(2000, 8);
     CHECK(f.sch.step() != nullptr);                  /* PF epoch {a, b} */
     f.commit_plain(12);
+    /* Past the 5 s cohort join window: c stays the mid-arrival this test is about, rather
+     * than joining epoch {a, b} and being a member when it finishes its chunk. */
+    f.advance_clock_ms(5001);
     const uint64_t c = f.submit(256, 8);             /* mid-arrival: one chunk */
     for (int k = 0; k < 20; ++k) {
         CHECK(f.sch.step() != nullptr);
@@ -4424,6 +4437,9 @@ TEST(epoch_E4b_no_decoders_at_the_boundary) {
     const uint64_t b = f.submit(512, 1);
     CHECK(f.sch.step() != nullptr);                  /* PF epoch {a, b} */
     f.commit_plain(12);
+    /* Past the 5 s cohort join window: c stays a mid-arrival, so the epoch closes when a and
+     * b close with it mid-prompt, rather than waiting for c as its member. */
+    f.advance_clock_ms(5001);
     const uint64_t c = f.submit(2000, 8);            /* mid-arrival */
     for (int k = 0; k < 20; ++k) {
         CHECK(f.sch.step() != nullptr);
@@ -4550,6 +4566,9 @@ TEST(epoch_victim_prefers_the_frozen_cut) {
     const uint64_t b = f.submit(128, 512);
     CHECK(f.sch.step() != nullptr);                  /* PF epoch {a, b} */
     f.commit_plain(12);
+    /* Past the 5 s cohort join window: c stays a mid-arrival, so the DECODE epoch cuts it at
+     * the boundary and it is the preferred victim, rather than being a protected member. */
+    f.advance_clock_ms(5001);
     const uint64_t c = f.submit(300, 512);           /* mid-arrival: runs beside the cohort */
     for (int k = 0; k < 20 && f.sch.metrics().epochs < 2; ++k) {
         CHECK(f.sch.step() != nullptr);
@@ -4571,6 +4590,200 @@ TEST(epoch_victim_prefers_the_frozen_cut) {
