post_install() {
    echo "==> envd systemd service installed."
    echo "==> To configure:"
    echo "    sudo cp /usr/share/doc/envd/server.yml.example /etc/envd/server.yml"
    echo "    sudo systemctl edit --full envd"
    echo ""
    echo "==> To start the system service:"
    echo "    sudo systemctl enable --now envd"
    echo ""
    echo "==> Or use the user service:"
    echo "    mkdir -p ~/.config/envd"
    echo "    cp /usr/share/doc/envd/server.yml.example ~/.config/envd/server.yml"
    echo "    systemctl --user enable --now envd"
}

post_upgrade() {
    post_install "$@"
}
