post_install() {
  cat <<'EOF'
  technitium-console is installed in /usr/share/technitium-console.

  To serve it from Technitium DNS Server 15.5 or later, set on the server:
    DNS_SERVER_WEB_SERVICE_WWW_FOLDER_PATH=/usr/share/technitium-console
  and restart the DNS service once. On Docker, mount it read-only instead;
  see the README "Docker" section.

  The one-line installer remains the recommended path on a live server
  (it verifies the running service and can roll back):
    curl -sSL https://raw.githubusercontent.com/byGarcia/technitium-console/main/install.sh | sudo sh
  Installed copy of that script: /usr/share/doc/technitium-console/install.sh
EOF
}

post_upgrade() {
  post_install
}
