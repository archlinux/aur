post_install() {
    echo ""
    echo "=== Odysseus AI: Creating virtual environment ==="
    python -m venv /usr/lib/odysseus-ai/venv
    /usr/lib/odysseus-ai/venv/bin/pip install --quiet \
        -r /usr/lib/odysseus-ai/requirements.filtered.txt
    echo "[ok] Dependencies installed"

    # Create required data directories
    mkdir -p /usr/lib/odysseus-ai/data/{uploads,personal_docs,personal_uploads,tts_cache,generated_images,deep_research,chroma,rag,memory_vectors}
    mkdir -p /usr/lib/odysseus-ai/logs
    chown -R "${SUDO_USER:-root}:${SUDO_USER:-root}" \
        /usr/lib/odysseus-ai/data \
        /usr/lib/odysseus-ai/logs 2>/dev/null || true

    echo ""
    echo "--- Enable the service ---"
    echo "  systemctl --user enable --now odysseus-ai"
    echo ""
    echo "Then open http://localhost:7000"
    echo "Note: On first start, fastembed downloads ~30MB of ML models. Give it a minute."
    echo ""
}

post_upgrade() {
    echo ""
    echo "=== Odysseus AI: Updating dependencies ==="
    /usr/lib/odysseus-ai/venv/bin/pip install --quiet \
        -r /usr/lib/odysseus-ai/requirements.filtered.txt
    echo ""
    echo "Restart the service:"
    echo "  systemctl --user restart odysseus-ai"
    echo ""
}

pre_remove() {
    systemctl --user stop odysseus-ai 2>/dev/null || true
    systemctl --user disable odysseus-ai 2>/dev/null || true
    systemctl stop odysseus-ai 2>/dev/null || true
    systemctl disable odysseus-ai 2>/dev/null || true
}

post_remove() {
    echo ""
    echo "=== Odysseus AI removed ==="
    echo "Data is NOT deleted automatically. Clean up manually if needed:"
    echo "  sudo rm -rf /usr/lib/odysseus-ai/venv"
    echo "  sudo rm -rf /usr/lib/odysseus-ai/data"
    echo "  rm -rf ~/.config/odysseus-ai"
    echo ""
}
