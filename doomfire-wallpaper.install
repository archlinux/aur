post_install() {
  echo -e "\033[1;33m"
  echo "=============================================================="
  echo "  IMPORTANT: Finalize setup by running: doom-fire-wallpaper setup"
  echo "  This will create your config and start the systemd user service."
  echo "=============================================================="
  echo "  run doom-fire-wallpaper setup now to enable the wallpaper..."
  echo "=============================================================="
  echo -e "\033[0m"
}