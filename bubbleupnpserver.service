[Unit]
Description=BubbleUPnP Server
Wants=network-online.target
After=network-online.target

[Service]
User=bubbleupnp
Group=bubbleupnp
WorkingDirectory=/var/lib/bubbleupnp
StateDirectory=bubbleupnp
StateDirectoryMode=0750
EnvironmentFile=/etc/conf.d/bubbleupnpserver.config
ExecStart=/usr/bin/bubbleupnpserver -dataDir /var/lib/bubbleupnp $RUN_ARGS

[Install]
WantedBy=multi-user.target
