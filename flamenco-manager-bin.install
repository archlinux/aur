post_install() {
  printf '%s\n' \
    'Flamenco Manager is not enabled automatically.' \
    'Start it for a Unix user with:' \
    '  systemctl enable --now flamenco-manager@USER.service' \
    'Configuration help: /usr/share/doc/flamenco-manager-bin/README.Arch'
}

post_upgrade() {
  post_install
}
