#!/usr/bin/env bash
if [[ -o xtrace ]]; then
  export XTRACE=true
fi

# this flag doesn't work with the dry-run switch
if [[ "$*" == *"--allow-unreleased"* ]]; then
  HELM_DIFF_USE_UPGRADE_DRY_RUN=false
fi
HELM_DIFF_USE_UPGRADE_DRY_RUN="${HELM_DIFF_USE_UPGRADE_DRY_RUN:-true}" exec helmrelease "diff" "$@"
