post_install() {
  cat <<'EOF'
==> Cross compilers installed:
      ppcross386  ->  win32  (i386)
      ppcrossx64  ->  win64  (x86_64)
    RTL units:  /usr/lib/fpc/3.2.2/units/{i386-win32,x86_64-win64}/rtl

==> With the 'fpc' package installed:   fpc -Twin32 hello.pas
                                        fpc -Twin64 hello.pas

==> Standalone use: add this line to /etc/fpc.cfg or ~/.fpc.cfg
      #INCLUDE /etc/fpc-mingw-w64.cfg
EOF
}

post_upgrade() {
  post_install
}
