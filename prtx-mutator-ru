                echo -ne "${BOLD}Введите '1' для подтверждения (2/5): ${NC}"
                IFS= read -rsn1 conf2
                while read -r -t 0; do read -r -t 0.01; done
                
                if [ "$conf2" != "1" ]; then
                    echo -e "${CYAN}Операция отменена.${NC}"
                    sleep 1
                    continue
                fi
                
                echo ""
                echo -e "${DIM}Статистика установки:${NC}"
                echo -e "${RED}Процесс может занять продолжительное время.${NC}"
                echo -ne "${BOLD}Введите '2' для подтверждения (3/5): ${NC}"
                IFS= read -rsn1 conf3
                while read -r -t 0; do read -r -t 0.01; done
                
                if [ "$conf3" != "2" ]; then
                    echo -e "${CYAN}Операция отменена.${NC}"
                    sleep 1
                    continue
                fi
                
                echo ""
                echo -e "${DIM}Предфинальная проверка:${NC}"
                echo -e "${RED}Убедитесь, что у вас есть минимум 500MB свободного места.${NC}"
                echo -ne "${BOLD}Введите '3' для подтверждения (4/5): ${NC}"
                IFS= read -rsn1 conf4
                while read -r -t 0; do read -r -t 0.01; done
                
                if [ "$conf4" != "3" ]; then
                    echo -e "${CYAN}Операция отменена.${NC}"
                    sleep 1
                    continue
                fi
                
                echo ""
                echo -e "${RED}${BOLD}ФИНАЛЬНОЕ ПОДТВЕРЖДЕНИЕ${NC}"
                echo -e "${DIM}...но если очень хочется, то можно...${NC}"
                echo ""
                echo -ne "${BOLD}Введите 'да, я подтверждаю это' или 'yes, i confirm this' (5/5): ${NC}"
                read -r final_conf
                
                if [ "$final_conf" != "да, я подтверждаю это" ] && [ "$final_conf" != "yes, i confirm this" ]; then
                    echo -e "${CYAN}Мудрое решение.${NC}"
                    sleep 1
                    continue
                fi
                
                echo ""
                echo -e "${YELLOW}Установка всех тем GRUB...${NC}"
                sudo pacman -S $(pacman -Ssq grub-theme)
                sleep 2
                ;;
        esac
    done
}

reboot_system() {
    local r_count=0
    
    echo ""
    echo -e "${YELLOW}${BOLD}⚠ ПЕРЕЗАГРУЗКА СИСТЕМЫ ⚠${NC}"
    echo -e "${DIM}Нажмите 'R' два раза для подтверждения${NC}"
    echo ""
    
    while [ $r_count -lt 2 ]; do
        echo -ne "${BOLD}Подтверждение ($(($r_count + 1))/2): ${NC}"
        IFS= read -rsn1 conf
        while read -r -t 0; do read -r -t 0.01; done
        
        if [ "$conf" = "r" ] || [ "$conf" = "R" ] || [ "$conf" = "к" ] || [ "$conf" = "К" ]; then
            ((r_count++))
            echo -e "${GREEN}✓${NC}"
        else
            echo -e "${RED}✗${NC}"
            echo -e "${CYAN}Перезагрузка отменена.${NC}"
            sleep 1
            return
        fi
    done
    
    echo ""
    echo -e "${GREEN}Перезагрузка системы...${NC}"
    sleep 1
    sudo reboot
}

uninstall_all_themes() {
    echo ""
    echo -e "${RED}${BOLD}⚠ УДАЛЕНИЕ ВСЕХ ТЕМ ⚠${NC}"
    echo -e "${DIM}Нажмите 'U' для подтверждения${NC}"
    echo ""
    
    echo -ne "${BOLD}Подтверждение: ${NC}"
    IFS= read -rsn1 conf
    while read -r -t 0; do read -r -t 0.01; done
    
    if [ "$conf" = "u" ] || [ "$conf" = "U" ] || [ "$conf" = "г" ] || [ "$conf" = "Г" ]; then
        echo -e "${GREEN}✓${NC}"
    else
        echo -e "${RED}✗${NC}"
        echo -e "${CYAN}Удаление отменено.${NC}"
        sleep 1
        return
    fi
    
    echo ""
    echo -e "${YELLOW}Удаление всех тем GRUB...${NC}"
    sudo pacman -Rns $(pacman -Qq | grep grub-theme) --noconfirm 2>/dev/null || true
    sudo sed -i '/^GRUB_THEME=/d' "$GRUB_CONFIG"
    sudo grub-mkconfig -o /boot/grub/grub.cfg > /dev/null 2>&1
    echo ""
    echo -e "${GREEN}${BOLD}✓${NC} Все темы удалены!"
    echo ""
    sleep 1.5
}

main() {
    if [ "$EUID" -eq 0 ]; then
        echo -e "${RED}Не запускайте скрипт с правами root напрямую!${NC}"
        echo -e "${YELLOW}Скрипт сам запросит sudo когда потребуется.${NC}"
        exit 1
    fi
    
    get_installed_themes || exit 1
    get_current_theme
    
    local current_page=0
    local total_pages=$(( (${#themes[@]} + THEMES_PER_PAGE - 1) / THEMES_PER_PAGE ))
    
    while true; do
        show_page $current_page
        
        IFS= read -rsn1 choice
        while read -r -t 0; do read -r -t 0.01; done
        
        case $choice in
            q|Q|й|Й)
                clear
                echo -e "${CYAN}Выход из программы...${NC}"
                exit 0
                ;;
            i|I|ш|Ш)
                install_menu
                get_installed_themes
                get_current_theme
                current_page=0
                total_pages=$(( (${#themes[@]} + THEMES_PER_PAGE - 1) / THEMES_PER_PAGE ))
                ;;
            r|R|к|К)
                reboot_system
                ;;
            u|U|г|Г)
                uninstall_all_themes
                get_installed_themes
                get_current_theme
                current_page=0
                total_pages=$(( (${#themes[@]} + THEMES_PER_PAGE - 1) / THEMES_PER_PAGE ))
                ;;
            '`'|'~')
                if [ $current_page -gt 0 ]; then
                    ((current_page--))
                fi
                ;;
            '-'|'_')
                if [ $((current_page + 1)) -lt $total_pages ]; then
                    ((current_page++))
                fi
                ;;
            [1-9])
                local num=$((choice))
                local start_idx=$((current_page * THEMES_PER_PAGE))
                local theme_idx=$((start_idx + num - 1))
                
                if [ $theme_idx -lt ${#themes[@]} ]; then
                    apply_theme "${themes[$theme_idx]}"
                    get_current_theme
                fi
                ;;
            0)
                local start_idx=$((current_page * THEMES_PER_PAGE))
                local theme_idx=$((start_idx + 9))
                
                if [ $theme_idx -lt ${#themes[@]} ]; then
                    apply_theme "${themes[$theme_idx]}"
                    get_current_theme
                fi
                ;;
        esac
    done
}

main
