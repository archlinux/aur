                sudo pacman -S dracula-grub-theme-git catppuccin-frappe-grub-theme-git catppuccin-latte-grub-theme-git catppuccin-macchiato-grub-theme-git catppuccin-mocha-grub-theme-git
                sleep 2
                ;;
