+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PIPEWIRE_MODULE_SOUNDTOUCH_ZONE_VOLUME_H
+#define PIPEWIRE_MODULE_SOUNDTOUCH_ZONE_VOLUME_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <spa/param/audio/raw.h>
+#include <spa/pod/builder.h>
+
+struct soundtouch_zone_volume {
+	uint32_t channels;
+	bool mute;
+	float channel_volumes[SPA_AUDIO_MAX_CHANNELS];
+};
+
+int soundtouch_zone_volume_init(struct soundtouch_zone_volume *volume,
+		uint32_t channels, float initial, bool mute);
+
+int soundtouch_zone_volume_build(const struct soundtouch_zone_volume *volume,
+		const struct spa_pod *source, struct spa_pod_builder *builder,
+		const struct spa_pod **param);
+
+int soundtouch_zone_volume_normalize(struct soundtouch_zone_volume *volume,
+		const struct spa_pod *source, struct spa_pod_builder *builder,
+		const struct spa_pod **param);
+
+#endif /* PIPEWIRE_MODULE_SOUNDTOUCH_ZONE_VOLUME_H */
