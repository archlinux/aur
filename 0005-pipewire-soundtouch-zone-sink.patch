+/** \page page_module_soundtouch_zone_sink SoundTouch zone sink
+ *
+ * This private loopback publishes a stable virtual SoundTouch zone sink.
+ * Its hidden playback stream deliberately has no autoconnect flag. A trusted
+ * controller must prepare the physical zone and explicitly link the playback
+ * ports before application audio can be consumed.
+ *
+ * Public mute and channel volumes are logical hardware controls. The capture
+ * adapter always receives scalar volume 1.0, soft mute false and unity soft
+ * volumes, so UI changes cannot alter audio samples in software.
+ *
+ * ## Module Name
+ *
+ * `libpipewire-module-soundtouch-zone-sink`
+ *
+ * ## Module Options
+ *
+ * - `zone.id`: required canonical UUID used for stable ASCII node names
+ * - `zone.publication-id`: required controller publication identifier
+ * - `zone.volume.initial`: required linear volume in the range 0.0 to 1.0
+ * - `zone.volume.initial.mute`: required boolean hardware mute state
+ * - `node.description`: a human readable, Unicode-capable zone name
+ * - `capture.props = {}`: properties to be passed to the input stream
+ * - `playback.props = {}`: properties to be passed to the output stream
+ *
+ * ## Fixed contract
+ *
+ * The public capture node is `Audio/Sink` and is named
+ * `soundtouch_zone.<32-lowercase-UUID-hex>`. The hidden playback node is
+ * `Stream/Output/Audio` and appends `.playback`. Both nodes advertise:
+ *
+ * - `soundtouch.zone.contract = 1`
+ * - `soundtouch.zone.volume.contract = 1`
+ * - `soundtouch.zone.volume.control = external`
+ * - `soundtouch.zone.arm.contract = 1`
+ * - `soundtouch.zone.arm.control = node-command`
+ * - `soundtouch.zone.arm.nonce = <16-hex-digit publication nonce>`
+ * - `soundtouch.zone.arm.sequence = <acknowledged decimal sequence>`
+ * - `soundtouch.zone.armed = false|true`
+ * - the zone UUID, publication identifier and node role
+ *
+ * Both streams start inactive. The hidden playback node is passive and is
+ * activated only by an accepted arm command. The core can therefore derive
+ * passive transport links from this trusted, module-owned node property even
+ * when the client link factory does not accept an explicit link.passive
+ * property. A controller must
+ * prepare the physical speakers, create and verify those explicit links, and
+ * only then send a `SPA_NODE_COMMAND_User` command to the public node.
+ * Its `extra` string contains the next sequence, the published nonce and the
+ * requested state:
+ *
+ *\code{.unparsed}
+ * { "command.id": "soundtouch-zone-arm-state",
+ *   "state": "armed",
+ *   "sequence": "<published sequence + 1>",
+ *   "nonce": "<published nonce>" }
+ *\endcode
+ *
+ * Before removing links or tearing down the physical zone, it sends the next
+ * generation with `"state": "disarmed"`.
+ *
+ * A command is accepted only when its nonce matches and its sequence is
+ * exactly one greater than the acknowledged sequence. An exact retry of an
+ * already acknowledged state is an idempotent no-op; stale, contradictory,
+ * skipped-generation and mismatched-nonce commands are rejected. The
+ * controller waits for the exact nonce, sequence and armed state to
+ * acknowledge each transition.
+ *
+ * Capture and playback use one fixed common channel layout. SoundTouch exposes
+ * one scalar zone volume, so all public channel volumes must be equal.
+ * `target.object`, autoconnect and software volume controls cannot be enabled
+ * through stream properties.
+ */
+
+#define NAME "soundtouch-zone-sink"
+
+PW_LOG_TOPIC_STATIC(mod_topic, "mod." NAME);
+#define PW_LOG_TOPIC_DEFAULT mod_topic
+
+static const struct spa_dict_item module_props[] = {
+	{ PW_KEY_MODULE_AUTHOR, "Wim Taymans <wim.taymans@gmail.com>; "
+			"Lukáš Lipinský" },
+	{ PW_KEY_MODULE_DESCRIPTION, "Create a hardware-volume SoundTouch zone sink" },
+	{ PW_KEY_MODULE_USAGE, " ( remote.name=<remote> ) "
+				"( node.latency=<latency as fraction> ) "
+				"( node.description=<zone description> ) "
+				"( audio.rate=<sample rate> ) "
+				"( audio.channels=<number of channels> ) "
+				"( audio.position=<channel map> ) "
+				"( zone.id=<canonical UUID> ) "
+				"( zone.publication-id=<publication identifier> ) "
+				"( zone.volume.initial=<linear 0.0..1.0> ) "
+				"( zone.volume.initial.mute=<true|false> ) "
+				"( capture.props=<properties> ) "
+				"( playback.props=<properties> ) " },
+	{ PW_KEY_MODULE_VERSION, PACKAGE_VERSION },
+};
