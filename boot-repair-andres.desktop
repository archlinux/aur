[Desktop Entry]
Name=Boot Repair Andres
Comment=Herramienta de rescate: Reparación de GRUB, pantalla, y diagnósticos.
Exec=pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY boot-repair
Icon=preferences-system
Terminal=true
Type=Application
Categories=System;Utility;Core;
Keywords=boot;repair;grub;system;diagnostico;
