[Desktop Entry]
Name=Devin
Comment=A team of agents for every engineer.
GenericName=Text Editor
Exec=/opt/devin-desktop/devin-desktop %F
Icon=devin-desktop
Type=Application
StartupNotify=false
StartupWMClass=Devin
Categories=TextEditor;Development;IDE;
MimeType=application/x-devin-desktop-workspace;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/opt/devin-desktop/devin-desktop --new-window %F
Icon=devin-desktop
