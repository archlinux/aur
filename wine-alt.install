post_install() {
    echo ""
    echo "========================================================================"
    echo "  Wine 11.7.1 (сборка ALT Linux Sisyphus) успешно установлен!"
    echo "========================================================================"
    echo ""
    echo "Это сборка в режиме 'new WoW64':"
    echo "  * Работают и 32-битные, и 64-битные Windows-приложения."
    echo "  * 32-битные Unix-библиотеки (lib32-*) НЕ требуются."
    echo ""
    echo "Если вы в Wayland-сессии (Sway/Hyprland/niri) и winecfg падает"
    echo "с ошибкой 'nodrv_CreateWindow':"
    echo "  * Sway:     'xwayland enable' в ~/.config/sway/config + swaymsg reload"
    echo "  * Hyprland: 'misc:xwayland = true' в hyprland.conf"
    echo "  * niri:     используйте xwayland-satellite или xwayland-run"
    echo ""
    echo "Альтернатива — native Wayland-драйвер:"
    echo "  wine reg add 'HKCU\\Software\\Wine\\Drivers' /v Graphics /d wayland /f"
    echo "  (но он пока уступает X11 по стабильности)"
    echo ""
    echo "Для типового офисного сценария доустановите:"
    echo "  pacman -S wine-mono wine-gecko alsa-lib libpulse libcups gnutls xorg-xwayland"
    echo ""
    echo "Для работы в домене AD:"
    echo "  pacman -S krb5 samba"
    echo ""
    echo "Для игр и DirectX 10+:"
    echo "  pacman -S vulkan-icd-loader"
    echo ""
    echo "Инициализация префикса Wine:  wineboot -u"
    echo "Настройка:                    winecfg"
    echo "========================================================================"
}

post_upgrade() { post_install; }
