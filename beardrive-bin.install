post_install() {
    cat <<'EOF'
BearDrive's systemd user service is managed by this package.

For each user, remove any unit previously generated by `bdrive init`, then
enable the packaged unit:

  bdrive autostart uninstall
  systemctl --user daemon-reload
  systemctl --user enable --now beardrive.service

Use `bdrive init --no-autostart` so bdrive does not recreate a user-local unit
that shadows /usr/lib/systemd/user/beardrive.service.
EOF
}

post_upgrade() {
    post_install
}
