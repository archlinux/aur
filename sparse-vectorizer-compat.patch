+# SPDX-License-Identifier: BSD-3-Clause
+import pickle
+import unittest
+
+import numpy as np
+from numpy.testing import assert_array_equal
+from scipy.sparse import csr_array
+from sklearn.base import clone
+from sklearn.feature_extraction import DictVectorizer as SklearnDictVectorizer
+
+from q2_sample_classifier.utilities import (
+    DictVectorizer, _compact_sparse_indices)
+
+
+class VectorizerCompatibilityTests(unittest.TestCase):
+    samples = [{'a': 1, 'category': 'first'},
+               {'b': 2, 'category': 'second'}]
+
+    def test_sparse_values_features_and_transform(self):
+        expected = SklearnDictVectorizer()
+        vectorizer = DictVectorizer()
+        result = vectorizer.fit_transform(iter(self.samples))
+        assert_array_equal(result.toarray(),
+                           expected.fit_transform(self.samples).toarray())
+        assert_array_equal(vectorizer.get_feature_names_out(),
+                           expected.get_feature_names_out())
+        transformed = vectorizer.transform([{'a': 3, 'unknown': 4}])
+        assert_array_equal(transformed.toarray(),
+                           expected.transform([{'a': 3, 'unknown': 4}]).toarray())
+        for matrix in [result, transformed]:
+            self.assertEqual(matrix.indices.dtype, np.dtype('int32'))
+            self.assertEqual(matrix.indptr.dtype, np.dtype('int32'))
+
+    def test_clone_fit_and_pickle(self):
+        original = DictVectorizer(dtype=np.float32, separator=':', sort=False)
+        vectorizer = clone(original)
+        self.assertIs(type(vectorizer), DictVectorizer)
+        self.assertEqual(vectorizer.get_params(), original.get_params())
+        self.assertIs(vectorizer.fit(self.samples), vectorizer)
+        restored = pickle.loads(pickle.dumps(vectorizer))
+        assert_array_equal(restored.transform(self.samples).toarray(),
+                           vectorizer.transform(self.samples).toarray())
+        self.assertEqual(restored.transform(self.samples).dtype, np.float32)
+        self.assertEqual(restored.transform(self.samples).indices.dtype,
+                         np.dtype('int32'))
+
+    def test_dense_output(self):
+        vectorizer = DictVectorizer(sparse=False, sort=False)
+        expected = SklearnDictVectorizer(sparse=False, sort=False)
+        result = vectorizer.fit_transform(self.samples)
+        self.assertIsInstance(result, np.ndarray)
+        assert_array_equal(result, expected.fit_transform(self.samples))
+        assert_array_equal(vectorizer.transform(self.samples),
+                           expected.transform(self.samples))
+
+    def test_large_sparse_shape_is_preserved(self):
+        column = np.iinfo(np.int32).max + 1
+        matrix = csr_array(([2.0], ([0], [column])),
+                           shape=(1, column + 1))
+        self.assertIs(_compact_sparse_indices(matrix), matrix)
+        self.assertEqual(matrix.indices.dtype, np.dtype('int64'))
+        self.assertEqual(matrix.shape, (1, column + 1))
+        assert_array_equal(matrix.indices, [column])
+        assert_array_equal(matrix.data, [2.0])
