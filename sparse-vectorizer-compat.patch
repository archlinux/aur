+def _compact_sparse_indices(matrix):
+    # Some estimators require 32-bit sparse indices even when DictVectorizer
+    # returns a sparse array with 64-bit indices. Preserve larger matrices.
+    if (issparse(matrix) and matrix.format in {'csr', 'csc'}
+            and max(*matrix.shape, matrix.nnz) <= np.iinfo(np.int32).max):
+        matrix.indices, matrix.indptr = safely_cast_index_arrays(
+            matrix, np.int32)
+    return matrix
+
+
+class DictVectorizer(_SklearnDictVectorizer):
+    "Keep compact sparse output compatible with all supported estimators."
+
+    def fit_transform(self, X, y=None):
+        return _compact_sparse_indices(super().fit_transform(X, y))
+
+    def transform(self, X):
+        return _compact_sparse_indices(super().transform(X))
 
 
