         public static string OriginalTempFolder;
 
         static FilesystemExtensions() {
-            OriginalTempFolder = OriginalTempFolder ?? Path.GetTempPath();
+            OriginalTempFolder = OriginalTempFolder ?? GetUserTempFolder();
             ResetTempFolder();
