[Unit]
Description=AzerothCore MMORPG Authentication Server
After=network.target

[Service]
Type=forking
User=azerothcore
Group=acore-admin
RuntimeDirectory=azerothcore
RuntimeDirectoryMode=0775
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/bin/tmux -S /run/azerothcore/auth.sock new-session -d -s authserver '/usr/share/azerothcore/bin/authserver'
ExecStop=/usr/bin/tmux -S /run/azerothcore/auth.sock kill-session -t authserver
Restart=on-failure

[Install]
WantedBy=multi-user.target
