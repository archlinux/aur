[Unit]
Description=AzerothCore MMORPG Authentication Server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=forking
User=azerothcore
Group=acore-admin
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/bin/tmux -S /run/azerothcore/auth.sock new-session -d -s worldserver '/usr/share/azerothcore/bin/authserver'
ExecStop=/usr/bin/tmux -S /run/azerothcore/auth.sock kill-session -t worldserver

[Install]
WantedBy=multi-user.target