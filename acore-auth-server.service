[Unit]
Description=AzerothCore MMORPG Authentication Server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
WorkingDirectory=/usr/share/azerothcore
ExecStart=/usr/bin/tmux new-session -d -s acore-auth /usr/share/azerothcore/acore.sh run-authserver
ExecStop=/usr/bin/tmux kill-session -t acore-auth || true

[Install]
WantedBy=multi-user.target