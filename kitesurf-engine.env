# Settings for the kitesurf-engine user service.
# Copy to ~/.config/kitesurf-engine/env, then: systemctl --user restart kitesurf-engine

# Port to listen on (CDP: ws://127.0.0.1:PORT/devtools/browser).
#KITESURF_ENGINE_PORT=8787

# The engine has no authentication. Keep it on 127.0.0.1 unless an
# authenticating reverse proxy sits in front of it.
#KITESURF_ENGINE_HOST=127.0.0.1

# Let pages load localhost and LAN addresses (local dev servers).
#KITESURF_ALLOW_PRIVATE_NETWORK=1

# V8 flags for workerd. Keep --expose-gc if you change this.
#MINIFLARE_WORKERD_V8_FLAGS=--expose-gc
