post_install() {
    cat <<'EOF'
==> Aqueous installed (NativeAOT build -- no .NET runtime required).

    Select 'Aqueous' from your display manager's session list (sddm, ly,
    tuigreet/greetd), or install 'aqueous-greetd-config' (or apply
    packaging/greetd/config.toml.example) for a preconfigured
    greetd + tuigreet setup.

    The output daemon (aqueous-outputd) drives wlr-randr from inside
    River's control context. It is started automatically by
    /usr/bin/aqueous-init at session start, which also applies the
    persisted display configuration before Aqueous draws its first
    frame (this is what makes the screen come up at the right
    resolution under greetd). To run it as a systemd user service
    instead:
        systemctl --user daemon-reload
        systemctl --user enable --now aqueous-outputd.service
    Requires the 'wlr-randr' package.

    The graphical session is brought up via aqueous-session.target (a
    wrapper that activates the static graphical-session.target) so that
    xdg-desktop-portal.service -- which has Requisite=graphical-session.target
    -- can start. This is what makes flameshot/screencast/screenshots work.
    It is started automatically by /usr/bin/aqueous-init at session start;
    no manual 'enable' is needed. Run 'systemctl --user daemon-reload' once
    so the new unit is picked up without a relogin.

    Per-user state/cache/config directories will be created at first
    login by systemd-tmpfiles --user.

    Logs:
        journalctl --user -u aqueous-outputd -f
        tail -f ~/.local/state/river/river.log
EOF
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/aqueous.conf >/dev/null 2>&1 || true
}

post_upgrade() {
    local old_ver="$2"
    echo "==> Aqueous upgraded from ${old_ver:-unknown}."
    echo "    Reload user units (picks up aqueous-session.target, which now"
    echo "    activates graphical-session.target so xdg-desktop-portal can"
    echo "    start) and restart the output daemon:"
    echo "        systemctl --user daemon-reload"
    echo "        systemctl --user try-restart aqueous-outputd.service"
    echo "    The session target takes effect on your next login."
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/aqueous.conf >/dev/null 2>&1 || true
}

pre_remove() {
    # Best-effort stop of running per-user instances.
    if command -v loginctl >/dev/null 2>&1; then
        for u in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
            local uid
            uid=$(id -u "$u" 2>/dev/null) || continue
            sudo -u "$u" XDG_RUNTIME_DIR="/run/user/$uid" \
                systemctl --user stop aqueous-outputd.service 2>/dev/null || true
        done
    fi
}

post_remove() {
    cat <<'EOF'
==> Aqueous removed.

    Per-user state was left in place:
        ~/.cache/aqueous
        ~/.config/aqueous
        ~/.local/state/aqueous
        ~/.local/state/river

    Delete manually if no longer wanted.
EOF
}
