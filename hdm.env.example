# amdgpu-fan-ctl-bmc 的 BMC 密码文件（示例）
#
# 用法：
#   sudo install -m 0600 /dev/null /etc/amdgpu-fan-ctl-bmc/hdm.env
#   sudo sh -c 'printf "IPMI_PASSWORD=你的BMC密码\n" > /etc/amdgpu-fan-ctl-bmc/hdm.env'
#
# systemd 通过 amdgpu-fan-ctl-bmc.service 里的 EnvironmentFile= 把它注入进环境，
# 所以密码不会出现在 config.toml、进程参数或 `systemctl show` 里。
#
# 变量名必须和 /etc/amdgpu-fan-ctl-bmc/config.toml 里 [bmc] password_env 的值一致
# （默认就是 IPMI_PASSWORD）。
IPMI_PASSWORD=changeme
