msg() {
  echo -e "\033[1;31m==> WARNING: This package now provides the native Linux version of HeidiSQL.\033[0m"
  echo -e "To copy your settings click on File > Import settings and select /home/$USER/.heidisql/portable_settings.txt"
  echo -e "There is also the old version available as heidisql-wine."

  echo -e "\033[31mheidisql-debug is installed too. If you don't need it, you can remove it with the following command:\033[0m"
  echo -e "\033[32m  sudo pacman -R heidisql-debug\033[0m"
}

post_upgrade() {
  msg
}
