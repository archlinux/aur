#!/bin/bash

# --- G-HELPER (AUR Partner for APT-Fake) ---
G_PURPLE='\033[1;35m'
G_CYAN='\033[1;36m'
G_GREEN='\033[1;32m'
G_YELLOW='\033[1;33m'
G_RED='\033[1;31m'
NC='\033[0m'

# Check for arguments
if [ -z "$1" ]; then
    echo -e "${G_PURPLE}G-HELPER v1.0.0${NC} - The AUR assistant"
    echo "Usage: g-helper [package_name]"
    exit 1
fi

PACKAGE=$1

echo -e "${G_CYAN}::${NC} Searching for ${G_YELLOW}$PACKAGE${NC} in AUR..."

# Check if the package exists in AUR
if ! curl -s "https://aur.archlinux.org/rpc/?v=5&type=info&arg[]=$PACKAGE" | grep -q '"resultcount":1'; then
    echo -e "${G_RED}Error:${NC} Package '$PACKAGE' not found in AUR."
    exit 1
fi

echo -e "${G_GREEN}::${NC} Package found! Preparing build directory..."
mkdir -p /tmp/g-helper-build && cd /tmp/g-helper-build

# Clone, Build and Install
if git clone "https://aur.archlinux.org/$PACKAGE.git"; then
    cd "$PACKAGE"
    echo -e "${G_CYAN}::${NC} Starting compilation and installation..."
    makepkg -si --noconfirm
    
    # Cleanup
    cd ..
    rm -rf "$PACKAGE"
    echo -e "${G_GREEN}::${NC} Process finished successfully."
else
    echo -e "${G_RED}Error:${NC} Failed to clone the repository."
    exit 1
fi
