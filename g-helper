#!/bin/bash

# --- G-HELPER v1.3 (Gabriele Edition) ---
G_PURPLE='\033[1;35m'
G_CYAN='\033[1;36m'
G_GREEN='\033[1;32m'
G_RED='\033[1;31m'
NC='\033[0m'

# Funzione di pulizia automatica
cleanup() {
    echo -e "\n${G_CYAN}::${NC} Cleaning up build files..."
    rm -rf "$BUILD_DIR"
}

# Se l'utente preme Ctrl+C, pulisci tutto
trap cleanup EXIT

if [ -z "$1" ]; then
    echo -e "${G_PURPLE}G-HELPER v1.3${NC}"
    echo "Usage: g-helper [package]"
    exit 1
fi

PACKAGE=$1
BUILD_DIR="/tmp/g-helper-$PACKAGE-$(date +%s)"

echo -e "${G_CYAN}::${NC} Starting AUR bridge for: ${G_PURPLE}$PACKAGE${NC}"

mkdir -p "$BUILD_DIR" && cd "$BUILD_DIR"

# Clone con progresso visibile
if git clone --depth 1 "https://aur.archlinux.org/$PACKAGE.git" .; then
    echo -e "${G_GREEN}::${NC} Repository cloned. Building now..."
    
    # Compilazione e installazione
    if makepkg -si --noconfirm; then
        echo -e "${G_GREEN}::${NC} $PACKAGE has been installed successfully."
    else
        echo -e "${G_RED}Error:${NC} Build failed for $PACKAGE."
        exit 1
    fi
else
    echo -e "${G_RED}Error:${NC} Package not found on AUR."
    exit 1
fi
