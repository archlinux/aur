#!/bin/bash

# --- UI Colors & Styles ---
G_PURPLE='\033[1;35m'
G_CYAN='\033[1;36m'
G_GREEN='\033[1;32m'
G_RED='\033[1;31m'
G_YELLOW='\033[1;33m'
NC='\033[0m' # No Color

pkg=$1

if [ -z "$pkg" ]; then
    echo -e "${G_RED}Error:${NC} No package specified."
    echo -e "Usage: g-helper <package_name>"
    exit 1
fi

# --- Header ---
echo -e "${G_PURPLE}┌────────────────────────────────────────────────────────┐${NC}"
echo -e "${G_PURPLE}│${NC}  ${G_CYAN}G-HELPER${NC} - The Superior AUR Architect                ${G_PURPLE}│${NC}"
echo -e "${G_PURPLE}└────────────────────────────────────────────────────────┘${NC}"

# --- API Metadata Fetching ---
echo -e "${G_CYAN}::${NC} Fetching AUR metadata for ${G_YELLOW}$pkg${NC}..."
info=$(curl -s "https://aur.archlinux.org/rpc/v5/info?arg[]=$pkg")
exists=$(echo "$info" | jq -r '.resultcount')

if [ "$exists" -eq "0" ]; then
    echo -e "${G_RED}![ERROR]!${NC} Package '${G_YELLOW}$pkg${NC}' not found in AUR."
    exit 1
fi

description=$(echo "$info" | jq -r '.results[0].Description')
version=$(echo "$info" | jq -r '.results[0].Version')
popularity=$(echo "$info" | jq -r '.results[0].Popularity')

echo -e "${G_CYAN}  > Version:${NC} $version"
echo -e "${G_CYAN}  > Popularity:${NC} $popularity"
echo -e "${G_CYAN}  > Description:${NC} $description"

# --- Security Audit ---
echo -e "\n${G_PURPLE}::${NC} Cloning and auditing PKGBUILD..."
build_dir="/tmp/g-helper-$USER"
mkdir -p "$build_dir"
cd "$build_dir" || exit

# Clean old builds
rm -rf "$pkg"
git clone "https://aur.archlinux.org/$pkg.git" &> /dev/null
cd "$pkg" || exit

echo -e "${G_CYAN}::${NC} Scanning for dangerous commands..."
if grep -E "rm -rf /|curl.*sh|wget.*sh|root" PKGBUILD; then
    echo -e "${G_RED}![SECURITY WARNING]!${NC} Suspicious patterns detected in PKGBUILD!"
    read -p "Do you want to proceed at your own risk? (y/N): " confirm
    [[ "$confirm" != "y" ]] && exit 1
else
    echo -e "${G_GREEN}  > PKGBUILD looks clean.${NC}"
fi

# --- Build Process ---
echo -e "\n${G_GREEN}::${NC} Starting professional build with all cores..."
export MAKEFLAGS="-j$(nproc)"
makepkg -sic --noconfirm --skipchecksums

echo -e "\n${G_GREEN}::${NC} Process finished successfully.${NC}"
