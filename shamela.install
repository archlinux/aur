post_install() {
    _install_path=$(cat /usr/share/shamela-bin.conf)
    
    chmod -R 777 "$_install_path"
    
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
    update-desktop-database -q
}

post_upgrade() {
    post_install
}

post_remove() {
    _install_path=$(cat /usr/share/shamela-bin.conf)
    
    if [ -d "$_install_path" ]; then
        rm -rf "$_install_path"
    fi
    
    rm -f /usr/share/shamela-bin.conf
    
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
    update-desktop-database -q
}