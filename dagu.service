[Unit]
Description=Dagu Workflow Engine
Documentation=https://github.com/dagucloud/dagu
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=dagu
Group=dagu
WorkingDirectory=/var/lib/dagu
StateDirectory=dagu
CacheDirectory=dagu
Environment=DAGU_HOME=/var/lib/dagu
Environment=XDG_CACHE_HOME=/var/cache/dagu
Environment=DAGU_DEFAULT_SHELL=/bin/bash
ExecStart=/usr/bin/dagu start-all
EnvironmentFile=-/etc/dagu/dagu.env
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
