post_install() {
    echo ""
    echo "==> GleamObserver v1.5.2 installed successfully!"
    echo ""
    echo "==> System tray daemon (libappindicator - compatible with DWM, i3, XFCE):"
    echo "    systemctl --user enable --now gleam-observer"
    echo ""
    echo "==> Desktop launcher installed - search 'GleamObserver' in rofi/dmenu"
    echo ""
    echo "==> Or run TUI manually:"
    echo "    gleam"
    echo ""
    echo "==> Config file:"
    echo "    ~/.config/gleam_observer/config.toml"
    echo "    (example: /usr/share/doc/gleam-observer/config-example.toml)"
    echo ""
}

post_upgrade() {
    post_install
}

pre_remove() {
    if systemctl --user is-active gleam-observer &>/dev/null; then
        echo "==> Stopping gleam-observer service..."
        systemctl --user stop gleam-observer
    fi
    if systemctl --user is-enabled gleam-observer &>/dev/null; then
        echo "==> Disabling gleam-observer service..."
        systemctl --user disable gleam-observer
    fi
}

post_remove() {
    echo "==> GleamObserver removed. Config files in ~/.config/gleam_observer/ were kept."
}
