#!/usr/bin/env bash
# sqlch-release.sh — Automate AUR-compliant release pipeline

set -euo pipefail

### Configurable metadata
PKGNAME=sqlch-suite
VERSION=0.1.1
REPO_DIR=~/aur/sqlch-suite
SRC_DIR=$REPO_DIR/sqlch-suite
TARBALL=${PKGNAME}-${VERSION}.tar.gz
TAG=v${VERSION}
GH_REPO="SW-philip/sqlch-suite"

cd "$REPO_DIR"

# 1. Build tarball with transform for correct top-level folder
rm -f "$TARBALL"
tar --exclude='.git' -czf sqlch-suite-0.1.1.tar.gz sqlch-suite \
  --transform="s,^sqlch-suite,sqlch-suite-0.1.1,"
echo "✅ Created tarball: $TARBALL"

# 2. Upload to GitHub release
if ! gh release view "$TAG" &>/dev/null; then
  gh release create "$TAG" "$TARBALL" --title "$TAG" --notes "Auto release of $PKGNAME $VERSION"
else
  gh release upload "$TAG" "$TARBALL" --clobber
fi

echo "✅ Uploaded tarball to GitHub release: $TAG"

# 3. Get new sha256 checksum
CHECKSUM=$(sha256sum "$TARBALL" | cut -d ' ' -f1)
echo "✅ Checksum: $CHECKSUM"

# 4. Update PKGBUILD
sed -i \
  -e "s|^pkgver=.*|pkgver=$VERSION|" \
  -e "s|^source=.*|source=(\"https://github.com/$GH_REPO/releases/download/$TAG/$TARBALL\")|" \
  -e "s|^sha256sums=.*|sha256sums=(\'$CHECKSUM\')|" \
  PKGBUILD

echo "✅ Updated PKGBUILD with version, source, and checksum"

# 5. Regenerate .SRCINFO
makepkg --printsrcinfo > .SRCINFO
echo "✅ Regenerated .SRCINFO"

# 6. Git commit and push
git add PKGBUILD .SRCINFO
if git diff --cached --quiet; then
  echo "🟡 Nothing to commit. Already up to date."
else
  git commit -m "release: $VERSION"
  git push origin master
  echo "🚀 Pushed to AUR repo"
fi

echo "🎉 Done. $PKGNAME $VERSION released."
