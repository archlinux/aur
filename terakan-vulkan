#!/usr/bin/env bash
set -euo pipefail

icd=/usr/share/vulkan/icd.d/terascale_icd.x86_64.json
driver=/usr/lib/libvulkan_terascale.so

if [[ ! -r "$icd" || ! -r "$driver" ]]; then
  echo "terakan-vulkan: install vulkan-ai-terakan first" >&2
  exit 1
fi
if (($# == 0)); then
  echo "usage: terakan-vulkan COMMAND [ARG ...]" >&2
  exit 2
fi

export VK_DRIVER_FILES="$icd"
export VK_ICD_FILENAMES="$icd"
exec "$@"
