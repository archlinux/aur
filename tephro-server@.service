# systemd template for more instances beside the one tephro-server.service
# runs: tephro-server@NAME keeps its instance in /var/lib/tephro/NAME. Install
# it beside the other unit:
#
#   install -m 0644 tephro-server@.service /etc/systemd/system/
#
# Each instance needs its own address, since every one takes TCP and UDP 443:
# a second public IP on the machine, set before the first start.
#
#   sudo -u tephro tephro-server admin config set listen 203.0.113.7:443 --data-dir /var/lib/tephro/NAME
#   systemctl enable --now tephro-server@NAME
#
# No TEPHRO_LISTEN here, so each instance's tephro.toml decides. The rest is
# tephro-server.service; docs/HOSTING.md has the whole procedure.

[Unit]
Description=Tephro server (%i)
Documentation=https://gitlab.com/encenillo/tephro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tephro
Group=tephro
Environment=TEPHRO_DATA_DIR=/var/lib/tephro/%i
ExecStart=/usr/local/bin/tephro-server serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=tephro/%i
StateDirectoryMode=0700
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
