post_install() {
  grep -qx /bin/reshell /etc/shells || echo /bin/reshell >>/etc/shells
  grep -qx /usr/bin/reshell /etc/shells || echo /usr/bin/reshell >>/etc/shells
}

post_upgrade() {
  post_install
}

post_remove() {
  sed -i -r '/^(\/usr)?\/bin\/reshell$/d' etc/shells
}

