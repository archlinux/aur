[Unit]
Description=SOGo 6 groupware API server
Documentation=https://www.sogo.nu/files/docs/v6/
# Ordered after the services SOGo may use on the same host, if they're there
After=network.target postgresql.service mariadb.service valkey.service redis.service slapd.service dovecot.service postfix.service
Wants=sogo6-agent.service sogo6-agent-beat.service

[Service]
Type=exec
User=sogo6
Group=sogo6
# The settings, as the environment: they take precedence over /etc/sogo/process.conf, which SOGo
# reads itself, and SOGO_AES_ENC_KEY is only read from the environment
EnvironmentFile=/etc/sogo6/process.conf
ExecStartPre=/usr/lib/sogo6-server/check-settings
WorkingDirectory=/var/lib/sogo6
# Upstream's gunicorn configuration (deploy/local/Dockerfile.local), its bind address, workers and
# log level from GUNICORN_BIND, GUNICORN_WORKERS and GUNICORN_LOGLEVEL; the log goes to the journal
ExecStart=/usr/bin/gunicorn -c /usr/share/sogo6-server/app/gunicorn.conf.py --chdir /usr/share/sogo6-server app.run:app
Restart=on-failure

# Hardening: the server only writes its state directory (the scheduler's state) and its private
# /tmp; the rest of the system is read-only to it
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sogo6
ProtectProc=invisible
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
