post_install() {
    # Refresh desktop + icon caches (no-op if gtk-update-icon-cache absent)
    xdg-desktop-menu forceupdate &>/dev/null || true
    echo ":: traycer-desktop installed. Launch from the app menu or run 'traycer-desktop'."
}

post_upgrade() {
    post_install "$1"
}

post_remove() {
    xdg-desktop-menu forceupdate &>/dev/null || true
    echo ":: User config lives in ~/.config/Traycer — remove manually if desired."
}
