_PPD_CONF=/etc/tuned/ppd.conf
_BACKUP=/etc/tuned/ppd.conf.gpdwinmini.bak

post_install() {
  _configure_ppd_conf
  _enable_services
  _print_post_install_msg
}

post_upgrade() {
  _configure_ppd_conf
  _restart_services
}

post_remove() {
  if [ -f "${_BACKUP}" ]; then
    mv -f "${_BACKUP}" "${_PPD_CONF}"
    systemctl restart tuned-ppd.service 2>/dev/null || true
    echo "==> Restored ${_PPD_CONF} from ${_BACKUP}"
  fi
}

_configure_ppd_conf() {
  [ -f "${_PPD_CONF}" ] || return 0
  if grep -q 'gpd-win-mini-balanced' "${_PPD_CONF}" 2>/dev/null; then
    return 0
  fi
  cp -p "${_PPD_CONF}" "${_BACKUP}"
  cat > "${_PPD_CONF}" <<'EOF'
[main]
default = balanced
battery_detection = false

[profiles]
power-saver = gpd-win-mini-power-saver
balanced = gpd-win-mini-balanced
performance = gpd-win-mini-performance
EOF
  echo "==> Wrote ${_PPD_CONF} (previous saved to ${_BACKUP})"
}

_enable_services() {
  systemctl enable --now tuned.service 2>/dev/null || true
  systemctl reset-failed tuned-ppd.service 2>/dev/null || true
  systemctl restart tuned-ppd.service 2>/dev/null || true
}

_restart_services() {
  systemctl is-active --quiet tuned.service && \
    systemctl restart tuned.service 2>/dev/null || true
  systemctl reset-failed tuned-ppd.service 2>/dev/null || true
  systemctl is-active --quiet tuned-ppd.service && \
    systemctl restart tuned-ppd.service 2>/dev/null || true
}

_print_post_install_msg() {
  cat <<'EOF'

==> GPD Win Mini TDP profiles installed:
==>     gpd-win-mini-power-saver  (8W)
==>     gpd-win-mini-balanced    (15W)
==>     gpd-win-mini-performance (20W)
==>
==> /etc/tuned/ppd.conf has been wired to these profiles. Your KDE/GNOME
==> power-profile selector now drives the GPD TDP. Verify with:
==>     tuned-adm active
==>     systemctl status tuned-ppd
==>
==> If TDP control isn't working, ensure /proc/acpi/call is writable
==> (acpi_call module loaded).
EOF
}
