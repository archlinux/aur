post_install() {
    echo "==> RDiskInfo installed at /usr/bin/rdiskinfo (desktop entry + Polkit policy included)."
    echo "==> Run 'rdiskinfo' for the GUI, or 'rdiskinfo --cli' / 'rdiskinfo --json' in a terminal."
    echo "==> Tip: If you previously ran an unpackaged build, remove ~/.local/share/applications/rdiskinfo.desktop"
    echo "         so the system desktop entry (/usr/share/applications/rdiskinfo.desktop) takes effect."
}

post_upgrade() {
    post_install
}
