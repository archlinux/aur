+/* sum of absolute neighbour differences: higher means sharper ridges */
+static guint64
+elan_frame_sharpness (FpiDeviceElan *self, const unsigned short *f)
+{
+  guint64 s = 0;
+
+  for (int y = 0; y < self->frame_height - 1; y++)
+    for (int x = 0; x < self->frame_width - 1; x++)
+      {
+        int i = x + y * self->frame_width;
+        s += ABS (f[i + 1] - f[i]) + ABS (f[i + self->frame_width] - f[i]);
+      }
+  return s;
+}
+
+/* std dev of column means over std dev of all pixels: close to 1 for the
+ * vertical stripe noise some empty captures produce, well below for ridges */
+static double
+elan_stripe_ratio (const guint8 *px, int w, int h)
+{
+  double mean = 0, var = 0, cvar = 0;
+
+  for (int i = 0; i < w * h; i++)
+    mean += px[i];
+  mean /= w * h;
+  for (int i = 0; i < w * h; i++)
+    var += (px[i] - mean) * (px[i] - mean);
+
+  for (int x = 0; x < w; x++)
+    {
+      double c = 0;
+      for (int y = 0; y < h; y++)
+        c += px[x + y * w];
+      c = c / h - mean;
+      cvar += c * c;
+    }
+
+  if (var == 0)
+    return 1;
+  return sqrt ((cvar / w) / (var / (w * h)));
+}
+
+/* Press mode: the finger rests still on a square sensor, so stitching frames
+ * by estimated motion only produces garbage. Submit the sharpest settled frame. */
+static void
+elan_submit_press_image (FpImageDevice *dev)
+{
+  FpiDeviceElan *self = FPI_DEVICE_ELAN (dev);
+  unsigned int frame_size = self->frame_width * self->frame_height;
+  g_autoptr(FpImage) img = NULL;
+  unsigned short *best = NULL;
+  guint64 best_sharpness = 0;
+  GSList *frames = NULL;
+  struct fpi_frame *frame;
+  double stripes;
+  int n = 0;
+
+  G_DEBUG_HERE ();
+
+  /* runs while the finger is still down; self->frames is newest first, so
+   * the skipped landing frames are at the tail */
+  for (GSList *l = self->frames;
+       l && n < self->num_frames - ELAN_PRESS_SKIP_FRAMES;
+       l = l->next, n++)
+    {
+      guint64 s = elan_frame_sharpness (self, l->data);
+
+      if (s > best_sharpness)
+        {
+          best_sharpness = s;
+          best = l->data;
+        }
+    }
+
+  assembling_ctx.frame_width = self->frame_width;
+  assembling_ctx.frame_height = self->frame_height;
+  self->process_frame (best, &frames);
+  frame = frames->data;
+
+  img = fp_image_new (self->frame_width, self->frame_height);
+  memcpy (img->data, frame->data, frame_size);
+  g_slist_free_full (frames, g_free);
+
+  stripes = elan_stripe_ratio (img->data, img->width, img->height);
+  fp_dbg ("press image: sharpest of %d frames (%" G_GUINT64_FORMAT "), stripe ratio %.2f",
+          n, best_sharpness, stripes);
+  if (stripes > ELAN_PRESS_MAX_STRIPE_RATIO)
+    {
+      fpi_image_device_retry_scan (dev, FP_DEVICE_RETRY_CENTER_FINGER);
+      return;
+    }
+
+  img->flags |= FPI_IMAGE_PARTIAL;
+  fpi_image_device_image_captured (dev, g_steal_pointer (&img));
+}
+
+/* SIGFM data for one capture, stored as a one-element "aay" RAW print so
+ * fpi_print_add_print() can collect every enroll capture */
+static gboolean
+elan_sigfm_img_to_print (FpImageDevice *dev, FpImage *image,
+                         FpPrint *print, GError **error)
+{
+  SigfmImgInfo *info = sigfm_extract (image->data, image->width, image->height);
+  GVariantBuilder builder;
+  unsigned char *blob;
+  int kp, len;
+
+  if (!info)
+    {
+      *error = fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL, "SIGFM extraction failed");
+      return FALSE;
+    }
+
+  kp = sigfm_keypoints_count (info);
+  fp_dbg ("sigfm keypoints: %d", kp);
+  if (kp < ELAN_SIGFM_MIN_KEYPOINTS)
+    {
+      sigfm_free_info (info);
+      *error = fpi_device_retry_new (FP_DEVICE_RETRY_CENTER_FINGER);
+      return FALSE;
+    }
+
+  blob = sigfm_serialize_binary (info, &len);
+  sigfm_free_info (info);
+  if (!blob)
+    {
+      *error = fpi_device_retry_new_msg (FP_DEVICE_RETRY_GENERAL, "SIGFM serialization failed");
+      return FALSE;
+    }
+
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+  g_variant_builder_add_value (&builder,
+                               g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, blob, len, 1));
+  g_object_set (print, "fpi-data", g_variant_builder_end (&builder), NULL);
+  free (blob);
+  return TRUE;
+}
+
+/* load the i-th SIGFM blob of a RAW print; NULL when out of range */
+static SigfmImgInfo *
+elan_sigfm_nth (GVariant *data, gsize i)
+{
+  g_autoptr(GVariant) child = NULL;
+  const guchar *blob;
+  gsize len;
+
+  if (i >= g_variant_n_children (data))
+    return NULL;
+  child = g_variant_get_child_value (data, i);
+  blob = g_variant_get_fixed_array (child, &len, 1);
+  return sigfm_deserialize_binary (blob, len);
+}
+
+/* best score of the scan against any enrolled capture */
+static FpiMatchResult
+elan_sigfm_match (FpImageDevice *dev, FpPrint *template,
+                  FpPrint *print, GError **error)
+{
+  g_autoptr(GVariant) tdata = NULL;
+  g_autoptr(GVariant) pdata = NULL;
+  SigfmImgInfo *probe;
+  int best = 0;
+
+  g_object_get (template, "fpi-data", &tdata, NULL);
+  g_object_get (print, "fpi-data", &pdata, NULL);
+
+  /* prints enrolled before this patch are NBIS and carry no SIGFM data */
+  if (!tdata || !g_variant_is_of_type (tdata, G_VARIANT_TYPE ("aay")))
+    {
+      fp_warn ("stored print has no SIGFM data, re-enroll this finger");
+      return FPI_MATCH_FAIL;
+    }
+
+  probe = elan_sigfm_nth (pdata, 0);
+  if (!probe)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID, "Bad SIGFM probe");
+      return FPI_MATCH_ERROR;
+    }
+
+  for (gsize i = 0; i < g_variant_n_children (tdata); i++)
+    {
+      SigfmImgInfo *enrolled = elan_sigfm_nth (tdata, i);
+      int score;
+
+      if (!enrolled)
+        continue;
+      score = sigfm_match_score (enrolled, probe);
+      sigfm_free_info (enrolled);
+      best = MAX (best, score);
+      if (best >= ELAN_SIGFM_THRESHOLD)
+        break;
+    }
+  sigfm_free_info (probe);
+
+  fp_dbg ("sigfm best score %d/%d", best, ELAN_SIGFM_THRESHOLD);
+  return best >= ELAN_SIGFM_THRESHOLD ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL;
+}
