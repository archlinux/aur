post_install() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable --now netexpertssupport.service
    fi
    printf '%s\n' 'NetExperts staff login is enabled by default. A saved No is preserved.'
    printf '%s\n' 'You can change this in Settings; the password shown on your screen still allows access.'
}

post_upgrade() {
    if [ "$(vercmp "$2" '1.5.1-1')" -lt 0 ]; then
        post_install
    elif [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl try-restart netexpertssupport.service
    fi
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl disable --now netexpertssupport.service
    fi
}
