post_install() {
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable --now netexpertssupport.service
    fi
    printf '%s\n' 'Open NetExperts Support to choose whether NetExperts administrators may log in automatically.'
    printf '%s\n' 'Staff-password access is off until you make that first-run choice.'
}

post_upgrade() {
    if [ "$(vercmp "$2" '1.5.1-1')" -lt 0 ]; then
        post_install
    elif [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl try-restart netexpertssupport.service
    fi
}

pre_remove() {
    if [ -d /run/systemd/system ]; then
        systemctl disable --now netexpertssupport.service
    fi
}
