post_install() {
  cat <<'EOF'
==> Default configuration template:
    /usr/share/openmemory/openmemory.env.example
    To customize (recommended), copy it to:
    ~/.config/openmemory/openmemory.env

==> To enable and start the OpenMemory backend (user service):
    systemctl --user daemon-reload
    systemctl --user enable --now openmemory-backend.service

==> Logs:
    journalctl --user -u openmemory-backend.service -f
EOF
}

post_upgrade() {
  post_install
}
