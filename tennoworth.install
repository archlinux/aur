# Arch equivalent of companion/tennoworth-desktop/scripts/postinstall.sh —
# keep the two behaviourally identical. See that file for why the capability
# is needed at all; the short version is that the inventory scan reads
# /proc/<pid>/mem and kernel.yama.ptrace_scope=1 (the usual default) refuses a
# non-descendant tracer without CAP_SYS_PTRACE.
#
# post_upgrade re-runs post_install because pacman replaces the binary, and
# replacing a file clears its capabilities.

_grant_ptrace() {
  local bin=/usr/bin/tennoworth-desktop

  [ -x "$bin" ] || return 0

  if ! command -v setcap >/dev/null 2>&1; then
    echo "==> TennoWorth: 'setcap' not found (install libcap), then run:"
    echo "      sudo setcap cap_sys_ptrace=eip $bin"
    return 0
  fi

  if ! setcap cap_sys_ptrace=eip "$bin" 2>/dev/null; then
    echo "==> TennoWorth: could not set cap_sys_ptrace on $bin."
    echo "    Inventory scanning will fail until this succeeds:"
    echo "      sudo setcap cap_sys_ptrace=eip $bin"
  fi
}

post_install() {
  _grant_ptrace
}

post_upgrade() {
  _grant_ptrace
}
