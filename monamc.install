post_install() {
    echo ""
    echo "  MonaMC -- A TUI Minecraft Launcher"
    echo "  Developed by Berke Oruc"
    echo "  In memory of Mona"
    echo ""
    echo "  Run 'monamc' from your terminal to start the launcher."
    echo ""
    echo "  Dependencies: Java 17+ required for modern Minecraft versions."
    echo "  Install java-runtime with: sudo pacman -S jre-openjdk"
    echo ""
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "Removing MonaMC..."
    echo "Your instances, mods, and skins are kept at ~/.config/monamc/"
    echo "To completely remove all data, run: rm -rf ~/.config/monamc/"
}
