post_install() {
	cat <<'MSG'
==> rayshot installed together with its GNOME extension.
==> On GNOME: log out and back in, then run AS YOUR USER (not as root):
==>     rayshot install-hotkey Print
==> Other desktops: bind a key to `rayshot` in your keyboard settings.
MSG
}

post_upgrade() {
	if [ "$(vercmp "$2" 0.2.0)" -lt 0 ]; then
		cat <<'MSG'
==> rayshot no longer runs a background daemon; a GNOME extension replaces it.
MSG
		post_install
	else
		echo "==> On GNOME, log out and back in to load the updated extension."
	fi
}

post_remove() {
	cat <<'MSG'
==> rayshot removed. If you ran `rayshot install-hotkey Print` and did not run
==> `rayshot uninstall-hotkey` first, give Print back to GNOME as your user:
==>     gsettings reset org.gnome.shell.keybindings show-screenshot-ui
MSG
}
