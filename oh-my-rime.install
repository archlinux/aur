post_install() {
  echo -e "------------------------------------------------------------------"
  echo -e "\n\e[1;32m===> 薄荷輸入法 (oh-my-rime) 安裝完成！\e[0m"
  echo -e "\e[1;34m[快速配置指令]\e[0m"
  echo -e "請根據您使用的輸入法框架，選擇對應的命令執行：\n"
  echo -e "\e[1m對於 Fcitx5 使用者：\e[0m"
  echo -e "\e[33mmkdir -p ~/.local/share/fcitx5/rime && echo -e \"patch:\\n  __include: oh_my_rime_suggestion:/\" > ~/.local/share/fcitx5/rime/default.custom.yaml\e[0m\n"
  echo -e "\e[1m對於 IBus 使用者：\e[0m"
  echo -e "\e[33mmkdir -p ~/.config/ibus/rime && echo -e \"patch:\\n  __include: oh_my_rime_suggestion:/\" > ~/.config/ibus/rime/default.custom.yaml\e[0m\n"
  echo -e "\e[1;31m注意：\e[0m"
  echo -e "1. 如果您原本已有 default.custom.yaml，執行上述命令會\e[1m覆蓋\e[0m它。建議手動編輯加入 patch。"
  echo -e "2. 配置完成後，請務必點擊工作列圖示並選擇 \e[1;32m「重新佈署 (Deploy)」\e[0m 才能讀取薄荷設定。"
  echo -e "------------------------------------------------------------------"
}
