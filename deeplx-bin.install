post_install() {
	cat <<EOF
Use systemd to manage the service:
  sudo systemctl enable deeplx
  sudo systemctl start deeplx
  sudo systemctl edit deeplx # Customize the service, e.g., override ExecStart to pass additional arguments

The default listening address is http://0.0.0.0:1188
EOF
}

post_upgrade() {
	post_install
}
