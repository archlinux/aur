post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;36m  shorin-contrib 安装完成！\e[0m"
    echo ""
    echo -e "  要免shorin前缀运行命令 (如 clean, pac, quickload)，"
    echo -e "  请在终端以\e[1;33m普通用户身份\e[0m执行以下命令生成本地软链接："
    echo ""
    echo -e "\e[1;33m    shorin link\e[0m"
    echo ""
    echo -e "  (注意：请确保 ~/.local/bin 已加入你的 PATH 环境变量)"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;36m  shorin-contrib 已更新\e[0m"
    echo ""
    echo -e "  pac / pacr / pacrrr 已拆分到独立软件包 \e[1;33mshorin-pac\e[0m（已作为依赖自动安装）。"
    echo -e "  shorin pac、shorin pacr 用法不变；pacrrr 已并入 pacr。"
    echo ""
    echo -e "  之前运行过 shorin link 的用户，请以\e[1;33m普通用户身份\e[0m重新执行一次（会清理失效的旧链接）："
    echo ""
    echo -e "\e[1;33m    shorin link\e[0m"
    echo ""
    echo -e "  否则 ~/.local/bin 里旧的 pac / pacr 链接会失效。"
    echo -e "\e[1;32m=================================================================\e[0m"
}
