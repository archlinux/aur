post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;36m  shorin-contrib 安装完成！\e[0m"
    echo ""
    echo -e "  要免shorin前缀运行命令 (如 clean, pac, quickload)，"
    echo -e "  请在终端以\e[1;33m普通用户身份\e[0m执行以下命令生成本地软链接："
    echo ""
    echo -e "\e[1;33m    shorin link\e[0m"
    echo ""
    echo -e "  (注意：请确保 ~/.local/bin 已加入你的 PATH 环境变量)"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    post_install
}
