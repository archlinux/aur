pre_install() {
	cat <<'EOF'
This software is subject to the NXP Software License Agreement (LA_OPT_NXP_Software_License),
which is accepted when downloading the installer from NXP's website.
A copy is installed to /usr/share/licenses/config-tools-for-imx/LICENSE.
EOF
}

post_install() {
	cat <<'EOF'
Config Tools for i.MX are installed under /opt/nxp/ and available from the application menu.
udev rules granting access to NXP/FTDI USB debug adapters are in /usr/lib/udev/rules.d/.
Replug the device after install.
EOF
}

post_upgrade() {
	post_install
}
