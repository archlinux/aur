Copy ifail without indexing one past its end. When all n eigenvalues are
found (nfound == n), &ifail_[ nfound_ ] indexes past the end of ifail_,
which _GLIBCXX_ASSERTIONS (part of Arch's CXXFLAGS) aborts on, so
heevx, hpevx, hbevx, hegvx, hpgvx, hbgvx and the other ?evx/?gvx/stemr
wrappers crash for range=All or a value range holding every eigenvalue.

diff --git a/src/hbevx.cc b/src/hbevx.cc
index 393f3c6..8cb0b23 100644
--- a/src/hbevx.cc
+++ b/src/hbevx.cc
@@ -68,7 +68,7 @@ int64_t hbevx(
     *nfound = nfound_;
     #ifndef LAPACK_ILP64
         if (jobz != Job::NoVec) {
-            std::copy( &ifail_[ 0 ], &ifail_[ nfound_ ], ifail );
+            std::copy( &ifail_[ 0 ], ifail_.data() + nfound_, ifail );
         }
     #endif
     return info_;
@@ -126,7 +126,7 @@ int64_t hbevx(
     *nfound = nfound_;
     #ifndef LAPACK_ILP64
         if (jobz != Job::NoVec) {
-            std::copy( &ifail_[ 0 ], &ifail_[ nfound_ ], ifail );
+            std::copy( &ifail_[ 0 ], ifail_.data() + nfound_, ifail );
         }
     #endif
     return info_;
