post_install() {
  cat <<EOF
==> capi-shell-mcp ships systemd --user units but doesn't enable them.
==> Enable and start the daemon with:
==>   systemctl --user daemon-reload
==>   systemctl --user enable --now capi-shell-mcp.service capi-shell-mcp-config.path
EOF
}

post_upgrade() {
  post_install
}
