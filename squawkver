#!/usr/bin/env python3

"""
Check whether a new Squawker VPN version is available upstream.

Fetches the latest version from TryHackMe's latest.json endpoint
and compares it with pkgver in the local PKGBUILD.

Intended for use by the AUR package maintainer.
"""

import json
import re
import urllib.error
import urllib.request
from pathlib import Path

LATEST_URL = "https://squawker-vpn.vm.tryhackme.com/latest.json"
PKGBUILD = Path(__file__).resolve().parent / "PKGBUILD"

def get_latest_version():
    request = urllib.request.Request(
        LATEST_URL,
        headers={"User-Agent": "squawkver"},
    )

    with urllib.request.urlopen(request, timeout=10) as response:
        data = json.load(response)

    version = data.get("version")

    if not isinstance(version, str) or not re.fullmatch(
        r"\d+(?:\.\d+)+", version
    ):
        raise ValueError("Upstream returned an invalid version")

    return version


def get_pkgbuild_version():
    content = PKGBUILD.read_text(encoding="utf-8")
    match = re.search(r"^pkgver=(\S+)\s*$", content, re.MULTILINE)

    if not match:
        raise ValueError("Could not find pkgver in PKGBUILD")

    return match.group(1)


def main():
    try:
        latest = get_latest_version()
        current = get_pkgbuild_version()
    except (
        urllib.error.URLError,
        TimeoutError,
        json.JSONDecodeError,
        OSError,
        ValueError,
    ) as error:
        print(f"ERROR: {error}")
        raise SystemExit(1)

    print(f"PKGBUILD version: {current}")
    print(f"Latest upsteam version: {latest}")

    if current == latest:
        print("PKGBUILD is up to date.")
    else:
        print(f"Version mismatch: {current} -> {latest}")
        print("Update pkgver and verify the source URLs and checksums!")


if __name__ == "__main__":
    main()
