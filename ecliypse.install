post_install() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  
  update-desktop-database -q
  
  echo ">>> Ecliypse has been installed."
  echo ">>> If you use an Nvidia GPU, use the 'Ecliypse (Nvidia)' launcher."
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
  update-desktop-database -q
}