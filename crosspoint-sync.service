[Unit]
Description=crosspoint-sync
After=network.target

[Service]
EnvironmentFile=/etc/conf.d/crosspoint-sync
ExecStart=node /usr/lib/crosspoint-sync/dist/index.js
User=crosspoint-sync
WorkingDirectory=/var/lib/crosspoint-sync

LockPersonality=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
RestrictRealtime=true
RestrictSUIDSGID=true

ProtectSystem=strict
ProtectHome=true
ProtectProc=noaccess
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=yes

ReadWritePaths=/var/lib/crosspoint-sync

[Install]
WantedBy=multi-user.target
