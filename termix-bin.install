post_upgrade() {
  if [ "$(vercmp "$2" 26.10.0)" -lt 0 ]; then
    cat <<'MSG'
==> Termix 26.10.0+ cannot start on data from Termix 2.8 or older.
==> If you haven't launched Termix since 2.8, downgrade to termix-bin 2.9.x,
==> start it once, then upgrade again.
==> See https://github.com/Termix-SSH/Termix/releases/tag/v26.10.0
MSG
  fi
}
