#!/bin/bash

if [ ! -d "$HOME"/.anituner ]; then
    mkdir -p "$HOME"/.anituner

    ln -s /usr/share/anituner/AniTuner.exe "$HOME"/.anituner/AniTuner.exe
    ln -s /usr/share/anituner/AniTuner.chm "$HOME"/.anituner/AniTuner.chm
    cp -r /usr/share/anituner/AniTunerPref.xml "$HOME"/.anituner/AniTunerPref.xml
fi

WINEDEBUG=-all wine "$HOME"/.anituner/AniTuner.exe "$@"