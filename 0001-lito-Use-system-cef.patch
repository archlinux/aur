From fe5a6cc7f5e96041cffa74de6c6738adbfd29c87 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Fri, 25 Sep 2026 20:00:02 +0800
Subject: [PATCH] lito: Use system cef

---
 viewer/WebViewer/WebViewer.cpp                                  | 2 +-
 waywallen/WebRenderer/install.lua                               | 2 +-
 waywallen/WebRenderer/web_entry.cpp                             | 2 +-
 .../plugins/org.waywallen.open-wallpaper-engine/install.lua     | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/viewer/WebViewer/WebViewer.cpp b/viewer/WebViewer/WebViewer.cpp
index 2b6af42..7ac332c 100644
--- a/viewer/WebViewer/WebViewer.cpp
+++ b/viewer/WebViewer/WebViewer.cpp
@@ -300,7 +300,7 @@ int main(int argc, char** argv) {
         return 1;
     }
 
-    auto exe_dir = viewer::ExecutableDir(argv[0]);
+    auto exe_dir = rstd::path::PathBuf::from("/usr/lib/cef"_str);
 
     weweb::BrowserHost::InitOptions opts;
     opts.resources_dir = exe_dir.clone();
diff --git a/waywallen/WebRenderer/install.lua b/waywallen/WebRenderer/install.lua
index bd61600..a0fe6f3 100644
--- a/waywallen/WebRenderer/install.lua
+++ b/waywallen/WebRenderer/install.lua
@@ -2,7 +2,7 @@ lito.install({
     artifacts = {
         {
             target = { kind = "bin", name = "waywallen-weweb-renderer" },
-            destination = "lib/weweb/waywallen-weweb-renderer",
+            destination = "bin/weweb/waywallen-weweb-renderer",
             runtime_search = {
                 {
                     external_asset = {
diff --git a/waywallen/WebRenderer/web_entry.cpp b/waywallen/WebRenderer/web_entry.cpp
index 74ef247..ac128f6 100644
--- a/waywallen/WebRenderer/web_entry.cpp
+++ b/waywallen/WebRenderer/web_entry.cpp
@@ -696,7 +696,7 @@ int run(int argc, char** argv) {
     });
 
     // BrowserHost::Init wants resources / locales relative to argv[0].
-    auto                            exe_dir = executable_dir(argv[0]);
+    auto                            exe_dir = rstd::path::PathBuf::from("/usr/lib/cef"_str);
     weweb::BrowserHost::InitOptions ho;
     ho.resources_dir = exe_dir.clone();
     ho.locales_dir   = exe_dir.join("locales"_str);
diff --git a/waywallen/plugins/org.waywallen.open-wallpaper-engine/install.lua b/waywallen/plugins/org.waywallen.open-wallpaper-engine/install.lua
index cab9494..98d4f8b 100644
--- a/waywallen/plugins/org.waywallen.open-wallpaper-engine/install.lua
+++ b/waywallen/plugins/org.waywallen.open-wallpaper-engine/install.lua
@@ -1,7 +1,7 @@
 local bundle_layout = lito.env("OWE_WAYWALLEN_PLUGIN_BUNDLE_LAYOUT") == "ON"
 local plugin = "share/waywallen/plugins/org.waywallen.open-wallpaper-engine"
 local scene_bin = "../../../../bin/waywallen-wescene-renderer"
-local web_bin = "../../../../lib/weweb/waywallen-weweb-renderer"
+local web_bin = "../../../../bin/waywallen-weweb-renderer"
 if bundle_layout then
     plugin = ""
     scene_bin = "bin/waywallen-wescene-renderer"
-- 
2.55.0

