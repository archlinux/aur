From 31bd810d30aa9545ebef0670f457e4b45c403e08 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Thu, 26 Nov 2026 17:00:55 +0800
Subject: [PATCH] lito: Use system cef

---
 cli/web/install.lua           | 2 +-
 cli/web/src/main.cppm         | 2 ++
 cli/web/src/waywallen.cpp     | 1 +
 plugins/waywallen/install.lua | 2 +-
 4 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/cli/web/install.lua b/cli/web/install.lua
index 084e3ef..300bc12 100644
--- a/cli/web/install.lua
+++ b/cli/web/install.lua
@@ -1,4 +1,4 @@
-local web_dir = "bin/weweb"
+local web_dir = "bin"
 local artifact = {
     target = { kind = "bin", name = "owe-web" },
     directory = web_dir,
diff --git a/cli/web/src/main.cppm b/cli/web/src/main.cppm
index 50b70e1..c4ac8de 100644
--- a/cli/web/src/main.cppm
+++ b/cli/web/src/main.cppm
@@ -270,6 +270,8 @@ int RunPreview(int argc, char** argv) {
 #if __is_target_os(linux)
     if (window.backend() == vui::host::WindowBackend::X11)
         opts.ozone_platform = weweb::BrowserHost::OzonePlatform::X11;
+    opts.resources_dir = rstd::path::PathBuf::from("/usr/lib/cef"_str);
+    opts.locales_dir = opts.resources_dir.join("locales"_str);
 #endif
 #if __is_target_os(macos)
     if (auto framework_root = CefFrameworkRoot(exe_dir); ! framework_root.is_empty()) {
diff --git a/cli/web/src/waywallen.cpp b/cli/web/src/waywallen.cpp
index e78def3..66950bd 100644
--- a/cli/web/src/waywallen.cpp
+++ b/cli/web/src/waywallen.cpp
@@ -759,6 +759,7 @@ int run(int argc, char** argv) {
     }
     profile = Some(acquired_profile.unwrap());
     weweb::BrowserHost::InitOptions ho;
+    exe_dir = rstd::path::PathBuf::from("/usr/lib/cef"_str);
     ho.resources_dir = exe_dir.clone();
     ho.locales_dir   = exe_dir.join("locales"_str);
     ho.cache_dir     = PathBuf::from(profile->path());
diff --git a/plugins/waywallen/install.lua b/plugins/waywallen/install.lua
index 483a291..f1b7f59 100644
--- a/plugins/waywallen/install.lua
+++ b/plugins/waywallen/install.lua
@@ -1,7 +1,7 @@
 local bundle_layout = lito.env("OWE_WAYWALLEN_PLUGIN_BUNDLE_LAYOUT") == "ON"
 local plugin = "share/waywallen/plugins/org.waywallen.open-wallpaper-engine"
 local scene_bin = "../../../../bin/owe-scene"
-local web_bin = "../../../../bin/weweb/owe-web"
+local web_bin = "../../../../bin/owe-web"
 if bundle_layout then
     plugin = ""
     scene_bin = "bin/owe-scene"
-- 
2.56.1

