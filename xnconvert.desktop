[Desktop Entry]
Type=Application
Name=XnConvert
GenericName=Batch Image Converter
Exec=xnconvert %F
Icon=xnconvert
Terminal=false
Categories=Graphics;
StartupNotify=true
MimeType=image/bmp;image/gif;image/x-portable-bitmap;image/x-portable-pixmap;image/vnd.adobe.photoshop;image/x-tga;image/x-xbitmap;image/tiff;image/jpeg;image/png;image/vnd.microsoft.icon;image/x-xpixmap;image/svg+xml;
