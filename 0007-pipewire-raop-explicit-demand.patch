+	if (want_stream == impl->want_stream)
+		return 0;
+	if (!want_stream)
+		return activation_deactivate(impl,
+				RAOP_SAFETY_GATE_ACTIVATION, why, false);
+
+	/*
+	 * Publish a fresh closed activation generation before any RTSP work.
+	 * A positive demand acknowledgement is therefore never an implicit
+	 * permission to deliver packets.
+	 */
+	if ((res = safety_gate_invalidate(impl,
+			RAOP_SAFETY_GATE_ACTIVATION, why)) < 0)
+		return res;
+	impl->want_stream = true;
+	if ((res = rtsp_do_connect(impl)) < 0) {
