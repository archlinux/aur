+		if ((res = demand_publish(impl)) < 0) {
+			demand_contract_fail(impl,
+					"can't publish idle RAOP demand state", res);
+			return res;
+		}
+	} else {
+		/*
+		 * Publish positive intent while the transport gate is still
+		 * closed. Only the derived Format && demanded state below may
+		 * begin RTSP activation.
+		 */
+		if ((res = demand_publish(impl)) < 0) {
+			demand_contract_fail(impl,
