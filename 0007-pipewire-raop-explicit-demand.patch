+			demand_contract_fail(impl,
+					"can't republish RAOP demand state", res);
+		return res;
+	case RAOP_DEMAND_STALE:
+		pw_log_debug("ignoring stale RAOP demand sequence %" PRIu64,
+				command->sequence);
+		return 0;
+	case RAOP_DEMAND_DENIED:
+		pw_log_warn("denying RAOP demand sequence %" PRIu64,
+				command->sequence);
