+static int activation_deactivate(struct impl *impl, uint32_t reasons,
+		const char *why, bool force_gate_generation)
+{
+	int first_error = 0, res;
+
+	/*
+	 * Close and drain packet delivery before clearing the cached activation
+	 * decision.
+	 * Continue every fail-closed action even if gate publication fails.
+	 */
+	if (impl->safety_gate_contract &&
+			(force_gate_generation || impl->want_stream) &&
+			(res = safety_gate_invalidate(impl, reasons, why)) < 0)
+		first_error = res;
+	impl->want_stream = false;
+	pw_timer_queue_cancel(&impl->reconnect_timer);
+	impl->reconnect_attempts = 0;
+	if (!impl->ready && (impl->connected || impl->connecting ||
+			impl->handshaking)) {
+		/*
+		 * There is no receiver session we can TEARDOWN yet. Closing the
+		 * RTSP client synchronously cancels pending OPTIONS/auth/ANNOUNCE/
+		 * SETUP callbacks, so an idle acknowledgement cannot be followed
+		 * by an older activation generation advancing to RECORD. It also
+		 * prevents a completed connect from remaining parked indefinitely
+		 * after demand disappeared.
+		 */
+		if ((res = pw_rtsp_client_disconnect(impl->rtsp)) < 0 &&
+				first_error == 0)
+			first_error = res;
+		/*
+		 * disconnect normally emits rtsp_disconnected(), which performs
+		 * this cleanup. Retain an idempotent fallback for an already
+		 * detached RTSP source.
+		 */
+		if (impl->connected || impl->connecting ||
+				impl->handshaking) {
+			impl->connected = false;
+			impl->connecting = false;
+			if (!connection_cleanup(impl) && first_error == 0)
+				first_error = -EIO;
+		}
+	} else if ((res = rtsp_do_teardown(impl)) < 0 &&
+			first_error == 0) {
+		first_error = res;
+	}
+	return first_error;
+}
+
+static int activation_reconcile(struct impl *impl, const char *why)
+{
+	bool want_stream = raop_demand_want_stream(
+			impl->demand_contract, &impl->demand,
+			impl->format_present, impl->activation_failed,
+			impl->destroying);
+	int res;
