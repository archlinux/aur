diff --git a/src/modules/module-raop/demand.c b/src/modules/module-raop/demand.c
new file mode 100644
index 0000000..b514ea8
--- /dev/null
+++ b/src/modules/module-raop/demand.c
@@ -0,0 +1,197 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <spa/utils/json.h>
+#include <spa/utils/string.h>
+
+#include "demand.h"
+
+static bool parse_string(const char *value, int len,
+		char *buffer, size_t size)
+{
+	return len > 0 && spa_json_is_string(value, len) &&
+		spa_json_parse_stringn(value, len, buffer, size) > 0;
+}
+
+static bool decimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (*p == '\0')
+		return false;
+	for (; *p != '\0'; p++)
+		if (*p < '0' || *p > '9')
+			return false;
+	return true;
+}
+
+static bool hexadecimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (strlen(value) != 16)
+		return false;
+	for (; *p != '\0'; p++)
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'f') ||
+		      (*p >= 'A' && *p <= 'F')))
+			return false;
+	return true;
+}
+
+static int parse_command_id(const char *object, int object_len,
+		char *id, size_t size)
+{
+	struct spa_json iter;
+	const char *value;
+	char key[64];
+	bool have_id = false;
+	int len;
+
+	if (spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+	while ((len = spa_json_object_next(&iter, key, sizeof(key),
+			&value)) > 0) {
+		if (!spa_streq(key, "command.id"))
+			continue;
+		if (have_id || !parse_string(value, len, id, size))
+			return -EINVAL;
+		have_id = true;
+	}
+	return len < 0 || !have_id ? -EINVAL : 0;
+}
+
+void raop_demand_state_init(struct raop_demand_state *state,
+		uint64_t nonce)
+{
+	if (state == NULL)
+		return;
+	state->sequence = 0;
+	state->nonce = nonce;
+	state->demanded = false;
+}
+
+enum raop_demand_result raop_demand_validate(
+		const struct raop_demand_state *state,
+		const struct raop_demand_command *command)
+{
+	if (state == NULL || command == NULL || command->sequence == 0 ||
+			command->nonce != state->nonce)
+		return RAOP_DEMAND_DENIED;
+	if (command->sequence == state->sequence)
+		return command->demanded == state->demanded ?
+			RAOP_DEMAND_RETRY :
+			RAOP_DEMAND_STALE;
+	if (state->sequence != UINT64_MAX &&
+			command->sequence == state->sequence + 1)
+		return RAOP_DEMAND_ADVANCE;
+	return command->sequence < state->sequence ?
+		RAOP_DEMAND_STALE :
+		RAOP_DEMAND_DENIED;
+}
+
+void raop_demand_commit(struct raop_demand_state *state,
+		const struct raop_demand_command *command)
+{
+	if (state == NULL || command == NULL)
+		return;
+	state->sequence = command->sequence;
+	state->demanded = command->demanded;
+}
+
+bool raop_demand_want_stream(bool demand_contract,
+		const struct raop_demand_state *state,
+		bool format_present, bool activation_failed, bool destroying)
+{
+	if (!format_present || activation_failed || destroying)
+		return false;
+	return !demand_contract || (state != NULL && state->demanded);
+}
+
+int raop_demand_command_parse(const char *json,
+		struct raop_demand_command *command)
+{
+	struct spa_json top, iter;
+	const char *object, *value;
+	char key[64], id[64], state[16], sequence[32], nonce[19];
+	bool have_id = false, have_state = false;
+	bool have_sequence = false, have_nonce = false;
+	bool have_unknown = false;
+	uint64_t parsed_sequence, parsed_nonce;
+	int object_len, len;
+
+	if (json == NULL || command == NULL)
+		return -EINVAL;
+	spa_json_init(&top, json, strlen(json));
+	object_len = spa_json_next(&top, &object);
+	if (object_len <= 0 || !spa_json_is_object(object, object_len))
+		return -EINVAL;
+	object_len = spa_json_container_len(&top, object, object_len);
+	if (object_len <= 0 ||
+			spa_json_next(&top, &value) != 0 ||
+			parse_command_id(object, object_len,
+				id, sizeof(id)) < 0)
+		return -EINVAL;
+	/*
+	 * User commands share one channel. Decide ownership from command.id
+	 * before validating demand-specific fields, so a future command can use
+	 * a key such as "nonce" with a different representation.
+	 */
+	if (!spa_streq(id, RAOP_DEMAND_COMMAND))
+		return -ENOENT;
+	if (spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+
+	while ((len = spa_json_object_next(&iter, key, sizeof(key),
+			&value)) > 0) {
+		if (spa_streq(key, "command.id")) {
+			if (have_id || !parse_string(value, len, id, sizeof(id)))
+				return -EINVAL;
+			have_id = true;
+		} else if (spa_streq(key, "state")) {
+			if (have_state || !parse_string(value, len,
+					state, sizeof(state)))
+				return -EINVAL;
+			have_state = true;
+		} else if (spa_streq(key, "sequence")) {
+			if (have_sequence || !parse_string(value, len,
+					sequence, sizeof(sequence)))
+				return -EINVAL;
+			have_sequence = true;
+		} else if (spa_streq(key, "nonce")) {
+			if (have_nonce || !parse_string(value, len,
+					nonce, sizeof(nonce)))
+				return -EINVAL;
+			have_nonce = true;
+		} else {
+			have_unknown = true;
+		}
+	}
+	if (len < 0 || !have_id)
+		return -EINVAL;
+	if (!have_state || !have_sequence || !have_nonce || have_unknown ||
+			!decimal_string(sequence) ||
+			!spa_atou64(sequence, &parsed_sequence, 10) ||
+			parsed_sequence == 0)
+		return -EINVAL;
+	if (!hexadecimal_string(nonce) ||
+			!spa_atou64(nonce, &parsed_nonce, 16) ||
+			parsed_nonce == 0)
+		return -EINVAL;
+	if (spa_streq(state, "demanded"))
+		command->demanded = true;
+	else if (spa_streq(state, "idle"))
+		command->demanded = false;
+	else
+		return -EINVAL;
+
+	command->sequence = parsed_sequence;
+	command->nonce = parsed_nonce;
+	return 0;
+}
diff --git a/src/modules/module-raop/demand.h b/src/modules/module-raop/demand.h
new file mode 100644
index 0000000..792cf98
--- /dev/null
+++ b/src/modules/module-raop/demand.h
@@ -0,0 +1,63 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PIPEWIRE_MODULE_RAOP_DEMAND_H
+#define PIPEWIRE_MODULE_RAOP_DEMAND_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define RAOP_EXPLICIT_DEMAND_CONTRACT	"4"
+#define RAOP_DEMAND_CONTRACT		"1"
+#define RAOP_DEMAND_CONTROL		"node-command"
+#define RAOP_DEMAND_COMMAND		"raop-demand-state"
+
+enum raop_demand_result {
+	RAOP_DEMAND_ADVANCE,
+	RAOP_DEMAND_RETRY,
+	RAOP_DEMAND_STALE,
+	RAOP_DEMAND_DENIED,
+};
+
+struct raop_demand_state {
+	uint64_t sequence;
+	uint64_t nonce;
+	bool demanded;
+};
+
+struct raop_demand_command {
+	uint64_t sequence;
+	uint64_t nonce;
+	bool demanded;
+};
+
+void raop_demand_state_init(struct raop_demand_state *state,
+		uint64_t nonce);
+
+enum raop_demand_result raop_demand_validate(
+		const struct raop_demand_state *state,
+		const struct raop_demand_command *command);
+
+void raop_demand_commit(struct raop_demand_state *state,
+		const struct raop_demand_command *command);
+
+bool raop_demand_want_stream(bool demand_contract,
+		const struct raop_demand_state *state,
+		bool format_present, bool activation_failed, bool destroying);
+
+/*
+ * Parse the JSON string carried in SPA_NODE_COMMAND_User's
+ * SPA_COMMAND_NODE_extra property. All four string fields are mandatory:
+ *
+ * {
+ *   "command.id": "raop-demand-state",
+ *   "state": "demanded"|"idle",
+ *   "sequence": "<positive decimal integer>",
+ *   "nonce": "<16 lowercase or uppercase hexadecimal digits>"
+ * }
+ */
+int raop_demand_command_parse(const char *json,
+		struct raop_demand_command *command);
+
+#endif /* PIPEWIRE_MODULE_RAOP_DEMAND_H */
diff --git a/src/modules/module-raop/test-demand.c b/src/modules/module-raop/test-demand.c
new file mode 100644
index 0000000..8db2fef
--- /dev/null
+++ b/src/modules/module-raop/test-demand.c
@@ -0,0 +1,179 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+
+#include <spa/utils/defs.h>
+
+#include "demand.h"
+
+#define TEST_NONCE UINT64_C(0x0123456789abcdef)
+
+static void test_state_machine(void)
+{
+	struct raop_demand_state state;
+	struct raop_demand_command command = {
+		.sequence = 1,
+		.nonce = TEST_NONCE,
+		.demanded = true,
+	};
+
+	raop_demand_state_init(&state, TEST_NONCE);
+	spa_assert_se(state.sequence == 0);
+	spa_assert_se(state.nonce == TEST_NONCE);
+	spa_assert_se(!state.demanded);
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_ADVANCE);
+	raop_demand_commit(&state, &command);
+	spa_assert_se(state.sequence == 1);
+	spa_assert_se(state.demanded);
+
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_RETRY);
+	command.demanded = false;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_STALE);
+
+	command.sequence = 2;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_ADVANCE);
+	raop_demand_commit(&state, &command);
+	spa_assert_se(!state.demanded);
+
+	command.sequence = 1;
+	command.demanded = true;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_STALE);
+	command.sequence = 4;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_DENIED);
+	command.sequence = 3;
+	command.nonce++;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_DENIED);
+	command.nonce = TEST_NONCE;
+	command.sequence = 0;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_DENIED);
+
+	state.sequence = UINT64_MAX;
+	state.demanded = false;
+	command.sequence = UINT64_MAX;
+	command.demanded = false;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_RETRY);
+	command.demanded = true;
+	spa_assert_se(raop_demand_validate(&state, &command) ==
+			RAOP_DEMAND_STALE);
+}
+
+static void test_want_stream(void)
+{
+	struct raop_demand_state state;
+
+	raop_demand_state_init(&state, TEST_NONCE);
+
+	/* Legacy contracts remain Format-driven. */
+	spa_assert_se(raop_demand_want_stream(false, &state,
+			true, false, false));
+	spa_assert_se(!raop_demand_want_stream(false, &state,
+			false, false, false));
+
+	/* Explicit-demand mode requires both Format and positive demand. */
+	spa_assert_se(!raop_demand_want_stream(true, &state,
+			true, false, false));
+	state.demanded = true;
+	spa_assert_se(!raop_demand_want_stream(true, &state,
+			false, false, false));
+	spa_assert_se(raop_demand_want_stream(true, &state,
+			true, false, false));
+
+	/* Fatal state and destruction dominate every other input. */
+	spa_assert_se(!raop_demand_want_stream(true, &state,
+			true, true, false));
+	spa_assert_se(!raop_demand_want_stream(true, &state,
+			true, false, true));
+	spa_assert_se(!raop_demand_want_stream(true, NULL,
+			true, false, false));
+}
+
+static void test_parser(void)
+{
+	struct raop_demand_command command;
+	static const char demanded[] =
+		"{\"command.id\":\"raop-demand-state\","
+		"\"state\":\"demanded\",\"sequence\":\"1\","
+		"\"nonce\":\"0123456789abcdef\"}";
+	static const char idle[] =
+		"{\"command.id\":\"raop-demand-state\","
+		"\"state\":\"idle\",\"sequence\":\"2\","
+		"\"nonce\":\"0123456789ABCDEF\"}";
+
+	spa_assert_se(raop_demand_command_parse(demanded, &command) == 0);
+	spa_assert_se(command.sequence == 1);
+	spa_assert_se(command.nonce == TEST_NONCE);
+	spa_assert_se(command.demanded);
+	spa_assert_se(raop_demand_command_parse(idle, &command) == 0);
+	spa_assert_se(command.sequence == 2);
+	spa_assert_se(command.nonce == TEST_NONCE);
+	spa_assert_se(!command.demanded);
+
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"other\",\"state\":\"demanded\","
+			"\"sequence\":\"3\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -ENOENT);
+	/* Parsers share the User-command channel; another command's schema must
+	 * pass through instead of being misclassified as malformed demand. */
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":\"0123456789abcdef\"}",
+			&command) == -ENOENT);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"nonce\":42,"
+			"\"command.id\":\"future-command\"}",
+			&command) == -ENOENT);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"invalid\",\"sequence\":\"3\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":3,"
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":\"0\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":\"3\","
+			"\"nonce\":\"0\"}", &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":\"3\","
+			"\"nonce\":\"0123456789abcdef\",\"unknown\":\"x\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":\"3\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(
+			"{\"command.id\":\"raop-demand-state\","
+			"\"state\":\"demanded\",\"sequence\":\"3\","
+			"\"nonce\":\"0123456789abcdef\"} trailing",
+			&command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(NULL, &command) == -EINVAL);
+	spa_assert_se(raop_demand_command_parse(demanded, NULL) == -EINVAL);
+}
+
+int main(void)
+{
+	test_state_machine();
+	test_want_stream();
+	test_parser();
+	return 0;
+}
