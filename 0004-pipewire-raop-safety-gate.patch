--- /dev/null
+++ b/src/modules/module-raop/safety-gate.c
@@ -0,0 +1,250 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <spa/utils/json.h>
+#include <spa/utils/string.h>
+
+#include "safety-gate.h"
+
+static uint64_t next_sequence(uint64_t sequence)
+{
+	if (++sequence == 0)
+		sequence++;
+	return sequence;
+}
+
+void raop_safety_gate_init(struct raop_safety_gate *gate, uint64_t nonce)
+{
+	gate->sequence = 0;
+	gate->nonce = nonce;
+	gate->reasons = 0;
+}
+
+uint64_t raop_safety_gate_invalidate(struct raop_safety_gate *gate,
+		uint32_t reasons)
+{
+	gate->sequence = next_sequence(gate->sequence);
+	gate->reasons |= reasons;
+	return gate->sequence;
+}
+
+uint64_t raop_safety_gate_hold(struct raop_safety_gate *gate,
+		uint32_t reasons)
+{
+	if ((gate->reasons & reasons) != reasons)
+		return raop_safety_gate_invalidate(gate, reasons);
+	return gate->sequence;
+}
+
+bool raop_safety_gate_is_closed(const struct raop_safety_gate *gate)
+{
+	return gate->reasons != 0;
+}
+
+enum raop_safety_gate_release_result raop_safety_gate_release(
+		struct raop_safety_gate *gate,
+		const struct raop_safety_gate_command *command,
+		bool public_mute, bool want_stream)
+{
+	if (command->nonce != gate->nonce)
+		return RAOP_SAFETY_GATE_RELEASE_DENIED;
+	if (command->sequence != gate->sequence)
+		return RAOP_SAFETY_GATE_RELEASE_STALE;
+	if (public_mute || !want_stream ||
+			(gate->reasons & RAOP_SAFETY_GATE_ERROR) != 0)
+		return RAOP_SAFETY_GATE_RELEASE_DENIED;
+
+	gate->reasons &= ~(RAOP_SAFETY_GATE_ACTIVATION |
+			RAOP_SAFETY_GATE_MUTE);
+	return gate->reasons == 0 ?
+		RAOP_SAFETY_GATE_RELEASE_SUCCESS :
+		RAOP_SAFETY_GATE_RELEASE_DENIED;
+}
+
+static bool parse_string(const char *value, int len,
+		char *buffer, size_t size)
+{
+	return len > 0 && spa_json_is_string(value, len) &&
+		spa_json_parse_stringn(value, len, buffer, size) > 0;
+}
+
+static bool decimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (*p == '\0')
+		return false;
+	for (; *p != '\0'; p++)
+		if (*p < '0' || *p > '9')
+			return false;
+	return true;
+}
+
+static bool hexadecimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (strlen(value) != 16)
+		return false;
+	for (; *p != '\0'; p++)
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'f') ||
+		      (*p >= 'A' && *p <= 'F')))
+			return false;
+	return true;
+}
+
+static bool lowercase_hexadecimal_string(const char *value)
+{
+	const unsigned char *p = (const unsigned char *)value;
+
+	if (strlen(value) != 16)
+		return false;
+	for (; *p != '\0'; p++)
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'f')))
+			return false;
+	return true;
+}
+
+int raop_safety_gate_parse_command(const char *json,
+		struct raop_safety_gate_command *command)
+{
+	struct spa_json top, iter;
+	const char *object, *value;
+	char key[64], id[64], sequence[32], nonce[19];
+	bool have_id = false, have_sequence = false, have_nonce = false;
+	uint64_t parsed_sequence, parsed_nonce;
+	int object_len, len;
+
+	if (json == NULL || command == NULL)
+		return -EINVAL;
+	spa_json_init(&top, json, strlen(json));
+	object_len = spa_json_next(&top, &object);
+	if (object_len <= 0 || !spa_json_is_object(object, object_len))
+		return -EINVAL;
+	object_len = spa_json_container_len(&top, object, object_len);
+	if (object_len <= 0 ||
+			spa_json_next(&top, &value) != 0 ||
+			spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+
+	while ((len = spa_json_object_next(&iter, key, sizeof(key),
+			&value)) > 0) {
+		if (spa_streq(key, "command.id")) {
+			if (have_id || !parse_string(value, len, id, sizeof(id)))
+				return -EINVAL;
+			have_id = true;
+		} else if (spa_streq(key, "sequence")) {
+			if (have_sequence || !parse_string(value, len,
+					sequence, sizeof(sequence)))
+				return -EINVAL;
+			have_sequence = true;
+		} else if (spa_streq(key, "nonce")) {
+			if (have_nonce || !parse_string(value, len,
+					nonce, sizeof(nonce)))
+				return -EINVAL;
+			have_nonce = true;
+		}
+	}
+	if (len < 0 || !have_id || !have_sequence || !have_nonce)
+		return -EINVAL;
+	if (!spa_streq(id, RAOP_SAFETY_GATE_RELEASE_COMMAND))
+		return -ENOENT;
+	if (!decimal_string(sequence) ||
+			!spa_atou64(sequence, &parsed_sequence, 10) ||
+			parsed_sequence == 0)
+		return -EINVAL;
+	if (!hexadecimal_string(nonce) ||
+			!spa_atou64(nonce, &parsed_nonce, 16) ||
+			parsed_nonce == 0)
+		return -EINVAL;
+
+	command->sequence = parsed_sequence;
+	command->nonce = parsed_nonce;
+	return 0;
+}
+
+int raop_safety_gate_parse_hold_command(const char *json,
+		struct raop_safety_gate_hold_command *command)
+{
+	struct spa_json top, iter;
+	const char *object, *value;
+	char key[64], id[64], nonce[19];
+	bool have_id = false, have_nonce = false, have_unknown = false;
+	uint64_t parsed_nonce;
+	int object_len, len;
+
+	if (json == NULL || command == NULL)
+		return -EINVAL;
+	spa_json_init(&top, json, strlen(json));
+	object_len = spa_json_next(&top, &object);
+	if (object_len <= 0 || !spa_json_is_object(object, object_len))
+		return -EINVAL;
+	object_len = spa_json_container_len(&top, object, object_len);
+	if (object_len <= 0 ||
+			spa_json_next(&top, &value) != 0 ||
+			spa_json_begin_object(&iter, object, object_len) <= 0)
+		return -EINVAL;
+
+	while ((len = spa_json_object_next(&iter, key, sizeof(key),
+			&value)) > 0) {
+		if (spa_streq(key, "command.id")) {
+			if (have_id || !parse_string(value, len, id, sizeof(id)))
+				return -EINVAL;
+			have_id = true;
+		} else if (spa_streq(key, "nonce")) {
+			if (have_nonce || !parse_string(value, len,
+					nonce, sizeof(nonce)))
+				return -EINVAL;
+			have_nonce = true;
+		} else {
+			have_unknown = true;
+		}
+	}
+	if (len < 0 || !have_id)
+		return -EINVAL;
+	if (!spa_streq(id, RAOP_SAFETY_GATE_HOLD_COMMAND))
+		return -ENOENT;
+	if (!have_nonce || have_unknown ||
+			!lowercase_hexadecimal_string(nonce) ||
+			!spa_atou64(nonce, &parsed_nonce, 16) ||
+			parsed_nonce == 0)
+		return -EINVAL;
+
+	command->nonce = parsed_nonce;
+	return 0;
+}
+
+const char *raop_safety_gate_reasons_string(uint32_t reasons,
+		char *buffer, size_t size)
+{
+	size_t offset = 0;
+
+	if (buffer == NULL || size == 0)
+		return NULL;
+	if (reasons == 0) {
+		snprintf(buffer, size, "none");
+		return buffer;
+	}
+	buffer[0] = '\0';
+#define APPEND_REASON(mask,name)						\
+	do {									\
+		if ((reasons & (mask)) != 0 && offset < size)			\
+			offset += snprintf(buffer + offset, size - offset,	\
+					"%s%s", offset == 0 ? "" : ",", name);	\
+	} while (0)
+	APPEND_REASON(RAOP_SAFETY_GATE_ACTIVATION, "activation");
+	APPEND_REASON(RAOP_SAFETY_GATE_MUTE, "mute");
+	APPEND_REASON(RAOP_SAFETY_GATE_ERROR, "error");
+#undef APPEND_REASON
+	return buffer;
+}
diff --git a/src/modules/module-raop/safety-gate.h b/src/modules/module-raop/safety-gate.h
new file mode 100644
index 0000000000000000000000000000000000000000..17a1ee2a94837d237b56e5c98355bb5faf3c064d
