+static void safety_gate_format_properties(const struct impl *impl,
+		char sequence[32], char nonce[17], char reasons[64],
+		const char **state)
+{
+	spa_scnprintf(sequence, 32, "%" PRIu64,
+			impl->safety_gate.sequence);
+	spa_scnprintf(nonce, 17, "%016" PRIx64,
+			impl->safety_gate.nonce);
+	raop_safety_gate_reasons_string(impl->safety_gate.reasons,
+			reasons, 64);
+	*state = raop_safety_gate_is_closed(&impl->safety_gate) ?
+		"closed" : "open";
+}
+
+static void safety_gate_set_initial_properties(struct impl *impl)
+{
+	const char *state;
+	char sequence[32], nonce[17], reasons[64];
+
+	if (!impl->safety_gate_contract)
+		return;
+	safety_gate_format_properties(impl, sequence, nonce, reasons, &state);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.state", state);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.sequence", sequence);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.nonce", nonce);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.reasons", reasons);
+}
+
+static void safety_gate_clear_initial_properties(struct impl *impl)
+{
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.state", NULL);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.sequence", NULL);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.nonce", NULL);
+	pw_properties_set(impl->stream_props,
+			"raop.safety.gate.reasons", NULL);
+}
+
+static int safety_gate_publish(struct impl *impl)
+{
+	struct spa_dict_item items[4];
+	const char *state;
+	char sequence[32], nonce[17], reasons[64];
+
+	if (!impl->safety_gate_contract || impl->stream == NULL)
+		return 0;
+
+	safety_gate_format_properties(impl, sequence, nonce, reasons, &state);
+	items[0] = SPA_DICT_ITEM_INIT("raop.safety.gate.state", state);
+	items[1] = SPA_DICT_ITEM_INIT("raop.safety.gate.sequence", sequence);
+	items[2] = SPA_DICT_ITEM_INIT("raop.safety.gate.nonce", nonce);
+	items[3] = SPA_DICT_ITEM_INIT("raop.safety.gate.reasons", reasons);
+	return rtp_stream_update_properties(impl->stream,
+			&SPA_DICT_INIT(items, SPA_N_ELEMENTS(items)));
+}
+
+static void safety_gate_invalidate(struct impl *impl, uint32_t reasons,
+		const char *why)
+{
+	int res;
+
+	if (!impl->safety_gate_contract)
+		return;
+
+	SPA_ATOMIC_STORE(impl->safety_gate_closed, 1);
+	raop_safety_gate_invalidate(&impl->safety_gate, reasons);
+	pw_log_debug("closed RAOP safety gate at sequence %" PRIu64
+			" (%s)", impl->safety_gate.sequence, why);
+	if ((res = safety_gate_publish(impl)) < 0)
+		pw_log_warn("can't publish closed RAOP safety gate: %s",
+				spa_strerror(res));
+}
+
+static void safety_gate_hold(struct impl *impl, uint32_t reasons,
+		const char *why)
+{
+	uint64_t old_sequence;
+	int res;
+
+	if (!impl->safety_gate_contract)
+		return;
+
+	SPA_ATOMIC_STORE(impl->safety_gate_closed, 1);
+	old_sequence = impl->safety_gate.sequence;
+	raop_safety_gate_hold(&impl->safety_gate, reasons);
+	if (impl->safety_gate.sequence != old_sequence)
+		pw_log_debug("closed RAOP safety gate at sequence %" PRIu64
+				" (%s)", impl->safety_gate.sequence, why);
+	if ((res = safety_gate_publish(impl)) < 0)
+		pw_log_warn("can't publish closed RAOP safety gate: %s",
+				spa_strerror(res));
+}
+
+static void safety_gate_release(struct impl *impl,
+		const struct raop_safety_gate_command *command)
+{
+	enum raop_safety_gate_release_result result;
+	int res;
+
+	result = raop_safety_gate_release(&impl->safety_gate, command,
+			impl->mute, impl->want_stream);
+	switch (result) {
+	case RAOP_SAFETY_GATE_RELEASE_STALE:
+		pw_log_debug("ignoring stale RAOP safety gate release sequence %"
+				PRIu64, command->sequence);
+		return;
+	case RAOP_SAFETY_GATE_RELEASE_DENIED:
+		pw_log_warn("denying RAOP safety gate release sequence %"
+				PRIu64, command->sequence);
+		return;
+	case RAOP_SAFETY_GATE_RELEASE_SUCCESS:
+		break;
+	}
+
+	/* Keep the data-loop gate closed until the new public state was
+	 * accepted. If publication fails, latch an error instead of allowing
+	 * packets under state that the controller could not observe. */
+	if ((res = safety_gate_publish(impl)) < 0) {
+		raop_safety_gate_invalidate(&impl->safety_gate,
+				RAOP_SAFETY_GATE_ERROR);
+		pw_log_error("can't publish open RAOP safety gate: %s",
+				spa_strerror(res));
+		if ((res = safety_gate_publish(impl)) < 0)
+			pw_log_warn("can't publish failed RAOP safety gate: %s",
+					spa_strerror(res));
+		return;
+	}
+	SPA_ATOMIC_STORE(impl->safety_gate_closed, 0);
+	pw_log_debug("released RAOP safety gate at sequence %" PRIu64,
+			impl->safety_gate.sequence);
+}
+
+static void stream_command(void *data, const struct spa_command *command)
+{
+	struct impl *impl = data;
+	const struct spa_pod_object *object;
+	struct spa_pod_prop *prop;
+
+	if (!impl->safety_gate_contract ||
+			SPA_UNLIKELY(SPA_COMMAND_TYPE(command) !=
+				SPA_TYPE_COMMAND_Node) ||
+			SPA_NODE_COMMAND_ID(command) != SPA_NODE_COMMAND_User)
+		return;
+
+	object = (const struct spa_pod_object *)command;
+	SPA_POD_OBJECT_FOREACH(object, prop) {
+		struct raop_safety_gate_hold_command hold;
+		struct raop_safety_gate_command release;
+		const char *json;
+		int res;
+
+		if (prop->key != SPA_COMMAND_NODE_extra ||
+				prop->value.type != SPA_TYPE_String)
+			continue;
+
+		json = SPA_POD_CONTENTS(struct spa_pod, &prop->value);
+		res = raop_safety_gate_parse_hold_command(json, &hold);
+		if (res == 0) {
+			if (hold.nonce != impl->safety_gate.nonce) {
+				pw_log_debug("ignoring stale RAOP safety gate hold");
+				return;
+			}
+			safety_gate_hold(impl, RAOP_SAFETY_GATE_ACTIVATION,
+					"explicit controller hold");
+			return;
+		}
+		if (res != -ENOENT) {
+			pw_log_warn("ignoring malformed RAOP safety gate command");
+			return;
+		}
+		if ((res = raop_safety_gate_parse_command(json, &release)) ==
+				-ENOENT)
+			continue;
+		if (res < 0) {
+			pw_log_warn("ignoring malformed RAOP safety gate command");
+			return;
+		}
+		safety_gate_release(impl, &release);
+		return;
+	}
+}
