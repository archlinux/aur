@@ -0,0 +1,67 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PIPEWIRE_MODULE_RAOP_SAFETY_GATE_H
+#define PIPEWIRE_MODULE_RAOP_SAFETY_GATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define RAOP_SAFETY_GATE_CONTRACT	"3"
+#define RAOP_SAFETY_GATE_HOLD_COMMAND	"raop-safety-gate-hold"
+#define RAOP_SAFETY_GATE_RELEASE_COMMAND	"raop-safety-gate-release"
+
+enum raop_safety_gate_reason {
+	RAOP_SAFETY_GATE_ACTIVATION = (1u << 0),
+	RAOP_SAFETY_GATE_MUTE = (1u << 1),
+	RAOP_SAFETY_GATE_ERROR = (1u << 2),
+};
+
+enum raop_safety_gate_release_result {
+	RAOP_SAFETY_GATE_RELEASE_SUCCESS,
+	RAOP_SAFETY_GATE_RELEASE_STALE,
+	RAOP_SAFETY_GATE_RELEASE_DENIED,
+};
+
+struct raop_safety_gate {
+	uint64_t sequence;
+	uint64_t nonce;
+	uint32_t reasons;
+};
+
+struct raop_safety_gate_command {
+	uint64_t sequence;
+	uint64_t nonce;
+};
+
+struct raop_safety_gate_hold_command {
+	uint64_t nonce;
+};
+
+void raop_safety_gate_init(struct raop_safety_gate *gate, uint64_t nonce);
+
+uint64_t raop_safety_gate_invalidate(struct raop_safety_gate *gate,
+		uint32_t reasons);
+
+uint64_t raop_safety_gate_hold(struct raop_safety_gate *gate,
+		uint32_t reasons);
+
+bool raop_safety_gate_is_closed(const struct raop_safety_gate *gate);
+
+enum raop_safety_gate_release_result raop_safety_gate_release(
+		struct raop_safety_gate *gate,
+		const struct raop_safety_gate_command *command,
+		bool public_mute, bool want_stream);
+
+int raop_safety_gate_parse_command(const char *json,
+		struct raop_safety_gate_command *command);
+
+int raop_safety_gate_parse_hold_command(const char *json,
+		struct raop_safety_gate_hold_command *command);
+
+const char *raop_safety_gate_reasons_string(uint32_t reasons,
+		char *buffer, size_t size);
+
+#endif /* PIPEWIRE_MODULE_RAOP_SAFETY_GATE_H */
diff --git a/src/modules/module-raop/test-safety-gate.c b/src/modules/module-raop/test-safety-gate.c
new file mode 100644
index 0000000000000000000000000000000000000000..9a3cb44b08c2a7f7286848a98661d6512514fffe
--- /dev/null
+++ b/src/modules/module-raop/test-safety-gate.c
@@ -0,0 +1,269 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <spa/utils/defs.h>
+#include <spa/utils/string.h>
+
+#include "safety-gate.h"
+
+#define TEST_NONCE UINT64_C(0x0123456789abcdef)
+
+static struct raop_safety_gate_command command_for(
+		const struct raop_safety_gate *gate)
+{
+	return (struct raop_safety_gate_command) {
+		.sequence = gate->sequence,
+		.nonce = gate->nonce,
+	};
+}
+
+static void test_activation_release(void)
+{
+	struct raop_safety_gate gate;
+	struct raop_safety_gate_command command;
+
+	raop_safety_gate_init(&gate, TEST_NONCE);
+	spa_assert_se(!raop_safety_gate_is_closed(&gate));
+	spa_assert_se(raop_safety_gate_invalidate(&gate,
+			RAOP_SAFETY_GATE_ACTIVATION) == 1);
+	spa_assert_se(raop_safety_gate_is_closed(&gate));
+
+	command = command_for(&gate);
+	spa_assert_se(raop_safety_gate_release(&gate, &command,
+			false, false) == RAOP_SAFETY_GATE_RELEASE_DENIED);
+	spa_assert_se(raop_safety_gate_is_closed(&gate));
+	spa_assert_se(raop_safety_gate_release(&gate, &command,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_SUCCESS);
+	spa_assert_se(!raop_safety_gate_is_closed(&gate));
+}
+
+static void test_fast_mute_unmute(void)
+{
+	struct raop_safety_gate gate;
+	struct raop_safety_gate_command muted, unmuted;
+
+	raop_safety_gate_init(&gate, TEST_NONCE);
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_ACTIVATION);
+	unmuted = command_for(&gate);
+	spa_assert_se(raop_safety_gate_release(&gate, &unmuted,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_SUCCESS);
+
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_MUTE);
+	muted = command_for(&gate);
+	spa_assert_se(raop_safety_gate_release(&gate, &muted,
+			true, true) == RAOP_SAFETY_GATE_RELEASE_DENIED);
+
+	/* An immediate unmute is a new intent even though the mute hold was
+	 * already closed. The old acknowledgement must not release it. */
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_MUTE);
+	unmuted = command_for(&gate);
+	spa_assert_se(unmuted.sequence != muted.sequence);
+	spa_assert_se(raop_safety_gate_release(&gate, &muted,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_STALE);
+	spa_assert_se(raop_safety_gate_is_closed(&gate));
+	spa_assert_se(raop_safety_gate_release(&gate, &unmuted,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_SUCCESS);
+	spa_assert_se(!raop_safety_gate_is_closed(&gate));
+}
+
+static void test_nonce_and_fail_closed(void)
+{
+	struct raop_safety_gate gate;
+	struct raop_safety_gate_command command;
+
+	raop_safety_gate_init(&gate, TEST_NONCE);
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_ACTIVATION);
+	command = command_for(&gate);
+	command.nonce++;
+	spa_assert_se(raop_safety_gate_release(&gate, &command,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_DENIED);
+	spa_assert_se(raop_safety_gate_is_closed(&gate));
+
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_ERROR);
+	command = command_for(&gate);
+	spa_assert_se(raop_safety_gate_release(&gate, &command,
+			false, true) == RAOP_SAFETY_GATE_RELEASE_DENIED);
+	spa_assert_se(raop_safety_gate_is_closed(&gate));
+}
+
+static void test_hold_is_idempotent(void)
+{
+	struct raop_safety_gate gate;
+	uint64_t sequence;
+
+	raop_safety_gate_init(&gate, TEST_NONCE);
+	sequence = raop_safety_gate_hold(&gate,
+			RAOP_SAFETY_GATE_ACTIVATION);
+	spa_assert_se(sequence == 1);
+	spa_assert_se(raop_safety_gate_hold(&gate,
+			RAOP_SAFETY_GATE_ACTIVATION) == sequence);
+	spa_assert_se(raop_safety_gate_hold(&gate,
+			RAOP_SAFETY_GATE_MUTE) != sequence);
+}
+
+static void test_command_parser(void)
+{
+	struct raop_safety_gate_command command;
+	static const char valid[] =
+		"{\"command.id\":\"raop-safety-gate-release\","
+		"\"sequence\":\"42\",\"nonce\":\"0123456789abcdef\"}";
+
+	spa_assert_se(raop_safety_gate_parse_command(valid, &command) == 0);
+	spa_assert_se(command.sequence == 42);
+	spa_assert_se(command.nonce == TEST_NONCE);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"other\",\"sequence\":\"42\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -ENOENT);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":42,\"nonce\":\"0123456789abcdef\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":\"0\",\"nonce\":\"0123456789abcdef\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":\"42\",\"nonce\":\"1123456789abcdef\"}",
+			&command) == 0);
+	spa_assert_se(command.nonce != TEST_NONCE);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":\"42\",\"nonce\":\"0\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":\"42\","
+			"\"nonce\":\"0123456789abcdef\"} trailing",
+			&command) == -EINVAL);
+}
+
+static void test_hold_command_parser(void)
+{
+	struct raop_safety_gate_hold_command command;
+	static const struct {
+		const char *nonce;
+		int result;
+		uint64_t parsed;
+	} cases[] = {
+		{ "0000000000000001", 0, UINT64_C(0x0000000000000001) },
+		{ "0123456789abcdef", 0, TEST_NONCE },
+		{ "a000000000000000", 0, UINT64_C(0xa000000000000000) },
+		{ "b807a21d4afe945a", 0, UINT64_C(0xb807a21d4afe945a) },
+		{ "c000000000000000", 0, UINT64_C(0xc000000000000000) },
+		{ "d000000000000000", 0, UINT64_C(0xd000000000000000) },
+		{ "e000000000000000", 0, UINT64_C(0xe000000000000000) },
+		{ "f000000000000000", 0, UINT64_C(0xf000000000000000) },
+		{ "ffffffffffffffff", 0, UINT64_MAX },
+		{ "0000000000000000", -EINVAL, 0 },
+		{ "0", -EINVAL, 0 },
+		{ "0123456789abcde", -EINVAL, 0 },
+		{ "10000000000000000", -EINVAL, 0 },
+		{ "fffffffffffffffff", -EINVAL, 0 },
+		{ "A000000000000000", -EINVAL, 0 },
+		{ "g000000000000000", -EINVAL, 0 },
+		{ "-000000000000000", -EINVAL, 0 },
+	};
+	char json[160];
+	uint32_t i;
+
+	for (i = 0; i < SPA_N_ELEMENTS(cases); i++) {
+		spa_scnprintf(json, sizeof(json),
+				"{\"command.id\":\"raop-safety-gate-hold\","
+				"\"nonce\":\"%s\"}", cases[i].nonce);
+		command.nonce = UINT64_C(0xfeedfacefeedface);
+		spa_assert_se(raop_safety_gate_parse_hold_command(json,
+				&command) == cases[i].result);
+		if (cases[i].result == 0)
+			spa_assert_se(command.nonce == cases[i].parsed);
+		else
+			spa_assert_se(command.nonce ==
+					UINT64_C(0xfeedfacefeedface));
+	}
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"other\","
+			"\"nonce\":\"0123456789abcdef\"}", &command) == -ENOENT);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-release\","
+			"\"sequence\":\"42\",\"nonce\":\"0123456789abcdef\"}",
+			&command) == -ENOENT);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":\"0123456789abcdeF\"}", &command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":\"0123456789abcdef\",\"sequence\":\"42\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":123}", &command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\"}",
+			&command) == -EINVAL);
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":\"0123456789abcdef\"} trailing",
+			&command) == -EINVAL);
+}
+
+static void test_hold_nonce_does_not_mutate(void)
+{
+	struct raop_safety_gate gate;
+	struct raop_safety_gate_hold_command command;
+	uint64_t sequence;
+	uint32_t reasons;
+
+	raop_safety_gate_init(&gate, TEST_NONCE);
+	raop_safety_gate_invalidate(&gate, RAOP_SAFETY_GATE_MUTE);
+	sequence = gate.sequence;
+	reasons = gate.reasons;
+
+	spa_assert_se(raop_safety_gate_parse_hold_command(
+			"{\"command.id\":\"raop-safety-gate-hold\","
+			"\"nonce\":\"1123456789abcdef\"}", &command) == 0);
+	if (command.nonce == gate.nonce)
+		raop_safety_gate_hold(&gate, RAOP_SAFETY_GATE_ACTIVATION);
+	spa_assert_se(gate.sequence == sequence);
+	spa_assert_se(gate.reasons == reasons);
+
+	command.nonce = gate.nonce;
+	if (command.nonce == gate.nonce)
+		raop_safety_gate_hold(&gate, RAOP_SAFETY_GATE_ACTIVATION);
+	spa_assert_se(gate.sequence != sequence);
+	spa_assert_se((gate.reasons & RAOP_SAFETY_GATE_ACTIVATION) != 0);
+	sequence = gate.sequence;
+	spa_assert_se(raop_safety_gate_hold(&gate,
+			RAOP_SAFETY_GATE_ACTIVATION) == sequence);
+}
+
+static void test_reason_strings(void)
+{
+	char buffer[64];
+
+	spa_assert_se(spa_streq(raop_safety_gate_reasons_string(0,
+			buffer, sizeof(buffer)), "none"));
+	spa_assert_se(spa_streq(raop_safety_gate_reasons_string(
+			RAOP_SAFETY_GATE_ACTIVATION |
+			RAOP_SAFETY_GATE_MUTE |
+			RAOP_SAFETY_GATE_ERROR,
+			buffer, sizeof(buffer)), "activation,mute,error"));
+}
+
+int main(void)
+{
+	test_activation_release();
+	test_fast_mute_unmute();
+	test_nonce_and_fail_closed();
+	test_hold_is_idempotent();
+	test_command_parser();
+	test_hold_command_parser();
+	test_hold_nonce_does_not_mutate();
+	test_reason_strings();
+	return 0;
+}
diff --git a/src/modules/module-raop/test-volume.c b/src/modules/module-raop/test-volume.c
index 70aeb92c81ff4ac0559f06dc2d4cdd4ca312ef56..efbb9647fb133869dc3e47f8d3ff816a4d34451d 100644
--- a/src/modules/module-raop/test-volume.c
+++ b/src/modules/module-raop/test-volume.c
@@ -226,6 +226,14 @@ static void test_stream_contract(void)
 	spa_assert_se(spa_streq(pw_properties_get(stream_props,
 			"raop.name"), "nested name remains"));

+	/* Contract 3 is explicitly selected by the module and must survive the
+	 * same trusted override that prevents nested stream.props forgery. */
+	pw_properties_set(module_props, "raop.volume.contract", "3");
+	spa_assert_se(raop_volume_override_stream_props(stream_props,
+			module_props) == 0);
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.volume.contract"), "3"));
+
 	/* A missing module identity value removes, rather than trusts, a value
 	 * injected through nested stream.props. */
 	pw_properties_set(module_props, "raop.device", NULL);
