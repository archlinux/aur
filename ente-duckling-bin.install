post_install() {
    cat <<'EOF'
==> duckling — third-party headless ente client (not affiliated with ente).

    Log in (interactive SRP; prompts for your password):
        duckling login [email]
        duckling whoami                       # verify the session

    Then upload:
        duckling upload <path>... --album <name>

    Persistent settings — sourced on every run (honours XDG_CONFIG_HOME):
        ~/.config/duckling/env
      e.g. to point at a self-hosted museum, put this line in it:
        export DUCKLING_ENDPOINT=https://your-museum.example.org
      Template: /usr/share/doc/ente-duckling-bin/env.example

    Session/tokens: ~/.local/state/duckling (XDG_STATE_HOME), or an existing
    ~/.duckling if you already have one. Override with DUCKLING_STATE_DIR.
    Video thumbnails/metadata need ffmpeg (optional dependency).
EOF
}

post_upgrade() {
    post_install
}
