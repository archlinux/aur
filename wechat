#!/bin/sh

function is_fcitx {
    command -v fcitx-remote 2>&1 1>/dev/null && fcitx-remote -c 2>&1 1>/dev/null && return 0
    command -v fcitx5-remote 2>&1 1>/dev/null && fcitx5-remote -c 2>&1 1>/dev/null && return 0
}

if [ -z "$QT_IM_MODULE" ]; then
    if [ "$XDG_SESSION_TYPE" != "wayland" ]; then
        if is_fcitx; then
            QT_IM_MODULE=fcitx
        else
            QT_IM_MODULE=ibus
        fi
    else
        QT_IM_MODULE=text-input-unstable-v3
    fi

    echo "QT_IM_MODULE is not set, set to $QT_IM_MODULE"
    export QT_IM_MODULE
fi

