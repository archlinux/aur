#!/bin/sh

export LD_LIBRARY_PATH='@TOOLCHAIN_PREFIX@/lib:@TOOLCHAIN_PREFIX@/lib/vala-0.58:@VALA_BUILDDIR@/codegen':"${LD_LIBRARY_PATH:-}"
# Keep the pinned Frida Gum VAPI first: valac resolves duplicate package names from the first --vapidir.
exec '@TOOLCHAIN_PREFIX@/bin/valac-0.58' '--vapidir=@FRIDA_GUM_VAPIDIR@' '--vapidir=@TOOLCHAIN_PREFIX@/share/vala-0.58/vapi' "$@"
