+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "config.h"
+
+#include "backends/meta-backend-private.h"
+#include "backends/meta-logical-monitor-private.h"
+#include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-settings-private.h"
+#include "tests/meta-monitor-manager-test.h"
+#include "tests/meta-test-utils.h"
+#include "tests/meta-monitor-test-utils.h"
+#include "tests/meta-test/meta-context-test.h"
+#include "wayland/meta-wayland.h"
+#include "wayland/meta-xwayland.h"
+#include "x11/meta-x11-display-private.h"
+
+static MetaContext *test_context;
+static GSettings *wayland_settings;
+static int output_serial_counter = 0x12300000;
+
+static void
+set_up_monitor (float                         scale,
+                MetaLogicalMonitorLayoutMode  layout_mode)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaMonitorManager *monitor_manager =
+    meta_backend_get_monitor_manager (backend);
+  MetaMonitorManagerTest *monitor_manager_test =
+    META_MONITOR_MANAGER_TEST (monitor_manager);
+  MetaMonitorTestSetup *test_setup;
+  g_autofree char *output_serial = NULL;
+  MonitorTestCaseSetup test_case_setup = {
+    .modes = {
+      {
+        .width = 1920,
+        .height = 1080,
+        .refresh_rate = 60.0,
+      },
+    },
+    .n_modes = 1,
+    .outputs = {
+      {
+        .crtc = 0,
+        .modes = { 0 },
+        .n_modes = 1,
+        .preferred_mode = 0,
+        .possible_crtcs = { 0 },
+        .n_possible_crtcs = 1,
+        .width_mm = 150,
+        .height_mm = 85,
+        .scale = scale,
+      },
+    },
+    .n_outputs = 1,
+    .crtcs = {
+      {
+        .current_mode = 0,
+      },
+    },
+    .n_crtcs = 1,
+  };
+
+  output_serial = g_strdup_printf ("0x%x", output_serial_counter++);
+  test_case_setup.outputs[0].serial = output_serial;
+
+  meta_monitor_manager_test_set_layout_mode (monitor_manager_test,
+                                             layout_mode);
+  test_setup = meta_create_monitor_test_setup (backend,
+                                               &test_case_setup,
+                                               MONITOR_TEST_FLAG_NO_STORED);
+  meta_monitor_manager_test_emulate_hotplug (monitor_manager_test,
+                                             test_setup);
+}
+
+static MetaXWaylandManager *
+get_xwayland_manager (void)
+{
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (test_context);
+
+  return meta_wayland_compositor_get_xwayland_manager (compositor);
+}
+
+static void
+set_scaling_mode (MetaXwaylandScalingMode mode,
+                  double                  scaling_factor)
+{
+  g_settings_set_enum (wayland_settings, "xwayland-scaling-mode", mode);
+  g_settings_set_double (wayland_settings, "xwayland-scaling-factor",
+                         scaling_factor);
+  g_settings_sync ();
+
+  while (g_main_context_iteration (NULL, FALSE))
+    ;
+}
+
+static void
+assert_scaling (float              monitor_scale,
+                double             expected_effective_scale,
+                int                expected_ui_factor)
+{
+  MetaXWaylandManager *xwayland_manager = get_xwayland_manager ();
+  double effective_scale;
+  int ui_factor;
+  MetaLogicalMonitor *logical_monitor;
+  GList *logical_monitors;
+  MtkRectangle layout;
+
+  logical_monitors =
+    meta_monitor_manager_get_logical_monitors (
+      meta_backend_get_monitor_manager (meta_context_get_backend (test_context)));
+  g_assert_cmpuint (g_list_length (logical_monitors), ==, 1);
+  logical_monitor = logical_monitors->data;
+  g_assert_cmpfloat_with_epsilon (meta_logical_monitor_get_scale (logical_monitor),
+                                  monitor_scale,
+                                  FLT_EPSILON);
+
+  effective_scale = meta_xwayland_get_effective_scale (xwayland_manager);
+  g_assert_cmpfloat_with_epsilon (effective_scale,
+                                  expected_effective_scale,
+                                  DBL_EPSILON);
+
+  /* The X11 root window is the logical monitor size scaled by the effective
+   * Xwayland scale. */
+  layout = meta_logical_monitor_get_layout (logical_monitor);
+  g_assert_cmpint ((int) round (layout.width * effective_scale),
+                   ==,
+                   (int) round (layout.width * expected_effective_scale));
+
+  ui_factor =
+    meta_xwayland_get_x11_ui_scaling_factor (xwayland_manager);
+  g_assert_cmpint (ui_factor, ==, expected_ui_factor);
+}
+
+static void
+meta_test_xwayland_scaling_automatic_fractional (void)
+{
+  set_up_monitor (1.25f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_AUTOMATIC, 0.0);
+  assert_scaling (1.25f, 2.0, 2);
+}
+
+static void
+meta_test_xwayland_scaling_native_fractional (void)
+{
+  set_up_monitor (1.25f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  assert_scaling (1.25f, 1.25, 1);
+
+  /* The coordinate space is the physical resolution, i.e. 1920x1080. */
+  g_assert_cmpint ((int) round (1536 * 1.25), ==, 1920);
+}
+
+static void
+meta_test_xwayland_scaling_native_1_5 (void)
+{
+  set_up_monitor (1.5f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  assert_scaling (1.5f, 1.5, 1);
+}
+
+static void
+meta_test_xwayland_scaling_native_2_0 (void)
+{
+  set_up_monitor (2.0f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  assert_scaling (2.0f, 2.0, 2);
+}
+
+static void
+meta_test_xwayland_scaling_explicit_factor (void)
+{
+  set_up_monitor (1.25f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+
+  /* An explicit factor takes precedence over the scaling mode and is rounded
+   * to the closest integer, so 1.0 results in the logical resolution being
+   * used as the Xwayland coordinate space (1536x864 here). */
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 1.0);
+  assert_scaling (1.25f, 1.0, 1);
+}
+
+static void
+meta_test_xwayland_scaling_physical_layout (void)
+{
+  set_up_monitor (1.25f, META_LOGICAL_MONITOR_LAYOUT_MODE_PHYSICAL);
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  /* In the physical layout mode the logical monitor keeps the monitor scale,
+   * but the Xwayland coordinate space is already physical. */
+  assert_scaling (1.25f, 1.0, 1);
+}
+
+static void
+wait_for_root_window_size (MetaX11Display *x11_display,
+                           int             expected_width,
+                           int             expected_height)
+{
+  Display *xdisplay = x11_display->xdisplay;
+  gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+
+  while (TRUE)
+    {
+      Window root_ret;
+      int x, y;
+      unsigned int width, height;
+      unsigned int border_width, depth;
+
+      /* Don't rely on the client side Screen width/height, as those are only
+       * updated while handling the corresponding RandR event. */
+      XGetGeometry (xdisplay,
+                    DefaultRootWindow (xdisplay),
+                    &root_ret,
+                    &x, &y,
+                    &width, &height,
+                    &border_width, &depth);
+
+      if ((int) width == expected_width && (int) height == expected_height)
+        return;
+
+      if (g_get_monotonic_time () > deadline)
+        {
+          g_error ("Timed out waiting for an Xwayland root window of %dx%d, "
+                   "got %ux%u",
+                   expected_width, expected_height,
+                   width, height);
+        }
+
+      g_main_context_iteration (NULL, TRUE);
+    }
+}
+
+static MetaTestClient *xwayland_test_client;
+
+static void
+ensure_xwayland (void)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  static int client_count = 0;
+  g_autofree char *client_name = NULL;
+  g_autoptr (GError) error = NULL;
+  gint64 deadline;
+
+  if (meta_display_get_x11_display (display))
+    return;
+
+  /* The test context uses the ON_DEMAND X11 policy, where Xwayland is only
+   * started once a client connects to the public X11 socket. Start a test
+   * client to trigger that, and keep it around so Xwayland stays alive. */
+  client_name = g_strdup_printf ("xwayland-scaling-client-%d", client_count++);
+  xwayland_test_client = meta_test_client_new (test_context,
+                                               client_name,
+                                               META_WINDOW_CLIENT_TYPE_X11,
+                                               &error);
+  if (!xwayland_test_client)
+    g_error ("Failed to launch test client: %s", error->message);
+
+  deadline = g_get_monotonic_time () + 30 * G_TIME_SPAN_SECOND;
+  while (!meta_display_get_x11_display (display))
+    {
+      if (g_get_monotonic_time () > deadline)
+        g_error ("Timed out waiting for Xwayland to start");
+
+      g_main_context_iteration (NULL, TRUE);
+    }
+}
+
+static void
+assert_root_window_size (int expected_width,
+                         int expected_height)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+  MetaX11Display *x11_display;
+
+  ensure_xwayland ();
+  x11_display = meta_display_get_x11_display (display);
+  wait_for_root_window_size (x11_display, expected_width, expected_height);
+}
+
+static void
+meta_test_xwayland_scaling_root_window (void)
+{
+  set_up_monitor (1.25f, META_LOGICAL_MONITOR_LAYOUT_MODE_LOGICAL);
+
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  assert_root_window_size (1920, 1080);
+
+  /* The automatic mode keeps rendering at the ceiling of the scale. */
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_AUTOMATIC, 0.0);
+  assert_root_window_size (3072, 1728);
+
+  set_scaling_mode (META_XWAYLAND_SCALING_MODE_NATIVE, 0.0);
+  assert_root_window_size (1920, 1080);
+}
+
+static void
+on_before_tests (void)
+{
+  wayland_settings = g_settings_new ("org.gnome.mutter.wayland");
+}
+
+static void
+on_after_tests (void)
+{
+  g_settings_reset (wayland_settings, "xwayland-scaling-mode");
+  g_settings_reset (wayland_settings, "xwayland-scaling-factor");
+  g_settings_sync ();
+  g_clear_object (&wayland_settings);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = meta_create_test_context (META_CONTEXT_TEST_TYPE_TEST,
+                                      META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  test_context = context;
+
+  g_test_add_func ("/backend/xwayland-scaling/automatic-fractional",
+                   meta_test_xwayland_scaling_automatic_fractional);
+  g_test_add_func ("/backend/xwayland-scaling/native-fractional",
+                   meta_test_xwayland_scaling_native_fractional);
+  g_test_add_func ("/backend/xwayland-scaling/native-1.5",
+                   meta_test_xwayland_scaling_native_1_5);
+  g_test_add_func ("/backend/xwayland-scaling/native-2.0",
+                   meta_test_xwayland_scaling_native_2_0);
+  g_test_add_func ("/backend/xwayland-scaling/explicit-factor",
+                   meta_test_xwayland_scaling_explicit_factor);
+  g_test_add_func ("/backend/xwayland-scaling/physical-layout",
+                   meta_test_xwayland_scaling_physical_layout);
+  g_test_add_func ("/backend/xwayland-scaling/root-window",
+                   meta_test_xwayland_scaling_root_window);
+
+  g_signal_connect (context, "before-tests",
+                    G_CALLBACK (on_before_tests), NULL);
+  g_signal_connect (context, "after-tests",
+                    G_CALLBACK (on_after_tests), NULL);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
