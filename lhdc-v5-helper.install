post_install() {
  cat <<'EOF'
==> lhdc-v5-helper installed.
==> The bundled ARM64 Android liblhdcv5.so is installed at:
    /usr/lib/lhdc-v5-helper/lib/liblhdcv5.so
==> To test another encoder build:
    sudo lhdc-v5-install-lib /path/to/liblhdcv5.so
==> Or set LHDCV5_LIB to an alternate path.
EOF
}

post_upgrade() {
  post_install
}
