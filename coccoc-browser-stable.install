note() {
    printf "${_blue}==>${_yellow} NOTE:${_bold} %s${_all_off}\n" "$1"
}

_all_off="$(tput sgr0)"
_bold="${_all_off}$(tput bold)"
_blue="${_bold}$(tput setaf 4)"
_yellow="${_bold}$(tput setaf 3)"

update_database() {
    update-desktop-database -q
    
    update-mime-database /usr/share/mime &> /dev/null || true
    
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor &> /dev/null || true
}

post_install() {
    update_database
    note "Custom flags should be put directly in: ~/.config/coccoc-browser-stable-flags.conf"
    note "The launcher is called: 'coccoc-browser-stable'"
}

post_upgrade() {
    post_install
}

post_remove() {
    update_database
}