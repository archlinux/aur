# shellcheck shell=bash
_notification_help() {
cat << 'EOF'
Barnard uses /usr/share/barnard/barnard-sound.sh as its default notification
command. To enable or customize notifications, copy that script to a
user-writable location, edit its notify and sound settings, then point the
notifycommand setting in ~/.barnard.toml to your copy.
EOF
}

post_install() {
    _notification_help
}

post_upgrade() {
cat << 'EOF'
Barnard UI server list format changed. If you used the old barnard-ui, remove
its server list before starting the new UI:
  rm -f ~/.config/barnard/servers.conf

Barnard keybindings have changed. To adopt the new defaults, edit
~/.barnard.toml and remove its keybinding entries. Leave them unchanged to
retain your existing bindings.

EOF
    _notification_help
}
