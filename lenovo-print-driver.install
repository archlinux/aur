# lenovo-print-driver.install
post_install() {
  PRINTERS="LJ2405D LJ2605D LJ2405 LJ2400Pro M7405D M7605D M7400Pro M7450FPro M7655DHF M7400W M7405DW M7605DW M7625DWA M7626DNA M7628DNA M7685DXF M7686DXF LJ2680DN M7680D M7460 M7480 M7690DNA M7490DNF M7675DXF M7455DNF M7615DNA LJ2655DN"
  
  # 修正历史版本(5.0.3-1)里 deb 带出的 0775 不安全权限:
  # CUPS 拒绝执行组写/其他可写的过滤器,否则报
  # "File ... has insecure permissions (0100775/uid=0/gid=0)"。
  if [ -d "/opt/lenovo/com.lenovo.lenovoprints/bin" ]; then
    find /opt/lenovo/com.lenovo.lenovoprints/bin -type d -exec chmod 755 {} \;
    find /opt/lenovo/com.lenovo.lenovoprints/bin -type f -perm /u+x -exec chmod 755 {} \;
    find /opt/lenovo/com.lenovo.lenovoprints/bin -type f ! -perm /u+x -exec chmod 644 {} \;
  fi

  ARCH=$(uname -m)
  
  if [ -d "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/$ARCH" ]; then
    ln -sf "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/$ARCH/rawtobr3" \
      "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/rawtobr3"
    ln -sf "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/$ARCH/brprintconflsr3" \
      "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/brprintconflsr3"
  fi
  
  mkdir -p "/etc/opt/lenovo/com.lenovo.lenovoprints/bin/inf"
  mkdir -p "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/inf"
  
  ln -sf "/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brlenovoprintsrc" \
    "/etc/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brlenovoprintsrc"
  ln -sf "/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brlenovoprintsrc" \
    "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/inf/brlenovoprintsrc"
  
  # 供应商脚本(lpdwrapper)期望的 rc 文件名是 br${PRINTER}rc,
  # 即 brcom.lenovo.lenovoprintsrc;实际打包名是通用的 brlenovoprintsrc,
  # 补一个链接,避免每个打印任务日志里出现 "cp: ... stat 失败"。
  ln -sf "/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brlenovoprintsrc" \
    "/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brcom.lenovo.lenovoprintsrc"
  
  # 修正历史版本(5.0.3-1/5.0.3-2)遗留的 0775 目录
  # (pacman 不会修改已存在目录的模式,只能这里补)。
  chmod 755 /var/spool/lpd 2>/dev/null
  chmod 755 /usr/share/cups/model/lenovo 2>/dev/null
  chmod 755 /usr/lib32/cups/filter /usr/libexec/cups/filter 2>/dev/null
  
  for printer in $PRINTERS; do
    if [ ! -e "/usr/bin/brprintconflsr3_${printer}" ]; then
      cat > "/usr/bin/brprintconflsr3_${printer}" << EOF
#!/bin/sh
/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/brprintconflsr3 -P ${printer} "\$@"
EOF
      chmod 755 "/usr/bin/brprintconflsr3_${printer}"
    fi
    
    # 创建 CUPS 过滤器链接
    for filterdir in "/usr/lib/cups/filter" "/usr/lib32/cups/filter" \
                     "/usr/libexec/cups/filter"; do
      if [ -d "$filterdir" ]; then
        # 清理旧版本可能留下的普通文件残留,确保最终是链接且目标权限 755
        if [ -e "$filterdir/lenovo_${printer}" ] && [ ! -L "$filterdir/lenovo_${printer}" ]; then
          rm -f "$filterdir/lenovo_${printer}"
        fi
        if [ ! -e "$filterdir/lenovo_${printer}" ]; then
          ln -s "/opt/lenovo/com.lenovo.lenovoprints/bin/cupswrapper/lpdwrapper" \
            "$filterdir/lenovo_${printer}"
        fi
      fi
    done
  done
  
  # 检查 perl 是否存在
  if [ ! -e "/usr/bin/perl" ]; then
    PERL_PATH=$(which perl 2>/dev/null)
    if [ -n "$PERL_PATH" ] && [ -e "$PERL_PATH" ]; then
      ln -sf "$PERL_PATH" "/usr/bin/perl"
    else
      echo "warring: no perl"
    fi
  fi
  

  if systemctl is-active cups.service &>/dev/null; then
    echo "restart CUPS service..."
    systemctl try-restart cups.service
  fi
  
  echo "finished."
}

pre_upgrade() {
  post_remove
}

post_upgrade() {
  post_install
}

pre_remove() {
  PRINTERS="LJ2405D LJ2605D LJ2405 LJ2400Pro M7405D M7605D M7400Pro M7450FPro M7655DHF M7400W M7405DW M7605DW M7625DWA M7626DNA M7628DNA M7685DXF M7686DXF LJ2680DN M7680D M7460 M7480 M7690DNA M7490DNF M7675DXF M7455DNF M7615DNA LJ2655DN"
  
  rm -f "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/rawtobr3"
  rm -f "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/brprintconflsr3"
  
  rm -f "/etc/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brlenovoprintsrc"
  rm -f "/opt/lenovo/com.lenovo.lenovoprints/bin/lpd/inf/brlenovoprintsrc"
  rm -f "/opt/lenovo/com.lenovo.lenovoprints/bin/inf/brcom.lenovo.lenovoprintsrc"
  
  for printer in $PRINTERS; do
    rm -f "/usr/bin/brprintconflsr3_${printer}"
    rm -f "/usr/lib/cups/filter/lenovo_${printer}"
    rm -f "/usr/lib32/cups/filter/lenovo_${printer}"
    rm -f "/usr/libexec/cups/filter/lenovo_${printer}"
    
    rm -rf "/var/spool/lpd/${printer}"
  done
  
  if [ -L "/usr/bin/perl" ] && [ "$(readlink /usr/bin/perl)" != "/usr/bin/perl" ]; then
    rm -f "/usr/bin/perl"
  fi
}

post_remove() {
  rmdir --ignore-fail-on-non-empty "/etc/opt/lenovo/com.lenovo.lenovoprints/bin/inf" 2>/dev/null
  rmdir --ignore-fail-on-non-empty "/etc/opt/lenovo/com.lenovo.lenovoprints/bin" 2>/dev/null
  rmdir --ignore-fail-on-non-empty "/etc/opt/lenovo/com.lenovo.lenovoprints" 2>/dev/null
  
  if systemctl is-active cups.service &>/dev/null; then
    systemctl try-restart cups.service
  fi
  
  echo "removed."
}