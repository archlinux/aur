_refresh_caches() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
  fi
}

# The unit creates /dev/video10 now and at every boot, without module-wide
# options, so other v4l2loopback users keep their devices.
_enable_device() {
  systemctl daemon-reload 2>/dev/null || true
  if ! systemctl enable --now linux-broadcast-loopback.service 2>/dev/null; then
    echo "==> /dev/video10 isn't available yet (DKMS may still be building v4l2loopback)."
    echo "    It is created at the next boot; see: systemctl status linux-broadcast-loopback"
  fi
}

post_install() {
  _enable_device
  _refresh_caches
}

post_upgrade() {
  _enable_device
  _refresh_caches
}

pre_remove() {
  /usr/lib/linux-broadcast/linux-broadcast-loopback remove || true
  systemctl disable --now linux-broadcast-loopback.service 2>/dev/null || true
}

post_remove() {
  _refresh_caches
}
