post_install() {
  cat <<'MSG'
==> xdg-desktop-portal-generic is experimental. Routing InputCapture to it
==> (portals.conf: org.freedesktop.impl.portal.InputCapture=generic) can freeze
==> pointer and keyboard input on labwc and other wlroots compositors when a
==> client such as Deskflow starts a capture session: captured events are
==> logged as "Failed to forward captured input event" and never delivered.
==> Nothing is routed to this backend until you add that portals.conf entry.
==> To recover, remove the entry and restart xdg-desktop-portal, or log out.
MSG
}

post_upgrade() {
  post_install
}
