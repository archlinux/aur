[Unit]
Description=AuroraDownloader web service (user)
After=network.target redis.service

[Service]
WorkingDirectory=%h/.cache/auroradownloader   # optional, stores runtime files
Environment="PATH=/opt/auroradownloader/venv/bin"
ExecStart=/opt/auroradownloader/venv/bin/gunicorn -k gevent --worker-connections 1000 --bind 127.0.0.1:5000 app:app
Restart=on-failure

[Install]
WantedBy=default.target
