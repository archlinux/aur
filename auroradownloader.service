[Unit]
Description=AuroraDownloader web service
After=network.target redis.service

[Service]
User=aurora
Group=aurora
WorkingDirectory=/opt/auroradownloader
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/opt/auroradownloader/venv/bin"
ExecStart=/opt/auroradownloader/venv/bin/gunicorn -k gevent --worker-connections 1000 --bind 127.0.0.1:5000 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
