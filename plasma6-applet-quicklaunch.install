# Copy the packaged applet plugin into each local user's
# ~/.local/lib/qt6/plugins so it overrides the bundled kdeplasma-addons copy,
# and remove those per-user copies again on uninstall.

plugin_src=/usr/lib/plasma6-applet-quicklaunch/plasma/applets/org.kde.plasma.quicklaunch.so
plugin_rel=.local/lib/qt6/plugins/plasma/applets/org.kde.plasma.quicklaunch.so

_each_user() {
    getent passwd | awk -F: '$3 >= 1000 && $3 != 65534 {print $1, $6}'
}

post_install() {
    _each_user | while read -r user home; do
        [ -d "$home" ] || continue
        install -D -o "$user" -g "$(id -gn "$user")" -m644 \
            "$plugin_src" "$home/$plugin_rel"
    done
}

post_upgrade() {
    post_install
}

pre_remove() {
    _each_user | while read -r user home; do
        rm -f "$home/$plugin_rel"
    done
}
