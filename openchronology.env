# OpenChronology server configuration: /etc/openchronology/openchronology.env
# Read by the openchronology, openchronology-mail services and openchronology-migrate.
# Restart after editing: sudo systemctl restart openchronology
# Each package version ships its current template as
# /usr/share/openchronology/openchronology.env.example; compare after upgrading.

# The public origin, exactly as users reach it (no trailing slash). Production needs HTTPS:
# put a reverse proxy (nginx, Caddy, Apache) in front of the address below.
APP_ORIGIN=http://localhost:5173
# The server refuses an http:// APP_ORIGIN other than localhost. Set to 1 to allow one on a
# trusted private network (for example http://timeline.lan:5173, with HOST=0.0.0.0): sign-in
# cookies and passwords then cross the network unencrypted.
ALLOW_INSECURE_ORIGIN=0
# Sites that may embed public timelines (/embed/<id>): * for any, or a list of origins.
EMBED_FRAME_ANCESTORS=*
# Where the server listens. Keep it on loopback behind the reverse proxy.
HOST=127.0.0.1
PORT=5173
# Set to 1 only when the reverse proxy overwrites X-Forwarded-For with the one client
# address and the port above is not reachable directly (see README "PostgreSQL deployment").
TRUST_PROXY=0

# The local PostgreSQL database created on first install (peer authentication over the
# Unix socket as the openchronology system user).
DATABASE_URL=postgresql:///openchronology?host=/var/run/postgresql

# 32 random bytes as 64 hex characters, generated on first install. Keep it and back it up
# apart from the database: it encrypts authenticator secrets and signs human checks.
AUTH_ENCRYPTION_KEY=

# Account email through Resend (registration, password reset). Then enable delivery:
#   sudo systemctl enable --now openchronology-mail
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# The first administrator, created by openchronology-migrate when these are set. The password
# is used once, to create it (15 or more characters; any, # included). To sign in with it again
# (or with a new one written here): sudo openchronology-reset-admin-password
# Once signed in with it and changed, empty it again, so this file holds no working password.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Default storage per account: a byte count or a size such as 500MiB or 2GB (0 = read-only
# accounts). When set, it applies at every start; unset, it starts at 100 MiB and is changed
# in /admin. Per-user quotas are always set in /admin.
DEFAULT_USER_STORAGE_BYTES=
# The platform's name in its header, page titles and link previews (such as timescale.info);
# empty shows OpenChronology. At most 60 characters.
PLATFORM_NAME=
# Where visitors can support this platform (GitHub Sponsors, Open Collective, your own page):
# an https:// address. It adds a Support link to the header and footer; empty shows none.
SUPPORT_URL=
# A Google Analytics 4 measurement ID (G-...). Empty disables analytics; when set, visitors
# are asked first, and Google's script loads only for those who accept. See docs/administration.md.
GOOGLE_ANALYTICS_ID=
# The landing page (docs/administration.md#landing-page): 1, true or yes shows a landing page
# at / and pages for each audience at /for/<audience>, and moves the timeline browser to
# /explore (which works either way). Empty or anything else keeps the browser at /.
LANDING_PAGE=
# A directory of Markdown files that replace the landing pages' copy, file by file (home.md,
# audiences.md, educators.md, …; see platform/content/landing/). Empty uses the built-in copy.
LANDING_CONTENT_DIR=
# Example timelines for the landing page, then for each audience's page: owner/slug addresses
# separated by commas, such as athan/deep-time,athan/ancient-egypt. Private, missing and
# labelled timelines are skipped; empty shows the browser's first public timelines, featured
# first.
LANDING_EXAMPLES=
LANDING_EXAMPLES_EDUCATORS=
LANDING_EXAMPLES_RESEARCHERS=
LANDING_EXAMPLES_INVESTIGATORS=
LANDING_EXAMPLES_OPERATIONS=
LANDING_EXAMPLES_WRITERS=
LANDING_EXAMPLES_DEVELOPERS=
# A YouTube video for the landing page, then for each audience's page, such as
# https://www.youtube.com/watch?v=…. It loads from youtube-nocookie.com only when a visitor
# plays it. Empty shows none; an address that is not a YouTube video stops the server starting.
LANDING_VIDEO=
LANDING_VIDEO_EDUCATORS=
LANDING_VIDEO_RESEARCHERS=
LANDING_VIDEO_INVESTIGATORS=
LANDING_VIDEO_OPERATIONS=
LANDING_VIDEO_WRITERS=
LANDING_VIDEO_DEVELOPERS=
# IndexNow (docs/administration.md#indexnow): a key of 8 to 128 letters, digits and dashes,
# such as the output of `openssl rand -hex 16`, served at /<key>.txt. When set, Bing, Yandex and
# other engines are told within minutes which public timelines and profiles changed. Empty is off.
INDEXNOW_KEY=
# Moments a timeline may hold, and as many durations and relationships: a whole number of
# at least 1000, or unlimited. Empty is 200000. See docs/administration.md before raising it.
TIMELINE_ENTRY_LIMIT=
# The most digits a time may have on this server, as an exact fraction in lowest terms:
# <numerator>/<denominator>, each from 20 to 1000000, or unlimited. Empty is 1000/65 (from
# 10^-64 to below 10^1000 of a timeline's unit). See docs/administration.md before raising it.
TIME_DIGIT_LIMIT=
# Links from a timeline's entities to other timelines (and to theirs), counting both ends:
# a whole number of at least 1, or unlimited. Empty is 10000. See docs/administration.md.
TIMELINE_LINK_LIMIT=
# The largest .och file exchanged with the server, from 1MiB to 1GiB (such as 128MiB). Empty
# is 64MiB. See docs/administration.md.
TIMELINE_FILE_BYTES=

# Cached downloads (docs/administration.md#cached-downloads): .ochx and .och files kept per
# revision. disk, s3 or off. Unset, disk when there is a directory: on Debian and RPM the
# service's cache directory, /var/cache/openchronology/exports; elsewhere EXPORT_CACHE_DIR.
EXPORT_CACHE=
# The disk cache's directory (with s3, where files are staged before upload). Under systemd
# the service writes only to its cache directory unless ReadWritePaths allows another.
EXPORT_CACHE_DIR=
# The most it holds, such as 10GB; empty is 2GiB. The least recently downloaded go first.
EXPORT_CACHE_MAX_BYTES=
# Optional: a web server or CDN serving the directory or bucket; public timelines' downloads
# redirect there once cached.
EXPORT_CACHE_PUBLIC_URL=
# For EXPORT_CACHE=s3: any S3-compatible service (AWS, R2, Spaces, MinIO…).
EXPORT_CACHE_S3_ENDPOINT=
EXPORT_CACHE_S3_REGION=
EXPORT_CACHE_S3_BUCKET=
EXPORT_CACHE_S3_PREFIX=
EXPORT_CACHE_S3_ACCESS_KEY_ID=
EXPORT_CACHE_S3_SECRET_ACCESS_KEY=
# 1 (default): https://endpoint/bucket/key; 0: https://bucket.endpoint/key.
EXPORT_CACHE_S3_PATH_STYLE=
# How many timelines can be compared at once, from 2 to 8.
COMPARE_TIMELINES_GUEST=4
COMPARE_TIMELINES_USER=8
COMPARE_TIMELINES_ADMIN=8
API_KEY_REQUESTS_PER_MINUTE=120
# Password checks run at once (1-64, about 128 MiB each); empty sizes it from the CPU cores.
PASSWORD_HASH_CONCURRENCY=

# Human verification: pow (self-hosted proof of work), turnstile, or off.
CHALLENGE_PROVIDER=pow
CHALLENGE_DIFFICULTY=150000
CHALLENGE_TRUST_DAYS=7
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sign-in providers: leave a pair empty to disable it. Callbacks are documented in
# /usr/share/doc/openchronology-server/authentication.md.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_GRAPH_VERSION=
# Set a provider's OAUTH_<NAME>_ENABLED=false to turn it off while keeping its ID and secret
# (for example while its app review is pending), e.g. OAUTH_FACEBOOK_ENABLED=false.
OAUTH_FACEBOOK_ENABLED=
# Microsoft (Entra ID) accounts. TENANT: organizations (default), common, consumers, or one
# tenant's ID or domain; LABEL: the button's name (Microsoft if empty).
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=
OAUTH_MICROSOFT_LABEL=

# Passkeys (authentication.md, "Passkeys"): false turns off signing in with a passkey alone,
# leaving passkeys as a second factor only. Empty or true allows it.
PASSKEY_SIGN_IN=

# Directory sign-in (LDAP or Active Directory) for a school or organisation: off unless
# LDAP_URL is set. See authentication.md, "Directory sign-in".
LDAP_URL=
LDAP_STARTTLS=
LDAP_TLS_CA=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_USERNAME_ATTRIBUTE=
LDAP_REQUIRED_GROUP=
LDAP_NESTED_GROUPS=
LDAP_LABEL=
# How often, in minutes, accounts are checked against the directory, ending the sessions and
# API keys of people who left it or LDAP_REQUIRED_GROUP. Empty for hourly; 0 turns it off.
LDAP_CHECK_MINUTES=

# Timeline UUIDs to feature on the dashboard, separated by commas.
FEATURED_TIMELINES=
# A JSON plugin library to offer besides the built-in plugins.
PLUGIN_LIBRARY=
