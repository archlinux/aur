post_install() {
    cat << "MSG"
:: Moore Threads MTT S30 DKMS module installed.
:: DKMS will automatically build the kernel module on kernel updates.
:: To verify the kernel module status, run:
::   dkms status -m mtgpu-s30
:: In case of emergency or black screen, boot with kernel parameter:
::   modprobe.blacklist=mtgpu
MSG
}

post_upgrade() {
    post_install
}
