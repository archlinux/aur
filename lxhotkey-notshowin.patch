Subject: [PATCH] Adjust desktop entry

Rename the launcher command while keeping the translated desktop name.
---
 plugins/gtk/lxhotkey-gtk.desktop.in | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/plugins/gtk/lxhotkey-gtk.desktop.in b/plugins/gtk/lxhotkey-gtk.desktop.in
index 682ac8a..70af61f 100644
--- a/plugins/gtk/lxhotkey-gtk.desktop.in
+++ b/plugins/gtk/lxhotkey-gtk.desktop.in
@@ -4,8 +4,7 @@ Icon=preferences-desktop-keyboard
 _Name=Setup Hot Keys
 _Comment=View and change Window Manager global shortcuts
 _Keywords=hotkey;shortcut;system;settings;
 Categories=DesktopSettings;Settings;Core;GTK;
-NotShowIn=GNOME;KDE;XFCE;MATE;
-Exec=lxhotkey --gui=gtk
+Exec=labhotkey --gui=gtk
 StartupNotify=true
 Terminal=false
