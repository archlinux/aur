+static void
+nouveau_copy_rect_m2mf(struct nvk_cmd_buffer *cmd,
+                       struct nouveau_copy *copy)
+{
+   assert(copy->src.bpp == copy->dst.bpp);
+   assert(copy->extent_el.depth == 1 || copy->extent_el.array_len == 1);
+
+   uint32_t layers = MAX2(copy->extent_el.depth, copy->extent_el.array_len);
+   for (unsigned z = 0; z < layers; z++) {
+      VkDeviceSize src_addr = copy->src.base_addr;
+      VkDeviceSize dst_addr = copy->dst.base_addr;
+
+      if (copy->src.image_type != VK_IMAGE_TYPE_3D)
+         src_addr += (z + copy->src.offset_el.a) * copy->src.array_stride;
+
+      if (copy->dst.image_type != VK_IMAGE_TYPE_3D)
+         dst_addr += (z + copy->dst.offset_el.a) * copy->dst.array_stride;
+
+      if (copy->src.tiling.gob_type == NIL_GOB_TYPE_LINEAR) {
+         src_addr += copy->src.offset_el.x * copy->src.bpp +
+                     copy->src.offset_el.y * copy->src.row_stride;
+      }
+
+      if (copy->dst.tiling.gob_type == NIL_GOB_TYPE_LINEAR) {
+         dst_addr += copy->dst.offset_el.x * copy->dst.bpp +
+                     copy->dst.offset_el.y * copy->dst.row_stride;
+      }
+
+      struct nv_push *p = nvk_cmd_buffer_push(cmd, 32);
+
+      P_MTHD(p, NV9039, OFFSET_OUT_UPPER);
+      P_NV9039_OFFSET_OUT_UPPER(p, dst_addr >> 32);
+      P_NV9039_OFFSET_OUT(p, dst_addr & 0xffffffff);
+
+      P_MTHD(p, NV9039, OFFSET_IN_UPPER);
+      P_NV9039_OFFSET_IN_UPPER(p, src_addr >> 32);
+      P_NV9039_OFFSET_IN(p, src_addr & 0xffffffff);
+      P_NV9039_PITCH_IN(p, copy->src.row_stride);
+      P_NV9039_PITCH_OUT(p, copy->dst.row_stride);
+      P_NV9039_LINE_LENGTH_IN(p, copy->extent_el.width * copy->src.bpp);
+      P_NV9039_LINE_COUNT(p, copy->extent_el.height);
+
+      uint32_t src_layout, dst_layout;
+      if (copy->src.tiling.gob_type != NIL_GOB_TYPE_LINEAR) {
+         assert(nil_gob_type_height(copy->src.tiling.gob_type) == 8);
+         P_MTHD(p, NV9039, SET_SRC_BLOCK_SIZE);
+         P_NV9039_SET_SRC_BLOCK_SIZE(p, {
+            .width = 0,
+            .height = copy->src.tiling.y_log2,
+            .depth = copy->src.tiling.z_log2,
+         });
+         P_NV9039_SET_SRC_WIDTH(p, copy->src.row_stride);
+         P_NV9039_SET_SRC_HEIGHT(p, copy->src.extent_el.height);
+         P_NV9039_SET_SRC_DEPTH(p, copy->src.extent_el.depth);
+         P_NV9039_SET_SRC_LAYER(p, copy->src.image_type == VK_IMAGE_TYPE_3D
+                                      ? (z + copy->src.offset_el.z) : 0);
+
+         P_MTHD(p, NV9039, SET_SRC_ORIGIN_BYTES_X);
+         P_NV9039_SET_SRC_ORIGIN_BYTES_X(p, copy->src.offset_el.x * copy->src.bpp);
+         P_NV9039_SET_SRC_ORIGIN_SAMPLES_Y(p, copy->src.offset_el.y);
+         src_layout = NV9039_LAUNCH_DMA_SRC_MEMORY_LAYOUT_BLOCKLINEAR;
+      } else {
+         src_layout = NV9039_LAUNCH_DMA_SRC_MEMORY_LAYOUT_PITCH;
+      }
+
+      if (copy->dst.tiling.gob_type != NIL_GOB_TYPE_LINEAR) {
+         assert(nil_gob_type_height(copy->dst.tiling.gob_type) == 8);
+         P_MTHD(p, NV9039, SET_DST_BLOCK_SIZE);
+         P_NV9039_SET_DST_BLOCK_SIZE(p, {
+            .width = 0,
+            .height = copy->dst.tiling.y_log2,
+            .depth = copy->dst.tiling.z_log2,
+         });
+         P_NV9039_SET_DST_WIDTH(p, copy->dst.row_stride);
+         P_NV9039_SET_DST_HEIGHT(p, copy->dst.extent_el.height);
+         P_NV9039_SET_DST_DEPTH(p, copy->dst.extent_el.depth);
+         P_NV9039_SET_DST_LAYER(p, copy->dst.image_type == VK_IMAGE_TYPE_3D
+                                      ? (z + copy->dst.offset_el.z) : 0);
+
+         P_MTHD(p, NV9039, SET_DST_ORIGIN_BYTES_X);
+         P_NV9039_SET_DST_ORIGIN_BYTES_X(p, copy->dst.offset_el.x * copy->dst.bpp);
+         P_NV9039_SET_DST_ORIGIN_SAMPLES_Y(p, copy->dst.offset_el.y);
+         dst_layout = NV9039_LAUNCH_DMA_DST_MEMORY_LAYOUT_BLOCKLINEAR;
+      } else {
+         dst_layout = NV9039_LAUNCH_DMA_DST_MEMORY_LAYOUT_PITCH;
+      }
+
+      P_IMMD(p, NV9039, LAUNCH_DMA, {
+         .src_inline = SRC_INLINE_FALSE,
+         .src_memory_layout = src_layout,
+         .dst_memory_layout = dst_layout,
+         .completion_type = COMPLETION_TYPE_FLUSH_ONLY,
+         .interrupt_type = INTERRUPT_TYPE_NONE,
+         .semaphore_struct_size = SEMAPHORE_STRUCT_SIZE_FOUR_WORDS,
+      });
+   }
+}
+
+static bool
+nouveau_copy_remap_is_identity(const struct nouveau_copy *copy)
+{
+   if (copy->remap.comp_size == 0)
+      return true;
+   if (copy->src.bpp != copy->dst.bpp)
+      return false;
+   uint32_t comps = copy->src.bpp / copy->remap.comp_size;
+   static const uint8_t identity[4] = {
+      NV90B5_SET_REMAP_COMPONENTS_DST_X_SRC_X,
+      NV90B5_SET_REMAP_COMPONENTS_DST_Y_SRC_Y,
+      NV90B5_SET_REMAP_COMPONENTS_DST_Z_SRC_Z,
+      NV90B5_SET_REMAP_COMPONENTS_DST_W_SRC_W,
+   };
+   for (uint32_t i = 0; i < comps && i < 4; i++) {
+      if (copy->remap.dst[i] != identity[i])
+         return false;
+   }
+   return true;
+}
+
 static void
 nouveau_copy_rect(struct nvk_cmd_buffer *cmd,
                   struct nouveau_copy *copy,
                   uint8_t data_transfer_type)
 {
+   if (nvk_device_physical(nvk_cmd_buffer_device(cmd))->info.cls_eng3d < KEPLER_A &&
+       nouveau_copy_remap_is_identity(copy)) {
+      nouveau_copy_rect_m2mf(cmd, copy);
+      return;
+   }
    uint32_t src_bw, dst_bw;
    if (copy->remap.comp_size > 0) {
       struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
