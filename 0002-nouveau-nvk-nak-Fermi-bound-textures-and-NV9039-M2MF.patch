+static void
+nvk_cmd_flush_gfx_bound_tex(struct nvk_cmd_buffer *cmd)
+{
+   if (nvk_cmd_buffer_3d_cls(cmd) >= KEPLER_A)
+      return;
+
+   struct nvk_descriptor_state *desc = &cmd->state.gfx.descriptors;
+
+   for (mesa_shader_stage stage = 0; stage < MESA_SHADER_MESH_STAGES; stage++) {
+      const struct nvk_shader *shader = cmd->state.gfx.shaders[stage];
+      if (shader == NULL || shader->bound_tex_map.tex_count == 0)
+         continue;
+
+      uint32_t group = nvk_cbuf_binding_for_stage(stage, false);
+      nvk_cmd_buffer_emit_bound_tex(cmd, desc, &shader->bound_tex_map,
+                                    SUBC_NV9097,
+                                    0x2400 + 0x20 * group,
+                                    0x2404 + 0x20 * group);
+   }
+}
