+static bool
+try_add_bound_tex(struct nvk_bound_tex_map *map,
+                  const struct nvk_bound_tex *entry,
+                  uint32_t *slot_out)
+{
+   for (uint32_t i = 0; i < map->tex_count; i++) {
+      if (memcmp(&map->texs[i], entry, sizeof(*entry)) == 0) {
+         *slot_out = i;
+         return true;
+      }
+   }
+
+   if (map->tex_count >= NVK_MAX_BOUND_TEX)
+      return false;
+
+   *slot_out = map->tex_count;
+   map->texs[map->tex_count++] = *entry;
+   return true;
+}
