+static struct nvk_sampled_image_descriptor
+nvk_cmd_buffer_read_sampled_image_desc(const struct nvk_descriptor_state *desc,
+                                       uint8_t set_idx, uint32_t offset)
+{
+   struct nvk_sampled_image_descriptor img_desc = {0};
+
+   if (set_idx >= NVK_MAX_SETS)
+      return img_desc;
+
+   switch (desc->sets[set_idx].type) {
+   case NVK_DESCRIPTOR_SET_TYPE_SET: {
+      struct nvk_descriptor_set *set = desc->sets[set_idx].set;
+      if (set != NULL && set->map != NULL)
+         memcpy(&img_desc, (const uint8_t *)set->map + offset, sizeof(img_desc));
+      break;
+   }
+   case NVK_DESCRIPTOR_SET_TYPE_PUSH: {
+      struct nvk_push_descriptor_set *push = desc->sets[set_idx].push;
+      if (push != NULL)
+         memcpy(&img_desc, &push->data[offset], sizeof(img_desc));
+      break;
+   }
+   default:
+      break;
+   }
+
+   return img_desc;
+}
+
+void
+nvk_cmd_buffer_emit_bound_tex(struct nvk_cmd_buffer *cmd,
+                              const struct nvk_descriptor_state *desc,
+                              const struct nvk_bound_tex_map *map,
+                              uint8_t subc,
+                              uint32_t bind_tsc_mthd,
+                              uint32_t bind_tic_mthd)
+{
+   if (map->tex_count == 0)
+      return;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 4 * map->tex_count);
+   for (uint32_t slot = 0; slot < map->tex_count; slot++) {
+      const struct nvk_bound_tex *bt = &map->texs[slot];
+      struct nvk_sampled_image_descriptor tex_desc =
+         nvk_cmd_buffer_read_sampled_image_desc(desc, bt->tex_set,
+                                                bt->tex_desc_offset);
+      uint32_t tic_idx = tex_desc.image_index;
+      uint32_t tsc_idx = 0;
+      if (bt->has_sampler) {
+         struct nvk_sampled_image_descriptor samp_desc =
+            (bt->samp_set == bt->tex_set &&
+             bt->samp_desc_offset == bt->tex_desc_offset)
+            ? tex_desc
+            : nvk_cmd_buffer_read_sampled_image_desc(desc, bt->samp_set,
+                                                     bt->samp_desc_offset);
+         tsc_idx = samp_desc.sampler_index;
+      }
+
+      __push_mthd(p, subc, bind_tsc_mthd);
+      P_INLINE_DATA(p, (tsc_idx << 12) | (slot << 4) | 1);
+      __push_mthd(p, subc, bind_tic_mthd);
+      P_INLINE_DATA(p, (tic_idx << 9) | (slot << 1) | 1);
+   }
+}
