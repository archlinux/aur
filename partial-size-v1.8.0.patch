+		if (read_partial_image(flash, newcontents, flash_size, filename, &partial_layout))
+			goto _free_ret;
+	} else if (filename) {
 		if (read_buf_from_file(newcontents, flash_size, filename))
 			goto _free_ret;
 	}
@@ -733,14 +847,16 @@ static int do_write(struct flashctx *const flash, const char *const filename, co
 	ret = flashrom_image_write(flash, newcontents, flash_size, refcontents);
 
 _free_ret:
+	release_partial_layout(flash, partial_layout);
 	free(refcontents);
 	free(newcontents);
 	return ret;
 }
 
