-static int do_write(struct flashctx *const flash, const char *const filename, const char *const referencefile)
+/**
+ * @brief Read an image that may be smaller than the flash (--ignore-size).
+ *
+ * The image is placed at offset 0 of @p buf (the remainder is left as is). If it
+ * is smaller than the flash, a layout with a single included region covering
+ * the image is installed, so that only that part of the flash is written or
+ * verified and the rest of the chip stays untouched.
+ *
+ * @param flash      Flash context.
+ * @param buf        Flash-sized buffer to fill.
+ * @param flash_size Size of the flash and of @p buf.
+ * @param filename   Image file, or "-" for standard input.
+ * @param layout     On success, set to the installed layout (NULL if the image
+ *                   covers the whole flash). Release it with
+ *                   release_partial_layout() when done.
+ * @return 0 on success, 1 on error.
+ */
+static int read_partial_image(struct flashctx *const flash, uint8_t *const buf, const size_t flash_size,
+			      const char *const filename, struct flashrom_layout **const layout)
+{
+	const bool from_stdin = !strcmp(filename, "-");
+	FILE *const image = from_stdin ? fdopen(fileno(stdin), "rb") : fopen(filename, "rb");
+	size_t len;
+
+	*layout = NULL;
+	if (!image) {
+		msg_gerr("Error: opening file \"%s\" failed: %s\n", filename, strerror(errno));
+		return 1;
+	}
+	len = fread(buf, 1, flash_size, image);
+	if (ferror(image)) {
+		msg_gerr("Error: reading file \"%s\" failed: %s\n", filename, strerror(errno));
+		(void)fclose(image);
+		return 1;
+	}
+	if (len == flash_size && fgetc(image) != EOF) {
+		msg_gerr("Error: Image is larger than the flash chip (%zu B)!\n", flash_size);
+		(void)fclose(image);
+		return 1;
+	}
+	(void)fclose(image);
+
+	if (len == 0) {
+		msg_gerr("Error: Image \"%s\" is empty!\n", filename);
+		return 1;
+	}
+	if (len == flash_size)
+		return 0;
+
+	if (set_prefix_layout(flash, len, layout))
+		return 1;
+	msg_ginfo("Ignoring image size: using %zu B of %zu B (0x%06x-0x%06zx), "
+		  "the rest of the flash is left untouched.\n", len, flash_size, 0, len - 1);
+	return 0;
+}
+
+static int do_write(struct flashctx *const flash, const char *const filename, const char *const referencefile,
+		    const bool ignore_size)
 {
 	const size_t flash_size = flashrom_flash_getsize(flash);
+	struct flashrom_layout *partial_layout = NULL;
 	int ret = 1;
 
 	uint8_t *const newcontents = alloc_flashsize_buf(flash);
@@ -714,7 +825,10 @@ static int do_write(struct flashctx *const flash, const char *const filename, co
 		goto _free_ret;
 
 	/* Read '-w' argument first... */
-	if (filename) {
