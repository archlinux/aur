+/**
+ * @brief Install a layout with a single included region [0, len) (for --read-size/--ignore-size).
+ *
+ * @return 0 on success, 1 on error.
+ */
+static int set_prefix_layout(struct flashctx *const flash, const size_t len, struct flashrom_layout **const layout)
 {
+	if (flashrom_layout_new(layout) ||
+	    flashrom_layout_add_region(*layout, 0, len - 1, "prefix") ||
+	    flashrom_layout_include_region(*layout, "prefix")) {
+		flashrom_layout_release(*layout);
+		*layout = NULL;
+		return 1;
+	}
+	flashrom_layout_set(flash, *layout);
+	return 0;
+}
+
+static void release_partial_layout(struct flashctx *const flash, struct flashrom_layout *const layout)
+{
+	if (!layout)
+		return;
+	flashrom_layout_set(flash, NULL);
+	flashrom_layout_release(layout);
+}
+
+static int do_read(struct flashctx *const flash, const char *const filename, const size_t read_size)
+{
+	struct flashrom_layout *partial_layout = NULL;
