# Settings for the Cinemion service. Restart it after changing them: sudo systemctl restart cinemion
# Every setting is described in .env.example in the source: https://github.com/LucasionGS/cinemion

#####################
# Server
#####################
# Port Cinemion listens on (web UI and API).
PORT=8600
# Public address when Cinemion is behind a reverse proxy, e.g. https://cinemion.example.com. Leave empty on a LAN.
SITE_URL=

#####################
# Folders
#####################
# Folders the library folder browser may show, separated by ":". The cinemion user must be able to read them.
MEDIA_ROOTS=/srv:/mnt:/media:/home

#####################
# Online services
#####################
# TMDB API key, used when none is set in Settings › Metadata.
TMDB_API_KEY=
# OpenSubtitles API key, used when none is set in Settings › Subtitles.
OPENSUBTITLES_API_KEY=
