# ─────────────────────────────────────────────────────────────────────────────
# AnythingLLM – Server environment configuration
# Managed at: /etc/anythingllm/server.env
#
# This file is loaded by both systemd service units. After the first
# successful boot, AnythingLLM will manage most settings through its web UI
# and write them back here automatically.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: Absolute path to the storage directory.
# Stores vectors, uploaded documents, SQLite database, and models.
STORAGE_DIR="/var/lib/anythingllm/storage"

# Server port (default: 3001)
SERVER_PORT=3001

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set via the web UI after first boot, or pre-configure here.
# LLM_PROVIDER=openai
# OPEN_AI_KEY=sk-...
# OPEN_MODEL_PREF=gpt-4o

# ─── Vector Database ─────────────────────────────────────────────────────────
# Defaults to the built-in LanceDB (no extra config needed).
# VECTOR_DB=lancedb

# ─── Authentication ───────────────────────────────────────────────────────────
# Leave blank to configure through the setup wizard on first boot.
# AUTH_TOKEN=
# JWT_SECRET=

# ─── Telemetry ───────────────────────────────────────────────────────────────
# Set to "true" to disable anonymous usage analytics.
DISABLE_TELEMETRY=true
