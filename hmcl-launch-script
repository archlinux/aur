#!/bin/bash

if [[ "$1" != "-p" ]]; then
    WORKDIR=${XDG_CONFIG_HOME:-$HOME/.config}/hmcl-no-download-restriction
    mkdir -p "$WORKDIR"
    cd "$WORKDIR" || exit 1
    ls hmcl.json > /dev/null 2>&1 || touch hmcl.json
fi

exec /usr/bin/java "$@" -jar "/usr/share/java/hmcl-no-download-restriction/hmcl-no-download-restriction.jar"
