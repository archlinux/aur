[Unit]
Description=Conquest C2 Server
After=network.target

[Service]
Type=simple
Environment="NIMBLE_PATH=/usr/share/conquest/vendor/pkgs2/"
ExecStart=/usr/share/conquest/bin/server -p /etc/conquest/default.toml
WorkingDirectory=/usr/share/conquest/
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5s
User=conquest
Group=conquest

CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/usr/share/conquest/
ReadOnlyPaths=/etc/conquest/
ProtectHome=yes

[Install]
WantedBy=multi-user.target
