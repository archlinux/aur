# Learn how to configure the Mercure.rocks Hub on https://mercure.rocks/docs/hub/config
{
    http_port 3000
    https_port 3001

    # Debug mode (disable it in production!)
    debug
}

# Automatic HTTPS does not work with the systemd service unit.
# Change port to your https_port and enable the tls setting, if you want to use HTTPS.
:3000

#tls /etc/ssl/certs/cert.pem /etc/ssl/private/key.pem

log

route {
    encode zstd gzip

    mercure {
        # Transport to use (default to Bolt)
        transport bolt {
            path /run/mercure/mercure.db
        }

        # An empty issuer block lets playground default it to the well-known
        # dev signing key and mint its own all-access token.
        issuer https://localhost {
        }

        # playground implies debugger, anonymous, subscriptions and wildcard
        # origins. Dev only, never in prod.
        playground
    }

    respond /healthz 200

    respond "Not Found" 404
}
