From f29fca452a213320fa470e59e370e376f3707ba6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Gallet?= <clement.gallet@ens-lyon.org>
Date: Tue, 21 Jul 2026 22:29:13 +0200
Subject: [PATCH] Fix SharedConfig variable not being initialized at
 compile-time, resulting in loss of value after libtas constructor (#749)

---
 configure.ac                                               | 4 ++--
 src/library/global.cpp                                     | 7 +++++--
 .../steam/isteamremotestorage/isteamremotestorage.cpp      | 2 +-
 src/library/steam/isteamuser/isteamuser.cpp                | 2 +-
 src/shared/SharedConfig.h                                  | 2 +-
 5 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/configure.ac b/configure.ac
index 32f1bd8b6..a399e0f5d 100644
--- a/configure.ac
+++ b/configure.ac
@@ -35,9 +35,9 @@ case $host in
     ;;
 esac
 
-dnl Prefer C++20, fall back to C++17
+dnl Use C++20
 AC_LANG_PUSH([C++])
-for flag in -std=c++20 -std=c++17; do
+for flag in -std=c++20; do
   AC_MSG_CHECKING([whether $CXX supports $flag])
   save_CXXFLAGS="$CXXFLAGS"
   CXXFLAGS="$CXXFLAGS $flag"
diff --git a/src/library/global.cpp b/src/library/global.cpp
index a83526d93..f8f41bf71 100644
--- a/src/library/global.cpp
+++ b/src/library/global.cpp
@@ -21,8 +21,11 @@
 
 namespace libtas {
 
-SharedConfig Global::shared_config;
-GameInfo Global::game_info;
+/* We use constinit to make sure these globals are initialized at compile time. If not, 
+ * the library constructor could be executed before those globals are initialized,
+ * resulting in overwriting the globals with their default values. */
+constinit SharedConfig Global::shared_config;
+constinit GameInfo Global::game_info;
 volatile bool Global::is_inited = false;
 volatile bool Global::is_exiting = false;
 volatile bool Global::is_fork = false;
diff --git a/src/library/steam/isteamremotestorage/isteamremotestorage.cpp b/src/library/steam/isteamremotestorage/isteamremotestorage.cpp
index 35c7156dc..07eac3b74 100644
--- a/src/library/steam/isteamremotestorage/isteamremotestorage.cpp
+++ b/src/library/steam/isteamremotestorage/isteamremotestorage.cpp
@@ -45,7 +45,7 @@ namespace libtas {
 
 DEFINE_ORIG_POINTER(SteamRemoteStorage)
 
-char steamremotestorage[2048] = "/NOTVALID";
+static char steamremotestorage[2048] = "/NOTVALID";
 static const char *steamremotestorage_version = NULL;
 
 void SteamSetRemoteStorageFolder(std::string path)
diff --git a/src/library/steam/isteamuser/isteamuser.cpp b/src/library/steam/isteamuser/isteamuser.cpp
index a8fd00889..e927fd18b 100644
--- a/src/library/steam/isteamuser/isteamuser.cpp
+++ b/src/library/steam/isteamuser/isteamuser.cpp
@@ -38,7 +38,7 @@ namespace libtas {
 
 DEFINE_ORIG_POINTER(SteamUser)
 
-char steamuserdir[2048] = "/NOTVALID";
+static char steamuserdir[2048] = "/NOTVALID";
 static const char *steamuser_version = NULL;
 
 void SteamSetUserDataFolder(std::string path)
diff --git a/src/shared/SharedConfig.h b/src/shared/SharedConfig.h
index 44a529a88..3a0247ceb 100644
--- a/src/shared/SharedConfig.h
+++ b/src/shared/SharedConfig.h
@@ -283,7 +283,7 @@ struct __attribute__((packed, aligned(8))) SharedConfig {
     bool mouse_prevent_warp = false;
 
     /* Display OSD main menu */
-    bool osd;
+    bool osd = true;
 
     /* Display OSD in the video encode */
     bool osd_encode = false;
