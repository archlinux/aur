#!/usr/bin/bash
set -euo pipefail

die() {
    printf 'paru-makepkg-jail: %s\n' "$*" >&2
    exit 1
}

# Find makepkg-jail beside this script, including after packaging.
self=$(readlink -f -- "${BASH_SOURCE[0]}")
jail="$(dirname -- "$self")/makepkg-jail"
[[ -x "$jail" ]] || die "Missing executable: $jail"

work=$(pwd -P)
case "$work" in
    *$'\n'*) die "Workspace paths containing newlines are unsupported." ;;
esac

# Support the exact invocations observed from your installed paru.
# Unknown invocations fail rather than guessing their network needs.
mode=

case "${1:-}" in
    --printsrcinfo|--packagelist)
        query_option=$1

        for arg in "${@:2}"; do
            case "$arg" in
                --ignorearch|-A) ;;
                *)
                    die "Unsupported modifier for $query_option: $arg"
                    ;;
            esac
        done

        case "$query_option" in
            --printsrcinfo) mode=metadata ;;
            --packagelist)  mode=packagelist ;;
        esac
        ;;

    --verifysource)
        if (( $# == 3 )) &&
            [[ "$2" == -Af && "$3" == -Cc ]]; then
            mode=verify
        fi ;;
    -ofA)
        if (( $# == 2 )) && [[ "$2" == -C ]]; then
            mode=online
        fi ;;
    -feA)
        if (( $# == 5 )) &&
            [[ "$2" == --noconfirm &&
               "$3" == --noprepare &&
               "$4" == --holdver &&
               "$5" == -c ]]; then
            mode=build
        fi ;;
esac

case "$mode" in
    online)
        exec "$jail" --online "$@"
        ;;

    metadata|build)
        exec "$jail" "$@"
        ;;

    packagelist)
        # Keep diagnostics on stderr. Validate all paths before emitting
        # anything, then translate sandbox paths to host workspace paths.
        paths=$("$jail" "$@")
        [[ -n "$paths" ]] || die "makepkg returned an empty package list."

        translated=()
        while IFS= read -r path; do
            [[ "$path" == /work/* ]] ||
                die "Unexpected package path: $path"

            filename=${path#/work/}
            [[ -n "$filename" &&
               "$filename" != */* &&
               "$filename" != "." &&
               "$filename" != ".." ]] ||
                die "Package path is not a direct workspace child: $path"

            translated+=("$work/$filename")
        done <<< "$paths"

        printf '%s\n' "${translated[@]}"
        ;;

    *)
        printf 'paru-makepkg-jail: unsupported makepkg invocation:' >&2
        printf ' %q' "$@" >&2
        printf '\n' >&2
        exit 64
        ;;
esac
