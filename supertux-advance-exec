#!/usr/bin/env bash

cd /opt/supertux-advance/ #because `sta` have addressed libraries relative to itself, we can't use
                          # /opt/supertux-advance/sta, while we are on ~,
                          # it looks for ./src, ./res,... in its Current Working directory
