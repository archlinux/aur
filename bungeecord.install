_game="bungeecord"
_user="bungeecord"
_server_root="/srv/bungeecord"

post_install() {
  echo "The server data is stored under ${_server_root} and the server runs as ${_user} user to increase security."
  echo "Use the ${_game} script under /usr/bin/${_game} to start, stop or backup each individual server, specifying its name."
  echo "Adjust the global configuration file under /etc/conf.d/${_game} to your liking."
  echo "You can create as many servers as you want. For each one, create servername.conf under ${_server_root}/servers as root and a servername folder owned by ${_user} (install -d -o ${_user} -g ${_user} ${_server_root}/servers/servername), tweak the configuration to your liking and put whichever server software you need (spigot, paper, etc)."
  echo "By default, ${_game} is installed as subserver proxy, under ${_server_root}/servers/proxy"
  echo "You can start it by using ${_game} proxy start"
}

post_upgrade() {
  if (( $(vercmp "$2" 2111-1) < 0 )); then
    echo "${_server_root}, ${_server_root}/servers and the .conf files in it now belong to root, because ${_game} sources them as the user who runs it. Edit them as root, only the subserver folders belong to ${_user}."
    echo "The jar moved to /usr/share/java/${_game}/BungeeCord.jar, ${_server_root}/servers/proxy/server.jar links to it."
    echo "Backups are enabled per subserver now: systemctl enable --now ${_game}-backup@servername.timer"
    echo "proxy.conf now backs up config.yml and plugins, merge ${_server_root}/servers/proxy.conf.pacnew if pacman created one."
  fi
}

post_remove() {
  [[ -d "${_server_root}" ]] && echo "Game saves in ${_server_root} were kept on your system."
  echo "The ${_user} user was preserved on your system."
}
