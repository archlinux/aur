post_install() {
    mkdir -p /var/lib/ocsinventory-agent
    mkdir -p /var/log/ocsinventory-agent
    chmod 755 /var/lib/ocsinventory-agent
    chmod 755 /var/log/ocsinventory-agent

    local response
    while ! [[ $response =~ ^[YyNn]$ ]]; do
        read -p $'\nEdit config? (y/n): ' -n 1 response
        echo ""
    done
    [[ $response =~ ^[Yy]$ ]] && ${EDITOR:-nano} /etc/ocsinventory/ocsinventory-agent.cfg || echo "Edit: /etc/ocsinventory/ocsinventory-agent.cfg"
}

pre_remove() {
    echo "Configuration preserved at /etc/ocsinventory/"
}
