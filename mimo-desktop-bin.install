# Mirrors the upstream Debian postinst/postrm: the sandbox helper only needs
# the setuid bit when unprivileged user namespaces are unavailable, and the
# bundled AppArmor profile is loaded when AppArmor is actually enabled.

_mimo_sandbox() {
  if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
    chmod 4755 '/opt/Xiaomi MiMo/chrome-sandbox' || true
  else
    chmod 0755 '/opt/Xiaomi MiMo/chrome-sandbox' || true
  fi
}

_mimo_apparmor_load() {
  local _profile='/opt/Xiaomi MiMo/resources/apparmor-profile'
  local _target='/etc/apparmor.d/xiaomi-mimo-desktop'

  command -v apparmor_status >/dev/null 2>&1 || return 0
  apparmor_status --enabled >/dev/null 2>&1 || return 0
  command -v apparmor_parser >/dev/null 2>&1 || return 0
  [[ -f "${_profile}" ]] || return 0

  # Dry-run the parser the same way the Debian package does; skip the profile
  # on AppArmor versions that do not support its abi/4.0 declaration.
  apparmor_parser --skip-kernel-load --debug "${_profile}" >/dev/null 2>&1 || return 0

  install -Dm644 "${_profile}" "${_target}"
  if ! { [[ -x /usr/bin/ischroot ]] && /usr/bin/ischroot; }; then
    apparmor_parser --replace --write-cache --skip-read-cache "${_target}" || true
  fi
}

post_install() {
  _mimo_sandbox
  _mimo_apparmor_load
}

post_upgrade() {
  _mimo_sandbox
  _mimo_apparmor_load
}

post_remove() {
  local _target='/etc/apparmor.d/xiaomi-mimo-desktop'

  [[ -f "${_target}" ]] || return 0
  if command -v apparmor_status >/dev/null 2>&1 \
    && apparmor_status --enabled >/dev/null 2>&1 \
    && command -v apparmor_parser >/dev/null 2>&1 \
    && ! { [[ -x /usr/bin/ischroot ]] && /usr/bin/ischroot; }; then
    apparmor_parser --remove "${_target}" || true
  fi
  rm -f "${_target}"
}
