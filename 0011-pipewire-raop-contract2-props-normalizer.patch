+static void test_contract2_props_normalizer(void)
+{
+	uint8_t input_buffer[1024], output_buffer[1024];
+	struct spa_pod_builder input =
+		SPA_POD_BUILDER_INIT(input_buffer, sizeof(input_buffer));
+	struct spa_pod_builder output =
+		SPA_POD_BUILDER_INIT(output_buffer, sizeof(output_buffer));
+	struct contract2_props props = {
+		.scalar = true,
+		.scalar_value = 1.0f,
+		.mute = true,
+		.mute_value = true,
+		.channels = true,
+		.channel_values = { 0.125f, 0.125f },
+		.n_channels = 2,
+		.soft_mute = true,
+		.soft_mute_value = true,
+		.soft_volumes = true,
+		.soft_values = { 1.0f, 1.0f },
+		.n_soft_volumes = 2,
+	};
+	const struct spa_pod *param, *correction = NULL;
+
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == RAOP_VOLUME_CONTRACT2_APPLY);
+	assert_contract2_canonical(correction, true);
+
+	/* A complete scalar-bearing tuple with the wrong channel count is
+	 * managed input, but cannot be applied to this two-channel sink. */
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.n_channels = 1;
+	props.n_soft_volumes = 1;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_assert_se(correction == NULL);
+	props.n_channels = 2;
+	props.n_soft_volumes = 2;
+
+	/* Any non-canonical managed field is invalid, not a source from which
+	 * logical or hardware intent may be synthesized. */
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.scalar_value = 0.5f;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_assert_se(correction == NULL);
+
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.scalar_value = 1.0f;
+	props.soft_mute_value = false;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_assert_se(correction == NULL);
+
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.soft_mute_value = true;
+	props.soft_values[1] = 0.5f;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_assert_se(correction == NULL);
+
+	/* A complete, already-canonical scalar-less follower is the sole managed
+	 * no-op. It is never promoted into a scalar-bearing intent. */
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.scalar = false;
+	props.soft_values[1] = 1.0f;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == RAOP_VOLUME_CONTRACT2_VETO);
+	spa_assert_se(correction == NULL);
+
+	/* Unrelated Props remain a true no-op; partial managed Props are vetoed. */
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props = (struct contract2_props){ 0 };
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == RAOP_VOLUME_CONTRACT2_UNRELATED);
+	spa_assert_se(correction == NULL);
+
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props = (struct contract2_props){
+		.scalar = true,
+		.scalar_value = NAN,
+		.mute = true,
+		.mute_value = false,
+		.soft_mute = true,
+		.soft_mute_value = true,
+	};
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_assert_se(correction == NULL);
+
+	/* Duplicated, asymmetric, non-finite, and ramped managed shapes are all
+	 * invalid so the callback can actively veto the outer SetParam. */
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props = (struct contract2_props){
+		.channels = true,
+		.channel_values = { 0.125f, 0.216f },
+		.n_channels = 2,
+	};
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.channel_values[1] = NAN;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.channel_values[1] = props.channel_values[0];
+	props.duplicate_channels = true;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+	spa_pod_builder_init(&input, input_buffer, sizeof(input_buffer));
+	spa_pod_builder_init(&output, output_buffer, sizeof(output_buffer));
+	props.duplicate_channels = false;
+	props.ramp = true;
+	param = build_contract2_props(&input, &props);
+	spa_assert_se(raop_volume_contract2_normalize_props(param, 2, &output,
+			&correction) == -EINVAL);
+}
