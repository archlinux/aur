+static void assert_contract2_canonical(const struct spa_pod *param,
+		bool expected_mute)
+{
+	const struct spa_pod_object *object =
+		(const struct spa_pod_object *)param;
+	struct spa_pod_prop *prop;
+	uint32_t properties = 0;
+
+	spa_assert(param != NULL && spa_pod_is_object(param));
+	SPA_POD_OBJECT_FOREACH(object, prop) {
+		properties++;
+		switch (prop->key) {
+		case SPA_PROP_volume:
+		{
+			float value;
+
+			spa_assert_se(spa_pod_get_float(&prop->value, &value) == 0);
+			spa_assert_se(value == 1.0f);
+			break;
+		}
+		case SPA_PROP_softVolumes:
+		{
+			const float *values;
+			uint32_t count, value_size, value_type, i;
+
+			values = spa_pod_get_array_full(&prop->value, &count,
+					&value_size, &value_type);
+			spa_assert_se(values != NULL && value_type == SPA_TYPE_Float &&
+					value_size == sizeof(float) && count == 2);
+			for (i = 0; i < count; i++)
+				spa_assert_se(values[i] == 1.0f);
+			break;
+		}
+		case SPA_PROP_softMute:
+		{
+			bool muted;
+
+			spa_assert_se(spa_pod_get_bool(&prop->value, &muted) == 0);
+			spa_assert_se(muted == expected_mute);
+			break;
+		}
+		case SPA_PROP_channelVolumes:
+		{
+			const float *values;
+			uint32_t count, value_size, value_type, i;
+
+			values = spa_pod_get_array_full(&prop->value, &count,
+					&value_size, &value_type);
+			spa_assert_se(values != NULL && value_type == SPA_TYPE_Float &&
+					value_size == sizeof(float) && count == 2);
+			for (i = 0; i < count; i++)
+				spa_assert_se(values[i] == 0.125f);
+			break;
+		}
+		case SPA_PROP_mute:
+		{
+			bool muted;
+
+			spa_assert_se(spa_pod_get_bool(&prop->value, &muted) == 0);
+			spa_assert_se(muted == expected_mute);
+			break;
+		}
+		default:
+			spa_assert_not_reached();
+		}
+	}
+	spa_assert_se(properties == 5);
+}
