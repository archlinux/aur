+int raop_volume_contract2_normalize_props(const struct spa_pod *param,
+		uint32_t expected_channels,
+		struct spa_pod_builder *builder,
+		const struct spa_pod **correction)
+{
+	const struct spa_pod_object *object;
+	struct spa_pod_prop *prop;
+	struct spa_pod_frame frame;
+	float scalar = 1.0f;
+	const float *channels = NULL, *soft_volumes = NULL;
+	uint32_t n_channels = 0, n_soft_volumes = 0;
+	bool mute = false, soft_mute = false;
+	bool have_scalar = false, have_channels = false, have_mute = false;
+	bool have_soft_volumes = false, have_soft_mute = false;
+	bool recognized = false;
+	uint32_t i;
+
+	if (correction == NULL)
+		return -EINVAL;
+	*correction = NULL;
+	if (param == NULL || expected_channels == 0 ||
+			expected_channels > SPA_AUDIO_MAX_CHANNELS || builder == NULL ||
+			!spa_pod_is_object(param))
+		return -EINVAL;
+	object = (const struct spa_pod_object *)param;
+	if (object->body.type != SPA_TYPE_OBJECT_Props ||
+			object->body.id != SPA_PARAM_Props)
+		return -EINVAL;
+
+	SPA_POD_OBJECT_FOREACH(object, prop) {
+		switch (prop->key) {
+		case SPA_PROP_volume:
+			recognized = true;
+			if (have_scalar ||
+					spa_pod_get_float(&prop->value, &scalar) < 0)
+				return -EINVAL;
+			have_scalar = true;
+			break;
+		case SPA_PROP_channelVolumes:
+		{
+			uint32_t value_size, value_type;
+
+			recognized = true;
+			if (have_channels)
+				return -EINVAL;
+			have_channels = true;
+			channels = spa_pod_get_array_full(&prop->value,
+					&n_channels, &value_size, &value_type);
+			if (channels == NULL || value_type != SPA_TYPE_Float ||
+					value_size != sizeof(float) || n_channels == 0 ||
+					n_channels > SPA_AUDIO_MAX_CHANNELS ||
+					raop_volume_validate_channels(channels,
+						n_channels, NULL) < 0)
+				n_channels = 0;
+			for (i = 1; i < n_channels; i++) {
+				if (channels[i] != channels[0]) {
+					n_channels = 0;
+					break;
+				}
+			}
+			break;
+		}
+		case SPA_PROP_mute:
+			recognized = true;
+			if (have_mute || spa_pod_get_bool(&prop->value, &mute) < 0)
+				return -EINVAL;
+			have_mute = true;
+			break;
+		case SPA_PROP_softVolumes:
+		{
+			uint32_t value_size, value_type;
+
+			recognized = true;
+			if (have_soft_volumes)
+				return -EINVAL;
+			have_soft_volumes = true;
+			soft_volumes = spa_pod_get_array_full(&prop->value,
+					&n_soft_volumes, &value_size, &value_type);
+			if (soft_volumes == NULL || value_type != SPA_TYPE_Float ||
+					value_size != sizeof(float)) {
+				soft_volumes = NULL;
+				n_soft_volumes = 0;
+			}
+			break;
+		}
+		case SPA_PROP_softMute:
+			recognized = true;
+			if (have_soft_mute ||
+					spa_pod_get_bool(&prop->value, &soft_mute) < 0)
+				return -EINVAL;
+			have_soft_mute = true;
+			break;
+		case SPA_PROP_volumeRampSamples:
+		case SPA_PROP_volumeRampStepSamples:
+		case SPA_PROP_volumeRampTime:
+		case SPA_PROP_volumeRampStepTime:
+		case SPA_PROP_volumeRampScale:
+			return -EINVAL;
+		default:
+			break;
+		}
+	}
+
+	if (!recognized)
+		return RAOP_VOLUME_CONTRACT2_UNRELATED;
+	if (!have_channels || n_channels != expected_channels || !have_mute ||
+			!have_soft_volumes ||
+			n_soft_volumes != expected_channels ||
+			!have_soft_mute || soft_mute != mute)
+		return -EINVAL;
+	for (i = 0; i < n_soft_volumes; i++) {
+		if (!isfinite(soft_volumes[i]) || soft_volumes[i] != 1.0f)
+			return -EINVAL;
+	}
+	if (!have_scalar)
+		return RAOP_VOLUME_CONTRACT2_VETO;
+	if (!isfinite(scalar) || scalar != 1.0f)
+		return -EINVAL;
+
+	spa_pod_builder_push_object(builder, &frame,
+			SPA_TYPE_OBJECT_Props, SPA_PARAM_Props);
+	spa_pod_builder_prop(builder, SPA_PROP_volume, 0);
+	spa_pod_builder_float(builder, 1.0f);
+	spa_pod_builder_prop(builder, SPA_PROP_mute, 0);
+	spa_pod_builder_bool(builder, mute);
+	spa_pod_builder_prop(builder, SPA_PROP_channelVolumes, 0);
+	spa_pod_builder_array(builder, sizeof(float), SPA_TYPE_Float,
+			n_channels, channels);
+	spa_pod_builder_prop(builder, SPA_PROP_softVolumes, 0);
+	spa_pod_builder_array(builder, sizeof(float), SPA_TYPE_Float,
+			n_channels, soft_volumes);
+	spa_pod_builder_prop(builder, SPA_PROP_softMute, 0);
+	spa_pod_builder_bool(builder, mute);
+	*correction = spa_pod_builder_pop(builder, &frame);
+	return *correction == NULL ? -ENOSPC : RAOP_VOLUME_CONTRACT2_APPLY;
+}
