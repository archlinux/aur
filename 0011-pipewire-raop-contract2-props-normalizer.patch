+struct contract2_props {
+	bool scalar;
+	float scalar_value;
+	bool mute;
+	bool mute_value;
+	bool channels;
+	float channel_values[2];
+	uint32_t n_channels;
+	bool soft_mute;
+	bool soft_mute_value;
+	bool soft_volumes;
+	float soft_values[2];
+	uint32_t n_soft_volumes;
+	bool duplicate_channels;
+	bool ramp;
+};
+
+static const struct spa_pod *build_contract2_props(
+		struct spa_pod_builder *builder,
+		const struct contract2_props *props)
+{
+	struct spa_pod_frame frame;
+
+	spa_pod_builder_push_object(builder, &frame,
+			SPA_TYPE_OBJECT_Props, SPA_PARAM_Props);
+	if (props->scalar) {
+		spa_pod_builder_prop(builder, SPA_PROP_volume, 0);
+		spa_pod_builder_float(builder, props->scalar_value);
+	}
+	if (props->mute) {
+		spa_pod_builder_prop(builder, SPA_PROP_mute, 0);
+		spa_pod_builder_bool(builder, props->mute_value);
+	}
+	if (props->channels) {
+		spa_pod_builder_prop(builder, SPA_PROP_channelVolumes, 0);
+		spa_pod_builder_array(builder, sizeof(float), SPA_TYPE_Float,
+				props->n_channels, props->channel_values);
+	}
+	if (props->duplicate_channels) {
+		spa_pod_builder_prop(builder, SPA_PROP_channelVolumes, 0);
+		spa_pod_builder_array(builder, sizeof(float), SPA_TYPE_Float,
+				props->n_channels, props->channel_values);
+	}
+	if (props->soft_mute) {
+		spa_pod_builder_prop(builder, SPA_PROP_softMute, 0);
+		spa_pod_builder_bool(builder, props->soft_mute_value);
+	}
+	if (props->soft_volumes) {
+		spa_pod_builder_prop(builder, SPA_PROP_softVolumes, 0);
+		spa_pod_builder_array(builder, sizeof(float), SPA_TYPE_Float,
+				props->n_soft_volumes, props->soft_values);
+	}
+	if (props->ramp) {
+		spa_pod_builder_prop(builder, SPA_PROP_volumeRampSamples, 0);
+		spa_pod_builder_int(builder, 64);
+	}
+	return spa_pod_builder_pop(builder, &frame);
+}
