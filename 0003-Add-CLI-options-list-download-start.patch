From 53bbc3ef1d176184c6efb56cd432b5e690ea11c9 Mon Sep 17 00:00:00 2001
From: xiota <>
Date: Wed, 18 Nov 2026 08:48:00 +0000
Subject: [PATCH] Add CLI options list/download/start

---
 ialauncher/__main__.py | 57 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/ialauncher/__main__.py b/ialauncher/__main__.py
index 69364f1..a2a335e 100644
--- a/ialauncher/__main__.py
+++ b/ialauncher/__main__.py
@@ -15,6 +15,46 @@ from .gamelist import gamelist
 from .scenes.loading import Loading
 from .utils import show_error
 
+GAMES_DIR = Path("/usr/share/ialauncher")
+
+def cli_list():
+    for entry in GAMES_DIR.iterdir():
+        if (entry / "metadata.ini").exists():
+            print(entry.name)
+
+def cli_start(identifier):
+    path = GAMES_DIR / identifier
+    if not (path / "metadata.ini").is_file():
+        print(f"Game not found: {identifier}")
+        return
+    game = Game(path)
+    if not game.is_downloaded():
+        game.download()
+        game.download_thread.join()
+        if game.download_thread.error:
+            print(game.download_thread.error)
+            return
+    if game.is_downloaded():
+        if not game.is_ready():
+            game.unzip().join()
+        if game.is_ready():
+            game.start()
+
+def cli_download(identifier):
+    path = GAMES_DIR / identifier
+    if not (path / "metadata.ini").is_file():
+        print(f"Game not found: {identifier}")
+        return
+
+    game = Game(path)
+    game.download()
+    game.download_thread.join()
+
+    if game.download_thread.error:
+        print(game.download_thread.error)
+    else:
+        print("Download complete.")
+
 # Autoplay times left out of the histogram and the total autoplay time.
 PLACEHOLDER_AUTOPLAY_TIMES = {60, 300}
 
@@ -42,6 +82,11 @@ def launch() -> None:
     parser = argparse.ArgumentParser(
         description="DOSBox frontend for the Internet Archive MS-DOS games collection"
     )
+
+    parser.add_argument('--list', action='store_true', help='List available games')
+    parser.add_argument('--download', metavar='GAME', help='Download a specific game')
+    parser.add_argument('--start', metavar='GAME', help='Launch a specific game')
+
     parser.add_argument(
         "--slideshow",
         type=int,
@@ -108,6 +153,18 @@ def launch() -> None:
     )
     args = parser.parse_args()
 
+    if args.list:
+        cli_list()
+        return
+
+    if args.download:
+        cli_download(args.download)
+        return
+
+    if args.start:
+        cli_start(args.start)
+        return
+
     set_options(args)
     has_opengl()
     if isinstance(sys.stdout, io.TextIOWrapper):
-- 
2.56.1

