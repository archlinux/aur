post_install() {
  cat <<'EOF'

  ==> wlbar was previously published as "river-bar".

      What changed (you must update these yourself):

        * Binary:  river-bar            ->  wlbar
                   Update the spawn/exec line in your compositor config,
                   e.g. River's ~/.config/river/init or niri's config.kdl.

        * Config:  ~/.config/river-bar/  ->  ~/.config/wlbar/
                   Move your existing config and themes over:

                       mv ~/.config/river-bar ~/.config/wlbar

        * Env var: RIVER_BAR_BIND_DEBUG  ->  WLBAR_BIND_DEBUG  (debug only)

      Until the config is moved, wlbar falls back to its built-in defaults.

EOF
}

post_upgrade() {
  # Coming from the old river-bar package, pacman runs post_install (wlbar is a
  # fresh install that replaces river-bar), so the migration notice is shown
  # there. Nothing extra to do on a plain wlbar -> wlbar upgrade.
  :
}
