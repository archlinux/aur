diff --git a/src/gallium/drivers/nouveau/nouveau_fence.c b/src/gallium/drivers/nouveau/nouveau_fence.c
index e3f4da9..727cb0d 100644
--- a/src/gallium/drivers/nouveau/nouveau_fence.c
+++ b/src/gallium/drivers/nouveau/nouveau_fence.c
@@ -40,7 +40,8 @@ nouveau_fence_new(struct nouveau_context *nv, struct nouveau_fence **fence)
    if (!new_fence)
       return false;
 
-   int ret = nouveau_bo_new(nv->screen->device, NOUVEAU_BO_GART, 0x1000, 0x1000, NULL, &new_fence->bo);
+   int ret = nouveau_bo_new(nv->screen->device, NOUVEAU_BO_GART, 0x1000, 0x1000, NULL,
+                            &new_fence->bo);
    if (ret) {
       FREE(new_fence);
       return false;
@@ -165,28 +166,28 @@ _nouveau_fence_update(struct nouveau_screen *screen, bool flushed)
    if (unlikely(screen->disable_fences))
       sequence = screen->fence.sequence;
 
-   if (fence_list->sequence_ack == sequence)
-      return;
-   fence_list->sequence_ack = sequence;
+   if (fence_list->sequence_ack != sequence) {
+      fence_list->sequence_ack = sequence;
 
-   for (fence = fence_list->head; fence; fence = next) {
-      next = fence->next;
-      sequence = fence->sequence;
+      for (fence = fence_list->head; fence; fence = next) {
+         next = fence->next;
+         sequence = fence->sequence;
 
-      fence->state = NOUVEAU_FENCE_STATE_SIGNALLED;
+         fence->state = NOUVEAU_FENCE_STATE_SIGNALLED;
 
-      nouveau_fence_trigger_work(fence);
-      _nouveau_fence_ref(NULL, &fence);
+         nouveau_fence_trigger_work(fence);
+         _nouveau_fence_ref(NULL, &fence);
 
-      if (sequence == fence_list->sequence_ack)
-         break;
+         if (sequence == fence_list->sequence_ack)
+            break;
+      }
+      fence_list->head = next;
+      if (!next)
+         fence_list->tail = NULL;
    }
-   fence_list->head = next;
-   if (!next)
-      fence_list->tail = NULL;
 
    if (flushed) {
-      for (fence = next; fence; fence = fence->next)
+      for (fence = fence_list->head; fence; fence = fence->next)
          if (fence->state == NOUVEAU_FENCE_STATE_EMITTED)
             fence->state = NOUVEAU_FENCE_STATE_FLUSHED;
    }
