+static int
+nouveau_vp3_decoder_fence_wait(struct pipe_video_codec *decoder,
+                               struct pipe_fence_handle *fence,
+                               uint64_t timeout)
+{
+   struct nouveau_vp3_decoder *dec = (struct nouveau_vp3_decoder *)decoder;
+   struct nouveau_bo *bo = (struct nouveau_bo *)fence;
+   uint32_t access = NOUVEAU_BO_RDWR;
+
+   if (!bo)
+      return 1;
+   if (!timeout)
+      access |= NOUVEAU_BO_NOBLOCK;
+
+   return nouveau_bo_wait(bo, access, dec->client) == 0;
+}
+
+static void
+nouveau_vp3_decoder_destroy_fence(struct pipe_video_codec *decoder,
+                                  struct pipe_fence_handle *fence)
+{
+   struct nouveau_bo *bo = (struct nouveau_bo *)fence;
+
+   nouveau_bo_ref(NULL, &bo);
+}
+
 static void
 nouveau_vp3_decoder_destroy(struct pipe_video_codec *decoder)
 {
    struct nouveau_vp3_decoder *dec = (struct nouveau_vp3_decoder *)decoder;
    int i;
 
+   if (dec->ref_bo)
+      nouveau_bo_wait(dec->ref_bo, NOUVEAU_BO_RDWR, dec->client);
+   if (dec->inter_bo[0])
+      nouveau_bo_wait(dec->inter_bo[0], NOUVEAU_BO_RDWR, dec->client);
+   if (dec->inter_bo[1])
+      nouveau_bo_wait(dec->inter_bo[1], NOUVEAU_BO_RDWR, dec->client);
+   for (i = 0; i < NOUVEAU_VP3_VIDEO_QDEPTH; ++i) {
+      if (dec->bsp_bo[i])
+         nouveau_bo_wait(dec->bsp_bo[i], NOUVEAU_BO_RDWR, dec->client);
+   }
+
+   /* Free the channel(s) before deleting the subchannel engine objects so
+    * that nouveau_channel_idle() inside DRM_NOUVEAU_CHANNEL_FREE runs while
+    * the MSVLD/MSPDEC/MSPPP engine contexts are still bound and powered on. */
+   if (dec->channel[0] != dec->channel[1]) {
+      for (i = 0; i < 3; ++i) {
+         nouveau_pushbuf_destroy(&dec->pushbuf[i]);
+         nouveau_object_del(&dec->channel[i]);
+      }
+   } else {
+      nouveau_pushbuf_destroy(dec->pushbuf);
+      nouveau_object_del(dec->channel);
+   }
+
+   nouveau_object_del(&dec->bsp);
+   nouveau_object_del(&dec->vp);
+   nouveau_object_del(&dec->ppp);
+
    nouveau_bo_ref(NULL, &dec->ref_bo);
    nouveau_bo_ref(NULL, &dec->bitplane_bo);
    nouveau_bo_ref(NULL, &dec->inter_bo[0]);
@@ -219,20 +272,6 @@ nouveau_vp3_decoder_destroy(struct pipe_video_codec *decoder)
    for (i = 0; i < NOUVEAU_VP3_VIDEO_QDEPTH; ++i)
       nouveau_bo_ref(NULL, &dec->bsp_bo[i]);
 
-   nouveau_object_del(&dec->bsp);
-   nouveau_object_del(&dec->vp);
-   nouveau_object_del(&dec->ppp);
-
-   if (dec->channel[0] != dec->channel[1]) {
-      for (i = 0; i < 3; ++i) {
-         nouveau_pushbuf_destroy(&dec->pushbuf[i]);
-         nouveau_object_del(&dec->channel[i]);
-      }
-   } else {
-      nouveau_pushbuf_destroy(dec->pushbuf);
-      nouveau_object_del(dec->channel);
-   }
-
    FREE(dec);
 }
 
