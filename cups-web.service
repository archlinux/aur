[Unit]
Description=CUPS Web Interface
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cups-web
Restart=on-failure
EnvironmentFile=/etc/conf.d/cups-web
Environment=DB_PATH=/var/lib/cups-web/data/cups-web.db
Environment=UPLOAD_DIR=/var/lib/cups-web/uploads
Environment=OFD_CONVERTER_JAR=/usr/share/java/ofdrw/ofdrw-converter.jar
ExecStart=/usr/bin/cups-web

[Install]
WantedBy=multi-user.target
