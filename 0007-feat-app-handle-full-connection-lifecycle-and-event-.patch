From 3594cde476c871e69ca99e654f46a3a57d607d7b Mon Sep 17 00:00:00 2001
From: lemonsh <lemon@lemonsh.moe>
Date: Mon, 2 Nov 2026 23:07:08 +0100
Subject: [PATCH 07/23] feat(app): handle full connection lifecycle and event
 re-subscription on :connect

Sync URI to all view states on :connect, re-subscribe the live libvirt
event stream, update dynamic hypervisor hostname, and reset stale domain
selection and detail state.
---
 src/app/domains.rs | 28 ++++++++++++++++++++++------
 src/app/mod.rs     | 21 +++++++++++++++++++++
 2 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/src/app/domains.rs b/src/app/domains.rs
index adf084f56ea9219a4e39f7e3d9a1065e7e787ffa..b44a7e796bc0fde4766ced346fcdf5b53b68f7f6 100644
--- a/src/app/domains.rs
+++ b/src/app/domains.rs
@@ -93,12 +93,28 @@ pub(super) fn apply_demo_transition(
 
 /// Re-fetch live domains after a mutation.
 pub(super) async fn refresh_live(uri: &str, dash: &mut crate::ui::views::dashboard::DashboardState) {
-    if let Ok((summaries, _)) = crate::backend::virsh::VirshBackend::new(uri)
-        .domains_with_stats()
-        .await
-    {
-        dash.apply_summaries(&summaries);
-        dash.apply_metrics();
+    let backend = crate::backend::virsh::VirshBackend::new(uri);
+    match backend.domains_with_stats().await {
+        Ok((summaries, _)) => {
+            dash.apply_summaries(&summaries);
+            dash.apply_metrics();
+            dash.connected = true;
+            dash.uri = uri.to_string();
+            dash.message.clear();
+            if let Ok(h) = backend.hostname().await {
+                dash.hostname = h.clone();
+                crate::ui::chrome::set_live(crate::ui::chrome::LiveChrome {
+                    hostname: h,
+                    refresh_secs: 1,
+                });
+            }
+        }
+        Err(e) => {
+            dash.apply_summaries(&[]);
+            dash.connected = false;
+            dash.uri = uri.to_string();
+            dash.message = format!("✗ connection to {uri} failed ({e})");
+        }
     }
 }
 
diff --git a/src/app/mod.rs b/src/app/mod.rs
index 113650db4df0fc3c8cc3366357cb36d3093269a6..e33de054ed29e71fc09cc7770eff135a1224baf9 100644
--- a/src/app/mod.rs
