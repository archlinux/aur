_show_next_steps() {
  printf '\n%s\n' '==> Manual action required:'
  printf '    sudo systemctl %s oneleet-daemon.service\n\n' "$1"
  printf '%s\n' '==> Personal application launchers refresh every five minutes.' \
    '    To disable personal inventory (system apps are unaffected):' \
    '    sudo touch /etc/oneleet-agent/disable-user-applications-scan' \
    '    Remove that file to reenable it.' ''
}

post_install() {
  _show_next_steps 'enable --now'
}

post_upgrade() {
  _show_next_steps restart
}
