post_install() {
    systemd-tmpfiles --create rusty-monitor-rapl.conf
    echo ":: RAPL energy counter unlocked for CPU power draw."
    echo "   (this re-opens the PLATYPUS side-channel from CVE-2020-8694;"
    echo "    generally fine on a personal desktop, but worth knowing)"
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: RAPL rule removed. energy_uj returns to root-only on next boot."
}