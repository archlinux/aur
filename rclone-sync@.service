# %i is the instance name, the ~/.config/rclone-sync/%i.conf file and the rclone
# remote at once. Runs as your user with your own rclone config, e.g.
#   systemctl --user enable --now rclone-sync@gdrive-docs.timer

[Unit]
Description=rclone %i sync
Documentation=file:/usr/share/doc/rclone-sync-timer/README.md
Documentation=man:rclone(1)
# At most 5 starts per hour, then the unit stays failed until the timer runs it again.
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
# Must set RCLONE_SRC and RCLONE_DEST; may set RCLONE_MODE / RCLONE_FLAGS.
EnvironmentFile=%h/.config/rclone-sync/%i.conf

# Unconfigured remote: exit 1-254 skips the run instead of failing the unit.
ExecCondition=/bin/sh -c '/usr/bin/rclone listremotes --quiet | grep -qxF "%i:"'

# Default mode, overridden by RCLONE_MODE= in the config file (EnvironmentFile
# wins over Environment=). "sync" mirrors the remote and deletes extra files at
# the destination; use "copy" to only add, "bisync" for two-way syncing.
Environment=RCLONE_MODE=sync

# $RCLONE_MODE and $RCLONE_FLAGS, not ${...}: $VAR splits on whitespace into
# separate arguments and expands to nothing when unset, ${VAR} would be one word.
ExecStart=/usr/bin/rclone $RCLONE_MODE ${RCLONE_SRC} ${RCLONE_DEST} $RCLONE_FLAGS

# File system sandboxing (ProtectSystem=, PrivateTmp=, ...) has no effect in user
# services and rclone needs no privileges beyond yours.
NoNewPrivileges=yes

Restart=on-failure
RestartSec=60
