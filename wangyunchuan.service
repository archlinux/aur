[Unit]
Description=WangYunChuan (wyc) resident client
Documentation=https://wangyunchuan.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wangyunchuan
Group=wangyunchuan
StateDirectory=wangyunchuan
RuntimeDirectory=wangyunchuan
ExecStart=/usr/bin/wyc run --config /etc/wangyunchuan/config.json
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wangyunchuan

[Install]
WantedBy=multi-user.target
