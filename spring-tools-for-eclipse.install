pre_upgrade() {
    # Keep existing '-javaagent' options, if any
    if [ -e "/opt/st4e/SpringToolsForEclipse.ini" ]; then
        grep -E "^-javaagent" /opt/st4e/SpringToolsForEclipse.ini > /tmp/st4e.javaagents || return 0
    fi
}

post_install() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

post_upgrade() {
    post_install $1

    # Restore existing '-javaagent' options, if any
    if [ -s "/tmp/st4e.javaagents" ]; then
        cat /tmp/st4e.javaagents >> /opt/st4e/SpringToolsForEclipse.ini
    fi
    rm -f /tmp/st4e.javaagents
}

post_remove() {
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

