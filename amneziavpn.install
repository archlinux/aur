_appname=AmneziaVPN
_srvname=AmneziaVPN.service

pre_install() {
  killall -9 $_appname
}

post_install() {
  systemctl enable --now $_srvname
}

pre_upgrade() {
  killall -9 $_appname
}

post_upgrade() {
  systemctl daemon-reload
  if systemctl is-active --quiet $_srvname; then
    systemctl restart $_srvname
  fi
}

pre_remove() {
  killall -9 $_appname
  systemctl disable --now $_srvname
}
