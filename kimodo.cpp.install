post_install() {
  cat <<'MSG'
:: kimodo.cpp was installed without model weights.
::
:: Recommended starter model (SOMA RP v1.1 + Q8_0 text encoder):
::   sudo -u kimodo -H kimodo-download-weights \
::     --output /var/lib/kimodo \
::     --model soma-rp-v1.1 \
::     --text-quantization q8_0
::
:: Then start the local web service:
::   sudo systemctl enable --now kimodo.cpp.service
::   http://127.0.0.1:8090/
::
:: Service configuration: /etc/conf.d/kimodo.cpp
:: Logs: journalctl -u kimodo.cpp.service -f
MSG
}

post_upgrade() {
  post_install
}
