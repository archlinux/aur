post_install() {
    cat << 'EOF'

╔══════════════════════════════════════════════════════════════════════════╗
║                    SnipText OCR - Installation Complete                 ║
╚══════════════════════════════════════════════════════════════════════════╝

[!] STEP 1: Configure keyboard shortcut (REQUIRED!)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  Recommended keybind: Ctrl+Alt+T
  Command to run:      sniptext --capture-now

  Configuration examples:

  Hyprland (~/.config/hypr/hyprland.conf):
    bind = CTRL ALT, T, exec, sniptext --capture-now

  Sway/i3 (~/.config/sway/config or ~/.config/i3/config):
    bindsym Ctrl+Alt+t exec sniptext --capture-now

  GNOME: Settings -> Keyboard -> Custom Shortcuts
  KDE:   System Settings -> Shortcuts -> Custom Shortcuts

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[!] STEP 2: Install screenshot tools (REQUIRED!)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  For Wayland (Hyprland, Sway, etc):
      sudo pacman -S slurp grim wl-clipboard

  For X11 (i3, bspwm, etc):
      sudo pacman -S maim xclip

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[*] OPTIONAL: Additional languages
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  For Russian, French, German, etc:
    sudo pacman -S tesseract-data-rus   # Russian
    sudo pacman -S tesseract-data-fra   # French
    sudo pacman -S tesseract-data-deu   # German

  Then edit ~/.config/sniptext/config.yaml:
    ocr_language: eng+rus  # Multiple languages

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[*] OPTIONAL: Enhanced spell correction (English only)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  For automatic correction of OCR errors in English:
    yay -S python-symspellpy

  Note: Currently works for English text only

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Test and configure!
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  Test from terminal:
    sniptext --capture-now

  Configuration file will be created at:
    ~/.config/sniptext/config.yaml

  Documentation:
    /usr/share/doc/sniptext/README.md

╚══════════════════════════════════════════════════════════════════════════╝

EOF
}

post_upgrade() {
    post_install
}
