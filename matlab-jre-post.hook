[Trigger]
Operation = Install
Operation = Remove
Type = Path
Target = usr/lib/jvm/*/bin/java
Target = @@MAKEPKG_MATLAB_ROOT@@/*/VersionInfo.xml
Target = @@MAKEPKG_MATLAB_ROOT@@/*/sys/java/jre/glnxa64/jre/bin/java

[Action]
Description = Configuring MATLAB JRE...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/matlab-jre
NeedsTargets
