# Override this file with a modified version in /etc/tmpfiles.d/
d /etc/mautrix-instagram 0750 root mautrix-instagram
z /etc/mautrix-instagram/* 0640 mautrix-instagram mautrix-instagram -
d /var/log/mautrix-instagram 0700 mautrix-instagram mautrix-instagram
d /var/lib/mautrix-instagram 0700 mautrix-instagram mautrix-instagram
