[Unit]
Description=Chayuan AI WPS Plugin & MCP Server
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStartPre=/usr/bin/bash /opt/chayuan-wps-addon/arch-user-init.sh
ExecStart=/usr/bin/bash -c 'cd %h/.config/chayuan-wps/mcp/runtime && exec ./start-mcp.sh'
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
