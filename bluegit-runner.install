# bluegit-runner: systemd-unit met User=bluegit-runner (groep docker).
# Na installatie start de service; koppelen gaat in de webinterface.
# Een upgrade herstart de service.
# Zonder draaiende systemd (chroot of container) faalt de transactie niet.

_bgr_systemctl() {
  if ! command -v systemctl >/dev/null 2>&1 || [[ ! -d /run/systemd/system ]]; then
    echo "bluegit-runner: systemd draait niet; de service is niet aangepast."
    return 0
  fi
  systemctl "$@" || true
}

post_install() {
  systemd-sysusers bluegit-runner.conf || true
  systemd-tmpfiles --create bluegit-runner.conf || true
  _bgr_systemctl daemon-reload
  _bgr_systemctl enable --now bluegit-runner.service
  cat <<'MSG'
bluegit-runner: open de webinterface op http://127.0.0.1:8765
  1. sudo -u bluegit-runner bluegit-runner ui-token --work-dir /var/lib/bluegit-runner
  2. Meld je aan en vul onder Koppeling de BlueGit-URL en het registratietoken in
     (Instellingen → Runners, of bij een groep).
De CLI "bluegit-runner register" blijft een alternatief.
MSG
}

post_upgrade() {
  systemd-sysusers bluegit-runner.conf || true
  systemd-tmpfiles --create bluegit-runner.conf || true
  _bgr_systemctl daemon-reload
  _bgr_systemctl try-restart bluegit-runner.service
}

pre_remove() {
  _bgr_systemctl disable --now bluegit-runner.service
}

post_remove() {
  _bgr_systemctl daemon-reload
}
