diff --git a/grub-core/normal/menu.c b/grub-core/normal/menu.c
index 62fa2e5..d98e88f 100644
--- a/grub-core/normal/menu.c
+++ b/grub-core/normal/menu.c
@@ -836,15 +836,21 @@ run_menu (grub_menu_t menu, int nested, int *auto_boot, int *notify_boot)
 
 /* Callback invoked immediately before a menu entry is executed.  */
 static void
-notify_booting (grub_menu_entry_t entry, void *userdata)
+notify_booting (grub_menu_entry_t entry
+#ifdef QUIET_BOOT
+		__attribute__((unused))
+#endif
+		, void *userdata)
 {
   int *notify_boot = userdata;
 
   if (*notify_boot)
     {
+#ifndef QUIET_BOOT
       grub_printf ("  ");
       grub_printf_ (N_("Booting `%s'"), entry->title);
       grub_printf ("\n\n");
+#endif
     }
 }
 
@@ -893,6 +899,9 @@ show_menu (grub_menu_t menu, int nested, int autobooted)
       int boot_entry;
       grub_menu_entry_t e;
       int auto_boot;
+#ifdef QUIET_BOOT
+      int initial_timeout = grub_menu_get_timeout ();
+#endif
       int notify_boot;
 
       boot_entry = run_menu (menu, nested, &auto_boot, &notify_boot);
@@ -908,6 +917,10 @@ show_menu (grub_menu_t menu, int nested, int autobooted)
 					 &execution_callback, &notify_boot);
       else
 	{
+#ifdef QUIET_BOOT
+      /* Only clear the screen if we drew the menu in the first place.  */
+      if (initial_timeout != 0)
+#endif
 	  grub_cls ();
 	  grub_menu_execute_entry (e, 0);
 	}
