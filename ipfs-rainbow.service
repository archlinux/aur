[Unit]
Description=ipfs-rainbow
After=network.target

[Service]
Type=simple
User=ipfs-rainbow
Group=ipfs-rainbow
DynamicUser=yes
EnvironmentFile=-/etc/conf.d/ipfs-rainbow
ExecStart=/usr/bin/ipfs-rainbow
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
RuntimeDirectory=ipfs-rainbow
StateDirectory=ipfs-rainbow
CacheDirectory=ipfs-rainbow
LogsDirectory=ipfs-rainbow

[Install]
WantedBy=multi-user.target
