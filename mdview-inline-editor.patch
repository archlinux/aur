+        && ((gint64) current_stat.st_mtime != mvr->editor_mtime
+        || (goffset) current_stat.st_size != mvr->editor_size)
+       )
+    {
+        g_set_error_literal
+        (error, G_FILE_ERROR, G_FILE_ERROR_FAILED,
+         _("The file changed on disk since it was opened or last saved; refusing to save"));
+        goto out;
+    }
+
+    if (!g_file_set_contents_full
+        (save_path, text, (gssize) len,
+         G_FILE_SET_CONTENTS_CONSISTENT | G_FILE_SET_CONTENTS_DURABLE,
+         0644, error))
+    {
+        goto out;
+    }
+
+    if (g_stat (save_path, &st) != 0)
+    {
+        const gint errsv = errno;
+        g_set_error (error, G_FILE_ERROR, g_file_error_from_errno (errsv),
+                     _("The file was saved, but its metadata could not be read: %s"),
+                     g_strerror (errsv));
+        goto out;
+    }
+
+    mvr->editor_mtime = (gint64) st.st_mtime;
+    mvr->editor_size = (goffset) st.st_size;
+    mtx_viewer_editor_indicator_reset (mvr);
+    gtk_text_buffer_set_modified (buffer, FALSE);
+    saved = TRUE;
+
+out:
+    g_free (text);
+    g_free (directory);
+    free (resolved_path);
+    return saved;
+}
