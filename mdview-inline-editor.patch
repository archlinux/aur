+typedef struct
+{
+    const gchar *options;
+    const gchar *extension;
+    gboolean supports_toc;
+} MtxExportFormat;
+
+static const MtxExportFormat mtx_export_formats[] =
+{
+    { "--html --html5 --html-full --html-css=2", ".html", TRUE },
+    { "--text", ".txt", FALSE },
+    { "--bare", ".txt", FALSE },
+    { "--ansi", ".txt", FALSE },
+    { "--tty", ".txt", FALSE },
+};
+
+/**
+mtx_export_format_label:
+Translated name of an export format. The labels live here, rather than in
+mtx_export_formats, because this project extracts messages with
+"--keyword=_" only.
+*/
+static const gchar *
+mtx_export_format_label (gsize index)
+{
+    const gchar *const labels[] =
+    {
+        _("HTML document"),
+        _("Decorated text"),
+        _("Plain text"),
+        _("Text with ANSI colors"),
+        _("Text with vt100 codes"),
+    };
+
+    G_STATIC_ASSERT (G_N_ELEMENTS (labels)
+                     == G_N_ELEMENTS (mtx_export_formats));
+
+    return index < G_N_ELEMENTS (labels) ? labels[index] : "";
+}
+
+struct _export_completer_data
+{
+    GtkWidget *btn;
+    MtxViewer *mvr;
+    gchar *path;
+};
+
+/**
+export_complete:
+Report the outcome of a finished export child and re-enable the button.
+*/
+static void
+export_complete (GPid     pid,
+                 gint     status,
+                 gpointer user_data)
+{
+    struct _export_completer_data *udat = user_data;
+
+    g_spawn_close_pid (pid);
+    if (g_spawn_check_wait_status (status, NULL))
+    {
+        g_autofree gchar *message =
+        g_strdup_printf (_("::: Exported to %s :::"), udat->path);
+        mtx_viewer_statusbar_warn_seconds (udat->mvr, 5, message);
+    }
+    else
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (udat->mvr, 5, _("::: Could not export this page :::"));
+    }
+    gtk_widget_set_sensitive (udat->btn, TRUE);
+    g_free (udat->path);
+    g_free (udat);
+}
+
+/**
+mtx_viewer_choose_export_path:
+Ask for the export target and format.
+
+Returns: (transfer full) the chosen path with the format's extension
+enforced, or NULL when the user cancelled.
+*/
+static gchar *
+mtx_viewer_choose_export_path (MtxViewer *mvr,
+                               const gchar *directory,
+                               const gchar *stem,
+                               gsize *out_format)
+{
+    GtkWidget *dialog = gtk_file_chooser_dialog_new
+    (_("Export Page As"), GTK_WINDOW (mvr->window),
+     GTK_FILE_CHOOSER_ACTION_SAVE,
+     _("_Cancel"), GTK_RESPONSE_CANCEL,
+     _("_Export"), GTK_RESPONSE_ACCEPT, NULL);
+    GtkFileChooser *chooser = GTK_FILE_CHOOSER (dialog);
+    GtkWidget *box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 6);
+    GtkWidget *label = gtk_label_new (_("Format:"));
+    GtkWidget *combo = gtk_combo_box_text_new ();
+
+    for (gsize i = 0; i < G_N_ELEMENTS (mtx_export_formats); i++)
+    {
+        gtk_combo_box_text_append_text (GTK_COMBO_BOX_TEXT (combo),
+                                        mtx_export_format_label (i));
+    }
+    gtk_combo_box_set_active (GTK_COMBO_BOX (combo), 0);
+    gtk_box_pack_start (GTK_BOX (box), label, FALSE, FALSE, 0);
+    gtk_box_pack_start (GTK_BOX (box), combo, FALSE, FALSE, 0);
+    gtk_widget_show_all (box);
+    gtk_file_chooser_set_extra_widget (chooser, box);
+    gtk_file_chooser_set_local_only (chooser, TRUE);
+    gtk_file_chooser_set_do_overwrite_confirmation (chooser, TRUE);
+    gtk_file_chooser_set_current_folder (chooser, directory);
+
+    g_autofree gchar *initial =
+    g_strconcat (stem, mtx_export_formats[0].extension, NULL);
+    gtk_file_chooser_set_current_name (chooser, initial);
+
+    const gint response = gtk_dialog_run (GTK_DIALOG (dialog));
+    const gint active = gtk_combo_box_get_active (GTK_COMBO_BOX (combo));
+    gchar *path = response == GTK_RESPONSE_ACCEPT
+        ? gtk_file_chooser_get_filename (chooser) : NULL;
+    gtk_widget_destroy (dialog);
+    if (path == NULL)
+    {
+        return NULL;
+    }
+    *out_format = active < 0 ? 0 : (gsize) active;
+
+    const gchar *extension = mtx_export_formats[*out_format].extension;
+    for (gsize i = 0; i < G_N_ELEMENTS (mtx_export_formats); i++)
+    {
+        const gchar *known = mtx_export_formats[i].extension;
+        const gsize length = strlen (path);
+        const gsize known_length = strlen (known);
+
+        if (length > known_length && g_str_has_suffix (path, known))
+        {
+            path[length - known_length] = '\0';
+            break;
+        }
+    }
+    if (!g_str_has_suffix (path, extension))
+    {
+        gchar *with_extension = g_strconcat (path, extension, NULL);
+        g_free (path);
+        path = with_extension;
+    }
+    return path;
+}
+
+/**
+export_clicked:
+Convert the current page to a user-chosen format and file.
+*/
+static void
+export_clicked (GtkWidget *widget,
+                gpointer data)
+{
+    gchar **argv = NULL;
+    GPid child_pid;
+    g_autoptr (GError) error = NULL;
+    MtxViewer *mvr = (MtxViewer *) data;
+    MtxRenderSource src = { NULL, NULL, NULL, NULL };
+
+    if (mtx_viewer_is_page_in_progress (mvr))
+    {
+        return;
+    }
+    if (!mtx_viewer_editor_confirm_discard_full (mvr, TRUE, FALSE))
+    {
+        return;
+    }
+    if (!mtx_viewer_resolve_render_source (mvr, &src))
+    {
+        mtx_render_source_clear (&src);
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 3, _("::: Cannot export this page :::"));
+        return;
+    }
+
+    g_autofree gchar *stem = g_strdup (src.base);
+    gchar *dot = strrchr (stem, '.');
+
+    if (dot != NULL && dot != stem)
+    {
+        *dot = '\0';
+    }
+
+    gsize format = 0;
+    g_autofree gchar *path =
+    mtx_viewer_choose_export_path (mvr, src.dir, stem, &format);
+
+    if (path == NULL)
+    {
+        mtx_render_source_clear (&src);
+        return;
+    }
+    gtk_widget_set_sensitive (widget, FALSE);
+
+    g_autofree gchar *toc = mtx_export_formats[format].supports_toc
+        ? g_strdup_printf (" --toc-level=%d", mvr->options->toc_level)
+        : g_strdup ("");
+    g_autofree gchar *p =
+    g_strdup_printf (PROGNAME " --emask=%d" " --tmask=%d" " %s%s"
+                     " \"--output=%s\"" " \"%s\"" " \"%s\"",
+                     mvr->options->extensions, mvr->options->tweaks,
+                     mtx_export_formats[format].options, toc,
+                     path, src.dir, src.file);
+    if (g_shell_parse_argv (p, NULL, &argv, &error) && error == NULL)
+    {
+        g_spawn_async_with_pipes (src.working_dir, argv, NULL,
+                                  G_SPAWN_SEARCH_PATH |
+                                  G_SPAWN_DO_NOT_REAP_CHILD, NULL,
+                                  NULL, &child_pid, NULL, NULL, NULL, &error);
+    }
+    g_strfreev (argv);
+    mtx_render_source_clear (&src);
+    if (error != NULL)
+    {
+        g_printerr (_("%s: Error: %s\n"), PROGNAME, error->message);
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 5, _("::: Could not export this page :::"));
+        gtk_widget_set_sensitive (widget, TRUE);
+        return;
+    }
+
+    struct _export_completer_data *udat =
+    g_malloc (sizeof *udat);
+    udat->btn = widget;
+    udat->mvr = mvr;
+    udat->path = g_steal_pointer (&path);
+    g_child_watch_add (child_pid, export_complete, udat);
+}
