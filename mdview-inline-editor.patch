+/**
+mtx_viewer_resolve_document_path:
+Resolve a local document page to a canonical absolute regular-file path.
+
+This helper is deliberately pure: it does not update editor state. On success
+it returns the canonical path and copies the same GStatBuf used to validate the
+file to @out_st. The relative-page basename fallback is retained for the editor
+gate, whose historical target-resolution semantics depend on it.
+
+@mvr: pointer to #MtxViewer.
+@page: local document page to resolve.
+@out_st: receives the validating stat snapshot on success. NULLABLE.
+
+Returns: the newly allocated canonical path, or NULL if the page does not
+resolve to a regular file. The caller must g_free() the returned path.
+*/
+static gchar *
+mtx_viewer_resolve_document_path (MtxViewer *mvr,
+                                  const gchar *page,
+                                  GStatBuf *out_st)
+{
+    MtxTextView *tv = (MtxTextView *) mvr->text_view;
+    const gchar *file_name;
+    gchar *built = NULL;
+    gchar *path;
+    gchar *resolved;
+    GStatBuf st;
+
+    if (page == NULL || g_uri_peek_scheme (page) != NULL)
+    {
+        return NULL;
+    }
+
+    file_name = page;
+    if (file_name[0] != '/')
+    {
+        built = g_build_filename (tv->image_directory, file_name, NULL);
+        if (!g_file_test (built, G_FILE_TEST_EXISTS))
+        {
+            gchar *name = g_path_get_basename (file_name);
+            g_free (built);
+            built = g_build_filename (tv->image_directory, name, NULL);
+            g_free (name);
+        }
+        file_name = built;
+    }
+    path = g_canonicalize_filename (file_name, NULL);
+    g_free (built);
+
+    resolved = realpath (path, NULL); /* libc-allocated, needs free() */
+    if (resolved != NULL)
+    {
+        g_free (path);
+        path = g_strdup (resolved);
+        free (resolved);
+    }
+
+    if (g_stat (path, &st) != 0 || !S_ISREG (st.st_mode))
+    {
+        g_free (path);
+        return NULL;
+    }
+    if (out_st != NULL)
+    {
+        *out_st = st;
+    }
+    return path;
+}
+
+/**
+mtx_viewer_editor_target:
+Decide whether the page on screen has a safe on-disk save target for the
+inline editor and, if it does, store that target's canonical absolute path.
+
+Returns FALSE -- and touches nothing in @mvr -- unless ALL of the following
+hold: a page is loaded (@mvr->current_file is non-NULL); that page is a real
+file rather than a synthetic one (no URI scheme, which excludes both
+"search://" results and "resource:///welcome.md"); the page is not a
+generated error page (@mvr->failed_file is NULL); the resolved path is a
+regular file that g_stat() can read; and that resolved path is not
+@mvr->backing_file -- the scratch /tmp file the viewer rewrites on every
+navigation, which has no scheme of its own and would therefore sail straight
+through a scheme-only check.
+
+The relative-path branch below is deliberately a copy of the algorithm
+accel_edit_current() (Ctrl+E) already uses, because both features must agree
+on what "the current file's real path" means. Symlinks are then resolved with
+realpath(3) -- chosen over a g_file_read_link() loop because it handles
+chains, "..", and ELOOP in one libc call, and this is a Linux-only GTK
+program -- so that a later save writes THROUGH a symlink instead of replacing
+it with a regular file.
+
+@mvr: pointer to #MtxViewer.
+@out_abs_path: on TRUE, receives the resolved absolute path; the caller owns
+it and must g_free() it. Set to NULL on FALSE. NULLABLE.
+
+Returns: TRUE if the page is editable. On TRUE, @mvr->editor_path (owned by
+@mvr), @mvr->editor_mtime and @mvr->editor_size are updated; editor_path is
+the ONLY path any later write may use, since current_file is often relative.
+*/
+static gboolean
+mtx_viewer_editor_target (MtxViewer *mvr,
+                          gchar **out_abs_path)
+{
+    gchar *path;
+    GStatBuf st;
+
+    if (out_abs_path != NULL)
+    {
+        *out_abs_path = NULL;
+    }
+    if (mvr->current_file == NULL
+        || g_uri_peek_scheme (mvr->current_file) != NULL
+        || mvr->failed_file != NULL)
+    {
+        return FALSE;
+    }
+
+    path = mtx_viewer_resolve_document_path (mvr, mvr->current_file, &st);
+    if (path == NULL)
+    {
+        return FALSE;
+    }
+
+    if (mvr->backing_file != NULL)
+    {
+        gboolean is_backing = g_strcmp0 (path, mvr->backing_file) == 0;
+        if (!is_backing)
+        {
+            /* Compare canonically too: /tmp itself may be a symlink. */
+            gchar *backing = realpath (mvr->backing_file, NULL);
+            if (backing != NULL)
+            {
+                is_backing = g_strcmp0 (path, backing) == 0;
+                free (backing);
+            }
+        }
+        if (is_backing)
+        {
+            g_free (path);
+            return FALSE;
+        }
+    }
+
+    g_free (mvr->editor_path);
+    mvr->editor_path = path;
+    mvr->editor_mtime = (gint64) st.st_mtime;
+    mvr->editor_size = (goffset) st.st_size;
+    if (out_abs_path != NULL)
+    {
+        *out_abs_path = g_strdup (path);
+    }
+    return TRUE;
+}
+
+static gboolean
+mtx_viewer_editor_load_current (MtxViewer *mvr)
+{
+    g_clear_pointer (&mvr->editor_path, g_free);
+    if (!mtx_viewer_editor_target (mvr, NULL))
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 2, _("::: This page cannot be edited :::"));
+        return FALSE;
+    }
+
+    gsize contents_size = 0;
+    gchar *contents =
+    mtx_text_view_mmap_read_file (mvr->editor_path, &contents_size, TRUE);
+    if (contents != NULL && strlen (contents) != contents_size)
+    {
+        g_free (contents);
+        contents = NULL;
+    }
+    if (contents == NULL)
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 3, g_access (mvr->editor_path, R_OK) != 0
+         ? _("::: Cannot read this file for editing :::")
+         : _("::: This file is not valid UTF-8 text :::"));
+        g_clear_pointer (&mvr->editor_path, g_free);
+        return FALSE;
+    }
+
+    GtkTextBuffer *buffer =
+    gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+    g_signal_handlers_block_by_func (buffer,
+                                     G_CALLBACK (on_editor_buffer_changed),
+                                     mvr);
+    gtk_text_buffer_set_text (buffer, contents, (gint) contents_size);
+    g_signal_handlers_unblock_by_func
+    (buffer, G_CALLBACK (on_editor_buffer_changed), mvr);
+    mtx_viewer_editor_indicator_reset (mvr);
+    gtk_text_buffer_set_modified (buffer, FALSE);
+    g_free (contents);
+    return TRUE;
+}
+
+static void
+mtx_viewer_editor_hide (MtxViewer *mvr)
+{
+    GtkWidget *editor_box = gtk_widget_get_parent (mvr->editor_scrolled);
+    gtk_widget_set_visible (editor_box, FALSE);
+
+    GtkTextBuffer *buffer =
+    gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+    g_signal_handlers_block_by_func (buffer,
+                                     G_CALLBACK (on_editor_buffer_changed),
+                                     mvr);
+    gtk_text_buffer_set_text (buffer, "", -1);
+    g_signal_handlers_unblock_by_func
+    (buffer, G_CALLBACK (on_editor_buffer_changed), mvr);
+    mtx_viewer_editor_indicator_reset (mvr);
+    gtk_text_buffer_set_modified (buffer, FALSE);
+    g_clear_pointer (&mvr->editor_path, g_free);
+
+    if (mvr->editor_debounce_id)
+    {
+        g_source_remove (mvr->editor_debounce_id);
+        mvr->editor_debounce_id = 0;
+    }
+    mvr->editor_render_pending = FALSE;
+}
+
+typedef void (*MtxViewerEditorRenderIssueFunc) (MtxViewer *, gboolean,
+                                                 gint, gdouble);
+
+typedef struct
+{
+    MtxViewer *mvr;
+    gint saved_curpos;
+    gdouble saved_scroll;
+    MtxViewerEditorRenderIssueFunc issue_render;
+} MtxViewerEditorRenderCompleteData;
+
+static gboolean
+mtx_viewer_editor_discard_render_pending (MtxViewer *mvr)
+{
+    return g_object_get_data (G_OBJECT (mvr->window),
+                              MTX_EDITOR_DISCARD_RENDER_DATA) != NULL;
+}
+
+static void
+mtx_viewer_editor_issue_next_render (MtxViewer *mvr,
+                                     MtxViewerEditorRenderIssueFunc issue_render,
+                                     gint saved_curpos,
+                                     gdouble saved_scroll)
+{
+    gchar *captured_text = g_object_steal_data
+    (G_OBJECT (mvr->window), MTX_EDITOR_DISCARD_RENDER_DATA);
+
+    mvr->editor_render_pending = FALSE;
+    if (captured_text != NULL)
+    {
+        mtx_viewer_editor_issue_render_full
+        (mvr, TRUE, saved_curpos, saved_scroll, captured_text, TRUE);
+        g_free (captured_text);
+    }
+    else
+    {
+        issue_render (mvr, TRUE, saved_curpos, saved_scroll);
+    }
+}
+
+static gboolean
+editor_render_resume_when_unsuppressed (gpointer data)
+{
+    MtxViewerEditorRenderCompleteData *resume = data;
+    MtxViewer *mvr = resume->mvr;
+
+    if (mvr->editor_suppress_render)
+    {
+        return G_SOURCE_CONTINUE;
+    }
+
+    mvr->editor_debounce_id = 0;
+    if ((mvr->editor_render_pending
+         || mtx_viewer_editor_discard_render_pending (mvr))
+        && !mvr->editor_render_in_flight)
+    {
+        mtx_viewer_editor_issue_next_render
+        (mvr, resume->issue_render, resume->saved_curpos,
+         resume->saved_scroll);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static GtkAdjustment *
+mtx_viewer_editor_preview_vadjustment (MtxViewer *mvr)
+{
+    GtkWidget *parent =
+    gtk_widget_get_parent (GTK_WIDGET (mvr->text_view));
+
+    g_return_val_if_fail (GTK_IS_SCROLLED_WINDOW (parent), NULL);
+    return gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (parent));
+}
+
+static void
+editor_render_complete (gpointer *instance __attribute__((unused)),
+                        gboolean cond,
+                        GError *error,    /* owned */
+                        gpointer data[])
+{
+    MtxViewerEditorRenderCompleteData *cdat =
+    (MtxViewerEditorRenderCompleteData *) data;
+    MtxViewer *mvr = cdat->mvr;
+    const gint saved_curpos = cdat->saved_curpos;
+    const gdouble saved_scroll = cdat->saved_scroll;
+    MtxViewerEditorRenderIssueFunc issue_render = cdat->issue_render;
+    g_autoptr (GError) err = error;
+
+    mvr->editor_render_in_flight = FALSE;
+    gtk_widget_set_sensitive (mvr->combo_toc,
+                              !mtx_viewer_is_current_skipping_toc (mvr));
+    mtx_viewer_editor_update_counter_label (mvr);
+    mtx_dbg_errout (1, "RENDER_COMPLETED success=%d pending=%d\n",
+                    (int) cond, (int) mvr->editor_render_pending);
+
+    if (mvr->editor_render_pending
+        || mtx_viewer_editor_discard_render_pending (mvr))
+    {
+        if (mvr->editor_suppress_render)
+        {
+            MtxViewerEditorRenderCompleteData *resume =
+            g_new (MtxViewerEditorRenderCompleteData, 1);
+            *resume = *cdat;
+            if (mvr->editor_debounce_id)
+            {
+                g_source_remove (mvr->editor_debounce_id);
+            }
+            mvr->editor_debounce_id = g_timeout_add_full
+            (G_PRIORITY_DEFAULT, MTX_EDITOR_DEBOUNCE_MS,
+             editor_render_resume_when_unsuppressed, resume, g_free);
+        }
+        else
+        {
+            mtx_viewer_editor_issue_next_render
+            (mvr, issue_render, saved_curpos, saved_scroll);
+        }
+    }
+
+    if (cond)
+    {
+        GtkAdjustment *adjustment;
+
+        mvr->changed_curpos = saved_curpos;
+        adjustment = mtx_viewer_editor_preview_vadjustment (mvr);
+        if (adjustment != NULL)
+        {
+            gtk_adjustment_set_value (adjustment, saved_scroll);
+        }
+        mtx_viewer_widgets_set_sensitive (mvr, TRUE);
+
+        gtk_entry_set_text (GTK_ENTRY (mvr->text_search), "");
+        gtk_entry_set_progress_fraction (GTK_ENTRY (mvr->text_search), 0.0);
+    }
+    else
+    {
+        const gchar *message = error != NULL ? error->message :
+            _("::: Live preview render failed :::");
+
+        /* reset_buffer may have nulled highlight_tag; do not clear tags here. */
+        mtx_viewer_statusbar_warn_seconds (mvr, 3, message);
+    }
+
+    g_free (cdat);
+}
+
+static void
+mtx_viewer_editor_issue_render_full (MtxViewer *mvr,
+                                     gboolean preserve_position,
+                                     gint saved_curpos,
+                                     gdouble saved_scroll,
+                                     const gchar *captured_text,
+                                     gboolean bypass_ceiling)
+{
+    gchar *copy;
+    /*
+    BYTES, not characters. gtk_text_buffer_get_char_count() counts
+    characters, so on multi-byte UTF-8 (CJK, accents, emoji) it
+    under-reports by up to 4x and would wave a document far over the
+    ceiling straight into the quadratic renderer. The string measured
+    here is also the exact allocation transferred to set_text().
+
+    A discard-triggered render supplies an owned snapshot captured from the
+    just-reloaded buffer. Keeping that snapshot outside GtkTextBuffer is what
+    lets F2 hide clear the editor without changing the queued render's input.
+    */
+    if (captured_text != NULL)
+    {
+        copy = g_strdup (captured_text);
+    }
+    else
+    {
+        GtkTextBuffer *buffer =
+        gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+        GtkTextIter start, end;
+        gtk_text_buffer_get_start_iter (buffer, &start);
+        gtk_text_buffer_get_end_iter (buffer, &end);
+        copy = gtk_text_buffer_get_text (buffer, &start, &end, FALSE);
+    }
+    gsize nbytes = (copy != NULL ? strlen (copy) : 0);
+
+    mtx_dbg_errout (1, "DEBOUNCE_FIRED bytes=%lu in_flight=%d pending=%d\n",
+                    (unsigned long) nbytes,
+                    (int) mvr->editor_render_in_flight,
+                    (int) mvr->editor_render_pending);
+
+    if (!bypass_ceiling && nbytes > MTX_EDITOR_LIVE_PREVIEW_MAX_BYTES)
+    {
+        g_free (copy);
+        mtx_dbg_errout (1, "RENDER_SKIPPED_CEILING bytes=%lu ceiling=%d\n",
+                        (unsigned long) nbytes,
+                        MTX_EDITOR_LIVE_PREVIEW_MAX_BYTES);
+        mtx_viewer_statusbar_warn_seconds (mvr, 3, _(
+            "::: Document too large for live preview - refresh manually :::"));
+        return;
+    }
+
+    if (mvr->editor_render_in_flight)
+    {
+        mvr->editor_render_pending = TRUE;
+        if (captured_text != NULL && bypass_ceiling)
+        {
+            /*
+            The ordinary coalescer only needs a boolean because it can read
+            the still-visible editor buffer when the active render completes.
+            Discard cannot: F2 hide clears that buffer. Attach this one owned
+            snapshot to the window so the same completion path serializes it
+            after the active render. mtx_viewer_editor_hide() may clear the
+            boolean, but the attached snapshot remains authoritative.
+            */
+            g_object_set_data_full
+            (G_OBJECT (mvr->window), MTX_EDITOR_DISCARD_RENDER_DATA,
+             copy, g_free);
+            mtx_dbg_errout
+            (1, "RENDER_DEFERRED_DISCARD bytes=%lu pending=%d\n",
+             (unsigned long) nbytes, (int) mvr->editor_render_pending);
+        }
+        else
+        {
+            g_free (copy);
+            mtx_dbg_errout (1, "RENDER_DEFERRED pending=%d\n",
+                            (int) mvr->editor_render_pending);
+        }
+        return;
+    }
+
+    gchar **text_ptr = g_new (gchar *, 1);
+    *text_ptr = copy;
+
+    if (!g_utf8_validate (copy, -1, NULL))
+    {
+        g_warning ("Editor buffer contains invalid UTF-8; render skipped");
+        g_free (copy);
+        g_free (text_ptr);
+        return;
+    }
+
+    const gchar *referrer = mvr->editor_referrer;
+    if (referrer != NULL && *referrer == '\0')
+    {
+        g_warning ("Empty editor render referrer rejected; using NULL");
+        referrer = NULL;
+    }
+
+    if (!preserve_position)
+    {
+        GtkAdjustment *adjustment =
+        mtx_viewer_editor_preview_vadjustment (mvr);
+
+        saved_curpos = mvr->changed_curpos;
+        saved_scroll = adjustment != NULL ?
+            gtk_adjustment_get_value (adjustment) : 0.0;
+    }
+    mvr->editor_saved_curpos = saved_curpos;
+    mvr->editor_saved_scroll = saved_scroll;
+
+    MtxViewerEditorRenderCompleteData *cdat =
+    g_new0 (MtxViewerEditorRenderCompleteData, 1);
+    cdat->mvr = mvr;
+    cdat->saved_curpos = saved_curpos;
+    cdat->saved_scroll = saved_scroll;
+    cdat->issue_render = mtx_viewer_editor_issue_render;
+    GClosure *completer =
+    g_cclosure_new (G_CALLBACK (editor_render_complete), cdat, NULL);
+    g_closure_set_marshal (completer,
+                           cclosure_marshal_VOID__BOOLEAN_POINTER);
+
+    mvr->editor_render_in_flight = TRUE;
+    gtk_widget_set_sensitive (mvr->combo_toc, FALSE);
+    mtx_viewer_editor_update_counter_label (mvr);
+    mtx_dbg_errout (1, "RENDER_ISSUED bytes=%lu forced=%d\n",
+                    (unsigned long) nbytes, (int) bypass_ceiling);
+
+    gboolean render_accepted =
+    mtx_text_view_set_text (mvr->text_view, text_ptr, referrer, TRUE,
+                            NULL, completer);
+    if (!render_accepted)
+    {
+        mvr->editor_render_in_flight = FALSE;
+        gtk_widget_set_sensitive (mvr->combo_toc,
+                                  !mtx_viewer_is_current_skipping_toc (mvr));
+        mtx_viewer_editor_update_counter_label (mvr);
+        mtx_dbg_errout (1, "RENDER_REJECTED referrer=%s\n",
+                        referrer != NULL ? referrer : "(null)");
+        g_closure_unref (completer);
+        g_free (cdat);
+        /* Ownership was not accepted on an early FALSE return. */
+        g_free (copy);
+        g_free (text_ptr);
+    }
+}
+
+static void
+mtx_viewer_editor_issue_render (MtxViewer *mvr,
+                                gboolean preserve_position,
+                                gint saved_curpos,
+                                gdouble saved_scroll)
+{
+    mtx_viewer_editor_issue_render_full
+    (mvr, preserve_position, saved_curpos, saved_scroll, NULL, FALSE);
+}
+
+/**
+on_editor_debounce_timeout:
+The one and only place a live-preview render is decided on. Runs
+MTX_EDITOR_DEBOUNCE_MS after the last keystroke, from the main loop.
+
+SERIALIZATION, NOT CANCELLATION -- read this before changing anything
+below. This scheduler must NEVER cancel an in-flight render. (The word
+that names mtxtextview.c's cancel entry point is deliberately not
+spelled out anywhere in this file outside cancel_loading_clicked(), so
+that grepping this file for it keeps returning exactly one hit.)
+
+Why cancelling is unsafe here: mtx_text_view_load_markup_async()
+(mtxtextview.c:1801) calls g_task_set_return_on_cancel (task, TRUE), so
+cancelling makes mtx_text_view_load_markup_loaded() fire IMMEDIATELY
+while the worker thread KEEPS RUNNING inside mtx_cmm_mtx() on the SHARED
+mvr->text_view markdown parser instance. Starting a replacement render
+then puts two parses on one parser object at once -- heap corruption or
+a garbled page, non-deterministic and near-impossible to reproduce.
+Worse, mtx_text_view_load_markup_loaded() is also the only place that
+recreates the text view's GCancellable, so cancelling when nothing is in
+flight leaves that GCancellable permanently cancelled and every future
+render returns cancelled with no buffer swap -- the preview would be
+bricked for the rest of the session. Hence: at most one render in
+flight, later requests coalesce into mvr->editor_render_pending, nothing
+is ever cancelled.
+
+Returns: G_SOURCE_REMOVE on every path -- one debounce window, one
+decision.
+*/
+static gboolean
+on_editor_debounce_timeout (gpointer data)
+{
+    MtxViewer *mvr = (MtxViewer *) data;
+
+    if (mvr->editor_suppress_render)
+    {
+        return G_SOURCE_CONTINUE;
+    }
+
+    /*
+    Cleared up front, not on the way out: every return below is
+    G_SOURCE_REMOVE, so by the time control leaves this function the
+    source is gone. A stale non-zero id would make the next
+    g_source_remove() in mtx_viewer_editor_schedule_render() fire a
+    "source ID was not found" warning at a dead source.
+    */
+    mvr->editor_debounce_id = 0;
+
+    if (!mvr->editor_render_in_flight)
+    {
+        mvr->editor_render_pending = FALSE;
+    }
+    mtx_viewer_editor_issue_render (mvr, FALSE, 0, 0.0);
+
+    return G_SOURCE_REMOVE;
+}
+
+/**
+mtx_viewer_editor_schedule_render:
+Restart the live-preview debounce window. Called on every editor
+keystroke; the point is that MTX_EDITOR_DEBOUNCE_MS of continuous typing
+produces exactly ZERO renders, and the burst collapses into one.
+
+Split out of on_editor_buffer_changed() so that todo 16's completer and
+todo 21's dialog code have a single entry point to call, and so that the
+mvr->editor_suppress_render veto is the literal first thing that runs on
+the path to a render.
+*/
+static void
+mtx_viewer_editor_schedule_render (MtxViewer *mvr)
+{
+    /*
+    Todo 21 raises this around modal dialogs: a dialog spins its own main
+    loop, so an unguarded debounce source would fire underneath it and
+    render a buffer the user is in the middle of being asked about.
+    Nothing sets it yet, so it is always FALSE today -- but honouring it
+    from day one is what lets todo 21 be a one-line change.
+    */
+    if (mvr->editor_suppress_render)
+    {
+        return;
+    }
+
+    if (mvr->editor_debounce_id)
+    {
+        g_source_remove (mvr->editor_debounce_id);
+        mvr->editor_debounce_id = 0;
+    }
+    mvr->editor_debounce_id =
+    g_timeout_add (MTX_EDITOR_DEBOUNCE_MS, on_editor_debounce_timeout, mvr);
+}
+
+/**
+on_editor_buffer_changed:
+"changed" handler for the inline editor's #GtkTextBuffer. Connected
+exactly once, in mtx_viewer_new(), which is what makes
+g_signal_handlers_block_by_func()/_unblock_by_func() unambiguous for
+callers that need to suppress it around a programmatic buffer fill --
+see the two HANDOFF(todo 12) sites inside accel_toggle_editor() below.
+Marks the document dirty and immediately refreshes the O(1) GTK character
+count in the dedicated
+mvr->counter_label (a plain widget living beside mvr->status_bar in
+status_row, not inside the statusbar itself -- see the status_row
+comment in mtx_viewer_new() for why. Either way this never calls
+gtk_statusbar_push()/_pop(), so it cannot grow or disturb the
+statusbar's own message stack). The O(n) Unicode word scan is separately
+throttled and never resets its timer during a typing burst. The same handler
+also mirrors the dirty state into the window title with a leading "*". The title is
+read back and checked before writing so a "changed" burst from
+ordinary typing (this handler fires on every keystroke) never
+double-prefixes it.
+*/
+static void
+on_editor_buffer_changed (GtkTextBuffer *buffer __attribute__((unused)),
+                          gpointer data)
+{
+    MtxViewer *mvr = (MtxViewer *) data;
+
+    mvr->editor_dirty = TRUE;
+    mtx_viewer_editor_update_counter_label (mvr);
+    mtx_viewer_editor_schedule_word_count (mvr);
+
+    const gchar *title = gtk_window_get_title (GTK_WINDOW (mvr->window));
+    if (title != NULL && title[0] != '*')
+    {
+        gchar *starred = g_strdup_printf ("*%s", title);
+        gtk_window_set_title (GTK_WINDOW (mvr->window), starred);
+        g_free (starred);
+    }
+
+    /*
+    Live-preview scheduling lives HERE, in the same handler as the dirty
+    marker, rather than on a second "changed" connection -- deliberately.
+    The two programmatic gtk_text_buffer_set_text() calls in
+    accel_toggle_editor() already bracket THIS function with
+    g_signal_handlers_block_by_func()/_unblock_by_func(), so folding the
+    scheduling in means a programmatic fill or clear also schedules no
+    render, which is exactly right: revealing the pane displays a preview
+    that already matches the file, and hiding it must not render an empty
+    buffer over the page. A separate connection would need its own
+    matching block/unblock at both of those sites, i.e. two more places to
+    forget.
+    */
+    mtx_viewer_editor_schedule_render (mvr);
+}
+
+/**
+mtx_viewer_editor_wrap:
+Apply an inline Markdown wrapper to the editor selection as one user action.
+
+The complete contract is:
+1. With no selection, insert @before followed by @after and leave the caret
+   between them.
+2. If the non-whitespace selection core is already wrapped and has non-empty
+   inner content, remove both markers and select that inner content.  An exact
+   @before+@after pair is deliberately left unchanged: it has no inner content
+   whose meaning can be preserved by toggling.
+3. Preserve leading/trailing whitespace outside the markers, which therefore
+   hug the non-whitespace core.  A whitespace-only selection is refused because
+   there is no core to wrap.
+4. Refuse non-code selections containing a blank or whitespace-only line and
+   warn that emphasis cannot cross a paragraph break.
+5. Permit non-code selections across multiple non-blank lines.
+6. Treat ` / ` as code: a selection containing any newline becomes a fenced
+   block with each ``` fence on its own line; otherwise use an inline code span.
+   Inline content containing backticks gets a delimiter one backtick longer
+   than its longest run and one padding space on each side.  The code rule takes
+   precedence over the paragraph-break refusal so multi-paragraph code is still
+   represented by a valid fenced block.
+*/
+static void G_GNUC_UNUSED
+mtx_viewer_editor_wrap (MtxViewer *mvr,
+                        const gchar *before,
+                        const gchar *after)
+{
+    g_return_if_fail (mvr != NULL);
+    g_return_if_fail (GTK_IS_TEXT_VIEW (mvr->editor_view));
+    g_return_if_fail (before != NULL && before[0] != '\0');
+    g_return_if_fail (after != NULL && after[0] != '\0');
+
+    GtkTextBuffer *buffer =
+    gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+    GtkTextIter start;
+    GtkTextIter end;
+    const gboolean has_selection =
+    gtk_text_buffer_get_selection_bounds (buffer, &start, &end);
+    const gint start_offset = gtk_text_iter_get_offset (&start);
+    const glong before_chars = g_utf8_strlen (before, -1);
+
+    gtk_text_buffer_begin_user_action (buffer);
+
+    if (!has_selection)
+    {
+        gchar *pair = g_strconcat (before, after, NULL);
+        gtk_text_buffer_insert (buffer, &start, pair, -1);
+        gtk_text_buffer_get_iter_at_offset (buffer, &start,
+                                            start_offset + before_chars);
+        gtk_text_buffer_place_cursor (buffer, &start);
+        g_free (pair);
+        gtk_text_buffer_end_user_action (buffer);
+        return;
+    }
+
+    gchar *selected = gtk_text_buffer_get_text (buffer, &start, &end, TRUE);
+    const gsize selected_len = strlen (selected);
+    const gboolean is_code = strcmp (before, "`") == 0
+        && strcmp (after, "`") == 0;
+    const gboolean has_newline = strchr (selected, '\n') != NULL;
+
+    const gchar *core_start = selected;
+    while (*core_start != '\0'
+           && g_unichar_isspace (g_utf8_get_char (core_start)))
+    {
+        core_start = g_utf8_next_char (core_start);
+    }
+
+    const gchar *core_end = selected + selected_len;
+    while (core_end > core_start)
+    {
+        const gchar *previous = g_utf8_find_prev_char (selected, core_end);
+        if (previous == NULL
+            || !g_unichar_isspace (g_utf8_get_char (previous)))
+        {
+            break;
+        }
+        core_end = previous;
+    }
+
+    const gsize leading_len = (gsize) (core_start - selected);
+    const gsize core_len = (gsize) (core_end - core_start);
+    const gsize trailing_len = selected_len - leading_len - core_len;
+    const glong leading_chars = g_utf8_strlen (selected, (gssize) leading_len);
+
+    if (core_len == 0)
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 3, _("::: Formatting requires non-whitespace text :::"));
+        g_free (selected);
+        gtk_text_buffer_end_user_action (buffer);
+        return;
+    }
+
+    const gsize before_len = strlen (before);
+    const gsize after_len = strlen (after);
+    const gchar *inner_start = NULL;
+    const gchar *inner_end = NULL;
+
+    if (is_code)
+    {
+        gsize opening_run = 0;
+        gsize closing_run = 0;
+        while (opening_run < core_len && core_start[opening_run] == '`')
+        {
+            opening_run++;
+        }
+        while (closing_run < core_len && core_end[-1 - closing_run] == '`')
+        {
+            closing_run++;
+        }
+        if (opening_run > 0 && opening_run == closing_run
+            && core_len > opening_run + closing_run)
+        {
+            inner_start = core_start + opening_run;
+            inner_end = core_end - closing_run;
+            if (inner_end - inner_start >= 2
+                && inner_start[0] == ' ' && inner_end[-1] == ' '
+                && memchr (inner_start + 1, '`',
+                           (gsize) (inner_end - inner_start - 2)) != NULL)
+            {
+                inner_start++;
+                inner_end--;
+            }
+        }
+    }
+    else if (core_len > before_len + after_len
+             && memcmp (core_start, before, before_len) == 0
+             && memcmp (core_end - after_len, after, after_len) == 0)
+    {
+        inner_start = core_start + before_len;
+        inner_end = core_end - after_len;
+    }
+
+    if (inner_start != NULL)
+    {
+        GString *replacement = g_string_sized_new (selected_len);
+        g_string_append_len (replacement, selected, (gssize) leading_len);
+        g_string_append_len (replacement, inner_start,
+                             (gssize) (inner_end - inner_start));
+        g_string_append_len (replacement, core_end, (gssize) trailing_len);
+
+        const glong inner_chars =
+        g_utf8_strlen (inner_start, (gssize) (inner_end - inner_start));
+        gtk_text_buffer_delete (buffer, &start, &end);
+        gtk_text_buffer_insert (buffer, &start, replacement->str, -1);
+        gtk_text_buffer_get_iter_at_offset
+        (buffer, &start, start_offset + leading_chars);
+        gtk_text_buffer_get_iter_at_offset
+        (buffer, &end, start_offset + leading_chars + inner_chars);
+        gtk_text_buffer_select_range (buffer, &end, &start);
+
+        g_string_free (replacement, TRUE);
+        g_free (selected);
+        gtk_text_buffer_end_user_action (buffer);
+        return;
+    }
+
+    if (core_len == before_len + after_len
+        && memcmp (core_start, before, before_len) == 0
+        && memcmp (core_end - after_len, after, after_len) == 0)
+    {
+        g_free (selected);
+        gtk_text_buffer_end_user_action (buffer);
+        return;
+    }
+
+    if (is_code && has_newline)
+    {
+        const gboolean starts_line = gtk_text_iter_starts_line (&start);
+        const gboolean ends_after_newline = gtk_text_iter_starts_line (&end);
+        const gboolean ends_before_newline = !gtk_text_iter_is_end (&end)
+            && gtk_text_iter_get_char (&end) == '\n';
+        const gchar *opening = starts_line ? "```\n" : "\n```\n";
+        const gchar *closing = ends_after_newline ? "```\n"
+            : ends_before_newline ? "\n```" : "\n```\n";
+        gchar *replacement =
+        g_strconcat (opening, selected, closing, NULL);
+        const glong replacement_chars = g_utf8_strlen (replacement, -1);
+
+        gtk_text_buffer_delete (buffer, &start, &end);
+        gtk_text_buffer_insert (buffer, &start, replacement, -1);
+        gtk_text_buffer_get_iter_at_offset (buffer, &start, start_offset);
+        gtk_text_buffer_get_iter_at_offset
+        (buffer, &end, start_offset + replacement_chars);
+        gtk_text_buffer_select_range (buffer, &end, &start);
+
+        g_free (replacement);
+        g_free (selected);
+        gtk_text_buffer_end_user_action (buffer);
+        return;
+    }
+
+    if (!is_code && has_newline)
+    {
+        const gchar *line_end = strchr (selected, '\n');
+        while (line_end != NULL)
+        {
+            const gchar *next_line = line_end + 1;
+            const gchar *cursor = next_line;
+            gboolean blank = TRUE;
+            while (*cursor != '\0' && *cursor != '\n')
+            {
+                if (!g_unichar_isspace (g_utf8_get_char (cursor)))
+                {
+                    blank = FALSE;
+                }
+                cursor = g_utf8_next_char (cursor);
+            }
+            if (*cursor == '\n' && blank)
+            {
+                mtx_viewer_statusbar_warn_seconds
+                (mvr, 3, _("::: Emphasis cannot cross a paragraph break :::"));
+                g_free (selected);
+                gtk_text_buffer_end_user_action (buffer);
+                return;
+            }
+            line_end = strchr (next_line, '\n');
+        }
+    }
+
+    GString *replacement = g_string_sized_new
+    (selected_len + before_len + after_len + 4);
+    g_string_append_len (replacement, selected, (gssize) leading_len);
+    const gsize wrapped_start_bytes = replacement->len;
+
+    if (is_code)
+    {
+        gsize current_run = 0;
+        gsize longest_run = 0;
+        for (const gchar *cursor = core_start; cursor < core_end; cursor++)
+        {
+            if (*cursor == '`')
+            {
+                current_run++;
+                longest_run = MAX (longest_run, current_run);
+            }
+            else
+            {
+                current_run = 0;
+            }
+        }
+        const gsize delimiter_len = longest_run + 1;
+        for (gsize i = 0; i < delimiter_len; i++)
+        {
+            g_string_append_c (replacement, '`');
+        }
+        if (longest_run > 0)
+        {
+            g_string_append_c (replacement, ' ');
+        }
+        g_string_append_len (replacement, core_start, (gssize) core_len);
+        if (longest_run > 0)
+        {
+            g_string_append_c (replacement, ' ');
+        }
+        for (gsize i = 0; i < delimiter_len; i++)
+        {
+            g_string_append_c (replacement, '`');
+        }
+    }
+    else
+    {
+        g_string_append (replacement, before);
+        g_string_append_len (replacement, core_start, (gssize) core_len);
+        g_string_append (replacement, after);
+    }
+
+    const gsize wrapped_len = replacement->len - wrapped_start_bytes;
+    g_string_append_len (replacement, core_end, (gssize) trailing_len);
+    const glong wrapped_chars = g_utf8_strlen
+    (replacement->str + wrapped_start_bytes, (gssize) wrapped_len);
+
+    gtk_text_buffer_delete (buffer, &start, &end);
+    gtk_text_buffer_insert (buffer, &start, replacement->str, -1);
+    gtk_text_buffer_get_iter_at_offset
+    (buffer, &start, start_offset + leading_chars);
+    gtk_text_buffer_get_iter_at_offset
+    (buffer, &end, start_offset + leading_chars + wrapped_chars);
+    gtk_text_buffer_select_range (buffer, &end, &start);
+
+    g_string_free (replacement, TRUE);
+    g_free (selected);
+    gtk_text_buffer_end_user_action (buffer);
+}
+
+/**
+mtx_viewer_editor_prefix:
+Apply a block Markdown prefix to complete editor lines as one user action.
+
+The complete contract is:
+1. Target every line touched by the selection, or the caret's current line when
+   there is no selection.  A heading targets only the first such line.
+2. A heading replaces an existing one-to-six-hash ATX marker.  On a quote or
+   list line, the heading follows the existing "> " or "- " marker.
+3. Quote prefixes toggle all target lines together, including blank lines.
+4. List prefixes toggle all non-blank target lines together and leave blank
+   lines unchanged.
+5. Prefixes follow each line's existing leading Unicode whitespace.
+6. Mutations emit only GtkTextBuffer's natural "changed" signals; Todo 12's
+   handler therefore owns dirty tracking without any manual update here.
+*/
+static void G_GNUC_UNUSED
+mtx_viewer_editor_prefix (MtxViewer *mvr, const gchar *prefix)
+{
+    g_return_if_fail (mvr != NULL);
+    g_return_if_fail (GTK_IS_TEXT_VIEW (mvr->editor_view));
+    g_return_if_fail (prefix != NULL && prefix[0] != '\0');
+
+    const gboolean is_heading = prefix[0] == '#';
+    const gboolean is_quote = strcmp (prefix, "> ") == 0;
+    const gboolean is_list = strcmp (prefix, "- ") == 0;
+    g_return_if_fail (is_heading || is_quote || is_list);
+
+    GtkTextBuffer *buffer =
+    gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+    GtkTextIter selection_start;
+    GtkTextIter selection_end;
+    const gboolean has_selection = gtk_text_buffer_get_selection_bounds
+    (buffer, &selection_start, &selection_end);
+    const gint first_line = gtk_text_iter_get_line (&selection_start);
+    gint last_line = gtk_text_iter_get_line (&selection_end);
+
+    /* A half-open selection ending at column zero does not touch that line. */
+    if (has_selection && last_line > first_line
+        && gtk_text_iter_starts_line (&selection_end))
+    {
+        last_line--;
+    }
+    if (is_heading)
+    {
+        last_line = first_line;
+    }
+
+    GtkTextMark *selection_start_mark = NULL;
+    GtkTextMark *selection_end_mark = NULL;
+    if (has_selection)
+    {
+        selection_start_mark = gtk_text_buffer_create_mark
+        (buffer, NULL, &selection_start, TRUE);
+        selection_end_mark = gtk_text_buffer_create_mark
+        (buffer, NULL, &selection_end, FALSE);
+    }
+
+    gtk_text_buffer_begin_user_action (buffer);
+
+    gboolean remove_prefix = !is_heading;
+    gboolean has_eligible_line = FALSE;
+    if (!is_heading)
+    {
+        for (gint line = first_line; line <= last_line; line++)
+        {
+            GtkTextIter line_start;
+            GtkTextIter line_end;
+            gtk_text_buffer_get_start_iter (buffer, &line_start);
+            gtk_text_iter_forward_lines (&line_start, line);
+            line_end = line_start;
+            if (!gtk_text_iter_ends_line (&line_end))
+            {
+                gtk_text_iter_forward_to_line_end (&line_end);
+            }
+
+            gchar *text = gtk_text_buffer_get_text
+            (buffer, &line_start, &line_end, TRUE);
+            const gchar *content = text;
+            while (*content != '\0'
+                   && g_unichar_isspace (g_utf8_get_char (content)))
+            {
+                content = g_utf8_next_char (content);
+            }
+
+            const gboolean blank = *content == '\0';
+            if (!is_list || !blank)
+            {
+                has_eligible_line = TRUE;
+                if (!g_str_has_prefix (content, prefix))
+                {
+                    remove_prefix = FALSE;
+                }
+            }
+            g_free (text);
+        }
+    }
+
+    for (gint line = last_line; line >= first_line; line--)
+    {
+        GtkTextIter line_start;
+        GtkTextIter line_end;
+        gtk_text_buffer_get_start_iter (buffer, &line_start);
+        gtk_text_iter_forward_lines (&line_start, line);
+        line_end = line_start;
+        if (!gtk_text_iter_ends_line (&line_end))
+        {
+            gtk_text_iter_forward_to_line_end (&line_end);
+        }
+
+        gchar *text = gtk_text_buffer_get_text
+        (buffer, &line_start, &line_end, TRUE);
+        const gchar *content = text;
+        while (*content != '\0'
+               && g_unichar_isspace (g_utf8_get_char (content)))
+        {
+            content = g_utf8_next_char (content);
+        }
+
+        const gboolean blank = *content == '\0';
+        const glong leading_chars = g_utf8_strlen
+        (text, (gssize) (content - text));
+        GtkTextIter marker_start = line_start;
+        gtk_text_iter_forward_chars (&marker_start, (gint) leading_chars);
+
+        if (is_heading)
+        {
+            const gchar *heading = content;
+            if (g_str_has_prefix (heading, "> ")
+                || g_str_has_prefix (heading, "- "))
+            {
+                heading += 2;
+                gtk_text_iter_forward_chars (&marker_start, 2);
+            }
+
+            gsize hashes = 0;
+            while (hashes < 6 && heading[hashes] == '#')
+            {
+                hashes++;
+            }
+            const gboolean has_heading = hashes > 0 && heading[hashes] == ' ';
+            const gsize old_marker_len = has_heading ? hashes + 1 : 0;
+
+            if (old_marker_len == 0
+                || strlen (prefix) != old_marker_len
+                || memcmp (heading, prefix, old_marker_len) != 0)
+            {
+                if (has_heading)
+                {
+                    GtkTextIter marker_end = marker_start;
+                    gtk_text_iter_forward_chars
+                    (&marker_end, (gint) old_marker_len);
+                    gtk_text_buffer_delete
+                    (buffer, &marker_start, &marker_end);
+                }
+                gtk_text_buffer_insert (buffer, &marker_start, prefix, -1);
+            }
+        }
+        else if ((!is_list || !blank) && has_eligible_line)
+        {
+            if (remove_prefix)
+            {
+                GtkTextIter marker_end = marker_start;
+                gtk_text_iter_forward_chars
+                (&marker_end, (gint) g_utf8_strlen (prefix, -1));
+                gtk_text_buffer_delete (buffer, &marker_start, &marker_end);
+            }
+            else
+            {
+                gtk_text_buffer_insert (buffer, &marker_start, prefix, -1);
+            }
+        }
+        g_free (text);
+    }
+
+    if (has_selection)
+    {
+        gtk_text_buffer_get_iter_at_mark
+        (buffer, &selection_start, selection_start_mark);
+        gtk_text_buffer_get_iter_at_mark
+        (buffer, &selection_end, selection_end_mark);
+        gtk_text_buffer_select_range
+        (buffer, &selection_end, &selection_start);
+        gtk_text_buffer_delete_mark (buffer, selection_start_mark);
+        gtk_text_buffer_delete_mark (buffer, selection_end_mark);
+    }
+
+    gtk_text_buffer_end_user_action (buffer);
+}
+
+/**
+accel_toggle_editor:
+Show or hide the inline Markdown editor pane (F2 / toolbar button).
+Refuses to reveal the pane on a page that is not editable.
+*/
+static gboolean
+on_editor_paned_set_initial_position (gpointer data)
+{
+    GtkWidget *paned = data;
+    gint width = gtk_widget_get_allocated_width (paned);
+
+    gtk_paned_set_position (GTK_PANED (paned), width / 2);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+on_editor_paned_first_size_allocate (GtkWidget *widget,
+                                     GdkRectangle *allocation
+                                     __attribute__((unused)),
+                                     gpointer data)
+{
+    GtkWidget *editor_box = data;
+
+    if (!gtk_widget_get_mapped (editor_box))
+    {
+        return;
+    }
+    g_signal_handlers_disconnect_by_func
+    (widget, G_CALLBACK (on_editor_paned_first_size_allocate), data);
+    g_idle_add_full (G_PRIORITY_DEFAULT_IDLE,
+                     on_editor_paned_set_initial_position,
+                     g_object_ref (widget), g_object_unref);
+}
+
+static gboolean
+mtx_viewer_editor_reveal (MtxViewer *mvr, GtkWidget *editor_box)
+{
+    static gboolean editor_position_set = FALSE;
+
+    /*
+    The editability gate. On success mtx_viewer_editor_target() has
+    already stored the canonical, symlink-resolved absolute path in
+    mvr->editor_path (plus the mtime/size snapshot todo 20 compares
+    against), so resolved_path is only a convenience copy here and
+    nothing downstream -- todo 11's buffer load, todo 19's save --
+    may re-derive a path from mvr->current_file, which is often
+    relative.
+    */
+    if (!mtx_viewer_editor_load_current (mvr))
+    {
+        return FALSE;
+    }
+
+    if (!editor_position_set)
+    {
+        g_signal_connect_after (mvr->paned, "size-allocate",
+                                G_CALLBACK
+                                (on_editor_paned_first_size_allocate),
+                                editor_box);
+        editor_position_set = TRUE;
+    }
+    gtk_widget_show_all (editor_box);
+    gtk_widget_grab_focus (mvr->editor_view);
+    return TRUE;
+}
+
+static gboolean
+accel_toggle_editor (GtkAccelGroup *group __attribute__((unused)),
+                     GObject *obj __attribute__((unused)),
+                     guint keyval __attribute__((unused)),
+                     GdkModifierType mod __attribute__((unused)),
+                     gpointer data)
+{
+    MtxViewer *mvr = (MtxViewer *) data;
+    /*
+    editor_box (the vertical GtkBox built in mtx_viewer_new(), wrapping
+    editor_toolbar + editor_scrolled) is a local variable there, not an mvr
+    struct field -- todo 7 deliberately did not add one (see the todo 8
+    learnings entry). mtx_viewer_new() show_all()s the whole window and
+    then explicitly hides ONLY editor_box; editor_toolbar, editor_scrolled
+    and editor_view keep their own "visible" property TRUE from that
+    show_all. A GTK container only maps a child once the child's entire
+    ancestor chain is itself mapped, so toggling the already-TRUE children
+    directly would be a no-op (empirically confirmed with a standalone GTK
+    test: re-asserting a visible child's own "visible" flag while its
+    parent stays hidden never maps it). The widget that actually gates
+    on-screen visibility is editor_box itself, so that is what gets
+    toggled here, reached via its parent pointer instead of storing an
+    extra field (mtxviewer.h is off-limits for this todo).
+    */
+    GtkWidget *editor_box = gtk_widget_get_parent (mvr->editor_scrolled);
+
+    if (gtk_widget_get_visible (editor_box))
+    {
+        /* Pane is visible: HIDE it. */
+        if (!mtx_viewer_editor_confirm_discard_full (mvr, TRUE, FALSE))
+        {
+            return TRUE;
+        }
+        mtx_viewer_editor_hide (mvr);
+    }
+    else
+    {
+        /* Pane is hidden: try to REVEAL it. */
+        if (!mtx_viewer_editor_reveal (mvr, editor_box))
+        {
+            return TRUE;
+        }
+    }
+
+    return TRUE;
+}
