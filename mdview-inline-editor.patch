+static gint
+mtx_viewer_editor_word_count (const gchar *text)
+{
+    gint words = 0;
+    gboolean in_word = FALSE;
+
+    for (const gchar *p = text; *p != '\0'; p = g_utf8_next_char (p))
+    {
