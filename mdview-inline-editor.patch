+typedef struct
+{
+    const gchar *title;
+    const gchar *text_label;
+    const gchar *url_label;
+    gchar *text;
+    gchar *url;
+} MtxViewerEditorReference;
+
+static gboolean
+mtx_viewer_editor_reference_dialog (MtxViewer *mvr,
+                                    MtxViewerEditorReference *reference)
+{
+    GtkWidget *dialog = gtk_dialog_new_with_buttons
+    (reference->title, GTK_WINDOW (mvr->window),
+     GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+     _("_Cancel"), GTK_RESPONSE_CANCEL,
+     _("_Insert"), GTK_RESPONSE_ACCEPT, NULL);
+    GtkWidget *grid = gtk_grid_new ();
+    GtkWidget *text_label = gtk_label_new_with_mnemonic (reference->text_label);
+    GtkWidget *url_label = gtk_label_new_with_mnemonic (reference->url_label);
+    GtkWidget *text_entry = gtk_entry_new ();
+    GtkWidget *url_entry = gtk_entry_new ();
+
+    gtk_entry_set_text (GTK_ENTRY (text_entry), reference->text);
+    gtk_label_set_mnemonic_widget (GTK_LABEL (text_label), text_entry);
+    gtk_label_set_mnemonic_widget (GTK_LABEL (url_label), url_entry);
+    gtk_grid_set_column_spacing (GTK_GRID (grid), 8);
+    gtk_grid_set_row_spacing (GTK_GRID (grid), 8);
+    gtk_grid_attach (GTK_GRID (grid), text_label, 0, 0, 1, 1);
+    gtk_grid_attach (GTK_GRID (grid), text_entry, 1, 0, 1, 1);
+    gtk_grid_attach (GTK_GRID (grid), url_label, 0, 1, 1, 1);
+    gtk_grid_attach (GTK_GRID (grid), url_entry, 1, 1, 1, 1);
+    gtk_container_set_border_width (GTK_CONTAINER (grid), 12);
+    gtk_container_add (GTK_CONTAINER
+                       (gtk_dialog_get_content_area (GTK_DIALOG (dialog))), grid);
+    gtk_entry_set_activates_default (GTK_ENTRY (url_entry), TRUE);
+    gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_ACCEPT);
+    gtk_widget_show_all (grid);
+    gtk_widget_grab_focus (url_entry);
+
+    mvr->editor_suppress_render = TRUE;
+    const gint response = gtk_dialog_run (GTK_DIALOG (dialog));
+    mvr->editor_suppress_render = FALSE;
+    if (response == GTK_RESPONSE_ACCEPT)
+    {
+        g_free (reference->text);
+        g_free (reference->url);
+        reference->text = g_strdup
+        (gtk_entry_get_text (GTK_ENTRY (text_entry)));
+        reference->url = g_strdup
+        (gtk_entry_get_text (GTK_ENTRY (url_entry)));
+    }
+    gtk_widget_destroy (dialog);
+    return response == GTK_RESPONSE_ACCEPT;
+}
