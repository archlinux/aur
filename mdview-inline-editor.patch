+/**
+on_editor_scroll_value_changed:
+"value-changed" handler for the inline editor's vertical GtkAdjustment
+(mvr->editor_scrolled's GtkScrolledWindow). Connected exactly once, in
+mtx_viewer_new(), directly to that adjustment object -- this is the
+ONLY "value-changed" connection this file makes to any GtkAdjustment
+(grep proof lives in the todo-18 evidence file: no other g_signal_connect
+in src/ names "value-changed", "vadjustment" or "hadjustment"). That is
+what makes the sync provably one-way: the preview's own vertical
+adjustment has no listener anywhere in this codebase, so the
+gtk_adjustment_set_value() call below cannot trigger a handler that
+scrolls the editor back -- there is no such handler to trigger. No
+re-entrancy flag is needed for that reason: a flag exists to break a
+cycle between two listeners watching each other; here only one endpoint
+listens at all, so there is no cycle to break, by construction rather
+than by assumption.
+
+Re-acquires BOTH adjustments fresh on every call, via
+gtk_scrolled_window_get_vadjustment(), rather than trusting the
+"adjustment" parameter GTK hands this handler or any prior lookup, and
+never touches either GtkTextBuffer, a GtkTextMark or a GtkTextIter.
+mtx_text_view_reset_buffer() (mtxtextview.c:724-743) decides whether to
+unref the PREVIEW's OLD buffer by inspecting its ref_count directly;
+holding any extra reference here -- by caching an adjustment, buffer,
+mark or iter across calls instead of re-fetching every time -- would
+leak one full tagged document copy per keystroke.
+
+The mapping applied below is PROPORTIONAL, not line-accurate, by
+design: mtx_cmm_mtx() erases the "<mtx>" metadata prefix and any YAML
+front matter before parsing (mtxcmm.c:3978-3979, :4155), and the raw
+Markdown source is freed right after parsing (the clear_markdown
+optimisation mtx_viewer_editor's own file-load comment already cites),
+so no line in the editor maps onto a specific line in the preview.
+A document that opens with e.g. a 30-line front-matter block therefore
+shows a permanent, constant offset between how far down the editor and
+how far down the preview the two views sit for the same scroll
+fraction -- expected and accepted, not a bug to fix here.
+*/
+static void
+on_editor_scroll_value_changed (GtkAdjustment *adjustment __attribute__((unused)),
+                                gpointer data)
+{
+    MtxViewer *mvr = (MtxViewer *) data;
+
+    g_return_if_fail (GTK_IS_SCROLLED_WINDOW (mvr->editor_scrolled));
+    GtkAdjustment *editor_adj = gtk_scrolled_window_get_vadjustment
+    (GTK_SCROLLED_WINDOW (mvr->editor_scrolled));
+    GtkAdjustment *preview_adj = mtx_viewer_editor_preview_vadjustment (mvr);
+
+    if (editor_adj == NULL || preview_adj == NULL)
+    {
+        return;
+    }
+
+    /*
+    editor_range <= 0 means the document is shorter than the viewport
+    (nothing to scroll) or the widget has not been laid out yet (upper
+    and page_size still equal, both at their construction-time
+    defaults). Either way there is no meaningful position to
+    propagate: treat it as the top rather than dividing by zero or by
+    a negative denominator.
+    */
+    gdouble editor_range = gtk_adjustment_get_upper (editor_adj) -
+        gtk_adjustment_get_page_size (editor_adj);
+    gdouble fraction = editor_range > 0.0 ?
+        gtk_adjustment_get_value (editor_adj) / editor_range : 0.0;
+
+    /*
+    Same guard, mirrored, on the write side: a preview shorter than its
+    own viewport (or not yet laid out) has no meaningful target either,
+    so land on the top rather than push a negative value at
+    gtk_adjustment_set_value() (which would merely be clamped, but
+    computing it is meaningless and not worth relying on that clamp).
+    */
+    gdouble preview_range = gtk_adjustment_get_upper (preview_adj) -
+        gtk_adjustment_get_page_size (preview_adj);
+    gdouble new_value = preview_range > 0.0 ? fraction * preview_range : 0.0;
+
+    gtk_adjustment_set_value (preview_adj, new_value);
+}
