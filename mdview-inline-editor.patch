+/**
+mtx_viewer_editor_confirm_discard:
+Ask what to do before an interactive action discards the visible editor's
+unsaved contents.
+
+Returns: TRUE when the caller may proceed, FALSE when it must abort.
+*/
+static gchar *
+mtx_viewer_editor_choose_save_path (MtxViewer *mvr)
+{
+    const gint hold_fd = open (mvr->backing_file, O_RDONLY);
+    GtkWidget *dialog = gtk_file_chooser_dialog_new
+    (_("Save Markdown Page As"), GTK_WINDOW (mvr->window),
+     GTK_FILE_CHOOSER_ACTION_SAVE,
+     _("_Cancel"), GTK_RESPONSE_CANCEL,
+     _("_Save"), GTK_RESPONSE_ACCEPT, NULL);
+    GtkFileChooser *chooser = GTK_FILE_CHOOSER (dialog);
+    GtkFileFilter *filter = gtk_file_filter_new ();
+    gtk_file_filter_set_name (filter, _("Markdown files"));
+    gtk_file_filter_add_pattern (filter, "*.md");
+    gtk_file_filter_add_pattern (filter, "*.markdown");
+    gtk_file_chooser_add_filter (chooser, filter);
+    gtk_file_chooser_set_filter (chooser, filter);
+    gtk_file_chooser_set_local_only (chooser, TRUE);
+    gtk_file_chooser_set_do_overwrite_confirmation (chooser, TRUE);
+
+    g_autofree gchar *directory = g_path_get_dirname (mvr->editor_path);
+    g_autofree gchar *name = g_path_get_basename (mvr->editor_path);
+    gtk_file_chooser_set_current_folder (chooser, directory);
+    gtk_file_chooser_set_current_name (chooser, name);
+
+    const gint response = gtk_dialog_run (GTK_DIALOG (dialog));
+    gchar *path = response == GTK_RESPONSE_ACCEPT
+        ? gtk_file_chooser_get_filename (chooser) : NULL;
+    gtk_widget_destroy (dialog);
+    if (hold_fd >= 0)
+    {
+        close (hold_fd);
+    }
+    if (path != NULL
+        && !g_str_has_suffix (path, ".md")
+        && !g_str_has_suffix (path, ".markdown"))
+    {
+        gchar *with_extension = g_strconcat (path, ".md", NULL);
+        g_free (path);
+        path = with_extension;
+    }
+    return path;
+}
+
+static gboolean
+mtx_viewer_editor_confirm_discard_full (MtxViewer *mvr,
+                                        gboolean rerender_on_discard,
+                                        gboolean is_quit_trigger)
+{
+    GtkWidget *editor_box = gtk_widget_get_parent (mvr->editor_scrolled);
+
+    if (!gtk_widget_get_visible (editor_box) || !mvr->editor_dirty)
+    {
+        return TRUE;
+    }
+
+    GtkWidget *dialog = gtk_message_dialog_new
+    (GTK_WINDOW (mvr->window),
+     GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+     GTK_MESSAGE_WARNING, GTK_BUTTONS_NONE, "%s",
+     _("The document has unsaved changes."));
+    gtk_message_dialog_format_secondary_text
+    (GTK_MESSAGE_DIALOG (dialog), "%s",
+     _("Save your changes before continuing?"));
+    gtk_dialog_add_buttons (GTK_DIALOG (dialog),
+                            _("_Cancel"), GTK_RESPONSE_CANCEL,
+                            _("_Discard"), GTK_RESPONSE_REJECT,
+                            _("Save _As..."), MTX_RESPONSE_SAVE_AS,
+                            _("_Save"), GTK_RESPONSE_ACCEPT,
+                            NULL);
+    gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_CANCEL);
+
+    /* gtk_dialog_run() spins a nested main loop. Keep suppression raised
+       through response dispatch too: Save can open a nested dialog, and
+       Discard reloads and queues its replacement render in this region. */
+    mvr->editor_suppress_render = TRUE;
+    const gint response = gtk_dialog_run (GTK_DIALOG (dialog));
+    gtk_widget_destroy (dialog);
+
+    gboolean proceed = FALSE;
+    gboolean save_as_success = FALSE;
+    gchar *discard_text = NULL;
+    gchar *saved_path = NULL;
+    if (response == GTK_RESPONSE_REJECT)
+    {
+        mtx_viewer_editor_indicator_reset (mvr);
+        if (!mtx_viewer_editor_load_current (mvr))
+        {
+            mtx_viewer_editor_hide (mvr);
+        }
+        else
+        {
+            proceed = TRUE;
+            if (rerender_on_discard)
+            {
+                GtkTextBuffer *buffer =
+                gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+                GtkTextIter start, end;
+                gtk_text_buffer_get_start_iter (buffer, &start);
+                gtk_text_buffer_get_end_iter (buffer, &end);
+                discard_text = gtk_text_buffer_get_text
+                (buffer, &start, &end, FALSE);
+            }
+        }
+    }
+    else if (response == GTK_RESPONSE_ACCEPT)
+    {
+        GError *error = NULL;
+        proceed = mtx_viewer_editor_save_to_path
+        (mvr, mvr->editor_path, TRUE, &error);
+        if (error != NULL)
+        {
+            gchar *message = g_strdup_printf (_("::: Save failed: %s :::"),
+                                              error->message);
+            mtx_viewer_statusbar_warn_seconds (mvr, 5, message);
+            g_free (message);
+            g_error_free (error);
+        }
+    }
+    else if (response == MTX_RESPONSE_SAVE_AS)
+    {
+        saved_path = mtx_viewer_editor_choose_save_path (mvr);
+        if (saved_path != NULL)
+        {
+            GError *error = NULL;
+            save_as_success = mtx_viewer_editor_save_to_path
+            (mvr, saved_path, FALSE, &error);
+            if (error != NULL)
+            {
+                gchar *message = g_strdup_printf (_("::: Save failed: %s :::"),
+                                                  error->message);
+                mtx_viewer_statusbar_warn_seconds (mvr, 5, message);
+                g_free (message);
+                g_error_free (error);
+            }
+            proceed = save_as_success && is_quit_trigger;
+        }
+    }
+
+    if (proceed || save_as_success)
+    {
+        if (mvr->editor_debounce_id)
+        {
+            g_source_remove (mvr->editor_debounce_id);
+            mvr->editor_debounce_id = 0;
+        }
+        mvr->editor_render_pending = FALSE;
+    }
+
+    if (proceed && discard_text != NULL)
+    {
+        mtx_viewer_editor_issue_render_full
+        (mvr, FALSE, 0, 0.0, discard_text, TRUE);
+    }
+    g_free (discard_text);
+
+    if (save_as_success && !is_quit_trigger)
+    {
+        mtx_viewer_editor_hide (mvr);
+        if (!mtx_viewer_is_page_in_progress (mvr))
+        {
+            (void) mtx_viewer_present_page (mvr, saved_path, 0);
+        }
+        else
+        {
+            mtx_viewer_statusbar_warn_seconds
+            (mvr, 3, _("::: Cannot switch to the saved page while another page is loading :::"));
+        }
+    }
+    g_free (saved_path);
+    mvr->editor_suppress_render = FALSE;
+    return proceed;
+}
+
+static gboolean G_GNUC_UNUSED
+mtx_viewer_editor_confirm_discard (MtxViewer *mvr)
+{
+    return mtx_viewer_editor_confirm_discard_full (mvr, FALSE, FALSE);
+}
