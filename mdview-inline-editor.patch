+static void
+mtx_viewer_editor_insert_reference (MtxViewer *mvr, gboolean image)
+{
+    GtkTextBuffer *buffer =
+    gtk_text_view_get_buffer (GTK_TEXT_VIEW (mvr->editor_view));
+    GtkTextIter start, end;
+    const gboolean had_selection =
+    gtk_text_buffer_get_selection_bounds (buffer, &start, &end);
+    gchar *selected = had_selection
+        ? gtk_text_buffer_get_text (buffer, &start, &end, TRUE)
+        : g_strdup (image ? "" : _("text"));
+    if (strchr (selected, '\n') != NULL)
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 3, _("::: Link text must stay on one line :::"));
+        g_free (selected);
+        return;
+    }
+
+    MtxViewerEditorReference reference = {
+        image ? _("Insert Image") : _("Insert Link"),
+        image ? _("_Alternative text:") : _("_Link text:"),
+        image ? _("Image _URL:") : _("_URL:"),
+        selected,
+        g_strdup ("")
+    };
+    if (!mtx_viewer_editor_reference_dialog (mvr, &reference))
+    {
+        g_free (reference.text);
+        g_free (reference.url);
+        gtk_widget_grab_focus (mvr->editor_view);
+        return;
+    }
+    g_strstrip (reference.url);
+    if (reference.url[0] == '\0')
+    {
+        mtx_viewer_statusbar_warn_seconds
+        (mvr, 3, _("::: A URL is required :::"));
+        g_free (reference.text);
+        g_free (reference.url);
+        gtk_widget_grab_focus (mvr->editor_view);
+        return;
+    }
+
+    gchar *markdown = image
+        ? g_strdup_printf ("![%s](%s)", reference.text, reference.url)
+        : g_strdup_printf ("[%s](%s)", reference.text, reference.url);
+    gtk_text_buffer_get_selection_bounds (buffer, &start, &end);
+    const gint offset = gtk_text_iter_get_offset (&start);
+    gtk_text_buffer_begin_user_action (buffer);
+    if (had_selection)
+    {
+        gtk_text_buffer_delete (buffer, &start, &end);
+    }
+    gtk_text_buffer_insert (buffer, &start, markdown, -1);
+    if (!image && !had_selection)
+    {
+        gtk_text_buffer_get_iter_at_offset (buffer, &start, offset + 1);
+        gtk_text_buffer_get_iter_at_offset
+        (buffer, &end, offset + 1 + g_utf8_strlen (reference.text, -1));
+        gtk_text_buffer_select_range (buffer, &end, &start);
+    }
+    else if (image || had_selection)
+    {
+        gtk_text_buffer_get_iter_at_offset
+        (buffer, &start, offset + g_utf8_strlen (markdown, -1));
+        gtk_text_buffer_place_cursor (buffer, &start);
+    }
+    gtk_text_buffer_end_user_action (buffer);
+
+    g_free (markdown);
+    g_free (reference.text);
+    g_free (reference.url);
+    gtk_widget_grab_focus (mvr->editor_view);
+}
