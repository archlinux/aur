+typedef struct
+{
+    gchar *dir;
+    gchar *file;
+    gchar *base;
+    gchar *working_dir;
+} MtxRenderSource;
+
+static void
+mtx_render_source_clear (MtxRenderSource *src)
+{
+    g_clear_pointer (&src->dir, g_free);
+    g_clear_pointer (&src->file, g_free);
+    g_clear_pointer (&src->base, g_free);
+    g_clear_pointer (&src->working_dir, g_free);
+}
+
+/**
+mtx_viewer_resolve_render_source:
+Resolve the current page into the arguments a child renderer needs: the two
+positional arguments, a basename to derive output names from, and the
+directory to spawn the child in.
+
+Returns: FALSE when the current page has no renderable on-disk source.
+*/
+static gboolean
+mtx_viewer_resolve_render_source (MtxViewer *mvr,
+                                  MtxRenderSource *out)
+{
+    const gchar *scheme = g_uri_peek_scheme (mvr->current_file);
+
+    if G_UNLIKELY (g_strcmp0 (scheme, "search") == 0)
+    {
+        out->dir = g_strdup (mvr->backing_file);
+        out->file = g_strdup ("");
+        out->working_dir = g_path_get_dirname (mvr->backing_file);
+        out->base =
+        g_strdelimit (g_strdup (mvr->current_file + sizeof "search://" - 1),
+                      " \t" G_DIR_SEPARATOR_S, '_');
+        return TRUE;
+    }
+    if (scheme == NULL && mtx_viewer_is_current_tracked (mvr))
+    {
+        const gchar *page = mvr->current_file;
+        g_autofree gchar *document_path = NULL;
+
+        if (!g_path_is_absolute (page))
+        {
+            MtxTextView *tv = (MtxTextView *) mvr->text_view;
+            document_path =
+            g_build_filename (tv->image_directory, page, NULL);
+            page = document_path;
+        }
+        g_autofree gchar *resolved =
+        mtx_viewer_resolve_document_path (mvr, page, NULL);
+        if (resolved == NULL)
+        {
+            return FALSE;
+        }
+        out->dir = g_path_get_dirname (resolved);
+        out->file = g_path_get_basename (resolved);
+        out->base = g_strdup (out->file);
+        out->working_dir = g_strdup (out->dir);
+        return TRUE;
+    }
+    out->dir = g_strdup (mvr->base_directory);
+    out->file = g_strdup (mvr->current_file);
+    out->base = g_path_get_basename (mvr->current_file);
+    return TRUE;
+}
+
+static void
+mtx_viewer_remove_flat_dir (const gchar *path)
+{
+    GDir *dir = g_dir_open (path, 0, NULL);
+
+    if (dir != NULL)
+    {
+        const gchar *entry;
+
+        while ((entry = g_dir_read_name (dir)) != NULL)
+        {
+            g_autofree gchar *victim = g_build_filename (path, entry, NULL);
+            (void) g_unlink (victim);
+        }
+        g_dir_close (dir);
+    }
+    (void) g_rmdir (path);
+}
+
+static void
+mtx_viewer_prune_dead_preview_sessions (const gchar *root)
+{
+    GDir *dir = g_dir_open (root, 0, NULL);
+    const gulong self = (gulong) getpid ();
+    const gchar *entry;
+
+    if (dir == NULL)
+    {
+        return;
+    }
+    while ((entry = g_dir_read_name (dir)) != NULL)
+    {
+        gchar *end = NULL;
+        const gulong pid = strtoul (entry, &end, 10);
+
+        if (end == entry || *end != '\0' || pid == self)
+        {
+            continue;
+        }
+        g_autofree gchar *proc = g_strdup_printf ("/proc/%lu", pid);
+        if (g_file_test (proc, G_FILE_TEST_IS_DIR))
+        {
+            continue;
+        }
+        g_autofree gchar *stale = g_build_filename (root, entry, NULL);
+        mtx_viewer_remove_flat_dir (stale);
+    }
+    g_dir_close (dir);
+}
+
+/**
+mtx_viewer_preview_dir:
+Return the directory that receives this process's generated preview and
+export files, creating it on first use. Directories belonging to instances
+that are no longer running are pruned at the same time, so a concurrently
+running instance never loses a file its browser may still be reading.
+
+Returns: (transfer none) the directory, or NULL when it cannot be prepared.
+*/
+static const gchar *
+mtx_viewer_preview_dir (void)
+{
+    static gchar *session_dir = NULL;
+
+    if (session_dir != NULL)
+    {
+        return session_dir;
+    }
+
+    g_autofree gchar *root_name =
+    g_strdup_printf (PROGNAME "-%lu", (gulong) getuid ());
+    g_autofree gchar *root =
+    g_build_filename (g_get_tmp_dir (), root_name, NULL);
+    GStatBuf st;
+
+    if (g_mkdir_with_parents (root, 0700) != 0
+        || g_lstat (root, &st) != 0
+        || !S_ISDIR (st.st_mode)
+        || st.st_uid != getuid ())
+    {
+        return NULL;
+    }
+    mtx_viewer_prune_dead_preview_sessions (root);
+
+    g_autofree gchar *session_name =
+    g_strdup_printf ("%lu", (gulong) getpid ());
+    gchar *dir = g_build_filename (root, session_name, NULL);
+
+    if (g_mkdir_with_parents (dir, 0700) != 0)
+    {
+        g_free (dir);
+        return NULL;
+    }
+    session_dir = dir;
+    return session_dir;
+}
