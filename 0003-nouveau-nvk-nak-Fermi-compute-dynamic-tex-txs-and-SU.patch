+impl SM20Op for OpSuLd {
+    fn legalize(&mut self, b: &mut LegalizeBuilder) {
+        use RegFile::GPR;
+        b.copy_alu_src_if_not_reg(&mut self.coord, GPR, SrcType::GPR);
+    }
+
+    fn encode(&self, e: &mut SM20Encoder<'_>) {
+        assert!(e.sm.sm() < 30);
+        let slot = self.su_slot as u32;
+        assert!(slot < 8);
+
+        e.set_opcode(SM20Unit::Mem, 0x35);
+        let mem_type = match self.image_access {
+            ImageAccess::Binary(mt) => mt,
+            ImageAccess::Formatted(mask) => match mask.to_bits() {
+                0x1 => MemType::B32,
+                0x3 => MemType::B64,
+                0xf => MemType::B128,
+                _ => MemType::B32,
+            },
+        };
+        e.set_mem_type(5..8, mem_type);
+        e.set_ld_cache_op(8..10, LdCacheOp::CacheAll);
+        e.set_dst(14..20, &self.dst);
+        e.set_reg_src(20..26, &self.coord);
+        e.set_field(26..32, slot);
+        let dim_bits: u8 = match self.image_dim {
+            ImageDim::_1D | ImageDim::_1DBuffer => 0,
+            ImageDim::_2D => 1,
+            ImageDim::_3D => 2,
+            ImageDim::_1DArray | ImageDim::_2DArray => 3,
+        };
+        e.set_field(44..46, dim_bits);
+        e.set_bit(46, true);
+        e.set_field(47..49, 0_u8);
+    }
+}
+
+impl SM20Op for OpSuSt {
+    fn legalize(&mut self, b: &mut LegalizeBuilder) {
+        use RegFile::GPR;
+        b.copy_alu_src_if_not_reg(&mut self.coord, GPR, SrcType::GPR);
+        b.copy_alu_src_if_not_reg(&mut self.data, GPR, SrcType::GPR);
+    }
+
+    fn encode(&self, e: &mut SM20Encoder<'_>) {
+        assert!(e.sm.sm() < 30);
+        let slot = self.su_slot as u32;
+        assert!(slot < 8);
+
+        e.set_opcode(SM20Unit::Mem, 0x37);
+        match self.image_access {
+            ImageAccess::Binary(mt) => {
+                e.set_mem_type(5..8, mt);
+            }
+            ImageAccess::Formatted(mask) => {
+                e.set_field(49..53, mask.to_bits());
+            }
+        }
+        e.set_st_cache_op(8..10, StCacheOp::WriteBack);
+        e.set_reg_src(14..20, &self.data);
+        e.set_reg_src(20..26, &self.coord);
+        e.set_field(26..32, slot);
+        let dim_bits: u8 = match self.image_dim {
+            ImageDim::_1D | ImageDim::_1DBuffer => 0,
+            ImageDim::_2D => 1,
+            ImageDim::_3D => 2,
+            ImageDim::_1DArray | ImageDim::_2DArray => 3,
+        };
+        e.set_field(44..46, dim_bits);
+        e.set_bit(46, true);
+        e.set_field(47..49, 0_u8);
+    }
+}
