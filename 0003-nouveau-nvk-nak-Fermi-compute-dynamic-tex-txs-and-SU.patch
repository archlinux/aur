+                             uint8_t subc)
+{
+   if (map->su_count == 0)
+      return;
+
+   struct nv_push *p = nvk_cmd_buffer_push(cmd, 7 * map->su_count);
+   for (uint32_t slot = 0; slot < map->su_count; slot++) {
