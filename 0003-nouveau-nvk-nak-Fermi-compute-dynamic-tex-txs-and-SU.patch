+static struct nvk_fermi_su_descriptor
+nvk_cmd_buffer_read_fermi_su_desc(const struct nvk_descriptor_state *desc,
+                                  uint8_t set_idx, uint32_t offset)
+{
+   struct nvk_fermi_su_descriptor su_desc = { .format = 0x14000 };
+
+   if (set_idx >= NVK_MAX_SETS)
+      return su_desc;
+
+   switch (desc->sets[set_idx].type) {
+   case NVK_DESCRIPTOR_SET_TYPE_SET: {
+      struct nvk_descriptor_set *set = desc->sets[set_idx].set;
+      if (set != NULL && set->map != NULL)
+         memcpy(&su_desc, (const uint8_t *)set->map + offset, sizeof(su_desc));
+      break;
+   }
+   case NVK_DESCRIPTOR_SET_TYPE_PUSH: {
+      struct nvk_push_descriptor_set *push = desc->sets[set_idx].push;
+      if (push != NULL)
+         memcpy(&su_desc, &push->data[offset], sizeof(su_desc));
+      break;
+   }
+   default:
+      break;
+   }
+
+   return su_desc;
+}
+
+void
