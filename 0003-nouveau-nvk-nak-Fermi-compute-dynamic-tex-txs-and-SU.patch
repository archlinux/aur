+static VkResult
+nvk_cmd_dispatch_fermi(struct nvk_cmd_buffer *cmd,
+                       struct nvk_shader *shader,
+                       const struct nvk_descriptor_state *desc,
+                       const void *root,
+                       size_t root_size,
+                       const uint32_t group_count[3])
+{
+   struct nvk_device *dev = nvk_cmd_buffer_device(cmd);
+   const struct nvk_physical_device *pdev = nvk_device_physical(dev);
+   const uint32_t min_cbuf_alignment = nvk_min_cbuf_alignment(&pdev->info);
+
+   uint64_t root_desc_addr = 0;
+   if (root_size > 0) {
+      VkResult result = nvk_cmd_buffer_upload_data(cmd, root, root_size,
+                                                   min_cbuf_alignment,
+                                                   &root_desc_addr);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (shader != NULL) {
+      nvk_device_ensure_slm(dev, shader->info.slm_size,
+                                 shader->info.crs_size);
+   }
+
+   if (group_count[0] == 0 || group_count[1] == 0 || group_count[2] == 0)
+      return VK_SUCCESS;
+
+   struct nv_push *p =
+      nvk_cmd_buffer_push(cmd, 8 * shader->cbuf_map.cbuf_count + 40);
+
+   for (uint32_t c = 0; c < shader->cbuf_map.cbuf_count; c++) {
+      const struct nvk_cbuf *cbuf = &shader->cbuf_map.cbufs[c];
+      struct nvk_buffer_address ba = { .size = 0 };
+
+      switch (cbuf->type) {
+      case NVK_CBUF_TYPE_ROOT_DESC:
+         ba.base_addr = root_desc_addr;
+         ba.size = align(root_size, min_cbuf_alignment);
+         break;
+
+      case NVK_CBUF_TYPE_SHADER_DATA:
+         ba.base_addr = shader->data_addr;
+         ba.size = shader->data_size;
+         break;
+
+      default:
+         if (!nvk_cmd_buffer_get_cbuf_addr(cmd, desc, shader, cbuf, &ba))
+            ba.size = 0;
+         break;
+      }
+
+      if (ba.size > 0) {
+         assert(ba.base_addr % min_cbuf_alignment == 0);
+         ba.size = align(ba.size, min_cbuf_alignment);
+         ba.size = MIN2(ba.size, NVK_MAX_CBUF_SIZE);
+
+         P_MTHD(p, NV90C0, SET_CONSTANT_BUFFER_SELECTOR_A);
+         P_NV90C0_SET_CONSTANT_BUFFER_SELECTOR_A(p, ba.size);
+         P_NV90C0_SET_CONSTANT_BUFFER_SELECTOR_B(p, ba.base_addr >> 32);
+         P_NV90C0_SET_CONSTANT_BUFFER_SELECTOR_C(p, ba.base_addr);
+      }
+
+      P_IMMD(p, NV90C0, BIND_CONSTANT_BUFFER, {
+         .valid = ba.size > 0,
+         .shader_slot = c,
+      });
+   }
+
+   P_MTHD(p, NV90C0, SET_CTA_PROGRAM_START);
+   P_NV90C0_SET_CTA_PROGRAM_START(p, shader->hdr_addr);
+
+   P_MTHD(p, NV90C0, SET_SHADER_LOCAL_MEMORY_LOW_SIZE);
+   P_NV90C0_SET_SHADER_LOCAL_MEMORY_LOW_SIZE(p, align(shader->info.slm_size, 0x10));
+   P_NV90C0_SET_SHADER_LOCAL_MEMORY_HIGH_SIZE(p, 0);
+   P_NV90C0_SET_SHADER_LOCAL_MEMORY_CRS_SIZE(p,
+      shader->info.crs_size ? align(shader->info.crs_size, 0x800) : 0);
+
+   P_MTHD(p, NV90C0, SET_SHADER_SHARED_MEMORY_SIZE);
+   P_NV90C0_SET_SHADER_SHARED_MEMORY_SIZE(p,
+      align(shader->info.cs.smem_size, 0x100));
+
+   const uint16_t *local_size = shader->info.cs.local_size;
+   P_MTHD(p, NV90C0, SET_CTA_THREAD_COUNT);
+   P_NV90C0_SET_CTA_THREAD_COUNT(p, local_size[0] * local_size[1] * local_size[2]);
+
+   P_MTHD(p, NV90C0, SET_CTA_BARRIER_COUNT);
+   P_NV90C0_SET_CTA_BARRIER_COUNT(p, shader->info.num_control_barriers);
+
+   P_MTHD(p, NV90C0, SET_CTA_REGISTER_COUNT);
+   P_NV90C0_SET_CTA_REGISTER_COUNT(p, shader->info.num_gprs);
+
+   P_IMMD(p, NV90C0, SET_GRID_PARAM, 1);
+   P_IMMD(p, NV90C0, SET_LAUNCH_ID, 0);
+
+   P_IMMD(p, NV90C0, INVALIDATE_SHADER_CACHES_NO_WFI, {
+      .instruction = INSTRUCTION_TRUE,
+      .global_data = GLOBAL_DATA_TRUE,
+      .uniform = UNIFORM_TRUE,
+      .constant = CONSTANT_TRUE,
+   });
+
+   P_MTHD(p, NV90C0, SET_CTA_THREAD_DIMENSION_A);
+   P_NV90C0_SET_CTA_THREAD_DIMENSION_A(p, {
+      .d0 = local_size[0],
+      .d1 = local_size[1],
+   });
+   P_NV90C0_SET_CTA_THREAD_DIMENSION_B(p, local_size[2]);
+
+   P_MTHD(p, NV90C0, SET_CTA_RASTER_SIZE_A);
+   P_NV90C0_SET_CTA_RASTER_SIZE_A(p, {
+      .width = group_count[0],
+      .height = group_count[1],
+   });
+   P_NV90C0_SET_CTA_RASTER_SIZE_B(p, group_count[2]);
+
+   P_IMMD(p, NV90C0, BEGIN_GRID, 0);
+   P_IMMD(p, NV90C0, SET_LAUNCH_SIZE, 0);
+   P_MTHD(p, NV90C0, LAUNCH);
+   P_INLINE_DATA(p, 0x1000);
+   P_IMMD(p, NV90C0, END_GRID, 0);
+   P_MTHD(p, NV90C0, WAIT_REF_COUNT);
+   P_INLINE_DATA(p, 1);
+
+   /* Restore CONSTANT_BUFFER_SELECTOR and 3D CB0 bindings */
+   if (nvk_cmd_buffer_queue_flags(cmd) & VK_QUEUE_GRAPHICS_BIT) {
+      P_1INC(p, NV9097, CALL_MME_MACRO(NVK_MME_SELECT_CB0));
+      P_INLINE_DATA(p, 0);
+      for (uint32_t g = 0; g < 5; g++) {
+         P_IMMD(p, NV9097, BIND_GROUP_CONSTANT_BUFFER(g), {
+            .valid = VALID_TRUE,
+            .shader_slot = 0,
+         });
+      }
+      P_IMMD(p, NV9097, INVALIDATE_SHADER_CACHES, {
+         .data = DATA_TRUE,
+         .constant = CONSTANT_TRUE,
+      });
+   }
+
+   return VK_SUCCESS;
+}
