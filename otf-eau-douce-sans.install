post_install() {
  echo -n "Updating font cache... "
  fc-cache -s >/dev/null
# The following two depend on xorg-mkfontscale, and probably unnecessary for Wayland
#  mkfontscale /usr/share/fonts/OTF
#  mkfontdir /usr/share/fonts/OTF
  echo "done."
}

post_upgrade() {
  post_install $1
}

post_remove() {
  post_install $1
}
