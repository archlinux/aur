post_install() {
    z13ctl-plus setup
    echo ""
    echo ">>> z13ctl-plus installed. Its daemon is disabled so it can coexist with upstream."
    echo ">>> After disabling any other Z13 daemon, enable this one with:"
    echo ">>>   systemctl --user enable --now z13ctl-plus.socket z13ctl-plus.service"
}

post_upgrade() {
    z13ctl-plus setup
    echo ""
    echo ">>> z13ctl-plus upgraded. If its daemon is enabled, reload and restart it:"
    echo ">>>   systemctl --user daemon-reload"
    echo ">>>   systemctl --user restart z13ctl-plus.service"
}
