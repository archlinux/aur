#!/bin/bash

export WINEPREFIX="$HOME"/.osaka-simulator/wine

if [ ! -d "$HOME"/.osaka-simulator ]; then
    mkdir -p "$HOME"/.osaka-simulator/wine

    wineboot -u
    winetricks -q dx8vb dmime dmsynth dmusic dsound dswave

    ln -s /usr/share/osaka-simulator/animation "$HOME"/.osaka-simulator/animation
    ln -s /usr/share/osaka-simulator/clipper "$HOME"/.osaka-simulator/clipper
    ln -s /usr/share/osaka-simulator/model "$HOME"/.osaka-simulator/model
    ln -s /usr/share/osaka-simulator/sound "$HOME"/.osaka-simulator/sound

    ln -s /usr/share/osaka-simulator/tsu_han.exe "$HOME"/.osaka-simulator/tsu_han.exe
    cp /usr/share/osaka-simulator/tsu_han.cfg "$HOME"/.osaka-simulator/tsu_han.cfg
fi

cd "$HOME"/.osaka-simulator && WINEDEBUG=-all LANG=ja_JP.utf8 wine "$HOME"/.osaka-simulator/tsu_han.exe "$@"