[Unit]
Description=Sakura Frp Client Service
# After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=idle
User=sakura-frp
Restart=on-failure
RestartSec=60s
ExecStart=/usr/bin/sakura-frpc -f %i
WorkingDirectory=/var/lib/sakura-frp

[Install]
WantedBy=multi-user.target
