 	source/ifstreambuf.cpp
@@ -142,4 +142,20 @@ if( MASTER_PROJECT )
 		PRIVATE
 		sai
 	)
-endif()
\ No newline at end of file
+
+	install(
+		TARGETS Thumbnail Decrypt Tree Document
+		DESTINATION bin/
