+++ dunelegacy/CMakeLists.txt	2026-02-19 19:26:28.199307087 +0100
@@ -340,7 +340,7 @@
     set(CPACK_PACKAGE_FILE_NAME "DuneLegacy-${PROJECT_VERSION}-Linux-x64")
     
     # Add custom target for Linux packages
-    add_custom_target(package
