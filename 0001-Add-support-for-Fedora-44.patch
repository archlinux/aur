From: Zygmunt Krynicki <me@zygoon.pl>
Date: Thu, 30 Apr 2026 18:22:16 +0200
Subject: [PATCH] Add support for Fedora 44

Signed-off-by: Zygmunt Krynicki <me@zygoon.pl>
Signed-off-by: Maciek Borzecki <maciek.borzecki@gmail.com>
---
 .gitlab-ci.yml          |  3 +++
 NEWS                    |  4 ++++
 data/fedora.ini         | 20 ++++++++++++++++++++
 image-garden.1          |  4 ++--
 spread-demo/spread.yaml |  3 +++
 5 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index 2b1c27e0874ca1167468ab548b9db28f44d2e60a..197dcb212a7d3c59c3786d4c8c5d790acb6121e0 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -308,6 +308,7 @@ test-x86_64:
                   - fedora-cloud-41
                   - fedora-cloud-42
                   - fedora-cloud-43
+                  - fedora-cloud-44
                   - gentoo-cloud
                   - opensuse-cloud-15.4
                   - opensuse-cloud-15.5
@@ -401,6 +402,7 @@ test-aarch64:
                   - fedora-cloud-41
                   - fedora-cloud-42
                   - fedora-cloud-43
+                  - fedora-cloud-44
                   - opensuse-cloud-15.4
                   - opensuse-cloud-15.5
                   - opensuse-cloud-15.6
@@ -533,6 +535,7 @@ test-s390x-on-x86_64:
                   - ubuntu-cloud-26.04
                   - fedora-cloud-42
                   - fedora-cloud-43
+                  - fedora-cloud-44
 
 test-ppc64el-on-x86_64:
     stage: test-tier-3
diff --git a/NEWS b/NEWS
index 77477289da8e16aa2d9fa7021702d051bb8fa163..7d0455153db6addd733e072815667226f063a202 100644
--- a/NEWS
+++ b/NEWS
@@ -1,3 +1,7 @@
+Changes in the next version:
+
+* Fedora 44 is now supported.
+
 Changes in 0.5.0:
 
 * Improve image preparation log readability with three-level formatting.
diff --git a/data/fedora.ini b/data/fedora.ini
index 4d61bb6cf55159303f5b9657bba28a7728165a32..0145689ead290ef07290c7a44fee6356231cf2fd 100644
--- a/data/fedora.ini
+++ b/data/fedora.ini
@@ -109,3 +109,23 @@ URL=https://download.fedoraproject.org/pub/fedora-secondary/releases/43/Cloud/s3
 SHA256SUMS=https://download.fedoraproject.org/pub/fedora-secondary/releases/43/Cloud/s390x/images/Fedora-Cloud-43-1.6-s390x-CHECKSUM
 Arch=s390x
 Release=43
+
+[fedora-cloud-44.x86_64]
+URL=http://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2
+SHA256SUMS=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-44-1.7-x86_64-CHECKSUM
+Arch=x86_64
+Boot=efi
+Release=44
+
+[fedora-cloud-44.aarch64]
+URL=http://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/aarch64/images/Fedora-Cloud-Base-Generic-44-1.7.aarch64.qcow2
+SHA256SUMS=https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/aarch64/images/Fedora-Cloud-44-1.7-aarch64-CHECKSUM
+Arch=aarch64
+Boot=efi
+Release=44
+
+[fedora-cloud-44.s390x]
+URL=https://download.fedoraproject.org/pub/fedora-secondary/releases/44/Cloud/s390x/images/Fedora-Cloud-Base-Generic-44-1.7.s390x.qcow2
+SHA256SUMS=https://download.fedoraproject.org/pub/fedora-secondary/releases/44/Cloud/s390x/images/Fedora-Cloud-44-1.7-s390x-CHECKSUM
+Arch=s390x
+Release=44
diff --git a/image-garden.1 b/image-garden.1
index cdee55ead9d55a1b7973dbdb53e18d5430970d44..5a0639a3062cd02c6980c644451670a0b0be20ba 100644
--- a/image-garden.1
+++ b/image-garden.1
@@ -214,11 +214,11 @@ CPU architecture.
 CentOS cloud images (usually CentOS stream).
 .It debian-cloud-{10,11,12,13,sid}
 Debian cloud images.
-.It fedora-cloud-{38,39,40,41,42,43}
+.It fedora-cloud-{38,39,40,41,42,43,44}
 Fedora cloud images. Fedora 42, only, is also supported on the
 .Em riscv64
 CPU architecture.
-Fedora 42 and 43 are also supported on the
+Fedora 42, 43 and 44 are also supported on the
 .Em s390x
 CPU architecture.
 .It opensuse-cloud-{15.4,15.5,15.16,tumbleweed}
diff --git a/spread-demo/spread.yaml b/spread-demo/spread.yaml
index 1a924fd3fbadd56df57669a11749e3a69331ace6..056f03c62c08d82c2c7fadb2eb17651ab8017c9e 100644
--- a/spread-demo/spread.yaml
+++ b/spread-demo/spread.yaml
@@ -198,6 +198,9 @@ backends:
             - fedora-cloud-43:
                   username: fedora
                   password: fedora
+            - fedora-cloud-44:
+                  username: fedora
+                  password: fedora
             # Gentoo
             - gentoo-cloud:
                   username: gentoo
-- 
