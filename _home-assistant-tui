#compdef home-assistant-tui
# Generated by home-assistant-tui completions zsh.

local -a _home_assistant_tui_commands
_home_assistant_tui_commands=(
  'dashboard:Overview of your Home Assistant instance'
  'entities:Browse and search all entities'
  'todo:View and manage todo lists'
  'settings:Configure connection and preferences'
  'test-connection:Diagnose Home Assistant connectivity'
  'test-view:Open the TUI sandbox view'
  'completions:Print shell completions'
)

local -a _home_assistant_tui_todo_options
_home_assistant_tui_todo_options=(
  '--bar-json:Print todo status-bar JSON'
  '--count:Print todo item count'
  '--all:Include completed todo items'
)

local -a _home_assistant_tui_settings_values
_home_assistant_tui_settings_values=(
  'connection:Change Home Assistant URL or access token'
)

local -a _home_assistant_tui_completions_values
_home_assistant_tui_completions_values=(
  'bash:Bash'
  'fish:Fish'
  'zsh:Zsh'
)

if (( CURRENT > 2 )) && [[ ${words[2]} == todo && ${words[CURRENT]} == --* ]]; then
  _describe -t options 'todo option' _home_assistant_tui_todo_options
  return
fi

if (( CURRENT > 2 )) && [[ ${words[CURRENT]} != -* ]]; then
  case ${words[2]} in
    settings)
      if (( CURRENT == 3 )); then
        _describe -t commands 'settings command' _home_assistant_tui_settings_values
        return
      fi
      ;;
    completions)
      if (( CURRENT == 3 )); then
        _describe -t commands 'value' _home_assistant_tui_completions_values
        return
      fi
      ;;
  esac
fi

local state
_arguments -C -S \
  '(-h --help)-h[Show help message]' \
  '(-h --help)--help[Show help message]' \
  '1:home-assistant-tui command:->command' && return

case $state in
  command)
    _describe -t commands 'home-assistant-tui command' _home_assistant_tui_commands
    ;;
esac
