# PDS Gatekeeper Environment Configuration
# See https://tangled.org/baileytownsend.dev/pds-gatekeeper for full documentation

# PDS_ENV_LOCATION - Location of the PDS environment file
# Default: /etc/pds.env (from atproto-pds package)
PDS_ENV_LOCATION=/etc/pds.env

# PDS_DATA_DIRECTORY - Root directory of the PDS
# Default: /pds
# PDS_DATA_DIRECTORY=/pds

# PDS_BASE_URL - Base URL of the PDS
# Upstream default: http://localhost:3000
# Set to http://localhost:2583 for atproto-pds package
PDS_BASE_URL=http://localhost:2583

# GATEKEEPER_HOST - Host for pds gatekeeper
# Default: 127.0.0.1
# GATEKEEPER_HOST=127.0.0.1

# GATEKEEPER_PORT - Port for pds gatekeeper
# Default: 8080
# GATEKEEPER_PORT=8080

# GATEKEEPER_TWO_FACTOR_EMAIL_SUBJECT - Subject of 2FA email
# Default: Sign in to Bluesky
# GATEKEEPER_TWO_FACTOR_EMAIL_SUBJECT="Sign in to Bluesky"

# GATEKEEPER_EMAIL_TEMPLATES_DIRECTORY - Custom email templates folder
# GATEKEEPER_EMAIL_TEMPLATES_DIRECTORY=/usr/share/pds-gatekeeper/email_templates

# GATEKEEPER_CREATE_ACCOUNT_PER_SECOND - Rate limit interval
# GATEKEEPER_CREATE_ACCOUNT_PER_SECOND=60

# GATEKEEPER_CREATE_ACCOUNT_BURST - Rate limit burst size
# GATEKEEPER_CREATE_ACCOUNT_BURST=5

# GATEKEEPER_ALLOW_ONLY_MIGRATIONS - Only allow account creation via migrations
# Default: false
# GATEKEEPER_ALLOW_ONLY_MIGRATIONS=false

# Captcha settings (requires hCaptcha account from https://www.hcaptcha.com/)
# GATEKEEPER_CREATE_ACCOUNT_CAPTCHA=false
# PDS_HCAPTCHA_SITE_KEY=
# PDS_HCAPTCHA_SECRET_KEY=
# GATEKEEPER_JWE_KEY=
# GATEKEEPER_DEFAULT_CAPTCHA_REDIRECT=https://bsky.app
# GATEKEEPER_CAPTCHA_SUCCESS_REDIRECTS=https://bsky.app,https://pdsmoover.com,https://blacksky.community,https://tektite.cc
