#!/usr/bin/env bash
# Runs from the libalpm hook after the tailscale package is installed or
# upgraded; see libalpm-hook-tailscale (installed as
# /usr/share/libalpm/hooks/mkinitcpio-tailscale.hook) for why.
#
# Exits quietly unless the tailscale mkinitcpio hook is both enabled and
# configured: rebuilding an image that does not carry tailscaled would be
# wasted work, and rebuilding one whose configuration is missing would fail
# the whole transaction's hook run for a package that works fine without us.
#
# When a kernel upgrade sits in the same transaction, mkinitcpio's own hook
# rebuilds as well and this one makes the rebuild happen twice. Detecting that
# from here is not worth the fragility; the second run is merely slow.
set -uo pipefail

# Next to this script when run from a checkout, installed under /usr/lib
# otherwise.
lib=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/lib-presets.sh
[[ -r $lib ]] || lib=/usr/lib/mkinitcpio-tailscale/presets.sh
# shellcheck source=lib-presets.sh
. "$lib"

hook_enabled() {
	# Every configuration `mkinitcpio -P` builds from, not just the default
	# file: a preset may name its own (ALL_config=, <name>_config=), and one
	# that lists tailscale needs the rebuild however the others look. The
	# library reads each one the way mkinitcpio does, by sourcing it, drop-ins
	# included where mkinitcpio includes them.
	local cfg
	while IFS= read -r cfg; do
		ts_uses_hook "$cfg" && return 0
	done < <(ts_configs)
	return 1
}

hook_enabled || exit 0

# The same two files the install hook refuses to build without; checking
# fewer would let a half-configured setup fail the rebuild after all.
if ! [[ -s /etc/initcpio/tailscale/tailscaled.state && -s /etc/initcpio/tailscale/default.env ]]; then
	echo "tailscale is in HOOKS= but /etc/initcpio/tailscale is not set up; not rebuilding the initramfs"
	echo "run setup-initcpio-tailscale, then mkinitcpio -P"
	exit 0
fi

exec mkinitcpio -P
