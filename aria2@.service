[Unit]
Description=Aria2c Daemon
After=network-online.target
Wants=network-online.target
ConditionPathExists=%E/aria2cd/%i.conf

[Service]
Type=simple
# Update tracker
ExecStartPre=-+/usr/lib/aria2cd/update-tracker %E/aria2cd/%i.conf
# Arguments here will override config file.
ExecStart=/usr/bin/aria2c --conf-path=%E/aria2cd/%i.conf --daemon=false --enable-rpc=true
# Paths
ProtectProc=noaccess
# User/Group Identity
User=aria2cd
DynamicUser=true
# Capabilities
## Listen ports under 1024
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Security
NoNewPrivileges=yes
# Sandboxing
ProtectSystem=strict
ProtectHome=yes
RuntimeDirectory=aria2cd
StateDirectory=aria2cd
LogsDirectory=aria2cd
CacheDirectory=aria2cd
ConfigurationDirectory=aria2cd
PrivateTmp=yes
PrivateDevices=yes
MemoryKSM=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
# System Call Filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
## update-tracker: sed
SystemCallFilter=@chown

[Install]
WantedBy=default.target
