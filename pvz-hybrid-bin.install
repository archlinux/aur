# shellcheck disable=SC2148
post_install() {
    echo "============================================"
    echo "  植物大战僵尸杂交版 安装完成！"
    echo "  启动命令: pvz-hybrid"
    echo "  存档位置: ~/.local/share/godot/app_userdata/植物大战僵尸杂交版/"
    echo "============================================"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "卸载将不会删除存档文件，请手动删除:"
    echo "  ~/.local/share/godot/app_userdata/植物大战僵尸杂交版/"
}
