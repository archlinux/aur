post_install() {
    echo -e "\n\e[1;34m==>\e[0m \e[1;37m安装后提示 (Post-install Tip):\e[0m"
    echo "如果你不希望在卸载 pvz-hybrid-bin 时，godot 被作为孤儿包(orphan)连带卸载，"
    echo "建议在终端执行以下命令，将 godot 标记为单独指定安装："
    echo -e "\e[1;33m    sudo pacman -D --asexplicit godot\e[0m\n"
}

post_upgrade() {
    post_install
}
