[Unit]
Description=Minecraft Legacy Edition Dedicated Server
After=network.target

[Service]
User=root
WorkingDirectory=/srv/lcemp
ExecStart=/usr/bin/screen -DmS lcemp-server /srv/lcemp/MinecraftDedicatedServer-Linux
ExecStop=/usr/bin/screen -S lcemp-server -X quit || true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target