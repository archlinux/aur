+/* --prefill-interleave epoch: the walk's class predicate, one spelling. A request whose prompt
+ * is fully placed and whose output (a preempted one's replay included) is within one token of
+ * its committed length is decoding; everything else is still prefilling. */
+bool Scheduler::req_class_prefill(const SchedReq& s) {
+    const Request& r = *s.req;
+    return (r.n_computed < (int64_t)r.prompt.size()) || (r.n_computed + 1 < s.seq_len());
+}
+
+/* A member leaves the cohort: its phase completed, it closed (a cancel or error drains it -- no
+ * guarantee is owed a request that will not finish), or it was preempted [OD1] -- which revokes
+ * membership rather than draining a guarantee, though the drain counter moves either way: the
+ * epoch must not wait for a request it no longer governs. The last departure closes the epoch;
+ * formation runs on the next planning pass. mu_ held. */
+void Scheduler::epoch_drop_member(int32_t slot, bool preempted) {
+    if (!epoch_member_at(slot)) return;
+    epoch_member_[(size_t)slot] = false;
+    --epoch_drain_;
+    if (preempted) ++m_.cohort_preempt_removals;
+    if (epoch_drain_ <= 0) {
+        epoch_live_ = false;
+        m_.epoch_len_steps += step_ - epoch_start_step_;
+    }
+}
+
+/* Formation: the leader is the oldest active request (head_slot_locked's rule), the epoch class
+ * is its current class -- a waiting leader enters as a prefill, the head_class_prefill rule --
+ * and the cohort is every request of that class present in running_ or waiting_: queued
+ * same-class members are guaranteed admitted-when-room and completed [OD2]. A running request of
+ * the other class is frozen by the flip: a mid-arrival cut (E3). Formation happens only when no
+ * epoch is live -- epoch end or idle->busy -- never mid-epoch. mu_ held. */
+void Scheduler::epoch_form_locked() {
+    const int32_t lead = head_slot_locked();
+    if (lead < 0) return;                       /* nothing to govern */
+    bool waiting_lead = false;
+    for (int32_t slot : waiting_)
+        if (slot == lead) { waiting_lead = true; break; }
+    epoch_class_prefill_ = waiting_lead || req_class_prefill(*reqs_[(size_t)lead]);
+    epoch_member_.assign(reqs_.size(), false);
+    epoch_drain_ = 0;
+    for (int32_t slot : running_) {
+        const SchedReq& s = *reqs_[(size_t)slot];
+        if (!s.req || !s.running) continue;
+        if (req_class_prefill(s) == epoch_class_prefill_) {
+            epoch_member_[(size_t)slot] = true;
+            ++epoch_drain_;
+        } else {
+            ++m_.midarrival_cuts;               /* frozen by the class flip at the boundary */
+        }
+    }
+    for (int32_t slot : waiting_) {
+        const SchedReq& s = *reqs_[(size_t)slot];
+        if (!s.req) continue;
+        /* A waiting request enters as a prefill whatever its counters read (the head rule). */
+        if (epoch_class_prefill_) {
+            epoch_member_[(size_t)slot] = true;
+            ++epoch_drain_;
+        }
+    }
+    epoch_live_ = true;
+    epoch_start_step_ = step_;
+    ++m_.epochs;
+}
