From bdadb409a9bd684d1816b8ca736b76e849d1c80b Mon Sep 17 00:00:00 2001
From: oweissbarth <mail@oweissbarth.de>
Date: Wed, 8 Oct 2025 20:15:44 +0200
Subject: [PATCH] only include custom gladTargets when not using system glad

---
 feather-tkConfig.cmake.in | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/feather-tkConfig.cmake.in b/feather-tkConfig.cmake.in
index 2729036..3250bb1 100644
--- a/feather-tkConfig.cmake.in
+++ b/feather-tkConfig.cmake.in
@@ -39,11 +39,11 @@ include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-resTargets.cmake")
 include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-resourceTargets.cmake")
 include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-coreTargets.cmake")
 if(@feather_tk_UI_LIB@)
-    include("${CMAKE_CURRENT_LIST_DIR}/gladTargets.cmake")
     if(@feather_tk_API@ STREQUAL "GL_4_1" OR
         @feather_tk_API@ STREQUAL "GL_4_1_Debug" OR
         @feather_tk_API@ STREQUAL "GLES_2")
-        include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-glTargets.cmake")
+       include("${CMAKE_CURRENT_LIST_DIR}/gladTargets.cmake")
+       include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-glTargets.cmake")
     endif()
     include("${CMAKE_CURRENT_LIST_DIR}/feather-tk-uiTargets.cmake")
 endif()
-- 
2.51.0

