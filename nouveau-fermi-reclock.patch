+ * Execution is by the custom Falcon program (tmp/memx_exec_custom.fuc,
+ * see RECLOCKING_NOTES.md §8.1), NOT the PMU firmware (its message path
+ * never answers) and NOT direct host MMIO (FB_PAUSE faults from the host
+ * and engines stay live).  The builder below emits a custom TLV script
+ * (op + fixed args, opcodes 1 ENTER, 2 LEAVE, 3 WR32, 4 WAIT, 5 DELAY,
+ * 6 VBLANK) into DMEM scratch; the Falcon program walks it with full
+ * MMIO privilege.  DELAY carries host-precomputed loop iters
+ * (~ticks/us, SAFE direction: exact or longer, never shorter); WAIT
+ * carries a generous iteration bound (early exit on match, host 2s
+ * backstop covers pathology); VBLANK is a fixed spin (engines are
+ * paused, so sync is cosmetic).
+ *****************************************************************************/
+
+/* Custom-executor image (assembled from tmp/memx_exec_custom.fuc).
+ * Signals completion via PDAEMON.SCRATCH0 (0x10a080). */
+#include "fexec_code.inc"
+
+
+static void fexec_upload(struct nvkm_device *device, const u32 *code, int nwords)
+{
+	int i, npages = (nwords + 0x3f) >> 6;
+	int total_words = npages * 0x40;
+
+	/* Falcon v3+ IMEM pages are 256 bytes (64 words). The hardware
+	 * VTLB marks each page BUSY on first word write, and only marks it
+	 * USABLE when the last word (offset 0xfc) of the 64-word page is
+	 * written. If an unpadded code image is uploaded, the trailing
+	 * page stays BUSY, and the Falcon CPU instruction fetch freezes.
+	 * Pad every upload to complete 64-word pages. */
+	nvkm_wr32(device, 0x10a180, 0x01000000);
+	for (i = 0; i < total_words; i++) {
+		if ((i & 0x3f) == 0)
+			nvkm_wr32(device, 0x10a188, i >> 6);
+		nvkm_wr32(device, 0x10a184, (i < nwords) ? code[i] : 0);
+	}
+	nvkm_wr32(device, 0x10a180, 0x00000000);
+	(void)nvkm_rd32(device, 0x10a080);
+}
+
+static bool fexec_resident_running = false;
+
+static int
+gf100_ram_exec_custom(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	unsigned long deadline;
+	u32 done, cur, pmc, cmd;
+
+	cmd = (freq == 900000) ? 1 : 2;
+
+	/* Check if resident executor is already running and ready in Falcon IMEM */
+	if (fexec_resident_running) {
+		u32 s0 = nvkm_rd32(device, 0x10a080);
+
+		/* Across S3 suspend/resume or Falcon reset, IMEM is cleared and S0 drops to 0x0.
+		 * If our resident handshake signature (0xE1EC0001) is missing, Falcon is uninitialized.
+		 * Fall back immediately to the cold path to reload the resident executor. */
+		if (s0 != 0xE1EC0001) {
+			nvkm_info(subdev, "DDR3: Falcon lost resident executor across suspend/reset (S0=%08x, PC=%08x), reloading via cold path\n",
+				  s0, nvkm_rd32(device, 0x10aff0));
+			fexec_resident_running = false;
+		}
+	}
+
+	if (fexec_resident_running) {
+		u32 uc_ctrl = nvkm_rd32(device, 0x10a100);
+		u32 s0 = nvkm_rd32(device, 0x10a080);
+		u32 s1 = nvkm_rd32(device, 0x10a084);
+		u32 pc = nvkm_rd32(device, 0x10aff0);
+		u32 st = nvkm_rd32(device, 0x10a128);
+
+		nvkm_info(subdev, "DDR3: resident fast-path request: cmd=%u (target %u kHz) [UC=%08x S0=%08x S1=%08x PC=%08x ST=%08x]\n",
+			  cmd, freq, uc_ctrl, s0, s1, pc, st);
+
+		/* If Falcon stopped, restart it directly WITHOUT touching PMC 0x000200 */
+		if (uc_ctrl & 0x10) {
+			nvkm_warn(subdev, "DDR3: Falcon stopped (UC=%08x, PC=%08x), restarting directly without PMC reset\n",
+				  uc_ctrl, pc);
+			nvkm_wr32(device, 0x10a080, 0x00000000);
+			nvkm_wr32(device, 0x10a084, cmd);
+			nvkm_wr32(device, 0x10a10c, 0x00000000);
+			nvkm_wr32(device, 0x10a104, 0x00000000);
+			nvkm_wr32(device, 0x10a100, 0x00000002);
+		} else {
+			/* Falcon is running resident: write command to SCRATCH3 */
+			nvkm_wr32(device, 0x10a080, 0x00000000);  /* clear DONE */
+			nvkm_wr32(device, 0x10a084, cmd);         /* send cmd: 1=900, 2=324 */
+		}
+		(void)nvkm_rd32(device, 0x10a080);
+		(void)nvkm_rd32(device, 0x10a084);
+
+		/* Poll DONE (2s backstop) */
+		deadline = jiffies + msecs_to_jiffies(2000);
+		do {
+			done = nvkm_rd32(device, 0x10a080);
+			if (done)
+				break;
+			usleep_range(500, 1000);
+		} while (time_before(jiffies, deadline));
+
+		if (done == 0xE1EC0001) {
+			/* Assert hardware PHY timing commit latch from host */
+			nvkm_wr32(device, 0x001548, 0x00000101);
+			nvkm_wr32(device, 0x001548, 0x80000101);
+
+			deadline = jiffies + msecs_to_jiffies(100);
+			do {
+				cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+				if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
+					break;
+				usleep_range(500, 1000);
+			} while (time_before(jiffies, deadline));
+
+			u32 f0 = nvkm_rd32(device, 0x1373f0);
+			u32 f_mpll = nvkm_clk_read(device->clk, nv_clk_src_mpll);
+			u32 f_mdiv = nvkm_clk_read(device->clk, nv_clk_src_mdiv);
+			nvkm_info(subdev, "DDR3: resident fast-path DONE: cmd=%u, 0x1373f0=%08x, mpll=%u kHz, mdiv=%u kHz, mem=%u kHz (target %u)\n",
+				  cmd, f0, f_mpll, f_mdiv, cur, freq);
+			if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
+				return 0;
+			nvkm_error(subdev, "DDR3: resident fast-path completed, but readback %u kHz != target %u kHz!\n",
+				  cur, freq);
+			return -EIO;
+		}
+
+		nvkm_error(subdev, "DDR3: resident executor fast-path %s (cmd=%u SCRATCH2=%08x SCRATCH3=%08x UC=%08x PC=%08x ST=%08x)\n",
+			   done ? "error" : "timeout", cmd, done,
+			   nvkm_rd32(device, 0x10a084),
+			   nvkm_rd32(device, 0x10a100),
+			   nvkm_rd32(device, 0x10aff0),
+			   nvkm_rd32(device, 0x10a128));
+		fexec_resident_running = false;
+		return -ETIMEDOUT;
+	}
+
+	/* Cold path: First transition after boot - reset PDAEMON and start resident executor */
+	/* Safety check: Never reset PDAEMON via 0x000200 if memory clock > 400 MHz */
+	cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+	if (cur > 400000) {
+		nvkm_error(subdev, "DDR3: refusing cold-path PDAEMON reset while memory clock is %u kHz!\n", cur);
+		return -EBUSY;
+	}
+
+	/* Reset PDAEMON */
+	pmc = nvkm_rd32(device, 0x000200);
+	nvkm_wr32(device, 0x000200, pmc & ~0x00002000);
+	nvkm_rd32(device, 0x000200);
+	nvkm_wr32(device, 0x000200, pmc | 0x00002000);
+	nvkm_rd32(device, 0x000200);
+
+	/* Wait for crypto reset scrubber */
+	nvkm_msec(device, 2000,
+		if (!(nvkm_rd32(device, 0x10a180) & 0x80000000))
+			break;
+	);
+	usleep_range(2000, 3000);
+
+	/* Re-unlock PDAEMON */
+	nvkm_mask(device, 0x10a048, 0x00000001, 0x00000001);
+	nvkm_mask(device, 0x10a090, 0x00010000, 0x00010000);
+	nvkm_wr32(device, 0x10a004, 0x00000008);
+	nvkm_wr32(device, 0x10a600, 0x00000000);
+	nvkm_wr32(device, 0x10a604, 0x00000000);
+	nvkm_wr32(device, 0x10a608, 0x00000004);
+	nvkm_wr32(device, 0x10a60c, 0x00000005);
+	nvkm_wr32(device, 0x10a610, 0x00000006);
+
+	/* Wait for PDAEMON I/O to open */
+	deadline = jiffies + msecs_to_jiffies(1000);
+	while (time_before(jiffies, deadline)) {
+		nvkm_wr32(device, 0x10a080, 0x0000000a);
+		if (nvkm_rd32(device, 0x10a080) == 0x0000000a)
+			break;
+		usleep_range(1000, 2000);
+	}
+	nvkm_wr32(device, 0x10a080, 0x00000000);
+
+	nvkm_info(subdev, "DDR3: PDAEMON reset+re-unlock for native executor\n");
+
+	/* Clear and disable Falcon interrupts */
+	nvkm_wr32(device, 0x10a014, 0xffffffff);
+	nvkm_wr32(device, 0x10a004, 0xffffffff);
+
+	/* Upload program to IMEM */
+	fexec_upload(device, fexec_code, ARRAY_SIZE(fexec_code));
+	nvkm_wr32(device, 0x10a080, 0x00000000);  /* clear DONE */
+	nvkm_wr32(device, 0x10a084, cmd);         /* send cmd: 1=900MHz, 2=324MHz */
+	(void)nvkm_rd32(device, 0x10a080);
+	(void)nvkm_rd32(device, 0x10a084);
+
+	nvkm_info(subdev, "DDR3: native executor: cmd=%u (target %u kHz), starting (UC=%08x)\n",
+		  cmd, freq, nvkm_rd32(device, 0x10a100));
+
+	/* ENTRY=0, START */
+	nvkm_wr32(device, 0x10a10c, 0x00000000);
+	nvkm_wr32(device, 0x10a104, 0x00000000);
+	nvkm_wr32(device, 0x10a100, 0x00000002);
+
+	/* Brief delay to allow Falcon to begin execution */
+	usleep_range(1000, 2000);
+
+	/* Poll DONE (2s backstop). */
+	deadline = jiffies + msecs_to_jiffies(2000);
+	do {
+		done = nvkm_rd32(device, 0x10a080);
+		if (done)
+			break;
+		usleep_range(1000, 5000);
+	} while (time_before(jiffies, deadline));
+
+	if (done == 0xE1EC0001) {
+		fexec_resident_running = true;
+
+		/* Assert hardware PHY timing commit latch from host */
+		nvkm_wr32(device, 0x001548, 0x00000101);
+		nvkm_wr32(device, 0x001548, 0x80000101);
+
+		deadline = jiffies + msecs_to_jiffies(100);
+		do {
+			cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+			if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
+				break;
+			usleep_range(500, 1000);
+		} while (time_before(jiffies, deadline));
+
+		u32 f0 = nvkm_rd32(device, 0x1373f0);
+		u32 f_mpll = nvkm_clk_read(device->clk, nv_clk_src_mpll);
+		u32 f_mdiv = nvkm_clk_read(device->clk, nv_clk_src_mdiv);
+		nvkm_info(subdev, "DDR3: native resident executor started DONE: cmd=%u, 0x1373f0=%08x, mpll=%u kHz, mdiv=%u kHz, mem=%u kHz (target %u)\n",
+			  cmd, f0, f_mpll, f_mdiv, cur, freq);
+		if (cur && abs((int)cur - (int)freq) < (int)(freq / 20))
+			return 0;
+		nvkm_error(subdev, "DDR3: executor completed, but readback %u kHz does NOT match target %u kHz!\n",
+			  cur, freq);
+		return -EIO;
+	}
+
+	nvkm_error(subdev, "DDR3: native executor %s (cmd=%u SCRATCH2=%08x SCRATCH3=%08x UC=%08x PC=%08x STATUS=%08x)\n",
+		   done ? "error" : "timeout", cmd, done,
+		   nvkm_rd32(device, 0x10a084),
+		   nvkm_rd32(device, 0x10a100),
+		   nvkm_rd32(device, 0x10aff0),
+		   nvkm_rd32(device, 0x10a128));
+	return -ETIMEDOUT;
+}
+
+static int
+gf100_ram_calc_ddr3(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	struct nvkm_device *device = subdev->device;
+	u32 cur = nvkm_clk_read(device->clk, nv_clk_src_mem);
+
+	/* State 03 requests 135 MHz in VBIOS: map to 324 MHz safe step-down */
+	if (freq == 135000)
+		freq = 324000;
+
+	if (freq != 324000 && freq != 900000) {
+		nvkm_error(subdev, "DDR3: unsupported memory clock %u kHz\n", freq);
+		return -EINVAL;
+	}
+
+	/* Already there (within 1%): do NOT retime DRAM for nothing. */
+	if (cur && abs((int)cur - (int)freq) < (int)(freq / 100)) {
+		nvkm_debug(subdev, "DDR3: memory already at %u kHz\n", cur);
+		return 0;
+	}
+
+	nvkm_info(subdev, "DDR3: reclocking memory %u -> %u kHz (custom Falcon executor)\n",
+		  cur, freq);
+
+
+
+	/* No ram_init: the custom executor needs no MEMX struct, no INFO
+	 * query and no PMU firmware running.  fuc stays untouched (fb
+	 * NULL), so prog() below safely no-ops via its fb guard. */
+	return gf100_ram_exec_custom(ram, freq);
+}
+
 int
 gf100_ram_calc(struct nvkm_ram *base, u32 freq)
 {
@@ -143,6 +437,9 @@ gf100_ram_calc(struct nvkm_ram *base, u3
 	int N1, M1, P;
 	int ret;
 
+	if (ram->base.type == NVKM_RAM_TYPE_DDR3)
+		return gf100_ram_calc_ddr3(ram, freq);
+
 	/* lookup memory config data relevant to the target frequency */
 	rammap.data = nvbios_rammapEm(bios, freq / 1000, &ver, &rammap.size,
 				      &cnt, &ramcfg.size, &cfg);
@@ -408,6 +705,22 @@ gf100_ram_prog(struct nvkm_ram *base)
 {
 	struct gf100_ram *ram = gf100_ram(base);
 	struct nvkm_device *device = ram->base.fb->subdev.device;
+
+	if (ram->base.type == NVKM_RAM_TYPE_DDR3) {
+		/* Custom Falcon executor already ran synchronously inside
+		 * calc (fuc never inited, fb NULL); nothing left to do. */
+		return 0;
+	}
+
+	if (ram->fuc.base.direct_exec) {
+		/* Direct MMIO mode: registers were written during _calc().
+		 * ram_exec() just releases state (and IRQs on error paths). */
+		ram_exec(&ram->fuc, false);
+		nvkm_debug(&ram->base.fb->subdev,
+			   "direct MMIO memory reclock completed\n");
+		return 0;
+	}
+
 	ram_exec(&ram->fuc, nvkm_boolopt(device->cfgopt, "NvMemExec", true));
 	return 0;
 }
@@ -438,6 +751,9 @@ gf100_ram_init(struct nvkm_ram *base)
 	struct nvkm_device *device = ram->base.fb->subdev.device;
 	int i;
 
+	/* Reset resident executor state across subdev reinit/resume */
+	fexec_resident_running = false;
+
 	switch (ram->base.type) {
 	case NVKM_RAM_TYPE_GDDR5:
 		break;
@@ -650,6 +966,14 @@ gf100_ram_new_(const struct nvkm_ram_fun
 	ram->fuc.r_0x611200 = ramfuc_reg(0x611200);
 
 	ram->fuc.r_0x13d8f4 = ramfuc_reg(0x13d8f4);
+
+	/* On Fermi (NV_C0) DDR3 boards the reclock script runs on the
+	 * custom Falcon executor (see gf100_ram_calc_ddr3 / §8.1), never
+	 * through host direct MMIO (FB_PAUSE faults from the host, engines
+	 * stay live: hard hangs) nor PMU MEMX (firmware never answers).
+	 * direct_exec is therefore never enabled here anymore.
+	 */
+
 	return 0;
 }
 
