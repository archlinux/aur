+		 * VRAM.  Gate engine->FB paths like memx_func_enter does
+		 * and keep the CPU off VRAM with IRQs disabled. */
+		struct nvkm_device *device = ram->fb->subdev.device;
+
+		if (ram->irq_held)
+			return;
+		nvkm_mask(device, 0x001620, 0x00000aa2, 0x00000000);
+		nvkm_mask(device, 0x001620, 0x00000001, 0x00000000);
+		nvkm_mask(device, 0x0026f0, 0x00000001, 0x00000000);
+		local_irq_save(ram->irq_flags);
+		ram->irq_held = true;
+	} else {
+		nvkm_memx_block(ram->memx);
+	}
 }
 
 static inline void
 ramfuc_unblock(struct ramfuc *ram)
 {
-	nvkm_memx_unblock(ram->memx);
+	if (ram->direct_exec) {
+		struct nvkm_device *device = ram->fb->subdev.device;
+
+		if (!ram->irq_held)
+			return;
+		local_irq_restore(ram->irq_flags);
+		ram->irq_held = false;
+		nvkm_mask(device, 0x0026f0, 0x00000001, 0x00000001);
+		nvkm_mask(device, 0x001620, 0x00000001, 0x00000001);
+		nvkm_mask(device, 0x001620, 0x00000aa2, 0x00000aa2);
+	} else {
+		nvkm_memx_unblock(ram->memx);
+	}
 }
 
