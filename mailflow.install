post_install() {
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo " MailFlow — first-time setup"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "1. Create the database (PostgreSQL 16+) and install a Redis 7 server."
    echo "   The password must match DB_PASSWORD in /etc/mailflow/mailflow.env."
    echo "     sudo -u postgres psql -c \\"
    echo "       \"CREATE USER mailflow WITH PASSWORD 'replace-me';\""
    echo "     sudo -u postgres psql -c \\"
    echo "       \"CREATE DATABASE mailflow OWNER mailflow;\""
    echo ""
    echo "2. Fill in /etc/mailflow/mailflow.env:"
    echo "     SESSION_SECRET=\$(openssl rand -hex 32)"
    echo "     ENCRYPTION_KEY=\$(openssl rand -hex 32)"
    echo "     DB_PASSWORD=<the role password from step 1>"
    echo "     APP_URL=https://mail.example.com"
    echo "   APP_URL is the origin the browser uses, including the scheme and"
    echo "   port. WebSocket connections are rejected when it does not match."
    echo "   ENCRYPTION_KEY encrypts mailbox passwords. Do not change it later."
    echo ""
    echo "3. Publish the site. The sample listens on port 80:"
    echo "     /usr/share/mailflow/nginx.conf"
    echo "   Point it at your server name, then reload nginx."
    echo ""
    echo "4. Start the backend:"
    echo "     systemctl enable --now mailflow"
    echo ""
    echo "5. Open APP_URL. The first registered account is the admin."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

post_upgrade() {
    echo "MailFlow upgraded. Migrations run on the next start:"
    echo "  systemctl restart mailflow"
}
