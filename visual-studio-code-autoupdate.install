post_install() {
  cat <<'EOF'
Run code (or open Visual Studio Code from the application menu).
On first launch it prepares /opt/vscode, downloads the official editor and
enables the user update timer automatically. System authorization may be
requested once to create /opt/vscode; downloads and updates run as your user.

The timer checks at 00:00 and 12:00, with up to 15 minutes of jitter.
No manual setup commands are required. Do not run code or vscode-update as root.
EOF
}

post_upgrade() {
  printf '%s\n' 'The next code launch completes any pending first-time setup automatically.'
}

pre_remove() {
  local uid user
  if [[ -d /opt/vscode && ! -L /opt/vscode ]]; then
    uid=$(stat -c %u -- /opt/vscode) || return
    user=$(getent passwd "$uid" | cut -d: -f1)
    if [[ -n $user && $uid != 0 ]]; then
      runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        systemctl --user --no-reload disable vscode-update.timer
      if [[ -S /run/user/$uid/bus ]]; then
        runuser -u "$user" -- env \
          XDG_RUNTIME_DIR="/run/user/$uid" \
          DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
          systemctl --user stop vscode-update.timer vscode-update.service
      fi
    fi
  fi
}

post_remove() {
  rm -rf --one-file-system -- /opt/vscode
}
