post_install() {
  cat <<'EOF'
This package installs a downloader, not a pacman-managed copy of VS Code.
As the desktop user who will own /opt/vscode, run once:
  sudo install -d -m 0755 -o "$USER" -g "$(id -gn)" /opt/vscode
  systemctl --user daemon-reload
  systemctl --user start vscode-update.service
  systemctl --user enable --now vscode-update.timer

The user timer checks at 00:00 and 12:00, with up to 15 minutes of jitter.
Read /usr/share/doc/visual-studio-code-autoupdate/README.md before migrating
an existing manual installation. Do not run vscode-update as root.
EOF
}

post_upgrade() {
  printf '%s\n' 'Run systemctl --user daemon-reload in the owning user session.'
}

pre_remove() {
  local uid user
  if [[ -d /opt/vscode && ! -L /opt/vscode ]]; then
    uid=$(stat -c %u -- /opt/vscode) || return
    user=$(getent passwd "$uid" | cut -d: -f1)
    if [[ -n $user && $uid != 0 ]]; then
      runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        systemctl --user --no-reload disable vscode-update.timer
      if [[ -S /run/user/$uid/bus ]]; then
        runuser -u "$user" -- env \
          XDG_RUNTIME_DIR="/run/user/$uid" \
          DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
          systemctl --user stop vscode-update.timer vscode-update.service
      fi
    fi
  fi
}

post_remove() {
  rm -rf --one-file-system -- /opt/vscode
}
