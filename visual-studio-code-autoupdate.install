post_install() {
  systemd-sysusers /usr/lib/sysusers.d/visual-studio-code-autoupdate.conf || return
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/visual-studio-code-autoupdate.conf || return
  systemctl --no-reload enable vscode-update.timer || return
  if [[ -d /run/systemd/system ]]; then
    systemctl daemon-reload || return
    systemctl start vscode-update.timer || return
  fi
  printf '%s\n' 'VS Code and automatic updates are ready. Open Visual Studio Code from the menu or run code.'
}

pre_upgrade() {
  # Retire the per-user timer from releases before 1.0-5 while its unit still exists.
  if (( $(vercmp "$2" '1.0-5') >= 0 )); then
    return
  fi
  local uid user
  if [[ -d /opt/vscode && ! -L /opt/vscode ]]; then
    uid=$(stat -c %u -- /opt/vscode) || return
    user=$(getent passwd "$uid" | cut -d: -f1)
    if [[ -n $user && $uid != 0 ]]; then
      runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
        systemctl --user --no-reload disable vscode-update.timer
      if [[ -S /run/user/$uid/bus ]]; then
        runuser -u "$user" -- env \
          XDG_RUNTIME_DIR="/run/user/$uid" \
          DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
          systemctl --user daemon-reload
        runuser -u "$user" -- env \
          XDG_RUNTIME_DIR="/run/user/$uid" \
          DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
          systemctl --user stop vscode-update.timer vscode-update.service
      fi
    fi
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --no-reload disable vscode-update.timer
  if [[ -d /run/systemd/system ]]; then
    systemctl daemon-reload
    systemctl stop vscode-update.timer vscode-update.service
  fi
}

post_remove() {
  rm -rf --one-file-system -- /var/lib/visual-studio-code-autoupdate /opt/vscode
  rm -f -- /var/lib/systemd/timers/stamp-vscode-update.timer
  if getent passwd vscode-autoupdate >/dev/null; then
    userdel vscode-autoupdate || return
  fi
  if getent group vscode-autoupdate >/dev/null; then
    groupdel vscode-autoupdate
  fi
}
