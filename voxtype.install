# /usr/bin/voxtype is created here instead of being packaged, as voxtype-bin
# and voxtype-git do. None of the three packages owns the path, so pacman
# can switch between them in either direction (a packaged link stops a switch
# from voxtype-bin at "/usr/bin/voxtype exists in filesystem"), and upgrades
# leave alone the variant `voxtype setup gpu --enable` or `voxtype setup onnx
# --enable` picked.
#
# Up to 1.1.1 this package shipped the link as a file, so the upgrade from
# 1.1.1 removes it. pre_upgrade saves the variant it pointed at in /run, a
# root-owned tmpfs no other user can write to, and post_upgrade restores it.
_backend_state="/run/voxtype-source-upgrade"
_backend_root="/usr/lib/voxtype"

# The binary a wrapper script or link at /usr/bin/voxtype runs, if any.
_active_target() {
    if [ -L /usr/bin/voxtype ]; then
        readlink -f /usr/bin/voxtype
    elif [ -f /usr/bin/voxtype ]; then
        sed -n 's/^exec \([^ ]*\).*/\1/p' /usr/bin/voxtype | head -1
    fi
}

# Link /usr/bin/voxtype unless it already runs a binary that exists. $1 is
# the variant to restore, if any; only an executable under /usr/lib/voxtype
# is accepted, whatever the saved file says.
_link_active_binary() {
    local current target
    current=$(_active_target)
    if [ -n "$current" ] && [ -f "$current" ]; then
        return
    fi
    target=$(readlink -f -- "${1:-/nonexistent}" 2>/dev/null)
    case "$target" in
        "$_backend_root"/*) [ -f "$target" ] && [ -x "$target" ] || target="" ;;
        *) target="" ;;
    esac
    rm -f /usr/bin/voxtype
    ln -s "${target:-$_backend_root/voxtype-native}" /usr/bin/voxtype
}

_detect_gpu() {
    # Detect GPU for acceleration recommendation
    GPU_DETECTED=""
    GPU_VENDOR=""
    if [ -d /dev/dri ]; then
        if ls /dev/dri/renderD* >/dev/null 2>&1; then
            if command -v lspci >/dev/null 2>&1; then
                GPU_INFO=$(lspci 2>/dev/null | grep -i 'vga\|3d\|display' | head -1 | sed 's/.*: //')
                if [ -n "$GPU_INFO" ]; then
                    GPU_DETECTED="$GPU_INFO"
                    case "$GPU_INFO" in
                        *NVIDIA*|*GeForce*|*RTX*|*GTX*) GPU_VENDOR="nvidia" ;;
                        *AMD*|*Radeon*) GPU_VENDOR="amd" ;;
                        *Intel*) GPU_VENDOR="intel" ;;
                    esac
                fi
            fi
            if [ -z "$GPU_DETECTED" ]; then
                GPU_DETECTED="GPU detected (install pciutils for details)"
            fi
        fi
    fi

    if [ -n "$GPU_DETECTED" ]; then
        echo ""
        echo "    GPU detected: $GPU_DETECTED"
        echo ""
        echo "    For GPU acceleration of Whisper and GGUF models, install your"
        echo "    GPU's Vulkan driver (e.g. vulkan-radeon, vulkan-intel or"
        echo "    nvidia-utils) and vulkan-icd-loader, then run:"
        echo "      sudo voxtype setup gpu --enable"
        if [ "$GPU_VENDOR" = "nvidia" ] || [ "$GPU_VENDOR" = "amd" ]; then
            echo ""
            echo "    This package builds the ONNX engines for the CPU only. For"
            echo "    CUDA or MIGraphX, use voxtype-bin."
        fi
    fi
}

_print_onnx_hint() {
    echo "    ONNX engines (Parakeet, Moonshine, SenseVoice, Paraformer, Dolphin,"
    echo "    Omnilingual, Cohere): install onnxruntime>=1.24.0, then run:"
    echo "      sudo voxtype setup onnx --enable"
}

_print_omarchy_hint() {
    [ -d /usr/share/omarchy ] || return 0
    echo "    Omarchy: the Voxtype Settings panel links itself when the daemon"
    echo "    next starts, or link it now with: voxtype setup omarchy"
}

post_install() {
    _link_active_binary

    echo ""
    echo "==> Voxtype Post-installation Steps:"
    echo ""

    _detect_gpu

    echo ""
    echo "    1. Add your user to the 'input' group:"
    echo "       sudo usermod -aG input \$USER"
    echo ""
    echo "    2. Log out and back in for group changes to take effect"
    echo ""
    echo "    3. Choose a model and configure dictation:"
    echo "       voxtype configure"
    echo ""
    echo "    4. Start voxtype:"
    echo "       systemctl --user enable --now voxtype"
    echo ""
    _print_onnx_hint
    echo ""
    _print_omarchy_hint
}

pre_upgrade() {
    # A file an interrupted upgrade left behind must not be taken for the
    # current state.
    rm -f "$_backend_state"
    local target
    target=$(_active_target)
    if [ -n "$target" ]; then
        echo "$target" > "$_backend_state"
    fi
}

post_upgrade() {
    local saved=""
    if [ -f "$_backend_state" ]; then
        saved=$(head -1 "$_backend_state")
        rm -f "$_backend_state"
    fi
    _link_active_binary "$saved"

    # pacman passes the new full version (pkgver-pkgrel) as $1; strip the
    # pkgrel. A hardcoded number here once announced 1.1.0 as 0.7.2.
    local version="${1%%-*}"

    echo ""
    echo "==> Voxtype upgraded to $version"
    echo "    Active binary: $(readlink -f /usr/bin/voxtype)"
    echo ""
    echo "    What's new in 1.3.0:"
    echo "      * Meetings: a live meeting view shows the transcript as it"
    echo "        happens, keeps speaker echo out of your lines, and lets you"
    echo "        fix lines during the call or after. Search every meeting,"
    echo "        and get a summary and action items when one ends."
    echo "      * Voxtype offers to record a call it detects and stops when"
    echo "        the call ends."
    echo "      * Without Quickshell, meetings open in a GTK window. Install"
    echo "        gtk4 for it."
    echo "      * voxtype doctor checks your setup, and a failure shows a"
    echo "        notification that names the fix."
    echo "      * Failed recordings and text that could not be typed are"
    echo "        kept instead of lost."
    echo "      * Models download only from Voxtype's own mirror."
    echo ""
    echo "    This package now always builds the ONNX engines and the GGUF"
    echo "    workers (CPU and Vulkan)."
    _print_onnx_hint
    echo ""
    _print_omarchy_hint
    echo "    Restart the daemon to apply updates:"
    echo "      systemctl --user restart voxtype"
    echo ""
    echo "    Full release notes:"
    echo "      https://github.com/peteonrails/voxtype/releases/tag/v$version"
    echo ""
}

post_remove() {
    rm -f /usr/bin/voxtype
}
