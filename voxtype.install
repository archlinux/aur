post_install() {
    echo ""
    echo "==> Voxtype Post-installation Steps:"
    echo ""
    echo "    1. Add your user to the 'input' group:"
    echo "       sudo usermod -aG input \$USER"
    echo ""
    echo "    2. Log out and back in for group changes to take effect"
    echo ""
    echo "    3. Install wtype for text output (recommended for Wayland):"
    echo "       pacman -S wtype"
    echo ""
    echo "    4. Download a whisper model:"
    echo "       voxtype setup --download"
    echo ""
    echo "    5. Start voxtype:"
    echo "       systemctl --user enable --now voxtype"
    echo "       Or run manually: voxtype"
    echo ""
    echo "==> X11 Users:"
    echo ""
    echo "    Install ydotool and enable the daemon:"
    echo "       pacman -S ydotool"
    echo "       systemctl --user enable --now ydotool"
    echo ""
    echo "==> GPU Acceleration (Optional):"
    echo ""
    echo "    This package was built for CPU inference. For GPU acceleration,"
    echo "    edit the PKGBUILD and rebuild with one of these features:"
    echo ""
    echo "      --features gpu-vulkan   # AMD, NVIDIA, Intel (recommended for AMD)"
    echo "      --features gpu-cuda     # NVIDIA only"
    echo "      --features gpu-hipblas  # AMD ROCm"
    echo ""
    echo "    GPU acceleration dramatically improves speed for larger models."
    echo "    See: https://voxtype.io or the README for details."
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> Voxtype upgraded to version 0.3.0"
    echo ""
    echo "    New in this version:"
    echo "      - wtype support for better CJK/Unicode text output"
    echo "      - wtype is now primary output method on Wayland (no daemon required)"
    echo "      - Fallback chain: wtype -> ydotool -> clipboard"
    echo "      - Fix systemd service not starting on login after logout"
    echo ""
    echo "    Wayland users: install wtype for best experience (pacman -S wtype)"
    echo "    X11 users: continue using ydotool"
    echo ""
    echo "    See: https://voxtype.io for details."
    echo ""
}
