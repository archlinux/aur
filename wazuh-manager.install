pre_upgrade()
{
  echo "=== PRE-UPGRADE ==="
  echo "Check: https://documentation.wazuh.com/current/upgrade-guide/upgrading-central-components.html"
  systemctl stop wazuh-manager 2>/dev/null || true
  systemctl stop filebeat 2>/dev/null || true
  cp /var/ossec/etc/ossec.conf /var/ossec/etc/ossec.conf.rpmsave 2>/dev/null || true
}

post_upgrade()
{
  echo "=== POST-UPGRADE ==="

  # Restore previous config
  if [ -f /var/ossec/etc/ossec.conf.rpmsave ]; then
    cp /var/ossec/etc/ossec.conf /var/ossec/etc/ossec.conf.rpmnew
    cp /var/ossec/etc/ossec.conf.rpmsave /var/ossec/etc/ossec.conf
    echo "Previous config restored. New config saved as /var/ossec/etc/ossec.conf.rpmnew"
  fi

  # El modulo wazuh de filebeat lo aporta el paquete wazuh-filebeat (dependencia).

  # Red de seguridad: si se viene de una instalacion sin ossec.conf, generarlo
  # aqui en vez de dejar el manager sin arrancar. No pisa uno existente.
  _generate_ossec_conf

  # Reload and restart services
  systemctl daemon-reload
  systemctl start wazuh-manager
  systemctl start filebeat

  echo ""
  echo "=== MANUAL STEPS IF NEEDED ==="
  echo "Update indexer credentials if changed:"
  echo "  echo '<USERNAME>' | /var/ossec/bin/wazuh-keystore -f indexer -k username"
  echo "  echo '<PASSWORD>' | /var/ossec/bin/wazuh-keystore -f indexer -k password"
}

post_install()
{
  echo "=== POST-INSTALL ==="

  # Create user and group
  echo "Creating wazuh user and group..."
  groupadd -f wazuh
  id "wazuh" &>/dev/null || useradd --system -g wazuh -d /var/ossec -s /usr/bin/nologin wazuh

  # Set permissions
  echo "Setting permissions..."
  chown -R wazuh:wazuh /var/ossec

  # ossec.conf NO viene dentro del paquete: el RPM lo genera en su %post con
  # gen_ossec.sh, porque add_localfiles.sh necesita mirar que logs existen en
  # ESTA maquina. Sin este paso una instalacion limpia se queda sin
  # /var/ossec/etc/ossec.conf y wazuh-manager no arranca.
  _generate_ossec_conf

  # Generate SSL certificates for wazuh-authd (agent enrollment)
  echo "Generating certificates for wazuh-authd..."
  /var/ossec/bin/wazuh-authd -C 365 -B 2048 -K /var/ossec/etc/sslmanager.key -X /var/ossec/etc/sslmanager.cert -S "/C=US/ST=California/CN=wazuh/" 2>/dev/null || true

  # Ficheros de log que el manager espera encontrar creados (los crea el %post
  # del RPM; sin ellos active response e integraciones no pueden escribir).
  touch /var/ossec/logs/active-responses.log /var/ossec/logs/integrations.log
  chown wazuh:wazuh /var/ossec/logs/active-responses.log /var/ossec/logs/integrations.log
  chmod 0660 /var/ossec/logs/active-responses.log
  chmod 0640 /var/ossec/logs/integrations.log

  # Restos de configuracion compartida que el RPM elimina en instalacion limpia
  rm -f /var/ossec/etc/shared/ar.conf /var/ossec/etc/shared/merged.mg 2>/dev/null || true

  # El modulo wazuh de filebeat lo aporta el paquete wazuh-filebeat (dependencia).

  echo ""
  echo "=========================================="
  echo "  WAZUH MANAGER INSTALLATION COMPLETE"
  echo "=========================================="
  echo ""
  echo "=== REQUIRED CONFIGURATION ==="
  echo ""
  echo "1. Deploy certificates to /etc/filebeat/certs/"
  echo "   mkdir -p /etc/filebeat/certs"
  echo "   tar -xf wazuh-certificates.tar -C /etc/filebeat/certs/ ./<SERVER_NODE_NAME>.pem ./<SERVER_NODE_NAME>-key.pem ./root-ca.pem --strip-components=1"
  echo "   mv /etc/filebeat/certs/<SERVER_NODE_NAME>.pem /etc/filebeat/certs/filebeat.pem"
  echo "   mv /etc/filebeat/certs/<SERVER_NODE_NAME>-key.pem /etc/filebeat/certs/filebeat-key.pem"
  echo "   chmod 500 /etc/filebeat/certs && chmod 400 /etc/filebeat/certs/*"
  echo ""
  echo "2. Configure /etc/filebeat/filebeat.yml with your indexer hosts"
  echo ""
  echo "3. Configure indexer credentials:"
  echo "   echo 'admin' | /var/ossec/bin/wazuh-keystore -f indexer -k username"
  echo "   echo '<PASSWORD>' | /var/ossec/bin/wazuh-keystore -f indexer -k password"
  echo ""
  echo "4. Start services:"
  echo "   systemctl daemon-reload"
  echo "   systemctl enable --now wazuh-manager"
  echo "   systemctl enable --now filebeat"
  echo ""
  echo "5. Test filebeat connection:"
  echo "   filebeat test output"
  echo ""
  echo "Documentation: https://documentation.wazuh.com/current/installation-guide/wazuh-server/step-by-step.html"
}

_generate_ossec_conf()
{
  local scripts=/var/ossec/packages_files/manager_installation_scripts

  if [ -f /var/ossec/etc/ossec.conf ]; then
    echo "  ossec.conf ya existe, se conserva"
    return
  fi

  if [ ! -x "$scripts/gen_ossec.sh" ]; then
    echo "  WARNING: gen_ossec.sh no esta disponible, no se puede generar ossec.conf"
    echo "  WARNING: wazuh-manager NO arrancara sin /var/ossec/etc/ossec.conf"
    return
  fi

  echo "Generating /var/ossec/etc/ossec.conf..."

  # dist-detect.sh exporta DIST_NAME / DIST_VER / DIST_SUBVER. En Arch y
  # derivadas no hay plantilla propia y gen_ossec.sh cae en la 'generic', que
  # es la correcta.
  DIST_NAME="generic"; DIST_VER="0"; DIST_SUBVER="0"
  # shellcheck source=/dev/null
  [ -r "$scripts/src/init/dist-detect.sh" ] && . "$scripts/src/init/dist-detect.sh"

  if "$scripts/gen_ossec.sh" conf manager "$DIST_NAME" "${DIST_VER}.${DIST_SUBVER}" \
        /var/ossec > /var/ossec/etc/ossec.conf 2>/dev/null && \
     [ -s /var/ossec/etc/ossec.conf ]; then
    # localfiles depende de que logs existan en esta maquina, por eso se
    # resuelve aqui y no en tiempo de empaquetado.
    "$scripts/add_localfiles.sh" /var/ossec >> /var/ossec/etc/ossec.conf 2>/dev/null || true
    chown root:wazuh /var/ossec/etc/ossec.conf
    chmod 0660 /var/ossec/etc/ossec.conf
    echo "  ossec.conf generado para ${DIST_NAME} ${DIST_VER}.${DIST_SUBVER}"
  else
    rm -f /var/ossec/etc/ossec.conf
    echo "  WARNING: fallo la generacion de ossec.conf"
    echo "  WARNING: wazuh-manager NO arrancara sin /var/ossec/etc/ossec.conf"
  fi
}
