post_install() {
  cat <<'EOF'
==> humen-mcp installed.
==> Initialize the admin account before starting the service:
    sudo humen-mcp init-admin --email <admin-login>
==> The command writes /etc/humen-mcp.env and prints the generated admin password.
==> Then set HUMEN_PUBLIC_BASE_URL in /etc/humen-mcp.env and start:
    sudo systemctl enable --now humen-mcp.service
==> Admin self-update is available after configuring /etc/humen-mcp-update.env
    for the normal AUR user.
==> GitHub OAuth stays disabled until HUMEN_GITHUB_CLIENT_ID and
    HUMEN_GITHUB_CLIENT_SECRET are configured by an admin.
EOF
}

post_upgrade() {
  cat <<'EOF'
==> humen-mcp upgraded.
==> If this is a new deployment or you need to reset the admin login, run:
    sudo humen-mcp init-admin --email <admin-login>
==> Restart after changing /etc/humen-mcp.env:
    sudo systemctl restart humen-mcp.service
==> If self-update fails, check /etc/humen-mcp-update.env and
    systemctl status humen-mcp-self-update.service
EOF
}
