new file mode 100644
index 000000000..b466c8747
--- /dev/null
+++ b/src/bootstrap/linux/libmillennium_bootstrap_x64.c
@@ -0,0 +1,316 @@
+/**
+ * ==================================================
+ *   _____ _ _ _             _
+ *  |     |_| | |___ ___ ___|_|_ _ _____
+ *  | | | | | | | -_|   |   | | | |     |
