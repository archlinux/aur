diff --git a/packages/arch/PKGBUILD b/packages/arch/PKGBUILD
index 450361556..1ac0b6df0 100644
--- a/packages/arch/PKGBUILD
+++ b/packages/arch/PKGBUILD
@@ -8,7 +8,7 @@ arch=('x86_64')
 url="https://github.com/SteamClientHomebrew/Millennium"
 license=('MIT')
 depends=('steam')
-makedepends=('git' 'bun' 'curl' 'zip' 'unzip' 'tar' 'cmake' 'ninja' 'rust' 'lib32-gcc-libs' 'lib32-openssl' 'lib32-libidn2' 'lib32-xz' 'lib32-zstd' 'lib32-brotli' 'lib32-libnghttp2' 'lib32-libpsl' 'libx11' 'libxtst')
+makedepends=('git' 'bun' 'curl' 'zip' 'unzip' 'tar' 'cmake' 'ninja' 'rust' 'openssl' 'lib32-gcc-libs' 'lib32-openssl' 'lib32-libidn2' 'lib32-xz' 'lib32-zstd' 'lib32-brotli' 'lib32-libnghttp2' 'lib32-libpsl' 'libx11' 'libxi' 'libxtst')
 install=millennium.install
 source=("git+$url.git#commit=88fb7c16d04d162cb3e94beedb11a51705ec03fb")
 sha256sums=('SKIP')
@@ -20,6 +20,9 @@ build() {
 
     cmake --preset linux-arch-pkgbuild
     cmake --build build
+
+    cmake --preset linux-arch-pkgbuild-x64
+    cmake --build build64
 }
 
 package() {
@@ -32,5 +35,8 @@ package() {
     install -m755 build/libmillennium_luavm_x86 "$pkgdir/usr/lib/millennium/"
     install -m755 build/libmillennium_bootstrap_hhx64.so "$pkgdir/usr/lib/millennium/"
     install -m755 build/libmillennium_pvs64 "$pkgdir/usr/lib/millennium/"
+    install -m755 build64/libmillennium_x64.so "$pkgdir/usr/lib/millennium/"
+    install -m755 build64/libmillennium_luavm_x64 "$pkgdir/usr/lib/millennium/"
+    install -m755 build64/libmillennium_bootstrap_x64.so "$pkgdir/usr/lib/millennium/"
     install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/millennium/LICENSE.md"
 }
diff --git a/packages/arch/millennium.install b/packages/arch/millennium.install
index 95acea065..113101d84 100644
--- a/packages/arch/millennium.install
+++ b/packages/arch/millennium.install
@@ -31,6 +31,12 @@ link_millennium() {
 
     ln -sf /usr/lib/millennium/libmillennium_bootstrap_x86.so   "$steam/ubuntu12_32/libXtst.so.6"
     ln -sf /usr/lib/millennium/libmillennium_bootstrap_hhx64.so "$steam/ubuntu12_64/libXtst.so.6"
+
+    # SteamRT3 runs the client inside a pressure-vessel container where /usr is not the host's,
+    # so the link has to go through /run/host. Created unconditionally: install hooks run once,
+    # and a user who opts into RT3 later would otherwise have no link at all.
+    mkdir -p "$steam/steamrt64"
+    ln -sf /run/host/usr/lib/millennium/libmillennium_bootstrap_x64.so "$steam/steamrt64/libXtst.so.6"
 }
 
 unlink_millennium() {
@@ -39,6 +45,7 @@ unlink_millennium() {
 
     rm -f "$steam/ubuntu12_32/libXtst.so.6"
     rm -f "$steam/ubuntu12_64/libXtst.so.6"
+    rm -f "$steam/steamrt64/libXtst.so.6"
     rm -f "$home/.steam/steam/.cef-enable-remote-debugging"
 }
 
diff --git a/packages/nix/millennium.nix b/packages/nix/millennium.nix
index f303662b5..5226beb26 100644
--- a/packages/nix/millennium.nix
+++ b/packages/nix/millennium.nix
@@ -19,6 +19,15 @@
   re2,
   runCommand,
 
+  openssl,
+  curl,
+  minizip-ng,
+  bzip2,
+  xz,
+  zstd,
+  nlohmann_json,
+  zlib,
+
   millennium-src,
   ...
 }:
@@ -151,6 +160,9 @@ let
     pname = "millennium-64";
 
     nativeBuildInputs = commonBuild.nativeBuildInputs ++ [
+      bun
+      nodejs
+      patchelf
       cargo
       rustc
     ];
@@ -161,9 +173,34 @@ let
       libXtst
       re2
       re2.dev
+      openssl
+      curl
+      minizip-ng
+      bzip2
+      xz
+      zstd
+      nlohmann_json
+      zlib
     ];
 
     postPatch = ''
+      export HOME=$TMPDIR
+
+      for dir in ${tsDirs}; do
+        if [ -d ${bunDeps}/$dir ]; then
+          mkdir -p "$(dirname "$dir")"
+          cp -r ${bunDeps}/$dir "$dir"
+          chmod -R u+w "$dir"
+        fi
+      done
+
+      mkdir -p src/typescript/ttc
+      cp -r ${bunDeps}/src/typescript/ttc/dist src/typescript/ttc/dist
+      chmod -R u+w src/typescript/ttc/dist
+
+      patchShebangs src/typescript/node_modules
+      ${tsBuildCmds}
+
       mkdir -p src/instrumentation/loopback/.cargo
       cat > src/instrumentation/loopback/.cargo/config.toml << 'EOF'
       [source.crates-io]
@@ -174,16 +211,24 @@ let
       EOF
     '';
 
-    cmakeFlags = commonBuild.cmakeFlags ++ [ "-DMILLENNIUM_NIX_64BIT=ON" ];
+    cmakeFlags = commonBuild.cmakeFlags ++ [ "-DMILLENNIUM_LINUX_X64=ON" "-DDISTRO_NIX=ON" ];
 
     installPhase = ''
       runHook preInstall
       mkdir -p $out/lib/
-      install -Dm755 libmillennium_hhx64.so           $out/lib/libmillennium_hhx64.so
-      install -Dm755 libmillennium_pvs64              $out/lib/libmillennium_pvs64
+      install -Dm755 libmillennium_x64.so            $out/lib/libmillennium_x64.so
+      install -Dm755 libmillennium_luavm_x64         $out/lib/libmillennium_luavm_x64
+      install -Dm755 libmillennium_bootstrap_x64.so  $out/lib/libmillennium_bootstrap_x64.so
+      install -Dm755 libmillennium_hhx64.so          $out/lib/libmillennium_hhx64.so
+      install -Dm755 libmillennium_pvs64             $out/lib/libmillennium_pvs64
       install -Dm755 libmillennium_bootstrap_hhx64.so $out/lib/libmillennium_bootstrap_hhx64.so
       runHook postInstall
     '';
+
+    postFixup = ''
+      patchelf --force-rpath --set-rpath "$(patchelf --print-rpath $out/lib/libmillennium_x64.so)" $out/lib/libmillennium_x64.so
+      patchelf --force-rpath --set-rpath "$(patchelf --print-rpath $out/lib/libmillennium_bootstrap_x64.so)" $out/lib/libmillennium_bootstrap_x64.so
+    '';
   });
 in
 runCommand "millennium-${version}" {
diff --git a/packages/nix/steam.nix b/packages/nix/steam.nix
index 7c43d7d2c..6d5d64a24 100644
--- a/packages/nix/steam.nix
+++ b/packages/nix/steam.nix
@@ -20,11 +20,15 @@ let
   millenniumEnv = {
     # consumed by millennium internally.
     MILLENNIUM_RUNTIME_PATH = "${millennium}/lib/libmillennium_x86.so";
+    # SteamRT3 client: the x64 proxy reads this first.
+    MILLENNIUM_RUNTIME_PATH_X64 = "${millennium}/lib/libmillennium_x64.so";
   };
 
   millenniumProfile = ''
     ln -sf ${millennium}/lib/libmillennium_bootstrap_x86.so "$HOME/.local/share/Steam/ubuntu12_32/libXtst.so.6"
     ln -sf ${millennium}/lib/libmillennium_bootstrap_hhx64.so "$HOME/.local/share/Steam/ubuntu12_64/libXtst.so.6"
+    mkdir -p "$HOME/.local/share/Steam/steamrt64"
+    ln -sf ${millennium}/lib/libmillennium_bootstrap_x64.so "$HOME/.local/share/Steam/steamrt64/libXtst.so.6"
   '';
 
   upstreamArgs = removeAttrs args [
diff --git a/scripts/install.sh b/scripts/install.sh
index 117b703dd..7a3c5ddd4 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -174,25 +174,30 @@ install_millennium() {
 post_install() {
     sudo chmod +x /usr/lib/millennium/libmillennium_pvs64 2>/dev/null || true
     sudo chmod +x /usr/lib/millennium/libmillennium_luavm_x86 2>/dev/null || true
+    sudo chmod +x /usr/lib/millennium/libmillennium_luavm_x64 2>/dev/null || true
 
     log "installing for '${USER}'"
 
     beta_file="${HOME}/.steam/steam/package/beta"
+    rt3_marker="${HOME}/.steam/steam/.steam-enable-steamrt64-client"
 
     # make sure to force steam stable for the first install.
     # if the user wants beta they can set it after install.
     # normally its fine, but many users forget they have it enabled on first install,
     # and then face issues.
-    if [ -f "${beta_file}" ]; then
+    # users already on the SteamRT3 client need the beta channel: do not push them back to stable.
+    if [ -f "${beta_file}" ] && [ ! -e "${rt3_marker}" ]; then
         log "removing beta '$(cat "${beta_file}")' in favor for stable."
         rm "${beta_file}"
     fi
 
     # create symlinks for millenniums preload bootstraps.
-    mkdir -p "${HOME}/.steam/steam/ubuntu12_32" "${HOME}/.steam/steam/ubuntu12_64"
+    mkdir -p "${HOME}/.steam/steam/ubuntu12_32" "${HOME}/.steam/steam/ubuntu12_64" "${HOME}/.steam/steam/steamrt64"
     ln -sf /usr/lib/millennium/libmillennium_bootstrap_x86.so   "${HOME}/.steam/steam/ubuntu12_32/libXtst.so.6"
     ln -sf /usr/lib/millennium/libmillennium_bootstrap_hhx64.so "${HOME}/.steam/steam/ubuntu12_64/libXtst.so.6"
     ln -sf /usr/lib/millennium/libmillennium_hhx64.so           "${HOME}/.steam/steam/ubuntu12_64/libmillennium_hhx64.so"
+    # SteamRT3 runs the client inside a pressure-vessel container, so the link resolves through /run/host.
+    ln -sf /run/host/usr/lib/millennium/libmillennium_bootstrap_x64.so "${HOME}/.steam/steam/steamrt64/libXtst.so.6"
 }
 
 cleanup() {
diff --git a/scripts/linux/destroy_devenv.sh b/scripts/linux/destroy_devenv.sh
index 8ef156a47..00f4cf7c0 100755
--- a/scripts/linux/destroy_devenv.sh
+++ b/scripts/linux/destroy_devenv.sh
@@ -25,6 +25,7 @@ remove_if_symlink() {
 
 remove_if_symlink "${U32}/libXtst.so.6"
 remove_if_symlink "${U64}/libXtst.so.6"
+remove_if_symlink "${STEAM_DIR}/steamrt64/libXtst.so.6"
 
 echo ""
 echo "dev environment removed. restart Steam to apply."
diff --git a/scripts/linux/setup_devenv.sh b/scripts/linux/setup_devenv.sh
index 2f21e4576..f30168c44 100755
--- a/scripts/linux/setup_devenv.sh
+++ b/scripts/linux/setup_devenv.sh
@@ -65,6 +65,13 @@ echo ""
 ln -sfv "${BOOTSTRAP_X86}" "${U32}/libXtst.so.6"
 ln -sfv "${BOOTSTRAP_HHX64}" "${U64}/libXtst.so.6"
 
+# Optional: the SteamRT3 x64 payload only exists in a build tree configured with
+# -DMILLENNIUM_LINUX_X64=ON. Do not fail an x86-only build over it.
+if [ -f "${BUILD_DIR}/libmillennium_bootstrap_x64.so" ]; then
+    mkdir -p "${STEAM_DIR}/steamrt64"
+    ln -sfv "${BUILD_DIR}/libmillennium_bootstrap_x64.so" "${STEAM_DIR}/steamrt64/libXtst.so.6"
+fi
+
 rm -f "${STEAM_DIR}/.cef-enable-remote-debugging"
 
 echo ""
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 1c5e729aa..de435c5b2 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -139,15 +139,18 @@ endif()
 if(UNIX AND NOT APPLE)
     set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -D_GNU_SOURCE")
     set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -D_GNU_SOURCE")
-    set(CMAKE_LIBRARY_PATH "/usr/lib32;/lib32" CACHE STRING "32-bit library search paths" FORCE)
-    set(CMAKE_FIND_ROOT_PATH "/usr/lib32;/lib32" CACHE STRING "32-bit find root path" FORCE)
-    set(ZLIBNG_FOUND FALSE CACHE BOOL "Disable zlib-ng detection" FORCE)
-    set(ZLIBNG_LIBRARY "" CACHE FILEPATH "Empty zlib-ng library path" FORCE)
-    set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -m32")
-    set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -m32")
-    set(CMAKE_ASM_FLAGS "${CMAKE_ASM_FLAGS} -m32")
-    set(LUAJIT_BUILD_FLAGS "-m32" CACHE STRING "LuaJIT build flags" FORCE)
-    set(LUAJIT_TARGET_FLAGS "-m32" CACHE STRING "LuaJIT target flags" FORCE)
+
+    if(NOT MILLENNIUM_LINUX_X64)
+        set(CMAKE_LIBRARY_PATH "/usr/lib32;/lib32" CACHE STRING "32-bit library search paths" FORCE)
+        set(CMAKE_FIND_ROOT_PATH "/usr/lib32;/lib32" CACHE STRING "32-bit find root path" FORCE)
+        set(ZLIBNG_FOUND FALSE CACHE BOOL "Disable zlib-ng detection" FORCE)
+        set(ZLIBNG_LIBRARY "" CACHE FILEPATH "Empty zlib-ng library path" FORCE)
+        set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -m32")
+        set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -m32")
+        set(CMAKE_ASM_FLAGS "${CMAKE_ASM_FLAGS} -m32")
+        set(LUAJIT_BUILD_FLAGS "-m32" CACHE STRING "LuaJIT build flags" FORCE)
+        set(LUAJIT_TARGET_FLAGS "-m32" CACHE STRING "LuaJIT target flags" FORCE)
+    endif()
 endif()
 
 include(${MILLENNIUM_BASE}/scripts/cmake/bootstrap_deps.cmake)
