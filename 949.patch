+        "MILLENNIUM_LINUX_X64": "ON",
+        "CMAKE_BUILD_TYPE": "Release"
+      }
+    },
+    {
+      "name": "linux-arch-pkgbuild-x64",
+      "inherits": "linux-release-x64",
+      "displayName": "linux-arch-pkgbuild-x64",
+      "description": "Arch Linux PKGBUILD build for SteamRT3 (RelWithDebInfo, remapped debug paths)",
+      "cacheVariables": {
+        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
+        "CMAKE_CXX_FLAGS": "-fdebug-prefix-map=${sourceDir}/= -fmacro-prefix-map=${sourceDir}/=",
+        "CMAKE_C_FLAGS": "-fdebug-prefix-map=${sourceDir}/= -fmacro-prefix-map=${sourceDir}/="
+      }
     }
   ]
