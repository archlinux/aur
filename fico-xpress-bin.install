post_install() {
    echo -e "\e[1;33m==> IMPORTANT: FICO Xpress has been installed.\e[0m"
    echo -e "\e[1;33m==> To apply the environment variables, you MUST log out and log back in\e[0m"
    echo -e "\e[1;33m==> to your desktop session (or restart your computer).\e[0m"
}

post_upgrade() {
    post_install
}

