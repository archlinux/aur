# MailFlow — /etc/mailflow/mailflow.env
# Preserved across upgrades (backup= in PKGBUILD).
# Generate secrets before the first start:
#   openssl rand -hex 32    # SESSION_SECRET and ENCRYPTION_KEY
#   openssl rand -hex 16    # DB_PASSWORD

# ── Required ──────────────────────────────────────────────────────────────────
# Browser origin, no trailing path. WebSocket checks this string exactly.
APP_URL=https://mail.example.com

# At least 32 characters.
SESSION_SECRET=

# Password of the PostgreSQL role named below. Must match the database user.
DB_PASSWORD=

# Exactly 64 hex characters (32 bytes). Losing or changing this makes every
# stored mailbox password and OAuth token unreadable.
ENCRYPTION_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mailflow
DB_USER=mailflow

# ── Redis ─────────────────────────────────────────────────────────────────────
# Unix socket is also accepted: redis+unix:///run/redis/redis.sock
REDIS_URL=redis://127.0.0.1:6379

# ── HTTP ──────────────────────────────────────────────────────────────────────
# The unit binds localhost unless HOST is changed. nginx proxies to this port.
HOST=127.0.0.1
PORT=3000

# Reverse proxies in front of the backend, counting the nginx shipped with this
# package. Empty means 1. Set 2 only when a second proxy is the sole way clients
# reach MailFlow, otherwise a direct client can pick the address used for the
# login rate limit.
TRUST_PROXY_HOPS=

# ── Optional ──────────────────────────────────────────────────────────────────
#LOG_LEVEL=info
#IMAP_MAX_PERSISTENT_PER_HOST=
#UPDATE_CHECK_DISABLED=true
#ALLOW_PRIVATE_IMAP_HOSTS=true

# Google OAuth (Workspace). Redirect URI must be ${APP_URL}/oauth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URI=https://mail.example.com/oauth/google/callback

# Microsoft 365 / Outlook OAuth
#MS_CLIENT_ID=
#MS_CLIENT_SECRET=
#MS_TENANT_ID=common
#MS_REDIRECT_URI=https://mail.example.com/oauth/microsoft/callback

# Web push. Generate with: npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com
