[Unit]
Description=AI-Trader FastAPI Backend Server
After=network.target redis.service postgresql.service
Wants=redis.service

[Service]
Type=simple
User=ai-trader
Group=ai-trader
WorkingDirectory=/opt/ai-trader/service/server
Environment=DOTENV_PATH=/etc/ai-trader/.env
ExecStart=/opt/ai-trader/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

ProtectSystem=false

[Install]
WantedBy=multi-user.target
