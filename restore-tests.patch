+        let (start, items) = complete("theme ", &ctx(), &no_flags);
+        assert_eq!(start, 6);
+        assert_eq!(items.len(), 3);
+        let (_, items) = complete("theme tok", &ctx(), &no_flags);
+        assert_eq!(
+            items.iter().map(|i| i.value.as_str()).collect::<Vec<_>>(),
+            ["tokyo-night", "tokyo-night-day"]
+        );
+    }
