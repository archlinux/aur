+        assert_eq!(devs[0], "network");
+        let xml = set_boot_order(&arch(), &["hd", "cdrom"]).unwrap();
+        assert!(xml.contains("dev=\"hd\"") || xml.contains("dev='hd'"));
+    }
+}
