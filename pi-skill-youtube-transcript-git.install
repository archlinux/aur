post_install() {
  cat <<'EOF'
==> pi-skill-youtube-transcript-git installed.

Pi discovers skills from configured paths.

Add one of these to your Pi settings:

Global (all projects): ~/.pi/agent/settings.json
{
  "skills": ["/usr/share/pi/skills"]
}

Project-only: .pi/settings.json
{
  "skills": ["/usr/share/pi/skills/youtube-transcript"]
}

Tip: you can include both paths if you want broad + explicit discovery.
EOF
}

post_upgrade() {
  post_install "$@"
}
