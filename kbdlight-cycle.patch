+static void toshiba_kbd_backlight_cycle(struct toshiba_acpi_dev *dev)
+{
+	u32 time;
+	int new_mode, new_brightness;
+
+	/* Only for type 2 keyboards with illumination support */
+	if (!dev->kbd_illum_supported || dev->kbd_type != 2)
+		return;
+
+	/* Cycle: AUTO (0x2) -> ON (0x8) -> OFF (0x10) -> AUTO */
+	switch (dev->kbd_mode & SCI_KBD_MODE_MASK) {
+	case SCI_KBD_MODE_AUTO:
+		new_mode = SCI_KBD_MODE_ON;
+		new_brightness = 2;
+		break;
+	case SCI_KBD_MODE_ON:
+		new_mode = SCI_KBD_MODE_OFF;
+		new_brightness = 0;
+		break;
+	case SCI_KBD_MODE_OFF:
+	default:
+		new_mode = SCI_KBD_MODE_AUTO;
+		new_brightness = 1;
+		break;
+	}
+
+	time = dev->kbd_time << HCI_MISC_SHIFT;
+	time |= new_mode;
+
+	if (toshiba_kbd_illum_status_set(dev, time) == 0) {
+		dev->kbd_mode = new_mode;
+		toshiba_acpi->kbd_mode = new_mode;
+
+		/* Notify LED subsystem of hardware-initiated change */
+		led_classdev_notify_brightness_hw_changed(&dev->kbd_led,
+				new_brightness);
+	}
+}
