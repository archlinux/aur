post_install() {
    cat <<EOF
mlink-bin: mLink installed to /opt/makeblock/mlink

  Start + enable on boot:  sudo systemctl enable --now mlink
  Check status:            systemctl status mlink
  View logs:               journalctl -u mlink
EOF
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl stop mlink.service 2>/dev/null || true
    systemctl disable mlink.service 2>/dev/null || true
}
