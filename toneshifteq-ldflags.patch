diff --git a/EQ12/Makefile b/EQ12/Makefile
index 1a20e77..8b19086 100644
--- a/EQ12/Makefile
+++ b/EQ12/Makefile
@@ -111,6 +111,7 @@ endif
 ifeq ($(TARGET), Linux)
