post_install() {
    echo ""
    echo "  ╔═══════════════════════════════════════════════╗"
    echo "  ║         HyprCandy+ Installer Ready            ║"
    echo "  ╚═══════════════════════════════════════════════╝"
    echo ""
    echo "  Run the installer with:"
    echo ""
    echo "    hc-install"
    echo ""
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ""
    echo "  HyprCandy+ installer removed."
    echo "  Your existing HyprCandy+ installation is unaffected."
    echo "  Run hc-update from your bar to manage it."
    echo ""
}
