# Installed by "keepalive service install"; remove with "keepalive service uninstall".
[Unit]
Description=keepalive
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/keepalive --plain --origin service
Restart=on-failure
RestartSec=5
Environment=KEEPALIVE_ORIGIN=service

[Install]
WantedBy=graphical-session.target
