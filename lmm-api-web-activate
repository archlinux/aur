#!/usr/bin/env bash
set -Eeuo pipefail

die() { printf 'lmm-api-web-activate: %s\n' "$*" >&2; exit 1; }

[[ $# == 1 ]] || die 'expected the installed package version'
readonly root=${LMM_API_WEB_ROOT:-/srv/lmm-api-frontend}
readonly source_dir=${LMM_API_WEB_SOURCE:-/usr/share/lmm-api-web/frontend-dist}
readonly publisher=${LMM_API_WEB_PUBLISHER:-/usr/lib/lmm-api-web/frontend-release.sh}
readonly revision_file=${LMM_API_WEB_REVISION_FILE:-/usr/share/doc/lmm-api-web-bin/REVISION}
readonly probe_url=${LMM_API_WEB_PROBE_URL:-https://api.lmm.best/}
readonly probe_resolve=${LMM_API_WEB_PROBE_RESOLVE:-api.lmm.best:443:127.0.0.1}
readonly keep=${LMM_API_WEB_KEEP:-3}

[[ -f $revision_file && ! -L $revision_file ]] || die 'release revision is unavailable'
revision=$(tr -d '[:space:]' <"$revision_file")
[[ $revision =~ ^[0-9a-f]{40,64}$ ]] || die 'release revision is invalid'
release=${1//:/-}.g${revision:0:12}
[[ $release =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]] || die 'invalid package version'

[[ $root == /* && $root != / ]] || die 'frontend root must be absolute and non-root'
[[ -x $publisher ]] || die 'frontend publisher is unavailable'
[[ -f $source_dir/index.html ]] || die 'packaged frontend is missing index.html'
[[ $keep =~ ^[1-9][0-9]*$ ]] || die 'retention must be a positive integer'

previous=''
if [[ -L $root/current ]]; then
  current_link=$(readlink -- "$root/current")
  case $current_link in
    releases/*) previous=${current_link#releases/} ;;
    *) die 'active frontend link is unsafe' ;;
  esac
  [[ $previous != */* && $previous =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]] ||
    die 'active frontend release is unsafe'
fi

mutation_started=0
restore_previous() {
  local rc=$?
  trap - ERR
  if (( mutation_started )); then
    if [[ -n $previous && -d $root/releases/$previous ]]; then
      "$publisher" rollback --root "$root" --release "$previous" --keep "$keep" || true
      nginx -t >/dev/null 2>&1 && systemctl reload nginx.service >/dev/null 2>&1 || true
    else
      rm -f -- "$root/current"
    fi
  fi
  exit "$rc"
}
trap restore_previous ERR

# Validate nginx before changing the active symlink. A package update never
# restarts the Go service.
nginx -t
mutation_started=1
target=$root/releases/$release
if [[ -e $target ]]; then
  [[ -d $target && ! -L $target ]] || die 'existing release target is unsafe'
  diff -qr --no-dereference -- "$source_dir" "$target" >/dev/null ||
    die 'existing release has different content'
  if [[ ! -L $root/current || $(readlink -- "$root/current") != "releases/$release" ]]; then
    "$publisher" rollback --root "$root" --release "$release" --keep "$keep"
  fi
else
  "$publisher" publish --root "$root" --source "$source_dir" --release "$release" --keep "$keep"
fi

nginx -t
systemctl reload nginx.service
systemctl is-active --quiet nginx.service
probe_args=(--fail --silent --show-error --location --max-time 15)
if [[ -n $probe_resolve ]]; then
  probe_args+=(--resolve "$probe_resolve")
fi
curl "${probe_args[@]}" "$probe_url" >/dev/null
mutation_started=0
trap - ERR
printf 'active_web_release=%s\n' "$release"
