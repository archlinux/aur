cleanup_leftovers() {
    local files=(
        /usr/bin/wayscriber
        /usr/bin/wayscriber-configurator
        /usr/lib/systemd/user/wayscriber.service
    )

    for file in "${files[@]}"; do
        if [[ -e "$file" ]] && ! pacman -Qo "$file" >/dev/null 2>&1; then
            rm -f "$file"
        fi
    done
}

pre_install() {
    cleanup_leftovers
}

pre_upgrade() {
    cleanup_leftovers
}
