diff --git a/conf/systemd/journald@raspisump.conf b/conf/systemd/journald@raspisump.conf
new file mode 100644
index 000000000000..01443693db7a
--- /dev/null
+++ b/conf/systemd/journald@raspisump.conf
@@ -0,0 +1,18 @@
+# Configuration for the "raspisump" journal namespace, read by the
+# systemd-journald@raspisump.service instance that collects log output of
+# raspisump.service and rsumpweb.service (see LogNamespace= in the units
+# and journald.conf(5)).
+#
+# Install to /etc/systemd/journald@raspisump.conf.
+#
+# Namespaced journal instances default to Storage=persistent; pinned here
+# so the log tail on the web System Status page survives reboots even if
+# the compiled-in default ever changes. The size caps keep the namespace
+# store small and SD-card friendly.
+[Journal]
+Storage=persistent
+Compress=yes
+SystemMaxUse=64M
+SystemMaxFileSize=8M
+SystemMaxFiles=10
+RuntimeMaxUse=16M
