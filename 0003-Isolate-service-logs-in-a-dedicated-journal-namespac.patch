diff --git a/conf/systemd/systemd-journald@raspisump.service.d/raspisump-acl.conf b/conf/systemd/systemd-journald@raspisump.service.d/raspisump-acl.conf
new file mode 100644
index 000000000000..b48b89205f15
--- /dev/null
+++ b/conf/systemd/systemd-journald@raspisump.service.d/raspisump-acl.conf
@@ -0,0 +1,19 @@
+# Grant the raspisump user read access to its own journal namespace.
+#
+# Install to /usr/lib/systemd/system/systemd-journald@raspisump.service.d/
+# (Debian: /lib/systemd/system/...).
+#
+# journald creates /var/log/journal/<machine-id>.raspisump owned by
+# root:systemd-journal, so without this grant only systemd-journal members
+# could read it back -- and putting raspisump in systemd-journal would
+# expose the entire system journal to the network-facing web process.
+# The d: (default) ACL entries make journal files created later (e.g. on
+# rotation) inherit the grant, matching the recursive ACL recipe in
+# systemd-journald.service(8).
+#
+# "+" runs the command with full privileges (setfacl needs to touch files
+# owned by root); "-" tolerates failure, e.g. if an admin overrides the
+# namespace to Storage=volatile and the directory never appears.
+# %m expands to the machine id, %i to the instance name "raspisump".
+[Service]
+ExecStartPost=-+/usr/bin/setfacl -Rnm u:raspisump:rX,d:u:raspisump:rX /var/log/journal/%m.%i
