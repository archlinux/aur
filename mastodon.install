# Mastodon package install script
#
# IMPORTANT:
# - Never recursively chown the package-owned application tree.
# - Never restart Mastodon automatically during a pacman transaction.
# - Never automatically run database migrations for upgrades from pre-4.7.
#   Such upgrades require an operator-controlled PRE/POST migration sequence.

_fix_ownership() {
  # Pacman owns the application files and their root:root metadata.
  # Only runtime-writable directories belong to the Mastodon service account.
  echo "==> Fixing ownership of Mastodon runtime directories..."

  install -d -o mastodon -g mastodon /var/lib/mastodon/tmp
  install -d -o mastodon -g mastodon /var/lib/mastodon/log
  install -d -o mastodon -g mastodon /var/lib/mastodon/public/system

  chown mastodon:mastodon /var/lib/mastodon/tmp
  chown mastodon:mastodon /var/lib/mastodon/log
  chown mastodon:mastodon /var/lib/mastodon/public/system
}

_reload_systemd() {
  echo "==> Reloading systemd units..."
  systemctl daemon-reload 2>/dev/null || true
}

_restart_notice() {
  echo
  echo "==> Mastodon services were NOT restarted automatically."
  echo "==> After checking the upgrade, restart them with:"
  echo "    systemctl restart mastodon-web mastodon-sidekiq mastodon-streaming"
  echo
  echo "==> Then verify:"
  echo "    systemctl is-active mastodon-web mastodon-sidekiq mastodon-streaming"
}

post_install() {
  echo "==> Mastodon installed."
  _fix_ownership
  _reload_systemd

  echo
  echo "==> Initial installation still requires Mastodon configuration"
  echo "==> and database setup before starting the services."
}

post_upgrade() {
  newver="$1"
  oldver="$2"

  echo
  echo "###########################################################"
  echo "### Mastodon package upgrade: ${oldver} -> ${newver}"
  echo "###########################################################"
  echo

  _fix_ownership
  _reload_systemd

  if [ "$(vercmp "$oldver" '4.7.0-1')" -ge 0 ]; then
    echo "==> Upgrade started from Mastodon 4.7.0 or newer."
    echo "==> Production assets are already included in the package."
    echo "==> No database migration is being run automatically."
    _restart_notice
    return 0
  fi

  echo
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  echo "!!! MANUAL DATABASE MIGRATION REQUIRED                  !!!"
  echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
  echo
  echo "==> This upgrade started from a Mastodon version older than 4.7."
  echo "==> The package WILL NOT run database migrations automatically."
  echo "==> Do not blindly restart the services."
  echo
  echo "==> Recommended operator procedure:"
  echo
  echo "  1. Take a verified PostgreSQL/database backup."
  echo "  2. Run PRE-deployment migrations:"
  echo
  echo "     cd /var/lib/mastodon"
  echo "     sudo -u mastodon env RAILS_ENV=production \\"
  echo "       SKIP_POST_DEPLOYMENT_MIGRATIONS=true \\"
  echo "       bundle exec rails db:migrate"
  echo
  echo "  3. Only after PRE migrations succeed, restart Mastodon:"
  echo "     systemctl restart mastodon-web mastodon-sidekiq mastodon-streaming"
  echo
  echo "  4. Verify the application, then run POST-deployment migrations:"
  echo "     cd /var/lib/mastodon"
  echo "     sudo -u mastodon env RAILS_ENV=production \\"
  echo "       bundle exec rails db:migrate"
  echo
  _restart_notice
}

post_remove() {
  _reload_systemd
}
