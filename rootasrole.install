CONF_PATH="/etc/security/rootasrole.json"
POLICY_FOLDER="/etc/security/rootasrole.d"
POLICY_PATH="$POLICY_FOLDER/default.json"
DEFAULT_CONF_PATH="/usr/share/rootasrole/rootasrole.json"
DEFAULT_POLICY_PATH="/usr/share/rootasrole/default.json"

log() {
    echo "RootAsRole: $1" >&2
}

is_immutable_supported() {
    FS_TYPE=$(df -T "$1" 2>/dev/null | awk 'NR==2 {print $2}')
    case "$FS_TYPE" in
    ext2 | ext3 | ext4 | xfs | btrfs | ocfs2 | jfs | reiserfs)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

clear_immutable_flags() {
    chattr -i "$CONF_PATH" 2>/dev/null || true
    for file in "$POLICY_FOLDER"/*; do
        [ -e "$file" ] || continue
        chattr -i "$file" 2>/dev/null || true
    done
    chattr -i "$POLICY_FOLDER" 2>/dev/null || true
}

enable_immutable() {
    if ! grep -q '"immutable": true' "$CONF_PATH" 2>/dev/null; then
        sed -i 's/"immutable": false/"immutable": true/' "$CONF_PATH" 2>/dev/null || true
    fi
}

disable_immutable() {
    clear_immutable_flags
    sed -i 's/"immutable": true/"immutable": false/' "$CONF_PATH" 2>/dev/null || true
    sed -i 's;"CAP_LINUX_IMMUTABLE";;g' "$POLICY_PATH" 2>/dev/null || true
}

check_immutable() {
    if ! is_immutable_supported "$1"; then
        log "The file system used at $1 does not support the immutable flag."
        return 1
    fi
    if ! chattr +i "$1" >/dev/null 2>&1; then
        log "Failed to set the immutable flag on $1."
        return 1
    fi
}

flag_policy() {
    check_immutable "$CONF_PATH" || return 1
    for file in "$POLICY_FOLDER"/*; do
        [ -f "$file" ] || continue
        check_immutable "$file" || return 1
    done
    check_immutable "$POLICY_FOLDER"
}

get_invoking_user() {
    current_user=$(id -un 2>/dev/null || true)
    if [ -n "$current_user" ] && [ "$current_user" != "root" ] && [ "$current_user" != "0" ]; then
        echo "$current_user"
        return
    elif [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
        echo "$SUDO_USER"
        return
    elif [ -n "$USER" ] && [ "$USER" != "root" ]; then
        echo "$USER"
        return
    elif [ -n "$LOGNAME" ] && [ "$LOGNAME" != "root" ]; then
        echo "$LOGNAME"
        return
    elif [ -n "$USERNAME" ] && [ "$USERNAME" != "root" ]; then
        echo "$USERNAME"
        return
    fi

    # Otherwise walk the process tree upwards
    pid=$PPID
    while [ "$pid" -gt 1 ]; do
        if ps_output=$(ps -o uid=,user= -p "$pid" 2>/dev/null); then
            uid=$(echo "$ps_output" | awk '{print $1}')
            user=$(echo "$ps_output" | awk '{print $2}')
            if [ "$uid" != "0" ] && [ -n "$uid" ]; then
                if [ -n "$user" ]; then
                    echo "$user"
                else
                    echo "$uid"
                fi
                return
            fi
        fi
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || break
    done
    echo "root"
}

setadmin() {
    TARGET_PATH="$1"
    if [ -f "$TARGET_PATH" ] && grep -q '"ROOTADMINISTRATOR"' "$TARGET_PATH"; then
        ADMIN_USER=$(get_invoking_user)
        sed -i -e "s/\"ROOTADMINISTRATOR\"/\"$ADMIN_USER\"/g" "$TARGET_PATH"
        log "The user $ADMIN_USER is now the administrator."
    fi
}

# $1: previous version (empty on a fresh install)
configure() {
    old_version="$1"

    if ! mkdir -p "$(dirname "$CONF_PATH")"; then
        log "Failed to create the configuration directory."
        return 1
    fi

    if [ ! -f "$CONF_PATH" ]; then
        if ! install -m 0600 "$DEFAULT_CONF_PATH" "$CONF_PATH"; then
            log "Failed to create the default configuration file at $CONF_PATH"
            return 1
        fi
        log "Created default configuration file at $CONF_PATH"
    fi

    if ! mkdir -p "$POLICY_FOLDER"; then
        log "Failed to create the policy folder at $POLICY_FOLDER"
        return 1
    fi
    chmod 0700 "$POLICY_FOLDER" 2>/dev/null || true

    if [ ! -f "$POLICY_PATH" ]; then
        if ! install -m 0600 "$DEFAULT_POLICY_PATH" "$POLICY_PATH"; then
            log "Failed to copy the default policy to $POLICY_PATH"
            return 1
        fi
    fi
    setadmin "$POLICY_PATH"

    # Configuration must not be readable by other users
    for file in "$CONF_PATH" "$POLICY_FOLDER"/*; do
        [ -f "$file" ] || continue
        case $(stat -c %a "$file") in
        *0) ;;
        *) chmod o-rwx "$file" || log "Failed to make $file unreadable by other users" ;;
        esac
    done

    if ! command -v chattr >/dev/null 2>&1 || ! is_immutable_supported "$CONF_PATH"; then
        sed -i 's/"immutable": true/"immutable": false/' "$CONF_PATH" 2>/dev/null || true
        sed -i 's;"CAP_LINUX_IMMUTABLE";;g' "$POLICY_PATH" 2>/dev/null || true
    fi

    if [ -n "$old_version" ] && ! chsr upgrade; then
        log "chsr upgrade failed: run 'dosr chsr upgrade' manually"
    fi

    enable_immutable
    flag_policy || disable_immutable
}

ensure_caps() {
    if [ -z "$(getcap /usr/bin/dosr 2>/dev/null)" ]; then
        setcap '=p' /usr/bin/dosr 2>/dev/null || log "Failed to set capabilities on /usr/bin/dosr"
    fi
}

post_install() {
    configure ""
    ensure_caps
}

# Immutable flags must be dropped before pacman replaces files and before 'chsr upgrade'
pre_upgrade() {
    clear_immutable_flags
}

post_upgrade() {
    configure "$2"
    ensure_caps
}

pre_remove() {
    clear_immutable_flags
}

post_remove() {
    if [ -f "$CONF_PATH" ] || [ -d "$POLICY_FOLDER" ]; then
        log "Configuration kept in $CONF_PATH and $POLICY_FOLDER (remove manually to purge)."
    fi
}
