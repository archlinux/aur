+/* --prefill-interleave epoch: the sentinel and the set flag; the dump prints the name back;
+ * anything epoch-shaped but not epoch is refused. */
+TEST(prefill_interleave_takes_epoch) {
+    Config e;
+    CHECK_EQ(parse({ "--prefill-interleave", "epoch" }, &e), RAD_OK);
+    CHECK_EQ(e.prefill_interleave, Config::kPrefillInterleaveEpoch);
+    CHECK(e.prefill_interleave_set);      /* bring-up keeps it: no auto:1 default */
+    Config c;
+    CHECK_EQ(parse({ "--prefill-interleave", "epoch:2" }, &c), RAD_E_INVAL);
+    CHECK_EQ(parse({ "--prefill-interleave", "Epoch" }, &c), RAD_E_INVAL);
+    CHECK_EQ(parse({ "--prefill-interleave", "epochs" }, &c), RAD_E_INVAL);
+    bool shown = false;
+    for (const diag::ConfigRow& r : diag::config_rows(e))
+        if (r.flag == "--prefill-interleave") {
+            shown = true;
+            CHECK_EQ(r.value, std::string("epoch"));
+        }
+    CHECK(shown);
+}
