[Unit]
#After=empd.service network.target
After=network.target
Description==A distributed, fault-tolerant Jabber/XMPP server

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecReload=/usr/bin/ejabberdctl reload_config
ExecStart=/usr/bin/ejabberdctl foreground
ExecStop=/bin/sh -c '/usr/bin/ejabberdctl stop && /usr/bin/ejabberdctl stopped'
Group=jabber
LimitNOFILE=16000
NoNewPrivileges=true
NotifyAccess=all
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ejabberd /var/log/ejabberd /run/ejabberd
Restart=on-failure
RestartSec=5
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
TimeoutSec=300
Type=notify
User=jabber

[Install]
WantedBy=multi-user.target
