post_install() {
  cat <<'EOF'

deepseek-responses-proxy is installed.

1. Add the upstream DeepSeek key:

   pass insert api-keys/deepseek

   Or set DEEPSEEK_API_KEY in the service environment if you do not use pass.

2. Start the local Responses-compatible proxy:

   systemctl --user enable --now deepseek-responses-proxy.service
   systemctl --user status deepseek-responses-proxy.service

3. Add this provider to ~/.codex/config.toml:

   [model_providers.deepseek]
   name = "DeepSeek"
   base_url = "http://127.0.0.1:8787/v1"
   experimental_bearer_token = "codex-deepseek-local"
   wire_api = "responses"

   [profiles.deepseek-v4-pro]
   model_provider = "deepseek"
   model = "deepseek-v4-pro"
   model_context_window = 1000000
   approval_policy = "untrusted"
   sandbox_mode = "workspace-write"
   features = { memories = false }

   [profiles.deepseek-v4-flash]
   model_provider = "deepseek"
   model = "deepseek-v4-flash"
   model_context_window = 1000000
   approval_policy = "untrusted"
   sandbox_mode = "workspace-write"
   features = { memories = false }

4. Start Codex with a profile, not just a model name:

   codex -p deepseek-v4-pro
   codex -p deepseek-v4-flash

5. Optional: suppress Codex model metadata warnings by setting:

   model_catalog_json = "/home/you/.codex/deepseek-model-catalog.json"

   Then add catalog entries for deepseek-v4-pro and deepseek-v4-flash.
   See the project README for a full model-catalog example and agent configs.

Docs: https://github.com/holo-q/deepseek-responses-proxy

EOF
}

post_upgrade() {
  post_install
}
