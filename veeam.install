pre_install() {
    if ! getent group veeam >/dev/null; then
        groupadd --system veeam
    fi
    mkdir -p /var/log/veeam/
    mkdir -m 2775 /var/log/veeam/config
    chgrp veeam /var/log/veeam/config
}

post_install() {
    systemctl daemon-reload
    systemctl enable veeamservice.service
    systemctl restart veeamservice.service
}

post_upgrade() {
    systemctl daemon-reload
    systemctl restart veeamservice.service
}

pre_remove() {
    systemctl stop veeamservice.service
    systemctl disable veeamservice.service
    /usr/sbin/veeamservice --uninstall || true
}

post_remove() {
    rm -rf /var/lib/veeam /var/log/veeam
}
