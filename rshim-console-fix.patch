+        /*
+         * On timeout, break out to the enclosing loop so that the has_tm /
+         * tmfifo_error checks are re-evaluated; a plain timeout on an idle
+         * channel is not an error and must not fail the read.
+         */
+        if (wait_rc == ETIMEDOUT)
