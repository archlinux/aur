--- a/src/rshim.c
+++ b/src/rshim.c
@@ -1431,11 +1431,15 @@ ssize_t rshim_fifo_read(rshim_backend_t *bd, char *buffer, size_t count,
       RSHIM_DBG("rshim%d(fifo_read) waiting for readable chan %d\n",
                 bd->index, chan);
       while (read_empty(bd, chan)) {
+        int wait_rc;
+
         clock_gettime(CLOCK_REALTIME, &ts);
         ts.tv_sec += 1;
-        if (pthread_cond_timedwait(&bd->read_fifo[chan].operable,
