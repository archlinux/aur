# /etc/odysseus/odysseus.env
# Edit this file to configure Odysseus before starting the service.
# Most settings can also be changed inside the web UI under Settings.

# --- Network ---
# Bind address. Keep 127.0.0.1 unless you are behind a reverse proxy.
APP_BIND=127.0.0.1
APP_PORT=7000

# --- Auth ---
AUTH_ENABLED=true
LOCALHOST_BYPASS=false
SECURE_COOKIES=false

# --- Database ---
# Default: SQLite at /opt/odysseus/data/app.db
# To use PostgreSQL: postgresql+asyncpg://user:pass@localhost/odysseus
DATABASE_URL=sqlite:////var/lib/odysseus/app.db

# --- Vector memory (ChromaDB) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# --- Search ---
# Point to your SearXNG instance if you have one running.
# SEARXNG_INSTANCE=http://localhost:8080

# --- LLM backends ---
# LLM_HOST=localhost
# LLM_HOSTS=localhost:8000,localhost:8001
# OPENAI_API_KEY=

# --- Admin account ---
# On first boot, Odysseus creates an admin user and prints a temp password.
# Override the username here if you want.
# ODYSSEUS_ADMIN_USER=admin
