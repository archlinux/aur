[Desktop Entry]
Type=Application
Name=NetMon GUI
GenericName=Network Monitor
Comment=Modern network monitor with speed test and quota tracking
Exec=/usr/bin/netmon-gui
Icon=netmon-gui
Terminal=false
Categories=Network;System;Monitor;Qt;
StartupWMClass=netmon-gui
StartupNotify=true
X-GNOME-Autostart-enabled=true
X-GNOME-UsesNotifications=true
