post_install() {
    echo -e "\e[1;32m======================================================================\e[0m"
    echo -e " 察元AI (Chayuan) 核心文件已安装就绪！"
    echo -e ""
    echo -e " \e[1;36m[需要使用的用户，请在普通终端执行：]\e[0m"
    echo -e "   \e[1;33msystemctl --user enable --now chayuan-mcp\e[0m"
    echo -e ""
    echo -e " \e[1;36m[进行更新的用户，请在普通终端执行：]\e[0m"
    echo -e "   \e[1;33msystemctl --user daemon-reload\e[0m"
    echo -e "   \e[1;33msystemctl --user restart chayuan-mcp\e[0m"
    echo -e ""
    echo -e " 这将安全地合并 WPS 注册表，"
    echo -e " 并启动察元的 MCP 后台进程。重启 WPS 即可生效。"
    echo -e "\e[1;32m======================================================================\e[0m"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo -e "\e[1;33m======================================================================\e[0m"
    echo -e " 卸载完成。基础框架已从 /opt 移除。"
    echo -e " 各用户曾生成的变体配置及后端状态缓存仍保留在其个人目录中。"
    echo -e " 如需彻底清理个人空间，用户可自行运行: "
    echo -e "   \e[1;31msystemctl --user daemon-reload\e[0m"
    echo -e "   \e[1;31mrm -rf ~/.config/chayuan-wps\e[0m"
    echo -e "   \e[1;31mrm -rf ~/.local/share/Kingsoft/wps/jsaddons/chayuan*\e[0m"
    echo -e "\e[1;33m======================================================================\e[0m"
}
