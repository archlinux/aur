From 34d7808cebead484f5527a5dc2c1926b60e6bd5c Mon Sep 17 00:00:00 2001
From: Eugene Flanagin <eflanagin@pm.me>
Date: Sat, 24 Oct 2026 14:09:25 -0400
Subject: [PATCH] n66: 32bpp xnu-ramfb (correct colours) + Linux-host
 guest-services ABI fixes

- xnu ramfb: boot-args depth 32 / x8r8g8b8 (16bpp boot-args were drawn as
  RGB555 but displayed as r8g8b8 -> magenta text, wrong stride)
- guest-services on Linux hosts: translate Darwin<->Linux sockaddr layout
  (sa_len + 8-bit family), O_NONBLOCK/O_APPEND fcntl flags, errno values,
  init accept() addrlen, and make accepted sockets inherit O_NONBLOCK (BSD)

---
 hw/arm/guest-fds.c          | 18 ++++++++++
 hw/arm/guest-services.c     | 37 +++++++++++++++++++
 hw/arm/guest-socket.c       | 71 ++++++++++++++++++++++++++++++++++++-
 hw/display/xnu_ramfb.c      |  2 +-
 include/hw/arm/xnu_fb_cfg.h |  4 +--
 5 files changed, 128 insertions(+), 4 deletions(-)

diff --git a/hw/arm/guest-fds.c b/hw/arm/guest-fds.c
index f109443..6748e2a 100644
--- a/hw/arm/guest-fds.c
+++ b/hw/arm/guest-fds.c
@@ -54,6 +54,15 @@ int32_t qc_handle_fcntl_getfl(CPUState *cpu, int32_t fd)
     if ((retval = fcntl(guest_svcs_fds[fd], F_GETFL)) < 0) {
         guest_svcs_errno = errno;
     }
+#ifdef __linux__
+    else {
+        /* translate Linux open flags to Darwin values for the iOS guest */
+        int dflags = retval & O_ACCMODE;
+        if (retval & O_NONBLOCK) dflags |= 0x0004; /* Darwin O_NONBLOCK */
+        if (retval & O_APPEND)   dflags |= 0x0008; /* Darwin O_APPEND */
+        retval = dflags;
+    }
+#endif
 
     return retval;
 }
@@ -64,6 +73,15 @@ int32_t qc_handle_fcntl_setfl(CPUState *cpu, int32_t fd, int32_t flags)
 
     int retval = -1;
 
+#ifdef __linux__
+    {
+        /* translate Darwin open flags from the iOS guest to Linux values */
+        int hflags = 0;
+        if (flags & 0x0004) hflags |= O_NONBLOCK;
+        if (flags & 0x0008) hflags |= O_APPEND;
+        flags = hflags;
+    }
+#endif
     if ((retval = fcntl(guest_svcs_fds[fd], F_SETFL, flags)) < 0) {
         guest_svcs_errno = errno;
     }
diff --git a/hw/arm/guest-services.c b/hw/arm/guest-services.c
index 038c453..1e5d182 100644
--- a/hw/arm/guest-services.c
+++ b/hw/arm/guest-services.c
@@ -38,6 +38,39 @@
 
 int32_t guest_svcs_errno = 0;
 
+#ifdef __linux__
+/* Map Linux host errno values to Darwin values for the iOS guest. */
+static int64_t host_errno_to_darwin(int64_t e)
+{
+    switch (e) {
+    case EAGAIN:        return 35;
+    case EINPROGRESS:   return 36;
+    case EALREADY:      return 37;
+    case ENOTSOCK:      return 38;
+    case EDESTADDRREQ:  return 39;
+    case EMSGSIZE:      return 40;
+    case EPROTOTYPE:    return 41;
+    case ENOPROTOOPT:   return 42;
+    case EPROTONOSUPPORT: return 43;
+    case EOPNOTSUPP:    return 45;
+    case EAFNOSUPPORT:  return 47;
+    case EADDRINUSE:    return 48;
+    case EADDRNOTAVAIL: return 49;
+    case ENETDOWN:      return 50;
+    case ENETUNREACH:   return 51;
+    case ECONNABORTED:  return 53;
+    case ECONNRESET:    return 54;
+    case ENOBUFS:       return 55;
+    case EISCONN:       return 56;
+    case ENOTCONN:      return 57;
+    case ETIMEDOUT:     return 60;
+    case ECONNREFUSED:  return 61;
+    case EHOSTUNREACH:  return 65;
+    default:            return e; /* 1..34 are identical */
+    }
+}
+#endif
+
 uint64_t qemu_call_status(CPUARMState *env, const ARMCPRegInfo *ri)
 {
     // NOT USED FOR NOW
@@ -174,7 +207,11 @@ void qemu_call(CPUARMState *env, const ARMCPRegInfo *ri, uint64_t value)
             break;
     }
 
+#ifdef __linux__
+    qcall.error = host_errno_to_darwin(guest_svcs_errno);
+#else
     qcall.error = guest_svcs_errno;
+#endif
 
     // Write the response
     cpu_memory_rw_debug(cpu, value, (uint8_t*) &qcall, sizeof(qcall), 1);
diff --git a/hw/arm/guest-socket.c b/hw/arm/guest-socket.c
index fdf9d1e..b768b78 100644
--- a/hw/arm/guest-socket.c
+++ b/hw/arm/guest-socket.c
@@ -29,6 +29,31 @@
 
 #define SOCKET_TIMEOUT_USECS (10)
 
+/*
+ * Linux-host support (2026-10-24): the guest is iOS/Darwin, whose struct
+ * sockaddr has a leading sa_len byte and an 8-bit sa_family, while Linux uses
+ * a 16-bit sa_family. Upstream ran on macOS hosts where the layouts match.
+ * Convert between the two layouts for AF_INET addresses.
+ */
+#ifdef __linux__
+static void darwin_to_host_sockaddr(const uint8_t *g, struct sockaddr_in *h)
+{
+    memset(h, 0, sizeof(*h));
+    h->sin_family = g[1];
+    memcpy(&h->sin_port, g + 2, 2);
+    memcpy(&h->sin_addr, g + 4, 4);
+}
+
+static void host_to_darwin_sockaddr(const struct sockaddr_in *h, uint8_t *g)
+{
+    memset(g, 0, 16);
+    g[0] = 16;
+    g[1] = (uint8_t) h->sin_family;
+    memcpy(g + 2, &h->sin_port, 2);
+    memcpy(g + 4, &h->sin_addr, 4);
+}
+#endif
+
 static int32_t find_free_socket(void) {
     for (int i = 0; i < MAX_FD_COUNT; ++i) {
         if (-1 == guest_svcs_fds[i]) {
@@ -59,7 +84,7 @@ int32_t qc_handle_accept(CPUState *cpu, int32_t sckt, struct sockaddr *g_addr,
                          socklen_t *g_addrlen)
 {
     struct sockaddr_in addr;
-    socklen_t addrlen;
+    socklen_t addrlen = sizeof(addr);
 
     VERIFY_FD(sckt);
 
@@ -74,8 +99,24 @@ int32_t qc_handle_accept(CPUState *cpu, int32_t sckt, struct sockaddr *g_addr,
         retval = -1;
         guest_svcs_errno = errno;
     } else {
+#ifdef __linux__
+        /* BSD semantics: accepted sockets inherit O_NONBLOCK (Linux: no) */
+        int lflags = fcntl(guest_svcs_fds[sckt], F_GETFL);
+        if (lflags >= 0 && (lflags & O_NONBLOCK)) {
+            int nflags = fcntl(guest_svcs_fds[retval], F_GETFL);
+            if (nflags >= 0) {
+                fcntl(guest_svcs_fds[retval], F_SETFL, nflags | O_NONBLOCK);
+            }
+        }
+        uint8_t gaddr[16];
+        host_to_darwin_sockaddr(&addr, gaddr);
+        addrlen = sizeof(gaddr);
+        cpu_memory_rw_debug(cpu, (target_ulong) g_addr, gaddr,
+                            sizeof(gaddr), 1);
+#else
         cpu_memory_rw_debug(cpu, (target_ulong) g_addr, (uint8_t*) &addr,
                             sizeof(addr), 1);
+#endif
         cpu_memory_rw_debug(cpu, (target_ulong) g_addrlen,
                             (uint8_t*) &addrlen, sizeof(addrlen), 1);
     }
@@ -95,15 +136,29 @@ int32_t qc_handle_bind(CPUState *cpu, int32_t sckt, struct sockaddr *g_addr,
     if (addrlen > sizeof(addr)) {
         guest_svcs_errno = ENOMEM;
     } else {
+#ifdef __linux__
+        uint8_t gaddr[16];
+        cpu_memory_rw_debug(cpu, (target_ulong) g_addr, gaddr,
+                            sizeof(gaddr), 0);
+        darwin_to_host_sockaddr(gaddr, &addr);
+        addrlen = sizeof(addr);
+#else
         cpu_memory_rw_debug(cpu, (target_ulong) g_addr, (uint8_t*) &addr,
                             sizeof(addr), 0);
+#endif
 
         if ((retval = bind(guest_svcs_fds[sckt], (struct sockaddr *) &addr,
                            addrlen)) < 0) {
             guest_svcs_errno = errno;
         } else {
+#ifdef __linux__
+            host_to_darwin_sockaddr(&addr, gaddr);
+            cpu_memory_rw_debug(cpu, (target_ulong) g_addr, gaddr,
+                                sizeof(gaddr), 1);
+#else
             cpu_memory_rw_debug(cpu, (target_ulong) g_addr, (uint8_t*) &addr,
                                 sizeof(addr), 1);
+#endif
         }
     }
 
@@ -122,15 +177,29 @@ int32_t qc_handle_connect(CPUState *cpu, int32_t sckt, struct sockaddr *g_addr,
     if (addrlen > sizeof(addr)) {
         guest_svcs_errno = ENOMEM;
     } else {
+#ifdef __linux__
+        uint8_t gaddr[16];
+        cpu_memory_rw_debug(cpu, (target_ulong) g_addr, gaddr,
+                            sizeof(gaddr), 0);
+        darwin_to_host_sockaddr(gaddr, &addr);
+        addrlen = sizeof(addr);
+#else
         cpu_memory_rw_debug(cpu, (target_ulong) g_addr, (uint8_t*) &addr,
                             sizeof(addr), 0);
+#endif
 
         if ((retval = connect(guest_svcs_fds[sckt], (struct sockaddr *) &addr,
                             addrlen)) < 0) {
             guest_svcs_errno = errno;
         } else {
+#ifdef __linux__
+            host_to_darwin_sockaddr(&addr, gaddr);
+            cpu_memory_rw_debug(cpu, (target_ulong) g_addr, gaddr,
+                                sizeof(gaddr), 1);
+#else
             cpu_memory_rw_debug(cpu, (target_ulong) g_addr, (uint8_t*) &addr,
                                 sizeof(addr), 1);
+#endif
         }
     }
 
diff --git a/hw/display/xnu_ramfb.c b/hw/display/xnu_ramfb.c
index a4ebdfb..0f9c6fe 100644
