[Unit]
Description=honk transparent proxy engine
Documentation=https://github.com/daeuniverse/honk
Wants=network-online.target
After=network-online.target docker.service systemd-sysctl.service
# dae attaches to the same interfaces, so starting one stops the other.
Conflicts=dae.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=notify
User=root
WorkingDirectory=/var/lib/honk
StateDirectory=honk
StateDirectoryMode=0700
# Without nfnetlink_queue loaded, startup disables NFQUEUE until the next restart.
ExecStartPre=-/usr/bin/modprobe -a nfnetlink_queue nft_ct nft_queue
ExecStart=/usr/bin/honk-core --config /etc/honk/config.dae --disable-timestamp
ExecReload=/usr/bin/honk-core reload
Restart=on-failure
RestartSec=2s
TimeoutStartSec=120
TimeoutStopSec=30s
LimitNPROC=4096
LimitNOFILE=1048576
LimitMEMLOCK=infinity
OOMScoreAdjust=-100
UMask=0077

[Install]
WantedBy=multi-user.target
