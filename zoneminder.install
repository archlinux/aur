post_install() {
    echo
    echo
    echo " ZoneMinder has been installed but some additional actions are required:"
    echo
    echo " 1) You will need to setup a MySQL-compatible database server."
    echo
    echo " 2) You will need to setup a web server and configure it to serve ZoneMinder's web interface, located at '/usr/share/webapps/zoneminder/'."
    echo
    echo "    Example configuration files are provided for Apache and Nginx; you can find them at '/usr/share/zoneminder/conf/'."
    echo
    echo " 3) If using Nginx, you will need to install 'fcgiwrap', 'spawn-fcgi' and 'multiwatch' and start the 'fcgiwrap-multiwatch' systemd service."
    echo
    echo " 4) After the previous steps have been completed, you will need to refresh systemd's tmpfiles."
    echo
    echo
    echo " More information on how to setup and use ZoneMinder can be obtained at the following links:"
    echo
    echo " * https://zoneminder.readthedocs.io/"
    echo " * https://wiki.archlinux.org/title/ZoneMinder"
    echo
    echo
}

post_upgrade() {
    echo
    echo
    echo " ZoneMinder's database needs to be updated. As the root user, run the following commands:"
    echo
    echo " /usr/bin/zmupdate.pl"
    echo " /usr/bin/zmupdate.pl --freshen"
    echo " /usr/bin/zmcamtool.pl --import"
    echo
    echo
}

post_remove() {
    echo
    echo
    echo " ZoneMinder's database has been left intact. You can delete it by running the following commands:"
    echo
    echo " mysql -u root -p -e \"drop database zm;\""
    echo " mysql -u root -p -e \"drop user 'zmuser'@localhost;\""
    echo
    echo " If you haven't configured a password for the database server's root user, omit the '-p' option."
    echo
    echo
}
