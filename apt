#!/bin/bash

# --- APT-Fake v1.7 (Gabriele Edition) ---
G_PURPLE='\033[1;35m'
G_CYAN='\033[1;36m'
G_GREEN='\033[1;32m'
G_RED='\033[1;31m'
NC='\033[0m'

# Function: Zenity GUI (The 1.6 Feature)
show_gui() {
    zenity --info \
        --title="APT-Fake Ubuntu v1.7" \
        --text="Welcome Gabriele!\n\nSystem: Arch Linux\nStatus: Optimized\n\nThis tool bridges the gap between Ubuntu commands and Arch power." \
        --icon-name="apt-fake" \
        --width=350
}

# Fix 1.7: Handle empty arguments or GUI call
if [[ -z "$1" || "$1" == "gui" ]]; then
    show_gui
    [[ "$1" == "gui" ]] && exit 0
    echo -e "${G_PURPLE}Usage: apt [install|update|upgrade|remove|search|gui]${NC}"
    exit 0
fi

case "$1" in
    install)
        shift
        # Fix 1.7: Improved package string handling
        packages=${*//-y/}
        echo -e "${G_CYAN}::${NC} Searching official repositories..."
        if sudo pacman -S --needed $packages; then
            echo -e "${G_GREEN}::${NC} Installation complete."
        else
            echo -e "${G_CYAN}::${NC} Not found. Engaging ${G_PURPLE}G-HELPER${NC}..."
            g-helper $packages
        fi
        ;;
    update)
        sudo pacman -Sy ;;
    upgrade)
        sudo pacman -Syu ;;
    remove)
        shift
        sudo pacman -Rs $@ ;;
    search)
        shift
        pacman -Ss $@ ;;
    *)
        echo -e "${G_RED}Error:${NC} Command '$1' not found." ;;
esac
