#!/bin/bash
# --- APT-Fake v2.0 (Gabriele Edition) ---
G_BLUE='\033[1;34m'; G_CYAN='\033[1;36m'; G_GREEN='\033[1;32m'; G_RED='\033[1;31m'; NC='\033[0m'
LOG_FILE="$HOME/.apt-fake-history"

if [[ -z "$1" ]]; then
    echo -e "${G_BLUE}APT-Fake v2.0${NC} - Gabriele's Package Manager Bridge"
    echo "Usage: apt [install|update|upgrade|search|history|clean]"
    exit 0
fi

case "$1" in
    update)
        (echo "50" ; echo "# Syncing Repos..." ; sudo pacman -Sy --noconfirm > /dev/null ; echo "100") | \
        zenity --progress --title="APT Update" --auto-close --width=300
        echo "$(date) - System Database Updated" >> "$LOG_FILE" ;;
    install)
        shift; sudo pacman -S --needed $@ || g-helper $@
        echo "$(date) - Installed: $@" >> "$LOG_FILE" ;;
    upgrade)
        sudo pacman -Syu ;;
    search)
        shift; echo -e "${G_CYAN}:: Official:${NC}"; pacman -Ss $@
        echo -e "${G_PURPLE}:: AUR Search Active...${NC}"; g-helper search $@ ;;
    history)
        cat "$LOG_FILE" 2>/dev/null || echo "No history yet." ;;
    clean)
        sudo pacman -Rns $(pacman -Qdtq) ;;
    *)
        sudo pacman $@ ;;
esac
