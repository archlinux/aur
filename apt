#!/bin/bash

# --- GabrieleArch Colors ---
G_PURPLE='\033[1;35m'
G_CYAN='\033[1;36m'
G_GREEN='\033[1;32m'
G_RED='\033[1;31m'
NC='\033[0m'

# Check if command is provided
if [ -z "$1" ]; then
    echo -e "${G_PURPLE}APT-Fake Ubuntu v1.5${NC}"
    echo "Usage: apt [install|update|upgrade|remove|search]"
    exit 1
fi

case "$1" in
    install)
        shift
        # Clean Ubuntu-specific flags (e.g., -y) for pacman
        packages=${*//-y/}
        
        echo -e "${G_CYAN}::${NC} Searching in Arch Linux official repositories..."
        if sudo pacman -S --needed $packages; then
            echo -e "${G_GREEN}::${NC} Installation successful."
        else
            echo -e "${G_CYAN}::${NC} Package not found. Launching ${G_PURPLE}G-HELPER${NC}..."
            
            # Switch to g-helper
            if command -v g-helper &> /dev/null; then
                g-helper $packages
            else
                echo -e "${G_RED}Error:${NC} g-helper is not installed. Please install it from AUR."
            fi
        fi
        ;;

    update)
        echo -e "${G_CYAN}::${NC} Synchronizing package databases..."
        sudo pacman -Sy
        ;;

    upgrade|dist-upgrade)
        echo -e "${G_CYAN}::${NC} Starting full system upgrade..."
        sudo pacman -Syu
        ;;

    remove|purge)
        shift
        echo -e "${G_CYAN}::${NC} Removing package(s)..."
        sudo pacman -Rs $@
        ;;

    search)
        shift
        echo -e "${G_CYAN}::${NC} Searching for: $@"
        pacman -Ss $@
        ;;

    *)
        echo -e "${G_RED}Error:${NC} Command '$1' not recognized."
        ;;
esac
