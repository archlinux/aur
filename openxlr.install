post_install() {
  udevadm control --reload || true
  cat <<'MSG'
==> OpenXLR: replug your interface once so the udev rule applies.
==> Start the daemon:  systemctl --user enable --now openxlr-daemon
==> Start the mixer:   openxlr   (or from your application menu)
==> Stream Deck via OpenDeck:
==>   cp -r /usr/share/openxlr/com.emaspa.openxlr.sdPlugin ~/.config/opendeck/plugins/
MSG
}
post_upgrade() {
  udevadm control --reload || true
  if (( $(vercmp "$2" 0.1.9) < 0 )); then
    cat <<'MSG'
==> OpenXLR: before 0.1.9, "Start daemon at login" in Options wrote a broken
==> ~/.config/systemd/user/openxlr-daemon.service that shadows the packaged
==> unit and fails after a reboot. Opening the mixer once repairs it; or by hand:
==>   rm ~/.config/systemd/user/openxlr-daemon.service
==>   systemctl --user daemon-reload && systemctl --user enable --now openxlr-daemon
MSG
  fi
}
