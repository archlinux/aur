post_install() {
  cat <<'MSG'
hermes-agent uses system ffmpeg/nodejs/ripgrep (pacman) and sets
HERMES_DISABLE_LAZY_INSTALLS=1. If `hermes --tui` warns that those tools are
"not installed or outdated", remove a leftover PM store from an older source
install, e.g. ~/.hermes/tools/facts.json — then retry.
MSG
}

post_upgrade() {
  post_install
}
