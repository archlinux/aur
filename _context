#compdef context
# Generated by context completions zsh. Do not edit by hand.

local -a context_commands
context_commands=(
  'git:Show branch context for the current repository'
  'stack:Detect the tech stack of a directory for agents'
  'mcp:Run the context MCP server over stdio'
  'completions:Generate shell completions'
  'help:Show context help'
)

if (( CURRENT == 2 )); then
  _describe -t commands 'context command' context_commands
  return
fi

local command=${words[2]}
case $command in
  git)
    _arguments -S \
      '--json[Emit the structured plugin payload instead of text]' \
      '--comments[Include pull request conversation comments]' \
      '--reviews[Include individual pull request reviews]' \
      '--labels[Include pull request labels]' \
      '--checks[Include CI check runs (makes a second gh call)]' \
      '--no-description[Omit the pull request description]' \
      '--no-pr[Omit the pull request block entirely]' \
      '--remotes[Include remote fetch/push URLs in branch metadata]' \
      '--no-branch-metadata[Omit the branch metadata block]' \
      '--no-status[Omit the working-tree status block]' \
      '--no-work-scope[Omit the branch work-scope block]' \
      '--diff[Append full unstaged and staged diffs for changed files]' \
      '--branch-diff[Append the merge-base diff vs the default branch]' \
      '--since[Show recent commits since this date or relative duration]:date:' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  stack)
    _arguments -S \
      '--json[Emit the structured plugin payload instead of text]' \
      '--plain[Disable ANSI styling in text output]' \
      '{-h,--help}[Show this help message]' \
      '1:Directory to scan (default: current working directory):_files' \
      '*::arg:->args'
    ;;
  mcp)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  completions)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '1:shell:(bash fish zsh)' \
      '*::arg:->args'
    ;;
  help)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '1:Optional command to show help for:(git stack mcp completions)' \
      '*::arg:->args'
    ;;
esac
