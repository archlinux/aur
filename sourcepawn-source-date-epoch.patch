+/*  ParseInt64
+ *
+ *  Parse a decimal integer that makes up all of "str", without overflow.
+ */
+std::optional<int64_t>
+ParseInt64(const char* str)
+{
+    char* endptr;
+    errno = 0;
+    int64_t value = std::strtoll(str, &endptr, 10);
+    if (errno == ERANGE || endptr == str || *endptr != '\0')
+        return {};
+    return value;
+}
