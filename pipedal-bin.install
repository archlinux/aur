post_install() {
  echo ":: PiPedal ${pkgver} installed."
  echo "::"
  echo ":: The package only installs files. Nothing has been started,"
  echo ":: enabled, or configured on this system."
  echo "::"
  echo ":: Upstream's setup step is:  sudo pipedalconfig --install"
  echo ":: (use '--port 8080' to serve on a high port and skip the"
  echo "::  authbind requirement)"
  echo ":: WARNING: that step is designed for a dedicated PiPedal"
  echo ":: machine. It will:"
  echo "::   - enable and start pipedald + pipedaladmind services"
  echo "::   - edit /etc/default/grub and regenerate grub.cfg"
  echo "::     (adds preempt=voluntary to the kernel cmdline)"
  echo "::   - create the pipedal_d user, /var/pipedal, realtime"
  echo "::     limits (rtprio 95), and network tweaks"
  echo ":: Run it only if you intend this machine to be a dedicated"
  echo ":: PiPedal device."
  echo "::"
  echo ":: Manual service setup (no boot config changes):"
  echo "::   sudo systemctl enable --now pipedald"
  echo "::   sudo systemctl enable --now pipedaladmind"
  echo "::"
  echo ":: See https://rerdavies.github.io/pipedal/ for documentation."
}

post_upgrade() {
  post_install
}

pre_remove() {
  # Clean up only if the user actually ran `pipedalconfig --install`
  # (its generated units are not owned by this package). User presets
  # and configuration under /var/pipedal are preserved either way.
  if [ -f /usr/lib/systemd/system/pipedald.service ]; then
    /usr/bin/pipedalconfig --uninstall >/dev/null 2>&1 || true
    echo ":: Removed services generated by 'pipedalconfig --install'."
    echo ":: User data under /var/pipedal was preserved."
  fi
}

post_remove() {
  true
}
