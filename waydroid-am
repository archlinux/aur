#!/bin/bash
# waydroid-am - set up Waydroid for Apple Music and sideload the app.
#
# Apple Music refuses to run on a device it detects as rooted, and only serves
# Lossless over Wi-Fi. Waydroid's bridged network reports as Ethernet, so the
# image's per-app Wi-Fi spoof has to be switched on explicitly.

set -uo pipefail

PKGDATA=/usr/share/waydroid-apple-music/apk
AM_PKG=com.apple.android.music
PROP=/var/lib/waydroid/waydroid_base.prop

# Properties Apple Music needs. The first seven defeat root detection; the last
# enables the image's per-app Wi-Fi spoof so Lossless is offered at all.
read -r -d '' PROPS <<'EOP'
ro.adb.secure=1
ro.debuggable=0
ro.build.selinux=1
ro.build.tags=release-keys
ro.product.build.tags=release-keys
ro.vendor.build.tags=release-keys
ro.odm.build.tags=release-keys
persist.waydroid.fake_wifi=com.apple.android.music
EOP

die()  { echo "error: $*" >&2; exit 1; }
info() { echo ":: $*"; }
need_root() { [ "$EUID" -eq 0 ] || die "'$1' needs root; re-run with sudo"; }

# Resolve the host path that maps to the container's /data/local/tmp.
container_tmp() {
    local u h
    u="${SUDO_USER:-$USER}"
    h=$(getent passwd "$u" | cut -d: -f6)
    for p in "$h/.local/share/waydroid/data/local/tmp" /var/lib/waydroid/data/local/tmp; do
        [ -d "$(dirname "$p")" ] && { echo "$p"; return 0; }
    done
    return 1
}

cmd_setup_quiet() { _apply_props; }

_apply_props() {
    [ -f "$PROP" ] || die "$PROP not found - run 'sudo waydroid init' first"

    # Idempotent: strip any previous copies before appending.
    local keys
    keys=$(printf '%s\n' "$PROPS" | cut -d= -f1)
    while read -r k; do
        [ -n "$k" ] && sed -i "\|^${k}=|d" "$PROP"
    done <<< "$keys"
    printf '%s\n' "$PROPS" >> "$PROP"

    info "applied $(printf '%s\n' "$PROPS" | grep -c .) properties to $PROP"
    grep -E '^(ro\.build\.tags|persist\.waydroid\.fake_wifi)=' "$PROP" | sed 's/^/   /'
    echo
}

cmd_setup() {
    need_root setup
    _apply_props
    info "restart the container for these to take effect:"
    echo "   sudo systemctl restart waydroid-container && waydroid session start"
}

# Block until the package manager inside the container answers.
wait_pm() {
    local n=0
    while [ $n -lt 120 ]; do
        waydroid shell -- pm list packages >/dev/null 2>&1 && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}

cmd_install() {
    need_root install

    local if_missing=0
    if [ "${1:-}" = "--if-missing" ]; then if_missing=1; shift; fi

    if [ "$if_missing" -eq 1 ]; then
        # Invoked from the systemd unit as the container starts.
        wait_pm || { info "container never became ready; skipping"; exit 0; }
        if waydroid shell -- pm list packages 2>/dev/null | grep -q "$AM_PKG"; then
            info "$AM_PKG already installed"; exit 0
        fi
        info "$AM_PKG missing - installing now"
    else
        waydroid status 2>/dev/null | grep -q RUNNING || \
            die "container is not running; start it with 'sudo systemctl start waydroid-container'"
    fi

    local tmp src apks=()
    tmp=$(container_tmp) || die "cannot locate the container's /data/local/tmp"
    mkdir -p "$tmp"

    src="${1:-}"
    if [ -z "$src" ]; then
        [ -d "$PKGDATA" ] || die "no APK supplied and $PKGDATA is missing"
        mapfile -t apks < <(find "$PKGDATA" -name '*.apk' | sort)
    elif [ -d "$src" ]; then
        mapfile -t apks < <(find "$src" -maxdepth 1 -name '*.apk' | sort)
    elif [[ "$src" == *.apkm || "$src" == *.xapk || "$src" == *.zip ]]; then
        local ex; ex=$(mktemp -d)
        info "extracting $(basename "$src")"
        unzip -o -q "$src" -d "$ex" || die "could not extract $src"
        for f in base.apk split_config.x86_64.apk split_config.xxhdpi.apk; do
            [ -f "$ex/$f" ] && apks+=("$ex/$f")
        done
        [ ${#apks[@]} -gt 0 ] || die "bundle contained no base.apk / x86_64 split"
    elif [[ "$src" == *.apk ]]; then
        apks=("$src")
    else
        die "unrecognised input: $src"
    fi

    [ ${#apks[@]} -gt 0 ] || die "nothing to install"
    info "installing ${#apks[@]} APK(s)"

    # adb reports "offline" because ro.adb.secure=1 is set above, so go through
    # pm inside the container instead.
    local total=0 sz
    for a in "${apks[@]}"; do
        sz=$(stat -c%s "$a"); total=$((total + sz))
        cp -f "$a" "$tmp/$(basename "$a")"; chmod 644 "$tmp/$(basename "$a")"
    done

    local sid
    sid=$(waydroid shell -- pm install-create -r -S "$total" 2>&1 | grep -oP '(?<=\[)\d+(?=\])')
    [ -n "$sid" ] || die "could not create an install session"
    info "session $sid ($total bytes)"

    for a in "${apks[@]}"; do
        local b; b=$(basename "$a"); sz=$(stat -c%s "$a")
        echo "   -> $b"
        waydroid shell -- pm install-write -S "$sz" "$sid" "${b%.apk}" \
            "/data/local/tmp/$b" < /dev/null >/dev/null || die "write failed for $b"
    done

    waydroid shell -- pm install-commit "$sid" || die "commit failed"
    rm -f "$tmp"/base.apk "$tmp"/split_config.*.apk

    echo
    waydroid shell -- pm list packages 2>/dev/null | grep -q "$AM_PKG" \
        && info "installed: $AM_PKG" || die "install reported success but package is absent"
    cmd_uid
}

cmd_uid() {
    need_root uid
    local uid tmp
    uid=$(waydroid shell -- dumpsys package "$AM_PKG" 2>/dev/null \
          | grep -m1 -oP '(?<=userId=)\d+')
    [ -n "$uid" ] || die "could not read the UID for $AM_PKG (is it installed?)"
    tmp=$(container_tmp) || die "cannot locate the container's /data/local/tmp"
    echo "$uid" > "$tmp/apple_music_uid.txt"
    chmod 644 "$tmp/apple_music_uid.txt"
    info "Apple Music UID $uid -> $tmp/apple_music_uid.txt"
}

OVERLAY=/var/lib/waydroid/overlay
SYSAPP="$OVERLAY/system/app/AppleMusic"

# Pre-install Apple Music by dropping it into the container's /system/app.
# Android's PackageManager scans that directory at boot and installs whatever
# it finds, so this needs no running container and no pm call.
cmd_stage() {
    need_root stage
    [ -d "$PKGDATA" ] || die "$PKGDATA missing - reinstall the package"
    [ -d /var/lib/waydroid ] || die "/var/lib/waydroid missing - run 'sudo waydroid init' first"

    local n
    n=$(find "$PKGDATA" -name '*.apk' | wc -l)
    [ "$n" -gt 0 ] || die "no APKs in $PKGDATA"

    rm -rf "$SYSAPP"
    install -dm755 "$SYSAPP"
    # A cluster install: the base plus its splits, side by side. PackageManager
    # identifies the base as the apk with no split name.
    install -m644 "$PKGDATA"/*.apk -t "$SYSAPP/"
    chmod 755 "$SYSAPP"

    info "staged $n APK(s) into $SYSAPP"
    info "Android will install them on the next container boot"
    find "$SYSAPP" -name '*.apk' -printf '   %f\n'
}

cmd_unstage() {
    need_root unstage
    rm -rf "$SYSAPP"
    info "removed $SYSAPP (Android drops the system copy on next boot)"
}

cmd_status() {
    echo "container    : $(systemctl is-active waydroid-container.service 2>/dev/null)"
    echo "session      : $(waydroid status 2>/dev/null | awk -F'\t' '/Session/{print $2}')"
    printf 'properties   : '
    if [ -f "$PROP" ]; then
        local n; n=$(grep -cE '^(ro\.adb\.secure|ro\.debuggable|ro\.build\.selinux|ro\.build\.tags|ro\.product\.build\.tags|ro\.vendor\.build\.tags|ro\.odm\.build\.tags|persist\.waydroid\.fake_wifi)=' "$PROP")
        [ "$n" -eq 8 ] && echo "all 8 applied" || echo "$n/8 applied - run 'sudo waydroid-am setup'"
    else echo "not initialised"; fi
    printf 'staged       : '
    [ -d "$SYSAPP" ] && echo "yes ($(find "$SYSAPP" -name '*.apk' | wc -l) apk)" || echo "no"
    printf 'apple music  : '
    waydroid shell -- pm list packages 2>/dev/null | grep -q "$AM_PKG" \
        && echo "installed" || echo "not installed"
    printf 'DAC now      : '
    local hw
    hw=$(cat /proc/asound/card*/pcm0p/sub0/hw_params 2>/dev/null | awk -F': ' '/^format|^rate/{printf "%s ",$2}')
    echo "${hw:-idle}"
}

# Wait for the container to finish booting (Android takes a moment).
wait_ready() {
    local n=0
    while [ $n -lt 60 ]; do
        waydroid status 2>/dev/null | grep -q "Session:.*RUNNING" && return 0
        sleep 1; n=$((n+1))
    done
    return 1
}

ensure_running() {
    if ! systemctl is-active --quiet waydroid-container.service; then
        info "starting container"
        # systemctl prompts through polkit when not run as root, so the
        # container stays on-demand without needing a boot-time unit.
        systemctl start waydroid-container.service || die "could not start the container"
    fi
    if ! waydroid status 2>/dev/null | grep -q "Session:.*RUNNING"; then
        info "starting session"
        local u; u="${SUDO_USER:-$USER}"
        if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
            sudo -u "$u" XDG_RUNTIME_DIR="/run/user/$(id -u "$u")" \
                nohup waydroid session start >/dev/null 2>&1 &
        else
            nohup waydroid session start >/dev/null 2>&1 &
        fi
        wait_ready || die "session did not come up within 60s"
    fi
}

cmd_bootstrap() {
    need_root bootstrap
    info "bootstrapping Apple Music on Waydroid"

    if [ ! -f "$PROP" ]; then
        info "running waydroid init (first time)"
        waydroid init || die "waydroid init failed"
    else
        info "already initialised - leaving existing setup alone"
    fi

    cmd_setup_quiet
    cmd_stage

    echo
    info "done. Start the container and Apple Music installs itself:"
    info "   sudo systemctl start waydroid-container"
}

cmd_launch() {
    [ "$EUID" -eq 0 ] && die "run 'launch' as your normal user, not root"
    ensure_running
    waydroid shell -- pm list packages 2>/dev/null | grep -q "$AM_PKG" \
        || die "Apple Music is not installed - run 'sudo waydroid-am bootstrap'"
    info "launching Apple Music"
    waydroid app launch "$AM_PKG"
}

cmd_stop() {
    waydroid session stop >/dev/null 2>&1
    systemctl stop waydroid-container.service
    info "stopped"
}

usage() {
    cat <<EOU
waydroid-am - Apple Music on Waydroid

  sudo waydroid-am bootstrap        do everything: properties + stage the app
  sudo waydroid-am stage            pre-install into the container's /system/app
  sudo waydroid-am unstage          remove that pre-installed copy
       waydroid-am launch           start the container and open Apple Music
       waydroid-am stop             shut the container down
  sudo waydroid-am setup            apply the properties Apple Music requires
  sudo waydroid-am install [SRC]    sideload Apple Music (SRC: .apkm/.xapk/.apk/dir)
                                    defaults to the APKs shipped with the package
  sudo waydroid-am uid              refresh the stored Apple Music UID
       waydroid-am status           show current state

First run:
  sudo waydroid-am bootstrap        <- that is all
  waydroid-am launch
EOU
}

case "${1:-}" in
    bootstrap) cmd_bootstrap ;;
    stage)   cmd_stage ;;
    unstage) cmd_unstage ;;
    launch)  cmd_launch ;;
    stop)    cmd_stop ;;
    setup)   cmd_setup ;;
    install) shift; cmd_install "${1:-}" ;;
    uid)     cmd_uid ;;
    status)  cmd_status ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command: $1 (try --help)" ;;
esac
