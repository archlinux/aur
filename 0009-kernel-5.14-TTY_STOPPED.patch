+++ b/ptyx/ptyc.c	2026-11-04 23:13:38.750143282 -0500
@@ -104,15 +104,11 @@ static int ptyx_ctrl_write_room(struct t
 	if (!tty || !tty->driver_data)		// paranoia
 		return 0;
 
 	ptyx_info = (struct ptyx_struct *) tty->driver_data;
 
-#if (LINUX_VERSION_CODE >= KERNEL_VERSION(5,14,0))
-	if (!tty || tty->flow.stopped || (ptyx_info->flags & SLAVE_CLOSING) )
-#else
 	if (!tty || tty->TTY_STOPPED || (ptyx_info->flags & SLAVE_CLOSING) )
-#endif
 		return 0;
 
 	return RECEIVE_ROOM(tty);
 }
 
