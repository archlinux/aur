[Desktop Entry]
Version=1.0
Type=Application
Name=kitty Album
GenericName=Image Viewer
Comment=Minimal kitten to sift through images intuitively
Exec=kitty --title Album kitty_album.py %F
Icon=kitty
Categories=Graphics;X-Multimedia;
Terminal=false
MimeType=image/bmp;image/jpeg;image/png;image/gif;image/tiff;image/webp;image/svg+xml;