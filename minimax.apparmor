# AppArmor profile for MiniMax AI Agent
# Location: /etc/apparmor.d/minimax
#
# To enable:
#   sudo cp minimax.apparmor /etc/apparmor.d/minimax
#   sudo apparmor_parser -r /etc/apparmor.d/minimax
#
# To enforce:
#   sudo aa-enforce /etc/apparmor.d/minimax

#include <tunables/global>

/opt/minimax/minimax {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/fonts>
  #include <abstractions/X>
  #include <abstractions/freedesktop.org>
  #include <abstractions/user-tmp>
  #include <abstractions/audio>
  #include <abstractions/dbus-session-strict>
  #include <abstractions/dbus-accessibility-strict>

  # MiniMax installation directory (read-only)
  /opt/minimax/** r,
  /opt/minimax/minimax ix,
  /opt/minimax/chrome-sandbox cx -> chrome_sandbox,

  # User data directories
  owner @{HOME}/.config/minimax/** rwk,
  owner @{HOME}/.cache/minimax/** rwk,
  owner @{HOME}/.local/share/minimax/** rwk,

  # System libraries and resources
  /usr/lib/** rm,
  /usr/share/** r,
  /etc/fonts/** r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,

  # Proc and sys access
  @{PROC}/sys/kernel/random/uuid r,
  @{PROC}/sys/fs/inotify/max_user_watches r,
  @{PROC}/@{pid}/fd/ r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/@{pid}/task/*/stat r,
  /sys/devices/system/cpu/** r,

  # Network access (required for web app)
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  # IPC and shared memory
  /dev/shm/** rw,
  owner /run/user/*/minimax-* rw,

  # Deny access to sensitive system files
  deny /boot/** rw,
  deny /sys/firmware/** rw,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /root/** rw,

  # Chrome sandbox child profile
  profile chrome_sandbox {
    #include <abstractions/base>

    capability sys_admin,
    capability sys_chroot,
    capability setuid,
    capability setgid,

    /opt/minimax/chrome-sandbox mr,
    /opt/minimax/** r,

    # Namespace operations
    @{PROC}/@{pid}/setgroups w,
    @{PROC}/@{pid}/uid_map w,
    @{PROC}/@{pid}/gid_map w,

    owner /dev/shm/** rw,
    /dev/null rw,
  }
}
