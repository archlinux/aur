#!/usr/bin/env bash
set -euo pipefail

run() {
  local seconds=$1
  shift
  printf '==> %s\n' "$*"
  timeout --signal=TERM --kill-after=2 "$seconds" "$@"
}

run 20 terakan-vulkan vulkaninfo --summary

if command -v vkcube >/dev/null; then
  run 10 terakan-vulkan vkcube --validate=false
else
  echo "SKIP: vkcube is not installed"
fi
