	printf '\n\033[1;33m[Gaze Notice]\033[0m %s has no auth line, so pam_gaze.so was not added.\n' "$pam_file" >&2
	printf 'Add "auth        sufficient    pam_gaze.so" to it by hand, then restart polkit.\n' >&2
