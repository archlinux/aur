post_install() {
    echo "==> To activate plasma-minimal-osd immediately in your current session:"
    echo "==>   systemctl --user set-environment QML2_IMPORT_PATH=\"/usr/lib/plasma-minimal-osd/qt6/qml:\${QML2_IMPORT_PATH}\""
    echo "==>   systemctl --user restart plasma-plasmashell.service"
    echo "==> (Or simply log out and log back in)"
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "==> Default KDE Plasma OSD will be restored on next login."
    echo "==> Or revert immediately: systemctl --user unset-environment QML2_IMPORT_PATH && systemctl --user restart plasma-plasmashell.service"
}
