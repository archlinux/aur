+#include <config.h>
+#include "Utils.h"
+
+void trimNewline(std::string *s) {
+  if (s->empty())
+  {
+      return;
+  }
+  if (s->back() == '\n') 
+  {
+      s->pop_back();
+  }
+  if (s->back() == '\r') 
+  {
+      s->pop_back();
+  }
+}

