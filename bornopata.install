post_install() {
  echo '==> Bornopata: run this once as your own user, not as root:'
  echo '      bornopata-setup'
  echo '    It starts the input method server, adds Bornopata to Fcitx5 and restarts Fcitx5.'
  echo '    Settings: search for "Bornopata Settings" in your application launcher.'
}

post_upgrade() {
  echo '==> Bornopata: run bornopata-setup to use the new version (it restarts the server and Fcitx5).'
}
