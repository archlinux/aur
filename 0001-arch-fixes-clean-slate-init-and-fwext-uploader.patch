new file mode 100644
index 0000000..2a7d930
--- /dev/null
+++ b/src/bin/synaptics009a-upload-fwext.rs
@@ -0,0 +1,134 @@
+//! Upload a Synaptics `.xpfwext` firmware extension to the `06cb:009a` sensor's
+//! flash partition 2, or check whether one is already loaded.
+//!
+//! `--check` only reports — exit 0 if the extension is present, 3 if absent —
+//! and never writes flash. The default uploads, skipping when one is already
+//! present; `--force` rewrites it.
+
+use std::path::PathBuf;
+use t480s_fingerprint_v2::{DriverError, SensorSession, SynapticsUsbTransport};
+
+/// Exit status of `--check` when no extension is loaded.
+const EXIT_NOT_PRESENT: i32 = 3;
+
+const HELP: &str = "\
+Usage: synaptics009a-upload-fwext [--check] [--force] [FILE.xpfwext]
+
+Stop fprintd first. Writes the Synaptics firmware extension to sensor flash
+partition 2 only (not the TLS pairing, calibration, or template partitions).
+Reboots the sensor at the end; the USB device will disconnect and re-enumerate.
+
+  --check   report whether an extension is loaded; write nothing
+            (exit 0 = present, 3 = absent)
+  --force   rewrite even if an extension is already present";
+
+enum Action {
+    Check,
+    Upload { path: PathBuf, force: bool },
+}
+
+fn parse_args() -> Result<Action, Box<dyn std::error::Error>> {
+    let mut check = false;
+    let mut force = false;
+    let mut files: Vec<PathBuf> = Vec::new();
+
+    for arg in std::env::args_os().skip(1) {
+        match arg.to_str() {
+            Some("-h" | "--help") => {
+                println!("{HELP}");
+                std::process::exit(0);
+            }
+            Some("--check") => check = true,
+            Some("--force") => force = true,
+            Some(s) if s.starts_with("--") => {
+                return Err(format!("Unknown option {s}; see --help").into());
+            }
+            _ => files.push(PathBuf::from(arg)),
+        }
+    }
+
+    if check {
+        if !files.is_empty() {
+            return Err("--check takes no file argument".into());
+        }
+        return Ok(Action::Check);
+    }
+    match files.len() {
+        1 => Ok(Action::Upload {
+            path: files.remove(0),
+            force,
+        }),
+        0 => Err("Expected a FILE.xpfwext argument; see --help".into()),
+        _ => Err("Expected exactly one FILE.xpfwext argument; see --help".into()),
+    }
+}
+
+/// Open the sensor, run the pre-TLS init and establish the TLS session.
+fn open_session() -> Result<SensorSession<SynapticsUsbTransport>, Box<dyn std::error::Error>> {
+    let mut session = SensorSession::new(SynapticsUsbTransport::open()?);
+    let version = session.initialize_metallica()?;
+    if version.product != 0x30 {
+        return Err(Box::new(DriverError::Protocol(
+            "Expected Metallica product 0x30".into(),
+        )));
+    }
+    let bundle = session.read_tls_flash_bundle()?;
+    session.establish_tls_session(&bundle)?;
+    Ok(session)
+}
+
+fn run() -> Result<i32, Box<dyn std::error::Error>> {
+    let action = parse_args()?;
+
+    // Read the image before touching the sensor so a bad path fails fast.
+    let file = match &action {
+        Action::Upload { path, .. } => Some(std::fs::read(path)?),
+        Action::Check => None,
+    };
+
+    let mut session = open_session()?;
+    let present = session.fwext_present()?;
+
+    match &action {
+        Action::Check => {
+            println!(
+                "firmware extension: {}",
+                if present { "present" } else { "ABSENT" }
+            );
+            let _ = session.reboot_sensor();
+            Ok(if present { 0 } else { EXIT_NOT_PRESENT })
+        }
+        Action::Upload { path, force } => {
+            if present && !*force {
+                eprintln!(
+                    "A firmware extension is already loaded; nothing to do \
+                     (use --force to rewrite it)."
+                );
+                let _ = session.reboot_sensor();
+                return Ok(0);
+            }
+            let file = file.expect("image is read for the upload action");
+            eprintln!("Loaded {} bytes from {}", file.len(), path.display());
+            let uploaded = session.upload_fwext(&file);
+            // Reboot so the sensor loads the new extension (also releases the
+            // TLS session on failure). It re-enumerates on the bus afterwards.
+            let reboot = session.reboot_sensor();
+            let image_len = uploaded?;
+            eprintln!(
+                "Wrote {image_len} bytes to flash partition 2; reboot requested \
+                 ({reboot:?}). Give the sensor a few seconds to re-enumerate."
+            );
+            Ok(0)
+        }
+    }
+}
+
+fn main() {
+    match run() {
+        Ok(code) => std::process::exit(code),
+        Err(error) => {
+            eprintln!("Firmware upload failed: {error}");
+            std::process::exit(1);
+        }
+    }
+}
