diff --git a/src/fwext.rs b/src/fwext.rs
new file mode 100644
index 0000000..e99c119
--- /dev/null
+++ b/src/fwext.rs
@@ -0,0 +1,215 @@
+//! Firmware-extension (`xpfwext`) upload for `06cb:009a`.
+//!
+//! Mirrors python-validity's `validitysensor/upload_fwext.py` and
+//! `validitysensor/flash.py`. This DOES write sensor flash — partition 2 only
+//! (the firmware extension). It does not touch the TLS pairing partition (1),
+//! the calibration partition (6), or the template database (4).
+//!
+//! Sequence (identical to the reference): strip the file at its first `0x1a`
+//! byte, split off the trailing 256-byte signature, poke two hardware
+//! registers, carve the image into 4 KB `0x41` flash writes, write the
+//! signature with `0x42`, then reboot so the sensor loads the extension.
+
+use crate::protocol::{SensorSession, WireOpcode};
+use crate::usb::Transport;
+use crate::{DriverError, Result};
+
+const PART_FWEXT: u8 = 2;
+const FLASH_CHUNK: usize = 0x1000;
+const SIGNATURE_LEN: usize = 0x100;
+const HW_REG_MODE_SET: u32 = 0x8000_205c;
+const HW_REG_MODE_GET: u32 = 0x8000_2080;
+
+// --- Wire request builders ---------------------------------------------------
+// Each mirrors one `struct.pack` in python-validity. Kept as pure functions so
+// the byte layouts can be unit-tested: a wrong byte here writes garbage to
+// sensor flash.
+
+/// `pack('<BLB', 7, addr, 4)` — read a 32-bit hardware register.
+fn hw_reg_read_request(addr: u32) -> Vec<u8> {
+    let mut req = Vec::with_capacity(6);
+    req.push(0x07);
+    req.extend_from_slice(&addr.to_le_bytes());
+    req.push(4);
+    req
+}
+
+/// `pack('<BLLB', 8, addr, value, 4)` — write a 32-bit hardware register.
+fn hw_reg_write_request(addr: u32, value: u32) -> Vec<u8> {
+    let mut req = Vec::with_capacity(10);
+    req.push(0x08);
+    req.extend_from_slice(&addr.to_le_bytes());
+    req.extend_from_slice(&value.to_le_bytes());
+    req.push(4);
+    req
+}
+
+/// `pack('<BBBHLL', 0x41, partition, 1, 0, addr, len) + buf` — write flash.
+fn flash_write_request(partition: u8, addr: u32, buf: &[u8]) -> Vec<u8> {
+    let mut req = Vec::with_capacity(13 + buf.len());
+    req.push(0x41);
+    req.push(partition);
+    req.push(1);
+    req.extend_from_slice(&0u16.to_le_bytes()); // `H` field, always 0
+    req.extend_from_slice(&addr.to_le_bytes());
+    req.extend_from_slice(&(buf.len() as u32).to_le_bytes());
+    req.extend_from_slice(buf);
+    req
+}
+
+/// `pack('<BBxH', 0x42, partition, len(sig)) + sig` — write the firmware signature.
+fn fw_signature_request(partition: u8, signature: &[u8]) -> Vec<u8> {
+    let mut req = Vec::with_capacity(5 + signature.len());
+    req.push(0x42);
+    req.push(partition);
+    req.push(0);
+    req.extend_from_slice(&(signature.len() as u16).to_le_bytes());
+    req.extend_from_slice(signature);
+    req
+}
+
+impl<T: Transport> SensorSession<T> {
+    /// Read a 32-bit hardware register.
+    pub fn read_hw_reg32(&mut self, addr: u32) -> Result<u32> {
+        let payload = self.execute_cmd(&hw_reg_read_request(addr), 8)?;
+        if payload.len() < 4 {
+            return Err(DriverError::ShortResponse {
+                context: "read_hw_reg32 response",
+                expected: 4,
+                actual: payload.len(),
+            });
+        }
+        Ok(u32::from_le_bytes([payload[0], payload[1], payload[2], payload[3]]))
+    }
+
+    /// Write a 32-bit hardware register.
+    pub fn write_hw_reg32(&mut self, addr: u32, value: u32) -> Result<()> {
+        let _ = self.execute_cmd(&hw_reg_write_request(addr, value), 8)?;
+        Ok(())
+    }
+
+    /// Write one `0x41` flash chunk, bracketed by `db_write_enable` and the
+    /// `0x1a` cleanup exactly as python-validity's `flash.write_flash` does.
+    pub fn write_flash_chunk(&mut self, partition: u8, addr: u32, buf: &[u8]) -> Result<()> {
+        self.db_write_enable()?;
+        let write = (|| {
+            let _ = self.execute_cmd(&flash_write_request(partition, addr, buf), 8)?;
+            Ok::<(), DriverError>(())
+        })();
+        // Always release the write lock, even if the write failed.
+        let cleanup = self.db_call_cleanups();
+        write.and(cleanup)
+    }
+
+    /// Write the 256-byte firmware signature.
+    pub fn write_fw_signature(&mut self, partition: u8, signature: &[u8]) -> Result<()> {
+        let _ = self.execute_cmd(&fw_signature_request(partition, signature), 8)?;
+        Ok(())
+    }
+
+    /// Whether a firmware extension is loaded on the sensor (flash partition 2),
+    /// i.e. whether `0x43 0x02` (`GetFwextInfo`) returns an OK status.
+    pub fn fwext_present(&mut self) -> Result<bool> {
+        let raw = self.execute_raw(&[WireOpcode::GetFwextInfo as u8, 0x02], 0xf0)?;
+        if raw.len() < 2 {
+            return Ok(false);
+        }
+        Ok(u16::from_le_bytes([raw[0], raw[1]]) == 0)
+    }
+
+    /// Split an `.xpfwext` file into (image, trailing 256-byte signature),
+    /// discarding everything up to and including the first `0x1a` byte.
+    pub fn split_fwext(file: &[u8]) -> Result<(&[u8], &[u8])> {
+        let marker = file
+            .iter()
+            .position(|&b| b == 0x1a)
+            .ok_or_else(|| DriverError::Protocol("No 0x1a marker in firmware file".into()))?;
+        let body = &file[marker + 1..];
+        if body.len() <= SIGNATURE_LEN {
+            return Err(DriverError::Protocol(format!(
+                "Firmware payload too small after marker: {} bytes",
+                body.len()
+            )));
+        }
+        Ok(body.split_at(body.len() - SIGNATURE_LEN))
+    }
+
+    /// Upload a firmware extension to flash partition 2. Returns the number of
+    /// image bytes written (excluding the signature). Does NOT reboot — the
+    /// caller must, so the sensor picks up the new extension.
+    pub fn upload_fwext(&mut self, file: &[u8]) -> Result<usize> {
+        let (image, signature) = Self::split_fwext(file)?;
+
+        self.write_hw_reg32(HW_REG_MODE_SET, 7)?;
+        let mode = self.read_hw_reg32(HW_REG_MODE_GET)?;
+        if mode != 2 && mode != 3 {
+            return Err(DriverError::Protocol(format!(
+                "Unexpected hw register 0x{HW_REG_MODE_GET:08x} = {mode} (expected 2 or 3); \
+                 refusing to write flash"
+            )));
+        }
+
+        let mut addr = 0u32;
+        for chunk in image.chunks(FLASH_CHUNK) {
+            self.write_flash_chunk(PART_FWEXT, addr, chunk)?;
+            addr += chunk.len() as u32;
+        }
+        self.write_fw_signature(PART_FWEXT, signature)?;
+        Ok(image.len())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::usb::SynapticsUsbTransport;
+    use crate::SensorSession;
+
+    fn hex(s: &str) -> Vec<u8> {
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    // Expected bytes are python-validity's own `struct.pack` output.
+    #[test]
+    fn request_layouts_match_python_validity() {
+        assert_eq!(hw_reg_read_request(0x8000_2080), hex("078020008004"));
+        assert_eq!(hw_reg_write_request(0x8000_205c, 7), hex("085c2000800700000004"));
+        assert_eq!(
+            flash_write_request(2, 0x1000, &[0u8; 0x1000])[..13].to_vec(),
+            hex("41020100000010000000100000")
+        );
+        assert_eq!(
+            flash_write_request(2, 0, &[0u8; 16])[..13].to_vec(),
+            hex("41020100000000000010000000")
+        );
+        assert_eq!(fw_signature_request(2, &[0u8; 256])[..5].to_vec(), hex("4202000001"));
+    }
+
+    #[test]
+    fn flash_write_request_appends_payload() {
+        let req = flash_write_request(2, 0, &[0xaa, 0xbb]);
+        assert_eq!(req.len(), 13 + 2);
+        assert_eq!(&req[13..], &[0xaa, 0xbb]);
+    }
+
+    #[test]
+    fn split_fwext_matches_reference_offsets() {
+        // 2 bytes of preamble, the 0x1a marker, then 300 bytes of payload.
+        let mut file = vec![0u8; 2];
+        file.push(0x1a);
+        file.extend_from_slice(&[1u8; 300]);
+        let (image, sig) = SensorSession::<SynapticsUsbTransport>::split_fwext(&file).unwrap();
+        assert_eq!(image.len(), 300 - 256);
+        assert_eq!(sig.len(), 256);
+        assert!(image.iter().all(|&b| b == 1));
+    }
+
+    #[test]
+    fn split_fwext_rejects_missing_marker() {
+        let file = vec![0u8; 1000];
+        assert!(SensorSession::<SynapticsUsbTransport>::split_fwext(&file).is_err());
+    }
+}
