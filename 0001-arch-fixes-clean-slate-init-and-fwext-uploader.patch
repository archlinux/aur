+    "f6444a8e2a10ed8fa9ddb8604bb95fe411b97112e78dbf5a4a0f004669c93765a9f38665cb55f5658895c1c06a7aedf6",
+    "94bfb3afa9b8b1dea5ab85c821ac20b0663b95023642fda36ad78e3e00140b966f404f7e55f0b416ea43b4c74c399008",
+    "30abc6906a1004bef1b5b7dbbbeb5ec1b22604ac86429b9f56511b746a7124c449b8c9498f49144abc2d64f6a114f1d7",
+    "f91aa41249faeef4d838e280cb5d6fc19cfe86c75f"
+));
+
 impl<T: Transport> SensorSession<T> {
     /// Create a new unencrypted [`SensorSession`] wrapping `transport`.
     ///
@@ -521,12 +544,34 @@ impl<T: Transport> SensorSession<T> {
         drv_debug!("Init step 2/4: Querying SensorConfig (0x19)");
         let _ = self.get_config()?;
 
-        drv_debug!("Init step 3/4: Querying Partition 2 FwextInfo (0x43 0x02)");
-        let _ = self.execute_cmd(&[WireOpcode::GetFwextInfo as u8, 0x02], 0xf0);
-
-        drv_debug!("Init step 4/4: Sending Metallica security init blob (0x06 0x02)");
+        drv_debug!("Init step 3/5: Querying Partition 2 FwextInfo (0x43 0x02)");
+        // A non-zero status here is not fatal: it means no firmware extension
+        // (fwext) is loaded, which is the "clean slate" case. Read the status
+        // word directly with execute_raw rather than execute_cmd, which would
+        // turn the non-zero status into an error.
+        let fwext_status = self
+            .execute_raw(&[WireOpcode::GetFwextInfo as u8, 0x02], 0xf0)
+            .ok()
+            .and_then(|r| {
+                (r.len() >= 2).then(|| u16::from_le_bytes([r[0], r[1]]))
+            })
+            .unwrap_or(0);
+
+        drv_debug!("Init step 4/5: Sending Metallica security init blob (0x06 0x02)");
         let _ = self.execute_cmd(&INIT_HARDCODED_009A, 64)?;
 
+        // Without a firmware extension the generic init blob is not enough:
+        // the sensor accepts the TLS session but fault-resets on the first
+        // capture program (e.g. the calibration AcqStart) unless the clean-slate
+        // init blob is also sent first. This mirrors python-validity's
+        // send_init(), which sends init_hardcoded_clean_slate when fwext != 0.
+        if fwext_status != 0 {
+            drv_debug!(
+                "Init step 5/5: no firmware extension (fwext status 0x{fwext_status:04x}); sending clean-slate init blob"
+            );
+            let _ = self.execute_cmd(&INIT_HARDCODED_CLEAN_SLATE_009A, 64)?;
+        }
+
         Ok(version)
     }
 
