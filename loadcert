#!/usr/bin/bash

Red="\e[0;31m"
Yellow="\e[0;33m"
Green="\e[0;32m"
White="\e[0m"





restart_browser() {
    local browser_name="$1"

    # Проверяем, запущен ли браузер
    if pgrep -x "$browser_name" > /dev/null || pgrep -f "$browser_name" > /dev/null; then
        echo "Found opened browser: $browser_name"
        echo "Closing $browser_name..."

        # Закрываем браузер
        pkill "$browser_name" 2>/dev/null || pkill -f "$browser_name" 2>/dev/null

        # Даем время на закрытие
        sleep 2

        echo "Restarting $browser_name..."
        # Перезапускаем браузер в фоне
        "$browser_name" &>/dev/null &

        echo "$browser_name successfully restarted."
        return 0
    fi
    return 1
}

