if [[ $# -eq 0 ]]; then
    printf "${Red}Please enter a path to a certificate - loadcert /path/to/cert\n${White}"
    exit 1
fi

if [[ ! -f $1 ]]; then
    printf "${Red}File not found. Please enter a valid path to a certificate - loadcert /path/to/cert\n${White}"
    exit 1
fi

output=$(openssl x509 -in $1 -noout -dates 2>&1)

if [[ "$output" == *"Could not"* ]]; then
    printf "${Red}File probably is not a certificate. Check it and try again - loadcert /path/to/cert\n${White}"
    exit 1
fi

printf "${Yellow}CERTIFICATE: \n${White}"
echo "$output"

printf "${Yellow}Trying to copy the certificate into trust-source folder... \n${White}"
sudo cp $1 /etc/ca-certificates/trust-source/anchors/
printf "${Green}Copied! \n${White}"

printf "${Yellow}Updating trusting certificates... \n${White}"
sudo trust extract-compat
printf "${Green}Done! \n${White}"

echo "$(openssl verify $1)"
printf "${Green}Loaded! ${White}Should we restart your browser to apply certificate? [${Green}Y${White}/${Red}n${White}]\n${White}"
read key

if [[ "$key" =~ ^[Nn]$ ]]; then
    # N or n PRESSED"
    exit 0
else
    # Y or another PRESSED"
    browsers=("firefox" "google-chrome" "chromium-browser" "opera" "brave-browser")

    for browser in "${browsers[@]}"; do
        if restart_browser "$browser"; then
            exit 0
        fi
    done
fi
