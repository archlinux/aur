+
+func TestUpdateDisabledRefusesInstall(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	setVersion(t, "v0.16.0")
+	old := UpdateDisabled
+	UpdateDisabled = "update it with your package manager"
+	t.Cleanup(func() { UpdateDisabled = old })
+	calls := withFakeUpdate(t, selfupdate.Release{
+		Tag:    "v0.17.0",
+		Assets: map[string]string{selfupdate.AssetName(): "https://example.test/asset"},
+	}, nil, nil)
+
+	_, err := run(t, "update")
+	if err == nil || !strings.Contains(err.Error(), UpdateDisabled) {
+		t.Errorf("update err = %v, want it to carry the UpdateDisabled message", err)
+	}
+	if *calls != 0 {
+		t.Errorf("apply must not run when updates are disabled, got %d calls", *calls)
+	}
+
+	out, err := run(t, "update", "--check")
+	if err != nil {
+		t.Fatalf("update --check: %v", err)
+	}
+	if !strings.Contains(out, "v0.17.0") {
+		t.Errorf("output = %q, want --check to still report the latest version", out)
+	}
+}
