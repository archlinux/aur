post_install() {
  ln -sf /opt/Sable/sable /usr/bin/sable
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
  update-desktop-database -q
}

post_upgrade() {
  post_install
}

post_remove() {
  rm -f /usr/bin/sable
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
  update-desktop-database -q
}
