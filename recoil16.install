post_install() {
	cat <<'MSG'
==> recoil16: the modules are built by DKMS and load automatically at boot. Reboot now.
==> Install recoil16ctl to control them: yay -S recoil16ctl
==>        sudo recoil16ctl battery mode long-life   (charge to ~93%; trickle ~90%)
==>        sudo recoil16ctl lightbar blue 60   (saved for boot)
==> Check everything: recoil16ctl check        Docs: man recoil16
MSG
}

post_upgrade() {
	# 1.1.0 replaced the percentage charge limit with charge modes
	if [ -e /etc/udev/rules.d/90-recoil16-charge-limit.rules ]; then
		rm -f /etc/udev/rules.d/90-recoil16-charge-limit.rules
		echo "==> recoil16: the battery charge limit is gone (it may damage the battery on this"
		echo "==>     model). Choose a charge mode: sudo recoil16ctl battery mode long-life"
	fi
	if [ ! -e /usr/bin/recoil16ctl ]; then
		echo "==> recoil16: recoil16ctl is now its own package: yay -S recoil16ctl (or recoil16ctl-git)"
		echo "==>     (your charge mode and lightbar settings keep working meanwhile)"
	fi
	echo "==> recoil16: reboot to load the updated modules."
}

post_remove() {
	echo "==> recoil16: removed. Reboot to return to the stock drivers."
}
