 char* nvkms_strncpy(char *dest, const char *src, size_t n)
 {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 2, 0)
+    size_t i;
+
+    for (i = 0ull; i < n && src[i] != '\0'; i++) dest[i] = src[i];
+    for (; i < n; i++) dest[i] = '\0';
+    
+    return dest;
+#else
     return strncpy(dest, src, n);
+#endif
 }
 
