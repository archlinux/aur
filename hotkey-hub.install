post_install() {
  echo "Please address the documentation first at https://github.com/akoidan/hotkey-hub"
  echo "Put configs and certs into ~/.config/hotkey-hub/config.jsonc and ~/.config/hotkey-hub/certs"
  echo "Edit /usr/lib/systemd/user/hotkey-hub.service for customization"
  echo "start the service with systemctl --user enable --now hotkey-hub.service"
}

post_upgrade() {
  post_install
}
