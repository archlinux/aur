<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/udf">
        <comment>Uyap Document File</comment>
        <comment xml:lang="tr">Uyap Dokuman Editor</comment>
        <acronym>UDF</acronym>
        <expanded-acronym>Uyap Document File</expanded-acronym>
        <icon name="uyap-editor"/>
        <generic-icon name="x-office-document"/>
        <glob pattern="*.udf"/>
    </mime-type>

    <mime-type type="application/usf">
        <comment>Uyap Template File</comment>
        <comment xml:lang="tr">Uyap Sablon Editor</comment>
        <acronym>USF</acronym>
        <expanded-acronym>Uyap Template File</expanded-acronym>
        <icon name="uyap-editor"/>
        <generic-icon name="text-x-generic-template"/>
        <glob pattern="*.usf"/>
    </mime-type>
</mime-info>
