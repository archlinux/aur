# Honcho server configuration, read by both honcho.service and
# honcho-deriver.service as a systemd EnvironmentFile.
#
# Notes:
#  - systemd does NOT strip inline comments: keep '#' at the start of a line.
#  - At least one LLM provider key is REQUIRED for memory derivation and
#    embeddings; without one the API still starts, but those jobs fail.
#  - Full reference: https://honcho.dev/docs/v3/contributing/configuration
#    and /usr/share/doc/honcho/env.template

# --- Database (required) ---
# PostgreSQL with the pgvector, pg_trgm and btree_gin extensions enabled.
# Must use the postgresql+psycopg:// prefix.
#DB_CONNECTION_URI=postgresql+psycopg://honcho@localhost:5432/honcho

# --- LLM provider (required) ---
# Uncomment exactly one (OpenAI-compatible endpoints work too, see
# *_MODEL_CONFIG__OVERRIDES__BASE_URL in env.template).
#LLM_OPENAI_API_KEY=sk-...
#LLM_ANTHROPIC_API_KEY=sk-ant-...
#LLM_GEMINI_API_KEY=...

# --- Common optional settings ---
#AUTH_USE_AUTH=false
#CACHE_ENABLED=false
#CACHE_URL=redis://localhost:6379/0
#LOG_LEVEL=INFO
#API_WORKERS=1
#HONCHO_HOST=127.0.0.1
#HONCHO_PORT=8000
#METRICS_ENABLED=false
#SENTRY_ENABLED=false
