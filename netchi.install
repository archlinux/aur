post_install() {
    echo ":: Applying network capabilities to the Netchi binary..."
    setcap cap_net_raw,cap_net_admin=eip /usr/bin/netchi
    echo ":: Setup complete. Netchi can now capture packets without root privileges."
}

post_upgrade() {
    post_install
}

post_remove() {
    echo ":: Netchi has been uninstalled. Network capabilities removed."
}
