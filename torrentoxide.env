# TorrentOxide runtime configuration.
# Values set here OVERRIDE the defaults baked into the systemd unit.
# Apply changes with:  sudo systemctl restart torrentoxide

# ---- Authentication (optional) --------------------------------------------
# Login is required only when BOTH are set. Leave blank/commented for no auth.
#AUTH_USERNAME=admin
#AUTH_PASSWORD=change-me

# Secret used to sign session cookies. Generate a strong one with:
#   openssl rand -hex 32
# If unset, an ephemeral key is used and all sessions reset on restart.
#SESSION_SECRET=

# ---- Paths (optional overrides) -------------------------------------------
# Defaults live under /var/lib/torrentoxide (see the systemd unit).
#DOWNLOAD_DIR=/var/lib/torrentoxide/downloads
#BROWSE_ROOT=/var/lib/torrentoxide/downloads
#PERSISTENCE_DIR=/var/lib/torrentoxide/.rqbit-session

# ---- Network / logging (optional) -----------------------------------------
# Bind address. Use 0.0.0.0:3000 to expose on the LAN (serve behind HTTPS!).
#LEPTOS_SITE_ADDR=127.0.0.1:3000
#RUST_LOG=info,librqbit=warn
