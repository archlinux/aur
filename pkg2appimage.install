#!/bin/bash
# Maintainer: Toria <ninetailedtori@uwu.gal>

pkgname=pkg2appimage

post_install() {
    # Link the pkg2appimage AppImage to /usr/bin
    rm -f   /usr/bin/pkg2appimage
    ln -sf  /opt/pkg2appimage/$pkgname.AppImage /usr/bin/$pkgname
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -f /usr/bin/pkg2appimage
}
