post_install() {
    echo "==> Reloading systemd daemon..."
    systemctl daemon-reload

    echo ""
    cat <<'EOF'
█▀▄▀█ ▄▀▀▀▄ ▄▀▀▀▄ █▄  █ █▀▀▀▄ ▀▀█▀▀ ▀▀█▀▀    ▄▀    ▄▀
█   █ █   █ █   █ █ ▀▄█ █▀▀▀▄   █     █    ▄▀    ▄▀
▀   ▀  ▀▀▀   ▀▀▀  ▀   ▀ ▀▀▀▀  ▀▀▀▀▀   ▀   ▀     ▀

EOF
    echo "==> moonbit v${1} installed successfully!"
    echo ""
    echo "Search for moonbit in your application menu, or run it directly:"
    echo ""
    echo "Usage:"
    echo "  moonbit                    # Interactive TUI"
    echo "  moonbit scan               # Scan and optionally clean"
    echo "  moonbit clean              # Preview files before cleaning"
    echo "  moonbit clean --force      # Actually delete files"
    echo "  moonbit scan --list-categories"
    echo ""
    echo "Automation (choose ONE mode):"
    echo ""
    echo "  Timer Mode (lightweight, periodic):"
    echo "    sudo systemctl enable --now moonbit-scan.timer   # Daily scans"
    echo "    sudo systemctl enable --now moonbit-clean.timer  # Weekly cleaning"
    echo ""
    echo "  Daemon Mode (long-running, continuous):"
    echo "    sudo systemctl enable --now moonbit-daemon.service"
    echo ""
    echo "  NOTE: Timer and Daemon modes are mutually exclusive."
    echo "        Do not enable both simultaneously."
    echo ""
    echo "Check status:"
    echo "  systemctl list-timers moonbit-*"
    echo "  systemctl status moonbit-daemon.service"
    echo ""
}

post_upgrade() {
    echo "==> Reloading systemd daemon..."
    systemctl daemon-reload

    echo ""
    cat <<'EOF'
█▀▄▀█ ▄▀▀▀▄ ▄▀▀▀▄ █▄  █ █▀▀▀▄ ▀▀█▀▀ ▀▀█▀▀    ▄▀    ▄▀
█   █ █   █ █   █ █ ▀▄█ █▀▀▀▄   █     █    ▄▀    ▄▀
▀   ▀  ▀▀▀   ▀▀▀  ▀   ▀ ▀▀▀▀  ▀▀▀▀▀   ▀   ▀     ▀

EOF
    echo "==> moonbit upgraded to v${1}!"
    echo ""
    echo "See the changelog for what changed in this release:"
    echo "  https://github.com/Nomadcxx/moonbit/releases/tag/v${1%%-*}"
    echo ""
    if [ -f /usr/local/bin/moonbit ]; then
        echo "!!  A stale binary remains at /usr/local/bin/moonbit."
        echo "    This package now installs to /usr/bin/moonbit (packaged files do"
        echo "    not belong in /usr/local). The old file was left by the"
        echo "    from-source installer and will shadow this one on most PATHs."
        echo "    Remove it with:  sudo rm /usr/local/bin/moonbit"
        echo ""
    fi
    echo "If you have enabled timers, they will continue running."
    echo "Check status: systemctl list-timers moonbit-*"
    echo "              systemctl status moonbit-daemon.service"
    echo ""
}

pre_remove() {
    echo "==> Disabling moonbit services..."
    systemctl disable --now moonbit-scan.timer 2>/dev/null || true
    systemctl disable --now moonbit-clean.timer 2>/dev/null || true
    systemctl disable --now moonbit-daemon.service 2>/dev/null || true
    systemctl daemon-reload
}

post_remove() {
    systemctl daemon-reload 2>/dev/null || true

    echo ""
    echo "==> moonbit binary and systemd units removed."
    echo ""
    echo "    Deliberately kept (they may hold the only copy of deleted files,"
    echo "    or your configuration):"
    echo "      /var/log/moonbit           audit log"
    echo "      /var/lib/moonbit           daemon state"
    echo "      ~/.config/moonbit          configuration"
    echo "      ~/.cache/moonbit           scan cache"
    echo "      ~/.local/share/moonbit     backups of previously deleted files"
    echo ""
    echo "    To remove them as well:"
    echo "      sudo rm -rf /var/log/moonbit /var/lib/moonbit"
    echo "      rm -rf ~/.config/moonbit ~/.cache/moonbit ~/.local/share/moonbit"
    echo ""
}
