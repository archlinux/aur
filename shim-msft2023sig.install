post_install() {
  cat <<'MSG'
shim-msft2023sig installed.

No EFI System Partition files were modified.

Files are available under:
  /usr/share/shim-msft2023sig/current/

Suggested checks:
  sbverify --list /usr/share/shim-msft2023sig/current/shimx64.efi
  objdump -s -j .sbat /usr/share/shim-msft2023sig/current/shimx64.efi

To deploy to an ESP, install shim-msft2023sig-helper and run:
  sudo shim-msft2023sig-install --esp /boot/efi --target arch
MSG
}

post_upgrade() {
  post_install
}
