post_install() {
  cat <<'MSG'
==> frugalRGB setup:
    USB RGB (motherboard): replug the device or run
      udevadm trigger
    to apply the installed udev rules.

    RAM RGB and ASUS GPU RGB (SMBus, i2c-dev):
      1. Add your user to the i2c group, then log out and back in:
           usermod -aG i2c $USER
      2. On boards whose BIOS claims the SMBus (most Gigabyte boards),
         the kernel refuses to bind the SMBus driver. Add
           acpi_enforce_resources=lax
         to the kernel command line and reboot. See the README.
MSG
}

post_upgrade() {
  return 0
}
