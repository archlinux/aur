[Unit]
Description=Paseo Daemon
Documentation=https://paseo.sh
# Bind to the graphical session: start only after the user has logged into a
# graphical session (so the daemon inherits DISPLAY/WAYLAND_DISPLAY/XAUTHORITY
# that the session imports into the systemd --user manager — GUI apps spawned by
# agents need them), and stop when the session ends. Without this the daemon can
# start at login before those vars exist and GUI apps fail with "could not
# connect to display".
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Run the daemon through the bundled CLI launcher (resources/bin/paseo), NOT
# /usr/bin/paseo: the latter is the GUI wrapper and cannot spawn the daemon's
# node-mode supervisor (ELECTRON_RUN_AS_NODE), which fails with
# "unknown command supervisor-entrypoint.js". The CLI launcher sets that up.
#
# Wrap it in the user's interactive login shell (-ilc) so the daemon and every
# agent it spawns inherit the same PATH/env as a terminal. Without this the
# systemd --user manager gives a minimal env and agents can't find git, node,
# or CLIs in ~/.local/bin. This mirrors the desktop app's inheritLoginShellEnv().
ExecStart=/bin/sh -c 'exec "$$(getent passwd "$$(id -u)" | cut -d: -f7)" -ilc "exec /opt/Paseo/resources/bin/paseo daemon start --foreground"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
