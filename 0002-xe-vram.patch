+					if (query_mem(card, total, used) and total > 0) {
+						gpu.mem_total = (long long)total;
+						if (gpu.supported_functions.mem_used) {
+							gpu.mem_used = (long long)used;
+							gpu.gpu_percent.at("gpu-vram-totals").push_back((long long)round((double)used * 100.0 / (double)total));
+						}
+					}
+				}
 			}
 
 			return true;
