+		static bool query_mem(Card& card, uint64_t& total, uint64_t& used) {
+			auto& raw = card.mem_buf;
+			if (card.drm_fd < 0 or not xe_query(card.drm_fd, DRM_XE_DEVICE_QUERY_MEM_REGIONS, raw) or raw.size() < sizeof(struct drm_xe_query_mem_regions)) {
+				raw.clear();
+				return false;
+			}
+			const auto* qm = (const struct drm_xe_query_mem_regions*)raw.data();
+			const size_t n = std::min<size_t>(qm->num_mem_regions, (raw.size() - sizeof(*qm)) / sizeof(struct drm_xe_mem_region));
+			for (size_t i = 0; i < n; i++) {
+				const auto& r = qm->mem_regions[i];
+				if (r.mem_class != DRM_XE_MEM_REGION_CLASS_VRAM) continue;
+				total = r.total_size;
+				used = r.used;
+				return true;
+			}
+			return false;
+		}
