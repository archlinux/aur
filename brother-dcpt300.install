post_install() {
	if systemctl is-active --quiet cups.service; then
		echo "Restarting CUPS..."
		systemctl restart cups.service
	fi
	echo "Register the printer using the web interface at http://localhost:631/"
}

post_upgrade() {
	post_install
}

post_remove() {
	if systemctl is-active --quiet cups.service; then
		echo "Restarting CUPS..."
		systemctl restart cups.service
	fi
}
