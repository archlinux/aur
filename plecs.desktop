[Desktop Entry]
Type=Application
Name=PLECS Standalone
GenericName=Power Electronics Circuit Simulator
Comment=Simulate power electronic circuits and control systems
Icon=plecs
Exec=/usr/bin/plecs %U
Path=/opt/plecs
Terminal=false
StartupNotify=true
StartupWMClass=plecs

Categories=Development;Engineering;Electronics;
Keywords=simulation;power electronics;circuit simulator;control systems;

MimeType=application/x-plecs;application/x-plecs-model;
