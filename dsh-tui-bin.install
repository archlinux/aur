post_install() {
    sync_profile
    echo
    echo "Optional agent backends (experimental):"
    echo "  Codex:  install openai-codex (codex >= 0.144.0)"
    echo "  Claude: install claude-code, then add the SDK to the profile:"
    echo "          cd ~/.dsh/profiles/dsh-tui && pnpm add @anthropic-ai/claude-agent-sdk@0.3.287"
}

post_upgrade() {
    sync_profile
}

sync_profile() {
    local user home
    user="${SUDO_USER:-}"
    if [ -z "$user" ]; then
        user="$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }')"
    fi
    [ -n "$user" ] || return 0
    home="$(getent passwd "$user" | cut -d: -f6)"
    [ -n "$home" ] && [ -d "$home" ] || return 0
    if ! timeout 300 runuser -u "$user" -- /usr/bin/dsh-tui update; then
        echo "dsh-tui: profile bootstrap failed; retry as $user with:" >&2
        echo "  dsh-tui update" >&2
    fi
}
