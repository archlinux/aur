 const MINIMUM_DISTANCE_TO_RESTORE_ORIGINAL_SIZE = 90;
 
diff --git a/src/polyfill.ts b/src/polyfill.ts
index 31930ce..f573816 100644
--- a/src/polyfill.ts
+++ b/src/polyfill.ts
@@ -18,7 +18,7 @@ function openPrefs() {
 }
 
 function getIsMaximized(window: Meta.Window) {
