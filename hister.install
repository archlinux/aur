post_install() {
	cat <<EOM
:: To start hister, enable the system or user service:
   systemctl enable --now hister # or...
   systemctl --user enable --now hister

:: Generate a default config file:
   hister create-config ~/.config/hister/config.yml
EOM
}

post_upgrade() {
	# Restart the system service if it is already running, to reload the binary.
	/usr/bin/systemctl set-property hister Markers=needs-restart

	cat <<EOM
:: Restart the hister user service if running:
   systemctl --user restart hister
EOM
}
