#!/bin/bash

_get_user_home() {
    # Best-effort: works for the common `sudo pacman -S` case.
    # Falls back to $HOME. Document the limitation in the README
    # instead of trying to handle every invocation (doas, su -, etc).
    if [[ -n "$SUDO_USER" ]]; then
        getent passwd "$SUDO_USER" | cut -d: -f6
    else
        echo "$HOME"
    fi
}

_ensure_default_files() {
    local hypremoji_dir="$1"
    mkdir -p "$hypremoji_dir"

    local pairs=(
        "/usr/share/hypremoji/hypremoji.conf:$hypremoji_dir/hypremoji.conf"
        "/usr/share/hypremoji/hypremoji.lua:$hypremoji_dir/hypremoji.lua"
        "/usr/share/hypremoji/config.json:$hypremoji_dir/config.json"
    )
    for pair in "${pairs[@]}"; do
        local src="${pair%%:*}"
        local dst="${pair##*:}"
        if [[ ! -f "$dst" ]]; then
            cp "$src" "$dst"
            echo "    -> Created $dst"
        fi
    done

    if [[ -n "$SUDO_USER" ]]; then
        chown -R "$SUDO_USER:$SUDO_USER" "$hypremoji_dir"
    fi
}

_print_integration_hint() {
    local hypr_dir="$1"

    if [[ -f "$hypr_dir/hyprland.lua" ]]; then
        if grep -q 'require("hypremoji")' "$hypr_dir/hyprland.lua"; then
            echo "    -> HyprEmoji already wired into hyprland.lua"
            return
        fi
        echo ""
        echo "    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "    !!  WARNING: hypremoji will NOT work until you add        !!"
        echo "    !!  these two lines to the END of $hypr_dir/hyprland.lua"
        echo "    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo ""
        echo '        package.path = package.path .. ";" .. os.getenv("HOME") .. "/.config/hypremoji/?.lua"'
        echo '        require("hypremoji")'
        echo ""
        echo "    Without this, the picker gets installed but Hyprland never"
        echo "    loads it (no keybind, no window rules)."
        echo ""
        return
    fi

    if [[ -f "$hypr_dir/hyprland.conf" ]]; then
        if grep -q "source.*hypremoji/hypremoji.conf" "$hypr_dir/hyprland.conf"; then
            echo "    -> HyprEmoji already wired into hyprland.conf"
            return
        fi
        echo ""
        echo "    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo "    !!  WARNING: hypremoji will NOT work until you add        !!"
        echo "    !!  this line to $hypr_dir/hyprland.conf"
        echo "    !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
        echo ""
        echo "        source = ~/.config/hypremoji/hypremoji.conf"
        echo ""
        echo "    Without this, the picker gets installed but Hyprland never"
        echo "    loads it (no keybind, no window rules)."
        echo ""
        return
    fi

    echo "    -> No Hyprland config found yet; wire HyprEmoji in once you set one up."
}

_append_style_v1_2() {
    local css="$1"
    [[ -f "$css" ]] || { echo "    -> style.css not found, skipping style update"; return; }
    grep -q "New styles for v1.2 components" "$css" && { echo "    -> styles already present"; return; }

    cat >> "$css" << 'EOF'

/* New styles for v1.2 components */
:root { --error: #c41313; }
.generic-btn { color: var(--primary-col); -gtk-icon-size: 24px; }
.toast-container {
  background-color: var(--btn-list-col);
  border-radius: 10px; padding: 5px 15px; margin: 0 20px 20px;
  border: 1px solid var(--primary-col);
  transition: all 0.3s ease-in-out; transform: scale(0.0000000001);
}
.toast-container.error { border: 1px solid var(--error); }
.toast-label { color: white; font-weight: 700; }
.show-toast { transform: scale(1); animation: boingCombo 5s both; }
@keyframes boingCombo {
  0% { opacity: 0; transform: scale3d(.3,.3,.3); }
  3%, 90% { opacity: 1; transform: scale3d(1,1,1); }
  100% { opacity: 0; transform: scale3d(.3,.3,.3); }
}
EOF
    [[ -n "$SUDO_USER" ]] && chown "$SUDO_USER:$SUDO_USER" "$css"
    echo "    -> Styles appended"
}

post_install() {
    local user_home hypr_dir hypremoji_dir
    user_home=$(_get_user_home)
    hypr_dir="$user_home/.config/hypr"
    hypremoji_dir="$user_home/.config/hypremoji"

    echo "==> Setting up hypremoji..."
    _ensure_default_files "$hypremoji_dir"
    _print_integration_hint "$hypr_dir"
    echo ""
    echo "==> Installation complete. Run 'hypremoji' to open the picker."
}

post_upgrade() {
    local new_ver="$1" old_ver="$2"
    local user_home hypr_dir hypremoji_dir
    user_home=$(_get_user_home)
    hypr_dir="$user_home/.config/hypr"
    hypremoji_dir="$user_home/.config/hypremoji"

    echo "==> Upgrading hypremoji: $old_ver -> $new_ver"
    _ensure_default_files "$hypremoji_dir"
    _print_integration_hint "$hypr_dir"
    _append_style_v1_2 "$hypremoji_dir/style.css"
    echo "==> Upgrade complete."
}
