post_install() {
  cat << 'EOF'
==> otaripper-bin (glibc build)

IMPORTANT:
────────────────────────────────────
If otaripper fails to run due to libc
or runtime issues, use the musl build.

goto https://github.com/syedinsaf/otaripper/releases

Look for: otaripper-linux-static-x86_64.tar.gz
────────────────────────────────────
EOF
}

post_upgrade() {
  post_install
}
