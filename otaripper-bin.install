post_install() {
  cat << 'EOF'

\e[1;36m==> otaripper-bin (glibc build)\e[0m

This package ships the \e[1mprebuilt glibc-based binary\e[0m.

\e[1;33mIf otaripper fails to run due to libc or runtime issues:\e[0m
You can use the \e[1;32mfully static musl build\e[0m instead:

  \e[4;34mhttps://github.com/syedinsaf/otaripper/releases\e[0m

Look for:
  \e[1motaripper-linux-static-x86_64.tar.gz\e[0m

EOF
}

post_upgrade() {
  post_install
}
