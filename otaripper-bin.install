post_install() {
  if command -v tput >/dev/null && [ -t 1 ]; then
    CYAN=$(tput setaf 6)
    YELLOW=$(tput setaf 3)
    GREEN=$(tput setaf 2)
    BLUE=$(tput setaf 4)
    BOLD=$(tput bold)
    RESET=$(tput sgr0)
  else
    CYAN= YELLOW= GREEN= BLUE= BOLD= RESET=
  fi

  cat << EOF
${CYAN}${BOLD}==> otaripper-bin (glibc build)${RESET}

This package ships the ${BOLD}prebuilt glibc-based binary${RESET}.

${YELLOW}If otaripper fails to run due to libc or runtime issues:${RESET}
You can use the ${GREEN}${BOLD}fully static musl build${RESET} instead:

  ${BLUE}https://github.com/syedinsaf/otaripper/releases${RESET}

Look for:
  ${BOLD}otaripper-linux-static-x86_64.tar.gz${RESET}
EOF
}

post_upgrade() {
  post_install
}
