#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Maintained by bacularis-api. Not a pacman-owned configuration file.
# Only installed Bacula binaries/services receive narrowly scoped sudo rules.
readonly target='/etc/sudoers.d/bacularis'
readonly marker='# Managed by bacularis-api: bacularis-sudoers-update'
readonly legacy_marker='# Generated by bacularis-sudoers-update.sh'
readonly sudo_user='http'

log() { printf '[bacularis-sudoers] %s\n' "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }

(( EUID == 0 )) || fail 'Run as root'
command -v pacman >/dev/null || fail 'pacman not found'
command -v visudo >/dev/null || fail 'visudo not found: install sudo'
getent passwd "$sudo_user" >/dev/null || fail 'PHP-FPM user http does not exist'

# Do not overwrite locally administered sudoers. Only edit files marked as ours.
if [[ -e "$target" ]]; then
  first_line=$(head -n 1 -- "$target")
  if [[ "$first_line" != "$marker" && "$first_line" != "$legacy_marker" ]]; then
    log "WARNING: $target exists but is not generated by us; unchanged."
    exit 0
  fi
fi

packages=()
while IFS= read -r package; do
  case "$package" in
    bacula-common|bacula-console|bacula-dir|bacula-sd|bacula-fd|bacula-dir-*)
      packages+=("$package") ;;
  esac
done < <(pacman -Qq 2>/dev/null)

declare -A installed=() paths=() units=()
for package in "${packages[@]}"; do installed["$package"]=1; done

# Read installed package ownership from pacman; never accept binaries outside
# system directories or arbitrary executables inserted into $PATH.
if ((${#packages[@]})); then
  while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    file=${path##*/}
    case "$file" in
      bconsole|bdirjson|bsdjson|bfdjson|bbconsjson)
        case "$path" in
          /usr/bin/*|/usr/sbin/*|/opt/bacula/bin/*)
            [[ -x "$path" && ! -L "$path" ]] && paths["$file"]="$path" ;;
        esac
        ;;
      bacula-dir.service|bacula-sd.service|bacula-fd.service)
        case "$path" in
          /usr/lib/systemd/system/*|/etc/systemd/system/*)
            [[ ! -L "$path" ]] && units["${file%.service}"]=1 ;;
        esac
        ;;
    esac
  done < <(pacman -Qql "${packages[@]}")
fi

rules=()
add_binary() {
  local pkg="$1" name="$2"
  if [[ ${installed[$pkg]:-0} == 1 && -n ${paths[$name]:-} ]]; then
    rules+=("$sudo_user ALL=(root) NOPASSWD: ${paths[$name]}")
  elif [[ ${installed[$pkg]:-0} == 1 ]]; then
    log "NOTE: $pkg installed, but no owned executable $name found"
  fi
}
add_binary bacula-console bconsole
add_binary bacula-console bbconsjson
add_binary bacula-dir bdirjson
add_binary bacula-sd bsdjson
add_binary bacula-fd bfdjson

# Use precisely the action verbs and service names documented by Bacularis.
# No enable/disable, daemon-reload, arbitrary unit names, or wildcards.
if [[ -x /usr/bin/systemctl ]]; then
  for role in bacula-dir bacula-sd bacula-fd; do
    if [[ ${installed[$role]:-0} == 1 && ${units[$role]:-0} == 1 ]]; then
      for verb in start stop restart; do
        rules+=("$sudo_user ALL=(root) NOPASSWD: /usr/bin/systemctl $verb $role")
      done
    fi
  done
fi

if ((${#rules[@]} == 0)); then
  if [[ -f "$target" ]]; then
    rm -f -- "$target"
    log "Removed $target (no supported local Bacula components)"
  else
    log 'No Bacula components requiring sudoers found'
  fi
  exit 0
fi

install -d -m 0750 -o root -g root /etc/sudoers.d
tmp=$(mktemp '/etc/sudoers.d/bacularis.tmp.XXXXXXXX')
trap 'rm -f -- "$tmp"' EXIT
{
  printf '%s\n' "$marker" '# Generated automatically; edit the Bacularis API settings, not this file.'
  printf '%s\n' "${rules[@]}"
} > "$tmp"
chmod 0440 "$tmp"
chown root:root "$tmp"
visudo -cf "$tmp" >/dev/null || fail 'sudoers syntax validation failed'
if [[ -f "$target" ]] && cmp -s "$tmp" "$target"; then
  log 'sudoers already current'
  exit 0
fi
mv -f -- "$tmp" "$target"
trap - EXIT
log "Updated $target (${#rules[@]} rules)"
