## arg 1:  the new package version
post_install() {
	ln -sf /opt/splashtop-onprem/splashtop-onprem /usr/bin/splashtop-onprem
}

## arg 1:  the new package version
## arg 2:  the old package version
post_upgrade() {
	post_install
}

## arg 1:  the old package version
post_remove() {
	rm /usr/bin/splashtop-onprem
	rm -rf /opt/splashtop-onprem
}
