post_install() {
    echo -e "\033[1;31m"
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║                        IMPORTANT NOTICE                      ║"
    echo "║                                                              ║"
    echo "║  Your user must belong to the 'video' group to access        ║"
    echo "║  the Backlight service!                                      ║"
    echo "║                                                              ║"
    echo "║  Run: sudo usermod -a -G video \$USER                        ║"
    echo "║  Then logout and login again.                                ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo -e "\033[0m"
    
    echo "Reloading udev rules for morghulis..."
    udevadm control --reload-rules
    udevadm trigger
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "Reloading udev rules..."
    udevadm control --reload-rules
    udevadm trigger
}