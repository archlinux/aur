From 9d365961a8a96fdf1c8b550c98abd369a9282948 Mon Sep 17 00:00:00 2001
From: Xiretza <xiretza@xiretza.xyz>
Date: Fri, 6 Mar 2026 21:31:54 +0000
Subject: [PATCH 2/2] Use patched rust-cpython

This makes it (somewhat) compatible with python 3.14
---
 Cargo.lock | 6 ++----
 Cargo.toml | 3 ++-
 2 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index b9c73ec..ff18c04 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -146,8 +146,7 @@ checksum = "06ea2b9bc92be3c2baa9334a323ebca2d6f074ff852cd1d7b11064035cd3868f"
 [[package]]
 name = "cpython"
 version = "0.7.2"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "43b398a2c65baaf5892f10bb69b52508bf7a993380cc4ecd3785aaebb5c79389"
+source = "git+https://github.com/Xiretza/rust-cpython?rev=f6c2cd2319bcf1187533909bb09ba2be58bd6eaa#f6c2cd2319bcf1187533909bb09ba2be58bd6eaa"
 dependencies = [
  "libc",
  "num-traits",
@@ -792,8 +791,7 @@ dependencies = [
 [[package]]
 name = "python3-sys"
 version = "0.7.2"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "0f53ef6740367a09718d2cd21ba15b0d7972342a38e554736bcee7773e45c9f5"
+source = "git+https://github.com/Xiretza/rust-cpython?rev=f6c2cd2319bcf1187533909bb09ba2be58bd6eaa#f6c2cd2319bcf1187533909bb09ba2be58bd6eaa"
 dependencies = [
  "libc",
  "regex",
diff --git a/Cargo.toml b/Cargo.toml
index a3c6824..d3d23ac 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -18,6 +18,7 @@ env_logger = "^0.7"
 log = "^0.4.6"
 
 [dependencies]
-cpython = { version = "0.7", features = ["extension-module"] }
+# https://github.com/dgrunwald/rust-cpython/pull/300
+cpython = { git = "https://github.com/Xiretza/rust-cpython", rev = "f6c2cd2319bcf1187533909bb09ba2be58bd6eaa", features = ["extension-module"] }
 libsodium-sys = { version = "0.2.7", features = ["use-pkg-config"] }
 etebase = { version = "^0.6.0" }
-- 
2.53.0

