post_install() {
  echo "==> WPS Office KR - 한글 설정 후속 프로세스 실행 중..."
  
  # 시스템 레벨 (locale, setup.cfg, Office.conf, mui 검증, font/mime DB)
  if [[ -x /usr/bin/wps-office-kr-setup ]]; then
    /usr/bin/wps-office-kr-setup --system 2>&1 | sed 's/^/  /' || true
  fi

  # 사용자 레벨: 설치를 실행한 사용자의 홈에 대해 (SUDO_USER 고려는 스크립트 내부에서)
  if [[ -x /usr/bin/wps-office-kr-setup ]]; then
    /usr/bin/wps-office-kr-setup --user 2>&1 | sed 's/^/  /' || true
    # sudo로 설치 시 실제 사용자 홈도 함께 처리 (스크립트가 SUDO_USER 처리)
  fi

  # 추가: pacman hook 대신 직접 DB 갱신 (hook이 없는 환경 대비)
  update-mime-database /usr/share/mime 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
  fc-cache -f 2>/dev/null || true

  echo "==> WPS Office KR 설치 후 설정 완료. 검증: wps-office-kr-setup --check"
  echo "    문제가 있으면: sudo wps-office-kr-setup --verbose"
}

post_upgrade() {
  post_install
}

pre_remove() {
  # 제거 시 사용자 설정은 유지 (Office.conf 백업 유지)
  echo "==> WPS Office KR 제거 중 - 사용자 설정(~/.config/Kingsoft/Office.conf)은 유지됩니다."
}

post_remove() {
  update-mime-database /usr/share/mime 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
  echo "==> 제거 완료. 한글 로케일(/etc/locale.conf)은 수동으로 확인하세요."
}
