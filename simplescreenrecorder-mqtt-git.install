post_install() {
	update-desktop-database -q
	gtk-update-icon-cache -q -f usr/share/icons/hicolor
	ldconfig
	echo ">>> SimpleScreenRecorder MQTT: shared settings for ssr and ssr-rc are"
	echo ">>> created automatically on first start:"
	echo ">>>   ~/.config/simplescreenrecorder/mqtt.yaml"
}
post_upgrade() {
	post_install
}
post_remove() {
	post_install
}
