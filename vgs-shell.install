# shellcheck shell=bash  # pacman sources .install scriptlets with bash; no shebang by design
post_install() {
  cat <<'EOF'
VGS is installed. Finish the setup for your account with:

  vshell setup

That reports the optional feature dependencies and which app owns
org.freedesktop.Notifications, then enables and starts vshell.service.
EOF
}

post_upgrade() {
  cat <<'EOF'
VGS was upgraded. If the shell is not already running, start it with:

  vshell setup
EOF
}
