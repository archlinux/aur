# One timer per instance; override it per instance.

[Unit]
Description=Run rclone-sync@%i every 10 minutes
Documentation=file:/usr/share/doc/rclone-sync-timer/README.md
Documentation=man:rclone(1)

[Timer]
# Every 10 minutes while the machine is on, plus one run shortly after the user
# manager starts (i.e. at login, or at boot with lingering enabled).
OnCalendar=*:0/10
RandomizedDelaySec=1m
OnStartupSec=2min
# Catch up a run missed while the machine was off at the next start.
Persistent=true
Unit=rclone-sync@%i.service

[Install]
WantedBy=timers.target
