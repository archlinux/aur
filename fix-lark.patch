+def get_meta(tree, attribute):
+    """
+    Get a meta attribute (like line or column) from a Lark Tree object.
+    Handles compatibility between newer lark versions (e.g. tree.meta.line)
+    and older versions (e.g. tree.line).
+    """
+    obj = getattr(tree, "meta", tree)
+    return getattr(obj, attribute)
