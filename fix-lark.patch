+// Expression hierarchy -- LALR-compatible operator precedence.
+// Transparent (?) rules collapse to their child when there is only one, so they
+// never appear as named tree nodes.  Named operations (ternary, logical_operation,
+// etc.) are created via -> aliases.  Levels run from lowest to highest precedence.
+
+// Ternary -- right-associative, lowest precedence.
+// The condition is the lor expression immediately before "?".
+?expr: lor
+     | lor "?" expr ":" expr -> ternary
+
+// Logical OR -- left-associative
+?lor: land
+    | lor logical_or_op land -> logical_operation
+
+// Logical AND -- left-associative
+?land: cmp
+     | land logical_and_op cmp -> logical_operation
+
+// Relational / comparison -- left-associative
+?cmp: add
+    | cmp relational_operator add -> relational_operation
+
+// Additive arithmetic -- left-associative
+?add: mul
+    | add arith_add_op mul -> arithmetic_operation
+
+// Multiplicative arithmetic -- left-associative
+?mul: pow
+    | mul arith_mul_op pow -> arithmetic_operation
+
+// Power -- left-associative (matches OpenSCAD behaviour)
+?pow: atomic_expr
+    | pow arith_pow_op atomic_expr -> arithmetic_operation
+
+// Atomic / unary expressions
+?atomic_expr: _meta_element
+     | function_literal
+     | let_expr
+     | signed_expr
+     | not_expr
+// echo_func_expr and assert_func_expr use "echo"/"assert" string literals, making
+// them keywords in expression context. The optional [expr] lets them appear as
+// standalone expressions (e.g. ternary arms) as well as wrapping a value.
+// The LALR contextual lexer keeps them out of statement-start states, so plain
+// module calls  echo(...);  and  assert(...);  continue to work via VARIABLE.
+     | echo_func_expr
+     | assert_func_expr
+
