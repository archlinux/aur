post_install() {
  printf '%s\n' \
    'Run: mip-paper setup [--image /path/to/image.jpg]' \
    'Setup will report the active wallpaper and any remaining QWeather configuration.'
}

post_upgrade() {
  printf '%s\n' \
    'Refresh the per-user KWin coordinator with: mip-paper setup' \
    'Restart active user instances with: mip-paper restart'
}
