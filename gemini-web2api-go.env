# Configuration for the gemini-web2api-go.service systemd unit.
# See: https://github.com/zexadev/gemini-web2api-go
#
# This file is sourced as an EnvironmentFile by systemd, so entries are
# plain KEY=VALUE pairs (no quoting, no "export").
#
# IMPORTANT: unlike some similar proxies, this binary has no --host/--bind
# flag — it always listens on 0.0.0.0:<port> (all interfaces), never just
# loopback. Setting ADMIN_TOKEN below is NOT optional for this deployment;
# without it the admin panel at /admin is reachable, unauthenticated, from
# anything that can reach this host. Put this service behind a firewall
# or reverse proxy if it must not be reachable from outside this machine.

# Admin panel login token (http://<host>:8083/admin). Required — see above.
ADMIN_TOKEN=

# Optional: lock the /v1/* API key to a fixed value (admin panel can no
# longer change it). Leave unset to auto-generate one on first boot and
# manage/rotate it from the admin panel instead.
#API_KEY=

# Optional: use MySQL or PostgreSQL instead of the default SQLite file.
# mysql://user:pass@host:3306/dbname  (or user:pass@tcp(host:3306)/dbname)
# postgres://user:pass@host:5432/dbname?sslmode=disable
#SQL_DSN=

#TZ=UTC
