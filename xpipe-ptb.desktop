[Desktop Entry]
Type=Application
Name=XPipe PTB
Comment=XPipe PTB Public Test Build
TryExec=/opt/xpipe-ptb/bin/xpiped
Exec=/opt/xpipe-ptb/bin/xpipe open %U
Path=/opt/xpipe-ptb
Icon=xpipe-ptb
Terminal=false
Categories=Utility;Development;
StartupNotify=true
StartupWMClass=__WM_CLASS__
MimeType=x-scheme-handler/xpipe;x-scheme-handler/ssh;x-scheme-handler/sftp;x-scheme-handler/s3
