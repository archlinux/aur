post_install() {
    mkdir /var/lib/mediatracker
    echo "To run, systemctl start mediatracker"
    echo "site at localhost:7481"
}

post_upgrade() {
    if [ -d "/home/mediatracker" ]; then
       systemctl stop mediatracker
       usermod -m -d /var/lib/mediatracker mediatracker 
    fi

}

post_remove() {
    userdel mediatracker
}
