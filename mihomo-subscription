class SubscriptionError(RuntimeError):
    pass


class RawSubscriptionError(SubscriptionError):
    """The server returned URI/Base64 nodes instead of Clash/Mihomo YAML."""


def log(message: str) -> None:
    print(f"[{PROGRAM}] {message}", file=sys.stderr)


def load_yaml(path: Path) -> Any:
    try:
        with path.open("r", encoding="utf-8") as file:
            return yaml.safe_load(file)
    except FileNotFoundError as exc:
        raise SubscriptionError(f"文件不存在：{path}") from exc
    except yaml.YAMLError as exc:
        raise SubscriptionError(f"YAML 解析失败：{path}: {exc}") from exc


class MihomoDumper(yaml.SafeDumper):
    """Keep numeric-looking strings strings in both PyYAML and Go YAML."""


def represent_mihomo_string(dumper: yaml.SafeDumper, value: str) -> Any:
    # Go YAML accepts numbers (e.g. 083456 and 1e10) that PyYAML considers
    # strings. Leaving these unquoted can corrupt short-id, passwords, etc.
    style = '"' if re.match(r"^[+-]?(?:[0-9]|\.[0-9])", value) else None
    return dumper.represent_scalar("tag:yaml.org,2002:str", value, style=style)


MihomoDumper.add_representer(str, represent_mihomo_string)


def dump_yaml(data: Any) -> bytes:
    return yaml.dump(
        data,
        Dumper=MihomoDumper,
        allow_unicode=True,
        sort_keys=False,
        default_flow_style=False,
    ).encode("utf-8")


def atomic_write(path: Path, data: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    file_descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        dir=str(path.parent),
    )
    temporary_path = Path(temporary_name)

    try:
        os.fchmod(file_descriptor, mode)
        with os.fdopen(file_descriptor, "wb", closefd=True) as file:
            file.write(data)
            file.flush()
            os.fsync(file.fileno())

        os.replace(temporary_path, path)

        directory_fd = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except Exception:
        temporary_path.unlink(missing_ok=True)
        raise


def ensure_inside(base: Path, candidate: Path) -> Path:
    base_resolved = base.resolve()
    candidate_resolved = candidate.resolve(strict=False)

    try:
        candidate_resolved.relative_to(base_resolved)
    except ValueError as exc:
        raise SubscriptionError(
            f"拒绝访问 home_dir 之外的路径：{candidate_resolved}"
        ) from exc

    return candidate_resolved


def apply_service_group(path: Path, group_name: str, mode: int) -> None:
    """chgrp + chmod，让以独立用户运行的 mihomo.service 能读取文件。"""
    if not group_name:
        return

    try:
        gid = grp.getgrnam(group_name).gr_gid
    except KeyError:
        log(f"警告：用户组 {group_name} 不存在，{path} 保持原属组和权限")
        return

    try:
        os.chown(path, -1, gid)
    except OSError as exc:
        if exc.errno not in (errno.EPERM, errno.EINVAL):
            raise
        log(f"警告：无法将 {path} 的属组设为 {group_name}，请用 root 运行")

    try:
        os.chmod(path, mode)
    except PermissionError:
        log(f"警告：无权将 {path} 的权限设为 {mode:o}，请用 root 运行")


def expand_environment(value: Any) -> Any:
    if isinstance(value, str):
        return os.path.expandvars(value)
    if isinstance(value, list):
        return [expand_environment(item) for item in value]
    if isinstance(value, dict):
        return {key: expand_environment(item) for key, item in value.items()}
    return value


def load_env_file(path: Path, *, override: bool = False) -> None:
    if not path.exists():
        return

    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SubscriptionError(f"无法读取密钥文件：{path}: {exc}") from exc

    for line_number, raw_line in enumerate(lines, 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        if line.startswith("export "):
            line = line[7:].lstrip()

        try:
            parts = shlex.split(line, comments=True, posix=True)
        except ValueError as exc:
            raise SubscriptionError(
                f"密钥文件语法错误：{path}:{line_number}: {exc}"
            ) from exc

        if len(parts) != 1 or "=" not in parts[0]:
            raise SubscriptionError(
                f"密钥文件仅支持 KEY=value 行：{path}:{line_number}"
            )

        key, value = parts[0].split("=", 1)
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            raise SubscriptionError(
                f"密钥文件变量名无效：{path}:{line_number}: {key}"
            )

        if override or key not in os.environ:
            os.environ[key] = value


def read_env_file_value(path: Path, key: str) -> str | None:
    if not path.exists():
        return None

    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SubscriptionError(f"无法读取密钥文件：{path}: {exc}") from exc

    for line_number, raw_line in enumerate(lines, 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        if line.startswith("export "):
            line = line[7:].lstrip()

        try:
            parts = shlex.split(line, comments=True, posix=True)
        except ValueError as exc:
            raise SubscriptionError(
                f"密钥文件语法错误：{path}:{line_number}: {exc}"
            ) from exc

        if len(parts) != 1 or "=" not in parts[0]:
            continue

        found_key, value = parts[0].split("=", 1)
        if found_key == key:
            return value

    return None


def set_env_file_value(path: Path, key: str, value: str) -> None:
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
        raise SubscriptionError(f"变量名无效：{key}")

    lines: list[str] = []
    if path.exists():
        lines = path.read_text(encoding="utf-8").splitlines()

    assignment = f"{key}={shlex.quote(value)}"
    pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(key)}=")
    replaced = False
    new_lines: list[str] = []

    for line in lines:
        if not line.lstrip().startswith("#") and pattern.match(line):
            new_lines.append(assignment)
            replaced = True
        else:
            new_lines.append(line)

    if not replaced:
        if new_lines and new_lines[-1].strip():
            new_lines.append("")
        new_lines.append(assignment)

    atomic_write(path, ("\n".join(new_lines) + "\n").encode("utf-8"), 0o600)


def remove_env_file_value(path: Path, key: str) -> None:
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
        raise SubscriptionError(f"变量名无效：{key}")
    if not path.exists():
        return

    lines = path.read_text(encoding="utf-8").splitlines()
    pattern = re.compile(rf"^\s*(?:export\s+)?{re.escape(key)}=")
    new_lines = [
        line
        for line in lines
        if line.lstrip().startswith("#") or not pattern.match(line)
    ]
    atomic_write(
        path,
        (("\n".join(new_lines) + "\n") if new_lines else "").encode("utf-8"),
        0o600,
    )


def enable_source_in_control_file(
    path: Path,
    *,
    source_id: str,
    url_env: str,
    converter_type: str = "direct",
) -> None:
    control = load_yaml(path)
    configured = configure_source_document(
        control,
        source_id=source_id,
        url_env=url_env,
        converter_type=converter_type,
    )
    atomic_write(path, dump_yaml(configured), 0o600)


def configure_source_document(
    control: Any,
    *,
    source_id: str,
    url_env: str,
    converter_type: str | None = None,
) -> dict[str, Any]:
    """Return a control-file copy with one source enabled and safely configured."""
    if converter_type not in (None, "direct"):
        raise SubscriptionError(f"不支持的 converter.type：{converter_type}")

    if not isinstance(control, dict) or not isinstance(control.get("sources"), list):
        raise SubscriptionError("订阅控制文件格式无效，无法修改来源")

    configured = copy.deepcopy(control)
    for source in configured["sources"]:
        if not isinstance(source, dict) or source.get("id") != source_id:
            continue

        source["enabled"] = True
        source["url_env"] = url_env
        source.pop("url", None)

        if converter_type == "direct":
            source["converter"] = {"type": "direct"}

        return configured

    raise SubscriptionError(f"订阅控制文件中没有来源：{source_id}")


def ask_yes_no(question: str, *, default: bool = False) -> bool:
    suffix = "[Y/n]" if default else "[y/N]"
    answer = input(f"{question} {suffix} ").strip().lower()
    if not answer:
        return default
    return answer in ("y", "yes")


def resolve_source_url(source: dict[str, Any]) -> str:
    direct_url = source.get("url")
    environment_name = source.get("url_env")

    if direct_url and environment_name:
        raise SubscriptionError(
            f"来源 {source['id']} 不能同时设置 url 和 url_env"
        )

    if environment_name:
        value = os.environ.get(str(environment_name), "").strip()
        if not value:
            raise SubscriptionError(
                f"来源 {source['id']} 所需环境变量未设置：{environment_name}"
            )
        return value

    if direct_url:
        return str(direct_url).strip()

    raise SubscriptionError(f"来源 {source['id']} 未设置 url 或 url_env")


def read_limited(response: Any, limit: int) -> bytes:
    data = response.read(limit + 1)
    if len(data) > limit:
        raise SubscriptionError(f"订阅响应超过大小限制：{limit} bytes")
    return data


def fetch_url(
    url: str,
    *,
    headers: dict[str, str],
    timeout: int,
    max_bytes: int,
) -> bytes:
    try:
        request_headers = {
            "User-Agent": "mihomo",
            "Accept": "*/*",
            "Accept-Encoding": "identity",
        }
        request_headers.update(headers)
        request = urllib.request.Request(url, headers=request_headers, method="GET")
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status = getattr(response, "status", 200)
            if not 200 <= status < 300:
                raise SubscriptionError(f"HTTP 状态异常：{status}")
            return read_limited(response, max_bytes)
    except SubscriptionError:
        raise
    except urllib.error.HTTPError as exc:
        raise SubscriptionError(f"HTTP 状态异常：{exc.code}") from exc
    except urllib.error.URLError as exc:
        detail = str(exc.reason).replace(url, "<订阅 URL>")
        raise SubscriptionError(f"下载失败：URLError: {detail}") from exc
    except Exception as exc:
        # Some URL parser errors include the complete URL (and therefore the
        # subscription token). Keep only the exception class in that case.
        raise SubscriptionError(f"下载失败：{type(exc).__name__}") from exc


def decode_text(data: bytes) -> str:
    for encoding in ("utf-8-sig", "utf-8"):
        try:
            return data.decode(encoding)
        except UnicodeDecodeError:
            continue

    raise SubscriptionError("订阅内容不是有效 UTF-8 文本")


def looks_like_raw_subscription(text: str) -> bool:
    stripped = text.strip()

    if any(scheme in stripped for scheme in RAW_SCHEMES):
        return True

    compact = "".join(stripped.split())
    if len(compact) >= 16 and re.fullmatch(r"[A-Za-z0-9+/=_-]+", compact):
        return True

    return False


def extract_proxies(text: str, source_id: str) -> list[dict[str, Any]]:
    try:
        document = yaml.safe_load(text)
    except yaml.YAMLError as exc:
        if looks_like_raw_subscription(text):
            raise RawSubscriptionError(
                f"来源 {source_id} 看起来是 URI/Base64 订阅"
            ) from exc
        raise SubscriptionError(f"来源 {source_id} 的 YAML 无法解析：{exc}") from exc

    proxies: Any
    if isinstance(document, dict) and isinstance(document.get("payload"), list):
        proxies = document["payload"]
    elif isinstance(document, dict) and isinstance(document.get("proxies"), list):
        proxies = document["proxies"]
    elif isinstance(document, list):
        proxies = document
    else:
        if looks_like_raw_subscription(text):
            raise RawSubscriptionError(f"来源 {source_id} 是 URI/Base64 原始订阅格式")
        raise SubscriptionError(f"来源 {source_id} 不包含 proxies 或 payload 列表")

    normalized: list[dict[str, Any]] = []
    for index, item in enumerate(proxies):
        if not isinstance(item, dict):
            raise SubscriptionError(
                f"来源 {source_id} 的第 {index + 1} 个节点不是映射对象"
            )

        node = copy.deepcopy(item)
        name = node.get("name")
        node_type = node.get("type")

        if not isinstance(name, str) or not name.strip():
            raise SubscriptionError(
                f"来源 {source_id} 的第 {index + 1} 个节点缺少有效 name"
            )

        if not isinstance(node_type, str) or not node_type.strip():
            raise SubscriptionError(f"来源 {source_id} 的节点 {name!r} 缺少有效 type")

        normalized.append(node)

    return normalized


def apply_prefix_and_validate_names(
    proxies: list[dict[str, Any]],
    *,
    source_id: str,
    prefix: str,
) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    names: set[str] = set()

    for node in proxies:
        new_node = copy.deepcopy(node)
        new_name = f"{prefix}{str(node['name']).strip()}"

        if new_name in names:
            raise SubscriptionError(f"来源 {source_id} 中存在重名节点：{new_name}")

        names.add(new_name)
        new_node["name"] = new_name
        result.append(new_node)

    return result


def normalize_source(
    source: dict[str, Any],
    *,
    timeout: int,
    max_bytes: int,
) -> list[dict[str, Any]]:
    source_id = str(source["id"])
    source_url = resolve_source_url(source)
    converter = source.get("converter") or {"type": "direct"}
    if not isinstance(converter, dict) or converter.get("type", "direct") != "direct":
        raise SubscriptionError(
            f"来源 {source_id} 仍使用旧转换配置；本版本只支持 Clash/Mihomo YAML。"
            "main 来源可运行 mihomo-webui-setup subscription --converter direct，"
            "其他来源请将 converter.type 改为 direct 并提供 YAML 订阅"
        )
    headers = expand_environment(source.get("headers") or {})
    headers = {str(key): str(value) for key, value in headers.items()}
    explicit_user_agents = [
        value for key, value in headers.items() if key.lower() == "user-agent"
    ]
    headers = {
        key: value for key, value in headers.items() if key.lower() != "user-agent"
    }
    preferred_user_agent = (
        explicit_user_agents[-1]
        if explicit_user_agents
        else str(source.get("user_agent", "mihomo"))
    ).strip()
    candidates: list[str] = []
    for candidate in (preferred_user_agent, *COMPATIBLE_USER_AGENTS):
        if candidate and candidate not in candidates:
            candidates.append(candidate)

    proxies: list[dict[str, Any]] | None = None
    for index, user_agent in enumerate(candidates):
        request_headers = dict(headers)
        request_headers["User-Agent"] = user_agent
        raw_data = fetch_url(
            source_url,
            headers=request_headers,
            timeout=timeout,
            max_bytes=max_bytes,
        )
        try:
            proxies = extract_proxies(decode_text(raw_data), source_id)
            break
        except RawSubscriptionError as exc:
            if index + 1 == len(candidates):
                raise RawSubscriptionError(
                    f"来源 {source_id} 已尝试 {len(candidates)} 种 Mihomo/Clash "
                    "客户端标识，但服务商仍只返回 URI/Base64 原始订阅；"
                    "请获取 Clash/Mihomo YAML 订阅入口。工具不会自动拼接 "
                    "target=clash 等非标准 URL 参数，也不转换原始协议订阅"
                ) from exc
            log(
                f"来源 {source_id} 返回 URI/Base64 原始订阅，"
                f"正在尝试兼容客户端标识（{index + 2}/{len(candidates)}）"
            )

    if proxies is None:  # candidates always contains at least the built-in values.
        raise SubscriptionError(f"来源 {source_id} 没有可用的客户端标识")
    prefix = str(source.get("prefix", f"[{source_id}] "))
    proxies = apply_prefix_and_validate_names(
        proxies,
        source_id=source_id,
        prefix=prefix,
    )

    if not proxies and not bool(source.get("allow_empty", False)):
        raise SubscriptionError(f"来源 {source_id} 没有节点；为防止清空配置，已拒绝更新")

    return proxies


def validate_control_inventory(
    control: Any,
) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    if not isinstance(control, dict):
        raise SubscriptionError("控制文件顶层必须是映射")

    if control.get("version") != 1:
        raise SubscriptionError("仅支持 version: 1")

    settings = control.get("settings")
    sources = control.get("sources")

    if not isinstance(settings, dict):
        raise SubscriptionError("缺少 settings 映射")

    if not isinstance(sources, list):
        raise SubscriptionError("缺少 sources 列表")

    seen_ids: set[str] = set()
    validated_sources: list[dict[str, Any]] = []

    for source in sources:
        if not isinstance(source, dict):
            raise SubscriptionError("sources 中的每一项都必须是映射")

        source_id = source.get("id")
        if not isinstance(source_id, str) or not SOURCE_ID_RE.fullmatch(source_id):
            raise SubscriptionError("source.id 只能包含字母、数字、点、下划线和连字符")

        if source_id in seen_ids:
            raise SubscriptionError(f"重复的 source.id：{source_id}")

        seen_ids.add(source_id)

        validated_sources.append(source)

    return settings, validated_sources


def validate_control_file(control: Any) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    settings, sources = validate_control_inventory(control)
    validated_sources = [
        source for source in sources if bool(source.get("enabled", True))
    ]

    if not validated_sources:
        raise SubscriptionError("没有已启用的订阅来源")

    return settings, validated_sources


def load_cached_payload(cache_file: Path, source_id: str) -> list[dict[str, Any]]:
    cached = load_yaml(cache_file)

    if not isinstance(cached, dict) or not isinstance(cached.get("payload"), list):
        raise SubscriptionError(f"来源 {source_id} 的缓存格式无效：{cache_file}")
    if not cached["payload"] or any(
        not isinstance(node, dict)
        or not isinstance(node.get("name"), str) or not node["name"].strip()
        or not isinstance(node.get("type"), str) or not node["type"].strip()
        for node in cached["payload"]
    ):
        raise SubscriptionError(f"来源 {source_id} 的缓存节点无效：{cache_file}")

    return cached["payload"]


def build_candidate(
    settings: dict[str, Any],
    sources: list[dict[str, Any]],
    *,
    strict: bool,
) -> tuple[bytes, dict[str, bytes], list[str]]:
    timeout = int(settings.get("timeout_seconds", 30))
    max_bytes = int(settings.get("max_download_bytes", 8 * 1024 * 1024))
    cache_dir = Path(str(settings.get("cache_dir", "/var/lib/mihomo-subscription/cache")))

    all_nodes: list[dict[str, Any]] = []
    cache_candidates: dict[str, bytes] = {}
    fallback_sources: list[str] = []
    global_names: set[str] = set()

    for source in sources:
        source_id = str(source["id"])
        cache_file = cache_dir / f"{source_id}.yaml"

        try:
            nodes = normalize_source(source, timeout=timeout, max_bytes=max_bytes)
            cache_candidates[source_id] = dump_yaml({"payload": nodes})
            log(f"来源 {source_id}：获取到 {len(nodes)} 个节点")
        except Exception as exc:
            if strict or not cache_file.exists():
                raise SubscriptionError(
                    f"来源 {source_id} 更新失败，且无法使用缓存：{exc}"
                ) from exc

            nodes = load_cached_payload(cache_file, source_id)
            fallback_sources.append(source_id)
            log(
                f"警告：来源 {source_id} 更新失败，"
                f"继续使用上一份缓存（{len(nodes)} 个节点）"
            )

        for node in nodes:
            name = str(node["name"])
            if name in global_names:
                raise SubscriptionError(f"聚合后出现重名节点：{name}")
            global_names.add(name)
            all_nodes.append(node)

    if not all_nodes:
        raise SubscriptionError("聚合结果为空，拒绝覆盖现有 provider")

    # Mihomo 的 file 类型 proxy-provider 要求顶层字段为 proxies。
    # payload 是 rule-provider 的格式，写成 payload 会被核心拒绝加载。
    return dump_yaml({"proxies": all_nodes}), cache_candidates, fallback_sources


def validate_with_mihomo(
    settings: dict[str, Any],
    provider_bytes: bytes,
    *,
    config_document: dict[str, Any] | None = None,
) -> None:
    binary = Path(str(settings.get("mihomo_binary", "/usr/bin/mihomo")))
    home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
    config_file = Path(str(settings.get("config_file", home_dir / "config.yaml")))
    provider_name = str(settings.get("provider_name", "subscriptions"))
    provider_relative = Path(str(settings.get("provider_file", "providers/subscriptions.yaml")))

    if provider_relative.is_absolute():
        raise SubscriptionError("provider_file 必须是相对于 home_dir 的路径")

    provider_absolute = ensure_inside(home_dir, home_dir / provider_relative)
    test_config = ensure_inside(home_dir, home_dir / ".subscription-test.yaml")

    if config_document is None:
        main_config = load_yaml(config_file)
    else:
        main_config = config_document
    if not isinstance(main_config, dict):
        raise SubscriptionError("Mihomo 主配置顶层必须是映射")

    providers = main_config.get("proxy-providers")
    if not isinstance(providers, dict):
        raise SubscriptionError("主配置缺少 proxy-providers")

    provider_config = providers.get(provider_name)
    if not isinstance(provider_config, dict):
        raise SubscriptionError(f"主配置缺少 proxy-providers.{provider_name}")

    if provider_config.get("type") != "file":
        raise SubscriptionError(f"proxy-providers.{provider_name}.type 必须是 file")

    try:
        provider_document = yaml.safe_load(provider_bytes)
    except yaml.YAMLError as exc:
        raise SubscriptionError("候选 provider 不是有效 YAML") from exc
    if not isinstance(provider_document, dict) or not isinstance(
        provider_document.get("proxies"), list
    ):
        raise SubscriptionError("候选 provider 缺少 proxies 列表")

    test_document = copy.deepcopy(main_config)
    # `mihomo -t` does not load file provider contents. Inline the candidate
    # only in the disposable test config so the core validates every node,
    # with the same provider filters/overrides and group references.
    test_provider = test_document["proxy-providers"][provider_name]
    test_provider["type"] = "inline"
    test_provider.pop("path", None)
    test_provider["payload"] = provider_document["proxies"]

    validation_environment = os.environ.copy()
    safe_paths: list[str] = []
    existing_safe_paths = validation_environment.get("SAFE_PATHS", "")
    if existing_safe_paths:
        safe_paths.extend(existing_safe_paths.split(os.pathsep))

    configured_safe_paths = settings.get("safe_paths", [])
    if isinstance(configured_safe_paths, str):
        safe_paths.append(configured_safe_paths)
    elif isinstance(configured_safe_paths, list):
        safe_paths.extend(str(path) for path in configured_safe_paths)

    external_ui = test_document.get("external-ui")
    if isinstance(external_ui, str) and Path(external_ui).is_absolute():
        safe_paths.append(external_ui)

    unique_safe_paths = list(dict.fromkeys(path for path in safe_paths if path))
    if unique_safe_paths:
        validation_environment["SAFE_PATHS"] = os.pathsep.join(unique_safe_paths)

    try:
        atomic_write(test_config, dump_yaml(test_document), 0o600)
        completed = subprocess.run(
            [str(binary), "-t", "-d", str(home_dir), "-f", str(test_config)],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=45,
            check=False,
            env=validation_environment,
        )

        if completed.returncode != 0:
            output = completed.stdout.strip()
            raise SubscriptionError("Mihomo 配置校验失败：\n" + output[-4000:])
    except subprocess.TimeoutExpired as exc:
        raise SubscriptionError("Mihomo 配置校验超时") from exc
    finally:
        test_config.unlink(missing_ok=True)

    ensure_inside(home_dir, provider_absolute)


def install_provider(
    settings: dict[str, Any],
    provider_bytes: bytes,
    cache_candidates: dict[str, bytes],
    *,
    dry_run: bool,
) -> Path:
    home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
    provider_relative = Path(str(settings.get("provider_file", "providers/subscriptions.yaml")))
    provider_file = ensure_inside(home_dir, home_dir / provider_relative)
    state_dir = Path(str(settings.get("state_dir", "/var/lib/mihomo-subscription")))
    cache_dir = Path(str(settings.get("cache_dir", state_dir / "cache")))
    provider_group = str(settings.get("provider_group", "mihomo"))

    if dry_run:
        return provider_file

    state_dir.mkdir(parents=True, exist_ok=True)
    cache_dir.mkdir(parents=True, exist_ok=True)

    if provider_file.exists():
        previous_file = state_dir / "subscriptions.yaml.previous"
        shutil.copy2(provider_file, previous_file)
        os.chmod(previous_file, 0o600)

    atomic_write(provider_file, provider_bytes, 0o600)
    apply_service_group(provider_file, provider_group, 0o640)

    for source_id, cache_bytes in cache_candidates.items():
        atomic_write(cache_dir / f"{source_id}.yaml", cache_bytes, 0o600)

    return provider_file


def reload_mihomo(settings: dict[str, Any], *, no_reload: bool) -> None:
    if no_reload:
        log("已跳过 Mihomo 重载")
        return

    service_name = str(settings.get("service_name", "mihomo.service"))
    active = subprocess.run(["systemctl", "is-active", "--quiet", service_name], check=False)

    if active.returncode != 0:
        log(f"{service_name} 当前未运行，不执行重载")
        return

    show = subprocess.run(
        ["systemctl", "show", service_name, "-p", "CanReload", "--value"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    action = "reload" if show.stdout.strip() == "yes" else "restart"
    if action == "restart":
        log(f"{service_name} 不支持 reload，改用 restart 使新节点生效")

    completed = subprocess.run(["systemctl", action, service_name], check=False)
    if completed.returncode != 0:
        raise SubscriptionError(
            f"provider 已更新，但 {action} {service_name} 失败；"
            f"请手工执行 systemctl restart {service_name}"
        )


def acquire_lock() -> Any:
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    lock_handle = LOCK_FILE.open("w", encoding="utf-8")

    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as exc:
        lock_handle.close()
        raise SubscriptionError("已有另一个更新进程正在运行") from exc

    return lock_handle


def native_policy(document: Any, provider_name: str) -> dict[str, Any]:
    """Extract native policy fields; server settings in a template are ignored."""
    if not isinstance(document, dict):
        raise SubscriptionError("规则模板顶层必须是 YAML 映射")
    groups = document.get("proxy-groups")
    rules = document.get("rules")
    providers = document.get("rule-providers", {})
    if not isinstance(groups, list) or not groups:
        raise SubscriptionError("规则模板缺少 proxy-groups")
    if not isinstance(rules, list) or not rules or not all(
        isinstance(rule, str) and rule.strip() for rule in rules
    ):
        raise SubscriptionError("规则模板的 rules 必须是非空字符串列表")
    if not isinstance(providers, dict) or not all(
        isinstance(name, str) and isinstance(value, dict)
        for name, value in providers.items()
    ):
        raise SubscriptionError("规则模板的 rule-providers 必须是映射")
    groups = copy.deepcopy(groups)
    names: set[str] = set()
    for group in groups:
        if not isinstance(group, dict) or not isinstance(group.get("name"), str):
            raise SubscriptionError("规则模板策略组缺少有效 name")
        name = group["name"]
        if not name.strip() or name in names:
            raise SubscriptionError(f"规则模板策略组名称为空或重复：{name}")
        names.add(name)
        for key in ("use", "proxies"):
            if key in group and (
                not isinstance(group[key], list)
                or not all(isinstance(member, str) for member in group[key])
            ):
                raise SubscriptionError(f"策略组 {name} 的 {key} 必须是字符串列表")
        if "use" in group:
            group["use"] = [
                provider_name if member == "subscriptions" else member
                for member in group["use"]
            ]
    return {
        "proxy-groups": groups,
        "rules": copy.deepcopy(rules),
        "rule-providers": copy.deepcopy(providers),
    }


def policy_state_path(settings: dict[str, Any]) -> Path:
    state_dir = Path(str(settings.get("state_dir", "/var/lib/mihomo-subscription")))
    return state_dir / "policy-state.yaml"


def describe_policy(policy: dict[str, Any], source_id: str = "native") -> dict[str, Any]:
    return {
        "version": POLICY_STATE_VERSION,
        "source_id": source_id,
        "proxy_groups": sorted(group["name"] for group in policy["proxy-groups"]),
        "rule_providers": sorted(policy.get("rule-providers", {})),
    }


def prepare_rule_cache(settings: dict[str, Any]) -> None:
    """Allow the service user to cache native HTTP rule providers."""
    home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
    directory = ensure_inside(home_dir, home_dir / "ruleset")
    directory.mkdir(parents=True, exist_ok=True)
    apply_service_group(directory, str(settings.get("provider_group", "mihomo")), 0o2770)


def load_policy_state(path: Path) -> tuple[set[str], set[str]]:
    if not path.exists():
        return set(), set()

    state = load_yaml(path)
    if not isinstance(state, dict) or state.get("version") != POLICY_STATE_VERSION:
        raise SubscriptionError(f"规则托管状态文件格式无效：{path}")

    groups = state.get("proxy_groups", [])
    providers = state.get("rule_providers", [])
    if not isinstance(groups, list) or not all(isinstance(item, str) for item in groups):
        raise SubscriptionError(f"规则托管状态文件的 proxy_groups 无效：{path}")
    if not isinstance(providers, list) or not all(
        isinstance(item, str) for item in providers
    ):
        raise SubscriptionError(f"规则托管状态文件的 rule_providers 无效：{path}")

    return set(groups), set(providers)


def render_policy_config(
    existing: dict[str, Any],
    policy: dict[str, Any],
    *,
    source_id: str,
    provider_name: str,
    previous_groups: set[str],
    previous_rule_providers: set[str],
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Merge only ACL policy sections while preserving every other top-level key."""
    policy = native_policy(policy, provider_name)
    incoming_groups = policy["proxy-groups"]
    incoming_by_name = {group["name"]: group for group in incoming_groups}
    incoming_group_names = set(incoming_by_name)

    current_groups = existing.get("proxy-groups", [])
    if not isinstance(current_groups, list):
        raise SubscriptionError("现有主配置的 proxy-groups 必须是列表")

    preserved_groups: list[dict[str, Any]] = []
    preserved_names: set[str] = set()
    for index, group in enumerate(current_groups, 1):
        if not isinstance(group, dict) or not isinstance(group.get("name"), str):
            raise SubscriptionError(f"现有主配置的第 {index} 个策略组缺少有效 name")
        name = str(group["name"])
        if name in previous_groups or group == incoming_by_name.get(name):
            continue
        preserved_groups.append(copy.deepcopy(group))
        preserved_names.add(name)

    conflicts = sorted(incoming_group_names & preserved_names)
    if conflicts:
        raise SubscriptionError(
            "ACL4SSR 策略组与本机非托管组重名，拒绝覆盖：" + "、".join(conflicts)
        )

    incoming_providers = copy.deepcopy(policy.get("rule-providers", {}))
    incoming_provider_names = set(incoming_providers)
    current_providers = existing.get("rule-providers", {})
    if not isinstance(current_providers, dict):
        raise SubscriptionError("现有主配置的 rule-providers 必须是映射")
    preserved_providers = {
        str(name): copy.deepcopy(value)
        for name, value in current_providers.items()
        if str(name) not in previous_rule_providers
        and value != incoming_providers.get(str(name))
    }
    provider_conflicts = sorted(incoming_provider_names & set(preserved_providers))
    if provider_conflicts:
        raise SubscriptionError(
            "ACL4SSR rule-provider 与本机非托管项重名，拒绝覆盖："
            + "、".join(provider_conflicts)
        )

    rendered = copy.deepcopy(existing)
    rendered["proxy-groups"] = preserved_groups + incoming_groups
    rendered["rules"] = copy.deepcopy(policy["rules"])
    if preserved_providers or incoming_providers:
        rendered["rule-providers"] = {**preserved_providers, **incoming_providers}
    else:
        rendered.pop("rule-providers", None)

    state = describe_policy(policy, source_id)
    return rendered, state


def command_rules(args: argparse.Namespace) -> int:
    """Apply a local native policy without downloading or converting subscriptions."""
    user_policy = getattr(args, "policy_document", None)
    if user_policy is None and not args.dry_run and not args.yes:
        if not sys.stdin.isatty():
            raise SubscriptionError("非交互环境必须使用 --yes 确认同步规则")
        if not ask_yes_no(
            "将用 ACL4SSR 规则替换当前 rules，并自动维护相关策略组，继续？",
            default=False,
        ):
            log("已取消，未修改任何文件")
            return 0

    lock_handle = acquire_lock()
    try:
        control = load_yaml(args.control_file)
        if not isinstance(control, dict) or not isinstance(control.get("settings"), dict):
            raise SubscriptionError("订阅控制文件缺少 settings")
        settings = control["settings"]
        source_id = "user" if user_policy is not None else "native"
        policy = native_policy(
            user_policy if user_policy is not None else load_yaml(args.template_file),
            str(settings.get("provider_name", "subscriptions")),
        )

        home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
        config_file = Path(str(settings.get("config_file", home_dir / "config.yaml")))
        provider_relative = Path(
            str(settings.get("provider_file", "providers/subscriptions.yaml"))
        )
        provider_file = ensure_inside(home_dir, home_dir / provider_relative)
        if not provider_file.exists():
            raise SubscriptionError(f"provider 文件不存在，请先更新订阅：{provider_file}")

        existing = load_yaml(config_file)
        if not isinstance(existing, dict):
            raise SubscriptionError("现有主配置顶层必须是映射")

        state_file = policy_state_path(settings)
        old_groups, old_providers = load_policy_state(state_file)
        rendered, state = render_policy_config(
            existing,
            policy,
            source_id=source_id,
            provider_name=str(settings.get("provider_name", "subscriptions")),
            previous_groups=old_groups,
            previous_rule_providers=old_providers,
        )
        if user_policy is not None:
            validate_user_policy_paths(policy, home_dir)
            print_policy_diff(existing, rendered, "system/current", "system/candidate")
            if not args.yes and not confirm_policy_apply():
                log("已取消，未替换系统配置")
                return 3
        provider_bytes = provider_file.read_bytes()
        validate_with_mihomo(settings, provider_bytes, config_document=rendered)

        if args.dry_run:
            log(
                f"ACL4SSR 校验成功：{len(state['proxy_groups'])} 个策略组、"
                f"{len(policy['rules'])} 条规则；dry-run 未修改正式文件"
            )
            return 0

        original_config = config_file.read_bytes()
        original_state = state_file.read_bytes() if state_file.exists() else None
        prepare_rule_cache(settings)
        backup = config_file.with_suffix(".yaml.policy.bak")
        shutil.copy2(config_file, backup)
        os.chmod(backup, 0o600)

        try:
            atomic_write(config_file, dump_yaml(rendered), 0o600)
            apply_service_group(
                config_file,
                str(settings.get("provider_group", "mihomo")),
                0o640,
            )
            atomic_write(state_file, dump_yaml(state), 0o600)
            reload_mihomo(settings, no_reload=args.no_reload)
        except Exception as exc:
            log(f"规则同步失败（{exc}），正在回滚……")
            rollback_problems: list[str] = []
            try:
                atomic_write(config_file, original_config, 0o600)
                apply_service_group(
                    config_file,
                    str(settings.get("provider_group", "mihomo")),
                    0o640,
                )
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {config_file} 失败：{rollback_exc}")
            try:
                if original_state is None:
                    state_file.unlink(missing_ok=True)
                else:
                    atomic_write(state_file, original_state, 0o600)
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {state_file} 失败：{rollback_exc}")

            if rollback_problems:
                raise SubscriptionError(
                    "规则同步失败且回滚不完整："
                    + "；".join(rollback_problems)
                    + f"；可从备份手工恢复：{backup}"
                ) from exc
            if user_policy is not None and not args.no_reload:
                try:
                    reload_mihomo(settings, no_reload=False)
                except Exception as rollback_exc:
                    raise SubscriptionError(
                        f"已恢复磁盘配置，但恢复后的重载失败：{rollback_exc}；备份：{backup}"
                    ) from exc
            raise SubscriptionError(
                f"规则同步失败，已恢复原配置（备份：{backup}）；"
                f"若服务状态异常请手工重启 Mihomo。原因：{exc}"
            ) from exc

        log(
            f"ACL4SSR 已同步：{len(state['proxy_groups'])} 个策略组、"
            f"{len(policy['rules'])} 条规则"
        )
        log(f"主配置：{config_file}")
        return 0
    finally:
        lock_handle.close()


def policy_sections(document: dict[str, Any]) -> dict[str, Any]:
    return {key: copy.deepcopy(document.get(key, {} if key == "rule-providers" else []))
            for key in POLICY_KEYS}


def print_policy_diff(before: dict[str, Any], after: dict[str, Any],
                      before_label: str, after_label: str) -> None:
    lines = list(difflib.unified_diff(
        dump_yaml(policy_sections(before)).decode().splitlines(keepends=True),
        dump_yaml(policy_sections(after)).decode().splitlines(keepends=True),
        fromfile=before_label, tofile=after_label,
    ))
    if lines:
        print("".join(lines), end="", flush=True)
    else:
        log("规则与策略组没有差异")


def validate_user_policy_paths(policy: dict[str, Any], home_dir: Path | None = None) -> None:
    cache_dir = ensure_inside(home_dir, home_dir / "ruleset") if home_dir is not None else None
    paths: set[str] = set()
    for name, provider in policy["rule-providers"].items():
        if provider.get("type") == "inline":
            if "path" in provider:
                raise SubscriptionError(f"inline 规则来源 {name} 不应设置 path")
            continue
        if provider.get("type") != "http":
            raise SubscriptionError(f"用户规则来源 {name} 仅支持 http 或 inline")
        url = provider.get("url", "")
        if not isinstance(url, str) or urllib.parse.urlsplit(url).scheme not in ("http", "https"):
            raise SubscriptionError(f"规则来源 {name} 必须使用 HTTP(S) URL")
        path = provider.get("path")
        if not isinstance(path, str):
            raise SubscriptionError(f"规则来源 {name} 必须设置 ruleset/ 下的缓存 path")
        relative = Path(path)
        if relative.is_absolute() or ".." in relative.parts or len(relative.parts) != 2 or relative.parts[0] != "ruleset":
            raise SubscriptionError(f"规则来源 {name} 的 path 必须是 ./ruleset/文件名")
        resolved = ensure_inside(cache_dir, cache_dir / relative.name) if cache_dir is not None else relative
        if str(resolved) in paths:
            raise SubscriptionError(f"规则来源缓存 path 重复：{path}")
        paths.add(str(resolved))


def parse_user_policy(data: bytes) -> dict[str, Any]:
    if len(data) > POLICY_MAX_BYTES:
        raise SubscriptionError("用户策略文件超过 2 MiB 限制")
    try:
        document = yaml.safe_load(data)
    except (yaml.YAMLError, UnicodeError) as exc:
        raise SubscriptionError(f"用户策略 YAML 解析失败：{exc}") from exc
    if not isinstance(document, dict):
        raise SubscriptionError("用户策略必须是 YAML 映射")
    unexpected = set(document) - set(POLICY_KEYS)
    if unexpected:
        raise SubscriptionError("用户策略只允许 proxy-groups、rule-providers、rules；不允许："
                                + ", ".join(sorted(map(str, unexpected))))
    policy = native_policy(document, "subscriptions")
    # Lexical checks here; repeat against actual system paths after elevation.
    validate_user_policy_paths(policy)
    return policy


def check_user_policy(policy: dict[str, Any]) -> None:
    """Unprivileged core validation, using no system config or real subscription."""
    with tempfile.TemporaryDirectory(prefix="mihomo-policy-check-") as temporary:
        home = Path(temporary)
        country = Path("/etc/clash/Country.mmdb")
        if country.is_file():
            shutil.copyfile(country, home / "Country.mmdb")
        config = copy.deepcopy(policy)
        config["proxy-providers"] = {"subscriptions": {
            "type": "file", "path": "./providers/subscriptions.yaml",
        }}
        config["dns"] = {"enable": False}
        provider = dump_yaml({"proxies": [{
            "name": "__policy_check_node__", "type": "http", "server": "127.0.0.1", "port": 9,
        }]})
        validate_with_mihomo({"home_dir": str(home)}, provider, config_document=config)
    log("本地校验通过（使用占位节点；apply 会结合真实节点和系统配置重新校验）")


def confirm_policy_apply() -> bool:
    try:
        # Buffered r+ requires a seekable stream in Python. A terminal is not
        # seekable; use separate streams, keeping stdin free for the snapshot.
        with open("/dev/tty", "r", encoding="utf-8") as reader, \
             open("/dev/tty", "w", encoding="utf-8") as writer:
            writer.write("应用以上系统策略变更并重载 Mihomo？[y/N] ")
            writer.flush()
            return reader.readline().strip().lower() in ("y", "yes")
    except OSError as exc:
        raise SubscriptionError(f"无法交互确认（{exc}），请使用 --yes") from exc


def command_apply_policy(args: argparse.Namespace) -> int:
    """Privileged endpoint: read a bounded snapshot, never reopen a user path."""
    if os.geteuid() != 0:
        raise SubscriptionError("内部应用命令必须由管理员运行")
    policy = parse_user_policy(sys.stdin.buffer.read(POLICY_MAX_BYTES + 1))
    return command_rules(argparse.Namespace(
        control_file=DEFAULT_CONTROL_FILE, template_file=None,
        policy_document=policy, yes=args.yes, dry_run=False, no_reload=False,
    ))


def user_policy_path() -> Path:
    root = os.environ.get("XDG_CONFIG_HOME")
    directory = Path(root) if root and Path(root).is_absolute() else Path.home() / ".config"
    return directory / "mihomo-webui-config" / "policy.yaml"


def command_user_policy(args: argparse.Namespace) -> int:
    if os.geteuid() == 0:
        raise SubscriptionError("请以普通用户运行此命令，不要加 sudo；apply 会按需提权")
    path = (args.file or user_policy_path()).expanduser().absolute()
    baseline = path.with_name(path.name + ".applied")
    if args.command == "policy-init":
        data = dump_yaml(native_policy(load_yaml(SHARE_DIR / "config.base.yaml"), "subscriptions"))
        path.parent.mkdir(parents=True, exist_ok=True)
        # Exclusive creation: never overwrite an existing edit or follow a symlink.
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
        log(f"已从软件包模板创建用户策略：{path}（不是运行配置的导出）")
        return 0

    with path.open("rb") as source:
        policy = parse_user_policy(source.read(POLICY_MAX_BYTES + 1))
    if args.command == "diff":
        if baseline.exists():
            before = load_yaml(baseline)
            label = "local/last-successful-apply"
        else:
            before = native_policy(load_yaml(SHARE_DIR / "config.base.yaml"), "subscriptions")
            label = "package/template (no local apply record)"
        log("本地差异不代表系统当前状态；apply 提权后会显示实际系统差异")
        print_policy_diff(before, policy, label, str(path))
        return 0

    check_user_policy(policy)
    if args.command == "check":
        return 0
    if not args.yes and not sys.stdin.isatty():
        raise SubscriptionError("非交互环境必须使用 --yes 确认应用")
    snapshot = dump_yaml(policy)
    command = ["sudo", "--", "/usr/bin/mihomo-subscription", "_apply-policy"]
    if args.yes:
        command.append("--yes")
    result = subprocess.run(command, input=snapshot, check=False)
    if result.returncode == 3:
        return 0  # Cancelled; do not advance the local baseline.
    if result.returncode:
        raise SubscriptionError("系统策略未成功应用，本地成功记录未更新")
    try:
        atomic_write(baseline, snapshot, 0o600)
    except OSError as exc:
        log(f"系统应用已成功，但无法保存本地差异基线：{exc}")
        return 1
    log(f"已应用；用户源文件保留在 {path}")
    return 0


def command_update(args: argparse.Namespace) -> int:
    lock_handle = acquire_lock()

    try:
        if args.secrets_file is not None:
            load_env_file(args.secrets_file)

        control = load_yaml(args.control_file)
        settings, sources = validate_control_file(control)

        provider_bytes, cache_candidates, fallback_sources = build_candidate(
            settings,
            sources,
            strict=args.strict,
        )

        validate_with_mihomo(settings, provider_bytes)
        provider_file = install_provider(
            settings,
            provider_bytes,
            cache_candidates,
            dry_run=args.dry_run,
        )

        if args.dry_run:
            log("校验成功；dry-run 模式未写入文件")
            return 0

        reload_mihomo(settings, no_reload=args.no_reload)

        if fallback_sources:
            log("更新完成，但以下来源使用了旧缓存：" + ", ".join(fallback_sources))
        else:
            log("所有订阅来源更新成功")

        log(f"provider 文件：{provider_file}")
        return 0
    finally:
        lock_handle.close()


def profile_env_name(profile_id: str) -> str:
    if not SOURCE_ID_RE.fullmatch(profile_id):
        raise SubscriptionError("订阅 ID 只能包含字母、数字、点、下划线和连字符")
    normalized = re.sub(r"[^A-Za-z0-9_]", "_", profile_id).upper()
    return f"MIHOMO_SUB_{normalized}"


def find_profile(sources: list[dict[str, Any]], profile_id: str) -> dict[str, Any]:
    for source in sources:
        if source.get("id") == profile_id:
            return source
    raise SubscriptionError(f"订阅档案不存在：{profile_id}")


def select_profile(control: dict[str, Any], profile_id: str) -> dict[str, Any]:
    return select_profiles(control, [profile_id])


def select_profiles(control: dict[str, Any], profile_ids: list[str]) -> dict[str, Any]:
    if not profile_ids:
        raise SubscriptionError("至少选择一个订阅")
    if len(set(profile_ids)) != len(profile_ids):
        raise SubscriptionError("不能重复选择同一个订阅")
    _, sources = validate_control_inventory(control)
    for profile_id in profile_ids:
        find_profile(sources, profile_id)
    selected = copy.deepcopy(control)
    for source in selected["sources"]:
        source["enabled"] = source["id"] in profile_ids
    return selected


def build_profile_candidate(
    settings: dict[str, Any],
    sources: list[dict[str, Any]],
    secrets_file: Path,
    overrides: dict[str, str] | None = None,
    *,
    strict: bool = True,
) -> tuple[bytes, dict[str, bytes]]:
    original_environment = os.environ.copy()
    try:
        load_env_file(secrets_file, override=True)
        if overrides:
            os.environ.update(overrides)
        provider_bytes, cache_candidates, _ = build_candidate(
            settings,
            sources,
            strict=strict,
        )
        return provider_bytes, cache_candidates
    finally:
        os.environ.clear()
        os.environ.update(original_environment)


def restore_snapshot(path: Path, original: bytes | None, mode: int = 0o600) -> None:
    if original is None:
        path.unlink(missing_ok=True)
    else:
        atomic_write(path, original, mode)


def commit_profile_candidate(
    args: argparse.Namespace,
    *,
    settings: dict[str, Any],
    candidate_control: dict[str, Any],
    provider_bytes: bytes,
    cache_candidates: dict[str, bytes],
    secret_value: tuple[str, str] | None,
    runtime_changed: bool,
) -> Path:
    home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
    provider_relative = Path(
        str(settings.get("provider_file", "providers/subscriptions.yaml"))
    )
    provider_file = ensure_inside(home_dir, home_dir / provider_relative)
    state_dir = Path(str(settings.get("state_dir", "/var/lib/mihomo-subscription")))
    cache_dir = Path(str(settings.get("cache_dir", state_dir / "cache")))
    cache_files = {
        source_id: cache_dir / f"{source_id}.yaml" for source_id in cache_candidates
    }
    originals = {
        args.control_file: args.control_file.read_bytes(),
        args.secrets_file: (
            args.secrets_file.read_bytes() if args.secrets_file.exists() else None
        ),
    }
    if runtime_changed:
        originals[provider_file] = (
            provider_file.read_bytes() if provider_file.exists() else None
        )
    for cache_file in cache_files.values():
        originals[cache_file] = cache_file.read_bytes() if cache_file.exists() else None

    runtime_touched = False
    try:
        if secret_value is not None:
            set_env_file_value(args.secrets_file, *secret_value)
        atomic_write(args.control_file, dump_yaml(candidate_control), 0o600)
        if runtime_changed:
            runtime_touched = True
            install_provider(
                settings,
                provider_bytes,
                cache_candidates,
                dry_run=False,
            )
            reload_mihomo(settings, no_reload=args.no_reload)
        else:
            cache_dir.mkdir(parents=True, exist_ok=True)
            for source_id, cache_bytes in cache_candidates.items():
                atomic_write(cache_files[source_id], cache_bytes, 0o600)
    except Exception as exc:
        log(f"订阅档案操作失败（{exc}），正在回滚……")
        rollback_problems: list[str] = []
        for path, original in originals.items():
            try:
                restore_snapshot(path, original)
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {path} 失败：{rollback_exc}")

        if runtime_changed and originals.get(provider_file) is not None:
            try:
                apply_service_group(
                    provider_file,
                    str(settings.get("provider_group", "mihomo")),
                    0o640,
                )
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {provider_file} 的权限失败：{rollback_exc}")

        if runtime_touched and not args.no_reload:
            try:
                reload_mihomo(settings, no_reload=False)
            except Exception as rollback_exc:
                rollback_problems.append(f"重新加载已恢复 provider 失败：{rollback_exc}")

        if rollback_problems:
            raise SubscriptionError(
                "订阅档案操作失败且回滚不完整：" + "；".join(rollback_problems)
            ) from exc
        raise SubscriptionError(
            f"订阅档案操作失败，已恢复原配置、provider 与缓存。原因：{exc}"
        ) from exc

    return provider_file


def read_new_subscription_url(args: argparse.Namespace, profile_id: str) -> str | None:
    value = args.subscription_url
    if value is None:
        if not sys.stdin.isatty():
            raise SubscriptionError("非交互环境必须使用 --subscription-url 提供新订阅 URL")
        value = getpass.getpass(
            f"订阅 {profile_id} 的新 URL（输入不会回显，留空取消）："
        )
    value = value.strip()
    if not value:
        log("已取消，未修改任何文件")
        return None
    if "\n" in value or "\r" in value:
        raise SubscriptionError("订阅 URL 不能包含换行")
    return value


def command_subscription_replace(
    args: argparse.Namespace,
    *,
    profile_id: str,
    create: bool,
    activate: bool,
) -> int:
    lock_handle = acquire_lock()
    try:
        if args.secrets_file is None:
            raise SubscriptionError("subscription 命令必须使用订阅密钥文件")
        control = load_yaml(args.control_file)
        settings, sources = validate_control_inventory(control)
        profile_env_name(profile_id)
        existing = next((item for item in sources if item["id"] == profile_id), None)
        if create and existing is not None:
            raise SubscriptionError(f"订阅档案已存在：{profile_id}；请使用 edit")
        if not create and existing is None:
            raise SubscriptionError(f"订阅档案不存在：{profile_id}")

        url_env = profile_env_name(profile_id)
        if existing is not None:
            current_env = existing.get("url_env")
            if isinstance(current_env, str) and current_env:
                url_env = current_env
            converter = existing.get("converter") or {"type": "direct"}
            if not isinstance(converter, dict):
                raise SubscriptionError(f"订阅 {profile_id} 的 converter 必须是映射")
            current_converter = str(converter.get("type", "direct"))
            converter_type = args.converter or current_converter
        else:
            converter_type = args.converter or "direct"
            used_envs = {
                str(item.get("url_env"))
                for item in sources
                if isinstance(item.get("url_env"), str)
            }
            if url_env in used_envs or read_env_file_value(args.secrets_file, url_env) is not None:
                raise SubscriptionError(
                    f"订阅 ID {profile_id} 生成的密钥变量与现有档案冲突：{url_env}"
                )
        if converter_type != "direct":
            raise SubscriptionError(
                f"订阅 {profile_id} 仍使用旧转换配置；请加 --converter direct 迁移"
            )

        subscription_url = read_new_subscription_url(args, profile_id)
        if subscription_url is None:
            return 0

        candidate_control = copy.deepcopy(control)
        if create:
            candidate_control["sources"].append(
                {
                    "id": profile_id,
                    "enabled": False,
                    "url_env": url_env,
                    "prefix": f"[{profile_id}] ",
                    "user_agent": "mihomo",
                    "headers": {},
                    "converter": {"type": "direct"},
                }
            )
        else:
            target = find_profile(candidate_control["sources"], profile_id)
            target["url_env"] = url_env
            target.pop("url", None)
            target["converter"] = {"type": "direct"}

        if activate:
            candidate_control = select_profile(candidate_control, profile_id)
        _, candidate_sources = validate_control_inventory(candidate_control)
        target = find_profile(candidate_sources, profile_id)
        runtime_changed = activate or bool(existing and existing.get("enabled", True))
        if runtime_changed:
            settings, download_sources = validate_control_file(candidate_control)
        else:
            download_sources = [target]

        provider_bytes, cache_candidates = build_profile_candidate(
            settings,
            download_sources,
            args.secrets_file,
            {url_env: subscription_url},
        )
        validate_with_mihomo(settings, provider_bytes)

        if args.dry_run:
            log(
                f"订阅 {profile_id} 下载与配置校验成功；dry-run 未修改任何文件"
            )
            return 0

        provider_file = commit_profile_candidate(
            args,
            settings=settings,
            candidate_control=candidate_control,
            provider_bytes=provider_bytes,
            cache_candidates=cache_candidates,
            secret_value=(url_env, subscription_url),
            runtime_changed=runtime_changed,
        )
        if create:
            log(f"订阅 {profile_id} 已保存，尚未启用；请通过 subscription select 或 manage 选择启用")
        elif activate:
            log(f"已更新并切换到订阅：{profile_id}")
        elif runtime_changed:
            log(f"活动订阅已更新：{profile_id}")
        else:
            log(f"非活动订阅已更新：{profile_id}（运行节点未改变）")
        if runtime_changed:
            log(f"provider 文件：{provider_file}")
        return 0
    finally:
        lock_handle.close()


def command_subscription_use(args: argparse.Namespace) -> int:
    lock_handle = acquire_lock()
    try:
        if args.secrets_file is None:
            raise SubscriptionError("subscription 命令必须使用订阅密钥文件")
        control = load_yaml(args.control_file)
        combining = args.subscription_action == "select"
        profile_ids = args.profile_ids if combining else [args.profile_id]
        candidate_control = select_profiles(control, profile_ids)
        settings, active_sources = validate_control_file(candidate_control)
        options = {"strict": False} if combining else {}
        provider_bytes, cache_candidates = build_profile_candidate(
            settings,
            active_sources,
            args.secrets_file,
            **options,
        )
        validate_with_mihomo(settings, provider_bytes)
        selected_label = "、".join(source["id"] for source in active_sources)
        node_count = len(yaml.safe_load(provider_bytes)["proxies"])
        log(f"目标订阅：{selected_label}；合计 {node_count} 个节点，核心校验通过")
        if args.dry_run:
            log("dry-run 未修改任何文件")
            return 0
        provider_file = commit_profile_candidate(
            args,
            settings=settings,
            candidate_control=candidate_control,
            provider_bytes=provider_bytes,
            cache_candidates=cache_candidates,
            secret_value=None,
            runtime_changed=True,
        )
        log(f"已启用订阅：{selected_label}")
        log(f"provider 文件：{provider_file}")
        return 0
    finally:
        lock_handle.close()


def profile_cache_count(settings: dict[str, Any], profile_id: str) -> str:
    state_dir = Path(str(settings.get("state_dir", "/var/lib/mihomo-subscription")))
    cache_dir = Path(str(settings.get("cache_dir", state_dir / "cache")))
    cache_file = cache_dir / f"{profile_id}.yaml"
    if not cache_file.exists():
        return "-"
    try:
        document = load_yaml(cache_file)
        payload = document.get("payload") if isinstance(document, dict) else None
        return str(len(payload)) if isinstance(payload, list) else "invalid"
    except SubscriptionError:
        return "invalid"


def print_subscription_profiles(control: dict[str, Any], *, numbered: bool = False) -> None:
    settings, sources = validate_control_inventory(control)
    enabled_count = sum(bool(source.get("enabled", True)) for source in sources)
    print(("编号\t" if numbered else "") + "ID\t状态\t缓存节点")
    for index, source in enumerate(sources, start=1):
        if bool(source.get("enabled", True)):
            status = "当前" if enabled_count == 1 else "已启用(聚合)"
        else:
            status = "未启用"
        prefix = f"{index}\t" if numbered else ""
        print(f"{prefix}{source['id']}\t{status}\t{profile_cache_count(settings, source['id'])}")


def command_subscription_list(args: argparse.Namespace) -> int:
    lock_handle = acquire_lock()
    try:
        print_subscription_profiles(load_yaml(args.control_file))
        return 0
    finally:
        lock_handle.close()


def command_subscription_remove(args: argparse.Namespace) -> int:
    if args.profile_id == "main":
        raise SubscriptionError("main 是兼容保留档案，不能删除；可以编辑或停用")
    if not args.yes:
        if not sys.stdin.isatty():
            raise SubscriptionError("非交互环境删除订阅必须使用 --yes")
        if not ask_yes_no(f"确认删除订阅档案 {args.profile_id}？", default=False):
            log("已取消，未修改任何文件")
            return 0

    lock_handle = acquire_lock()
    try:
        if args.secrets_file is None:
            raise SubscriptionError("subscription 命令必须使用订阅密钥文件")
        control = load_yaml(args.control_file)
        settings, sources = validate_control_inventory(control)
        target = find_profile(sources, args.profile_id)
        if bool(target.get("enabled", True)):
            raise SubscriptionError("不能删除当前或已启用订阅；请先切换到其他档案")

        candidate_control = copy.deepcopy(control)
        candidate_control["sources"] = [
            source
            for source in candidate_control["sources"]
            if source.get("id") != args.profile_id
        ]
        validate_control_inventory(candidate_control)
        url_env = target.get("url_env")
        remaining_envs = {
            source.get("url_env") for source in candidate_control["sources"]
        }
        state_dir = Path(str(settings.get("state_dir", "/var/lib/mihomo-subscription")))
        cache_dir = Path(str(settings.get("cache_dir", state_dir / "cache")))
        cache_file = cache_dir / f"{args.profile_id}.yaml"
        originals = {
            args.control_file: args.control_file.read_bytes(),
            args.secrets_file: (
                args.secrets_file.read_bytes() if args.secrets_file.exists() else None
            ),
            cache_file: cache_file.read_bytes() if cache_file.exists() else None,
        }
        try:
            atomic_write(args.control_file, dump_yaml(candidate_control), 0o600)
            if isinstance(url_env, str) and url_env not in remaining_envs:
                remove_env_file_value(args.secrets_file, url_env)
            cache_file.unlink(missing_ok=True)
        except Exception as exc:
            rollback_problems: list[str] = []
            for path, original in originals.items():
                try:
                    restore_snapshot(path, original)
                except Exception as rollback_exc:
                    rollback_problems.append(f"恢复 {path} 失败：{rollback_exc}")
            if rollback_problems:
                raise SubscriptionError(
                    "删除订阅失败且回滚不完整：" + "；".join(rollback_problems)
                ) from exc
            raise SubscriptionError(f"删除订阅失败，已恢复原文件：{exc}") from exc
        log(f"已删除订阅档案：{args.profile_id}")
        return 0
    finally:
        lock_handle.close()


def command_subscription_manage(args: argparse.Namespace) -> int:
    if not sys.stdin.isatty():
        raise SubscriptionError("订阅管理菜单需要交互终端；脚本请使用具体子命令")
    control = load_yaml(args.control_file)
    print_subscription_profiles(control, numbered=True)
    print("\n[a] 添加（仅保存）  [s] 选择启用组合  [u] 单订阅切换  [e] 编辑  [r] 删除  [q] 退出")
    choice = input("请选择操作：").strip().lower()
    actions = {"a": "add", "s": "select", "u": "use", "e": "edit", "r": "remove"}
    if choice in ("", "q"):
        log("已退出，未修改任何文件")
        return 0
    action = actions.get(choice)
    if action is None:
        raise SubscriptionError(f"未知菜单选项：{choice}")
    nested = argparse.Namespace(**vars(args))
    nested.subscription_action = action
    if action == "select":
        selection = input("要启用的订阅编号（空格分隔；留空或 q 取消）：").strip()
        if not selection or selection.lower() == "q":
            log("已取消，未修改任何文件")
            return 0
        _, sources = validate_control_inventory(control)
        tokens = selection.split()
        if any(not re.fullmatch(r"[0-9]+", token) for token in tokens):
            raise SubscriptionError("订阅编号必须是列表中的数字")
        indexes = [int(token) for token in tokens]
        if any(index < 1 or index > len(sources) for index in indexes):
            raise SubscriptionError("订阅编号不在列表中")
        nested.profile_ids = [sources[index - 1]["id"] for index in indexes]
        selected = select_profiles(control, nested.profile_ids)
        label = "、".join(s["id"] for s in selected["sources"] if s["enabled"])
        if not ask_yes_no(f"启用组合 {label}，停用其余订阅？", default=False):
            log("已取消，未修改任何文件")
            return 0
    else:
        nested.profile_id = input("订阅 ID：").strip()
        profile_env_name(nested.profile_id)
    nested.subscription_url = None
    nested.converter = "direct"
    nested.dry_run = False
    nested.no_reload = False
    nested.yes = False
    return command_subscription(nested)


def command_subscription(args: argparse.Namespace) -> int:
    """Manage saved subscription profiles while keeping the legacy main editor."""
    action = getattr(args, "subscription_action", None)
    if action is None:
        return command_subscription_replace(
            args,
            profile_id="main",
            create=False,
            activate=True,
        )
    if action == "manage":
        return command_subscription_manage(args)
    if action == "list":
        return command_subscription_list(args)
    if action == "add":
        return command_subscription_replace(
            args,
            profile_id=args.profile_id,
            create=True,
            activate=False,
        )
    if action == "edit":
        return command_subscription_replace(
            args,
            profile_id=args.profile_id,
            create=False,
            activate=False,
        )
    if action in ("use", "select"):
        return command_subscription_use(args)
    if action == "remove":
        return command_subscription_remove(args)
    raise SubscriptionError(f"未知订阅管理操作：{action}")


# reset 时从现有主配置保留的服务器参数白名单。
# 白名单之外的 DNS、代理组、规则和 provider 定义一律按最新模板重建，
# 避免把旧配置重新带入，同时自动获得模板新增的安全默认值。
RESET_PRESERVED_KEYS = (
    "mixed-port",
    "port",
    "socks-port",
    "redir-port",
    "tproxy-port",
    "allow-lan",
    "bind-address",
    "lan-allowed-ips",
    "lan-disallowed-ips",
    "authentication",
    "skip-auth-prefixes",
    "external-controller",
    "secret",
    "tun",
)

SECRET_PLACEHOLDER = "__MIHOMO_SECRET__"


def render_reset_config(
    template: dict[str, Any],
    existing: dict[str, Any],
) -> tuple[dict[str, Any], list[str]]:
    """以最新模板为基础，叠加现有配置中需要保留的服务器参数。"""
    rendered = copy.deepcopy(template)
    preserved: list[str] = []

    for key in RESET_PRESERVED_KEYS:
        if key in existing:
            rendered[key] = copy.deepcopy(existing[key])
            preserved.append(key)

    secret = rendered.get("secret")
    if not isinstance(secret, str) or not secret or secret == SECRET_PLACEHOLDER:
        rendered["secret"] = secrets.token_urlsafe(32)

    return rendered, preserved


def command_reset(args: argparse.Namespace) -> int:
    if not args.yes and not args.dry_run:
        if not sys.stdin.isatty():
            raise SubscriptionError("非交互环境必须使用 --yes 确认重置")
        if not ask_yes_no("确认按最新模板重置 Mihomo 主配置？", default=False):
            log("已取消，未修改任何文件")
            return 0
    lock_handle = acquire_lock()

    try:
        if args.secrets_file is not None:
            load_env_file(args.secrets_file)

        control = load_yaml(args.control_file)
        settings, sources = validate_control_file(control)

        home_dir = Path(str(settings.get("home_dir", "/etc/mihomo")))
        config_file = Path(str(settings.get("config_file", home_dir / "config.yaml")))

        existing = load_yaml(config_file)
        if not isinstance(existing, dict):
            raise SubscriptionError("现有主配置顶层必须是映射")

        template = load_yaml(args.template_file)
        if not isinstance(template, dict):
            raise SubscriptionError("配置模板顶层必须是映射")

        rendered, preserved = render_reset_config(template, existing)
        rendered_bytes = dump_yaml(rendered)

        log("将保留的服务器参数：" + ("、".join(preserved) if preserved else "（无）"))
        log("将按最新模板重新生成：DNS、代理组、规则和 provider 定义")
        log(f"不会修改：{args.control_file} 与订阅 URL 密钥文件")

        # 重置必须拿到全新节点；任一下载失败即终止，不使用旧缓存。
        provider_bytes, cache_candidates, _ = build_candidate(
            settings,
            sources,
            strict=True,
        )

        # 先完整校验候选主配置与候选 provider，成功前不触碰正式文件。
        validate_with_mihomo(settings, provider_bytes, config_document=rendered)

        if args.dry_run:
            log("校验成功；dry-run 模式未写入文件")
            return 0

        backup = config_file.with_suffix(".yaml.bak")
        original_config_bytes = config_file.read_bytes()
        shutil.copy2(config_file, backup)
        os.chmod(backup, 0o600)
        log(f"已备份原配置：{backup}")

        provider_relative = Path(str(settings.get("provider_file", "providers/subscriptions.yaml")))
        provider_file = ensure_inside(home_dir, home_dir / provider_relative)
        original_provider_bytes = provider_file.read_bytes() if provider_file.exists() else None
        state_file = policy_state_path(settings)
        original_state = state_file.read_bytes() if state_file.exists() else None
        policy = native_policy(rendered, str(settings.get("provider_name", "subscriptions")))
        prepare_rule_cache(settings)

        # 替换阶段任一步失败都回滚到原配置与 provider，兑现"失败保留原配置"的承诺。
        try:
            atomic_write(config_file, rendered_bytes, 0o600)
            apply_service_group(config_file, "mihomo", 0o640)

            provider_file = install_provider(
                settings,
                provider_bytes,
                cache_candidates,
                dry_run=False,
            )

            atomic_write(state_file, dump_yaml(describe_policy(policy)), 0o600)
            reload_mihomo(settings, no_reload=args.no_reload)
        except Exception as exc:
            log(f"重置失败（{exc}），正在回滚到原配置……")
            rollback_problems: list[str] = []

            try:
                atomic_write(config_file, original_config_bytes, 0o600)
                apply_service_group(config_file, "mihomo", 0o640)
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {config_file} 失败：{rollback_exc}")

            try:
                if original_provider_bytes is not None:
                    atomic_write(provider_file, original_provider_bytes, 0o600)
                    apply_service_group(
                        provider_file,
                        str(settings.get("provider_group", "mihomo")),
                        0o640,
                    )
                elif provider_file.exists():
                    provider_file.unlink()
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {provider_file} 失败：{rollback_exc}")

            try:
                if original_state is None:
                    state_file.unlink(missing_ok=True)
                else:
                    atomic_write(state_file, original_state, 0o600)
            except Exception as rollback_exc:
                rollback_problems.append(f"恢复 {state_file} 失败：{rollback_exc}")

            if rollback_problems:
                raise SubscriptionError(
                    "重置失败且回滚不完整："
                    + "；".join(rollback_problems)
                    + f"；可从备份手工恢复：{backup}"
                ) from exc
            raise SubscriptionError(
                f"重置失败，已回滚到原配置（备份：{backup}）；"
                f"如 Mihomo 已停止请手工重启。原因：{exc}"
            ) from exc

        log(f"主配置已重置：{config_file}")
        log(f"provider 文件：{provider_file}")
        return 0
    finally:
        lock_handle.close()


def replace_secret(template: str) -> str:
    return template.replace(SECRET_PLACEHOLDER, secrets.token_urlsafe(32))


def validate_controller_listen(value: str) -> str:
    if any(character in value for character in "\r\n"):
        raise argparse.ArgumentTypeError("controller 地址不能包含换行")

    parsed = urllib.parse.urlsplit("//" + value)
    try:
        port = parsed.port
    except ValueError as exc:
        raise argparse.ArgumentTypeError(f"controller 端口无效：{value}") from exc

    if (
        not parsed.hostname
        or port is None
        or port < 1
        or parsed.username is not None
        or parsed.password is not None
        or parsed.path
        or parsed.query
        or parsed.fragment
    ):
        raise argparse.ArgumentTypeError(
            "controller 地址必须为 HOST:PORT，例如 127.0.0.1:9090"
        )

    return value


def configure_mihomo_template(
    template: str,
    *,
    controller_listen: str | None,
    allow_proxy_lan: bool,
) -> str:
    if controller_listen is not None:
        replacement = "external-controller: " + json.dumps(controller_listen)
        template, count = re.subn(
            r"(?m)^external-controller:\s*.*$",
            replacement,
            template,
            count=1,
        )
        if count != 1:
            raise SubscriptionError("配置模板缺少 external-controller")

    if allow_proxy_lan:
        template, count = re.subn(
            r"(?m)^allow-lan:\s*false\s*$",
            "allow-lan: true",
            template,
            count=1,
        )
        if count != 1:
            raise SubscriptionError("配置模板缺少 allow-lan: false")

    return template


def command_init(args: argparse.Namespace) -> int:
    if args.non_interactive and args.require_subscription:
        raise SubscriptionError("--non-interactive 不能与 --require-subscription 同时使用")

    mihomo_home = Path("/etc/mihomo")
    control_dir = Path("/etc/mihomo-subscription")
    provider_dir = mihomo_home / "providers"
    state_dir = Path("/var/lib/mihomo-subscription")
    cache_dir = state_dir / "cache"

    for directory, mode in (
        (mihomo_home, 0o755),
        (provider_dir, 0o750),
        (control_dir, 0o700),
        (state_dir, 0o700),
        (cache_dir, 0o700),
    ):
        directory.mkdir(parents=True, exist_ok=True)
        os.chmod(directory, mode)

    # mihomo.service 以 mihomo 用户运行，providers 目录需要该组可读
    apply_service_group(provider_dir, "mihomo", 0o750)
    prepare_rule_cache({"home_dir": str(mihomo_home)})

    config_file = mihomo_home / "config.yaml"
    control_file = control_dir / "subscriptions.yaml"
    secrets_file = control_dir / "secrets.env"
    provider_file = provider_dir / "subscriptions.yaml"
    cache_file = mihomo_home / "cache.db"

    if config_file.exists() and (args.controller_listen or args.allow_proxy_lan):
        raise SubscriptionError(
            "--controller-listen 与 --allow-proxy-lan 仅用于新建 config.yaml；"
            "现有配置请手工修改并执行 mihomo -t 校验"
        )

    def write_config_template() -> None:
        template = (SHARE_DIR / "config.base.yaml").read_text(encoding="utf-8")
        template = configure_mihomo_template(
            template,
            controller_listen=args.controller_listen,
            allow_proxy_lan=args.allow_proxy_lan,
        )
        atomic_write(config_file, replace_secret(template).encode("utf-8"), 0o600)
        apply_service_group(config_file, "mihomo", 0o640)
        policy = native_policy(yaml.safe_load(template), "subscriptions")
        atomic_write(state_dir / "policy-state.yaml", dump_yaml(describe_policy(policy)), 0o600)
        log(f"已创建主配置：{config_file}")

    if not config_file.exists():
        write_config_template()
    else:
        existing = load_yaml(config_file)
        providers = existing.get("proxy-providers") if isinstance(existing, dict) else None
        has_provider = isinstance(providers, dict) and "subscriptions" in providers

        if has_provider:
            log(f"保留已有主配置，不做修改：{config_file}")
        elif not args.non_interactive and sys.stdin.isatty() and ask_yes_no(
            f"已有 {config_file} 缺少 proxy-providers.subscriptions，"
            "备份后用模板替换？",
            default=True,
        ):
            backup = config_file.with_suffix(".yaml.bak")
            shutil.copy2(config_file, backup)
            log(f"已备份原配置：{backup}")
            write_config_template()
        else:
            log(f"保留已有主配置，不做修改：{config_file}")
            log(
                "警告：该配置缺少 proxy-providers.subscriptions，"
                "update 将无法通过校验；请手工合并模板 "
                f"{SHARE_DIR / 'config.base.yaml'}"
            )

    if not control_file.exists():
        shutil.copy2(SHARE_DIR / "subscriptions.example.yaml", control_file)
        os.chmod(control_file, 0o600)
        log(f"已创建订阅控制文件：{control_file}")

    if not secrets_file.exists():
        shutil.copy2(SHARE_DIR / "secrets.env.example", secrets_file)
        os.chmod(secrets_file, 0o600)
        log(f"已创建订阅密钥文件：{secrets_file}")

    if not provider_file.exists():
        atomic_write(provider_file, dump_yaml({"proxies": []}), 0o600)
        apply_service_group(provider_file, "mihomo", 0o640)
        log(f"已创建空 provider：{provider_file}")

    if not cache_file.exists():
        atomic_write(cache_file, b"", 0o600)
        apply_service_group(cache_file, "mihomo", 0o660)
        log(f"已创建 Mihomo 状态缓存：{cache_file}")

    subscription_url = args.subscription_url
    converter_type = args.converter
    existing_url = read_env_file_value(secrets_file, "MIHOMO_SUB_MAIN")

    if subscription_url is None and not args.non_interactive and sys.stdin.isatty():
        if existing_url and ask_yes_no("检测到已有 main 订阅，是否复用它配置 main 来源？", default=True):
            subscription_url = existing_url
        elif args.require_subscription:
            subscription_url = getpass.getpass("订阅 URL（输入不会回显）：").strip()
            if not subscription_url:
                raise SubscriptionError("订阅 URL 不能为空")
        elif ask_yes_no("是否现在配置 main 订阅？", default=False):
            subscription_url = getpass.getpass("订阅 URL（输入不会回显，留空跳过）：").strip()

    if args.require_subscription and subscription_url is None:
        raise SubscriptionError("必须在交互终端输入订阅 URL，或使用 --subscription-url")

    if subscription_url:
        set_env_file_value(secrets_file, "MIHOMO_SUB_MAIN", subscription_url.strip())
        enable_source_in_control_file(
            control_file,
            source_id="main",
            url_env="MIHOMO_SUB_MAIN",
            converter_type=converter_type,
        )
        log("已写入 main 订阅 URL，并启用 main 来源")
        log("然后执行：sudo mihomo-subscription update --strict")
    else:
        log("下一步：编辑 subscriptions.yaml 与 secrets.env")
        log("然后执行：sudo mihomo-subscription update --strict")

    log("确认成功后再启用 mihomo.service 与更新 timer")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description="Safely update Mihomo proxy provider from subscriptions.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="创建初始配置，但不覆盖已有 config.yaml")
    init_parser.add_argument(
        "--non-interactive",
        action="store_true",
        help="不询问订阅 URL，只创建模板文件",
    )
    init_parser.add_argument(
        "--require-subscription",
        action="store_true",
        help="交互初始化时要求输入非空的 main 订阅 URL",
    )
    init_parser.add_argument(
        "--subscription-url",
        help="初始化时写入 main 订阅 URL；注意 shell 历史可能记录该值",
    )
    init_parser.add_argument(
        "--converter",
        choices=("direct",),
        default="direct",
        help="仅支持 direct：Clash/Mihomo YAML（兼容旧命令参数）",
    )
    init_parser.add_argument(
        "--controller-listen",
        type=validate_controller_listen,
        metavar="HOST:PORT",
        help="新建配置时设置 MetaCubeXD/API 监听地址；默认 127.0.0.1:9090",
    )
    init_parser.add_argument(
        "--allow-proxy-lan",
        action="store_true",
        help="新建配置时允许局域网使用 mixed-port；不影响 controller 监听地址",
    )
    init_parser.set_defaults(func=command_init)

    update_parser = subparsers.add_parser("update", help="下载、提取、校验并更新订阅 provider")
    update_parser.add_argument(
        "--control-file",
        type=Path,
        default=DEFAULT_CONTROL_FILE,
    )
    update_parser.add_argument(
        "--secrets-file",
        type=Path,
        default=DEFAULT_SECRETS_FILE,
        help="读取 KEY=value 格式密钥文件；传入空字符串可禁用",
    )
    update_parser.add_argument(
        "--strict",
        action="store_true",
        help="任一来源失败即终止，不使用旧缓存",
    )
    update_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="只下载和校验，不写入 provider",
    )
    update_parser.add_argument(
        "--no-reload",
        action="store_true",
        help="更新成功后不重载 Mihomo",
    )
    update_parser.set_defaults(func=command_update)

    subscription_parser = subparsers.add_parser(
        "subscription",
        help="安全修改 main 订阅 URL，校验成功后才替换现有 provider",
    )
    subscription_parser.add_argument(
        "--control-file",
        type=Path,
        default=DEFAULT_CONTROL_FILE,
    )
    subscription_parser.add_argument(
        "--secrets-file",
        type=Path,
        default=DEFAULT_SECRETS_FILE,
        help="读取并更新 KEY=value 格式密钥文件",
    )
    subscription_parser.add_argument(
        "--subscription-url",
        help="新订阅 URL；省略时隐藏式交互输入，命令行传入可能被 shell 历史记录",
    )
    subscription_parser.add_argument(
        "--converter",
        choices=("direct",),
        default=None,
        help="将旧来源迁移到 direct；仅支持 Clash/Mihomo YAML",
    )
    subscription_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="只下载和校验新订阅，不修改任何文件",
    )
    subscription_parser.add_argument(
        "--no-reload",
        action="store_true",
        help="替换成功后不重载 Mihomo",
    )
    subscription_actions = subscription_parser.add_subparsers(
        dest="subscription_action",
        metavar="{manage,list,add,use,select,edit,remove}",
    )
    subscription_actions.add_parser("manage", help="打开订阅档案交互管理菜单")
    subscription_actions.add_parser("list", help="列出订阅档案，不显示 URL")

    for action, help_text in (
        ("add", "下载、校验并保存订阅，不自动启用"),
        ("edit", "修改指定订阅；非活动档案不改变运行节点"),
    ):
        action_parser = subscription_actions.add_parser(action, help=help_text)
        action_parser.add_argument("profile_id", metavar="ID")
        action_parser.add_argument(
            "--subscription-url",
            default=argparse.SUPPRESS,
            help="新订阅 URL；省略时隐藏式输入，命令行传入可能被 shell 历史记录",
        )
        action_parser.add_argument(
            "--converter",
            choices=("direct",),
            default=argparse.SUPPRESS,
            help="将旧来源迁移到 direct；仅支持 Clash/Mihomo YAML",
        )
        action_parser.add_argument(
            "--dry-run",
            action="store_true",
            default=argparse.SUPPRESS,
            help="只下载和校验，不修改任何文件",
        )
        action_parser.add_argument(
            "--no-reload",
            action="store_true",
            default=argparse.SUPPRESS,
            help="成功后不重载 Mihomo",
        )

    for action, help_text in (
        ("use", "严格刷新并切换到单个订阅"),
        ("select", "选择启用组合，获取失败时使用缓存；停用其余订阅"),
    ):
        action_parser = subscription_actions.add_parser(action, help=help_text)
        if action == "select":
            action_parser.add_argument("profile_ids", metavar="ID", nargs="+")
        else:
            action_parser.add_argument("profile_id", metavar="ID")
        action_parser.add_argument(
            "--dry-run", action="store_true", default=argparse.SUPPRESS,
            help="只下载和校验，不修改任何文件",
        )
        action_parser.add_argument(
            "--no-reload", action="store_true", default=argparse.SUPPRESS,
            help="成功后不重载 Mihomo",
        )

    remove_parser = subscription_actions.add_parser(
        "remove", help="删除非活动订阅档案（main 除外）"
    )
    remove_parser.add_argument("profile_id", metavar="ID")
    remove_parser.add_argument(
        "--yes",
        action="store_true",
        help="跳过删除确认，用于自动化",
    )
    subscription_parser.set_defaults(func=command_subscription)

    rules_parser = subparsers.add_parser(
        "rules",
        help="应用原生 ACL4SSR 规则模板与策略组（无转换器）",
    )
    rules_parser.add_argument(
        "--control-file",
        type=Path,
        default=DEFAULT_CONTROL_FILE,
    )
    rules_parser.add_argument(
        "--template-file",
        type=Path,
        default=SHARE_DIR / "config.base.yaml",
        help="本地 Mihomo YAML 模板；仅导入规则与策略组，支持自定义副本",
    )
    rules_parser.add_argument(
        "--yes",
        action="store_true",
        help="跳过替换 rules 的交互确认",
    )
    rules_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="只生成和校验，不修改正式文件",
    )
    rules_parser.add_argument(
        "--no-reload",
        action="store_true",
        help="同步成功后不重载 Mihomo",
    )
    rules_parser.set_defaults(func=command_rules)

    reset_parser = subparsers.add_parser(
        "reset",
        help="按最新模板重建主配置，仅保留服务器参数，并严格更新 provider",
    )
    reset_parser.add_argument(
        "--control-file",
        type=Path,
        default=DEFAULT_CONTROL_FILE,
    )
    reset_parser.add_argument(
        "--secrets-file",
        type=Path,
        default=DEFAULT_SECRETS_FILE,
        help="读取 KEY=value 格式密钥文件；传入空字符串可禁用",
    )
    reset_parser.add_argument(
        "--template-file",
        type=Path,
        default=SHARE_DIR / "config.base.yaml",
        help="重建主配置使用的模板",
    )
    reset_parser.add_argument(
        "--yes",
        action="store_true",
        help="跳过交互确认，用于自动化",
    )
    reset_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="只渲染、下载和校验，不写入任何文件",
    )
    reset_parser.add_argument(
        "--no-reload",
        action="store_true",
        help="重置成功后不重载 Mihomo",
    )
    reset_parser.set_defaults(func=command_reset)

    for name, help_text in (
        ("policy-init", "从软件包模板创建普通用户策略文件（不覆盖）"),
        ("check", "普通用户本地策略校验（占位节点，不读系统配置）"),
        ("diff", "比较用户策略与上次本地成功记录，首次与软件包模板比较"),
        ("apply", "校验用户策略，按需 sudo 后确认并应用到系统服务"),
    ):
        policy_parser = subparsers.add_parser(name, help=help_text)
        policy_parser.add_argument("--file", type=Path, help="用户策略路径；默认 XDG_CONFIG_HOME/mihomo-webui-config/policy.yaml")
        if name == "apply":
            policy_parser.add_argument("--yes", action="store_true", help="跳过系统差异确认")
        policy_parser.set_defaults(func=command_user_policy, command=name)
    apply_parser = subparsers.add_parser("_apply-policy", help="内部：应用 stdin 中的策略快照")
    apply_parser.add_argument("--yes", action="store_true")
    apply_parser.set_defaults(func=command_apply_policy)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    if getattr(args, "secrets_file", None) == Path(""):
        args.secrets_file = None

    try:
        return int(args.func(args))
    except (SubscriptionError, OSError) as exc:
        log(f"错误：{exc}")
        return 1
    except KeyboardInterrupt:
        log("操作已取消")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
