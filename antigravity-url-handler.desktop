[Desktop Entry]
Name=Antigravity URL Handler
Comment=Handle URL scheme antigravity://
GenericName=Code Editor
Exec=/usr/bin/antigravity --open-url %U
Icon=antigravity
Type=Application
NoDisplay=true
StartupNotify=false
Categories=Utility;
MimeType=x-scheme-handler/antigravity;
Keywords=google;antigravity;
