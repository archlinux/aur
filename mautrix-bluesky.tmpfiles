# Override this file with a modified version in /etc/tmpfiles.d/
d /etc/mautrix-bluesky 0750 root mautrix-bluesky
z /etc/mautrix-bluesky/* 0640 mautrix-bluesky mautrix-bluesky -
d /var/log/mautrix-bluesky 0700 mautrix-bluesky mautrix-bluesky
d /var/lib/mautrix-bluesky 0700 mautrix-bluesky mautrix-bluesky
