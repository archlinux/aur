post_install() {
  if ! id -u portmux >/dev/null 2>&1; then
    echo "Creating portmux user..."
    useradd --system --no-create-home --shell /usr/sbin/nologin --comment "PORTMUX Daemon" portmux
  fi

  chown root:portmux /etc/portmux
  chmod 755 /etc/portmux

  echo "==> To start portmux service:"
  echo "    sudo systemctl enable --now portmux.service"
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl stop portmux.service 2>/dev/null || true
  systemctl disable portmux.service 2>/dev/null || true
}

post_remove() {
  echo "==> Configuration files in /etc/portmux/ have been preserved"
  echo "==> Remove them manually if no longer needed"
}
