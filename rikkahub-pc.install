post_install() {
  cat <<'EOF'
==> Rikkahub installed.
    Launch it from your application menu, or run: rikkahub-pc
    User data is kept in ~/.local/share/rikkahub-pc
    Update via `pacman -Syu` — ignore the in-app "update available" prompt
    (the in-app updater can't write to the package-managed /opt install).
EOF
}

post_upgrade() {
  post_install
}
