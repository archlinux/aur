post_install() {
  cat <<'EOF'
omarchy-share-picker installed to /usr/bin/omarchy-share-picker.

Point xdg-desktop-portal-hyprland at it in ~/.config/hypr/xdph.conf:

  screencopy {
      allow_token_by_default = false
      custom_picker_binary = omarchy-share-picker
  }

Then:

  systemctl --user restart xdg-desktop-portal-hyprland.service
EOF
}

post_upgrade() {
  post_install
}
