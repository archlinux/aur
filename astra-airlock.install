# astra-airlock.install
#
# Sets up the greeter environment: the `greeter` system user, the state cache
# directory, the Hyprland kiosk greetd configuration, and per-user data
# (dynamic scheme + profile picture) synced from the invoking user's desktop.

_greeter_setup() {
    # Create the restricted system user greetd runs the greeter as
    if ! getent passwd greeter >/dev/null; then
        useradd -r -M -s /usr/bin/nologin -d /var/cache/astra-airlock greeter
    fi
    usermod -aG video,input greeter

    # Setup the state cache directory for persistent settings & session memory
    mkdir -p /var/cache/astra-airlock
    chown -R greeter:greeter /var/cache/astra-airlock
    chmod 755 /var/cache/astra-airlock

    # Setup /etc/pam.d/greetd with GNOME Keyring auto-unlock
    cat << 'EOF' > /etc/pam.d/greetd
#%PAM-1.0

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
auth       optional     pam_gnome_keyring.so

account    include      system-local-login

password   include      system-local-login

session    include      system-local-login
session    optional     pam_gnome_keyring.so auto_start
EOF

    # Deploy the Hyprland kiosk greetd configuration
    astra-airlock -k hyprland

    # Sync the current user's active Caelestia scheme as the "dynamic" scheme
	astra-airlock -s || echo "warning: caelestia scheme sync skipped"

    # Set the profile picture from the default ~/.face path
    astra-airlock --set-pfp '~/.face' || echo "warning: no ~/.face found, profile picture not set"
}

post_install() {
    _greeter_setup
}
