+static void nv_drm_dev_release(struct drm_device *dev)
+{
+    struct nv_drm_device *nv_dev;
+
+    if (dev == NULL) {
+        return;
+    }
+
+    nv_dev = dev->dev_private;
+    dev->dev_private = NULL;
+
