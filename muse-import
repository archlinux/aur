# Source registry: listing + resolving per agent
# ---------------------------------------------------------------------------

def omp_headers():
    out = []
    if not os.path.exists(OMP_SESSIONS):
        return out
    for path in sorted(glob.glob(os.path.join(OMP_SESSIONS, "*", "*.jsonl"))):
        header, msgs = None, 0
        try:
            with open(path, encoding="utf-8", errors="ignore") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        rec = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(rec, dict):
                        continue
                    if rec.get("type") == "session" and header is None:
                        header = rec
                    elif rec.get("type") == "message":
                        m = rec.get("message")
                        if isinstance(m, dict) and m.get("role") == "user":
                            msgs += 1
        except OSError:
            continue
        if header is None:
            continue
        out.append({"id": header.get("id") or os.path.basename(path),
                    "title": header.get("title") or "(untitled)",
                    "cwd": header.get("cwd") or "",
                    "timestamp": header.get("timestamp") or "",
                    "path": path, "messages": msgs})
    return out


def agy_headers():
    out = []
    for root in AGY_BRAIN_ROOTS:
        if not os.path.exists(root):
            continue
        for cid in sorted(os.listdir(root)):
            tpath = os.path.join(root, cid, ".system_generated", "logs",
                                 "transcript_full.jsonl")
            if not os.path.isfile(tpath):
                continue
            title, cwd, ts, msgs = "", "", "", 0
            try:
                con = sqlite3.connect(f"file:{AGY_SUMMARY_DB}?mode=ro", uri=True)
                row = con.execute(
                    "SELECT title, workspace_uris, last_user_input_time FROM"
                    " conversation_summaries WHERE conversation_id=?",
                    (cid,)).fetchone()
                con.close()
                if row:
                    title = row[0] or ""
                    for u in (row[1] or "").split(","):
                        u = u.strip()
                        if u.startswith("file://"):
                            cwd = u[len("file://"):]
                            break
                    ts = str(row[2] or "")
            except Exception:
                pass
            try:
                with open(tpath, encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        if '"USER_INPUT"' in line:
                            msgs += 1
            except OSError:
                pass
            out.append({"id": cid, "title": title or f"antigravity {cid[:8]}",
                        "cwd": cwd, "timestamp": ts, "path": tpath,
                        "messages": msgs})
    return out


def opencode_headers(db_path=None):
    db_path = db_path or OPENCODE_DB
    out = []
    if not os.path.exists(db_path):
        return out
    try:
        con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    except Exception:
        return out
    try:
        tables = {r[0] for r in con.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        if "session_v2" in tables:
            for sid, title, d, tc in con.execute(
                    "SELECT id, title, directory, time_created FROM session_v2"
                    " ORDER BY time_created DESC"):
                ts = (datetime.fromtimestamp(tc / 1000, tz=timezone.utc).isoformat()
                      if tc else "")
                out.append({"id": sid, "title": title or f"opencode {sid[:13]}",
                            "cwd": d or "", "timestamp": ts,
                            "messages": con.execute(
                                "SELECT COUNT(*) FROM session_message"
                                " WHERE session_id=? AND type='user'",
                                (sid,)).fetchone()[0]})
        elif "session" in tables:
            for sid, title, d in con.execute("SELECT id, title, directory FROM session"):
                out.append({"id": sid, "title": title or f"opencode {sid[:13]}",
                            "cwd": d or "", "timestamp": "",
                            "messages": con.execute(
                                "SELECT COUNT(*) FROM message m WHERE m.session_id=?"
                                " AND json_extract(m.data, '$.role')='user'",
                                (sid,)).fetchone()[0]})
    except Exception:
        pass
    finally:
        con.close()
    return out


SOURCES = {
    "omp": {"desc": "omp native sessions (~/.omp/agent/sessions)",
            "headers": omp_headers},
    "agy": {"desc": "Antigravity brain transcripts (~/.gemini/.../brain)",
            "headers": agy_headers},
    "opencode": {"desc": "OpenCode sessions (~/.local/share/opencode/opencode.db)",
                 "headers": opencode_headers},
}


def sniff_path(path):
    """Guess the source of a .jsonl file from its first records."""
    try:
        with open(path, encoding="utf-8", errors="ignore") as f:
            for _ in range(5):
                line = f.readline().strip()
                if not line:
                    continue
                try:
                    rec = json.loads(line)
                except Exception:
                    continue
                if not isinstance(rec, dict):
                    continue
                t = rec.get("type", "")
                if isinstance(t, str) and t.isupper():
                    return "agy"
                if t in ("session", "message") and isinstance(rec.get("message"), dict):
                    return "omp"
                if t == "session" and rec.get("version") == 3 and "cwd" in rec:
                    return "omp"
    except OSError:
        pass
    return None


def resolve_source(spec, hint=None, db_path=None):
    """Resolve ID/prefix/path -> (source, path_or_id, meta)."""
    if hint and hint not in SOURCES:
        die(f"unknown source '{hint}' (choose from: {', '.join(SOURCES)})", code=2)
    if os.path.isfile(spec):
        if spec.endswith(".db"):
            die("pass an opencode session id (use list --source opencode to browse),"
                " not the .db file itself")
        kind = hint or sniff_path(spec)
        if kind == "agy":
            m = re.search(r"brain[\\/]([0-9a-f-]{36})[\\/]", spec.replace(os.sep, "/"))
            meta = {"id": m.group(1) if m else spec, "title": "",
                    "cwd": "", "timestamp": None}
            return "agy", spec, meta
        meta = {"id": os.path.basename(spec), "title": "",
                "cwd": "", "timestamp": None}
        return "omp", spec, meta
    if hint:
        if hint == "opencode":
            return "opencode", spec, {"id": spec}
        if hint == "agy":
            for root in AGY_BRAIN_ROOTS:
                p = os.path.join(root, spec, ".system_generated", "logs",
                                 "transcript_full.jsonl")
                if os.path.isfile(p):
                    return "agy", p, {"id": spec}
            cands = [s for s in agy_headers() if s["id"].startswith(spec)]
            if len(cands) == 1:
                return "agy", cands[0]["path"], {"id": cands[0]["id"]}
            die(f"no agy conversation matching '{spec}'"
                + (f" (candidates: {', '.join(c['id'][:13] for c in cands)})" if cands else ""))
        headers = omp_headers()
        matches = [s for s in headers if s["id"].lower().startswith(spec.lower())]
        if len(matches) == 1:
            return "omp", matches[0]["path"], matches[0]
        if not matches:
            die(f"no omp session matching '{spec}'")
        die(f"ambiguous omp session '{spec}':\n" +
            "\n".join(f"  {s['id']}  {s['title']}" for s in matches))
    # No hint: ses_* ids are opencode, else search omp then agy.
    if spec.startswith("ses_"):
        return "opencode", spec, {"id": spec}
    headers = omp_headers()
    matches = [s for s in headers if s["id"].lower().startswith(spec.lower())]
    if len(matches) == 1:
        return "omp", matches[0]["path"], matches[0]
    if len(matches) > 1:
        die(f"ambiguous omp session '{spec}' (use --source to disambiguate)")
    cands = [s for s in agy_headers() if s["id"].startswith(spec)]
    if len(cands) == 1:
        return "agy", cands[0]["path"], {"id": cands[0]["id"]}
    if cands:
        die(f"ambiguous agy conversation '{spec}' (use --source to disambiguate)")
    die(f"no omp/agy session matching '{spec}' (opencode ids start with ses_; pass --source opencode)")


