#!/usr/bin/env python3
"""
muse-import: import foreign agent sessions into Muse Code's session store.

Reads omp, Antigravity/agy and OpenCode sessions, normalizes them to
plain-text turns, and writes a Muse session directory (session.jsonl)
plus a session-index.db row, so `muse resume <uuid>` picks the
conversation up.

Provenance rule (same as the omp import skill): imported tool history
stays plain text — tool calls and results become `assistant_message_committed`
text blocks, never synthesized tool-call payloads, so a resumed session
cannot fake tool provenance. Foreign system prompts, credential material
and opaque reasoning blobs are dropped, skipped counts reported.

Integrated with the muse wrapper: `muse import ...` dispatches here.
"""

import argparse
import ast
import glob
import json
import os
import re
import shutil
import sqlite3
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone

OMP_SESSIONS = os.path.expanduser("~/.omp/agent/sessions")
AGY_BRAIN_ROOTS = [
    os.path.expanduser("~/.gemini/antigravity-cli/brain"),
    os.path.expanduser("~/.gemini/antigravity/brain"),
    os.path.expanduser("~/.gemini/Antigravity/brain"),
]
AGY_SUMMARY_DB = os.path.expanduser(
    "~/.gemini/antigravity-cli/conversation_summaries.db")
OPENCODE_DB = os.path.expanduser("~/.local/share/opencode/opencode.db")

MUSE_DATA = os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"),
    "muse",
)
MUSE_SESSIONS = os.path.join(MUSE_DATA, "sessions")
MUSE_INDEX = os.path.join(MUSE_DATA, "session-index.db")

# Muse model context stamped on imported sessions. The next `muse resume`
# turn runs under the local Meta provider regardless, so record that.
IMPORT_PROVIDER = "meta"
IMPORT_MODEL = "muse-spark-1.3"

USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def color(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def bold(text): return color(text, "1")
def green(text): return color(text, "32")
def red(text): return color(text, "31")
def yellow(text): return color(text, "33")
def dim(text): return color(text, "90")


def die(msg, code=1):
    print(f"{red('error:')} {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"{yellow('warning:')} {msg}", file=sys.stderr)


def iso_to_us(ts):
    """ISO-8601, epoch ms/s/us -> microseconds since epoch."""
    if ts is None:
        return int(time.time() * 1_000_000)
    if isinstance(ts, (int, float)):
        ts = int(ts)
        if ts >= 1e15:
            return ts
        if ts >= 1e12:
            return ts * 1000
        return ts * 1_000_000
    try:
        s = str(ts).strip()
        if s.endswith("Z"):
            s = s[:-1] + "+00:00"
        return int(datetime.fromisoformat(s).timestamp() * 1_000_000)
    except (ValueError, OverflowError):
        return int(time.time() * 1_000_000)


def trunc(text, max_chars):
    if max_chars and len(text) > max_chars:
        return text[:max_chars] + "\n[…truncated]"
    return text


# ---------------------------------------------------------------------------
# Readers: each returns (meta, turns, stats) where a turn is
# ("user"|"assistant"|"tool", text, ts_us) and meta holds
# {id, title, cwd, timestamp}. Tool history is always pre-rendered text.
# ---------------------------------------------------------------------------

def read_omp(path, max_chars=None):
    meta = {"id": os.path.basename(path), "title": "", "cwd": "",
            "timestamp": None}
    turns, stats = [], {"user": 0, "assistant": 0, "tool": 0, "skipped": 0}

    def parse_blocks(content):
        if isinstance(content, list):
            return [b for b in content if isinstance(b, dict)]
        if isinstance(content, str):
            s = content.strip()
            if not s:
                return []
            for loads in (json.loads, ast.literal_eval):
                try:
                    v = loads(s)
                    if isinstance(v, list):
                        return [b for b in v if isinstance(b, dict)]
                    break
                except Exception:
                    continue
            return [{"type": "text", "text": content}]
        return []

    def block_text(block):
        kind = block.get("type")
        if kind == "text":
            text = (block.get("text") or "").strip()
        elif kind == "toolCall":
            args = block.get("arguments", "")
            if not isinstance(args, str):
                args = json.dumps(args)
            text = (f"[omp tool call: {block.get('name', 'unknown')} "
                    f"id={block.get('id', 'unknown')}]\nargs: {args}").strip()
        else:
            return None
        if not text:
            return None
        return trunc(text, max_chars)

    with open(path, encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except Exception:
                stats["skipped"] += 1
                continue
            if not isinstance(rec, dict):
                stats["skipped"] += 1
                continue
            if rec.get("type") == "session":
                meta.update({"id": rec.get("id", meta["id"]),
                             "title": rec.get("title", ""),
                             "cwd": rec.get("cwd", ""),
                             "timestamp": rec.get("timestamp")})
                continue
            if rec.get("type") != "message":
                # session_init (foreign system prompt), credential pins,
                # lifecycle markers: never imported.
                stats["skipped"] += 1
                continue
            msg = rec.get("message")
            if not isinstance(msg, dict):
                stats["skipped"] += 1
                continue
            ts = iso_to_us(msg.get("timestamp") or rec.get("timestamp"))
            if msg.get("role") == "user":
                texts = [block_text(b) for b in parse_blocks(msg.get("content"))
                         if isinstance(b, dict) and b.get("type") == "text"]
                texts = [t for t in texts if t]
                if not texts:
                    stats["skipped"] += 1
                    continue
                turns.append(("user", "\n\n".join(texts), ts))
                stats["user"] += 1
            elif msg.get("role") == "assistant":
                wrote = False
                for b in parse_blocks(msg.get("content")):
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "toolCall":
                        # thoughtSignature is opaque foreign reasoning: drop it.
                        b = {k: v for k, v in b.items()
                             if k != "thoughtSignature"}
                        text = block_text(b)
                        if text:
                            turns.append(("tool", text, ts))
                            stats["tool"] += 1
                            wrote = True
                    else:
                        text = block_text(b)
                        if text:
                            turns.append(("assistant", text, ts))
                            stats["assistant"] += 1
                            wrote = True
                if not wrote:
                    stats["skipped"] += 1
            else:
                stats["skipped"] += 1
    return meta, turns, stats


def strip_user_wrapper(text):
    m = re.fullmatch(
        r"\s*<USER_REQUEST>\n?(.*?)\n?\s*(</USER_REQUEST>)?\s*$",
        text, re.DOTALL)
    return m.group(1) if m else text


def read_agy(path, cid, max_chars=None):
    meta = {"id": cid or os.path.basename(path), "title": "",
            "cwd": "", "timestamp": None}
    turns, stats = [], {"user": 0, "assistant": 0, "tool": 0, "skipped": 0}
    # Title/workspace from the summaries db (best effort).
    try:
        con = sqlite3.connect(f"file:{AGY_SUMMARY_DB}?mode=ro", uri=True)
        row = con.execute(
            "SELECT title, workspace_uris FROM conversation_summaries"
            " WHERE conversation_id = ?", (meta["id"],)).fetchone()
        con.close()
        if row:
            meta["title"] = row[0] or ""
            uris = (row[1] or "").split(",")
            for u in uris:
                u = u.strip()
                if u.startswith("file://"):
                    meta["cwd"] = u[len("file://"):]
                    break
    except Exception:
        pass

    def emit(kind, text, ts):
        text = (text or "").strip()
        if not text:
            return False
        turns.append((kind, trunc(text, max_chars), ts))
        return True

    with open(path, encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                step = json.loads(line)
            except Exception:
                stats["skipped"] += 1
                continue
            t = step.get("type", "GENERIC")
            ts = iso_to_us(step.get("created_at"))
            if meta["timestamp"] is None:
                meta["timestamp"] = step.get("created_at")
            if t == "USER_INPUT":
                if emit("user", strip_user_wrapper(step.get("content", "")), ts):
                    stats["user"] += 1
                else:
                    stats["skipped"] += 1
            elif t in ("PLANNER_RESPONSE", "GENERIC"):
                text = step.get("content") or step.get("thinking") or ""
                if text.strip() and emit("assistant", text, ts):
                    stats["assistant"] += 1
                else:
                    stats["skipped"] += 1
                calls = step.get("tool_calls")
                if isinstance(calls, str):
                    try:
                        calls = ast.literal_eval(calls)
                    except Exception:
                        calls = None
                if isinstance(calls, list):
                    for c in calls:
                        if not isinstance(c, dict):
                            continue
                        args = c.get("args", "")
                        if not isinstance(args, str):
                            args = json.dumps(args)
                        if emit("tool",
                                f"[agy tool: {c.get('name', 'unknown')}]\n"
                                f"args: {args}", ts):
                            stats["tool"] += 1
            elif t == "CHECKPOINT":
                # Compaction summary: kept as labeled narrative context.
                if emit("assistant", "[compaction]\n" + (step.get("content") or ""), ts):
                    stats["assistant"] += 1
                else:
                    stats["skipped"] += 1
            elif t in ("SYSTEM_MESSAGE", "CONVERSATION_HISTORY",
                       "ERROR_MESSAGE"):
                # Foreign system content: never imported.
                stats["skipped"] += 1
            else:
                # Other MODEL tool-result types (VIEW_FILE, RUN_COMMAND,
                # GREP_SEARCH, ...): kept as labeled text.
                text = step.get("content") or step.get("thinking") or ""
                if text.strip() and emit(
                        "assistant", f"[agy {t.lower()}]\n{text}", ts):
                    stats["assistant"] += 1
                else:
                    stats["skipped"] += 1
    if not meta["title"]:
        meta["title"] = f"antigravity {meta['id'][:8]}"
    return meta, turns, stats


def read_opencode(db_path, session_id, max_chars=None):
    meta = {"id": session_id, "title": "", "cwd": "", "timestamp": None}
    turns, stats = [], {"user": 0, "assistant": 0, "tool": 0, "skipped": 0}

    def emit(kind, text, ts):
        text = (text or "").strip()
        if not text:
            return False
        turns.append((kind, trunc(text, max_chars), ts))
        return True

    con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    try:
        tables = {r[0] for r in
                  con.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        # Prefix match first (list view truncates ids); exact match wins ties.
        like = (session_id.replace("\\", "\\\\").replace("%", "\\%")
                .replace("_", "\\_") + "%")
        full_id, multi = None, []
        for t in ("session_v2", "session"):
            if t not in tables:
                continue
            rows = [r[0] for r in con.execute(
                f"SELECT id FROM {t} WHERE id LIKE ? ESCAPE '\\'", (like,)).fetchall()]
            exact = [r for r in rows if r == session_id]
            if exact:
                full_id = exact[0]
                break
            if len(rows) == 1 and full_id is None:
                full_id = rows[0]
            elif len(rows) > 1:
                multi.extend(rows)
        if full_id is None:
            if multi:
                die(f"ambiguous opencode session '{session_id}':\n" +
                    "\n".join(f"  {c}" for c in multi[:10]))
            die(f"no opencode session {session_id!r} in {db_path}")
        session_id = full_id
        if "session_v2" in tables:
            row = con.execute(
                "SELECT id, title, directory, time_created FROM session_v2"
                " WHERE id=?", (session_id,)).fetchone()
            if row is None:
                die(f"no opencode session {session_id!r} in {db_path}")
            meta.update({"id": row[0], "title": row[1] or "",
                         "cwd": row[2] or "",
                         "timestamp": row[3] / 1000 if row[3] else None})
            msgs = con.execute(
                "SELECT type, time_created, data FROM session_message"
                " WHERE session_id=? ORDER BY seq", (session_id,)).fetchall()
            for mtype, tms, data in msgs:
                try:
                    d = json.loads(data)
                except Exception:
                    stats["skipped"] += 1
                    continue
                ts = iso_to_us(tms)
                if mtype == "user":
                    if emit("user", d.get("text", ""), ts):
                        stats["user"] += 1
                    else:
                        stats["skipped"] += 1
                elif mtype == "assistant":
                    wrote = False
                    for b in d.get("content", []) or []:
                        if not isinstance(b, dict):
                            continue
                        bt = b.get("type")
                        if bt == "text":
                            if emit("assistant", b.get("text", ""), ts):
                                stats["assistant"] += 1
                                wrote = True
                        elif bt == "reasoning":
                            # Plaintext foreign reasoning: kept labeled,
                            # same call as the omp skill's [OpenCode reasoning].
                            if emit("assistant",
                                    "[opencode reasoning]\n" + (b.get("text") or ""), ts):
                                stats["assistant"] += 1
                                wrote = True
                        elif bt == "tool":
                            st = b.get("state", {}) or {}
                            inp = st.get("input", "")
                            if not isinstance(inp, str):
                                inp = json.dumps(inp)
                            if emit("tool",
                                    f"[opencode tool: {b.get('name', 'unknown')} "
                                    f"id={b.get('id', 'unknown')}]\nargs: {inp}", ts):
                                stats["tool"] += 1
                                wrote = True
                            for c in (st.get("content") or []):
                                if isinstance(c, dict) and c.get("type") == "text":
                                    if emit("assistant", c.get("text", ""), ts):
                                        stats["assistant"] += 1
                        else:
                            stats["skipped"] += 1
                    if not wrote:
                        stats["skipped"] += 1
                else:
                    stats["skipped"] += 1
        elif "session" in tables:
            row = con.execute(
                "SELECT id, title, directory FROM session WHERE id=?",
                (session_id,)).fetchone()
            if row is None:
                die(f"no opencode session {session_id!r} in {db_path}")
            meta.update({"id": row[0], "title": row[1] or "",
                         "cwd": row[2] or ""})
            msgs = con.execute(
                "SELECT id, time_created, data FROM message"
                " WHERE session_id=? ORDER BY time_created, rowid",
                (session_id,)).fetchall()
            for mid, tms, data in msgs:
                try:
                    m = json.loads(data)
                except Exception:
                    stats["skipped"] += 1
                    continue
                ts = iso_to_us(tms)
                role = m.get("role")
                parts = con.execute(
                    "SELECT data FROM part WHERE message_id=?"
                    " ORDER BY time_created, rowid", (mid,)).fetchall()
                if role == "user":
                    texts = [json.loads(p[0]).get("text", "") for p in parts
                             if _part_text(p[0])]
                    texts = [t for t in texts if t and t.strip()]
                    if texts and emit("user", "\n\n".join(texts), ts):
                        stats["user"] += 1
                    else:
                        stats["skipped"] += 1
                elif role == "assistant":
                    wrote = False
                    for (pdata,) in parts:
                        try:
                            b = json.loads(pdata)
                        except Exception:
                            continue
                        if not isinstance(b, dict):
                            continue
                        bt = b.get("type")
                        if bt == "text":
                            if emit("assistant", b.get("text", ""), ts):
                                stats["assistant"] += 1
                                wrote = True
                        elif bt == "reasoning":
                            if emit("assistant",
                                    "[opencode reasoning]\n" + (b.get("text") or ""), ts):
                                stats["assistant"] += 1
                                wrote = True
                        elif bt == "tool":
                            st = b.get("state", {}) or {}
                            inp = st.get("input", "")
                            if not isinstance(inp, str):
                                inp = json.dumps(inp)
                            if emit("tool",
                                    f"[opencode tool: {b.get('tool', 'unknown')} "
                                    f"id={b.get('callID', 'unknown')}]\nargs: {inp}", ts):
                                stats["tool"] += 1
                                wrote = True
                            for c in (st.get("output") or st.get("content") or []):
                                if isinstance(c, str) and c.strip():
                                    if emit("assistant", c, ts):
                                        stats["assistant"] += 1
                                elif isinstance(c, dict) and c.get("type") == "text":
                                    if emit("assistant", c.get("text", ""), ts):
                                        stats["assistant"] += 1
                        elif bt == "patch":
                            files = b.get("files", [])
                            if emit("assistant",
                                    "[opencode patch]\n" + "\n".join(map(str, files)), ts):
                                stats["assistant"] += 1
                                wrote = True
                        elif bt in ("step-start", "step-finish", "compaction"):
                            stats["skipped"] += 1
                        else:
                            stats["skipped"] += 1
        else:
            die(f"{db_path} has neither session_v2 nor session tables")
    finally:
        con.close()
    if not meta["title"]:
        meta["title"] = f"opencode {meta['id'][:13]}"
    return meta, turns, stats


def _part_text(pdata):
    try:
        b = json.loads(pdata)
    except Exception:
        return ""
    return b.get("text", "") if isinstance(b, dict) else ""


