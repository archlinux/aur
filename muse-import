def cmd_list(args):
    wanted = [args.source] if args.source else list(SOURCES)
    for w in wanted:
        if w not in SOURCES:
            die(f"unknown source '{w}' (choose from: {', '.join(SOURCES)})", code=2)
    total = 0
    for name in wanted:
        if name == "opencode":
            sessions = opencode_headers(args.db)
        else:
            sessions = SOURCES[name]["headers"]()
        total += len(sessions)
        if args.json:
            print(json.dumps({name: sessions}, indent=2))
            continue
        if not sessions:
            print(f"No {name} sessions found.")
            continue
        print(f"Importable {name} sessions ({len(sessions)}):")
        for s in sessions:
            ts = str(s.get("timestamp") or "")[:16].replace("T", " ")
            print(f"  {bold(s['id'][:13])}  {dim(ts):<17} {dim(str(s.get('messages', '?')) + ' msgs'):<9} {(s.get('title') or '')[:60]}")
            if s.get("cwd"):
                print(f"    {dim(s['cwd'])}")
    if total == 0 and not args.json:
        print("(no importable sessions in any known store)")
    return 0


def cmd_import(args):
    if not args.source:
        return cmd_list(args)
    kind, spec, meta = resolve_source(args.source, args.from_source, args.db)
    conv, stats = convert_source(kind, spec, meta, args.cwd, args.title,
                                 args.max_chars, args.db)
    print(f"source [{kind}]:  {spec}")
    print(f"session: {bold(conv['sid'])}  ({conv['workspace']})")
    print(f"         user={stats['user']} assistant={stats['assistant']} "
          f"tool-as-text={stats['tool']} skipped={stats['skipped']}")
    if args.dry_run:
        print(dim("(dry run — nothing written)"))
        return 0
    sdir, sid = write_session(conv)
    print(f"{green('imported')} {sid}")
    print(f"  log:   {os.path.join(sdir, 'session.jsonl')}")
    print(f"  resume with: muse resume {sid}")
    return 0


def build_parser():
    p = argparse.ArgumentParser(
        prog="muse import",
        description="Import foreign agent sessions into Muse Code.",
    )
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("list", help="list importable foreign sessions")
    s.add_argument("--source", choices=list(SOURCES),
                   help="only this source (default: all found)")
    s.add_argument("--db", metavar="PATH",
                   help="opencode db path (default: ~/.local/share/opencode/opencode.db)")
    s.add_argument("--json", action="store_true", help="raw JSON output")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("import", help="import a foreign session into muse")
    s.add_argument("source", nargs="?", metavar="ID|PATH",
                   help="session id/prefix or file path (default: list)")
    s.add_argument("--from", dest="from_source", choices=list(SOURCES),
                   help="force source intead of auto-detect")
    s.add_argument("--db", metavar="PATH", help="opencode db path")
    s.add_argument("--dry-run", action="store_true",
                   help="preview without writing")
    s.add_argument("--cwd", metavar="PATH", help="override workspace root")
    s.add_argument("--title", metavar="TITLE", help="override session title")
    s.add_argument("--max-chars", dest="max_chars", metavar="N", type=int,
                   default=None, help="truncate imported text blocks")
    s.set_defaults(func=cmd_import)
    # `muse import` with no subcommand behaves like `list`.
    p.set_defaults(func=lambda a: cmd_list(a))
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "cmd", None) is None:
        args.json = False
        args.source = None
        args.db = None
        return cmd_list(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
