--- /dev/null
+++ b/swfdec/swfdec_oil_compat.h
@@ -0,0 +1,154 @@
+/* Scalar replacements for the small subset of liboil used by Swfdec. */
+
+#ifndef __SWFDEC_OIL_COMPAT_H__
+#define __SWFDEC_OIL_COMPAT_H__
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+static inline void
+oil_init (void)
+{
+}
+
+static inline int
+oil_clamp_255 (int x)
+{
+  return x < 0 ? 0 : (x > 255 ? 255 : x);
+}
+
+static inline void
+oil_copy_u8 (uint8_t *dest, const uint8_t *src, int n)
+{
+  memmove (dest, src, n);
+}
+
+static inline void
+oil_merge_linear_u8 (uint8_t *dest, const uint8_t *src1, const uint8_t *src2,
+    const uint32_t *weight, int n)
+{
+  int i;
+  uint32_t w = *weight;
+
+  for (i = 0; i < n; i++)
+    dest[i] = (uint8_t) (((256 - w) * src1[i] + w * src2[i] + 128) >> 8);
+}
+
+static inline void
+oil_colorspace_argb (uint32_t *dest, const uint32_t *src,
+    const int16_t *matrix, int n)
+{
+  int i;
+
+  (void) matrix;
+  for (i = 0; i < n; i++) {
+    int y = (src[i] >> 16) & 0xff;
+    int u = (src[i] >> 8) & 0xff;
+    int v = src[i] & 0xff;
+    int c = y - 16;
+    int d = u - 128;
+    int e = v - 128;
+    int r = (298 * c + 409 * e + 128) >> 8;
+    int g = (298 * c - 100 * d - 208 * e + 128) >> 8;
+    int b = (298 * c + 516 * d + 128) >> 8;
+
+    dest[i] = (0xffU << 24) |
+      (oil_clamp_255 (r) << 16) |
+      (oil_clamp_255 (g) << 8) |
+      oil_clamp_255 (b);
+  }
+}
+
+static inline void
+oil_mult8x8_s16 (int16_t *dest, const int16_t *src1, const int16_t *src2,
+    int dstr, int sstr1, int sstr2)
+{
+  int x, y;
+
+  for (y = 0; y < 8; y++) {
+    int16_t *d = (int16_t *) ((uint8_t *) dest + y * dstr);
+    const int16_t *s1 = (const int16_t *) ((const uint8_t *) src1 + y * sstr1);
+    const int16_t *s2 = (const int16_t *) ((const uint8_t *) src2 + y * sstr2);
+    for (x = 0; x < 8; x++)
+      d[x] = s1[x] * s2[x];
+  }
+}
+
+static inline void
+oil_unzigzag8x8_s16 (int16_t *dest, int dstr, const int16_t *src, int sstr)
+{
+  static const uint8_t zigzag[64] = {
+    0, 1, 8, 16, 9, 2, 3, 10,
+    17, 24, 32, 25, 18, 11, 4, 5,
+    12, 19, 26, 33, 40, 48, 41, 34,
+    27, 20, 13, 6, 7, 14, 21, 28,
+    35, 42, 49, 56, 57, 50, 43, 36,
+    29, 22, 15, 23, 30, 37, 44, 51,
+    58, 59, 52, 45, 38, 31, 39, 46,
+    53, 60, 61, 54, 47, 55, 62, 63
+  };
+  int i;
+
+  memset (dest, 0, dstr * 8);
+  for (i = 0; i < 64; i++) {
+    int pos = zigzag[i];
+    int16_t *d = (int16_t *) ((uint8_t *) dest + (pos / 8) * dstr);
+    const int16_t *s = (const int16_t *) ((const uint8_t *) src + (i / 8) * sstr);
+    d[pos % 8] = s[i % 8];
+  }
+}
+
+static inline void
+oil_idct8x8_s16 (int16_t *dest, int dstr, const int16_t *src, int sstr)
+{
+  int x, y, u, v;
+  const double inv_sqrt2 = 0.70710678118654752440;
+
+  for (y = 0; y < 8; y++) {
+    int16_t *d = (int16_t *) ((uint8_t *) dest + y * dstr);
+    for (x = 0; x < 8; x++) {
+      double sum = 0.0;
+      for (v = 0; v < 8; v++) {
+	const int16_t *s = (const int16_t *) ((const uint8_t *) src + v * sstr);
+	for (u = 0; u < 8; u++) {
+	  double cu = u == 0 ? inv_sqrt2 : 1.0;
+	  double cv = v == 0 ? inv_sqrt2 : 1.0;
+	  sum += cu * cv * s[u] *
+	    cos (((2 * x + 1) * u * M_PI) / 16.0) *
+	    cos (((2 * y + 1) * v * M_PI) / 16.0);
+	}
