From 759939ca322a5ec4ee7f4342e97e80d252f1e832 Mon Sep 17 00:00:00 2001
From: Lubosz Sarnecki <lubosz@gmail.com>
Date: Mon, 13 Oct 2025 15:27:27 +0200
Subject: [PATCH] setup.py: Add -DGLOG_USE_GLOG_EXPORT flag.

---
 setup.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 681a423..c82fff2 100644
--- a/setup.py
+++ b/setup.py
@@ -199,6 +199,7 @@ if not SKIP_CUDA_BUILD and not IS_ROCM:
     nvcc_flags = [
     "-O3",
     "-std=c++17",
+    "-DGLOG_USE_GLOG_EXPORT",
     "-U__CUDA_NO_HALF_OPERATORS__",
     "-U__CUDA_NO_HALF_CONVERSIONS__",
     "-U__CUDA_NO_HALF2_OPERATORS__",
@@ -217,7 +218,7 @@ if not SKIP_CUDA_BUILD and not IS_ROCM:
     # "-DFLASHATTENTION_DISABLE_LOCAL",
     ]
 
-    compiler_c17_flag=["-O3", "-std=c++17"]
+    compiler_c17_flag=["-O3", "-std=c++17", "-DGLOG_USE_GLOG_EXPORT"]
     # Add Windows-specific flags
     if sys.platform == "win32" and os.getenv('DISTUTILS_USE_SDK') == '1':
         nvcc_flags.extend(["-Xcompiler", "/Zc:__cplusplus"])
-- 
2.51.0

