post_install() {
	cat <<-MSG
	==> liquidlauncher-bin is the recommended package.
	==> It is built from the official .deb release, does not need the
	==> AppImage runtime (fuse2) and integrates better with the system.
	==>
	==>   pacman -S liquidlauncher-bin  (or your AUR helper of choice)
	MSG
}

post_upgrade() {
	post_install
}
