+        static string Norm(string s) => s.Replace("-", "").ToLowerInvariant();
+
+        static bool IsNeg(PropertyInfo p) =>
+            p.PropertyType == typeof(bool) && p.Name.Length > 2 && p.Name.StartsWith("No") && char.IsUpper(p.Name[2]);
+
+        static string Kebab(string s) => Regex.Replace(s, "(?<!^)([A-Z])", "-$1").ToLowerInvariant().Replace("il2-cpp", "il2cpp");
+
+        static string[] ApplyFlags(string[] args)
+        {
+            var rest = new List<string>();
+            var props = typeof(Config).GetProperties();
+            for (var i = 0; i < args.Length; i++)
+            {
+                var a = args[i];
+                if (!a.StartsWith("--") || a == "--help") { rest.Add(a); continue; }
+                var body = a.Substring(2);
+                string value = null;
+                var eq = body.IndexOf('=');
+                if (eq >= 0) { value = body.Substring(eq + 1); body = body.Substring(0, eq); }
+
+                var negate = false;
+                var prop = props.FirstOrDefault(p => Norm(p.Name) == Norm(body));
+                if (prop == null && body.StartsWith("no-"))
+                {
+                    negate = true;
+                    prop = props.FirstOrDefault(p => Norm(p.Name) == Norm(body.Substring(3)));
+                }
+                if (prop == null)
+                {
+                    prop = props.FirstOrDefault(p => IsNeg(p) && Norm(p.Name.Substring(2)) == Norm(body));
+                    negate = prop != null;
+                }
+                if (prop == null)
+                {
+                    Console.Error.WriteLine($"ERROR: unknown option {a}");
+                    Environment.Exit(1);
+                }
+
+                try
+                {
+                    if (prop.PropertyType == typeof(bool))
+                    {
+                        var on = value == null || bool.Parse(value);
+                        prop.SetValue(config, negate ? !on : on);
+                    }
+                    else
+                    {
+                        if (value == null)
+                        {
+                            if (i + 1 >= args.Length) throw new ArgumentException("needs a value");
+                            value = args[++i];
+                        }
+                        prop.SetValue(config, Convert.ChangeType(value, prop.PropertyType, CultureInfo.InvariantCulture));
+                        if (prop.Name == "ForceVersion") config.ForceIl2CppVersion = true; // implied
+                    }
+                }
+                catch (Exception e)
+                {
+                    Console.Error.WriteLine($"ERROR: bad value for {a}: {e.Message}");
+                    Environment.Exit(1);
+                }
+            }
+            return rest.ToArray();
+        }
+
+
