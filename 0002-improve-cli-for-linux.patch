+            Console.WriteLine("options (override config: il2cppdumper.json):");
+            foreach (var p in typeof(Config).GetProperties())
+            {
+                var k = Kebab(p.Name);
+                if (p.PropertyType != typeof(bool))
+                    Console.WriteLine($"  --{k} <value>   (default: {p.GetValue(config)})");
+                else if (IsNeg(p))
