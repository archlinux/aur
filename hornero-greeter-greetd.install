post_install() {
  cat <<'EOF'

  hornero-greeter-greetd: to enable the Hornero greeter under greetd
  ------------------------------------------------------------------
  1. Install the greeter PAM stack (greetd asks PAM for the
     "greetd-greeter" service; without pam_systemd in it, cage gets no
     logind seat session and exits):

       sudo install -m644 /usr/share/doc/hornero-greeter-greetd/greetd-greeter.pam.example /etc/pam.d/greetd-greeter

  2. Point greetd at the session wrapper (it creates the greeter's
     private XDG_RUNTIME_DIR, then starts cage + the greeter).
     /etc/greetd/config.toml:

       [terminal]
       vt = 1
       [default_session]
       command = "/usr/bin/hornero-greetd-session"
       user = "greeter"

  3. Enable greetd and keep a console switch available (cage -s):

       sudo systemctl enable greetd.service

  The SDDM theme (hornero-greeter) is a separate package; both can be
  installed at the same time.
EOF
}

post_upgrade() {
  post_install
}
