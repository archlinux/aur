[Unit]
Description=DNS over HTTP proxy service
After=network.target

[Service]
User=doh-server
Group=doh-server
PrivateTmp=true
# NOTE: You may want to manually set hostname/domain below
ExecStart=/usr/sbin/doh-proxy \
    -H $(hostname -f) \
    -l 127.0.0.1:3000 \
    -u 127.0.0.1:53
Type=exec
Restart=always

[Install]
WantedBy=default.target
RequiredBy=network.target

