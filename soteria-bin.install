post_install() {
  cat <<'EOFMESSAGE'
==> To enable the polkit agent for your user session:
    systemctl --user enable --now soteria.service

==> If you have another polkit agent running (lxpolkit/polkit-gnome/xfce-polkit),
    disable it to avoid conflicts.
EOFMESSAGE
}

post_upgrade() {
  post_install
}
