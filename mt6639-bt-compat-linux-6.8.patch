Bluetooth: btusb/btmtk: adapt Linux 7.2 drivers to Ubuntu Linux 6.8

The HCI driver command interface is a new userspace control plane, not
part of the MT6639 firmware initialization. Register it only when the
host exposes that interface. No core command handlers are emulated.
On 6.8 use the original quirk bitmap and classify QCA diagnostic ACL
frames in the receive callback through the existing hci_recv_diag API.
Firmware download, MT6639 reset and ISO handling remain enabled.

Source: Linux 7.2 drivers/bluetooth; Ubuntu linux-hwe-6.8
6.8.0-138.138~22.04.1 headers and source used for API comparison.
Upstream driver licensing is retained; this compatibility change is
SPDX-License-Identifier: GPL-2.0-or-later

--- a/btusb.c
+++ b/btusb.c
@@ -18,16 +18,30 @@
 #include <linux/suspend.h>
 #include <linux/gpio/consumer.h>
 #include <linux/debugfs.h>
+#include <linux/version.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 12, 0)
+#include <asm/unaligned.h>
+#else
 #include <linux/unaligned.h>
+#endif

 #include <net/bluetooth/bluetooth.h>
 #include <net/bluetooth/hci_core.h>
+#if __has_include(<net/bluetooth/hci_drv.h>)
 #include <net/bluetooth/hci_drv.h>
+#define BTUSB_HAS_HCI_DRV
+#endif

 #include "btintel.h"
 #include "btbcm.h"
 #include "btrtl.h"
 #include "btmtk.h"
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 9, 0)
+/* 6.8 stores quirks in one unsigned long, rather than quirk_flags. */
+#define hci_set_quirk(hdev, nr) set_bit((nr), &(hdev)->quirks)
+#define hci_clear_quirk(hdev, nr) clear_bit((nr), &(hdev)->quirks)
+#endif

 #define VERSION "0.8"

@@ -3302,6 +3316,11 @@

 static int btusb_recv_acl_qca(struct hci_dev *hdev, struct sk_buff *skb)
 {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 9, 0)
+	/* Keep QCA diagnostic classification in the transport on 6.8. */
+	if (btusb_classify_qca_pkt_type(hdev, skb) == HCI_DIAG_PKT)
+		return hci_recv_diag(hdev, skb);
+#endif
 	if (acl_pkt_is_dump_qca(hdev, skb))
 		return handle_dump_pkt_qca(hdev, skb);
 	return hci_recv_frame(hdev, skb);
@@ -3936,6 +3955,7 @@
 	.llseek		= default_llseek,
 };

+#ifdef BTUSB_HAS_HCI_DRV
 #define BTUSB_HCI_DRV_OP_SUPPORTED_ALTSETTINGS \
 		hci_opcode_pack(HCI_DRV_OGF_DRIVER_SPECIFIC, 0x0000)
 #define BTUSB_HCI_DRV_SUPPORTED_ALTSETTINGS_SIZE	0
@@ -4066,6 +4086,8 @@
 	.specific_handlers	= btusb_hci_drv_specific_handlers,
 };

+#endif /* BTUSB_HAS_HCI_DRV */
+
 static int btusb_probe(struct usb_interface *intf,
 		       const struct usb_device_id *id)
 {
@@ -4195,7 +4217,9 @@
 	hdev->send    = btusb_send_frame;
 	hdev->notify  = btusb_notify;
 	hdev->wakeup  = btusb_wakeup;
+#ifdef BTUSB_HAS_HCI_DRV
 	hdev->hci_drv = &btusb_hci_drv;
+#endif

 	err = btusb_config_oob_wake(hdev);
 	if (err)
@@ -4311,7 +4335,9 @@
 		data->recv_acl = btusb_recv_acl_qca;
 		hci_devcd_register(hdev, btusb_coredump_qca, btusb_dump_hdr_qca, NULL);
 		data->setup_on_usb = btusb_setup_qca;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 9, 0)
 		hdev->classify_pkt_type = btusb_classify_qca_pkt_type;
+#endif
 		hdev->shutdown = btusb_shutdown_qca;
 		hdev->set_bdaddr = btusb_set_bdaddr_wcn6855;
 		hdev->reset = btusb_qca_reset;
