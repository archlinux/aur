post_install() {
  # Remove stale local user schemas that override the system schema.
  # These are left behind by previous 'meson install' to a local prefix
  # and cause startup crashes because they lack newer keys like
  # playback-volume-local, playback-volume-cast, playback-volume-dlna.
  for userdir in /home/*/.local/share/glib-2.0/schemas; do
    if [ -f "$userdir/de.haeckerfelix.Shortwave.gschema.xml" ]; then
      echo "==> Removing stale local schema override in $userdir"
      rm -f "$userdir/de.haeckerfelix.Shortwave.gschema.xml"
      glib-compile-schemas "$userdir" 2>/dev/null || true
    fi
  done

  # Ensure system GSettings schemas are compiled
  if [ -d /usr/share/glib-2.0/schemas ]; then
    echo "==> Compiling GSettings schemas..."
    glib-compile-schemas /usr/share/glib-2.0/schemas
    echo "==> Schema compilation complete"
  fi
  
  # Update icon cache
  if [ -d /usr/share/icons/hicolor ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  fi
  
  # Update desktop database
  update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
  post_install
}

post_remove() {
  # Recompile schemas after removal to clean up
  if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas 2>/dev/null || true
  fi
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database -q 2>/dev/null || true
}
