[Unit]
Description=The web frontend for seafile server.
After=seafile-server.service

[Service]
Type=forking
EnvironmentFile=/srv/seafile/conf/.env
ExecStart=/srv/seafile/seafile-server/seahub.sh start
ExecStop=/srv/seafile/seafile-server/seahub.sh stop
WorkingDirectory=/srv/seafile
User=seafile
Group=seafile

[Install]
WantedBy=multi-user.target
