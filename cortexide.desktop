[Desktop Entry]
Name=CortexIDE
Categories=Development;IDE;TextEditor;
Comment=Open-source AI code editor
Keywords=development;editor;ide;ai;
GenericName=Text Editor
Exec=/usr/bin/cortexide %F
Icon=cortexide
Type=Application
StartupNotify=false
StartupWMClass=CortexIDE
MimeType=text/plain;inode/directory;application/x-cortexide-workspace;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=/usr/bin/cortexide --new-window %F
Icon=cortexide
