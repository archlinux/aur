+  def target_architecture_index(self):
+    """Map generated targets to requested architectures in one operation pass."""
+    architecture_features = [
+      (architecture, int(architecture.split('a')[0].split('f')[0]))
+      for architecture in self.compute_capabilities_feature_set
+    ]
+    supported_by_target = {}
+
+    for kind, operations_by_cc in self.operations.items():
+      for min_cc, configurations in operations_by_cc.items():
+        for operations in configurations.values():
+          for operation in operations:
+            key = (kind, min_cc, operation.extended_name())
+            supported = supported_by_target.setdefault(key, set())
+            if not self.filter_by_cc:
+              supported.update(self.compute_capabilities_feature_set)
+              continue
+            tile = operation.tile_description
+            smem_usage = CalculateSmemUsage(operation)
+
+            for architecture, baseline_cc in architecture_features:
+              if baseline_cc >= tile.minimum_compute_capability and \
+                 baseline_cc <= tile.maximum_compute_capability and \
+                 (baseline_cc not in SharedMemPerCC or
+                  SharedMemPerCC[baseline_cc] >= smem_usage):
+                supported.add(architecture)
+
+    target_architectures = {}
+    for key, supported in supported_by_target.items():
+      architectures = [
+        architecture for architecture in self.compute_capabilities_feature_set
+        if architecture in supported
+      ]
+      if not architectures:
+        kind, min_cc, subclass = key
+        raise RuntimeError(
+          "No requested architecture supports generated target "
+          f"{OperationKindNames[kind]}_sm{min_cc}_{subclass}")
+      target_architectures[key] = architectures
+
+    return target_architectures
+
   def emit_manifest_cmake(self, manifest_path, top_level_path, source_files):
+    target_architectures = self.target_architecture_index()
     with open(manifest_path, "w") as manifest_file:
 
