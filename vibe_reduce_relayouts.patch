From f146e40a5ad68851c86f4af42c4c7e1ff11efc7d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ivica=20Ki=C4=8Di=C4=87?= <ivicakicic@gmail.com>
Date: Thu, 2 Jul 2026 11:51:52 +0200
Subject: [PATCH 1/2] Skip relayout for animation frames

Every animation tick (spinner, loading gradient, banner cat, bash
prompt spinner, recording indicator) pushed its frame with
Static.update(), which defaults to layout=True, causing very high CPU
usage.

To fix this, pass layout=False, because all of these frames are fixed-size.
---
 vibe/cli/textual_ui/recording/recording_indicator.py | 5 +++--
 vibe/cli/textual_ui/widgets/banner/petit_chat.py     | 4 +++-
 vibe/cli/textual_ui/widgets/loading.py               | 7 +++++--
 vibe/cli/textual_ui/widgets/messages.py              | 3 ++-
 vibe/cli/textual_ui/widgets/spinner.py               | 3 ++-
 5 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/vibe/cli/textual_ui/recording/recording_indicator.py b/vibe/cli/textual_ui/recording/recording_indicator.py
index ddd07c33c..d9a7329f0 100644
--- a/vibe/cli/textual_ui/recording/recording_indicator.py
+++ b/vibe/cli/textual_ui/recording/recording_indicator.py
@@ -53,7 +53,8 @@ def _poll_peak(self) -> None:
         index = min(
             int(self._voice_manager.peak * len(PEAK_BLOCKS)), len(PEAK_BLOCKS) - 1
         )
-        self.update(PEAK_BLOCKS[index])
+        # Frames are all one cell wide; skip the (whole-screen) relayout.
+        self.update(PEAK_BLOCKS[index], layout=False)
 
     def _stop_peak_polling(self) -> None:
         if self._peak_timer:
@@ -71,7 +72,7 @@ def _advance_flushing_animation(self) -> None:
         if self._voice_manager.transcribe_state != TranscribeState.FLUSHING:
             return
         self._processing_index = (self._processing_index + 1) % len(FILL_BLOCKS)
-        self.update(FILL_BLOCKS[self._processing_index])
+        self.update(FILL_BLOCKS[self._processing_index], layout=False)
 
     def _stop_flushing_animation_timer(self) -> None:
         if self._flushing_animation_timer:
diff --git a/vibe/cli/textual_ui/widgets/banner/petit_chat.py b/vibe/cli/textual_ui/widgets/banner/petit_chat.py
index 183991adf..cdcd2c929 100644
--- a/vibe/cli/textual_ui/widgets/banner/petit_chat.py
+++ b/vibe/cli/textual_ui/widgets/banner/petit_chat.py
@@ -206,7 +206,9 @@ def _apply_next_transition(self) -> None:
         self._dots -= transition["remove"]
         self._dots |= transition["add"]
         self._transition_index = (self._transition_index + 1) % len(TRANSITIONS)
-        self._inner.update(render_braille(self._dots, WIDTH, HEIGHT))
+        # render_braille always emits the full WIDTH x HEIGHT grid, so frames
+        # never change size; skip the (whole-screen) relayout.
+        self._inner.update(render_braille(self._dots, WIDTH, HEIGHT), layout=False)
 
         if not self._may_stop():
             return
diff --git a/vibe/cli/textual_ui/widgets/loading.py b/vibe/cli/textual_ui/widgets/loading.py
index f45ba59a3..0de497b6f 100644
--- a/vibe/cli/textual_ui/widgets/loading.py
+++ b/vibe/cli/textual_ui/widgets/loading.py
@@ -214,13 +214,16 @@ def _build_status_text(self) -> str:
