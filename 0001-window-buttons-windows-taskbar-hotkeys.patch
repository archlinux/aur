+static gboolean
+tasklist_plugin_remote_event (XfcePanelPlugin *panel_plugin,
+                              const gchar *name,
+                              const GValue *value)
+{
+  TasklistPlugin *plugin = TASKLIST_PLUGIN (panel_plugin);
+  XfceTasklistHotkeyAction action;
+  const gchar *separator;
+  gchar *event;
+  gint unique_id;
+
+  panel_return_val_if_fail (value == NULL || G_IS_VALUE (value), FALSE);
+
+  separator = strrchr (name, '-');
+  if (separator == NULL || separator == name)
+    return FALSE;
+
+  unique_id = g_ascii_strtoll (separator + 1, NULL, 10);
+  if (unique_id != xfce_panel_plugin_get_unique_id (panel_plugin))
+    return FALSE;
+
+  event = g_strndup (name, separator - name);
+
+  if (g_strcmp0 (event, "cycle") == 0
+      || g_strcmp0 (event, "cycle-backwards") == 0)
+    {
+      xfce_tasklist_hotkey_cycle (XFCE_TASKLIST (plugin->tasklist),
+                                  g_strcmp0 (event, "cycle-backwards") == 0);
+      g_free (event);
+      return TRUE;
+    }
+
+  if (value == NULL || !G_VALUE_HOLDS_UINT64 (value))
+    {
+      g_free (event);
+      return TRUE;
+    }
+
+  if (g_strcmp0 (event, "activate") == 0)
+    action = XFCE_TASKLIST_HOTKEY_ACTIVATE;
+  else if (g_strcmp0 (event, "new-instance") == 0)
+    action = XFCE_TASKLIST_HOTKEY_NEW_INSTANCE;
+  else if (g_strcmp0 (event, "activate-last") == 0)
+    action = XFCE_TASKLIST_HOTKEY_ACTIVATE_LAST;
+  else if (g_strcmp0 (event, "menu") == 0)
+    action = XFCE_TASKLIST_HOTKEY_MENU;
+  else
+    {
+      g_free (event);
+      return TRUE;
+    }
+
+  xfce_tasklist_hotkey_activate (XFCE_TASKLIST (plugin->tasklist),
+                                 g_value_get_uint64 (value), action);
+  g_free (event);
+
+  return TRUE;
+}
