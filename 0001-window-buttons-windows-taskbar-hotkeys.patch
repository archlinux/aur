+
+static XfceTasklistChild *
+xfce_tasklist_hotkey_get_child (XfceTasklist *tasklist,
+                                guint position)
+{
+  GList *li;
+
+  if (position == 0)
+    return NULL;
+
+  for (li = tasklist->windows; li != NULL; li = li->next)
+    {
+      XfceTasklistChild *child = li->data;
+
+      if (!gtk_widget_get_visible (child->button)
+          || (child->type != CHILD_TYPE_WINDOW
+              && child->type != CHILD_TYPE_GROUP))
+        continue;
+
+      if (--position == 0)
+        return child;
+    }
+
+  return NULL;
+}
+
+static XfceTasklistChild *
+xfce_tasklist_hotkey_get_group_window (XfceTasklistChild *group_child,
+                                       gboolean cycle)
+{
+  XfceTasklistChild *active = NULL;
+  XfceTasklistChild *last = NULL;
+  XfceTasklistChild *first = NULL;
+  GSList *li;
+
+  for (li = group_child->windows; li != NULL; li = li->next)
+    {
+      XfceTasklistChild *child = li->data;
+
+      if (!gtk_widget_get_visible (child->button)
+          || child->type != CHILD_TYPE_GROUP_MENU)
+        continue;
+
+      if (first == NULL)
+        first = child;
+      if (last == NULL || child->last_focused > last->last_focused)
+        last = child;
+      if (xfw_window_is_active (child->window))
+        active = child;
+    }
+
+  if (!cycle || active == NULL)
+    return last;
+
+  for (li = g_slist_find (group_child->windows, active); li != NULL; li = li->next)
+    {
+      XfceTasklistChild *child = li->data;
+
+      if (child != active
+          && gtk_widget_get_visible (child->button)
+          && child->type == CHILD_TYPE_GROUP_MENU)
+        return child;
+    }
+
+  return first;
+}
+
+static void
+xfce_tasklist_hotkey_popup_menu (XfceTasklistChild *child)
+{
+  XfcePanelPlugin *plugin = xfce_tasklist_get_panel_plugin (child->tasklist);
+  GtkWidget *menu;
+
+  if (child->type == CHILD_TYPE_GROUP)
+    {
+      menu = xfce_tasklist_group_button_menu (child, TRUE);
+      g_signal_connect (G_OBJECT (menu), "deactivate",
+                        G_CALLBACK (xfce_tasklist_group_button_menu_destroy), child);
+    }
+  else
+    {
+      menu = xfw_window_action_menu_new (child->window);
+      xfce_tasklist_button_add_launch_new_instance_item (child, menu, FALSE);
+      g_signal_connect (G_OBJECT (menu), "deactivate",
+                        G_CALLBACK (xfce_tasklist_button_menu_destroy), child);
+    }
+
+  gtk_menu_attach_to_widget (GTK_MENU (menu), child->button, xfce_tasklist_menu_deactivate);
+  xfce_panel_plugin_popup_menu (plugin, GTK_MENU (menu), child->button, NULL);
+  gtk_toggle_button_set_active (GTK_TOGGLE_BUTTON (child->button), TRUE);
+}
+
+gboolean
+xfce_tasklist_hotkey_activate (XfceTasklist *tasklist,
+                               guint position,
+                               XfceTasklistHotkeyAction action)
+{
+  XfceTasklistChild *child;
+  XfceTasklistChild *window_child;
+
+  panel_return_val_if_fail (XFCE_IS_TASKLIST (tasklist), FALSE);
+
+  child = xfce_tasklist_hotkey_get_child (tasklist, position);
+  if (child == NULL)
+    return FALSE;
+
+  if (action == XFCE_TASKLIST_HOTKEY_MENU)
+    {
+      xfce_tasklist_hotkey_popup_menu (child);
+      return TRUE;
+    }
+
+  window_child = child->type == CHILD_TYPE_GROUP
+                   ? xfce_tasklist_hotkey_get_group_window (child,
+                                                            action == XFCE_TASKLIST_HOTKEY_ACTIVATE)
+                   : child;
+  if (window_child == NULL)
+    return FALSE;
+
+  if (action == XFCE_TASKLIST_HOTKEY_NEW_INSTANCE)
+    xfce_tasklist_button_start_new_instance_clicked (window_child->button, window_child);
+  else if (!xfw_window_is_active (window_child->window))
+    xfce_tasklist_button_activate (window_child, gtk_get_current_event_time ());
+  else if (action == XFCE_TASKLIST_HOTKEY_ACTIVATE)
+    xfw_window_set_minimized (window_child->window, TRUE, NULL);
+
+  return TRUE;
+}
+
+gboolean
+xfce_tasklist_hotkey_cycle (XfceTasklist *tasklist,
+                            gboolean backwards)
+{
+  XfwWindow *active_window;
+  XfceTasklistChild *child;
+  GPtrArray *children;
+  guint next = 0;
+  guint i;
+  GList *li;
+
+  panel_return_val_if_fail (XFCE_IS_TASKLIST (tasklist), FALSE);
+
+  children = g_ptr_array_new ();
+  active_window = xfw_screen_get_active_window (tasklist->screen);
+
+  for (li = tasklist->windows; li != NULL; li = li->next)
+    {
+      child = li->data;
+      if (gtk_widget_get_visible (child->button)
+          && (child->type == CHILD_TYPE_WINDOW || child->type == CHILD_TYPE_GROUP))
+        g_ptr_array_add (children, child);
+    }
+
+  if (children->len == 0)
+    {
+      g_ptr_array_free (children, TRUE);
+      return FALSE;
+    }
+
+  for (i = 0; i < children->len; i++)
+    {
+      gboolean active = FALSE;
+
+      child = g_ptr_array_index (children, i);
+      if (child->type == CHILD_TYPE_WINDOW)
+        active = child->window == active_window;
+      else
+        for (GSList *lp = child->windows; lp != NULL; lp = lp->next)
+          {
+            XfceTasklistChild *window_child = lp->data;
+            if (window_child->window == active_window)
+              {
+                active = TRUE;
+                break;
+              }
+          }
+
+      if (active)
+        {
+          next = backwards ? (i + children->len - 1) % children->len
+                           : (i + 1) % children->len;
+          break;
+        }
+    }
+
+  child = g_ptr_array_index (children, next);
+  if (child->type == CHILD_TYPE_GROUP)
+    child = xfce_tasklist_hotkey_get_group_window (child, FALSE);
+
+  if (child != NULL && !xfw_window_is_active (child->window))
+    xfce_tasklist_button_activate (child, gtk_get_current_event_time ());
+
+  g_ptr_array_free (children, TRUE);
+  return child != NULL;
+}
