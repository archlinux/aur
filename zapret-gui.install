post_install() {
  if command -v setcap >/dev/null 2>&1; then
    setcap cap_net_admin,cap_net_raw+ep /usr/lib/zapret-gui/exe/nfqws 2>/dev/null || true
    setcap cap_net_admin,cap_net_raw+ep /usr/lib/zapret-gui/exe/nfqws2 2>/dev/null || true
  fi
}

post_upgrade() {
  post_install
}

post_remove() {
  :
}
