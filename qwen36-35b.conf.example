# Copy to /etc/colibri/qwen36-35b.conf before enabling the instance.
COLI_MODEL=/var/lib/llama/models/colibri/qwen36-35b
COLI_HOST=127.0.0.1
COLI_PORT=8090
COLI_AUTO_TIER=1
# COLI_CTX=32768
# COLI_POLICY=balanced
# COLI_KV_SLOTS=1
COLI_CPU_AFFINITY=0-5
OMP_NUM_THREADS=6
OMP_DYNAMIC=FALSE
OMP_PROC_BIND=TRUE
OMP_PLACES=cores
COLI_LOOKUP=0
COLI_KV_PREFIX=1
COLI_PREFIX_LOG=1
COLI_NO_OMP_TUNE=1
