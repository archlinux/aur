post_install() {
    cat <<'EOF'
==> whatevr installed whatevrd systemd user units.
==> Enable one startup mode:
==>   systemctl --user enable --now whatevrd.socket
==> or:
==>   systemctl --user enable --now whatevrd.service
EOF
}

post_upgrade() {
    cat <<'EOF'
==> Reload whatevrd's systemd user units and restart the active startup mode:
==>   systemctl --user daemon-reload
==>   systemctl --user try-restart whatevrd.socket whatevrd.service
EOF
}
