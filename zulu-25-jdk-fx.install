_THIS_JDK='zulu-25-jdk-fx'

_fix_default() {
    if [[ ! -x /usr/bin/java ]]; then
        /usr/bin/archlinux-java unset
        printf ''
    else
        /usr/bin/archlinux-java get
    fi
}

post_install() {
    local default
    default=$(_fix_default)

    if [[ -z "$default" ]]; then
        /usr/bin/archlinux-java set "$_THIS_JDK"
    fi
}

post_upgrade() {
    local default
    default=$(_fix_default)

    if [[ -z "$default" ]]; then
        /usr/bin/archlinux-java set "$_THIS_JDK"
    fi
}

pre_remove() {
    local default
    default=$(_fix_default)

    if [[ "$default" == "$_THIS_JDK" ]]; then
        /usr/bin/archlinux-java unset
    fi
}
