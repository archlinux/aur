pkgname="mechclick"

pkg_install() {
    # Enable systemd user service
    if [ -f "$pkgdir/usr/lib/systemd/user/mechclick.service" ]; then
        systemctl --user enable mechclick.service 2>/dev/null || true
    fi
}

pkg_upgrade() {
    # Reload systemd daemon after upgrade
    systemctl --user daemon-reload 2>/dev/null || true
    
    # Restart service if running
    if systemctl --user is-active --quiet mechclick.service; then
        systemctl --user restart mechclick.service
    fi
}

pkg_remove() {
    # Disable systemd user service
    systemctl --user disable mechclick.service 2>/dev/null || true
}
