_setup_venv() {
    python3 -m venv /usr/share/Linux-Chan-AI/python-env
    /usr/share/Linux-Chan-AI/python-env/bin/pip install --quiet --upgrade pip
    /usr/share/Linux-Chan-AI/python-env/bin/pip install --quiet \
        -r /usr/share/Linux-Chan-AI/requirements.txt
}

post_install() {
    echo "==> Python sanal ortamı oluşturuluyor..."
    _setup_venv
    echo ""
    echo "==> Linux Chan AI kuruldu!"
    echo "==> Kullanmadan önce Gemini API anahtarınızı ayarlayın:"
    echo "    mkdir -p ~/.config/linux-chan-ai"
    echo "    echo 'GEMINI_API_KEY=your_key_here' > ~/.config/linux-chan-ai/.env"
    echo ""
    echo "==> Başlatmak için: linux-chan-ai"
    echo ""
}

post_upgrade() {
    echo "==> Bağımlılıklar güncelleniyor..."
    _setup_venv
    echo "==> Güncelleme tamamlandı."
}

pre_remove() {
    rm -rf /usr/share/Linux-Chan-AI/python-env
}
