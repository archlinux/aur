pkgname=zig-git
pkgver=0.17.0.r245.gf7a607ef68c9
pkgrel=1
pkgdesc='Zig programming language (static standalone toolchain)'
arch=('aarch64' 'x86_64')
url='https://ziglang.org/'
license=('MIT' 'Apache-2.0-with-LLVM-exception')
conflicts=(zig)
provides=("zig=${pkgver%%.r*}")
depends=(glibc libxml2 python)
makedepends=(cmake gcc git glibc libxml2 python)
options=(!emptydirs !lto staticlibs)
source=("git+https://github.com/zlib-ng/zlib-ng#tag=2.3.3"
        "git+https://github.com/facebook/zstd.git#tag=v1.5.7"
        "git+https://github.com/llvm/llvm-project.git#tag=llvmorg-22.1.4"
        "git+https://codeberg.org/ziglang/zig.git#branch=master")
sha256sums=('aa625dc5ecdeb0ea6c12d76518dd10a55e865499c5a0fced68f52cb751542041'
            'e43521ef6e50b3c0f42612f6147c2f74c1c3af18e1c2d56fb91b8ddcb590c699'
            '1645888af17256c905125c2ba6ccbbb810fedf2587cd35205398a5459f48e519'
            'SKIP')

pkgver() {
  cd zig

  MAJ=$(grep "set(ZIG_VERSION_MAJOR" CMakeLists.txt | cut -d' ' -f2 | cut -d')' -f1)
  MIN=$(grep "set(ZIG_VERSION_MINOR" CMakeLists.txt | cut -d' ' -f2 | cut -d')' -f1)
  PAT=$(grep "set(ZIG_VERSION_PATCH" CMakeLists.txt | cut -d' ' -f2 | cut -d')' -f1)
  HASH=$(git describe --long --tags --abbrev=12 | sed 's/v//;s/\([^-]*-g\)/r\1/;s/-/./g' | cut -d'.' -f4,5)
  echo "$MAJ.$MIN.$PAT.${HASH}"
}

build() {
  local DEPS_PREFIX="${srcdir}/deps-install"
  local LLVM_CONFIG="${DEPS_PREFIX}/bin/llvm-config"

  CFLAGS="${CFLAGS/-Wp,-D_FORTIFY_SOURCE=3/} -ffat-lto-objects"
  CXXFLAGS="${CXXFLAGS/-Wp,-D_FORTIFY_SOURCE=3/} -ffat-lto-objects"

  msg2 "###########################"
  msg2 "# Building static zlib... #"
  msg2 "###########################"

  cmake -S ${srcdir}/zlib-ng -B build-zlib \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_INSTALL_PREFIX="${DEPS_PREFIX}" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_GTEST=OFF \
    -DZLIB_BUILD_STATIC=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DZLIB_COMPAT=ON \
    -Wno-dev

  cmake --build build-zlib
  cmake --install build-zlib

  msg2 "###########################"
  msg2 "# Building static zstd... #"
  msg2 "###########################"

  cmake -S ${srcdir}/zstd/build/cmake -B build-zstd \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_INSTALL_PREFIX="${DEPS_PREFIX}" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DZSTD_ZLIB_SUPPORT=ON \
    -DZSTD_LZMA_SUPPORT=ON \
    -DZSTD_LZ4_SUPPORT=ON \
    -DZSTD_BUILD_CONTRIB=OFF \
    -DZSTD_BUILD_STATIC=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DZSTD_BUILD_TESTS=OFF \
    -DZSTD_PROGRAMS_LINK_SHARED=OFF

  cmake --build build-zstd
  cmake --install build-zstd
  rm -f ${DEPS_PREFIX}/lib/*zstd*so*

  msg2 "###########################"
  msg2 "# Building static LLVM... #"
  msg2 "###########################"

  cmake -S ${srcdir}/llvm-project/llvm -B build-llvm \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_INSTALL_PREFIX="${DEPS_PREFIX}" \
    -DCMAKE_PREFIX_PATH="${DEPS_PREFIX}" \
    -DLLVM_ENABLE_PROJECTS="lld;clang" \
    -DLLVM_ENABLE_LIBXML2=OFF \
    -DLLVM_ENABLE_TERMINFO=OFF \
    -DLLVM_ENABLE_ZLIB=FORCE_ON \
    -DLLVM_ENABLE_ZSTD=FORCE_ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DLLVM_BUILD_LLVM_DYLIB=OFF \
    -DLLVM_LINK_LLVM_DYLIB=OFF \
    -DLLVM_TARGETS_TO_BUILD="all"

  cmake --build build-llvm
  cmake --install build-llvm

  msg2 "##########################"
  msg2 "# Building static Zig... #"
  msg2 "##########################"

  $LLVM_CONFIG --link-static --libs --system-libs
  cmake -S ${srcdir}/zig -B build-zig \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_PREFIX_PATH="${DEPS_PREFIX}" \
    -DCMAKE_IGNORE_PATH="/usr/lib/llvm;/usr/lib/cmake/llvm" \
    -DZIG_STATIC_ZLIB=ON \
    -DZIG_STATIC_ZSTD=ON \
    -DZIG_STATIC_LLVM=ON \
    -DZIG_USE_LLVM_CONFIG=ON \
    -DLLVM_CONFIG_EXE="${LLVM_CONFIG}" \
    -DZIG_TARGET_TRIPLE=native-linux.6.18-gnu.2.42 \
    -DZIG_TARGET_MCPU=baseline \
    -DCMAKE_CXX_STANDARD_LIBRARIES="-Wl,--start-group -lpthread -ldl -lz -lzstd -lxml2 -Wl,--end-group"

  cmake --build build-zig
}

package() {
  DESTDIR=${pkgdir} cmake --install build-zig
  install -Dm644 ${srcdir}/zig/LICENSE ${pkgdir}/usr/share/licenses/${pkgname}/LICENSE
  rm ${pkgdir}/usr/doc/langref.html
}
