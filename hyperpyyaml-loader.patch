--- a/speechbrain/utils/hparams.py
+++ b/speechbrain/utils/hparams.py
@@ -7,2 +7,22 @@
+import yaml
+from hyperpyyaml import load_hyperpyyaml as _load_hyperpyyaml
+
+
+def load_hyperpyyaml(
+    yaml_stream, overrides=None, overrides_must_match=True, loader=yaml.Loader
+):
+    """Load trusted SpeechBrain configuration with HyperPyYAML's public API.
+
+    ruamel.yaml 0.19's legacy Loader does not initialize the max_depth field
+    required by its composer. HyperPyYAML supports PyYAML loaders explicitly;
+    use that backend here while retaining reference resolution and custom tags.
+    Configurations can construct Python objects and must remain trusted input.
+    """
+    return _load_hyperpyyaml(
+        yaml_stream,
+        overrides=overrides,
+        overrides_must_match=overrides_must_match,
+        loader=loader,
+    )
 
 
