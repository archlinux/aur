#!/bin/bash

# --- COLOR CONFIGURATION (DEBIAN STYLE) ---
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# --- DEPENDENCY CHECK ---
if ! command -v yay &> /dev/null && ! command -v pacman &> /dev/null; then
    echo -e "${RED}E: Package management system not found!${NC}"
    exit 1
fi

COMMAND="$1"

case "$COMMAND" in
    update)
        echo -e "${GREEN}Reading package lists... Done${NC}"
        # Syncing databases (Repos + AUR)
        yay -Sy
        ;;

    upgrade|dist-upgrade)
        echo -e "${GREEN}Reading package lists... Done${NC}"
        echo -e "${GREEN}Calculating upgrade... Done${NC}"
        # Full system upgrade
        yay -Syu
        ;;

    install)
        shift
        if [ -z "$1" ]; then
            echo -e "${RED}E: You must specify at least one package to install${NC}"
            exit 1
        fi
        echo -e "${GREEN}Reading package lists... Done${NC}"
        echo -e "${GREEN}Building dependency tree... Done${NC}"
        # Fallback logic: try pacman first, then yay
        sudo pacman -S "$@" || yay -S "$@"
        ;;

    remove)
        shift
        echo -e "${GREEN}Removing packages...${NC}"
        sudo pacman -Rs "$@"
        ;;

    purge)
        shift
        echo -e "${GREEN}Purging packages and configuration files...${NC}"
        sudo pacman -Rns "$@"
        ;;

    autoremove)
        echo -e "${GREEN}Reading package lists... Done${NC}"
        ORPHANS=$(pacman -Qdtq)
        if [ -n "$ORPHANS" ]; then
            sudo pacman -Rns $ORPHANS
        else
            echo "0 upgraded, 0 newly installed, 0 to remove and 0 not upgraded."
        fi
        ;;

    search)
        shift
        # Search everywhere (Repos + AUR)
        yay -Ss "$@"
        ;;

    show)
        shift
        # Show info from local DB or repos
        pacman -Si "$@" || yay -Si "$@"
        ;;

    clean)
        echo -e "${GREEN}Cleaning package cache...${NC}"
        sudo pacman -Scc
        ;;

    help|--help)
        echo "apt 2.10.1 (Arch/CachyOS Wrapper) - GPL License"
        echo "Usage: apt [command] [package]"
        echo ""
        echo "Available commands:"
        echo "  update      - Synchronize repository databases"
        echo "  upgrade     - Perform a full system upgrade"
        echo "  install     - Install new packages (Repo + AUR)"
        echo "  remove      - Remove packages"
        echo "  purge       - Remove packages and their config files"
        echo "  autoremove  - Remove unused orphan packages"
        echo "  search      - Search for packages"
        echo "  show        - Show package details"
        echo "  clean       - Clear the local package cache"
        ;;

    *)
        echo -e "${RED}E: Invalid operation $COMMAND${NC}"
        echo "Use 'apt help' to see available commands."
        exit 1
        ;;
esac
