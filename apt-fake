#!/bin/bash

if [[ $EUID -ne 0 ]]; then
   zenity --error --text="Questo comando deve essere eseguito come root (sudo)." --width=300
   exit 1
fi

case "$1" in
    update)
        pacman -Sy | zenity --text-info --title="Update" --width=400 --height=300 --auto-scroll
        ;;
    upgrade)
        pacman -Syu | zenity --text-info --title="Upgrade" --width=400 --height=300 --auto-scroll
        ;;
    install)
        shift
        pacman -S "$@" | zenity --text-info --title="Install" --width=400 --height=300 --auto-scroll
        ;;
    remove|purge)
        shift
        pacman -Rs "$@" | zenity --text-info --title="Remove" --width=400 --height=300 --auto-scroll
        ;;
    autoremove)
        pacman -Rns $(pacman -Qdtq) | zenity --text-info --title="Autoremove" --width=400 --height=300 --auto-scroll
        ;;
    *)
        echo "Usage: apt-fake {update|upgrade|install|remove|autoremove}"
        exit 1
        ;;
esac
