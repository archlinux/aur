[Unit]
Description=ArkSigner e-Imza Arka Plan Servisi
After=network.target pcscd.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/arksigner
Environment="LD_LIBRARY_PATH=/opt/arksigner/libs:/usr/local/lib64"
Environment="LD_PRELOAD=/opt/arksigner/libs/libssl.so.1.1:/opt/arksigner/libs/libcrypto.so.1.1"
ExecStart=/opt/arksigner/arksigner-service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
