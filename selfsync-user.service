[Unit]
Description=Self-hosted Chrome Sync server.
Documentation=https://github.com/loyalpartner/selfsync

[Service]
Type=simple
ExecStart=/usr/bin/selfsync-server
WorkingDirectory=%S/selfsync
BindPaths=%S/selfsync
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
StateDirectory=selfsync
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
PrivateUsers=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
PrivateBPF=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
PrivateMounts=true
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallArchitectures=native

[Install]
WantedBy=default.target
