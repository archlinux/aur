From 3f339c41a96236818c6f0e6e6d854e76f8004568 Mon Sep 17 00:00:00 2001
From: graysky <therealgraysky AT proton DOT me>
Date: Sun, 19 Apr 2026 10:26:33 -0400
Subject: [PATCH 2/3] Expose whisper decode options

* temperature (float, default 0.0)
* no_speech_thold (float, default 0.6)

Helps avoid model hallucinations
---
 libavfilter/af_whisper.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/libavfilter/af_whisper.c b/libavfilter/af_whisper.c
index 75103ced0c41..baacdac2b63d 100644
--- a/libavfilter/af_whisper.c
+++ b/libavfilter/af_whisper.c
@@ -55,6 +55,10 @@ typedef struct WhisperContext {
     char *destination;
     char *format;
     int max_len;
+    float temperature_inc;
+
+    float no_speech_thold;
+    float temperature;
 
     struct whisper_context *ctx_wsp;
     struct whisper_vad_context *ctx_vad;
@@ -224,6 +228,9 @@ static void run_transcription(AVFilterContext *ctx, AVFrame *frame, int samples)
     params.max_len = wctx->max_len;
     params.token_timestamps = (wctx->max_len > 0);
     params.split_on_word = (wctx->max_len > 0);
+    params.no_speech_thold = wctx->no_speech_thold;
+    params.temperature = wctx->temperature;
+    params.temperature_inc = wctx->temperature_inc;
 
     if (whisper_full(wctx->ctx_wsp, params, wctx->audio_buffer, samples) != 0) {
         av_log(ctx, AV_LOG_ERROR, "Failed to process audio with whisper.cpp\n");
@@ -471,6 +478,9 @@ static const AVOption whisper_options[] = {
     { "vad_threshold", "VAD threshold", OFFSET(vad_threshold), AV_OPT_TYPE_FLOAT, {.dbl = 0.5}, 0.0, 1.0, .flags = FLAGS },
     { "vad_min_speech_duration", "Minimum speech duration for VAD", OFFSET(vad_min_speech_duration), AV_OPT_TYPE_DURATION, {.i64 = 100000}, 20000, HOURS, .flags = FLAGS },
     { "vad_min_silence_duration", "Minimum silence duration for VAD", OFFSET(vad_min_silence_duration), AV_OPT_TYPE_DURATION, {.i64 = 500000}, 0, HOURS, .flags = FLAGS },
+    { "no_speech_thold",           "No-speech probability threshold",       OFFSET(no_speech_thold),           AV_OPT_TYPE_FLOAT, {.dbl = 0.6},  0.0, 1.0,     .flags = FLAGS },
+    { "temperature",               "Sampling temperature (0 = greedy)",     OFFSET(temperature),               AV_OPT_TYPE_FLOAT, {.dbl = 0.0},  0.0, 1.0,     .flags = FLAGS },
+    { "temperature_inc", "Temperature increment for fallback (0 = disabled)", OFFSET(temperature_inc), AV_OPT_TYPE_FLOAT, {.dbl = 0.2}, 0.0, 1.0, .flags = FLAGS },
     { NULL }
 };
 
