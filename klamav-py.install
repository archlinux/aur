# Su Arch la policy è NON abilitare né disabilitare unit systemd in fase di
# install/rimozione: lo stato del sistema è dell'utente. Ci si limita a
# stampare un hint, come fanno i pacchetti ufficiali.
post_install() {
  echo "klamav-py: le scansioni automatiche si configurano nella GUI,"
  echo "  pagina Pianificazione (girano con KlamAV-Py aperto, anche nella tray)."
  echo "klamav-py: la GUI richiede il pacchetto pyside6,"
  echo "  la scansione richiede il demone clamd attivo (pacchetto clamav)."
}

post_upgrade() {
  post_install
  # klamav-scan.timer non è più nel pacchetto. La GUI, al primo avvio,
  # toglie abilitazione e drop-in rimasti nella home (legacy_timer.py).
  if [ "$(vercmp "$2" 0.2.0)" -lt 0 ]; then
    echo "klamav-py: la scansione programmata di sistema (klamav-scan.timer)"
    echo "  è stata rimossa. Per fermarla subito nella sessione in corso:"
    echo "  systemctl --user disable --now klamav-scan.timer"
  fi
}
