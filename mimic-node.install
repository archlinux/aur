# Mimic-Node Install Script

post_install() {
    echo ""
    echo "================================================================================"
    echo "                    Mimic-Node 安装完成"
    echo "================================================================================"
    echo ""
    echo "  快速开始:"
    echo ""
    echo "    # 1. 启用 OverlayFS 挂载 (关键! 否则无法写入配置)"
    echo "    sudo systemctl enable --now mimic-node-mount.service"
    echo ""
    echo "    # 2. 运行交互式初始化向导 (推荐)"
    echo "    sudo mimictl setup"
    echo ""
    echo "    # 或者手动初始化:"
    echo "    sudo mimictl gen-keys          # 生成 Reality 密钥对"
    echo "    sudo mimictl sni <域名>        # 设置 SNI (如: sudo mimictl sni www.microsoft.com)"
    echo "    sudo mimictl add my@email.com # 添加用户"
    echo "    sudo mimictl verify           # 验证配置"
    echo "    sudo mimictl apply            # 应用配置"
    echo ""
    echo "    # 3. 启动服务"
    echo "    sudo systemctl enable --now sing-box"
    echo "    sudo systemctl enable --now mimic-node.timer"
    echo "    sudo systemctl enable --now mimic-node.path"
    echo ""
    echo "  管理命令:"
    echo ""
    echo "    sudo mimictl list              # 列出用户"
    echo "    sudo mimictl add <email>       # 添加用户"
    echo "    sudo mimictl link <email>      # 生成链接"
    echo "    sudo mimictl diagnose --verbose # 诊断检查"
    echo ""
    echo "  Claude Code Skill (可选):"
    echo ""
    echo "    sudo mimictl skill install     # 安装 Claude Code 智能助手"
    echo ""
    echo "  文档: https://github.com/LIghtJUNction/Mimic-Node#readme"
    echo "================================================================================"
    echo ""
}

post_upgrade() {
    echo ""
    echo "================================================================================"
    echo "                    Mimic-Node 已升级"
    echo "================================================================================"
    echo ""
    echo "  确保 OverlayFS 挂载服务已启用:"
    echo "    sudo systemctl enable --now mimic-node-mount.service"
    echo ""
    echo "  如需查看配置变更:"
    echo "    sudo mimictl diff"
    echo ""
    echo "  如需完整诊断:"
    echo "    sudo mimictl diagnose --verbose"
    echo ""
    echo "  注意: 如果遇到问题，可尝试重置配置:"
    echo "    sudo mimictl reset"
    echo "    sudo mimictl apply"
    echo "================================================================================"
    echo ""
}

post_remove() {
    echo ""
    echo "================================================================================"
    echo "                    Mimic-Node 已卸载"
    echo "================================================================================"
    echo ""
    echo "  如需彻底清除配置 (包括密钥和用户数据):"
    echo "    sudo rm -rf /var/lib/mimic-node"
    echo ""
    echo "  如需清除 cargo 缓存:"
    echo "    rm -rf ~/.cache/cargo-target"
    echo ""
    echo "  感谢使用 Mimic-Node!"
    echo "================================================================================"
    echo ""
}
