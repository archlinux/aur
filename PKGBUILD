pkgname=kwin-canvas
pkgver=0.4.0
pkgrel=1
pkgdesc="Infinite canvas for KDE Plasma: windows on one pannable plane, activities as monitor frames, as a KWin QML effect plus a ground wallpaper, a panel applet and a terminal CLI"
arch=('any')
url="https://github.com/aaronsb/kwin-canvas"
license=('GPL-2.0-or-later')
depends=('kwin' 'plasma-workspace' 'qt6-tools')
makedepends=('make')
optdepends=('plasma-activities: one frame group per activity'
            'kwin-canvas-passthrough: windows stay live while the canvas is open')
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('975325cf834fe5cc87964b718b8532996e746ec38afb212a8b8b5fb722f7e4b3')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make DESTDIR="$pkgdir" install-system
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
    install -Dm644 LICENSES/GPL-2.0-or-later.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
