pkgname=arch-summit-strudel-2026
pkgver=2026
pkgrel=1
pkgdesc="Install a strudel wallpaper from the Arch Linux Summit 2026"
arch=('any')
url="https://pitastrudl.me/arch-summit-strudel-2026.jpg"
license=('MIT')
source=("${url}")
sha256sums=('10d9c9c1a9bb87f0de7cb47937f83492347dc5a05735f51afa09fd90b63826d9')

package() {
  install -vDm644 "arch-summit-strudel-2026.jpg" -t "$pkgdir/usr/share/backgrounds/${pkgname}/"
}
