# Generated by et.rs release automation. Do not edit by hand.
pkgname=et-rs-bin
pkgver=0.0.14
pkgrel=1
pkgdesc="Single telemetry-free EternalTerminal binary (Rust port)"
arch=('x86_64' 'aarch64')
url="https://github.com/minpeter/et.rs"
license=('Apache-2.0')
provides=('et-rs')
# Drop-in replacement for EternalTerminal: both install et/etserver/etterminal.
conflicts=('et-rs' 'eternal-terminal' 'eternal-terminal-git')
options=('!strip' '!debug')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/et@$pkgver/et-$pkgver-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/et@$pkgver/et-$pkgver-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('15dfbd5dcb69b10de5f38fa290b59cfe90cc6361b53cabf78aad0ecbd56775a0')
sha256sums_aarch64=('a174fd5c69a3420b04c5126910462d9606ee6171ad7834105f54790420f3be2b')

_triple() {
  case "$CARCH" in
    x86_64) echo x86_64-unknown-linux-gnu ;;
    aarch64) echo aarch64-unknown-linux-gnu ;;
  esac
}

package() {
  cd "et-$pkgver-$(_triple)"
  install -Dm755 et "$pkgdir/usr/bin/et"
  # Busybox-style role dispatch by argv[0].
  for role in etserver etterminal htm htmd; do
    ln -s et "$pkgdir/usr/bin/$role"
  done
}
