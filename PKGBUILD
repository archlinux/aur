pkgname='jaguar-bin'
pkgver=1.67.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('21afabf617b648b0b94ecd7e92f287f2882b6275a9e63e1e416fb3a0fe356476')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
