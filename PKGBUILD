pkgname='jaguar-bin'
pkgver=1.45.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('ff587644f1e7187ba920c207326fe5f504bd4f088cd66a833aa80d1c5f4917d0')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
