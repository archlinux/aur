package_onnxruntime-core-bin() {
    pkgdesc='Cross-platform inference engine for ONNX models: the C and C++ library with the CPU execution provider (prebuilt)'
    depends=(
        'glibc'
        'libgcc'
        'libstdc++'
    )
    optdepends=(
        'onnxruntime-provider-cuda: the CUDA execution provider'
        'onnxruntime-provider-tensorrt: the TensorRT execution provider'
        'onnxruntime-provider-openvino: the OpenVINO execution provider (Intel CPU, GPU and NPU)'
        'onnxruntime-provider-migraphx: the MIGraphX execution provider (AMD GPUs, untested)'
    )
    provides=(
        'onnxruntime-core=1.29.0-5'
        'onnxruntime=1.29.0'
        'libonnxruntime.so=1-64'
    )
    conflicts=(
        'onnxruntime-core'
        'onnxruntime'
        'onnxruntime-cpu'
        'onnxruntime-cuda'
        'onnxruntime-opt-cuda'
        'onnxruntime-rocm'
        'onnxruntime-opt-rocm'
        'onnxruntime-git'
        'onnxruntime-full'
    )
    replaces=(
        'onnxruntime-full'
    )

    bsdtar -xpf "$srcdir"/'onnxruntime-core-1.29.0-5-x86_64.pkg.tar.zst' -C "$pkgdir" usr
    if [[ -d $pkgdir/usr/share/licenses/onnxruntime-core ]]; then
        mv "$pkgdir/usr/share/licenses/onnxruntime-core" "$pkgdir/usr/share/licenses/onnxruntime-core-bin"
    fi
}

