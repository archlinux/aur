# Maintainer: Yakov Till <yakov.till@gmail.com>
pkgname=agx
pkgver=0.2.1
pkgrel=1
pkgdesc="Terminal step-through debugger for AI agent traces (Claude Code, Codex, Gemini, LangChain, Vercel AI SDK, OpenTelemetry GenAI)"
arch=('x86_64')
url="https://github.com/brevity1swos/agx"
# Upstream Cargo.toml declares "MIT OR Apache-2.0" but ships no license
# file. Under the disjunctive OR we distribute under Apache-2.0, a common
# license whose full text the `licenses` package provides — no file needed,
# and no MIT copyright notice to fabricate.
license=('Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo')
# The user-facing binary is `agx`, but upstream tags the TUI crate as
# `agx-tui-vX.Y.Z` (the `agx` crate name was squatted on crates.io).
_tag="agx-tui-v${pkgver}"
_srcdir="${pkgname}-${_tag}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${_tag}.tar.gz")
sha256sums=('3d21c2155afbe81c18af9d4d1a0ad367fe6838b8341368c58a42efaf04c1392a')

# latestver: track agx-tui release tags only (agx-core / agx-mcp tag
# independently in the same monorepo). Maintainer-only — gh is not a build dep.
latestver() {
    gh api --paginate repos/brevity1swos/agx/tags --jq '.[].name' |
        sed -nE 's/^agx-tui-v([0-9]+(\.[0-9]+)*)$/\1/p' | sort -V | tail -1
}

prepare() {
    cd "${_srcdir}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${_srcdir}"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
    # otel-proto: binary OTLP (.pb/.otlp) trace support (pure-Rust prost).
    # notifications: desktop notifications for --notify-on-* in --live mode
    # (pure-Rust zbus). embedding-search is intentionally omitted: it pulls
    # ONNX Runtime plus a ~90MB model downloaded at first use.
    cargo build --frozen --release --features otel-proto,notifications
}

package() {
    cd "${_srcdir}"
    install -Dm755 "target/release/agx" "${pkgdir}/usr/bin/agx"
    install -Dm755 "target/release/agx-mcp" "${pkgdir}/usr/bin/agx-mcp"

    # Shell completions, generated by the built binary.
    install -dm755 "${pkgdir}/usr/share/bash-completion/completions" \
        "${pkgdir}/usr/share/zsh/site-functions" \
        "${pkgdir}/usr/share/fish/vendor_completions.d"
    "target/release/agx" --completions bash > "${pkgdir}/usr/share/bash-completion/completions/agx"
    "target/release/agx" --completions zsh  > "${pkgdir}/usr/share/zsh/site-functions/_agx"
    "target/release/agx" --completions fish > "${pkgdir}/usr/share/fish/vendor_completions.d/agx.fish"

    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
