pkgname='jaguar-bin'
pkgver=1.44.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('c7ff966922d399d693d552fe5de5574bc713efb11fe33d0313fb3836ea0e3997')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
