pkgname='jaguar-bin'
pkgver=1.49.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('97b4652c106052220fde9744af94e04de5f8ce840d664bc3f92c62d69c119e0f')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
