sha256sums_aarch64=('c317a1ba0b2885ae49298defdaa0355610e37b7686d75a384e685d8aae38770d'
                    'e5fe97d2f4d45cd1b44812a00f3b0fa6e82591b651e499e4bbfd20ed52340b20'
