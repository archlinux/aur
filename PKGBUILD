# Maintainer: riey <creeper844@gmail.com>
# Maintainer: Moon Sungjoon <sumoon at seoulsaram dot org>

_pkgname=kime
pkgname=kime-bin
pkgver=3.2.0
pkgrel=1
pkgdesc="Korean IME"
url="https://github.com/Riey/kime"
conflicts=('kime')
provides=("kime=${pkgver}")
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'libxkbcommon' 'noto-fonts-cjk')
optdepends=('dbus: indicator support'
            'gtk3: GTK3 IM module support'
            'gtk4: GTK4 IM module support'
            'qt5-base: Qt5 IM module support'
            'qt6-base: Qt6 IM module support'
            'libglvnd: candidate window support')
makedepends=('meson' 'ninja' 'gtk3' 'gtk4' 'qt5-base' 'qt6-base')
source=(
    ${_pkgname}-${pkgver}.tar.gz::"${url}/archive/v${pkgver}.tar.gz"
    "${url}/releases/download/v${pkgver}/${_pkgname}-v${pkgver}_amd64_debian-trixie.deb"
    meson-system-engine-no-cargo.patch
)
noextract=(${_pkgname}-v${pkgver}_amd64_debian-trixie.deb)
sha256sums=('be0c10830761833eb5b7573beef5065c0e0b77e32c9330ad185ce086332de170'
            '6f4677bb0c5231cd6fd4067f0cb1f8b9678bdba688b9b295071c56c12b228b44'
            '472a8ac87c0ab992f4a97b05e2e546f15d2e2a1811ff66d97e3038c661defc35')

prepare() {
    bsdtar -xOf ${_pkgname}-v${pkgver}_amd64_debian-trixie.deb data.tar.xz | bsdtar -xf -
    cd "${_pkgname}-${pkgver}"
    # meson requires cargo at setup even though system_engine never runs it
    patch -Np1 -i ../meson-system-engine-no-cargo.patch
    # cbindgen output, generated by the cargo build that system_engine skips
    cp ../usr/include/kime_engine.h ../usr/include/kime_engine.hpp src/engine/capi
}

build() {
    cd "${_pkgname}-${pkgver}"
    export LDFLAGS="-L${srcdir}/usr/lib/x86_64-linux-gnu ${LDFLAGS}"
    arch-meson . build -Dsystem_engine=true
    meson compile -C build
}

package() {
    cd "${_pkgname}-${pkgver}"
    meson install -C build --destdir "${pkgdir}"
    install -Dm755 "${srcdir}"/usr/bin/* -t "${pkgdir}/usr/bin"
    install -Dm755 "${srcdir}/usr/lib/x86_64-linux-gnu/libkime_engine.so" \
        -t "${pkgdir}/usr/lib"
    install -Dm644 LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
