# Maintainer: Jiahao, Woo <woojiahao1234@gmail.com>
pkgname=gitmastery-bin
pkgver="v2.3.10"
pkgrel=1
pkgdesc="Git-Mastery CLI for practicing Git"
arch=('x86_64')
url='https://github.com/git-mastery/app'
license=('MIT')
depends=(
  'python'
)
changelog="gitmastery.changelog"
source=("gitmastery-2.3.10-linux-amd64::https://github.com/git-mastery/app/releases/download/v2.3.10/gitmastery-2.3.10-linux-amd64")
sha256sums=('SKIP')

package() {
  install -D -m 0755 "$srdir/gitmastery-2.3.10-linux-amd64" "$pkgdir/usr/bin/gitmastery"
  chmod 755 "$pkgdir/usr/bin/gitmastery"
}

