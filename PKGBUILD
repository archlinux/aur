pkgname='jaguar-bin'
pkgver=1.45.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('8f5fee1778b4d5275ed24c9f7ee5737d79bca09ff1be2723b43cccbb39727b0a')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
