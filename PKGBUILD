                    'SKIP')
sha256sums_armv7h=('b9c039743d402043c82d8b4fa127d1d543050c9bdcfc033346272433d35af11f'
                   'SKIP')
sha256sums_x86_64=('0c6114d5590efd499dd0de162624370580e5aad9600320cb5dd7e30fb35c4b75'
                   'SKIP')
