# Maintainer: Robin Trioux <robin@trioux.eu>
# PKGBUILD generated by pipman
# Python package author: Luxonis <support@luxonis.com>
# AUR package author : Robin Trioux <robin@trioux.eu>

pkgname=python-depthai
pkgver=2.34.0.0
pkgrel=1
pkgdesc="DepthAI Python Library"
arch=('x86_64')
url="https://github.com/luxonis/depthai-python"
license=(MIT)
makedepends=("python-build" "python-installer" "cmake" "patchelf")
# depthai.so directly links libpsl.so.5 (XLink) and libstdc++ (C++ bindings)
depends=("python" "libusb" "gcc-libs" "libpsl")
optdepends=("mypy" "python-pyqt5" "python-psutil" "python-numpy" "python-opencv")
# Symbols stay in the bindings module (!strip), so !debug avoids a pointless
# empty usr/src/debug tree leaking into the package
options+=(!strip !debug)

# Since upstream 2.31 Luxonis no longer publishes the matching depthai-core
# source release on GitHub, so we build from the PyPI sdist, which bundles
# depthai-core (with its shared submodules) at the version pinned by the
# depthai-python release. The sdist however omits the utilities/ scripts
# that setup.py requires to build the depthai_cli module, so those are
# fetched separately from the matching git tag.
source=(
"depthai-$pkgver.tar.gz::https://files.pythonhosted.org/packages/source/d/depthai/depthai-$pkgver.tar.gz"
"cam_test.py::https://raw.githubusercontent.com/luxonis/depthai-python/v$pkgver/utilities/cam_test.py"
"cam_test_gui.py::https://raw.githubusercontent.com/luxonis/depthai-python/v$pkgver/utilities/cam_test_gui.py"
"stress_test.py::https://raw.githubusercontent.com/luxonis/depthai-python/v$pkgver/utilities/stress_test.py"
"80-movidius.rules"
"pyproject.toml"
)

prepare() {
	cd "$srcdir"
	cp -f pyproject.toml "depthai-$pkgver"
	# The PyPI sdist omits the utilities that setup.py's depthai_cli build step requires
	install -d "depthai-$pkgver/utilities"
	install -m644 cam_test.py cam_test_gui.py stress_test.py "depthai-$pkgver/utilities/"
}


build() {
	# Prevent hunter C++ package manager from using users home
	#export HUNTER_ROOT=$srcdir/hunter
	#export HUNTER_BINARY_DIR=$srcdir/hunterdir
	#mkdir -p $HUNTER_ROOT
	#mkdir -p $HUNTER_BINARY_DIR
	export CMAKE_MINIMUM_REQUIRED_VERSION=3.5
	export CMAKE_POLICY_VERSION_MINIMUM=3.5
	# Emulate the upstream CI environment: forces a Release build, bakes a clean
	# version string (2.34.0.0, no ".dev0+" suffix) into the bindings and enables
	# the depthai-shared commit-hash integrity checks. Without it the build detects
	# the AUR git checkout it lives in and stamps its HEAD into depthai.__version__.
	export CI=true
	# Build strictly against system packages, never the builder's ~/.local
	export PYTHONNOUSERSITE=1
	ncpu=$(nproc --all)
	export MAKEFLAGS="-j$ncpu"
	cd $srcdir/depthai-$pkgver
	python -m build --wheel --no-isolation
}

package() {
	cd $srcdir/depthai-$pkgver
	python -m installer --destdir="$pkgdir" dist/*.whl
	# The hunter-built bindings carry a RUNPATH pointing into the builder's
	# ~/.hunter cache: strip it, all needed libraries live in system paths
	find "$pkgdir/usr/lib" -name 'depthai*.so' -exec patchelf --remove-rpath {} +
	# makepkg's !strip handling can leave an empty usr/src/debug tree behind
	rm -rf "$pkgdir/usr/src"
	# Vendor udev rule: installed in /usr/lib/udev/rules.d so that the
	# 35-systemd-udev-reload alpm hook automatically reloads rules on
	# install/upgrade (/etc/udev/rules.d is not covered by any hook).
	install -Dm644 "${srcdir}/80-movidius.rules" "$pkgdir/usr/lib/udev/rules.d/80-movidius.rules"
	install -Dm644 "${srcdir}/depthai-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

