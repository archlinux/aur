# Maintainer: Valentin Batz <valentin.batz+archlinux@posteo.de>

pkgname=mdns-browser
pkgver=2.5.1
pkgrel=1
pkgdesc="A cross platform mDNS browsing app written in Rust using tauri and svelte"
arch=('x86_64')
url="https://github.com/hrzlgnm/mdns-browser"
license=('MIT')
depends=('cairo' 'desktop-file-utils' 'gdk-pixbuf2' 'glib2' 'gtk3' 'hicolor-icon-theme' 'libsoup3' 'pango' 'webkit2gtk-4.1' 'openssl')
conflicts=('mdns-browser-bin')
makedepends=('cargo' 'cargo-auditable' 'git' 'file' 'appmenu-gtk-module' 'libappindicator-gtk3' 'librsvg' 'base-devel' 'curl' 'wget' 'rust' 'nodejs' 'pnpm')
options=('!strip' '!emptydirs')
source=("v2.5.1.tar.gz::https://github.com/hrzlgnm/$pkgname/archive/refs/tags/v2.5.1.tar.gz")
sha256sums=('92dd1696db0ca5dffb77d4cd6ecd19308b7eab134cf0e081c262ce5f138f5fd9')
_builddir="$pkgname-2.5.1"
prepare() {
    cd "$srcdir/$_builddir" || exit 1
    pnpm install --frozen-lockfile
    cargo fetch --locked --manifest-path src-tauri/Cargo.toml --target "$(rustc -vV | sed -n 's/host: //p')"
}
build() {
    cd "$srcdir/$_builddir" || exit 1
    # unfortunately LTOFLAGS -flto=auto set by /etc/makepkg.conf break linking as those are added to CFLAGS automatically
    # building will bail out with something like: undefined reference to 'ring_core_0_17_8_OPENSSL_ia32cap_P' when -flto=auto is set
    export CFLAGS="${CFLAGS//-flto=auto//}"
    # route the cargo spawned by 'pnpm tauri' through cargo-auditable
    export PATH="$PWD/scripts:$PATH"
    export CARGO_NET_OFFLINE=true
    # build the normal binary without bundling first
    pnpm tauri build --no-bundle
    # bundle the already-built binary as deb to get required icons and
    # desktop file for packaging, without building a second time
    pnpm tauri bundle -b deb --no-sign
}
check() {
    cd "$srcdir/$_builddir" || exit 1
    cargo test --locked --frozen --manifest-path src-tauri/Cargo.toml --package=models --package=mdns-browser
}
package() {
    install -Dm755 "${srcdir}/${_builddir}/src-tauri/target/release/mdns-browser" "$pkgdir"/usr/bin/mdns-browser
    install -Dm644 "${srcdir}/${_builddir}/docs/mdns-browser.1" "$pkgdir"/usr/share/man/man1/mdns-browser.1
    install -Dm644 "${srcdir}/${_builddir}/CHANGELOG.md" "$pkgdir"/usr/share/doc/mdns-browser/changelog
    install -Dm644 "${srcdir}/${_builddir}/LICENSE" "$pkgdir"/usr/share/licenses/mdns-browser/LICENSE
    # use the intermediate artifacts generated by the bundler for creating the .deb
    cd "${srcdir}/${_builddir}/src-tauri/target/release/bundle/deb/${pkgname}_${pkgver}_amd64/data" || exit 1
    install -Dm644 usr/share/applications/mdns-browser.desktop "$pkgdir"/usr/share/applications/mdns-browser.desktop
    install -Dm644 usr/share/icons/hicolor/128x128/apps/mdns-browser.png "$pkgdir"/usr/share/icons/hicolor/128x128/apps/mdns-browser.png
    install -Dm644 usr/share/icons/hicolor/256x256@2/apps/mdns-browser.png "$pkgdir"/usr/share/icons/hicolor/256x256@2/apps/mdns-browser.png
    install -Dm644 usr/share/icons/hicolor/32x32/apps/mdns-browser.png "$pkgdir"/usr/share/icons/hicolor/32x32/apps/mdns-browser.png
}
