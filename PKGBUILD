sha256sums_aarch64=('f668b798ce685da6772d6fdcca2c58e3bd4fc96d4852cc42bf0ecd23de84d339'
                    'f32ff5d788b3bef93b9e8c6d12f7d75a8468578f5bf7a8087d0b13a77e835caf'
