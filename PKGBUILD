# Maintainer: minpeter <minpeter@users.noreply.github.com>
# Generated by openaside release automation. Do not edit by hand.
pkgname=openaside-bin
pkgver=0.0.13
pkgrel=1
pkgdesc="OpenAside - AI-powered browser built on patched Chromium"
arch=('x86_64')
url="https://github.com/minpeter/openaside"
license=('UNLICENSED')
provides=('openaside')
conflicts=('openaside')
options=('!strip' '!debug')
# depends: Arch packages owning every DT_NEEDED soname of the shipped ELF files
# (chrome, chrome_crashpad_handler, chrome_sandbox, bundled ANGLE/Vulkan .so,
# bun, aside-daemon) that the tarball does not ship itself, plus gtk3, which
# Chromium dlopen()s at startup as its Linux UI toolkit (file dialogs, theming).
# The Qt shims (libqt5_shim.so/libqt6_shim.so) are dlopen()ed only for Qt UI
# integration, so qt5-base/qt6-base stay optional. The compiled daemon runs
# agent shell commands through bwrap only when ASIDE_ENABLE_BWRAP_SANDBOX=1
# (plain bash otherwise), so bubblewrap is optional too.
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'glibc' 'gtk3'
         'libcups' 'libgcc' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext'
         'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs')
optdepends=('xorg-server-xvfb: run the browser when no X display is available'
            'bubblewrap: sandbox agent shell commands when ASIDE_ENABLE_BWRAP_SANDBOX=1'
            'libpulse: PulseAudio/PipeWire audio output (ALSA is used otherwise)'
            'pciutils: GPU detection for hardware acceleration'
            'qt5-base: Qt 5 UI integration'
            'qt6-base: Qt 6 UI integration')
source=("$pkgname-$pkgver.tar.gz::https://github.com/minpeter/openaside-releases/releases/download/openaside@$pkgver/openaside-$pkgver-linux-x64.tar.gz")
sha256sums=('b45a2bcb86aedc11e11282a9b58eaf135490e1d817cb2cbc22484e1ba280ceeb')

package() {
  cd "openaside-$pkgver"
  # install.sh owns DESTDIR staging, desktop-entry templating
  # (@OPENASIDE_BIN@), native-messaging manifest rendering, and permission
  # hardening; packaging must not re-implement them against files that only
  # exist post-install (e.g. the generated openaside.desktop).
  DESTDIR="$pkgdir" ./install.sh --prefix /usr/local
  # Match the modes/owners Arch gives shared system directories so pacman does
  # not warn that directory permissions differ: /etc/sudoers.d (filesystem)
  # and /etc/polkit-1/rules.d (polkit; gid 102 is Arch's fixed polkitd group,
  # which keeps our rule readable by polkitd whichever package lands first).
  chmod 0750 "$pkgdir/etc/sudoers.d"
  chown root:102 "$pkgdir/etc/polkit-1/rules.d"
  chmod 0750 "$pkgdir/etc/polkit-1/rules.d"
}
