package() {
  local dest="$pkgdir$_skinsdir"
  install -dm755 "$dest"
  bsdtar -xf "$srcdir/aimp-skin-black-box-537.archive" -C "$dest"
  find "$dest" -mindepth 2 -type f -exec mv -t "$dest" {} +
  find "$dest" -mindepth 1 -type d -empty -delete
