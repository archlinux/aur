package() {
    install -d "$pkgdir/usr/share/fonts/OTF"
    install -m644 "$srcdir/"*.otf "$pkgdir/usr/share/fonts/OTF/"

    install -d "$pkgdir/usr/share/licenses/$pkgname"
    # License text embedded in the font per OFL; provide a plain text copy
    cat > "$pkgdir/usr/share/licenses/$pkgname/OFL.txt" << 'EOF'
Copyright 2020, 2024 Braille Institute of America, Inc.
This Font Software is licensed under the SIL Open Font License, Version 1.1.
http://scripts.sil.org/OFL
EOF
}
