# Generated by .github/workflows/aur.yml from packaging/aur/prostir-bin/PKGBUILD.in.
pkgname=prostir-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Extra KDE Plasma 6 and Hyprland monitors in a Meta Quest 3 or 3S headset (PC part)"
arch=('x86_64')
url="https://prostir.ishawyha.dev"
license=('GPL-3.0-or-later')
# gst-plugin-va: the VA-API encoders (vah264enc, vah265enc, vapostproc).
# gst-plugins-bad-libs: h264parse and h265parse. gst-plugins-good: pulsesrc.
# libpulse: pactl, pacat. pipewire-audio: pw-loopback. mesa: libgbm and the AMD VA driver.
depends=('glibc' 'gcc-libs' 'gstreamer' 'gst-plugins-base-libs' 'gst-plugins-good'
         'gst-plugins-bad-libs' 'gst-plugin-va' 'gst-plugin-pipewire' 'pipewire'
         'pipewire-audio' 'pulse-native-provider' 'libpulse' 'mesa' 'curl')
optdepends=('gst-plugins-ugly: encoding on the CPU with x264 (NVIDIA, or no VA-API encoder)'
            'intel-media-driver: hardware encoding on Intel graphics'
            'libkscreen: arranging the monitors on KDE Plasma (kscreen-doctor)'
            'qt6-tools: matching wallpapers on every monitor on KDE Plasma (qdbus6)'
            'kdialog: the pairing dialog (or zenity, fuzzel, wofi, rofi)'
            'zenity: the pairing dialog (or kdialog, fuzzel, wofi, rofi)'
            'libnotify: notifications'
            'grim: screenshots on Hyprland'
            'spectacle: whole-desktop screenshots on KDE when a monitor cannot be captured'
            'android-tools: connecting the headset over USB (developer mode)')
provides=('prostir')
conflicts=('prostir')
source=("https://github.com/OlexiyOdarchuk/prostir/releases/download/v${pkgver}/prostir-${pkgver}-x86_64-linux.tar.gz")
sha256sums=('5b94e81eb67394ec3910d656a24cf3359f262e6a7152a0b9efb1e58c65354976')

package() {
  cd "prostir-${pkgver}-x86_64-linux"
  install -Dm755 prostir "${pkgdir}/usr/bin/prostir"
  install -Dm644 packaging/prostir.desktop "${pkgdir}/usr/share/applications/prostir.desktop"
  install -Dm644 packaging/prostir.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/prostir.svg"
  install -Dm644 LICENSE-EXCEPTION.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-EXCEPTION.md"
  install -Dm644 THIRD-PARTY-LICENSES.txt "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-LICENSES.txt"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
