pkgname='jaguar-bin'
pkgver=1.48.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('0a94787855cfc0bbb390d5248cb36679e07206e799996a387a0d35a8d41329cc')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
