pkgname=hacktyper
pkgver=0.2.7
pkgrel=1
pkgdesc="A terminal-based typing simulator that mimics hacking scenes from movies."
url="https://github.com/HsiangNianian/hacktyper"
license=("MIT")
arch=("x86_64")
depends=()
makedepends=("cargo")
provides=("hacktyper")
conflicts=("hacktyper")
source=("$pkgname-$pkgver.tar.gz::https://github.com/HsiangNianian/hacktyper/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release
}
package() {
    install -Dm755 "target/release/hacktyper" "$pkgdir/usr/bin/hacktyper"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
