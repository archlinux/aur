b2sums_x86_64=('5ec887c0eea10a798251a0b49d11dd8e2aa9ee869152adaf0d97953bab81e2df7ffea1128891b8f9e8c525437f1e72a451ca6d25137742b4077d745d49395e78')
b2sums_aarch64=('798f3759d55f23014084ba38d282a5ac61fd82a570ee382e16020cfbd843b49ffee23acd938e510e391d5259d1188974a3a3fcdacfdbe711ae092f429321d71c')

