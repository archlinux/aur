# Generated by https://github.com/cjber/kiln/blob/main/scripts/render-aur.ts; edits are overwritten on the next release.
pkgname=kiln-agents
pkgver=0.4.0
pkgrel=1
pkgdesc="Vim-style overview of every Claude, Codex and Pi session on the machine"
arch=('x86_64' 'aarch64')
url="https://github.com/cjber/kiln"
license=('MIT')
depends=('bun' 'tmux' 'fzf')
optdepends=('libnotify: desktop notifications when agent turns finish' 'zoxide: rank the directories offered for new sessions' 'kitty: jump to agents running in other kitty windows' 'claude-code: Claude sessions' 'openai-codex: Codex sessions')
provides=('kiln')
# The AUR's `kiln` is an unrelated static site generator that also installs /usr/bin/kiln.
conflicts=('kiln' 'kiln-agents-bin')
options=('!strip')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/cjber/kiln/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('9bbff252c24b034008bfd05b4a25c5b7f17d0a56435ca2cf3aa74c6c9fdb9bbf')

build() {
  cd "kiln-${pkgver}"
  bun install --frozen-lockfile --production
}

package() {
  cd "kiln-${pkgver}"
  install -d "${pkgdir}/usr/lib/kiln" "${pkgdir}/usr/bin"
  cp -a bin src extensions bundled-skills node_modules package.json tmux.conf "${pkgdir}/usr/lib/kiln/"
  ln -s /usr/lib/kiln/bin/kiln "${pkgdir}/usr/bin/kiln"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
