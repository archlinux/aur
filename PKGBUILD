build() {
	# build.sh expects <root>/{build.sh,tools/} plus the four upstream archives.
	cd "$srcdir"
	APP_VER="$pkgver" \
		INSTALLER="$srcdir/$_installer" \
		ELECTRON_ZIP_PATH="$srcdir/$_electron" \
		USB_TGZ="$srcdir/$_usb" \
		SERIALPORT_TGZ="$srcdir/$_serialport" \
		bash "$srcdir/build.sh"
}

package() {
	install -d "$pkgdir/usr/lib"
	cp -a "$srcdir/dist/xtool-studio" "$pkgdir/usr/lib/$pkgname"

	# Chromium's setuid sandbox helper; the launcher only passes --no-sandbox
	# when this is not setuid root.
	chmod 4755 "$pkgdir/usr/lib/$pkgname/chrome-sandbox"
	chown root:root "$pkgdir/usr/lib/$pkgname/chrome-sandbox"

	install -d "$pkgdir/usr/bin"
	ln -s "/usr/lib/$pkgname/xtool-studio-launcher" "$pkgdir/usr/bin/$pkgname"

	install -Dm644 "$srcdir/xtool-studio.desktop" \
		"$pkgdir/usr/share/applications/$pkgname.desktop"
	install -Dm644 "$srcdir/dist/xtool-studio/xtool-studio.png" \
		"$pkgdir/usr/share/pixmaps/$pkgname.png"

	install -d "$pkgdir/usr/share/licenses/$pkgname"
	install -m644 "$srcdir/dist/xtool-studio/LICENSE" \
		"$srcdir/dist/xtool-studio/LICENSES.chromium.html" \
		"$pkgdir/usr/share/licenses/$pkgname/"
}
