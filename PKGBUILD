pkgname='jaguar-bin'
pkgver=1.61.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('76a30389daadf938a1d43010d46a02d84b4f4a2ce6ce60d4752d05e433cf7e43')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
