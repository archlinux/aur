pkgname='jaguar-bin'
pkgver=1.39.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('9483f08374251d1ece6b11c7a7ab755bfecff992ead22beaeda795512a69c4dd')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
