  "${pkgbase}-elasticsearch: elasticsearch backend (python-aiohttp python-elasticsearch)"
  "${pkgbase}-filetree: filetree backend (python-aiofile python-anyio)"
  "${pkgbase}-firestore: firestore backend (python-google-auth python-google-cloud-firestore)"
  "${pkgbase}-keyring: keyring backend (python-keyring)"
  "${pkgbase}-keyring-linux: keyring-linux backend (python-dbus python-keyring)"
