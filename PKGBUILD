pkgname=repoforge-git
pkgver=0.1.0
pkgrel=1
pkgdesc="A C++ TUI wizard for building .deb .rpm and aur packages in clicks"
arch=('x86_64')
url="https://github.com/Vniverse77/byte-knight"
license=('GPL')
depends=(gcc-libs glibs)
makedepends=('gcc')
source=("https://github.com/Vniverse77/repoForge/archive/refs/tags/0.1.0.tar.gz")
sha256sums=('4e99ae4263c00aa0a78c182b1a98b852dcebc6623eeb522a19c1305460a6751e')

build() {
    cd "$srcdir"
    g++ -std=c++17 -O2 -Wl,-z,relro,-z,now -o repoforge repoForge.cpp -lpthread
}

package() {
    cd "$srcdir"
    install -Dm755 repoforge "$pkgdir/usr/bin/repoforge"
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
