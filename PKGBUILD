# Maintainer: fulgidus <fulgidus at users dot noreply dot github dot com>
# Generated by whoseware's release job: pkgver and sha256sums are filled in there.
pkgname=whoseware
pkgver=0.1.1
pkgrel=1
pkgdesc="Who owns, leads or funds the software you run? Checks packages against the fashware lists"
arch=(x86_64)
url="https://github.com/fulgidus/whoseware"
license=(X11)
makedepends=(zig)
source=("$pkgname-$pkgver-src.tar.gz::$url/releases/download/v$pkgver/whoseware-$pkgver-src.tar.gz")
sha256sums=('bfb54f8e6e1df836890d86b4ace72cc805a4a70319f968c6ec66ce3b8e766bab')

build() {
  cd "$pkgname-$pkgver"
  ./build.sh   # the source tarball ships the release's graph: no network here
}

check() {
  cd "$pkgname-$pkgver"
  ./zig-out/whoseware --fail-on-hit helix >/dev/null
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 zig-out/whoseware "$pkgdir/usr/bin/whoseware"
  install -Dm644 hooks/whoseware.hook "$pkgdir/usr/share/libalpm/hooks/whoseware.hook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
