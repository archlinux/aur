pkgname=ytmgo
pkgver=1.1.1
pkgrel=1
pkgdesc="A terminal-based YouTube Music client — search, download, queue, and play music from the keyboard"
arch=('x86_64' 'aarch64')
url="https://github.com/anas1412/ytmgo"
license=('MIT')
depends=('mpv' 'yt-dlp' 'ffmpeg' 'cava')
makedepends=('go>=1.22')
source=("$url/archive/v$pkgver.tar.gz")
sha256sums=('f60ac89644e15398845438bd937dc34df08dea2cf4004e43769dd6f2dbf64197')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w -X ytmgo/internal/version.Version=v$pkgver" \
    -o ytmgo .
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./ytmgo --version 2>&1 | grep -q "v$pkgver"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 ytmgo "$pkgdir/usr/bin/ytmgo"
  install -Dm644 ytmgo-icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/ytmgo.png"
  # MIT carries its own copyright line, so Arch wants the text shipped
  # rather than pointed at /usr/share/licenses/common.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/ytmgo.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=ytmgo
Comment=YouTube Music from the Terminal
Exec=ytmgo
Icon=ytmgo
Terminal=true
Categories=AudioVideo;Audio;Music;Player;
Keywords=music;youtube;player;terminal;tui;audio;
StartupNotify=false
EOF
}
