# Maintainer: Ibnu Afdel <ibnu@example.com>
pkgname=dbwiz-bin
pkgver=1.1.0
pkgrel=1
pkgdesc="Find, browse, administer, and query your local SQL databases (Docker, SQLite) from a friendly TUI"
arch=('x86_64' 'aarch64')
url="https://github.com/Ibnu-Afdel/dbWiz"
license=('MIT')
provides=('dbwiz')
conflicts=('dbwiz')
optdepends=('docker: detect and manage database containers'
            'openssh: reach remote databases and Docker hosts over SSH')
install=dbwiz-bin.install
options=('!strip' '!debug')
_base="https://github.com/Ibnu-Afdel/dbWiz/releases/download/v${pkgver}"
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/Ibnu-Afdel/dbWiz/v${pkgver}/LICENSE")
source_x86_64=("dbwiz-${pkgver}-x86_64::${_base}/dbwiz-linux-amd64")
source_aarch64=("dbwiz-${pkgver}-aarch64::${_base}/dbwiz-linux-arm64")
sha256sums=('b9c8d9918e1315c637cd7907482230f824fd522a622e7aa3ebf99cc590aee9e5')
sha256sums_x86_64=('b39e7e6e78d7ae8ca6170b690460704e9ba9820a8fbd75ad4b1225143548d076')
sha256sums_aarch64=('73bec33be21c65ab26d7e2f223a3c208b7c42544b6eeebe947191ada368c8641')

package() {
  local bin="dbwiz-${pkgver}-${CARCH}"
  install -Dm755 "$bin" "$pkgdir/usr/bin/dbwiz"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Shell completions, generated by the binary itself. Skipped when building
  # for a different architecture than the host (the binary can't run).
  if [[ $CARCH == "$(uname -m)" ]]; then
    chmod +x "$bin"
    install -dm755 "$pkgdir/usr/share/bash-completion/completions" \
                   "$pkgdir/usr/share/zsh/site-functions" \
                   "$pkgdir/usr/share/fish/vendor_completions.d"
    "./$bin" completion bash > "$pkgdir/usr/share/bash-completion/completions/dbwiz"
    "./$bin" completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_dbwiz"
    "./$bin" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/dbwiz.fish"
  fi
}
