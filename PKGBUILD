pkgname=kwin-canvas
pkgver=0.3.1
pkgrel=1
pkgdesc="Infinite canvas for KDE Plasma: windows on one pannable plane, activities as monitor frames, as a KWin QML effect plus a ground wallpaper"
arch=('any')
url="https://github.com/aaronsb/kwin-canvas"
license=('GPL-2.0-or-later')
depends=('kwin' 'plasma-workspace')
makedepends=('make')
optdepends=('plasma-activities: one frame group per activity'
            'qt6-tools: qdbus6 for make enable and make status')
install=$pkgname.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('99a7108684d6e4f1846522ebcb187d67f6b0e9fec0099d307ffc0a96fb5561e6')

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make DESTDIR="$pkgdir" install-system
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
    install -Dm644 LICENSES/GPL-2.0-or-later.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
