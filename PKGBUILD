# Generated by https://github.com/cjber/keeper/blob/main/scripts/render-aur.ts; edits are overwritten on the next release.
pkgname=keeper
pkgver=0.4.2
pkgrel=1
pkgdesc="Agent-first cleanup for Arch: stale worktrees, AUR clones, caches and agent leftovers"
arch=('x86_64' 'aarch64')
url="https://github.com/cjber/keeper"
license=('MIT')
depends=('bun' 'git' 'pacman-contrib')
optdepends=('github-cli: prove a worktree finished from its merged pull request' 'expac: size orphaned packages' 'libnotify: desktop notifications for low disk and pending approvals' 'uv: prune the uv cache')
provides=('keeper')
conflicts=('keeper-bin')
options=('!strip')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/cjber/keeper/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('bda5ea806c1bd942b2b021251e93f7e13ce7153b124d1e5ca3855b39807a5c00')

build() {
  cd "keeper-${pkgver}"
  bun install --frozen-lockfile --production
}

package() {
  cd "keeper-${pkgver}"
  install -d "${pkgdir}/usr/lib/keeper" "${pkgdir}/usr/bin"
  cp -a src skills node_modules package.json "${pkgdir}/usr/lib/keeper/"
  ln -s /usr/lib/keeper/src/index.tsx "${pkgdir}/usr/bin/keeper"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
