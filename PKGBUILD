pkgname='jaguar-bin'
pkgver=1.34.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('6dd3c3dad5f98b1c1c8b2b7dd02bb3f5cee59a553bf15e3c3375b67a67fce47d')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
