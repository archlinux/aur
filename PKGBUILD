pkgbase=python-py-key-value-aio
_name=${pkgbase#python-}
_name=${_name//-/_}
pkgver=0.4.5
pkgrel=1
pkgdesc="Async key-value store with pluggable backends"
arch=('any')
url="https://github.com/strawgate/py-key-value"
license=('Apache-2.0')

# The three blocks below are generated by ./gen_meta.py from the upstream
# [project.optional-dependencies] of pyproject.toml. Do not edit them by hand;
# run "python gen_meta.py" instead (lilac does this automatically).
