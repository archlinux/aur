pkgname=deskpilot
pkgver=0.8.0
pkgrel=1
pkgdesc="Desktop control for agents on Hyprland: click and type in a window while the user keeps working"
arch=('any')
url="https://github.com/agent-labs-dev/deskpilot"
license=('MIT')
depends=('python' 'python-evdev' 'python-jeepney' 'python-pillow' 'python-mcp' 'python-pydantic' 'hyprland' 'grim' 'gcc' 'make' 'pkgconf' 'pixman' 'libdrm' 'libxcb' 'libxkbcommon' 'cairo')
makedepends=('python-build' 'python-installer' 'python-hatchling')
optdepends=('wl-clipboard: read and set the clipboard' 'ffmpeg: record a window or a recipe to an mp4' 'at-spi2-core: target elements through the accessibility tree')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/agent-labs-dev/deskpilot/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('c43ddde621516df0f362604bb58278cf403b101ff5c2d25e4b2825fb8e4339f6')

build() {
  cd "${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  cp -a docs skills "${pkgdir}/usr/share/doc/${pkgname}/"
}
