# Maintainer: petrouil <petrouil@archlinux>
# Upstream:   https://github.com/pewdiepie-archdaemon/odysseus

# Build strategy
# --------------
# We track upstream main (git+ branch=main) and ship a prebuilt Python 3.12
# venv under /usr/lib/odysseus-ai/venv/. The venv is built with
#     uv venv --relocatable --python 3.12 --link-mode=copy
# and synced against a committed requirements.lock (generated by
# `uv pip compile --upgrade --python-version 3.12 requirements.txt -o requirements.lock`).
# NOTE: --upgrade is required — without it uv keeps the existing pins and the
# lock silently drifts from upstream. This gives us
# deterministic, byte-identical rebuilds without an AUR-side wheel cache.
#
# JS deps: upstream's only JS dependency is the devDep
# @antithesishq/bombadil (a docs-build CLI), which we don't ship. There are
# no runtime node_modules, so the package ships without them.
#
# The venv's interpreter is built with `--link-mode=copy` so bin/python3.12
# is a real ELF copy, not a symlink to $HOME/.local/share/uv/python/...
# This is verified post-package() in the build() pre-flight.

pkgname=odysseus-ai-git
_pkgname=odysseus
pkgver=r1894.cf4e240ad
pkgrel=1
pkgdesc="Self-hosted AI workspace with prebuilt Python 3.12 venv, tracking upstream main"
arch=('x86_64')
url='https://github.com/pewdiepie-archdaemon/odysseus'
license=('MIT')
depends=(
  'python'           # used by 4 in-process stdio MCP servers via sys.executable
  'nodejs'           # provides npx for @playwright/mcp browser MCP; also yt-dlp --js-runtimes node
  'git'              # Cookbook clones (llama.cpp etc.); shell tool uses it
  'tmux'             # Cookbook background sessions; agent shell tool
  'openssh'          # Cookbook --host, remote hardware probes
  'curl'             # health check in ExecStartPost=, plus Cookbook HF polling
)
makedepends=(
  'git'              # source=() is git+...
  'uv'               # builds the relocatable Python 3.12 venv (Arch [extra])
)
optdepends=(
  'nvidia-utils: NVIDIA GPU detection in Cookbook'
  'rocminfo: AMD GPU detection in Cookbook'
  'yt-dlp: YouTube comment fetching'
  'docker: optional, lets the agent run commands inside containers'
  'python-faster-whisper: local speech-to-text backend'
  'python-kokoro: local GPU TTS backend'
  'python-pymupdf: PDF RAG indexing (AGPL-3.0, opt in knowingly)'
  'python-duckduckgo-search: alternative web search backend'
  'python-markitdown: docx/pptx/xlsx parsing for RAG'
)
provides=('odysseus-ai')
conflicts=('odysseus-ai')
backup=('etc/odysseus-ai/odysseus-ai.env')
install=odysseus-ai-git.install
options=('!strip' '!debug')
source=(
  "git+https://github.com/pewdiepie-archdaemon/${_pkgname}.git#branch=main"
  "requirements.lock"
  "package-lock.json"
  "odysseus-ai.service"
  "odysseus-ai.sysusers"
  "odysseus-ai.tmpfiles"
  "odysseus-ai.logrotate"
  "odysseus-ai-git.svg"
  "setup.py.patch"
  "agent_loop.py.patch"
  "odysseus-ai"
  "odysseus-ai-install-extra"
  "odysseus-ai-symlinks.sh"
  "odysseus-ai.env.dist"
  "README.md"
  "LICENSE"
)
