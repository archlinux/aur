pkgname='jaguar-bin'
pkgver=1.35.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('99ec5688046466d391e8f27158288eaa28b25e6fc31df483aa2544d030df09ad')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
