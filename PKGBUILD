# Embedded upstream minisign public key (primary release-signing key,
# keyID 94562DC3EC2D6EB4 — mirrors docs/release-public-key.txt and the
# daemon's self-update roster). prepare() verifies SHA256SUMS against
# its detached signature with this key, so the signature is a
# load-bearing build-time gate (provenance) rather than advisory. The
# per-arch sha256sums arrays above still gate per-binary integrity;
# this gate authenticates the manifest those sums live in.
_minisign_pubkey='RWS0bi3swy1WlKoCoCnTQtCYAvt01ue3mMxhVy/Q6qxmVOdPpt8eIyQ1'

prepare() {
    # Authenticate the signed checksum manifest before trusting it.
    # minisign -V also verifies the global signature over the trusted
    # comment, and exits non-zero on any failure → makepkg aborts.
    minisign -V -P "${_minisign_pubkey}" \
        -m "${srcdir}/SHA256SUMS" \
        -x "${srcdir}/SHA256SUMS.minisig"

    case "$CARCH" in
        x86_64)  _arch=linux-amd64 ;;
        aarch64) _arch=linux-arm64 ;;
        armv7h)  _arch=linux-armv7 ;;
    esac
    # Match the upstream binary name (no -linux-* suffix once installed).
    cp "${srcdir}/mtroamd-${_arch}" "${srcdir}/mtroamd"
    cp "${srcdir}/mtroam-${_arch}"     "${srcdir}/mtroam"
}

package() {
    install -Dm755 "${srcdir}/mtroamd" "${pkgdir}/usr/bin/mtroamd"
    install -Dm755 "${srcdir}/mtroam"     "${pkgdir}/usr/bin/mtroam"

    # systemd-user unit, generated from the freshly-installed binary
    # so the file always matches `mtroamd unit print`. KillMode=
    # process is load-bearing for the v0.6+ sidecar architecture.
    chmod +x "${srcdir}/mtroamd"
    "${srcdir}/mtroamd" unit print --bin=/usr/bin/mtroamd > "${srcdir}/mtroamd.service"
    install -Dm644 "${srcdir}/mtroamd.service" "${pkgdir}/usr/lib/systemd/user/mtroamd.service"

    install -Dm644 "${srcdir}/mtroamd.8" "${pkgdir}/usr/share/man/man8/mtroamd.8"
    install -Dm644 "${srcdir}/mtroam.1"     "${pkgdir}/usr/share/man/man1/mtroam.1"

    install -Dm644 "${srcdir}/mtroamd.bash" "${pkgdir}/usr/share/bash-completion/completions/mtroamd"
    install -Dm644 "${srcdir}/mtroam.bash"     "${pkgdir}/usr/share/bash-completion/completions/mtroam"
    install -Dm644 "${srcdir}/mtroamd.zsh"  "${pkgdir}/usr/share/zsh/site-functions/_mtroamd"
    install -Dm644 "${srcdir}/mtroam.zsh"      "${pkgdir}/usr/share/zsh/site-functions/_mtroam"
    install -Dm644 "${srcdir}/mtroamd.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/mtroamd.fish"
    install -Dm644 "${srcdir}/mtroam.fish"     "${pkgdir}/usr/share/fish/vendor_completions.d/mtroam.fish"
}
