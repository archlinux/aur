# IBM Bob IDE is proprietary software owned by IBM
# See LICENSE file for complete terms and disclaimers
#
# NOTE: This AUR package was generated by Bob (IBM Bob IDE)
#
# INSTALLATION INSTRUCTIONS:
# 1. Download the IBM Bob IDE RPM from the official IBM website
# 2. Place the RPM file (IBM-Bob-linux-x64-1.109.5+bob1.0.1.rpm) in the same directory as this PKGBUILD
# 3. Run: makepkg -si
#
# The RPM file is not included in this package and must be obtained from IBM

pkgname=ibm-bobide
_pkgname=IBM-Bob-linux-x64
pkgver=1.109.5+bob1.0.1
pkgrel=1
pkgdesc="IBM Bob Shell - A highly skilled software engineering assistant (Unofficial AUR Package)"
arch=('x86_64')
url="https://ibm.com"
license=('custom:IBM-Proprietary')
depends=(
  'gtk3'
  'libxss'
  'nss'
)
makedepends=('rpmextract')
provides=('ibm-bob')
conflicts=('ibm-bob' 'ibm-bob-bin')
install=ibm-bobide.install
source=()
sha256sums=(
  'SKIP'
  'SKIP'
)

prepare() {
    # Check if RPM file exists in the same directory as PKGBUILD
    if [ ! -f "${startdir}/${_pkgname}-${pkgver}.rpm" ]; then
        echo ""
        echo "ERROR: RPM file not found!"
        echo ""
        echo "Please download the IBM Bob IDE RPM from IBM's website:"
        echo "  File: ${_pkgname}-${pkgver}.rpm"
        echo "  Place it in: ${startdir}/"
        echo ""
        echo "Visit https://bob.ibm.com to download the RPM."
        echo ""
        return 1
    fi
    
    # Copy RPM to srcdir for extraction
    cp "${startdir}/${_pkgname}-${pkgver}.rpm" "$srcdir/"
}

package() {
    cd "$srcdir"

    rpmextract.sh "${_pkgname}-${pkgver}.rpm"

    install -d "$pkgdir"
    cp -a --no-preserve=ownership usr "$pkgdir/"

    # Install LICENSE file
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    
    # Install README documentation
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"

    rm -f "$pkgdir/usr/bin/bobide"
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/bobide" <<'EOF'
#!/usr/bin/env sh
set -e

VSCODE_PATH="/usr/share/bobide"

if [ -n "$VSCODE_IPC_HOOK_CLI" ]; then
    REMOTE_CLI="$(command -v bobide | grep /remote-cli/ || true)"
    if [ -n "$REMOTE_CLI" ]; then
        exec "$REMOTE_CLI" "$@"
    fi
fi

if [ "$(id -u)" = "0" ]; then
    for i in "$@"; do
        case "$i" in
            --user-data-dir|--user-data-dir=*|--file-write|tunnel|serve-web)
                CAN_LAUNCH_AS_ROOT=1
                ;;
        esac
    done
    if [ -z "$CAN_LAUNCH_AS_ROOT" ]; then
        echo "You are trying to start IBM Bob as a super user which isn't recommended. If this was intended, please add the argument \`--no-sandbox\` and specify an alternate user data directory using the \`--user-data-dir\` argument." 1>&2
        exit 1
    fi
fi

ELECTRON="$VSCODE_PATH/bobide"
CLI="$VSCODE_PATH/resources/app/out/cli.js"
exec env ELECTRON_RUN_AS_NODE=1 "$ELECTRON" "$CLI" "$@"
EOF

    chmod 755 "$pkgdir/usr/share/bobide/bobide"
    chmod 755 "$pkgdir/usr/share/bobide/bin/bobide"
    chmod 755 "$pkgdir/usr/share/bobide/bin/bobide-tunnel"
    chmod 4755 "$pkgdir/usr/share/bobide/chrome-sandbox"

    find "$pkgdir/usr/share/applications" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr/share/appdata" -type f -exec chmod 644 {} \;
    find "$pkgdir/usr/share/bash-completion" -type f -exec chmod 644 {} \;
}