pkgbase=ptui
pkgname=ptui-bin
pkgver=2.7.0
pkgrel=1
pkgdesc="Picture TUI - terminal image viewer with a file browser and live previews"
url="https://github.com/narbs/ptui"
license=("MIT")
arch=("x86_64")
provides=("ptui")
conflicts=("ptui")
depends=("chafa" "imagemagick" "jp2a")
source=("https://github.com/narbs/ptui/releases/download/v$pkgver/ptui-$pkgver-x86_64.tar.gz")
sha256sums=("fa81d449d22552be7d8b4271e39266cc899a2e58c72fdd669166f26fe96bebec")

package() {
    install -Dm755 ptui -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/ptui/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/ptui/README.md"
    install -Dm644 "NEWS.md" "$pkgdir/usr/share/doc/ptui/NEWS.md"
    install -Dm644 "CHANGELOG.md" "$pkgdir/usr/share/doc/ptui/CHANGELOG.md"
    install -Dm644 "docs/example.config.ptui.json" "$pkgdir/usr/share/doc/ptui/example.config.ptui.json"
}
