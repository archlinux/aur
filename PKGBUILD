# Maintainer: Tércio Martins <echo dGVyY2lvd2VuZGVsQGdtYWlsLmNvbQo= | base64 -d>

pkgname=r3d-sdk
pkgver=9.2.0
pkgrel=1
arch=('x86_64')
pkgdesc="SDK to load and decode R3D files generated by RED cameras"
url="https://www.red.com/developers"
license=('LicenseRef-EULA')
depends=('gcc-libs' 'util-linux-libs')
makedepends=('poppler')
options=('!strip')
_pkgver=$(echo $pkgver | sed -e 's/_/-/' -e 's/\./_/g')
source=("https://downloads.red.com/software/sdk/R3D/${pkgver%.*}/R3DSDKv${_pkgver}.zip")
b2sums=('bb586376d95d6a7874d63ea130f035bb0b93bf18acdd058e02a21e8ea9e638625bc43049f4ae11800c61bd7778397e51c0c6eb773a06fd7c4f425aff69c26e9a')

prepare(){
  pdftotext -layout "R3DSDKv${_pkgver%-*}/SDK License Agreement.pdf" 2>&-
  mv "R3DSDKv${_pkgver%-*}/SDK License Agreement.txt" "$srcdir"
}

package() {
  install -d "$pkgdir/opt"
  install -d "$pkgdir/usr/share/licenses/$pkgname"

  cp -dr --no-preserve=ownership "R3DSDKv${_pkgver%-*}" \
                                 "$pkgdir/opt/R3DSDK"

  cp --no-preserve=ownership "$srcdir/SDK License Agreement.txt" \
                             "$pkgdir/usr/share/licenses/$pkgname"
}
