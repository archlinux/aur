# Maintainer: HireFerry contributors <support@lmm.best>
# Generated by scripts/aur.py; edit the generator in the upstream repository.
pkgname=hireferry-server-git
pkgver=0.1.0.r41.g11b0dfc
pkgrel=1
pkgdesc='Self-hosted recruitment server with an embedded web UI'
arch=('x86_64' 'aarch64')
url='https://github.com/TokenNotIncluded/hireferry'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'ca-certificates' 'systemd')
provides=('hireferry-server')
conflicts=('hireferry-server')
makedepends=('cargo' 'git' 'pkgconf')
options=('!lto')
source=('hireferry::git+https://github.com/TokenNotIncluded/hireferry.git#branch=main')
sha256sums=('SKIP')
_target="$CARCH-unknown-linux-gnu"

pkgver() {
  cd "$srcdir/hireferry"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' Cargo.toml | head -n 1)
  printf '%s.r%s.g%s' "${version//-/.}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/hireferry"
  cargo fetch --locked --target "$_target"
}

build() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo build --frozen --release --target "$_target" -p hireferry
}

check() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo test --frozen --target "$_target" -p hireferry
}

package() {
  cd "$srcdir/hireferry"
  install -Dm755 target/$_target/release/hireferry "$pkgdir/usr/bin/hireferry"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "packaging/arch/hireferry.service" "$pkgdir/usr/lib/systemd/system/hireferry.service"
  install -Dm644 "packaging/arch/hireferry.sysusers" "$pkgdir/usr/lib/sysusers.d/hireferry.conf"
  install -Dm644 "packaging/arch/hireferry.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/hireferry.conf"
  install -Dm644 config.example.toml "$pkgdir/usr/share/hireferry/config.example.toml"
  install -Dm644 THIRD_PARTY_NOTICES "$pkgdir/usr/share/doc/hireferry-server/THIRD_PARTY_NOTICES"
  install -Dm644 docs/self-hosting.md docs/deployment-handoff.md docs/aur.md -t "$pkgdir/usr/share/doc/hireferry-server/"
}
