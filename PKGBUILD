            '409c1c62d2060585e25378294a2087ff1c4ceb2522f52ea38d5a6736be768dc6')

package() {
	install -d "$pkgdir/opt/selfwork" "$pkgdir/usr/bin"
	cp -a "Selfwork-0.0.1-linux-x64/." "$pkgdir/opt/selfwork/"
	# Electron's sandbox helper must be setuid where unprivileged user namespaces are disabled
	chmod 4755 "$pkgdir/opt/selfwork/chrome-sandbox"
	ln -s /opt/selfwork/selfwork "$pkgdir/usr/bin/selfwork"
	install -Dm644 selfwork.desktop "$pkgdir/usr/share/applications/selfwork.desktop"
	install -Dm644 selfwork.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/selfwork.png"
}
