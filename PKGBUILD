prepare() {
  cd "$srcdir"
  local repo="flatpak-repo" ref
  rm -rf "$repo" app .flatpak-extras
  ostree init --mode=archive --repo="$repo"
  flatpak build-import-bundle --no-update-summary "$repo" "$srcdir/cfluxdo-1.3.4-linux-x86_64.flatpak"
  ref="$(ostree refs --repo="$repo" | grep -E "^app/com.github.molchuan.cfluxdo/x86_64/" | head -n 1)"
  if [[ -z "$ref" ]]; then
    printf "No app/com.github.molchuan.cfluxdo/x86_64 ref found in the Flatpak bundle\n" >&2
    return 1
  fi
  ostree checkout --repo="$repo" --user-mode "$ref" app
  mkdir -p .flatpak-extras
  mkdir -p ".flatpak-extras/libjxl-0.10.3-1-x86_64"
  bsdtar -xf "$srcdir/libjxl-0.10.3-1-x86_64.pkg.tar.zst" -C ".flatpak-extras/libjxl-0.10.3-1-x86_64"
  install -d "app/files/cfluxdo/lib"
  cp -a ".flatpak-extras/libjxl-0.10.3-1-x86_64"/usr/lib/libjxl*.so.0.10* "app/files/cfluxdo/lib/"
  mkdir -p ".flatpak-extras/openexr-3.2.4-1-x86_64"
  bsdtar -xf "$srcdir/openexr-3.2.4-1-x86_64.pkg.tar.zst" -C ".flatpak-extras/openexr-3.2.4-1-x86_64"
  install -d "app/files/cfluxdo/lib"
  cp -a ".flatpak-extras/openexr-3.2.4-1-x86_64"/usr/lib/lib*-3_2.so.31* "app/files/cfluxdo/lib/"
  mkdir -p ".flatpak-extras/imath-3.1.9-2-x86_64"
  bsdtar -xf "$srcdir/imath-3.1.9-2-x86_64.pkg.tar.zst" -C ".flatpak-extras/imath-3.1.9-2-x86_64"
  install -d "app/files/cfluxdo/lib"
  cp -a ".flatpak-extras/imath-3.1.9-2-x86_64"/usr/lib/libImath-3_1.so.29* "app/files/cfluxdo/lib/"
}

