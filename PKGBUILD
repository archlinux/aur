package() {
  cd "$srcdir"
  install -d "$pkgdir/opt/rufpak/com.github.molchuan.cfluxdo"
  cp -a app/files/. "$pkgdir/opt/rufpak/com.github.molchuan.cfluxdo/"
  if [[ -d app/export/share ]]; then
    install -d "$pkgdir/usr/share"
    cp -aL app/export/share/. "$pkgdir/usr/share/"
  fi
  local desktop
  while IFS= read -r -d '' desktop; do
    sed -i "s|^Exec=[^[:space:]]*|Exec=cfluxdo|" "$desktop"
  done < <(find "$pkgdir/usr/share/applications" -maxdepth 1 \( -type f -o -type l \) -name "*.desktop" -print0 2>/dev/null || true)
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/cfluxdo" <<'LAUNCHER'
#!/bin/bash
set -euo pipefail
PAYLOAD='/opt/rufpak/com.github.molchuan.cfluxdo'
APPID='com.github.molchuan.cfluxdo'
APPDIR="${HOME}/.var/app/${APPID}"
mkdir -p "$APPDIR/config/dconf" "$APPDIR/data" "$APPDIR/cache" "$APPDIR/state"
args=()
add() { if [ -e "$2" ]; then args+=("$1" "$2" "$2"); fi; return 0; }
for d in /usr /etc; do args+=(--ro-bind "$d" "$d"); done
for d in /var /run /opt /srv; do add --bind "$d"; done
for l in /lib /lib64 /bin /sbin; do if [ -L "$l" ]; then args+=(--symlink "$(readlink "$l")" "$l"); fi; done
args+=(--proc /proc --ro-bind /sys /sys --dev /dev)
add --dev-bind /dev/dri
add --bind /dev/shm
args+=(--tmpfs /tmp)
add --ro-bind /tmp/.X11-unix
args+=(--bind "$APPDIR" "$APPDIR")
d=$(xdg-user-dir DOWNLOAD 2>/dev/null || true); [ -n "${d:-}" ] || d="$HOME/Downloads"; add --bind "$d"
args+=(--ro-bind "$PAYLOAD" /app --unshare-pid --die-with-parent)
args+=(--setenv PATH "/app/bin:${PATH:-/usr/local/bin:/usr/bin}")
args+=(--setenv XDG_DATA_DIRS "/app/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}")
args+=(--setenv XDG_CONFIG_HOME "$APPDIR/config")
args+=(--setenv XDG_DATA_HOME "$APPDIR/data")
args+=(--setenv XDG_CACHE_HOME "$APPDIR/cache")
args+=(--setenv XDG_STATE_HOME "$APPDIR/state")
args+=(--ro-bind-try "$HOME/.config/dconf" "$APPDIR/config/dconf")
exec bwrap "${args[@]}" -- /app/bin/cfluxdo "$@"
LAUNCHER
  chmod 0755 "$pkgdir/usr/bin/cfluxdo"
}
