conflicts=('devserial')
options=('!strip')
source_x86_64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.13/devserial-0.1.13-x86_64-unknown-linux-gnu.tar.gz')
sha256sums_x86_64=('b590717c00ee043d7e25ddafbc42240046412d01a6dfd7361fe99f2a5275abd6')
source_aarch64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.13/devserial-0.1.13-aarch64-unknown-linux-gnu.tar.gz')
