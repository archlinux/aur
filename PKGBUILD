pkgname=emskin-bin
pkgver=0.3.13
pkgrel=1
pkgdesc="Nested Wayland compositor for Emacs"
url="https://github.com/emskin/emskin"
license=("GPL-3.0")
arch=("x86_64")
provides=("emskin")
conflicts=("emskin")
depends=("wayland" "libxkbcommon" "libxkbcommon-x11" "mesa" "libinput" "seatd" "fontconfig" "freetype2" "ttf-dejavu" "xorg-xwayland" "xwayland-satellite")
optdepends=("emacs-wayland: pgtk Emacs (recommended)" "emacs: X11 Emacs (works via xwayland-satellite)")
source=("https://github.com/emskin/emskin/releases/download/v$pkgver/emskin-$pkgver-x86_64.tar.gz")
sha256sums=('ed16ea5fde2b2c0b950b499dc8a458fe893cede2a7c8ab9fbf62628a4bd7f52f')

package() {
    install -Dm755 emskin -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "assets/emskin.desktop" "$pkgdir/usr/share/applications/emskin.desktop"
    install -Dm644 "assets/emskin.png" "$pkgdir/usr/share/pixmaps/emskin.png"
    install -Dm755 "emskin-bar" "$pkgdir/usr/bin/emskin-bar"
}
