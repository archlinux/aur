# Workaround for "bsdtar: Can't translate pathname to UTF-8"
# export LANG=C.UTF-8
# export LC_ALL=C.UTF-8

package() {
	mkdir -m0755 -p "$pkgdir/etc"
	cp -Ppr "$srcdir/etc/ascon" "$pkgdir/etc/"
	cp -Ppr "$srcdir/etc/xdg" "$pkgdir/etc/"
	cp -Ppr "$srcdir/opt" "$pkgdir/"
	cp -Ppr "$srcdir/usr" "$pkgdir/"

	echo "Name[en]=KOMPAS-3D v24" >> "$pkgdir/usr/share/desktop-directories/kompas-24.directory"

	# Fix error while loading shared libraries: libunwind.so.1: cannot open shared object file: No such file or directory
	ln -s /usr/lib/libunwind.so "$pkgdir/opt/ascon/kompas3d-v24/Bin/libunwind.so.1"

	# from ascon-helpserver
	chmod +x "$pkgdir/usr/bin/Ascon.HelpServer"

	# from ascon-kompas-graphic-v24
	ln -s "/opt/ascon/kompas3d-v24/Bin/kKompas" "$pkgdir/usr/bin/kompas-v24"
	ln -s "/opt/ascon/kompas3d-v24/License/kactivation" "$pkgdir/usr/bin/kompas-kactivation-v24"
	# add group ascon-kompas
	# chgrp -R ascon-kompas /etc/ascon/KOMPAS-3D/24/
	# chmod -R 775 /etc/ascon/KOMPAS-3D/24/
	# ru_RU.CP1251 locale

	# from ascon-kompas-help-v24
	# chgrp -R ascon-kompas /etc/ascon/HelpServer/
	# chmod -R 775 /etc/ascon/HelpServer/

	# from ascon-kompas-sdk-v24
	mkdir -m0755 -p "$pkgdir/etc/profile.d"
	echo "export KOMPAS_SDK=/opt/ascon/kompas3d-v24/SDK/" > "$pkgdir/etc/profile.d/ascon-kompas-sdk.sh"

	# from ascon-kompas3d-v24
	ln -sn "/opt/ascon/PolynomLibrary" "$pkgdir/opt/ascon/kompas3d-v24/Libs/PolynomLib"

	# from grdcontrol
	mkdir -m0755 -p "$pkgdir/etc/udev/rules.d"
	mkdir -m0755 -p "$pkgdir/usr/lib/systemd/system"
	ln -s "/opt/guardant/grdcontrol/license_wizard" "$pkgdir/usr/bin/license_wizard"
	cp "$pkgdir/opt/guardant/grdcontrol/95-grdnt.rules" "$pkgdir/etc/udev/rules.d/"
	cp "$pkgdir/opt/guardant/grdcontrol/grdcontrol.service" "$pkgdir/usr/lib/systemd/system/grdcontrol.service"
}
