sha256sums_x86_64=('4983e72129500b392733fc005bee73074db4e1b10d37ed3fab392ac0af02df4c')
package() {
    install -Dm755 "${srcdir}/${pkgname%-bin}" -t "${pkgdir}/usr/bin"
    install -Dm644 "${srcdir}/README"* -t "${pkgdir}/usr/share/docs/${pkgname%-bin}"
}
