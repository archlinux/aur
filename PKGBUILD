# Generated by scripts/aur.py; edit the generator in the upstream repository.
pkgname=hireferry-cli-git
pkgver=0.1.3.r38.gd3c1214
pkgrel=1
pkgdesc='Command-line client for HireFerry (hfy)'
arch=('x86_64' 'aarch64')
url='https://github.com/TokenNotIncluded/hireferry'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'ca-certificates')
provides=('hireferry-cli')
conflicts=('hireferry-cli')
optdepends=('xdg-utils: open browser for interactive login')
makedepends=('cargo' 'git')
options=('!lto')
source=('hireferry::git+https://github.com/TokenNotIncluded/hireferry.git#branch=main')
sha256sums=('SKIP')
_target="$CARCH-unknown-linux-gnu"

pkgver() {
  cd "$srcdir/hireferry"
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"$/\1/p' crates/hireferry-cli/Cargo.toml | head -n 1)
  printf '%s.r%s.g%s' "${version//-/.}" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/hireferry"
  cargo fetch --locked --target "$_target"
}

build() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo build --frozen --release --target "$_target" -p hireferry-cli
}

check() {
  cd "$srcdir/hireferry"
  CARGO_TARGET_DIR=target cargo test --frozen --target "$_target" -p hireferry-cli
}

package() {
  cd "$srcdir/hireferry"
  install -Dm755 target/$_target/release/hfy "$pkgdir/usr/bin/hfy"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/cli.md "$pkgdir/usr/share/doc/hireferry-cli/README.md"
  install -d "$pkgdir/usr/share/hireferry-cli/skills"
  cp -r skills/hireferry "$pkgdir/usr/share/hireferry-cli/skills/"
  install -Dm755 scripts/install-skill.sh "$pkgdir/usr/share/hireferry-cli/scripts/install-skill.sh"
}
