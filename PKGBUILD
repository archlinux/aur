  install -dm755 "$dest"
  bsdtar -xf "$srcdir/aimp-skin-style-x-789.archive" -C "$dest"
  find "$dest" -mindepth 2 -type f -exec mv -t "$dest" {} +
  find "$dest" -mindepth 1 -type d -empty -delete
