pkgname='jaguar-bin'
pkgver=1.70.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('21e79a41d39766b83ff2f114e8376525ddbbca0237a2011a29a551a5082f0b9a')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
