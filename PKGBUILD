source_aarch64=("gizmosql-${pkgver}-arm64.zip::https://github.com/gizmodata/gizmosql/releases/download/v${pkgver}/gizmosql_cli_linux_arm64.zip")
b2sums_x86_64=('0831f06581ae807d0f89d53be7cf893bc2122c815cd542fef8d14ede278b57cad0a438e2277b91c36f0be123750d140978df6474063823c943995197be651b09')
b2sums_aarch64=('676e13bdf91350c3346d264e2477130897de6ef40e2a8819747bfa8a7329266e916d105396b1964823b7018eef4aef586701c36a5060d120edf9304a1575a5d8')

