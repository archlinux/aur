pkgname=sonic-frameworks-data-models
pkgver=6.31.0
pkgrel=1
pkgdesc='Models for Qt Model/View system'
arch=('x86_64')
url='https://github.com/Sonic-DE/sonic-frameworks-data-models'
license=(
	'LGPL-2.0-only'
	'LGPL-3.0-only'
)
depends=(
	'glibc'
	'libstdc++'
	'qt6-base'
)
makedepends=(
	'doxygen'
	'qt6-declarative'
	'qt6-tools'
	'sonic-frameworks-cmake-modules'
)
optdepends=('qt6-declarative: QML bindings')
provides=('kitemmodels')
conflicts=('kitemmodels')
groups=('sonicde-frameworks')
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('fa825205e659fd1061f325407d9d6736f000243d7d139048633e7a6297632fb7')

build() {
	cmake -B build -S "$pkgname-$pkgver" \
		-DBUILD_TESTING=OFF
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
