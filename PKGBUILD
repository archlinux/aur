package() {
  local dest="$pkgdir$_skinsdir"
  install -dm755 "$dest"
  bsdtar -xf "$srcdir/aimp-skin-origami-331.archive" -C "$dest"
  find "$dest" -mindepth 2 -type f -exec mv -t "$dest" {} +
