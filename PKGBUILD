# Maintainer: Kief Studio <packages@kief.studio>
#
# Rolling build from the latest commit on the default branch. SKIP is mandatory
# for a VCS source, so provenance comes from prepare(), which refuses to build a
# HEAD whose content cannot be traced back to commits signed by our release key
# (validpgpkeys). See _ks_trusted below. NOTE: this is a WEAKER guarantee than
# the tagged packages (aur-scanner / ks-aur-scanner), which verify a signed
# release tag pinned to a reviewed version. Prefer the tagged packages on
# production systems.
pkgname=aur-scanner-git
pkgver=2.1.1.r6.g0cd9123
pkgrel=1
pkgdesc="Security scanner for Arch Linux AUR packages - detect malicious PKGBUILDs before installation"
arch=('x86_64' 'aarch64')
url="https://github.com/KiefStudioMA/ks-aur-scanner"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'openssl')
makedepends=('cargo' 'git' 'clang')
provides=('aur-scanner' 'aur-scan')
conflicts=('aur-scanner' 'ks-aur-scanner' 'aur-scanner-rc')
options=('!debug')
# Import the signing key first:  gpg --recv-keys 25631EAE3F43999050B7D7021132BF893C33FB51
source=("git+https://github.com/KiefStudioMA/ks-aur-scanner.git")
validpgpkeys=('25631EAE3F43999050B7D7021132BF893C33FB51') # gitleaks:allow (public GPG key fingerprint, not a secret)
sha256sums=('SKIP')

pkgver() {
    cd ks-aur-scanner
    local tag_ver
    tag_ver=$(git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')
    if [[ -n "$tag_ver" ]]; then
        echo "$tag_ver"
    else
        printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

# True when commit $1 carries a good signature from the release key itself.
# Checked by fingerprint: `git verify-commit` alone accepts ANY good signature
# in the builder's keyring, not just ours.
_ks_signed_by_release_key() {
    local status fpr
    status=$(git log -1 --format='%G?' "$1" 2>/dev/null)
    fpr=$(git log -1 --format='%GP' "$1" 2>/dev/null)
    [[ ( $status == G || $status == U ) && ${fpr^^} == "${validpgpkeys[0]}" ]]
}

# True when commit $1's content provably comes from release-key-signed commits.
#
# Either $1 is signed by the release key, or it is a two-parent merge where
#   - the second parent (the merged PR head) is signed by the release key,
#   - the first parent is itself trusted (checked recursively), and
#   - its tree is exactly a clean `git merge-tree` of those two parents,
#     so the merge commit added nothing of its own.
# That last rule is what lets GitHub's "Merge pull request" commits through
# (GitHub signs those with its own key, never ours; issue #20) without trusting
# GitHub: a merge that slipped in an edit, merged an unsigned head, or sits on
# an untrusted base is refused.
_ks_trusted() {
    local commit=$1 depth=${2:-0}
    (( depth <= 500 )) || return 1
    _ks_signed_by_release_key "$commit" && return 0

    local -a parents
    read -ra parents <<< "$(git rev-list --parents -n 1 "$commit")"
    (( ${#parents[@]} == 3 )) || return 1
    _ks_signed_by_release_key "${parents[2]}" || return 1

    local merged
    merged=$(git merge-tree --write-tree "${parents[1]}" "${parents[2]}" 2>/dev/null) || return 1
    [[ $merged == "$(git rev-parse "$commit^{tree}")" ]] || return 1

    _ks_trusted "${parents[1]}" $((depth + 1))
}

prepare() {
    cd ks-aur-scanner
    # Verify provenance before building, or even fetching deps for, any of it.
    if ! _ks_trusted HEAD; then
        echo "ERROR: HEAD $(git rev-parse --short HEAD) cannot be traced to commits signed" >&2
        echo "       by the release key ${validpgpkeys[0]}." >&2
        echo "       If the key is missing:  gpg --recv-keys ${validpgpkeys[0]}" >&2
        return 1
    fi
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd ks-aur-scanner
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --all --locked
}

check() {
    cd ks-aur-scanner
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --all --locked
}

package() {
    cd ks-aur-scanner

    # Binaries
    install -Dm755 "target/release/aur-scan" "$pkgdir/usr/bin/aur-scan"
    install -Dm755 "target/release/aur-scan-wrap" "$pkgdir/usr/bin/aur-scan-wrap"
    install -Dm755 "target/release/aur-scan-hook" "$pkgdir/usr/bin/aur-scan-hook"

    # Shell completions, generated by the binary we just built so they can never
    # drift from the actual command surface. This package follows the default
    # branch, which may predate the `completions` subcommand (2.2+), so only
    # install them when the binary has it.
    if "target/release/aur-scan" completions bash >/dev/null 2>&1; then
        install -d "$pkgdir/usr/share/bash-completion/completions"
        install -d "$pkgdir/usr/share/zsh/site-functions"
        install -d "$pkgdir/usr/share/fish/vendor_completions.d"
        "target/release/aur-scan" completions bash > "$pkgdir/usr/share/bash-completion/completions/aur-scan"
        "target/release/aur-scan" completions zsh  > "$pkgdir/usr/share/zsh/site-functions/_aur-scan"
        "target/release/aur-scan" completions fish > "$pkgdir/usr/share/fish/vendor_completions.d/aur-scan.fish"
    fi

    # Shell integration -- the recommended gate. Source it from your shell rc to
    # scan AUR packages BEFORE makepkg builds them.
    install -Dm644 "install/integration.bash" "$pkgdir/usr/share/aur-scan/integration.bash"
    install -Dm644 "install/integration.zsh" "$pkgdir/usr/share/aur-scan/integration.zsh"
    install -Dm644 "install/integration.fish" "$pkgdir/usr/share/aur-scan/integration.fish"
    install -Dm644 "install/integration.nu" "$pkgdir/usr/share/aur-scan/integration.nu"

    # Community rules -- every shipped .toml, not just the example. These are
    # loaded by the scan engine at runtime, so a rule file that is written but
    # never installed is a rule that silently does not exist on user systems.
    install -d "$pkgdir/usr/share/aur-scanner/rules.d"
    for _rule in install/rules.d/*.toml; do
        install -Dm644 "$_rule" "$pkgdir/usr/share/aur-scanner/rules.d/$(basename "$_rule")"
    done

    # pacman hook, shipped as an opt-in example (NOT auto-enabled). It runs after
    # makepkg has already built the package, so it only catches install-scriptlet
    # payloads -- prefer the shell integration above.
    install -Dm644 "install/aur-scan.hook" "$pkgdir/usr/share/aur-scan/aur-scan.hook.example"

    # License + docs
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
