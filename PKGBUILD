sha256sums=('03f5bfc27bd37041e66c972266e169eca4a5da2529f5743b40f249cd4ab891de')

package() {
    cp -a "${srcdir}"/* "${pkgdir}/"
    rm -f "${pkgdir}/.BUILDINFO" "${pkgdir}/.MTREE" "${pkgdir}/.PKGINFO" "${pkgdir}/.INSTALL"
}
