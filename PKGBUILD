# Maintainer: shitlime <fwshitlime@outlook.com>

pkgname=ttf-wenjin-mincho-font
pkgver=2.011
pkgrel=1
pkgdesc="A large Han-ideograph character set Songti(Mincho) font suite mainly derived by Source Han Serif and Han glyphs generated by modified Kage engine, and the glyphs are mainly presented in China mainland glyphs standard(aka G source)."
arch=('any')
url="https://github.com/takushun-wu/WenJinMincho"
license=('OFL-1.1')
source=(
    "${pkgname}-${pkgver}.7z::https://github.com/takushun-wu/WenJinMincho/releases/download/v${pkgver}/WenJinMincho-TTF.7z"
    "LICENSE-${pkgver}.md::https://raw.githubusercontent.com/takushun-wu/WenJinMincho/v${pkgver}/LICENSE.md"
    "LICENSE-${pkgver}-zh.md::https://raw.githubusercontent.com/takushun-wu/WenJinMincho/v${pkgver}/LICENSE-zh.md"
)
sha256sums=('ef12220d913f3873cae00972b4724c19d83cce74693e75adfc836c57a21add9c'
            '3f47d592920dbb67d90e2b248b26295703b3892cfeec465f1814fd71b2e902ef'
            '1a19fb2db8e608f863fbaf6f35f79b695bc6465bdcb9920fe5b6c04cd05d2194')

package() {
    find . -name "*.ttf" -exec install -Dm644 {} -t "$pkgdir/usr/share/fonts/WenJinMincho-TTF/" \;
    install -Dm644 "LICENSE-${pkgver}.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
    install -Dm644 "LICENSE-${pkgver}-zh.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-zh.md"
}
