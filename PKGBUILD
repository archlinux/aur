b2sums_x86_64=('3ea96fb5178c512a2b9affcd85bf08deabdb9b41be254240caa28e79d3bab6aa251331720eb3f4b301439c70c834662311161a4cc60e3423ec2203e7a4f01944')
b2sums_aarch64=('394c2666289330722adcd1a90bf731edc8c8764ad6fed635a4e589b78eb187ea55249f71cd313e6976e9d950d3e7744bb22c9213376e0216f728b9a323a81a36')

package(){
    install -D -m 755 "gizmosql_server" -t "${pkgdir}/usr/bin"
