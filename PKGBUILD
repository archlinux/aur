# Transitional package. The goodixtls55x4 driver (SIGFM matcher) is replaced
# by libfprint-goodix55b4, which uses Goodix's Milan matcher ported to native
# C. Installing this pulls in the new package; it has no files of its own.
# Prints enrolled with the old driver are not compatible: re-enroll.

pkgname=libfprint-goodixtls-55x4
pkgver=1.94.10.m2
pkgrel=1
pkgdesc="Transitional package: replaced by libfprint-goodix55b4 (Goodix 27c6:55b4, native Milan matcher)"
arch=('any')
url="https://github.com/TheWeirdDev/libfprint-goodix55b4-milan"
license=('LGPL-2.1-or-later')
depends=('libfprint-goodix55b4')
install=$pkgname.install
