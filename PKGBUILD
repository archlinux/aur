# SPDX-FileCopyrightText: 2026 Yangtse Su <yangtsesu@gmail.com>
# SPDX-License-Identifier: 0BSD
#
# The packaging files live only in this repository: the project keeps no copy, so this is the
# single source of truth for how cirrocast is packaged. The rationale is recorded in the project
# (docs/plans/13-packaging-and-release.md) and the release checklist is in its README under
# "Packaging and release".
#
# Every bump is verified with:
#   namcap PKGBUILD
#   makepkg --printsrcinfo | diff - .SRCINFO     # must print nothing
#   makepkg -f && namcap cirrocast-*.pkg.tar.zst
#   pkgctl build                                 # clean chroot
#   cirrocast --version && man -w cirrocast && pacman -Ql cirrocast | grep -c completions   # 3

pkgname=cirrocast
pkgver=1.2.0
pkgrel=1
pkgdesc="Terminal weather client with pluggable backends and wttr.in-style output"
arch=('x86_64' 'aarch64')
url="https://github.com/YangtseSu/cirrocast"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'jq' 'rust')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/YangtseSu/cirrocast/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dad09fbe53b02a94e27e34b4bfe71064beccf697a754731fdb1773817051719a')

# Rust's target triple for both supported architectures is exactly `<arch>-unknown-linux-gnu`, and
# `$CARCH` already holds the architecture, so nothing has to be mapped by hand. There is no
# cross-compilation here: the crate builds with its own toolchain for the machine makepkg runs on.
_triple() {
  echo "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked --target "$(_triple)"
}

check() {
  cd "$pkgname-$pkgver"
  # The tag tarball's crate version must be the one this PKGBUILD claims: a stale PKGBUILD fails
  # here instead of shipping a package whose metadata lies.
  local built
  # By name: the tarball's workspace has a second member (the dev-only `geo-table` builder) and
  # `packages[0]` resolves to that one.
  built="$(cargo metadata --format-version 1 --no-deps \
    | jq -r '.packages[] | select(.name == "cirrocast") | .version')"
  if [[ "$built" != "$pkgver" ]]; then
    echo "cirrocast: PKGBUILD says $pkgver but the tarball builds $built" >&2
    exit 1
  fi
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  local bin="target/$(_triple)/release/cirrocast"

  install -Dm755 "$bin" "$pkgdir/usr/bin/cirrocast"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The man page and the completions are generated by the binary itself, so they can never drift
  # from the command line surface they document.
  "$bin" man > "$srcdir/cirrocast.1"
  install -Dm644 "$srcdir/cirrocast.1" "$pkgdir/usr/share/man/man1/cirrocast.1"

  "$bin" completion bash > "$srcdir/cirrocast.bash"
  install -Dm644 "$srcdir/cirrocast.bash" \
    "$pkgdir/usr/share/bash-completion/completions/cirrocast"
  "$bin" completion zsh > "$srcdir/_cirrocast"
  install -Dm644 "$srcdir/_cirrocast" "$pkgdir/usr/share/zsh/site-functions/_cirrocast"
  "$bin" completion fish > "$srcdir/cirrocast.fish"
  install -Dm644 "$srcdir/cirrocast.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/cirrocast.fish"
}
