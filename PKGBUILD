# Maintainer: Andrew Mello <andrew@88plug.com>
pkgname=k3d-bin
pkgver=5.8.3
pkgrel=1
pkgdesc="k3d — run k3s in Docker (pre-built upstream binary). Local Kubernetes for CI, dev, GPU clusters"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/k3d-io/k3d"
license=('MIT')
depends=('docker')
optdepends=(
    'kubectl: query the cluster after creation'
    'nvidia-container-toolkit: GPU passthrough for k3d-gpu workloads'
    'bash-completion: tab completion for the k3d CLI'
    'zsh-completions: zsh completion'
    'fish: fish shell completion'
)
provides=('k3d')
conflicts=('k3d' 'k3d-git')
options=('!strip')

source_x86_64=("k3d-${pkgver}-linux-amd64::https://github.com/k3d-io/k3d/releases/download/v${pkgver}/k3d-linux-amd64")
source_aarch64=("k3d-${pkgver}-linux-arm64::https://github.com/k3d-io/k3d/releases/download/v${pkgver}/k3d-linux-arm64")
source_armv7h=("k3d-${pkgver}-linux-arm::https://github.com/k3d-io/k3d/releases/download/v${pkgver}/k3d-linux-arm")
source=("LICENSE::https://raw.githubusercontent.com/k3d-io/k3d/v${pkgver}/LICENSE")

sha256sums_x86_64=('dbaa79a76ace7f4ca230a1ff41dc7d8a5036a8ad0309e9c54f9bf3836dbe853e')
sha256sums_aarch64=('0b8110f2229631af7402fb828259330985918b08fefd38b7f1b788a1c8687216')
sha256sums_armv7h=('c4ef4e8008edb55cf347d846a7fc70af319883f9a474167689bd8af04693401d')
sha256sums=('SKIP')

package() {
    cd "$srcdir"

    # Binary
    case "$CARCH" in
        x86_64)  install -Dm755 "k3d-${pkgver}-linux-amd64" "$pkgdir/usr/bin/k3d" ;;
        aarch64) install -Dm755 "k3d-${pkgver}-linux-arm64" "$pkgdir/usr/bin/k3d" ;;
        armv7h)  install -Dm755 "k3d-${pkgver}-linux-arm"   "$pkgdir/usr/bin/k3d" ;;
    esac

    # Shell completions — generated by the binary itself; baked at package() time so users get them
    # without runtime cost. `--no-banner` keeps stdout clean of marketing line.
    install -dm755 "$pkgdir/usr/share/bash-completion/completions"
    install -dm755 "$pkgdir/usr/share/zsh/site-functions"
    install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d"
    "$pkgdir/usr/bin/k3d" completion bash > "$pkgdir/usr/share/bash-completion/completions/k3d" 2>/dev/null || true
    "$pkgdir/usr/bin/k3d" completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_k3d"        2>/dev/null || true
    "$pkgdir/usr/bin/k3d" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/k3d.fish" 2>/dev/null || true

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
