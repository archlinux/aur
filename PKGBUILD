pkgname=git-identity-manager
_bin=git-identity
pkgver=1.2.1
pkgrel=1
pkgdesc='Switch between Git identities per repository'
arch=('x86_64' 'aarch64')
url='https://github.com/Dxsk/git-identity-manager'
license=('MIT')
depends=('git' 'gcc-libs' 'glibc')
makedepends=('cargo')
conflicts=('git-identity-manager-bin' 'git-identity')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('90c3a92159dd2fa446a589af54d49d55cdb83eee5d96f82043dd31fa6885122e')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/$_bin" "$pkgdir/usr/bin/$_bin"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
