# Maintainer: Tobias Bachmann <tobachmann@gmx.de>
pkgname=connectome-workbench
pkgver=2.2.1
pkgrel=1
pkgdesc="Connectome Workbench is an open source, freely available visualization and discovery tool used to map neuroimaging data, especially data generated by the Human Connectome Project."
arch=('x86_64')
url="http://humanconnectome.org/software/connectome-workbench"
license=('GPL')
depends=('qt5-base' 'ftgl')
makedepends=('cmake')
source=("https://github.com/Washington-University/workbench/archive/v$pkgver.tar.gz"
	"$pkgname.desktop"
	"001-include_cstdint_in_CaretRgb.h.patch")
sha256sums=('e8c4c1d76df7dc657840c3a9756d83a418cdcd03037d4054819249d72f0d8477'
	    '9e002a2bc4e8354a0514e6e50c7ae388db9f243341385a7aaa8870954acbad96'
    	    'ea4700ceff714ac16782ea37b5e400009ebc590fb203f3e53532469cdda89658')

prepare() {
  cd "workbench-$pkgver"
  patch -p1 < "${srcdir}"/001-include_cstdint_in_CaretRgb.h.patch
}

build() {
  mkdir -p build
  cd build
  sed -i 's/3\.0/3\.5/g' ${srcdir}/workbench-2.2.1/src/kloewe/dot/CMakeLists.txt
  cmake -D CMAKE_CXX_FLAGS="-fpermissive" -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D WORKBENCH_MESA_DIR=/usr -D WORKBENCH_USE_QT5=TRUE -DWORKBENCH_USE_SIMD=FALSE ../workbench-$pkgver/src
  make -j $(nproc)
}

check() {
  cd build
  ctest
}

package() {
  cd build
  make DESTDIR="$pkgdir/" install
  mkdir -p $pkgdir/usr/share/$pkgname/icons
  install ../workbench-$pkgver/icons/linux/workbench_128x128x32.png $pkgdir/usr/share/$pkgname/icons/workbench_128x128x32.png
  mkdir -p $pkgdir/usr/share/applications
  install ../../$pkgname.desktop $pkgdir/usr/share/applications/$pkgname.desktop
}

post_install() {
  update-desktop-database
}
