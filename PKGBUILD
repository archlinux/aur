# The desktop app's AUR package was openchronology-desktop-bin until 0.30, and is
# circagraph-desktop-bin now. This last openchronology-desktop-bin is empty and depends on
# circagraph-desktop-bin, so that an AUR helper's upgrade installs it in place of the old
# package. Releases publish it (scripts/aur-packages.mjs --transitional) until the AUR merges
# openchronology-desktop-bin into circagraph-desktop-bin.
# Maintainer: Athan Clark <athan.clark@gmail.com>
pkgname=openchronology-desktop-bin
pkgver=0.31.0
pkgrel=1
pkgdesc='Renamed circagraph-desktop-bin: this transitional package installs it, and may be removed'
arch=('any')
url='https://github.com/circagraph/timeline-app'
license=('GPL-3.0-only')
depends=('circagraph-desktop-bin')

package() {
  :
}
