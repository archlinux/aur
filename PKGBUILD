_pkgname=dartR.popgen
_pkgver=1.3.0
pkgname=r-${_pkgname,,}
pkgver=${_pkgver//[:-]/.}
pkgrel=1
pkgdesc="Analysing 'SNP' and 'Silicodart' Data Generated by Genome-Wide Restriction Fragment Analysis"
arch=('any')
url="https://cran.r-project.org/package=${_pkgname}"
license=('GPL-3.0-or-later')
depends=(
  r-adegenet
  r-ape
  r-crayon
  r-dartr.base
  r-dartr.data
  r-data.table
  r-dplyr
  r-furrr
  r-future
  r-ggdendro
  r-ggplot2
  r-lea
  r-patchwork
  r-pillar
  r-plyr
  r-purrr
  r-r.utils
  r-stampp
  r-stringr
  r-terra
)
optdepends=(
  r-assignpop
  r-coda
  r-directlabels
  r-expm
  r-fields
  r-gplots
  r-gridextra
  r-igraph
  r-iterpc
  r-label.switching
  r-leaflet
  r-pegas
  r-proxy
  r-qvalue
  r-raster
  r-reshape2
  r-scales
  r-siber
  r-snpstats
  r-sp
  r-testthat
  r-tidyr
  r-viridis
  r-withr
  r-zoo
)
source=("https://cran.r-project.org/src/contrib/${_pkgname}_${_pkgver}.tar.gz")
md5sums=('2aab3772bbe8d2dbeacb451ed3940980')
b2sums=('b0e2e107efa665014702bd7ce33fc9b50087d3990ceedeafb7dd5d1d1e873166964006ebd7098e5a3c0c453add703a512abc6892a68bf7c706ddfff153240f2d')

build() {
  mkdir build
  R CMD INSTALL -l build "$_pkgname"
}

package() {
  install -d "$pkgdir/usr/lib/R/library"
  cp -a --no-preserve=ownership "build/$_pkgname" "$pkgdir/usr/lib/R/library"
}
