pkgname=devserial-bin
pkgver=0.1.10
pkgrel=1
pkgdesc='MCP server bridging serial hardware to LLMs via SQLite-backed buffer'
arch=('x86_64' 'aarch64')
url='https://github.com/metaneutrons/devserial'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
provides=('devserial')
conflicts=('devserial')
options=('!strip')
source_x86_64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.10/devserial-0.1.10-x86_64-unknown-linux-gnu.tar.gz')
sha256sums_x86_64=('9b638aeaa4bb88050d1603fd24dfef60e11f846b8cbcb2256401dcd2d0b9c857')
source_aarch64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.10/devserial-0.1.10-aarch64-unknown-linux-gnu.tar.gz')
