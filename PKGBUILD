# Maintainer: Raul Dias <raul@dias.com.br>
#
# Prebuilt Arch packages of omarchy-broadcast (https://github.com/rsd/omarchy-broadcast),
# from the assets of its release v0.57.5. Generated by scripts/aur.sh --bin
# in that repository, from the -git packages the release was made of: do
# not edit it by hand; report problems there.
#
# Each <name>-bin package installs the usr/ tree of the release asset
# <name>-<pkgver>-x86_64.tar.zst as it is: the files of <name>-git, with
# the licence directory named <name>-bin. Each provides <name> and
# conflicts with <name> and <name>-git, so that either kind meets the
# other packages. The NVIDIA Maxine SDKs and ONNX Runtime are not part of
# these packages: the module packages depend on the packages that hold
# them, as the -git ones do.

pkgbase=omarchy-broadcast-bin
pkgname=(
  'omarchy-broadcast-bin'
  'omarchy-broadcast-maxine-vfx-bin'
  'omarchy-broadcast-maxine-ar-bin'
  'omarchy-broadcast-maxine-afx-bin'
  'omarchy-broadcast-onnx-bin'
)
pkgver=0.57.5
pkgrel=1
pkgdesc='GPU virtual camera daemon for v4l2loopback, with a D-Bus API and a CLI (prebuilt)'
url='https://github.com/rsd/omarchy-broadcast'
arch=('x86_64')
license=(
  'MIT OR Apache-2.0'
  'BSD-3-Clause'
  'ISC'
)
options=('!strip' '!debug' '!lto')
source=(
  "omarchy-broadcast-$pkgver-x86_64.tar.zst::https://github.com/rsd/omarchy-broadcast/releases/download/v$pkgver/omarchy-broadcast-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-vfx-$pkgver-x86_64.tar.zst::https://github.com/rsd/omarchy-broadcast/releases/download/v$pkgver/omarchy-broadcast-maxine-vfx-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-ar-$pkgver-x86_64.tar.zst::https://github.com/rsd/omarchy-broadcast/releases/download/v$pkgver/omarchy-broadcast-maxine-ar-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-afx-$pkgver-x86_64.tar.zst::https://github.com/rsd/omarchy-broadcast/releases/download/v$pkgver/omarchy-broadcast-maxine-afx-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-onnx-$pkgver-x86_64.tar.zst::https://github.com/rsd/omarchy-broadcast/releases/download/v$pkgver/omarchy-broadcast-onnx-$pkgver-x86_64.tar.zst"
)
sha256sums=(
  '9eb1565206c6bffa0b77830a352fbfaec6aba7d4a88534cbe72e40c3307f7ece'
  '44c1beecbcaaac9659b2d813b450e9358aabbbfad2a23471157089c40b2d42e9'
  '931f43a313e64d1228ad66a6e4f8463837c092ad44eefcaa33b6601ba04604c7'
  '386f56ebfc2924666eb50e849e1cc85d73e0021c288281c11e0d33b4c9bd0d76'
  '9d7c3e7486aa8faa3550f50ff9f55a486146b69fd2aaeab725c2ab583822b107'
)
# Extracted, every asset would land in the same $srcdir and their usr/
# trees would merge: each package() unpacks its own.
noextract=(
  "omarchy-broadcast-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-vfx-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-ar-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-maxine-afx-$pkgver-x86_64.tar.zst"
  "omarchy-broadcast-onnx-$pkgver-x86_64.tar.zst"
)

package_omarchy-broadcast-bin() {
  pkgdesc='GPU virtual camera daemon for v4l2loopback, with a D-Bus API and a CLI (prebuilt)'
  license=(
    'MIT OR Apache-2.0'
    'BSD-3-Clause'
    'ISC'
  )
  depends=(
    'libgcc'
    'glibc'
    'glib2'
    'gstreamer'
    'gst-plugins-base-libs'
    'gst-plugins-good'
    'gst-plugins-bad-libs'
    'V4L2LOOPBACK-MODULE'
    'libpipewire'
    'alsa-lib'
  )
  optdepends=(
    'cuda: NVRTC, needed for the CUDA video path on NVIDIA GPUs'
    'nvidia-utils: CUDA driver and NVML, needed for the CUDA video path on NVIDIA GPUs'
    'omarchy: the Omarchy shell, for the bar widget in the separate omarchy-broadcast-plugin repository'
    'v4l2loopback-utils: runtime-only loopback setup without modprobe.d'
    'pipewire: the optional PipeWire camera node ([pipewire] enabled in config.toml), the optional noise-removed microphone (ADR 0014) and the microphone host with its audio worker (omarchy-broadcast-mic.service, omarchy-broadcast-audiod)'
    'noise-suppression-for-voice: RNNoise engine for the noise-removed microphone (default)'
    'deepfilternet-ladspa: DeepFilterNet engine for the noise-removed microphone'
    'omarchy-broadcast-maxine-vfx: NVIDIA Maxine video effects module (background blur and replacement, video noise removal)'
    'omarchy-broadcast-maxine-ar: NVIDIA Maxine AR effects module (eye contact)'
    'omarchy-broadcast-maxine-afx: NVIDIA Maxine audio effects module for the microphone'
    'omarchy-broadcast-onnx: open-model cut-out module (background blur and replacement with ONNX Runtime)'
    'gst-plugins-bad: WebP background and away images (webpdec)'
    'ffmpeg: animated imports and posters of video backgrounds'
  )
  provides=(
    'omarchy-broadcast'
    'omarchy-broadcast-module-abi=1.6'
  )
  conflicts=(
    'omarchy-broadcast'
    'omarchy-broadcast-git'
  )
  install=omarchy-broadcast.install

  bsdtar -xpf "$srcdir/omarchy-broadcast-$pkgver-x86_64.tar.zst" -C "$pkgdir" usr
}

package_omarchy-broadcast-maxine-vfx-bin() {
  pkgdesc='NVIDIA Maxine video effects module for omarchy-broadcast: background blur and replacement, video noise removal (prebuilt)'
  license=(
    'MIT OR Apache-2.0'
    'ISC'
  )
  depends=(
    'omarchy-broadcast-module-abi>=1.6'
    'omarchy-broadcast-module-abi<2'
    'libgcc'
    'glibc'
    'cuda'
    'maxine-vfx-sdk-local'
  )
  provides=(
    'omarchy-broadcast-maxine-vfx'
  )
  conflicts=(
    'omarchy-broadcast-maxine-vfx'
    'omarchy-broadcast-maxine-vfx-git'
  )

  bsdtar -xpf "$srcdir/omarchy-broadcast-maxine-vfx-$pkgver-x86_64.tar.zst" -C "$pkgdir" usr
}

