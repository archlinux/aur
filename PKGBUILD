# Maintainer: pngdeity <pngdeity@tutanota.com>
_githubname="apple/pkl-lsp"
_pkgname=pkl-lsp

pkgname=$_pkgname
pkgver=0.7.1
pkgrel=2
pkgdesc="Language Server Protocol implementation for Pkl"
arch=('x86_64' 'aarch64')
url="https://github.com/apple/pkl-lsp"
license=('Apache-2.0')
makedepends=('git' 'python')
depends=('glibc' 'zlib')
conflicts=('pkl-lsp-bin')

_graalvm_ver=25.1.3-dev-20260619_0111
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz"
  "LICENSE.txt::https://raw.githubusercontent.com/${_githubname}/${pkgver}/LICENSE.txt"
  "run-lsp-agent.py"
)
source_x86_64=(
  "graalvm-jdk-${_graalvm_ver}-x64.tar.gz::https://github.com/graalvm/graalvm-ce-dev-builds/releases/download/${_graalvm_ver}/graalvm-community-dev-linux-amd64.tar.gz"
)
source_aarch64=(
  "graalvm-jdk-${_graalvm_ver}-arm64.tar.gz::https://github.com/graalvm/graalvm-ce-dev-builds/releases/download/${_graalvm_ver}/graalvm-community-dev-linux-aarch64.tar.gz"
)
sha512sums=('88fa02a73aaf99169df900ee9e300f52ad0b86f52ca4f82b54d1d1fc9fd9053af5d0a9af35cee34c112ec6aa7a99dfc77d944ce5a5ae723845ae2a11750f078d'
            '98f6b79b778f7b0a15415bd750c3a8a097d650511cb4ec8115188e115c47053fe700f578895c097051c9bc3dfb6197c2b13a15de203273e1a3218884f86e90e8'
            '0ad269086aa96c77d2c9a66bdab8fe59adb11cc8bd0e024266f33d474f415c8b5145157b26901fbaeca8bb92f32156361f12564af46727099671300b12e41d74')
sha512sums_x86_64=('7097c459e88b4fe3bfbc81f1c5246c0d46988d6503176a373a30a3dc34836c50577b07af81ea7c82f0bdb866e5788b05c1f8434f8530c54900cc463e8f3ff7a2')
sha512sums_aarch64=('3e3aeebdd8dfac4b8c1e2ac01ccee015dc15f3582a5f65d106c068642f547aa9d888ac3b2d3ce085497ccfb5ff4bae02819e90b6582c46005aea5b1e2b48779d')

prepare() {
  mkdir -p "${srcdir}/graalvm-jdk"

  if [[ "${CARCH}" == "x86_64" ]]; then
    bsdtar --strip-components=1 -xzf "graalvm-jdk-${_graalvm_ver}-x64.tar.gz" -C "${srcdir}/graalvm-jdk"
  else
    bsdtar --strip-components=1 -xzf "graalvm-jdk-${_graalvm_ver}-arm64.tar.gz" -C "${srcdir}/graalvm-jdk"
  fi

  if [[ ! -x "${srcdir}/graalvm-jdk/bin/native-image" ]]; then
    echo "::error::native-image not found in GraalVM JDK"
    exit 1
  fi
}

build() {
  export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-$(date +%s)}"
  export JAVA_HOME="${srcdir}/graalvm-jdk"
  export GRAALVM_HOME="${JAVA_HOME}"
  export PATH="${JAVA_HOME}/bin:${PATH}"
  export _JAVA_OPTIONS="-Xmx2g"
  export JDK_JAVA_OPTIONS=""

  cd "${srcdir}/${pkgname}-${pkgver}"

  ./gradlew --no-daemon --console=plain --build-cache shadowJar -x verifyShadowJar

  local JAR=$(find build/libs -name "pkl-lsp-${pkgver}*.jar" ! -name "*-sources*" ! -name "*-javadoc*" -print -quit)

  if [[ -z "${JAR}" ]]; then
    echo "::error::shadow JAR not found"
    echo "Contents of build/libs:"
    ls -la build/libs/
    exit 1
  fi

  if ! jar tf "${JAR}" | grep -q '\.pkl$'; then
    echo "::warning::shadow JAR contains no .pkl stdlib files — Pkl stdlib will be unavailable at runtime"
  fi

  python3 "${srcdir}/run-lsp-agent.py" "${JAR}" || {
    echo "::error::reachability metadata generation failed"
    exit 1
  }

  if ! ls META-INF/native-image/*.json &>/dev/null; then
    echo "::error::no reachability metadata generated by agent"
    exit 1
  fi

  for f in META-INF/native-image/*.json; do
    [[ -f "$f" ]] && jar --file "${JAR}" -u "$f"
  done

  export _JAVA_OPTIONS="-Xmx6g"

  native-image \
    -J--enable-native-access=ALL-UNNAMED \
    -march=compatibility \
    --enable-url-protocols=https,http \
    --enable-native-access=ALL-UNNAMED \
    -H:+ForeignAPISupport \
    --initialize-at-build-time= \
    -H:+ReportExceptionStackTraces \
    -H:NativeLinkerOption=-Wl,-z,relro,-z,now \
    -H:+StripDebugInfo \
    -R:MaxHeapSize=1g \
    --enable-sbom=false \
    -jar "${JAR}" \
    -o "${pkgname}"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/LICENSE.txt" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
