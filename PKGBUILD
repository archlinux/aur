pkgname=datui-bin
pkgver=0.2.37
pkgrel=1
pkgdesc="Data Exploration in the Terminal"
url="https://github.com/derekwisong/datui"
license=("MIT")
arch=("x86_64")
provides=("datui")
conflicts=("datui")
depends=("fontconfig")
source=("https://github.com/derekwisong/datui/releases/download/v$pkgver/datui-$pkgver-x86_64.tar.gz")
sha256sums=("c682e0abb4241d02384662fb48838624380b90116f9ddb7c6e4c60bbd69c514e")

package() {
    install -Dm755 datui -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "target/release/datui.1.gz" "$pkgdir/usr/share/man/man1/datui.1.gz"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/datui/LICENSE"
}
