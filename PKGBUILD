prepare() {
    cd "${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release -p chordsketch
}

package() {
    cd "${pkgname}-${pkgver}"
    install -Dm755 target/release/chordsketch "${pkgdir}/usr/bin/chordsketch"
    install -Dm644 LICENSE NOTICE THIRD_PARTY_LICENSES.md -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
