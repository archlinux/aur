# Maintainer: Geoff Jay <geoff.jay@gmail.com>
# This PKGBUILD is generated by goreleaser on every release tag push.
# Do not edit manually — changes are overwritten.

pkgname=horde-bin
pkgver=0.4.0
pkgrel=1
pkgdesc="Distributed multi-agent system"
arch=('x86_64' 'aarch64')
url="https://github.com/geoffjay/horde"
license=('MIT')
provides=('horde')
conflicts=('horde')

case "$CARCH" in
x86_64)
  _arch='amd64'
  _os='linux'
  ;;
aarch64)
  _arch='arm64'
  _os='linux'
  ;;
*)
  echo "Unsupported arch: $CARCH"
  exit 1
  ;;
esac

source=("${url}/releases/download/v${pkgver}/horde_${pkgver}_${_os}_${_arch}.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/horde" "$pkgdir/usr/bin/horde"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim:set ts=2 sw=2 et:
