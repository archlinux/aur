# Maintainer: Niko Lowry <niko@neeks.me>
#
# Template. The release workflow fills in 0.9.9 and the
# @SHA256_*@ checksums and attaches the result to the release, so
# this file is never edited by hand per release.
#
# Prebuilt binaries, hence the AUR -bin naming convention.

pkgname=saxby-bin
pkgver=0.9.9
pkgrel=1
pkgdesc="Local-first LLM routing daemon"
arch=('x86_64' 'aarch64')
url="https://github.com/saxby-tools/saxby"
license=('AGPL-3.0-or-later')
depends=('glibc')
provides=('saxby')
conflicts=('saxby')

# Deno appends the program to the runtime inside each binary.
# Stripping it removes the program, so never strip.
options=('!strip')

_base="https://github.com/saxby-tools/saxby/releases/download"
_stage="saxby-${pkgver}"

source_x86_64=("${_base}/v${pkgver}/${_stage}-linux-x64.tar.gz")
source_aarch64=("${_base}/v${pkgver}/${_stage}-linux-arm64.tar.gz")

sha256sums_x86_64=('dadbcf0ac94edd23f7d59fcc423d26230f67676c8a1a9af230f51c17041e7cce')
sha256sums_aarch64=('657b1a9860f87abfb1cbe3c4e7ce3432c5832b86b128ec1ce04a4efe78e3f5bc')

package() {
    local target

    case "${CARCH}" in
        x86_64) target="linux-x64" ;;
        aarch64) target="linux-arm64" ;;
    esac

    local dir="${srcdir}/${_stage}-${target}"

    install -Dm755 "${dir}/saxbyd" "${pkgdir}/usr/bin/saxbyd"
    install -Dm755 "${dir}/saxby" "${pkgdir}/usr/bin/saxby"
    install -Dm644 "${dir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Generated by scripts/build.js and shipped in the tarball.
    local share="${pkgdir}/usr/share"

    install -Dm644 "${dir}/completions/saxby.bash" \
        "${share}/bash-completion/completions/saxby"
    install -Dm644 "${dir}/completions/_saxby" \
        "${share}/zsh/site-functions/_saxby"
    install -Dm644 "${dir}/completions/saxby.fish" \
        "${share}/fish/vendor_completions.d/saxby.fish"
}
