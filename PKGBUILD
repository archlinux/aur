# Maintainer: JBetchGH <JBetchGH@users.noreply.github.com>
#
# Binary AUR package. Downloads the signed release artifacts directly
# from GitHub Releases — faster install, no Go toolchain required.
# Use the source `mtroamd` package if you'd rather build from
# verified source.
#
# Per-arch sources are matched at install time by makepkg; the
# sha256sums_<arch> arrays are regenerated by `make aur-prep` after
# every upstream tag.

pkgname=mtroamd-bin
pkgver=1.7.2
pkgrel=1
pkgdesc="Persistent terminal daemon over QUIC - like mosh+tmux in one daemon, with multi-client handoff (pre-built)"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/AG-Studio-Apps/mtroamd"
license=('AGPL-3.0-or-later')
# minisign is load-bearing: prepare() verifies the signed checksum
# manifest with the upstream release key before any binary is trusted.
makedepends=('minisign')
conflicts=('mtroamd')
provides=("mtroamd=${pkgver}" "mtroam=${pkgver}")

_releaseurl="https://github.com/AG-Studio-Apps/mtroamd/releases/download/v${pkgver}"

source_x86_64=(
    "${_releaseurl}/mtroamd-linux-amd64"
    "${_releaseurl}/mtroam-linux-amd64"
    "${_releaseurl}/SHA256SUMS"
    "${_releaseurl}/SHA256SUMS.minisig"
    "${_releaseurl}/mtroamd.8"
    "${_releaseurl}/mtroam.1"
    "${_releaseurl}/mtroamd.bash"
    "${_releaseurl}/mtroam.bash"
    "${_releaseurl}/mtroamd.zsh"
    "${_releaseurl}/mtroam.zsh"
    "${_releaseurl}/mtroamd.fish"
    "${_releaseurl}/mtroam.fish"
)
source_aarch64=(
    "${_releaseurl}/mtroamd-linux-arm64"
    "${_releaseurl}/mtroam-linux-arm64"
    "${_releaseurl}/SHA256SUMS"
