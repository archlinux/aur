# upstream package ships no install hooks
source=("gaze-cinnamon-extension-0.3.1-1-x86_64.pkg.tar.zst::https://packages.gundulabs.com/arch/packages/gaze-cinnamon-extension-0.3.1-1-x86_64.pkg.tar.zst")
