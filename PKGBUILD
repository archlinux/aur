# Maintainer: Jiahao, Woo <woojiahao1234@gmail.com>
pkgname=gitmastery-beta-bin
pkgver="v.0.1.13_beta.1"
pkgrel=1
pkgdesc="Git-Mastery CLI for practicing Git"
arch=('x86_64')
url='https://github.com/git-mastery/app'
license=('MIT')
depends=(
  'python'
)
changelog="gitmastery-beta.changelog"
source=("gitmastery-beta-.0.1.13-beta.1-linux-amd64::https://github.com/git-mastery/app/releases/download/v.0.1.13-beta.1/gitmastery-beta-.0.1.13-beta.1-arch-amd64")
sha256sums=('SKIP')

package() {
  install -D -m 0755 "$srcdir/gitmastery-beta-.0.1.13-beta.1-linux-amd64" "$pkgdir/usr/bin/gitmastery-beta"
  chmod 755 "$pkgdir/usr/bin/gitmastery-beta"
}

