# _install_skin <target-dir> <source-file>
_install_skin() {
  local dest="$pkgdir$_skinsdir/$1"
  install -dm755 "$dest"
  bsdtar -xf "$srcdir/$2" -C "$dest"
  find "$dest" -type d -exec chmod 755 {} +
  find "$dest" -type f -exec chmod 644 {} +
}

package_aimp-skin-soot() {
  pkgdesc='AIMP skin: Soot 4.0.1 (by gr-e)'
  _install_skin 'Soot' 'aimp-skin-soots-923.archive'
}

