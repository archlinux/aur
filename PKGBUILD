# _ortf_lib_pkg <soname> <tensorrt package>: prints the package that
# provides the library <soname> on Arch; nothing when it is not mapped.
# Every DT_NEEDED entry of every library of every package must map to a
# package in that package's depends (_ortf_lib_depends), or package()
# fails: a library a new release starts to link, of whatever vendor
# (libcutensor, libnvjpeg, libOpenCL, libze_loader, ...), is caught rather
# than shipped without its dependency, and so is a system library whose
# package is not declared. The system libraries: glibc's (libc, libm,
# libdl, libpthread, librt, the dynamic loader), GCC's runtimes
# (libstdc++ in libstdc++, libgcc_s in libgcc: Arch's split of gcc-libs),
# python's; ONNX Runtime's own (libonnxruntime.so,
# libonnxruntime_providers_shared.so) are onnxruntime-core's.
_ortf_lib_pkg() {
  case ${1%%.so*} in
    libc | libm | libdl | libpthread | librt | ld-linux*) printf 'glibc\n' ;;
    libstdc++) printf 'libstdc++\n' ;;
    libgcc_s) printf 'libgcc\n' ;;
    libpython3*) printf 'python\n' ;;
    libonnxruntime | libonnxruntime_providers_shared) printf 'onnxruntime-core\n' ;;
    libcuda) printf 'nvidia-utils\n' ;;
    libcudart | libcublas | libcublasLt | libcufft | libcurand) printf 'cuda\n' ;;
    libcudnn*) printf 'cudnn\n' ;;
    libnvinfer* | libnvonnxparser) printf '%s\n' "${2:-a TensorRT package}" ;;
    libopenvino*) printf 'openvino\n' ;;
    # Arch's ROCm, under /opt/rocm/lib: MIGraphX's libraries are migraphx's,
    # the HIP runtime is hip-runtime-amd's.
    libmigraphx*) printf 'migraphx\n' ;;
    libamdhip64) printf 'hip-runtime-amd\n' ;;
    # oneTBB's own package (not openvino's, which only depends on it): a
    # provider that links libtbb depends on onetbb itself.
    libtbb*) printf 'onetbb\n' ;;
  esac
}

# _ortf_lib_depends <package> <label> <tensorrt package> [<CUDA major>]
# [<TensorRT version>] [<cuDNN major>] [<libmigraphx_c major>]
# [<libamdhip64 major>]: reads the DT_NEEDED entries of a library of
# <package> on stdin and checks that each one maps (_ortf_lib_pkg) to
# <package> itself or to a package in depends (the caller's array); prints
# the version bounds to add to depends, one per line, from the major
# version in the soname: libcudart.so.N gives cuda>=N and cuda<N+1,
# libcudnn.so.N cudnn's (the CUDA provider has no such NEEDED entry: its cudnn
# bound is the recorded one). TensorRT, openvino, python, migraphx and
# hip-runtime-amd get their bounds from the installed versions prepare()
# recorded instead (_ortf_minor_bounds, _ortf_major_bounds): a soname major
# is too coarse for TensorRT, openvino's soname (libopenvino.so.2641) is no
# package version, and ROCm's sonames outlast its majors (libamdhip64.so.7
# and libmigraphx_c.so.3 in ROCm 7.2 and 10.1 alike). With
# <CUDA major>, a libcudart.so.N must have N equal to it, the major the
# package names carry; with <TensorRT version>, a libnvinfer.so.N must have
# its major, and with <cuDNN major>, a libcudnn.so.N must have N equal to
# it (the one the CUDA package is bounded to, _ortf_check_libs); with
# <libmigraphx_c major> and <libamdhip64 major>, a libmigraphx_c.so.N and a
# libamdhip64.so.N must have the N of the library prepare() found in
# $_ortf_rocm_home/lib (the one the build linked). Returns 1
# with a message on stderr, prefixed <label>, for a
# library mapped to no package, for one whose package is not in depends
# (the library of another engine, such as libnvinfer in the CUDA provider,
# a vendor library in onnxruntime-core, or a system library whose package
# is missing), and for a major other than the recorded one.
#
# The NEEDED gate does not see what a library dlopen()s. libcuda, libnvrtc
# and libcufft (the CUDA provider opens them at run time) are covered by
# nvidia-utils and the cuda bound; cuDNN, which the CUDA provider also
# dlopen()s (the real libonnxruntime_providers_cuda.so has no libcudnn in
# its NEEDED entries), by the bound recorded from the build-time cuDNN
# (ORTF_CUDNN_MAJOR, _ortf_check_libs).
#
# This replaces the earlier design, one package with the vendor runtimes as
# optdepends: a provider package can no longer be installed without its
# vendor libraries, and so silently broken. A vendor upgrade across a
# bound needs a rebuild (pkgrel bump); until then pacman refuses it.
_ortf_lib_depends() {
  local self=$1 label=$2 trt=$3 cuda_major=${4:-} trt_major=${5:-} cudnn_major=${6:-} soname pkg dep major bad=0
  local migraphx_major=${7:-} hip_major=${8:-}
  local -a have=() bounds=()
  trt_major=${trt_major#*:}
  trt_major=${trt_major%%.*}
  for dep in "${depends[@]}"; do have+=("${dep%%[<>=]*}"); done
  while read -r soname; do
    [[ -n $soname ]] || continue
    pkg=$(_ortf_lib_pkg "$soname" "$trt")
    if [[ -z $pkg ]]; then
      echo "$label: $soname is a library no package is known for: map it to its package in _ortf_lib_pkg" >&2
      bad=1
      continue
    fi
    [[ $pkg != "$self" ]] || continue
    if [[ " ${have[*]} " != *" $pkg "* ]]; then
      echo "$label: $soname belongs to $pkg, which is not in the depends of $self (${have[*]})" >&2
      bad=1
      continue
    fi
    major=''
    [[ ! $soname =~ ^lib(cudart|cudnn|nvinfer|migraphx_c|amdhip64)[.]so[.]([0-9]+) ]] || major=${BASH_REMATCH[2]}
    # ROCm: the soname is checked, and gives no bound (the package's
    # version does, _ortf_package_provider).
    if [[ $soname == libmigraphx_c.so* || $soname == libamdhip64.so* ]]; then
      local want=$migraphx_major what=libmigraphx_c key=ORTF_MIGRAPHX_SONAME_MAJOR
      [[ $soname != libamdhip64.so* ]] || want=$hip_major what=libamdhip64 key=ORTF_HIP_SONAME_MAJOR
      if [[ -n $want && $major != "$want" ]]; then
        echo "$label: $soname is not $what.so.$want, the one the build linked ($key)" >&2
        bad=1
      fi
      continue
    fi
    if [[ -n $cuda_major && $soname == libcudart.so.* && $major != "$cuda_major" ]]; then
      echo "$label: $soname is CUDA ${major:-?}, the package names say CUDA $cuda_major (ORTF_CUDA_MAJOR)" >&2
      bad=1
      continue
    fi
    if [[ -n $cudnn_major && $soname == libcudnn.so.* && $major != "$cudnn_major" ]]; then
      echo "$label: $soname is cuDNN ${major:-?}, the build used cuDNN $cudnn_major (ORTF_CUDNN_MAJOR)" >&2
      bad=1
      continue
    fi
    if [[ $soname == libnvinfer.so.* ]]; then
      if [[ -n $trt_major && $major != "$trt_major" ]]; then
        echo "$label: $soname is TensorRT ${major:-?}, the installed $trt is TensorRT $trt_major (ORTF_TENSORRT_VERSION)" >&2
        bad=1
      fi
      continue
    fi
    if [[ -n $major ]]; then
      bounds+=("$pkg>=$major" "$pkg<$((major + 1))")
    fi
  done
  ((bad == 0)) || return 1
  ((${#bounds[@]} == 0)) || printf '%s\n' "${bounds[@]}"
}

# _ortf_minor_bounds <name> <version>: prints the dependencies that hold
# <name> to the major.minor of <version> ([epoch:]A.B[...][-pkgrel]), one
# per line: 11.4.0.106 gives <name>>=11.4 and <name><11.5, 2026.4.1-1
# <name>>=2026.4 and <name><2026.5 (pacman's vercmp orders 11.4.0.106
# between the two). Returns 1 with a message on stderr when <version> has
# no numeric major.minor.
_ortf_minor_bounds() {
  local name=$1 v=$2 epoch=''
  if [[ $v == *:* ]]; then epoch=${v%%:*}: v=${v#*:}; fi
  if [[ ! $v =~ ^([0-9]+)[.]([0-9]+)([.+_-]|$) ]]; then
    echo "$name: version '$2' has no numeric major.minor to bound the dependency with" >&2
    return 1
  fi
  printf '%s\n' "$name>=$epoch${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" \
    "$name<$epoch${BASH_REMATCH[1]}.$((10#${BASH_REMATCH[2]} + 1))"
}

# _ortf_major_bounds <name> <version>: prints the dependencies that hold
# <name> to the major of <version> ([epoch:]A[.B...][-pkgrel]), one per
# line: 7.2.3-7 gives <name>>=7 and <name><8, 10.1-1 <name>>=10 and
# <name><11 (pacman's vercmp orders 7.2.3-7 between the two). Returns 1
# with a message on stderr when <version> has no numeric major.
_ortf_major_bounds() {
  local name=$1 v=$2 epoch=''
  if [[ $v == *:* ]]; then epoch=${v%%:*}: v=${v#*:}; fi
  if [[ ! $v =~ ^([0-9]+)([.+_-]|$) ]]; then
    echo "$name: version '$2' has no numeric major to bound the dependency with" >&2
    return 1
  fi
  printf '%s\n' "$name>=$epoch${BASH_REMATCH[1]}" "$name<$epoch$((10#${BASH_REMATCH[1]} + 1))"
}

# _ortf_rocm_soname_major <library>: prints the soname major N of
# $_ortf_rocm_home/lib/<library>.so.N, the library the MIGraphX provider
# links (libmigraphx_c, libamdhip64), from the file names there (each
# library's runtime link, .so.N, and its .so.N.M... files, whose N counts
# too). Returns 1 with a
# message on stderr when there is none, or more than one major.
_ortf_rocm_soname_major() {
  local f n found=''
  for f in "$_ortf_rocm_home/lib/$1".so.*; do
    [[ -e $f || -L $f ]] || continue
    # .so.N and .so.N.x.y alike: a stale .so.6.x.y without its .so.6 link
    # still counts as a ROCm there.
    if [[ ${f##*/} =~ ^$1[.]so[.]([0-9]+)([.].*)?$ ]]; then
      n=${BASH_REMATCH[1]}
      if [[ -n $found && $found != "$n" ]]; then
        echo "migraphx: $_ortf_rocm_home/lib has $1.so.$found and $1.so.$n: one ROCm, please" >&2
        return 1
      fi
      found=$n
    fi
  done
  if [[ -z $found ]]; then
    echo "migraphx: no $_ortf_rocm_home/lib/$1.so.N (install migraphx and hip-runtime-amd)" >&2
    return 1
  fi
  printf '%s\n' "$found"
}

# _ortf_tensorrt_version <NvInferVersion.h>: prints the TensorRT version
# (major.minor.patch.build) the header defines. TensorRT 10 and 11 define
# TRT_MAJOR_ENTERPRISE, ... and NV_TENSORRT_MAJOR as that name; older
# releases define NV_TENSORRT_MAJOR ... as numbers. Returns 1 with a message
# on stderr when the header is missing or gives no numeric major and minor.
_ortf_tensorrt_version() {
  local line k v part val ref
  local -A defs=()
  if [[ ! -f $1 ]]; then
    echo "tensorrt: $1 not found (the TensorRT headers give the version the provider package is bounded to)" >&2
    return 1
  fi
  while read -r line; do
    if [[ $line =~ ^#[[:space:]]*define[[:space:]]+([A-Z_]+)[[:space:]]+([A-Za-z0-9_]+) ]]; then
      k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
      defs[$k]=$v
    fi
  done <"$1"
  local -a nums=()
  for part in MAJOR MINOR PATCH BUILD; do
    val=${defs[NV_TENSORRT_$part]:-}
    # One step of indirection: NV_TENSORRT_MAJOR TRT_MAJOR_ENTERPRISE.
    if [[ -n $val && ! $val =~ ^[0-9]+$ ]]; then ref=$val val=${defs[$ref]:-}; fi
    if [[ $val =~ ^[0-9]+$ ]]; then
      nums+=("$val")
    else
      break
    fi
  done
  if ((${#nums[@]} < 2)); then
    echo "tensorrt: $1 gives no numeric NV_TENSORRT_MAJOR and NV_TENSORRT_MINOR" >&2
    return 1
  fi
  local IFS=.
  printf '%s\n' "${nums[*]}"
}

# _ortf_installed_version <name>: prints the version of the installed
# package that is or provides <name> (pacman -Qi, read-only): its own
# version for its own name, the provided version for a provided one
# (openvino-git 2026.5.0.r1-1 provides openvino=2026.5.0). Returns 1 when no installed package
# is or provides <name>, 2 when one provides it without a version, which a
# versioned dependency cannot be met by.
_ortf_installed_version() {
  local info line key='' val name='' version='' provides='' p
  local -a words
  info=$(LC_ALL=C pacman -Qi -- "$1" 2>/dev/null) || return 1
  while IFS= read -r line; do
    if [[ $line =~ ^([A-Z][A-Za-z\ ]*[a-z])\ *:\ ?(.*)$ ]]; then
      key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
    elif [[ $line == ' '* ]]; then
      val=$line
    else
      key='' val=''
    fi
    case $key in
      Name) name=$val ;;
      Version) version=$val ;;
      Provides) [[ $val == None ]] || provides+=" $val" ;;
    esac
  done <<<"$info"
  if [[ $name == "$1" && -n $version ]]; then
    printf '%s\n' "$version"
    return 0
  fi
  read -ra words <<<"$provides"
  for p in "${words[@]}"; do
    if [[ $p == "$1="* ]]; then
      printf '%s\n' "${p#*=}"
      return 0
    fi
    [[ $p != "$1" ]] || return 2
  done
  return 1
}

# _ortf_pick <name> <default> [<variable>]: sets _ortf_val to the
# environment variable <name> when it is set and not empty, else to
# <default>, and _ortf_src to where the value came from: environment,
# default, or, with <variable> (the PKGBUILD's _ortf_default_* line the
# default is from, which a copy may have changed), "PKGBUILD default,
# <variable>".
# The caller declares both local.
_ortf_pick() {
  if [[ -n ${!1:-} ]]; then
    _ortf_val=${!1} _ortf_src=environment
  elif [[ -n ${3:-} ]]; then
    _ortf_val=$2 _ortf_src="PKGBUILD default, $3"
  else
    _ortf_val=$2 _ortf_src=default
  fi
}

# _ortf_jobs: prints the job count of -jN, -j N, --jobs=N or --jobs N in
# MAKEFLAGS (the last one wins), nothing when there is none.
_ortf_jobs() {
  local -a words
  local i n=''
  read -ra words <<<"${MAKEFLAGS:-}"
  for ((i = 0; i < ${#words[@]}; i++)); do
    case ${words[i]} in
      -j | --jobs) n=${words[i + 1]:-} ;;
      --jobs=*) n=${words[i]#--jobs=} ;;
      -j*) n=${words[i]#-j} ;;
    esac
  done
  if [[ $n =~ ^[1-9][0-9]*$ ]]; then printf '%s\n' "$n"; fi
  return 0
}

# _ortf_resolve <file>: resolves, checks and prints the build inputs, and
# writes them to <file> as KEY=value lines. Returns 1 with a message on
# stderr when one is not usable.
_ortf_resolve() {
  local out=$1 _ortf_val _ortf_src w
  local -a words lines=()
  local cpu=0 cuda=0 trt=0 ov=0 mgx=0 eps archs='' python=0 python_exe='' nvcc_threads ccache='' jobs
  local trt_home='' trt_libdir='' host_cxx='' cuda_major='' cudnn_major='' cudnn_src nvcc_out cudnn_version
  local trt_version='' trt_installed='' ov_version='' python_version='' bounds rc
  local mgx_version='' hip_version='' mgx_soname='' hip_soname='' cudnn_minor=''

  case $_ortf_line in
    main) ;;
    cuda12) lines+=("line cuda12 (_ortf_line): the CUDA 12 legacy CUDA package alone, for the main line's onnxruntime-core") ;;
    *) echo "_ortf_line: '$_ortf_line' is neither main nor cuda12" >&2; return 1 ;;
  esac

  _ortf_pick ORTF_EPS "$_ortf_default_eps" _ortf_default_eps
  read -ra words <<<"${_ortf_val//,/ }"
  if ((${#words[@]} == 0)); then
    echo "ORTF_EPS: empty; give cpu, or some of cuda, tensorrt, openvino, migraphx" >&2
    return 1
  fi
  for w in "${words[@]}"; do
    case $w in
      cpu) cpu=1 ;;
      cuda) cuda=1 ;;
      tensorrt) trt=1 ;;
      openvino) ov=1 ;;
      # Alone or with the others: nothing in ONNX Runtime's CMake excludes
      # the combination (untested together, and on AMD hardware).
      migraphx) mgx=1 ;;
      *) echo "ORTF_EPS: unknown provider '$w' (known: cpu, cuda, tensorrt, openvino, migraphx)" >&2; return 1 ;;
    esac
  done
  if ((cpu && cuda + trt + ov + mgx > 0)); then
    echo "ORTF_EPS: cpu stands alone (the CPU provider is always built); drop it or the others" >&2
    return 1
  fi
  if ((trt && !cuda)); then
    echo "ORTF_EPS: tensorrt needs cuda" >&2
    return 1
  fi
  eps=''
  ((cpu)) && eps=cpu
  ((cuda)) && eps+=' cuda'
  ((trt)) && eps+=' tensorrt'
  ((ov)) && eps+=' openvino'
  ((mgx)) && eps+=' migraphx'
  eps=${eps# }
  # The cuda12 line has one package, the CUDA one: another provider would
  # be built for no package.
  if [[ $_ortf_line == cuda12 && $eps != cuda ]]; then
    echo "ORTF_EPS: '$eps': the cuda12 line (_ortf_line) builds cuda alone, its one package" >&2
    return 1
  fi
  lines+=("ORTF_EPS=$eps ($_ortf_src)")

  _ortf_pick ORTF_CUDA_ARCHS "$_ortf_default_cuda_archs" _ortf_default_cuda_archs
  read -ra words <<<"${_ortf_val//[,;]/ }"
  local virtual='' preset='' list
  # A preset stands alone and expands to its list, which is what is
  # checked and recorded (with the preset's name, for the package name).
  for w in "${words[@]}"; do
    if list=$(_ortf_cuda_preset "$w"); then
      if ((${#words[@]} != 1)); then
        echo "ORTF_CUDA_ARCHS: the preset '$w' stands alone: give it or a list of architectures, not both" >&2
        return 1
      fi
      preset=$w
      read -ra words <<<"$list"
      break
    fi
  done
  for w in "${words[@]}"; do
    w=${w#sm_}
    w=${w#sm}
    # ONNX Runtime keeps a bare 120a or 120f as such, and enables its
    # SM120-only kernels only when the list has a bare 120 (its
    # cmake/external/cuda_configuration.cmake and
    # onnxruntime_providers_cuda.cmake): a suffix would silently drop them.
    if [[ $w =~ ^[1-9][0-9]{1,2}[af](-real|-virtual)?$ ]]; then
      echo "ORTF_CUDA_ARCHS: '$w': give ${w%%[af]*} without the a/f suffix (ONNX Runtime adds the a itself: 120 -> 120a-real)" >&2
      return 1
    fi
    if [[ ! $w =~ ^[1-9][0-9]{1,2}(-real|-virtual)?$ ]]; then
      echo "ORTF_CUDA_ARCHS: '$w' is not a CUDA architecture such as 120, sm_120 or 120-virtual, nor a preset (${_ortf_cuda_presets// /, })" >&2
      return 1
    fi
    # ONNX Runtime keeps only the last -virtual entry.
    if [[ $w == *-virtual ]]; then
      if [[ -n $virtual ]]; then
        echo "ORTF_CUDA_ARCHS: '$virtual' and '$w': ONNX Runtime embeds PTX for one -virtual architecture only" >&2
        return 1
      fi
      virtual=$w
    fi
    archs+=";$w"
  done
  archs=${archs#;}
  if [[ -z $archs ]]; then
    echo "ORTF_CUDA_ARCHS: empty" >&2
    return 1
  fi
  w=$archs
  [[ -z $preset ]] || w="$preset: $archs"
  if ((cuda)); then
    lines+=("ORTF_CUDA_ARCHS=$w ($_ortf_src)")
  else
    lines+=("ORTF_CUDA_ARCHS=$w ($_ortf_src; unused without cuda)")
  fi

  _ortf_pick ORTF_NVCC_THREADS 1
  if [[ ! $_ortf_val =~ ^[1-9][0-9]*$ ]]; then
    echo "ORTF_NVCC_THREADS: '$_ortf_val' is not a positive number" >&2
    return 1
  fi
  nvcc_threads=$_ortf_val
  lines+=("ORTF_NVCC_THREADS=$nvcc_threads ($_ortf_src)")

  # A portable x86-64 package: no flags for the building CPU only. Arch's
  # makepkg.conf has -march=x86-64 -mtune=generic; -march=x86-64-vN is the
  # builder's choice (the package then needs such a CPU). MLAS, the CPU
  # provider's kernels, picks AVX2 or AVX-512 code at run time, so the
  # generic baseline loses nothing there.
  local flags march=''
  for flags in CFLAGS CXXFLAGS; do
    read -ra words <<<"${!flags:-}"
    for w in "${words[@]}"; do
      case $w in
        -march=native | -mtune=native)
          echo "$flags: $w builds for this machine's CPU only: use -march=x86-64 (or x86-64-v2/v3/v4) and -mtune=generic in /etc/makepkg.conf or ~/.makepkg.conf" >&2
          return 1
          ;;
        -march=*) march=${w#-march=} ;;
      esac
    done
  done
  lines+=("CPU baseline: -march=${march:-compiler default} (CFLAGS, CXXFLAGS)")

  if ((cuda)); then
    if [[ ! -x $_ortf_cuda_home/bin/nvcc ]]; then
      echo "cuda: $_ortf_cuda_home/bin/nvcc not found (install cuda)" >&2
      return 1
    fi
    # The CUDA major names the CUDA and TensorRT packages (read from
    # cuda.h when makepkg sources this file): nvcc, which compiles, must be
    # of the same one.
    if ! cuda_major=$(_ortf_cuda_header_major "$_ortf_cuda_home"); then
      echo "cuda: no '#define CUDA_VERSION' in $_ortf_cuda_home/include/cuda.h (install cuda)" >&2
      return 1
    fi
    nvcc_out=$("$_ortf_cuda_home/bin/nvcc" --version 2>&1) || true
    if [[ ! $nvcc_out =~ release\ ([0-9]+)[.]([0-9]+), ]]; then
      echo "cuda: $_ortf_cuda_home/bin/nvcc --version prints no 'release N.M,' line: $nvcc_out" >&2
      return 1
    fi
    if [[ ${BASH_REMATCH[1]} != "$cuda_major" ]]; then
      echo "cuda: $_ortf_cuda_home/bin/nvcc is CUDA ${BASH_REMATCH[1]}.${BASH_REMATCH[2]}, $_ortf_cuda_home/include/cuda.h CUDA $cuda_major: one CUDA toolkit, please" >&2
      return 1
    fi
    lines+=("CUDA ${BASH_REMATCH[1]}.${BASH_REMATCH[2]} ($_ortf_cuda_home: nvcc and include/cuda.h; packages named -cuda$cuda_major)")
    # The cuda12 line is CUDA 12's: its names, depends and preset are.
    if [[ $_ortf_line == cuda12 && $cuda_major != 12 ]]; then
      echo "cuda: $_ortf_cuda_home is CUDA $cuda_major; the cuda12 line (_ortf_line) builds with CUDA 12 only (AUR cuda-12.9)" >&2
      return 1
    fi
    # A preset is for the CUDA major its architectures need
    # (_ortf_cuda_preset_major).
    if [[ -n $preset ]] && ! w=$(_ortf_cuda_preset_major "$preset" "$cuda_major"); then
      echo "ORTF_CUDA_ARCHS: the preset '$preset' needs $w, $_ortf_cuda_home is CUDA $cuda_major" >&2
      return 1
    fi
    if [[ ! -f $_ortf_cudnn_home/include/cudnn.h ]]; then
      echo "cuda: $_ortf_cudnn_home/include/cudnn.h not found (install cudnn)" >&2
      return 1
    fi
    # The cuDNN major the CUDA and TensorRT packages are bounded to: the
    # CUDA provider dlopen()s cuDNN (no DT_NEEDED for it, so the NEEDED
    # check cannot bound it), so it is recorded here, from the header the
    # build compiles against, else from the installed cudnn package. Its
    # minor, from the same source, bounds the cuda12 line's CUDA package:
    # cuDNN 9.11 dropped Maxwell, Pascal and Volta, so a bound on the major
    # would let pacman install a cuDNN the legacy cards cannot run.
    if cudnn_major=$(_ortf_cudnn_header_major "$_ortf_cudnn_home"); then
      cudnn_src="$_ortf_cudnn_home/include/cudnn_version.h"
      cudnn_minor=$(_ortf_cudnn_header_minor "$_ortf_cudnn_home") || cudnn_minor=''
    elif cudnn_version=$(_ortf_installed_version cudnn) && [[ ${cudnn_version#*:} =~ ^([0-9]+)[.](([0-9]+)([^0-9]|$))? ]]; then
      cudnn_major=${BASH_REMATCH[1]} cudnn_minor=${BASH_REMATCH[3]} cudnn_src="installed cudnn $cudnn_version"
      [[ -z $cudnn_minor ]] || cudnn_minor=$((10#$cudnn_minor))
    else
      echo "cuda: no CUDNN_MAJOR in $_ortf_cudnn_home/include/cudnn_version.h and no installed cudnn version (pacman -Q cudnn): the cuDNN bound of the CUDA package has no source" >&2
      return 1
    fi
    if [[ $_ortf_line == cuda12 ]]; then
      if [[ -z $cudnn_minor ]]; then
        echo "cuda: no cuDNN minor version in $cudnn_src: the cuda12 line bounds its CUDA package to the cuDNN major.minor" >&2
        return 1
      fi
      # cuDNN 9.11 dropped Maxwell, Pascal and Volta: this line takes 9.10.
      if ((cudnn_major != 9 || cudnn_minor != 10)); then
        echo "cuda: the CUDA 12 legacy line needs cuDNN 9.10 (found $cudnn_major.$cudnn_minor): cuDNN 9.11 dropped Maxwell, Pascal and Volta" >&2
        return 1
      fi
      lines+=("cuDNN $cudnn_major.$cudnn_minor ($cudnn_src, so cudnn>=$cudnn_major.$cudnn_minor cudnn<$cudnn_major.$((cudnn_minor + 1)))")
    else
      lines+=("cuDNN $cudnn_major ($cudnn_src, so cudnn>=$cudnn_major cudnn<$((cudnn_major + 1)))")
    fi
    # nvcc's host compiler, as the cuda package sets it for login shells.
    if [[ -n ${NVCC_CCBIN:-} ]]; then
      host_cxx=$NVCC_CCBIN _ortf_src=environment
    elif [[ -r $_ortf_cuda_profile ]] &&
      host_cxx=$(sed -n "s/^export NVCC_CCBIN='\([^']*\)'\$/\1/p" "$_ortf_cuda_profile") && [[ -n $host_cxx ]]; then
      _ortf_src=$_ortf_cuda_profile
    else
      host_cxx=/usr/bin/g++ _ortf_src=default
    fi
    lines+=("NVCC_CCBIN=$host_cxx ($_ortf_src; also the C++ compiler)")
  fi

  if ((trt)); then
    _ortf_pick ORTF_TENSORRT_HOME ''
    if [[ -n $_ortf_val ]]; then
      trt_home=$_ortf_val
    elif [[ -f $_ortf_tensorrt_default/include/NvInfer.h ]]; then
      trt_home=$_ortf_tensorrt_default _ortf_src="found $_ortf_tensorrt_default/include/NvInfer.h"
    else
      trt_home=$_ortf_tensorrt_usr _ortf_src="default: no $_ortf_tensorrt_default/include/NvInfer.h"
    fi
    if [[ $trt_home != /* ]]; then
      echo "ORTF_TENSORRT_HOME: '$trt_home' is not an absolute path" >&2
      return 1
    fi
    trt_home=${trt_home%/}
    [[ -n $trt_home ]] || trt_home=/
    if [[ ! -f $trt_home/include/NvInfer.h ]]; then
      echo "tensorrt: $trt_home/include/NvInfer.h not found (install TensorRT, or set ORTF_TENSORRT_HOME)" >&2
      return 1
    fi
    for w in lib lib64; do
      if compgen -G "$trt_home/$w/libnvinfer.so*" >/dev/null; then
        trt_libdir=$trt_home/$w
        break
      fi
    done
    if [[ -z $trt_libdir ]]; then
      echo "tensorrt: no libnvinfer.so under $trt_home/lib or $trt_home/lib64" >&2
      return 1
    fi
    lines+=("ORTF_TENSORRT_HOME=$trt_home ($_ortf_src; libraries in $trt_libdir)")
    # The TensorRT provider package depends on tensorrt, bounded to the
    # major.minor of the headers it is built with (an ABI boundary for
    # TensorRT): the AUR's tensorrt and nvidia-tensorrt-sdk-local both
    # provide that name. The version is read from the headers, not from a
    # package, so a TensorRT that is not installed as a package builds too;
    # the dependency is only met at install time, hence just a warning.
    trt_version=$(_ortf_tensorrt_version "$trt_home/include/NvInferVersion.h") || return 1
    bounds=$(_ortf_minor_bounds tensorrt "$trt_version") || return 1
    lines+=("ORTF_TENSORRT_VERSION=$trt_version ($trt_home/include/NvInferVersion.h, so ${bounds//$'\n'/ })")
    # Read-only: pacman -T prints the dependencies no installed package
    # satisfies (exit 127).
    if ! pacman -T -- tensorrt >/dev/null 2>&1; then
      echo "warning: tensorrt: no installed package is or provides tensorrt, which the TensorRT provider package depends on: update nvidia-tensorrt-sdk-local or install the AUR tensorrt before installing the provider package" >&2
    elif trt_installed=$(_ortf_installed_version tensorrt) &&
      [[ $trt_installed =~ ^([0-9]+)[.]([0-9]+) && $trt_version. != "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}."* ]]; then
      echo "warning: tensorrt: the installed tensorrt is $trt_installed, the headers in $trt_home are TensorRT $trt_version: the provider package will not install against the former" >&2
    fi
  fi

  if ((ov)); then
    if ! compgen -G "$_ortf_openvino_cmake_dir/openvino*/OpenVINOConfig.cmake" >/dev/null; then
      echo "openvino: no $_ortf_openvino_cmake_dir/openvino*/OpenVINOConfig.cmake (install openvino)" >&2
      return 1
    fi
    # The OpenVINO provider depends on the year.minor of the openvino it was
    # built with (its soname, libopenvino.so.2641, changes with each).
    if ! ov_version=$(_ortf_installed_version openvino) || [[ -z $ov_version ]]; then
      echo "openvino: no version recorded for openvino (pacman -Qi openvino gives none), which bounds the OpenVINO provider package's dependency: install Arch's openvino" >&2
      return 1
    fi
    bounds=$(_ortf_minor_bounds openvino "$ov_version") || return 1
    lines+=("openvino $ov_version (installed, so ${bounds//$'\n'/ })")
  fi

  if ((mgx)); then
    # The CMake packages the provider's find_package(hip) and
    # find_package(migraphx) look for under the ROCm root.
    for w in migraphx hip; do
      if [[ ! -f $_ortf_rocm_home/lib/cmake/$w/$w-config.cmake && ! -f $_ortf_rocm_home/lib/cmake/$w/${w}Config.cmake ]]; then
        echo "migraphx: no $_ortf_rocm_home/lib/cmake/$w/$w-config.cmake (install migraphx and hip-runtime-amd)" >&2
        return 1
      fi
    done
    # The MIGraphX provider depends on the major of the migraphx and
    # hip-runtime-amd it was built with: the package versions, as the
    # sonames stay across ROCm majors (libamdhip64.so.7 in ROCm 7.2 and
    # 10.1). The sonames found here are what package() checks the
    # provider's NEEDED entries against.
    if ! mgx_version=$(_ortf_installed_version migraphx) || [[ -z $mgx_version ]]; then
      echo "migraphx: no version recorded for migraphx (pacman -Qi migraphx gives none), which bounds the MIGraphX provider package's dependency: install migraphx and hip-runtime-amd" >&2
      return 1
    fi
    if ! hip_version=$(_ortf_installed_version hip-runtime-amd) || [[ -z $hip_version ]]; then
      echo "migraphx: no version recorded for hip-runtime-amd (pacman -Qi hip-runtime-amd gives none), which bounds the MIGraphX provider package's dependency: install migraphx and hip-runtime-amd" >&2
      return 1
    fi
    mgx_soname=$(_ortf_rocm_soname_major libmigraphx_c) || return 1
    hip_soname=$(_ortf_rocm_soname_major libamdhip64) || return 1
    bounds=$(_ortf_major_bounds migraphx "$mgx_version") || return 1
    w=$(_ortf_major_bounds hip-runtime-amd "$hip_version") || return 1
    bounds+=$'\n'$w
    lines+=("migraphx $mgx_version, hip-runtime-amd $hip_version (installed; $_ortf_rocm_home/lib: libmigraphx_c.so.$mgx_soname, libamdhip64.so.$hip_soname; so ${bounds//$'\n'/ })")
  fi

  _ortf_pick ORTF_PYTHON "$_ortf_default_python" _ortf_default_python
  case $_ortf_val in
    0 | 1) python=$_ortf_val ;;
    *) echo "ORTF_PYTHON: '$_ortf_val' is neither 0 nor 1" >&2; return 1 ;;
  esac
  # The main line's python-onnxruntime-core serves the cuda12 line too (its
  # module links no CUDA library).
  if [[ $_ortf_line == cuda12 ]] && ((python)); then
    echo "ORTF_PYTHON=1: the cuda12 line (_ortf_line) has no Python package; give ORTF_PYTHON=0" >&2
    return 1
  fi
  if ((python)); then
    if ! python_exe=$(command -v python); then
      echo "ORTF_PYTHON=1: no python on PATH" >&2
      return 1
    fi
    # The module is built for this python's minor version (its ABI), and
    # the Python package depends on that minor.
    python_version=$("$python_exe" -I -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null) || python_version=''
    if [[ ! $python_version =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
      echo "ORTF_PYTHON=1: no version recorded for $python_exe (it printed '$python_version'), which bounds the Python package's dependency on python" >&2
      return 1
    fi
    bounds=$(_ortf_minor_bounds python "$python_version") || return 1
    lines+=("ORTF_PYTHON=1 ($_ortf_src; $python_exe, Python $python_version, so ${bounds//$'\n'/ })")
    [[ $python_exe == /usr/bin/python ]] ||
      lines+=("  warning: $python_exe is not /usr/bin/python: the Python package is for recipe checks only")
  else
    lines+=("ORTF_PYTHON=0 ($_ortf_src; no python-onnxruntime-core)")
  fi

  _ortf_pick ORTF_CCACHE auto
  case $_ortf_val in
    auto) ccache=$(command -v ccache || true) ;;
    1)
      if ! ccache=$(command -v ccache); then
        echo "ORTF_CCACHE=1: ccache is not on PATH" >&2
        return 1
      fi
      ;;
    0) ccache='' ;;
    *) echo "ORTF_CCACHE: '$_ortf_val' is not auto, 0 or 1" >&2; return 1 ;;
  esac
  lines+=("ORTF_CCACHE=$_ortf_val ($_ortf_src; ${ccache:-ccache not used})")

  jobs=$(_ortf_jobs)
  lines+=("jobs=${jobs:-ninja default, nproc+2} (MAKEFLAGS=${MAKEFLAGS:-})")

  printf '  %s\n' "${lines[@]}"
  {
    printf 'ORTF_EPS=%s\n' "$eps"
    printf 'ORTF_CUDA_ARCHS=%s\n' "$archs"
    printf 'ORTF_CUDA_PRESET=%s\n' "$preset"
    printf 'ORTF_CUDA_MAJOR=%s\n' "$cuda_major"
    printf 'ORTF_CUDNN_MAJOR=%s\n' "$cudnn_major"
    printf 'ORTF_CUDNN_MINOR=%s\n' "$cudnn_minor"
    printf 'ORTF_NVCC_THREADS=%s\n' "$nvcc_threads"
    printf 'ORTF_TENSORRT_HOME=%s\n' "$trt_home"
    printf 'ORTF_TENSORRT_LIBDIR=%s\n' "$trt_libdir"
    printf 'ORTF_TENSORRT_VERSION=%s\n' "$trt_version"
    printf 'ORTF_OPENVINO_VERSION=%s\n' "$ov_version"
    printf 'ORTF_MIGRAPHX_VERSION=%s\n' "$mgx_version"
    printf 'ORTF_HIP_VERSION=%s\n' "$hip_version"
    printf 'ORTF_MIGRAPHX_SONAME_MAJOR=%s\n' "$mgx_soname"
    printf 'ORTF_HIP_SONAME_MAJOR=%s\n' "$hip_soname"
    printf 'ORTF_PYTHON=%s\n' "$python"
    printf 'ORTF_PYTHON_EXE=%s\n' "$python_exe"
    printf 'ORTF_PYTHON_VERSION=%s\n' "$python_version"
    printf 'ORTF_CCACHE=%s\n' "$ccache"
    printf 'ORTF_JOBS=%s\n' "$jobs"
    printf 'NVCC_CCBIN=%s\n' "$host_cxx"
  } >"$out.tmp" && mv -f -- "$out.tmp" "$out"
}

# _ortf_get <key>: prints the value prepare() recorded for <key>.
_ortf_get() {
  local key value
  while IFS='=' read -r key value; do
    if [[ $key == "$1" ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done <"$srcdir/ortf.conf"
  echo "ortf.conf: no $1 (run makepkg without -e, so that prepare() runs)" >&2
  return 1
}

# _ortf_has <provider>: whether ORTF_EPS, as recorded, has <provider>.
_ortf_has() {
  local eps
  eps=$(_ortf_get ORTF_EPS) || return 2
  [[ " $eps " == *" $1 "* ]]
}

# _ortf_check_names: the package names makepkg runs for (from the
# environment, _ortf_pkgname) are those the build inputs prepare() recorded
# make. They differ when `makepkg -e` or `-R` runs with another environment
# than the build's, or after the CUDA toolkit changed major; makepkg would
# then write packages named for inputs the build did not have.
_ortf_check_names() {
  local eps archs preset python major want
  eps=$(_ortf_get ORTF_EPS) || return 1
  archs=$(_ortf_get ORTF_CUDA_ARCHS) || return 1
  # A preset's name, not its list, is what names the CUDA package.
  preset=$(_ortf_get ORTF_CUDA_PRESET) || return 1
  [[ -z $preset ]] || archs=$preset
  python=$(_ortf_get ORTF_PYTHON) || return 1
  # Empty without cuda: no name then carries it.
  major=$(_ortf_get ORTF_CUDA_MAJOR) || return 1
  want=$(_ortf_pkgnames "$eps" "$archs" "$python" "${major:-$_ortf_cuda_major}")
  if [[ $want != "${_ortf_pkgname[*]}" ]]; then
    echo "makepkg runs for: ${_ortf_pkgname[*]}" >&2
    echo "the build was made for: $want" >&2
    if [[ -n $major && $major != "$_ortf_cuda_major" ]]; then
      if ((_ortf_cuda_header_found)); then
        echo "the build used CUDA $major, $_ortf_cuda_home/include/cuda.h is now CUDA $_ortf_cuda_major: build anew (makepkg without -e/-R)" >&2
      else
        echo "the build used CUDA $major, $_ortf_cuda_home/include/cuda.h is absent so the names use _ortf_cuda_major_default ($_ortf_cuda_major_default): build anew (makepkg without -e/-R)" >&2
      fi
    else
      echo "run makepkg with ORTF_EPS='$eps' ORTF_CUDA_ARCHS='$archs' ORTF_PYTHON=$python, the inputs src/ortf.conf records (or without -e/-R, to build anew)" >&2
    fi
    return 1
  fi
}

# _ortf_needed <file>: prints the DT_NEEDED entries of an ELF file.
_ortf_needed() {
  readelf -d -- "$1" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p'
}

# _ortf_py_site <python>: prints the site-packages directory for extension
# modules (platlib) of the /usr prefix, as <python> computes it: its own
# version in the path, never its own prefix, so a virtual environment's
# python gives the same directory as /usr/bin/python of that version.
_ortf_py_site() {
  "$1" -I -c 'import sysconfig
print(sysconfig.get_path("platlib", "posix_prefix", {"base": "/usr", "platbase": "/usr"}))'
}

# _ortf_check_tools: the tools the build runs, checked early (makepkg -d
# skips the dependency check).
_ortf_check_tools() {
  local tool missing=()
  local -a tools=(cmake ninja git patch readelf)
  # patchelf gives the TensorRT provider its RUNPATH.
  ! _ortf_has tensorrt || tools+=(patchelf)
  for tool in "${tools[@]}"; do
    command -v "$tool" >/dev/null || missing+=("$tool")
  done
  if ((${#missing[@]} > 0)); then
    echo "missing tools: ${missing[*]}" >&2
    return 1
  fi
  if [[ $(_ortf_get ORTF_PYTHON) == 1 ]] &&
    ! "$(_ortf_get ORTF_PYTHON_EXE)" -c 'import numpy, build, installer, setuptools, wheel' 2>/dev/null; then
    echo "ORTF_PYTHON=1: the python on PATH lacks numpy, build, installer, setuptools or wheel" >&2
    return 1
  fi
  if [[ $(_ortf_get ORTF_PYTHON) == 1 ]]; then
    # The module is built for the build python's version and installed into
    # the system python's site-packages: they must be the same.
    local build_site system_site
    build_site=$(_ortf_py_site "$(_ortf_get ORTF_PYTHON_EXE)") || return 1
    if ! system_site=$(_ortf_py_site "$_ortf_system_python"); then
      echo "ORTF_PYTHON=1: $_ortf_system_python does not run (install python)" >&2
      return 1
    fi
    if [[ $build_site != "$system_site" ]]; then
      echo "ORTF_PYTHON=1: the python on PATH installs to $build_site, $_ortf_system_python to $system_site: use a python of the system's version" >&2
      return 1
    fi
  fi
}

# _ortf_mirror <deps.txt> <mirror>: lays the downloaded dependency archives
# out as the local mirror ONNX Runtime looks in (<mirror>/<URL without
# https://>), after checking each one's URL and SHA-1 against <deps.txt>.
_ortf_mirror() {
  local deps=$1 mirror=$2 name entry url='' line dep_url dep_sha1 file got
  rm -rf -- "$mirror"
  for name in "${_ortf_deps[@]}"; do
    url=''
    for entry in "${source[@]}"; do
      if [[ $entry == "ortf-dep-$name.zip::"* ]]; then
        url=${entry#*::}
      fi
    done
    if [[ -z $url ]]; then
      echo "source=(): no ortf-dep-$name.zip" >&2
      return 1
    fi
    if ! line=$(grep -m1 "^$name;" -- "$deps"); then
      echo "cmake/deps.txt has no $name: update _ortf_deps and source=()" >&2
      return 1
    fi
    IFS=';' read -r _ dep_url dep_sha1 <<<"$line"
    if [[ $dep_url != "$url" ]]; then
      echo "$name: cmake/deps.txt pins $dep_url, source=() has $url" >&2
      return 1
    fi
    file=$srcdir/ortf-dep-$name.zip
    got=$(sha1sum -- "$file" | cut -d' ' -f1)
    if [[ $got != "$dep_sha1" ]]; then
      echo "$name: SHA-1 $got, cmake/deps.txt expects $dep_sha1" >&2
      return 1
    fi
    install -d -- "$mirror/$(dirname -- "${url#https://}")"
    ln -s -- "$(realpath -- "$file")" "$mirror/${url#https://}"
  done
}

prepare() {
  echo "ONNX Runtime build inputs:"
  _ortf_resolve "$srcdir/ortf.conf" || return 1
  _ortf_check_tools || return 1
  # The recorded values are the environment's, canonical: they give the
  # same names (a check of the two name functions against each other).
  _ortf_check_names || return 1
  echo "packages: ${_ortf_pkgname[*]}"

  cd "$srcdir/onnxruntime"
  local head
  head=$(git rev-parse HEAD)
  if [[ $head != "$_ortf_commit" ]]; then
    echo "tag v$pkgver is commit $head, not $_ortf_commit: the tag moved; check it and update _ortf_commit" >&2
    return 1
  fi
  # The checkout as tagged: build() copies the Python package tree the
  # build assembled into onnxruntime/ and setup.py leaves build/ and
  # *.egg-info, untracked files that would survive into the next build in
  # this BUILDDIR (makepkg resets tracked files only) and enter its wheel.
  git clean -ffdxq
  _ortf_mirror cmake/deps.txt "$srcdir/deps-mirror" || return 1
  echo "dependency mirror: ${#_ortf_deps[@]} archives checked against cmake/deps.txt"
  # A fresh CMake build directory, so that a cache from other build inputs
  # is never reused (makepkg -e skips prepare() and continues a build).
  rm -rf -- "$srcdir/build" "$srcdir/dist" "$srcdir/stage"
}

build() {
  local jobs ccache python archs host_cxx trt_home
  jobs=$(_ortf_get ORTF_JOBS) || return 1
  ccache=$(_ortf_get ORTF_CCACHE) || return 1
  python=$(_ortf_get ORTF_PYTHON) || return 1

  local -a args=(
    -S "$srcdir/onnxruntime/cmake"
    -B "$srcdir/build"
    -G Ninja
    -Wno-dev
    # Upstream sets COMPILE_WARNING_AS_ERROR on its targets; a newer
    # compiler than upstream's CI must not fail the build on a warning.
    --compile-no-warning-as-error
    # Bundled dependencies declare cmake_minimum_required below 3.5, which
    # CMake 4 refuses.
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    # Release adds -O3 -DNDEBUG to makepkg's flags, as upstream builds.
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LIBDIR=lib
    -Donnxruntime_BUILD_SHARED_LIB=ON
    # The unit tests would build googletest and thousands of test files and
    # need the GPU to mean anything; the package is checked after install.
    -Donnxruntime_BUILD_UNIT_TESTS=OFF
    -DBUILD_TESTING=OFF
    -Donnxruntime_USE_TELEMETRY=OFF
    # A portable package: upstream adds -march=native -mtune=native with
    # this on (cmake/adjust_global_compile_flags.cmake; its default is OFF,
    # set here so that it stays so). makepkg's CFLAGS set the baseline
    # (prepare() refuses -march=native), and MLAS dispatches its AVX2 and
    # AVX-512 kernels at run time, so nothing that matters is lost.
    -Donnxruntime_BUILD_FOR_NATIVE_MACHINE=OFF
    # The OpenVINO provider requires the full protobuf (build.py turns it
    # on with OpenVINO); used for every build, so that a CPU-only check
    # builds the same configuration.
    -Donnxruntime_USE_FULL_PROTOBUF=ON
    # The pinned dependencies, from the local mirror prepare() laid out.
    -DFETCHCONTENT_TRY_FIND_PACKAGE_MODE=NEVER
    -Donnxruntime_CMAKE_DEPS_MIRROR_DIR="$srcdir/deps-mirror"
  )
  if [[ $python == 1 ]]; then
    args+=(-Donnxruntime_ENABLE_PYTHON=ON -DPython_EXECUTABLE="$(_ortf_get ORTF_PYTHON_EXE)")
  else
    args+=(-Donnxruntime_ENABLE_PYTHON=OFF)
  fi

  # GCC 15 and later reject errors in uninstantiated templates of the
  # bundled abseil and CUTLASS; Arch's recipe downgrades them the same way.
  CXXFLAGS+=' -Wno-template-body'
  # The source paths in __FILE__ (ORT_ENFORCE and the logging macros keep
  # them in the error messages) are written as makepkg writes them for its
  # debug packages, not as the build directory: no reference to $srcdir.
  local prefix_map="-ffile-prefix-map=$srcdir=/usr/src/debug/$pkgbase"
  CFLAGS+=" $prefix_map"
  CXXFLAGS+=" $prefix_map"
  local cc=/usr/bin/gcc cxx=/usr/bin/g++ cuda_flags cuda_major
  if _ortf_has cuda; then
    archs=$(_ortf_get ORTF_CUDA_ARCHS) || return 1
    host_cxx=$(_ortf_get NVCC_CCBIN) || return 1
    cuda_flags="-Xcompiler -Wno-template-body -Xcompiler $prefix_map"
    # CUDA 12.9's nvcc warns on every compile for the architectures it
    # deprecates (below 75, the legacy preset's 60 61 70). A warning only:
    # no nvcc warning is an error here (--compile-no-warning-as-error;
    # upstream makes only default-stream-launch one), so this just keeps
    # the log readable.
    cuda_major=$(_ortf_get ORTF_CUDA_MAJOR) || return 1
    [[ $cuda_major != 12 ]] || cuda_flags+=' -Wno-deprecated-gpu-targets'
    # The C++ compiler is nvcc's host compiler, so that host code compiled
    # by nvcc and by the C++ compiler agrees.
    cxx=$host_cxx cc=${host_cxx/g++/gcc}
    # The C++ sources of the CUDA provider include CUDA's CCCL headers
    # (targets/x86_64-linux: $CARCH, this recipe's one arch).
    CXXFLAGS+=" -I$_ortf_cuda_home/targets/$CARCH-linux/include"
    args+=(
      -Donnxruntime_USE_CUDA=ON
      -Donnxruntime_CUDA_HOME="$_ortf_cuda_home"
      -Donnxruntime_CUDNN_HOME="$_ortf_cudnn_home"
      -DCMAKE_CUDA_COMPILER="$_ortf_cuda_home/bin/nvcc"
      -DCMAKE_CUDA_HOST_COMPILER="$host_cxx"
      -DCMAKE_CUDA_ARCHITECTURES="$archs"
      -DCMAKE_CUDA_FLAGS="$cuda_flags"
      -Donnxruntime_NVCC_THREADS="$(_ortf_get ORTF_NVCC_THREADS)"
      # One GPU: no multi-GPU collectives (and no NCCL dependency).
      -Donnxruntime_USE_NCCL=OFF
    )
  fi
  if _ortf_has tensorrt; then
    trt_home=$(_ortf_get ORTF_TENSORRT_HOME) || return 1
    args+=(
      -Donnxruntime_USE_TENSORRT=ON
      -Donnxruntime_TENSORRT_HOME="$trt_home"
      # TensorRT's own libnvonnxparser, which matches the installed
      # TensorRT, rather than a pinned onnx-tensorrt built from source.
      -Donnxruntime_USE_TENSORRT_BUILTIN_PARSER=ON
    )
  fi
  if _ortf_has openvino; then
    # No device is fixed at build time: the provider's device_type option
    # (CPU, GPU, NPU, AUTO:...) picks it per session.
    args+=(-Donnxruntime_USE_OPENVINO=ON)
  fi
  if _ortf_has migraphx; then
    # Host C++ only, and no GPU architecture is fixed at build time:
    # MIGraphX compiles each model for the GPU it finds at run time. ONNX
    # Runtime 1.29 has no ROCm provider, so Arch's HIP architecture, HIP
    # flag, NCCL/RCCL, composable-kernel and ROCM_HOME settings would be
    # inert here and are not passed.
    args+=(-Donnxruntime_USE_MIGRAPHX=ON -Donnxruntime_MIGRAPHX_HOME="$_ortf_rocm_home")
  fi
  args+=(-DCMAKE_C_COMPILER="$cc" -DCMAKE_CXX_COMPILER="$cxx")
  if [[ -n $ccache ]]; then
    args+=(-DCMAKE_C_COMPILER_LAUNCHER="$ccache" -DCMAKE_CXX_COMPILER_LAUNCHER="$ccache")
    if _ortf_has cuda; then args+=(-DCMAKE_CUDA_COMPILER_LAUNCHER="$ccache"); fi
  fi

  cmake "${args[@]}"
  cmake --build "$srcdir/build" ${jobs:+-j "$jobs"}

  if [[ $python == 1 ]]; then
    # As Arch's recipe does: the Python package tree the build assembled
    # (modules, provider libraries) goes into the source tree, whose
    # setup.py makes the wheel.
    cp -a -- "$srcdir/build/onnxruntime/." "$srcdir/onnxruntime/onnxruntime/"
    rm -rf -- "$srcdir/dist"
    (cd "$srcdir/onnxruntime" &&
      "$(_ortf_get ORTF_PYTHON_EXE)" -m build --wheel --no-isolation --outdir "$srcdir/dist")
  fi
}


# In a package function, makepkg's loop over the packages has set
# pkgname[0], and only that element, to the package being written.

# _ortf_licenses: ONNX Runtime's licence (MIT) and the bundled
# dependencies' notices, and the licences of cpuinfo (BSD-2-Clause) and
# protobuf (BSD-3-Clause), both compiled into libonnxruntime.so, as
# cpuinfo-LICENSE and protobuf-LICENSE, in every package's own licence
# directory: one text of each identifier of license=() that Arch does not
# ship in /usr/share/licenses/spdx, as namcap's licensepkg rule counts them
# (MIT, BSD-2-Clause, BSD-3-Clause: three files at least). Fails when a
# source archive or its licence entry is missing (_ortf_dep_license).
_ortf_licenses() {
  install -Dm644 -t "$pkgdir/usr/share/licenses/${pkgname[0]}" \
    "$srcdir/onnxruntime/LICENSE" "$srcdir/onnxruntime/ThirdPartyNotices.txt"
  _ortf_dep_license pytorch_cpuinfo LICENSE cpuinfo-LICENSE || return 1
  _ortf_dep_license protobuf LICENSE protobuf-LICENSE || return 1
}

# _ortf_cudnn_frontend_license: cudnn-frontend's licence (MIT), in the CUDA
# package's licence directory as cudnn-frontend-LICENSE.txt. The CUDA
# provider compiles in this header-only library (ortf-dep-cudnn_frontend),
# which ThirdPartyNotices.txt has no entry for.
_ortf_cudnn_frontend_license() {
  _ortf_dep_license cudnn_frontend LICENSE.txt cudnn-frontend-LICENSE.txt
}

# _ortf_dep_license <dependency> <entry> <file>: the licence file <entry>
# at the top of the mirrored source archive of <dependency>
# ($srcdir/ortf-dep-<dependency>.zip, the one the build tree is fed from;
# entry <top directory>/<entry>), not FetchContent's copy, installed as
# <file> in the licence directory of the package being written. Fails when
# the archive is missing, has not exactly one such entry, or the extracted
# file is empty.
_ortf_dep_license() {
  local zip=$srcdir/ortf-dep-$1.zip entry=$2 entries dest
  local -a found
  if [[ ! -f $zip ]]; then
    echo "$zip not found: $1's licence, which ${pkgname[0]} must carry, is read from it" >&2
    return 1
  fi
  if ! entries=$(bsdtar -tf "$zip"); then
    echo "$zip: cannot list it" >&2
    return 1
  fi
  mapfile -t found < <(grep -xF -- "${entries%%/*}/$entry" <<<"$entries" || true)
  if ((${#found[@]} != 1)); then
    echo "$zip: ${#found[@]} entries are <top directory>/$entry, want exactly one" >&2
    return 1
  fi
  dest=$pkgdir/usr/share/licenses/${pkgname[0]}/$3
  install -dm755 -- "${dest%/*}"
  if ! bsdtar -xOf "$zip" "${found[0]}" >"$dest" || [[ ! -s $dest ]]; then
    echo "$zip: cannot extract ${found[0]}" >&2
    return 1
  fi
  chmod 644 -- "$dest"
}

# _ortf_drop_bare_depends: removes from depends (the caller's array) each
# entry without a version (cuda) that a bounded entry of the same name
# (cuda>=13, cuda<14) also lists: pacman needs the bounds alone, and the
# package's .PKGINFO then lists each such dependency once, by its bounds.
# Run last, after _ortf_check_libs and the recorded bounds. The bare names
# stay in the package functions' bodies, so .SRCINFO (whose depends carry
# no bounds then) has them; the cuda12 line's CUDA package lists its cuda
# and cudnn bounds in the body instead, and has none here to drop.
_ortf_drop_bare_depends() {
  local d e keep
  local -a kept=()
  for d in "${depends[@]}"; do
    keep=1
    if [[ $d != *[\<\>=]* ]]; then
      for e in "${depends[@]}"; do
        if [[ $e == "$d"[\<\>=]* ]]; then keep=0; fi
      done
    fi
    ((keep == 0)) || kept+=("$d")
  done
  depends=("${kept[@]}")
}

# _ortf_cuda12_needed <label> <library file name>: reads the DT_NEEDED
# entries of a library of the cuda12 line on stdin and fails, with a
# message on stderr prefixed <label>, on any CUDA library (one
# _ortf_lib_pkg maps to cuda) of soname major 13: a CUDA 13 runtime that
# reached a build meant for CUDA 12 (a /opt/cuda of the other major). The
# CUDA provider itself, libonnxruntime_providers_cuda.so, must link the
# CUDA 12 runtime and cuBLAS: libcudart.so.12, libcublas.so.12 and
# libcublasLt.so.12.
_ortf_cuda12_needed() {
  local label=$1 soname want bad=0
  local -a needed=()
  mapfile -t needed
  for soname in "${needed[@]}"; do
    if [[ $soname =~ [.]so[.]13([.]|$) && $(_ortf_lib_pkg "$soname") == cuda ]]; then
      echo "$label: $soname is a CUDA 13 library: the cuda12 line links CUDA 12 only (build with CUDA 12 in $_ortf_cuda_home)" >&2
      bad=1
    fi
  done
  if [[ $2 == libonnxruntime_providers_cuda.so ]]; then
    for want in libcudart.so.12 libcublas.so.12 libcublasLt.so.12; do
      if [[ " ${needed[*]} " != *" $want "* ]]; then
        echo "$label: no $want in its NEEDED entries (${needed[*]}): the cuda12 line's CUDA provider links CUDA 12's runtime and cuBLAS" >&2
        bad=1
      fi
    done
  fi
  ((bad == 0))
}

# _ortf_check_libs [<tensorrt package>]: checks the DT_NEEDED entries of
# every library of the package being written (each regular file named
# *.so or *.so.*; links are checked as their targets) against its depends
# (_ortf_lib_depends), and adds the cuda bounds they give, and the cudnn
# ones of the recorded cuDNN major, to depends, each once. Fails on any library whose package is not in
# depends. A package that depends on migraphx or hip-runtime-amd has its
# libmigraphx_c and libamdhip64 sonames checked against the majors
# prepare() found (ORTF_MIGRAPHX_SONAME_MAJOR, ORTF_HIP_SONAME_MAJOR).
# In the cuda12 line the cudnn bounds are on the recorded major.minor
# (ORTF_CUDNN_MINOR), each library's NEEDED entries also pass
# _ortf_cuda12_needed, and a cuda or cudnn bound not already in depends
# fails: that package function lists its bounds itself (in .SRCINFO), so
# a build of another CUDA or cuDNN would not match them.
_ortf_check_libs() {
  local trt=${1:-} cuda_major cudnn_major='' cudnn_minor='' trt_version='' lib needed bounds b d bad=0
  local mgx_soname='' hip_soname='' key
  local -a libs found=() names=()
  # The names in depends, without their bounds (cudnn for cudnn>=9.10).
  for d in "${depends[@]}"; do names+=("${d%%[<>=]*}"); done
  # The CUDA major the names carry, and the TensorRT version prepare()
  # recorded: the libcudart and libnvinfer linked must be of these.
  cuda_major=$(_ortf_get ORTF_CUDA_MAJOR) || return 1
  if [[ -n $trt ]]; then trt_version=$(_ortf_get ORTF_TENSORRT_VERSION) || return 1; fi
  # The cuDNN major prepare() recorded, for a package that depends on
  # cudnn (the CUDA provider dlopen()s cuDNN: no NEEDED entry gives its
  # bound). A libcudnn in the NEEDED entries (the TensorRT provider's) must
  # be of it, and gives the same bounds, added once.
  if [[ " ${names[*]} " == *" cudnn "* ]]; then
    cudnn_major=$(_ortf_get ORTF_CUDNN_MAJOR) || return 1
    if [[ ! $cudnn_major =~ ^[1-9][0-9]*$ ]]; then
      echo "ortf.conf: ORTF_CUDNN_MAJOR is '$cudnn_major', not a major version (run makepkg without -e, so that prepare() runs)" >&2
      return 1
    fi
    # The cuda12 line's bound is on the major.minor (_ortf_resolve).
    if [[ $_ortf_line == cuda12 ]]; then
      cudnn_minor=$(_ortf_get ORTF_CUDNN_MINOR) || return 1
      if [[ ! $cudnn_minor =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "ortf.conf: ORTF_CUDNN_MINOR is '$cudnn_minor', not a minor version (run makepkg without -e, so that prepare() runs)" >&2
        return 1
      fi
    fi
  fi
  for key in migraphx:ORTF_MIGRAPHX_SONAME_MAJOR hip-runtime-amd:ORTF_HIP_SONAME_MAJOR; do
    [[ " ${depends[*]} " == *" ${key%%:*} "* ]] || continue
    b=$(_ortf_get "${key#*:}") || return 1
    if [[ ! $b =~ ^[0-9]+$ ]]; then
      echo "ortf.conf: ${key#*:} is '$b', not a soname major (run makepkg without -e, so that prepare() runs)" >&2
      return 1
    fi
    if [[ ${key%%:*} == migraphx ]]; then mgx_soname=$b; else hip_soname=$b; fi
  done
  mapfile -t libs < <(find "$pkgdir" -type f \( -name '*.so' -o -name '*.so.*' \) | LC_ALL=C sort)
  for lib in "${libs[@]}"; do
    needed=$(_ortf_needed "$lib") || return 1
    echo "${lib##*/} needs: ${needed//$'\n'/ }"
    if [[ $_ortf_line == cuda12 ]] && ! _ortf_cuda12_needed "${pkgname[0]}: ${lib##*/}" "${lib##*/}" <<<"$needed"; then
      bad=1
      continue
    fi
    if ! bounds=$(_ortf_lib_depends "${pkgname[0]}" "${pkgname[0]}: ${lib##*/}" "$trt" "$cuda_major" \
      "$trt_version" "$cudnn_major" "$mgx_soname" "$hip_soname" <<<"$needed"); then
      bad=1
      continue
    fi
    [[ -z $bounds ]] || mapfile -t -O "${#found[@]}" found <<<"$bounds"
  done
  ((bad == 0)) || return 1
  if [[ -n $cudnn_minor ]]; then
    found+=("cudnn>=$cudnn_major.$cudnn_minor" "cudnn<$cudnn_major.$((cudnn_minor + 1))")
  elif [[ -n $cudnn_major ]]; then
    found+=("cudnn>=$cudnn_major" "cudnn<$((cudnn_major + 1))")
  fi
  for b in "${found[@]}"; do
    [[ " ${depends[*]} " != *" $b "* ]] || continue
    if [[ $_ortf_line == cuda12 && ( ${b%%[<>=]*} == cuda || ${b%%[<>=]*} == cudnn ) ]]; then
      echo "${pkgname[0]}: $b is not in its depends (${depends[*]}): the cuda12 line's package function lists its cuda and cudnn bounds, and the build does not match them" >&2
      bad=1
      continue
    fi
    depends+=("$b")
  done
  ((bad == 0))
}

# _ortf_recorded_bounds <ortf.conf key> <package> [major]: prints the
# major.minor bounds on <package> from the installed version prepare()
# recorded under <key> (_ortf_minor_bounds); with major, the major bounds
# (_ortf_major_bounds).
_ortf_recorded_bounds() {
  local version
  version=$(_ortf_get "$1") || return 1
  if [[ -z $version ]]; then
    echo "ortf.conf: $1 is empty (run makepkg without -e, so that prepare() runs)" >&2
    return 1
  fi
  if [[ ${3:-} == major ]]; then
    _ortf_major_bounds "$2" "$version"
  else
    _ortf_minor_bounds "$2" "$version"
  fi
}

# _ortf_stage: installs the build into a fresh stage, $srcdir/stage, which
# every package copies its files from. The first package of the run does
# it (_ortf_pkgnames gives the order): onnxruntime-core in the main line,
# the CUDA package in the cuda12 line, which has no onnxruntime-core.
_ortf_stage() {
  rm -rf -- "$srcdir/stage"
  DESTDIR=$srcdir/stage cmake --install "$srcdir/build"
}

package_onnxruntime-core() {
  pkgdesc='Cross-platform inference engine for ONNX models: the C and C++ library with the CPU execution provider'
  # What libonnxruntime.so itself links (package() checks every library's
  # DT_NEEDED entries against these, _ortf_check_libs): it runs CPU-only
  # without any provider package. No zlib: libonnxruntime.so does not link
  # libz, and a libz in its DT_NEEDED entries in a future release fails the
  # check rather than going unnoticed.
  depends=('glibc' 'libgcc' 'libstdc++')
  # The provider packages of this build's inputs (_ortf_provider_optdepends).
  optdepends=("${_ortf_provider_optdepends[@]}")
  # libonnxruntime.so: makepkg turns a listed soname into the versioned
  # provide (libonnxruntime.so=1-64 in the .PKGINFO); it adds none unlisted.
  provides=("onnxruntime=$pkgver" 'libonnxruntime.so')
  # onnxruntime-full: this recipe's unsplit 1.29.0-1, which held every
  # provider library. replaces= acts on a sync upgrade only; with pacman -U
  # the conflict makes pacman offer to remove it in the same transaction
  # (the top of the file).
  conflicts=(onnxruntime onnxruntime-cpu onnxruntime-cuda onnxruntime-opt-cuda
    onnxruntime-rocm onnxruntime-opt-rocm onnxruntime-git onnxruntime-full)
  replaces=(onnxruntime-full)

  _ortf_check_names || return 1
  local stage=$srcdir/stage lib f left
  _ortf_stage

  # The library, headers, pkg-config and CMake files only: the bundled
  # dependencies' own install rules (abseil, protobuf, ...) would otherwise
  # put headers and static libraries under /usr that clash with Arch's
  # packages. The provider libraries stay in the stage for their packages,
  # which makepkg writes after this one.
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/include"
  cp -a -- "$stage"/usr/lib/libonnxruntime.so* "$pkgdir/usr/lib/"
  if [[ -e $stage/usr/lib/libonnxruntime_providers_shared.so ]]; then
    cp -a -- "$stage/usr/lib/libonnxruntime_providers_shared.so" "$pkgdir/usr/lib/"
  fi
  cp -a -- "$stage/usr/include/onnxruntime" "$pkgdir/usr/include/"
  install -Dm644 "$stage/usr/lib/pkgconfig/libonnxruntime.pc" "$pkgdir/usr/lib/pkgconfig/libonnxruntime.pc"
  if [[ -d $stage/usr/lib/cmake/onnxruntime ]]; then
    install -d "$pkgdir/usr/lib/cmake"
    cp -a -- "$stage/usr/lib/cmake/onnxruntime" "$pkgdir/usr/lib/cmake/"
  fi
  left=$(cd "$stage" && find . ! -type d ! -path './usr/lib/libonnxruntime*' \
    ! -path './usr/include/onnxruntime/*' ! -path ./usr/lib/pkgconfig/libonnxruntime.pc \
    ! -path './usr/lib/cmake/onnxruntime/*' | sort)
  if [[ -n $left ]]; then
    echo "not packaged ($(wc -l <<<"$left") files of the bundled dependencies), e.g.:"
    head -n 5 <<<"$left"
  fi

  # The layout consumers rely on.
  local -a expected=(
    usr/lib/libonnxruntime.so usr/lib/libonnxruntime.so.1 "usr/lib/libonnxruntime.so.$pkgver"
    usr/include/onnxruntime/onnxruntime_c_api.h usr/include/onnxruntime/onnxruntime_cxx_api.h
    usr/lib/pkgconfig/libonnxruntime.pc
  )
  _ortf_has cpu || expected+=(usr/lib/libonnxruntime_providers_shared.so)
  for f in "${expected[@]}"; do
    [[ -e $pkgdir/$f ]] || { echo "the package lacks /$f" >&2; return 1; }
  done

  # Its libraries need system libraries only: a vendor library maps to a
  # package not in depends, and fails.
  _ortf_check_libs || return 1

  _ortf_licenses
}

# _ortf_package_provider <provider>: writes the package of
# libonnxruntime_providers_<provider>.so, from the stage the first package
# of the run installs (_ortf_stage: onnxruntime-core's, or this one's when
# it is the first, as in the cuda12 line), and adds the version bounds of
# its vendor runtimes to depends: TensorRT's, openvino's, migraphx's and
# hip-runtime-amd's from the versions prepare() recorded, cuda's from the
# sonames and cudnn's from the build-time cuDNN (_ortf_check_libs). The
# caller has set depends.
_ortf_package_provider() {
  local ep=$1 name=libonnxruntime_providers_$1.so lib trt='' trt_home trt_libdir runpath bounds rpath
  _ortf_check_names || return 1
  if [[ ${pkgname[0]} == "${_ortf_pkgname[0]}" ]]; then
    _ortf_stage || return 1
  fi
  if [[ ! -f $srcdir/stage/usr/lib/$name ]]; then
    echo "$srcdir/stage/usr/lib/$name not found (the first package of the run stages the install; a build without $ep?)" >&2
    return 1
  fi
  install -d "$pkgdir/usr/lib"
  cp -a -- "$srcdir/stage/usr/lib/$name" "$pkgdir/usr/lib/"
  lib=$pkgdir/usr/lib/$name

  if [[ $ep == tensorrt ]]; then
    # tensorrt, bounded to the major.minor of the TensorRT headers the build
    # used (_ortf_resolve): not known when makepkg sources this file, so not
    # in .SRCINFO.
    trt=tensorrt
    bounds=$(_ortf_recorded_bounds ORTF_TENSORRT_VERSION tensorrt) || return 1
    mapfile -t -O "${#depends[@]}" depends <<<"$bounds"
    # The TensorRT provider finds libnvinfer and libnvonnxparser, which it
    # links, through its own RUNPATH: no ld.so.conf entry, nothing global.
    # /opt/nvidia/tensorrt/lib always (nvidia-tensorrt-sdk-local), the
    # library directory of a build against another ORTF_TENSORRT_HOME first
    # (the one it was built against); the default search then covers /usr/lib
    # (the AUR's tensorrt). patchelf, after the install, on this one
    # library: CMAKE_INSTALL_RPATH would give every library the path. That
    # RUNPATH does not cover libnvinfer_plugin: the provider has
    # libonnxruntime.so open it by name (Env::LoadDynamicLibrary,
    # tensorrt_execution_provider_custom_ops.cc), and a dlopen() searches
    # the RUNPATH of the object that calls it: libonnxruntime.so's is only
    # $ORIGIN (/usr/lib, where the AUR's tensorrt puts it). A program that wants TensorRT's built-in plugins sets
    # LD_LIBRARY_PATH (the top of this file), or the provider option
    # trt_extra_plugin_lib_paths; without them the provider still runs.
    trt_home=$(_ortf_get ORTF_TENSORRT_HOME) || return 1
    trt_libdir=$(_ortf_get ORTF_TENSORRT_LIBDIR) || return 1
    rpath=$_ortf_tensorrt_default/lib
    case $trt_libdir in
      /usr/lib | /usr/lib64 | "$rpath") ;;
      *) rpath=$trt_libdir:$rpath ;;
    esac
    patchelf --set-rpath "$rpath" "$lib"
    runpath=$(readelf -d -- "$lib" | sed -n 's/.*(RUNPATH).*\[\(.*\)\]$/\1/p')
    if [[ $runpath != "$rpath" ]]; then
      echo "$name: RUNPATH '$runpath', not $rpath" >&2
      return 1
    fi
    echo "$name: RUNPATH $runpath (TensorRT in $trt_home)"
  fi
  if [[ $ep == openvino ]]; then
    bounds=$(_ortf_recorded_bounds ORTF_OPENVINO_VERSION openvino) || return 1
    mapfile -t -O "${#depends[@]}" depends <<<"$bounds"
  fi
  if [[ $ep == migraphx ]]; then
    # By the package versions' major, not the sonames' (the top of the
    # file): libamdhip64.so.7 is also ROCm 10.1's.
    bounds=$(_ortf_recorded_bounds ORTF_MIGRAPHX_VERSION migraphx major) || return 1
    mapfile -t -O "${#depends[@]}" depends <<<"$bounds"
    bounds=$(_ortf_recorded_bounds ORTF_HIP_VERSION hip-runtime-amd major) || return 1
    mapfile -t -O "${#depends[@]}" depends <<<"$bounds"
  fi

  _ortf_check_libs "$trt" || return 1
  if [[ $ep == migraphx ]]; then
    # _ortf_check_libs checks the majors of the sonames a library has; the
    # provider must link both, or a build that linked neither would pass.
    local want_lib want_key want_major needed
    needed=$(_ortf_needed "$lib") || return 1
    for want_lib in libmigraphx_c:ORTF_MIGRAPHX_SONAME_MAJOR libamdhip64:ORTF_HIP_SONAME_MAJOR; do
      want_key=${want_lib#*:} want_lib=${want_lib%%:*}
      want_major=$(_ortf_get "$want_key") || return 1
      if ! grep -qxF -- "$want_lib.so.$want_major" <<<"$needed"; then
        echo "$name: $want_lib.so.$want_major ($want_key) is not in its NEEDED entries (${needed//$'\n'/ })" >&2
        return 1
      fi
    done
  fi
  _ortf_drop_bare_depends
  echo "${pkgname[0]} depends: ${depends[*]}"

  _ortf_licenses
}

# The CUDA and TensorRT package functions: their names carry the CUDA
# major (_ortf_cuda_major) and the CUDA one the architectures (_ortf_sfx),
# so they are defined with eval. Their pkgdesc, depends, provides and
# conflicts are written out in the body, where `makepkg --printsrcinfo`
# reads them.
#
# The CUDA package provides the plain name and the one with the CUDA major
# and conflicts with both: pacman ignores a package's conflict with
# itself, so this only keeps two CUDA packages from being installed
# together. onnxruntime-provider-cuda keeps a CUDA package of another
# major (a -cuda12 build) out as well, which is right: every one installs
# /usr/lib/libonnxruntime_providers_cuda.so. glibc, libgcc and libstdc++:
# every provider library links them (_ortf_check_libs).
#
# Its onnxruntime-core is that of the same build, pkgver-pkgrel; in the
# cuda12 line, which makes no onnxruntime-core, the main line's of the same
# pkgver, any pkgrel: onnxruntime-core links no CUDA library, and the
# provider bridge between the two depends on the ONNX Runtime version and
# build defines only, not on the CUDA of either side.
# The cuda12 line's vendor depends are its bounds, written out in the
# order package() gives them (the released package's .PKGINFO), so that
# .SRCINFO, the built package and its -bin list the same: CUDA 12 and
# cuDNN 9.10, the only ones prepare() accepts there, and the guard in
# _ortf_check_libs fails a build whose bounds differ. The main line's are
# the bare names, the bounds added at package time (_ortf_check_libs,
# _ortf_drop_bare_depends).
# Single-quoted: $pkgver and $pkgrel expand in the function's body.
# shellcheck disable=SC2016
if [[ $_ortf_line == cuda12 ]]; then
  _ortf_cuda_core_dep='onnxruntime-core=$pkgver'
  _ortf_cuda_vendor_deps="'nvidia-utils' 'cuda>=12' 'cuda<13' 'cudnn>=9.10' 'cudnn<9.11'"
  _ortf_cuda_pkgdesc=$_ortf_cuda12_pkgdesc
else
  _ortf_cuda_core_dep='onnxruntime-core=$pkgver-$pkgrel'
  _ortf_cuda_vendor_deps="'cuda' 'cudnn' 'nvidia-utils'"
  _ortf_cuda_pkgdesc='The CUDA execution provider of ONNX Runtime, for onnxruntime-core (NVIDIA GPUs)'
fi
eval "package_onnxruntime-provider-cuda$_ortf_cuda_major-$_ortf_sfx() {
  pkgdesc='$_ortf_cuda_pkgdesc'
  depends=(\"$_ortf_cuda_core_dep\" 'glibc' 'libgcc' 'libstdc++' $_ortf_cuda_vendor_deps)
  provides=(\"onnxruntime-provider-cuda=\$pkgver\" \"onnxruntime-provider-cuda$_ortf_cuda_major=\$pkgver\")
  conflicts=('onnxruntime-provider-cuda' 'onnxruntime-provider-cuda$_ortf_cuda_major')
  _ortf_package_provider cuda
  _ortf_cudnn_frontend_license
}"

# The TensorRT package has no architecture suffix: its library holds no
# CUDA GPU code (TensorRT builds its kernels at run time), so it works
# with the CUDA package of any architectures of its CUDA major, by the name
# each of them provides. It links CUDA's runtime, cuBLAS and cuDNN itself,
# hence cuda and cudnn in its depends too; its TensorRT package, with
# bounds on the major.minor of the headers it was built with, is added at
# package time (_ortf_package_provider). It provides, and conflicts with,
# onnxruntime-provider-tensorrt, the name the optdepends use.
eval "package_onnxruntime-provider-tensorrt-cuda$_ortf_cuda_major() {
  pkgdesc='The TensorRT execution provider of ONNX Runtime, for onnxruntime-core (NVIDIA GPUs)'
  depends=(\"onnxruntime-core=\$pkgver-\$pkgrel\" \"onnxruntime-provider-cuda$_ortf_cuda_major=\$pkgver\"
    'glibc' 'libgcc' 'libstdc++' 'cuda' 'cudnn' 'nvidia-utils')
  provides=(\"onnxruntime-provider-tensorrt=\$pkgver\")
  conflicts=('onnxruntime-provider-tensorrt')
  _ortf_package_provider tensorrt
}"

# The OpenVINO package's bounds on openvino's year.minor are added at
# package time (_ortf_package_provider).
package_onnxruntime-provider-openvino() {
  pkgdesc='The OpenVINO execution provider of ONNX Runtime, for onnxruntime-core (Intel CPU, GPU and NPU)'
  depends=("onnxruntime-core=$pkgver-$pkgrel" 'glibc' 'libgcc' 'libstdc++' 'openvino')
  optdepends=(
    'openvino-intel-gpu-plugin: the OpenVINO GPU device (Intel graphics)'
    'openvino-intel-npu-plugin: the OpenVINO NPU device (Intel NPU)'
    'intel-compute-runtime: Intel graphics compute runtime (OpenVINO GPU device)'
    'level-zero-loader: oneAPI Level Zero loader (OpenVINO GPU and NPU devices)'
    'intel-npu-driver: Intel NPU user-space driver (OpenVINO NPU device)'
  )
  _ortf_package_provider openvino
}

# The MIGraphX package (AMD GPUs; built and checked here, never run on AMD
# hardware). Its library is host C++ only (no per-GPU code, so no suffix):
# MIGraphX compiles each model for the GPU it finds at run time, with the
# GPU kernels of Arch's ROCm libraries it depends on. migraphx and
# hip-runtime-amd are what it links (libmigraphx_c, libamdhip64), never
# rocm-hip-sdk; their bounds on the major of the installed package
# versions are added at package time (_ortf_package_provider). Like the
# OpenVINO package, it provides nothing: its own name is the one the
# optdepends use.
package_onnxruntime-provider-migraphx() {
  pkgdesc='The MIGraphX execution provider of ONNX Runtime, for onnxruntime-core (AMD GPUs; untested on AMD hardware)'
  depends=("onnxruntime-core=$pkgver-$pkgrel" 'glibc' 'libgcc' 'libstdc++' 'migraphx' 'hip-runtime-amd')
  _ortf_package_provider migraphx
  # The wheel of a migraphx build has no MIGraphX provider library
  # (upstream's setup.py bundles it only with --use_migraphx), so the Python
  # module could not load that provider. This package therefore links its
  # own library into the module's capi directory, where the module looks for
  # its providers, when the build also makes python-onnxruntime-core. The
  # link points at this package's own file, so it never dangles. No python
  # in depends: without python the link is inert.
  if [[ " ${_ortf_pkgname[*]} " == *' python-onnxruntime-core '* ]]; then
    local site
    site=$(_ortf_py_site "$_ortf_system_python") || return 1
    install -d -- "$pkgdir$site/onnxruntime/capi"
    ln -sf -- /usr/lib/libonnxruntime_providers_migraphx.so \
      "$pkgdir$site/onnxruntime/capi/libonnxruntime_providers_migraphx.so"
  fi
}

package_python-onnxruntime-core() {
  pkgdesc='The Python module of ONNX Runtime, the cross-platform inference engine for ONNX models (onnxruntime-core)'
  # import onnxruntime needs numpy (onnxruntime/__init__.py and
  # capi/onnxruntime_inference_collection.py import it, and the module's
  # C++ side uses its C API); flatbuffers, packaging and protobuf are the
  # wheel's other unconditional requirements (Requires-Dist), which
  # importlib.metadata and pip check see, used by onnxruntime.tools,
  # quantization and transformers. python: bounded to the minor version the
  # module is built for, at package time.
  depends=("onnxruntime-core=$pkgver-$pkgrel" 'glibc' 'libgcc' 'libstdc++'
    'python' 'python-numpy' 'python-flatbuffers' 'python-packaging' 'python-protobuf')
  # The provider packages (_ortf_provider_optdepends), then the Python
  # modules imported only by the tools that need them, not by import
  # onnxruntime.
  optdepends=("${_ortf_provider_optdepends[@]}"
    'python-onnx: the quantization, transformers optimisation and model tools'
    'python-ml-dtypes: 4-bit and float8 quantization (the wheel'"'"'s quantization extra)'
    'python-sympy: symbolic shape inference (onnxruntime.tools)'
    'python-psutil: the transformers optimisation and benchmark tools'
    'python-py-cpuinfo: the transformers optimisation and benchmark tools'
  )
  provides=("python-onnxruntime=$pkgver")
  # python-onnxruntime-full: this recipe's unsplit 1.29.0-1 (see
  # onnxruntime-core's replaces).
  conflicts=(python-onnxruntime python-onnxruntime-cpu python-onnxruntime-cuda
    python-onnxruntime-opt-cuda python-onnxruntime-rocm python-onnxruntime-opt-rocm
    python-onnxruntime-full)
  replaces=(python-onnxruntime-full)

  _ortf_check_names || return 1
  local python wheels site lib base outside f sibling owner bounds
  python=$(_ortf_get ORTF_PYTHON_EXE)
  wheels=("$srcdir"/dist/onnxruntime-*.whl)
  if ((${#wheels[@]} != 1)) || [[ ! -f ${wheels[0]} ]]; then
    echo "expected one wheel in $srcdir/dist, found: ${wheels[*]}" >&2
    return 1
  fi
  # The system python's site-packages, whichever python runs the build:
  # installer's own default is the running interpreter's scheme, which for
  # a virtual environment's python is the environment, not /usr.
  # --prefix=/usr gives installer that scheme's paths under /usr (for a
  # venv python too), and prepare() checked that the two pythons agree on
  # the directory.
  site=$(_ortf_py_site "$_ortf_system_python") || return 1
  "$python" -m installer --destdir="$pkgdir" --prefix=/usr "${wheels[0]}"
  outside=$(cd "$pkgdir" && find . -mindepth 1 -maxdepth 1 ! -name usr)
  if [[ -n $outside ]]; then
    echo "the wheel installed outside /usr: $outside" >&2
    return 1
  fi
  if [[ ! -d $pkgdir$site/onnxruntime/capi ]]; then
    echo "the wheel did not install into $site (the system python's site-packages)" >&2
    return 1
  fi
  # installer writes the running interpreter into the scripts' #! line.
  for f in "$pkgdir"/usr/bin/*; do
    if [[ -f $f ]]; then sed -i "1s|^#!.*python[0-9.]*\$|#!$_ortf_system_python|" "$f"; fi
  done
  if [[ $python != "$_ortf_system_python" ]] && grep -rlF -- "${python%/bin/*}" "$pkgdir"; then
    echo "the files above name the build python's environment, ${python%/bin/*}" >&2
    return 1
  fi

  # libonnxruntime.so and the provider libraries are those of
  # onnxruntime-core and the provider packages (the same build, and the
  # TensorRT one with its RUNPATH): links instead of copies, each checked
  # against the package directory makepkg already wrote it to (this
  # package comes last). The link of a provider whose package is not
  # installed dangles; ONNX Runtime then reports that the provider library
  # failed to load, and the other providers still work. Upstream's setup.py
  # puts libonnxruntime_providers_migraphx.so into the wheel only when run
  # with --use_migraphx (which leaves the TensorRT one out), so the wheel of
  # a migraphx build has no MIGraphX provider library: the MIGraphX package
  # itself links its library into this directory (package_onnxruntime-
  # provider-migraphx). (On Linux, setup.py copies no ROCm library into the
  # wheel either.) Should a wheel ever carry that library, this package
  # drops it, so that the two packages never own the same path.
  if [[ " ${_ortf_pkgname[*]} " == *' onnxruntime-provider-migraphx '* ]]; then
    rm -f -- "$pkgdir$site"/onnxruntime/capi/libonnxruntime_providers_migraphx.so
  fi
  for lib in "$pkgdir$site"/onnxruntime/capi/libonnxruntime.so* \
    "$pkgdir$site"/onnxruntime/capi/libonnxruntime_providers_*.so; do
    [[ -e $lib ]] || continue
    base=${lib##*/} owner=''
    for sibling in "${_ortf_pkgname[@]}"; do
      if [[ $sibling != "${pkgname[0]}" && -f ${pkgdir%/*}/$sibling/usr/lib/$base ]]; then owner=$sibling; fi
    done
    if [[ -z $owner ]]; then
      echo "$base is in the wheel but in no other package of this build (${_ortf_pkgname[*]})" >&2
      return 1
    fi
    ln -sf -- "/usr/lib/$base" "$lib"
  done
  for lib in "$pkgdir$site"/onnxruntime/capi/onnxruntime_pybind11_state*.so; do
    [[ -f $lib ]] || { echo "the wheel has no onnxruntime_pybind11_state module" >&2; return 1; }
  done
  # The module and any other library of the wheel need no vendor runtime:
  # a vendor library maps to a package not in depends, and fails.
  _ortf_check_libs || return 1
  bounds=$(_ortf_recorded_bounds ORTF_PYTHON_VERSION python) || return 1
  mapfile -t -O "${#depends[@]}" depends <<<"$bounds"
  _ortf_drop_bare_depends
  echo "${pkgname[0]} depends: ${depends[*]}"

  _ortf_licenses
}
