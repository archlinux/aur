pkgname='jaguar-bin'
pkgver=1.33.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('815abaad2ff2dfb3072e8d43bf53f0134f13d08508f0b858a0a06eabe11a96c2')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
