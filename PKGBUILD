  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  export CFLAGS="${CFLAGS//-flto=auto/}" CXXFLAGS="${CXXFLAGS//-flto=auto/}" LDFLAGS="${LDFLAGS//-flto=auto/}"
