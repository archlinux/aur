pkgname=datui-bin
pkgver=0.3.2
pkgrel=1
pkgdesc="Data Exploration in the Terminal"
url="https://derekwisong.github.io/datui"
license=("MIT")
arch=("x86_64")
provides=("datui")
conflicts=("datui")
depends=("fontconfig")
options=(!strip !debug)
source=("https://github.com/derekwisong/datui/releases/download/v$pkgver/datui-$pkgver-x86_64.tar.gz")
sha256sums=("61d8adc60f2c2512aa6f3583167aa70a3dc545f7386dce39ab6f7ad3d3b47919")

package() {
    install -Dm755 datui -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "target/release/datui.1.gz" "$pkgdir/usr/share/man/man1/datui.1.gz"
    install -Dm644 "scripts/packaging/datui.desktop" "$pkgdir/usr/share/applications/datui.desktop"
}
