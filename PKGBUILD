pkgdesc='MCP server bridging serial hardware to LLMs via SQLite-backed buffer'
arch=('x86_64' 'aarch64')
url='https://github.com/metaneutrons/devserial'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
provides=('devserial')
conflicts=('devserial')
options=('!strip')
source_x86_64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.12/devserial-0.1.12-x86_64-unknown-linux-gnu.tar.gz')
sha256sums_x86_64=('3fd7ce06f05bc31e013cd59b3d6696900dbffdd9618f713e2254749006dd26ba')
source_aarch64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.12/devserial-0.1.12-aarch64-unknown-linux-gnu.tar.gz')
