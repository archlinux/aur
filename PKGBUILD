pkgname='jaguar-bin'
pkgver=1.32.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('2ae5ec3f10bdafcc2d82a3144df7f7cf06f8aea0e5d5950bd1668bf65444da90')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
