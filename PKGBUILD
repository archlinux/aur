pkgname='jaguar-bin'
pkgver=1.38.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('ee3adb50730940e42dea68d40c9c4a268d3eab246f44affe1ceae5c9384b6d27')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
