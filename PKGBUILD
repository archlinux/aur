# Maintainer: Cristo Cola <kristokola@hotmail.com>
pkgname=fast-folder
pkgver=2.1.0
pkgrel=1
pkgdesc="Template-driven project folder generator with a guided TUI and CLI (fastf)"
arch=(x86_64)
url="https://github.com/cristocola/fast-folder"
license=(MIT)
depends=(gcc-libs)
makedepends=(cargo)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4c742ad57cf78a865d506075619e8d31cd19d6e90711fdf8f63b7e640189a57f')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Tests are hermetic: they redirect all state via FASTF_INSTALL_DIR.
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  local bin=target/release/fastf

  install -Dm755 "$bin" "$pkgdir/usr/bin/fastf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Shell completions (generated by the built binary; writes nothing to $HOME)
  "$bin" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/fastf"
  "$bin" completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_fastf"
  "$bin" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/fastf.fish"

  # Man pages
  "$bin" mangen man
  install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1/"

  # Desktop integration (app-menu entry for the guided TUI)
  install -Dm644 packaging/fastf.desktop "$pkgdir/usr/share/applications/fastf.desktop"
  for size in 48 128 256; do
    install -Dm644 "packaging/icons/fastf-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/fastf.png"
  done
}
