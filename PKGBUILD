# Maintainer: Guillaume Horel <guillaume.horel@gmail.com>

pkgname=python-perspective
_pkgname=perspective
pkgver=4.5.2
pkgrel=1
pkgdesc="Python bindings for Perspective, a high performance data-visualization and analytics component"
url="https://github.com/perspective-dev/perspective"
license=('Apache-2.0')
arch=('x86_64')
depends=('python' 'gcc-libs' 'glibc' 'abseil-cpp' 'protobuf')
makedepends=('cargo' 'cmake' 'maturin' 'python-build' 'python-installer' 'git' 'protobuf')
# The jupyterlab labextension's JS bundle requires nightly Rust to compile
# `perspective-viewer` to wasm (it uses iter_intersperse / try_blocks /
# more_qualified_paths). Rather than build a nightly toolchain, vendor the
# prebuilt labextension bytes from the official PyPI wheel (same upstream
# version we build the rest from) and graft them onto our wheel via maturin's
# `data = ...` directive. Our .so is still built from source.
_upstream_whl=perspective_python-${pkgver}-cp311-abi3-manylinux_2_28_x86_64.whl
source=("https://github.com/perspective-dev/perspective/archive/refs/tags/v$pkgver.tar.gz"
        "https://files.pythonhosted.org/packages/89/94/94c06faff7430c8b5c48bed41da759e1e4894528b2e2373617adf9d5f1e4/${_upstream_whl}")
sha512sums=('46fc86ac07a4457f79e0a571d939540678d8bfce8bdce19bbcaceb5d7861c15aa153f71774211d426e2ad5748b7d55482aa9e91500e5cf0daa32ace51f43251e'
            '36500ccf7eadb33098ccda45205b829dbadc8352266eb5a44c4ac5c60bd50dfedebfe810f46be59da18a2374c59c1fa7924435700c75531b706e4f61bf51faa1')

prepare() {
  cd "$_pkgname-$pkgver"
  # Drop workspace members that require nightly Cargo (`-Z bindeps`)
  sed -i '/"rust\/lint",/d;/"rust\/metadata",/d;/"rust\/bundle",/d;/"examples\/rust-axum",/d' Cargo.toml

  # Expose perspective-client's `omit_metadata` feature through perspective-python
  # so we can skip pulling in `docs/expression_gen.md` (generated by the metadata
  # crate, which we just removed from the workspace).
  sed -i '/^default = \[\]$/a omit_metadata = ["perspective-client/omit_metadata"]' \
    rust/perspective-python/Cargo.toml

  # Force the C++ archive containing the psp_* FFI exports to be whole-archive
  # linked. Without this the rust linker leaves binding_api.cpp.o out and the
  # cdylib comes out missing every psp_* symbol at import time. Only apply the
  # modifier to libpsp; the recursive walk emits some library names twice
  # (e.g. lz4) and rustc rejects duplicates that disagree on modifiers. Also
  # teach the walk to skip libpsp so its modifier-less re-emission doesn't
  # collide with the explicit `+whole-archive=psp` declaration.
  sed -i 's|cargo:rustc-link-lib=static=psp|cargo:rustc-link-lib=static:+whole-archive,-bundle=psp|' \
    rust/perspective-server/build.rs
  sed -i 's|println!("cargo:rustc-link-lib=static={a}");|if a != "psp" { println!("cargo:rustc-link-lib=static={a}"); }|' \
    rust/perspective-server/build.rs

  # Use the system protobuf (Arch's /usr/bin/protoc + /usr/lib/libprotobuf.so)
  # rather than have perspective's cmake fetch and build a vendored copy.
  # Swap psp_build_dep("protobuf", ...) for find_package(Protobuf REQUIRED)
  # in the protos sub-build, and drop the obsolete include-dir line that
  # pointed into the vendored protobuf source tree.
  sed -i 's|psp_build_dep("protobuf".*|find_package(Protobuf REQUIRED)|' \
    rust/perspective-server/cpp/protos/CMakeLists.txt
  sed -i '/target_include_directories(protos PRIVATE \${CMAKE_CURRENT_BINARY_DIR}\/protobuf-src\/src)/d' \
    rust/perspective-server/cpp/protos/CMakeLists.txt

  # Point perspective-server's cmake at system protoc instead of the vendored
  # one from the protobuf-src crate (v27.1), so the generated .pb.cc matches
  # the system libprotobuf headers/ABI.
  perl -i -0pe 's|protoc\(\)\s*\.parent\(\)\s*\.expect\("protoc\(\) returned root path or empty string"\),|std::path::PathBuf::from("/usr/bin"),|' \
    rust/perspective-server/build.rs

  # The cmake walk in build.rs would normally link the vendored libprotobuf.a
  # the bundled build produces. With find_package we link the system .so
  # instead — emitted alongside the system absl dylibs below.
  sed -i 's|cmake_link_deps(\&artifact_dir)?;|cmake_link_deps(\&artifact_dir)?;\n        link_system_protobuf_absl()?;|' \
    rust/perspective-server/build.rs
  cat >> rust/perspective-server/build.rs <<'RUSTEOF'

fn link_system_protobuf_absl() -> Result<(), std::io::Error> {
    // perspective's bundled protobuf picks up the *system* abseil-cpp via
    // find_package() during its cmake build, so libprotobuf.so carries
    // references to abseil's versioned (`lts_…`) mangled names. Link the
    // system protobuf and every system libabsl_*.so dynamically so those
    // references resolve at module-load time. Arch ships these as shared
    // libs under /usr/lib/libabsl_*.so (each a symlink onto a versioned
    // .so.N.M.P).
    println!("cargo:rustc-link-lib=dylib=protobuf");
    let lib_dir = std::path::Path::new("/usr/lib");
    for entry in fs::read_dir(lib_dir)? {
        let path = entry?.path();
        let name = match path.file_name().and_then(|n| n.to_str()) {
            Some(s) => s.to_string(),
            None => continue,
        };
        if let Some(stem) = name.strip_prefix("lib").and_then(|s| s.strip_suffix(".so"))
            && stem.starts_with("absl_")
        {
            println!("cargo:rustc-link-lib=dylib={stem}");
        }
    }
    Ok(())
}
RUSTEOF

  cd rust/perspective-python
  cp ../../LICENSE.md .

  # Graft the prebuilt jupyterlab labextension (JS + perspective-viewer wasm)
  # from the upstream PyPI wheel into our `data` directory so maturin packages
  # it into our wheel under `usr/share/jupyter/labextensions/`. We only take
  # the .data tree from the upstream wheel; everything else (the .so, the
  # python sources, the dist-info) comes from our local build.
  rm -rf "perspective_python-$pkgver.data"
  bsdtar -xf "$srcdir/$_upstream_whl" "perspective_python-$pkgver.data/data/share/jupyter/*"
}

build() {
  cd "$_pkgname-$pkgver/rust/perspective-python"
  export PSP_ROOT_DIR=../..
  # makepkg adds `-flto=auto` to CXX/CFLAGS by default. With only LTO bitcode
  # in the .o files, the rust linker can't see the C++ symbols in libpsp.a et
  # al. and the cdylib comes out without any psp_*/arrow/protobuf symbols.
  # Force fat-LTO objects so each .o carries both the bitcode and normal ELF
  # code; the linker then has something to pull in from the static archives.
  export CFLAGS+=" -ffat-lto-objects"
  export CXXFLAGS+=" -ffat-lto-objects"
  maturin build --release --features=generate-proto,protobuf-src,omit_metadata --interpreter python
}

package() {
  cd "$_pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" rust/target/wheels/*.whl
  install -Dm644 LICENSE.md -t "$pkgdir/usr/share/licenses/$pkgname/"
}
