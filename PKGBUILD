pkgname='jaguar-bin'
pkgver=1.36.2
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('c4fb5987d99f9838b084654840c29f9909d78014b8f9bf9fead2b58fba0eca8a')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
