# Generated by scripts/release/gen_recipes.sh from the v2.0.0 release's checksums.txt.
pkgname=turf-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="TurfLang: a statically typed, LLVM-backed, ahead-of-time compiled language"
arch=('x86_64' 'aarch64')
url="https://github.com/turf-lang/turf-lang"
license=('Apache-2.0')
depends=('glibc')
provides=('turf')
conflicts=('turf')
options=('!strip' '!debug')
source_x86_64=("https://github.com/turf-lang/turf-lang/releases/download/v2.0.0/turf-v2.0.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('d51e99d35724e152e120bc68d33d3c980c271ad65638176dffde9c1323d878dd')
source_aarch64=("https://github.com/turf-lang/turf-lang/releases/download/v2.0.0/turf-v2.0.0-linux-arm64.tar.gz")
sha256sums_aarch64=('57515026881319c68e97b454b6790e25fcd7f4bea42a2c98cb46af7271f8adbf')

package() {
  # One tree, as in the archive: turf finds turfc and lib/std from its real
  # path, so /usr/bin only gets links.
  local dir
  case "$CARCH" in
    aarch64) dir="turf-v2.0.0-linux-arm64" ;;
    *) dir="turf-v2.0.0-linux-x86_64" ;;
  esac
  install -dm755 "$pkgdir/opt/turf" "$pkgdir/usr/bin"
  cp -a "$srcdir/$dir/." "$pkgdir/opt/turf/"
  ln -s /opt/turf/bin/turf "$pkgdir/usr/bin/turf"
  ln -s /opt/turf/bin/turfc "$pkgdir/usr/bin/turfc"
  install -Dm644 "$srcdir/$dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
