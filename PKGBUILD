# Maintainer: fr0stb1rd - fr0stb1rd.gitlab.io

pkgname=subtitle-deduplicator
pkgver=1.0.0
pkgrel=1
pkgdesc="Remove duplicate/ghost entries from SRT subtitle files generated by auto-captioning tools"
arch=('any')
url="https://github.com/fr0stb1rd/subtitle-deduplicator"
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-hatchling')
source=("https://files.pythonhosted.org/packages/source/s/subtitle-deduplicator/subtitle_deduplicator-${pkgver}.tar.gz")
sha512sums=('a5993b915d9503afc70e054451331bd69e6d7150371369f5e3a9a237c612381bdc9ddc3a9bdc1243d8d318601894835cef7dfb00bde6b27c7aebec76142e8301')

build() {
    cd "subtitle_deduplicator-${pkgver}"
    python -m build --wheel --no-isolation
}

package() {
    cd "subtitle_deduplicator-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
