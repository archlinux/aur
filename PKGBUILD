pkgname='jaguar-bin'
pkgver=1.73.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('7e1651e3c8463798202d3a8d4c81f4a1f3315b749a81a0f31f62185b5a16f0e5')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
