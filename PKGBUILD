_author=ROKR
_dist=CatalystX-InjectComponent
pkgname=perl-${_dist@L}
pkgver=0.025
pkgrel=2
pkgdesc='Inject components into your Catalyst application'
arch=('any')
url=https://metacpan.org/release/$_author/$_dist-$pkgver
license=('Artistic-1.0-Perl OR GPL-1.0-or-later')
depends=(
    'perl'
    'perl-catalyst-runtime>=5.8'
    'perl-class-inspector'
    'perl-module-pluggable'
    'perl-parent'
)
makedepends=(
    'perl-extutils-makemaker>=6.30'
    'perl-test-most'
)
options=('!emptydirs')
source=("https://cpan.metacpan.org/authors/id/${_author::1}/${_author::2}/$_author/$_dist-$pkgver.tar.gz")
sha256sums=('86729cce634cd057f9d2774d9b55912fe96ff2f68b029691e6807c7a9b397d71')

build()
{
    cd "$_dist-$pkgver"

    unset PERL_MM_OPT PERL5LIB PERL_LOCAL_LIB_ROOT
    export PERL_MM_USE_DEFAULT=1

    /usr/bin/perl Makefile.PL NO_PACKLIST=1 NO_PERLLOCAL=1
    make
}

check()
{
    cd "$_dist-$pkgver"

    unset PERL5LIB PERL_LOCAL_LIB_ROOT

    make test
}

package()
{
    cd "$_dist-$pkgver"

    unset PERL5LIB PERL_LOCAL_LIB_ROOT

    make install INSTALLDIRS=vendor DESTDIR="$pkgdir"
}
