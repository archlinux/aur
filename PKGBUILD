provides=('turf')
conflicts=('turf')
options=('!strip' '!debug')
source_x86_64=("https://github.com/turf-lang/turf-lang/releases/download/v2.1.1/turf-v2.1.1-linux-x86_64.tar.gz")
sha256sums_x86_64=('e3d46ca618210e505e10f3c525a538aa56091572f6321a89f9d4b294c0307be6')
source_aarch64=("https://github.com/turf-lang/turf-lang/releases/download/v2.1.1/turf-v2.1.1-linux-arm64.tar.gz")
sha256sums_aarch64=('9cbdce20c5daa5b242d3d9af09f9b9445c99117f92c9d6dd870f99d5f1f36087')

package() {
  # One tree, as in the archive: turf finds turfc and lib/std from its real
  # path, so /usr/bin only gets links.
  local dir
  case "$CARCH" in
    aarch64) dir="turf-v2.1.1-linux-arm64" ;;
    *) dir="turf-v2.1.1-linux-x86_64" ;;
  esac
  install -dm755 "$pkgdir/opt/turf" "$pkgdir/usr/bin"
  cp -a "$srcdir/$dir/." "$pkgdir/opt/turf/"
  ln -s /opt/turf/bin/turf "$pkgdir/usr/bin/turf"
  ln -s /opt/turf/bin/turfc "$pkgdir/usr/bin/turfc"
  install -Dm644 "$srcdir/$dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
