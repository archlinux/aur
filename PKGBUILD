# Generated by the nebula-desktop stable release workflow.
pkgname=nebula-desktop-bin
pkgver=0.2.8
pkgrel=1
pkgdesc="Desktop companion app for nebula.gg"
arch=('x86_64')
url="https://github.com/agent-labs-dev/nebula-desktop/tree/main/apps/desktop"
license=('MIT')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'libcups' 'dbus' 'expat' 'gcc-libs' 'glib2' 'glibc' 'gtk3' 'libdrm' 'libnotify' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'libxss' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs' 'libayatana-appindicator')
provides=("nebula-desktop=$pkgver")
conflicts=('nebula-desktop')
options=('!strip')
install='nebula-desktop-bin.install'
source=("Nebula-0.2.8-x64.pacman::https://app-assets.nebula.gg/desktop/stable/0.2.8/Nebula-x64.pacman")
noextract=('Nebula-0.2.8-x64.pacman')
sha256sums=('420d001e9bc8ca3e5d39578c6d2f22582ffc140d9dfa4abda452b295d83830d8')

package() {
  bsdtar -xf "$srcdir/Nebula-0.2.8-x64.pacman" -C "$pkgdir" \
    --exclude='.MTREE' --exclude='.PKGINFO' --exclude='.INSTALL'
  install -d "$pkgdir/usr/bin"
  ln -sf /opt/Nebula/nebula-desktop "$pkgdir/usr/bin/nebula-desktop"
  printf 'aur\n' > "$pkgdir/opt/Nebula/resources/package-type"
}
