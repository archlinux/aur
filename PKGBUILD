pkgver() {
  cd "$_pkgname"
  printf 'r%d.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"

  # ---- Pre-flight: verify uv is available and recent enough ----
  if ! command -v uv >/dev/null 2>&1; then
    error "uv is required to build this package (pacman -S uv)"
  fi
  if ! uv --version | grep -qE '^uv (0\.(4-9|[1-9][0-9]*)|[1-9][0-9]*\.)'; then
    error "uv >= 0.4 required (got: $(uv --version))"
  fi

  # ---- Patch setup.py to use CWD-relative paths (WorkingDirectory=) ----
  patch -p1 -i "$srcdir/setup.py.patch"

  # ---- Patch upstream bug: agent_loop.py uses `Any` without importing it ----
  # Upstream src/agent_loop.py defines
  #   def _resolved_tool_event_name(event: dict[str, Any]) -> str:
  # but the typing import lacks Any, crashing the app at import time
  # (NameError). Fix the import until upstream merges the fix.
  patch -p1 -i "$srcdir/agent_loop.py.patch"
}

build() {
  cd "$_pkgname"

  # ---- Build a relocatable Python 3.12 venv ----
  msg2 "Building relocatable Python 3.12 venv..."
  uv venv --clear --relocatable --python 3.12 --link-mode=copy "$srcdir/venv"

  # ---- Sync the locked pip dependencies into the venv ----
  msg2 "Syncing locked Python dependencies..."
  VIRTUAL_ENV="$srcdir/venv" uv pip sync "$srcdir/requirements.lock"

  # ---- Embed the real Python interpreter and libpython into the venv ----
  # uv venv creates bin/python3.12 as a symlink to the uv-managed
  # Python install, which won't exist on the target system. We
  # materialize a real copy so the venv is portable.
  msg2 "Embedding real Python interpreter into the venv..."
  local py_real
  py_real=$(readlink -f "$srcdir/venv/bin/python3.12")
  local py_root
  py_root=$(dirname $(dirname "$py_real"))
  # Remove the symlinks and copy the real interpreter in
  rm -f "$srcdir/venv/bin/python" "$srcdir/venv/bin/python3" "$srcdir/venv/bin/python3.12"
  cp -f "$py_real" "$srcdir/venv/bin/python3.12"
  ln -sf python3.12 "$srcdir/venv/bin/python3"
  ln -sf python3.12 "$srcdir/venv/bin/python"
  # Copy libpython.so.* and the stdlib so the binary can find them
  # via its $ORIGIN/../lib RPATH
  cp -fa "$py_root/lib"/libpython3.12.so* "$srcdir/venv/lib/" 2>/dev/null || true
  cp -fa "$py_root/lib/python3.12" "$srcdir/venv/lib/" 2>/dev/null || true
  # Update pyvenv.cfg: home should be the venv's own bin
  sed -i "s|^home = .*|home = /usr/lib/odysseus-ai/venv/bin|" "$srcdir/venv/pyvenv.cfg"
  # Also set PYTHONHOME-like prefix via pyvenv prefix
  echo "include-system-site-packages = false" >> "$srcdir/venv/pyvenv.cfg"

  # ---- No JS deps to install ----
  # Upstream's only JS dependency (bombadil) is a docs-build devDep we
  # don't ship, so there is nothing to `npm ci` and no node_modules.

  # ---- Syntax check the Python code (compileall would write .pyc files that
  # embed the absolute makepkg $srcdir path into the package — we do NOT want
  # that. Python's runtime is fast enough to compile on first import, and
  # the heavier smoke test is in check() below.) ----
  msg2 "Running Python syntax check..."
  "$srcdir/venv/bin/python3.12" -c "
import ast, pathlib, sys
errors = []
for p in ['app.py','src','core','routes','services','mcp_servers']:
    for f in pathlib.Path(p).rglob('*.py'):
        try:
            ast.parse(f.read_text(), filename=str(f))
        except SyntaxError as e:
            errors.append(f'{f}: {e}')
if errors:
    for e in errors: print(e, file=sys.stderr)
    sys.exit(1)
print('ok')
" || error "Python syntax check failed"
}

check() {
  cd "$_pkgname"
  msg2 "Verifying venv structure..."
  # ---- Verify the venv's python is a real ELF executable with the right RPATH
  [[ -x "$srcdir/venv/bin/python3.12" ]] || error "venv python3.12 missing or not executable"
  [[ -f "$srcdir/venv/lib/libpython3.12.so.1.0" ]] || error "libpython3.12.so.1.0 missing"
  # ---- Verify the venv's python can boot and self-locate
  "$srcdir/venv/bin/python3.12" -c "import sys; assert sys.prefix == '$srcdir/venv', f'wrong prefix: {sys.prefix}'" \
    || error "venv sys.prefix not pointing at \$srcdir/venv"
  # ---- Verify the key runtime deps actually import cleanly
  # (bcrypt is the one that bit us on a system python 3.14 with no venv;
  # this guarantees the venv's python is the one being used, and that the
  # the lock file resolved all 105 packages.)
  msg2 "Verifying key runtime dependencies import cleanly..."
  "$srcdir/venv/bin/python3.12" -c "
import fastapi, sqlalchemy, pydantic, pydantic_settings, bcrypt, mcp, uvicorn
import chromadb, httpx, cryptography
print('ok')
" || error "key runtime dependency missing from venv"
}

package() {
  cd "$_pkgname"

  # ---- Defensive: strip any __pycache__ dirs that may have been created
  # during sed/compileall/check. .pyc files in here would embed the
  # makepkg $srcdir absolute path into the installed package. ----
  find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  find . -type f -name '*.pyc' -delete 2>/dev/null || true

  # ---- Install app source tree to /usr/lib/odysseus-ai/app ----
  install -dm755 "$pkgdir/usr/lib/odysseus-ai/app"
  # Copy the parts that are actually needed at runtime. There are no JS
  # runtime deps (bombadil is a docs-build devDep), so no node_modules.
  # `static/` is the web UI (login.html, app.js, fonts/, js/, etc.) and
  # MUST be installed; the app reads it via CWD-relative paths
  # (e.g. abs_join(BASE_DIR, "static/login.html")).
  cp -ra app.py setup.py src core routes services mcp_servers scripts integrations \
        companion config licenses static \
        package.json package-lock.json .env.example \
        "$pkgdir/usr/lib/odysseus-ai/app/" || \
    error "failed to copy app tree (upstream layout changed?)"

  # ---- Install the relocatable venv ----
  install -dm755 "$pkgdir/usr/lib/odysseus-ai"
  cp -ra "$srcdir/venv" "$pkgdir/usr/lib/odysseus-ai/venv"
  # Defensive: rewrite any absolute paths that survived --relocatable
  find "$pkgdir/usr/lib/odysseus-ai/venv/bin" -type f \
       -exec sed -i "s|$srcdir/venv|/usr/lib/odysseus-ai/venv|g" {} + 2>/dev/null || true

  # ---- Install systemd unit + sysusers + tmpfiles + logrotate ----
  install -Dm644 "$srcdir/odysseus-ai.service" \
                 "$pkgdir/usr/lib/systemd/system/odysseus-ai.service"
  install -Dm644 "$srcdir/odysseus-ai.sysusers" \
                 "$pkgdir/usr/lib/sysusers.d/odysseus-ai.conf"
  install -Dm644 "$srcdir/odysseus-ai.tmpfiles" \
                 "$pkgdir/usr/lib/tmpfiles.d/odysseus-ai.conf"
  install -Dm644 "$srcdir/odysseus-ai.logrotate" \
                 "$pkgdir/etc/logrotate.d/odysseus-ai"

  # ---- Install the CLI wrappers and libexec symlink script ----
  install -Dm755 "$srcdir/odysseus-ai" \
                 "$pkgdir/usr/bin/odysseus-ai"
  install -Dm755 "$srcdir/odysseus-ai-install-extra" \
                 "$pkgdir/usr/bin/odysseus-ai-install-extra"
  install -Dm755 "$srcdir/odysseus-ai-symlinks.sh" \
                 "$pkgdir/usr/lib/odysseus-ai/libexec/odysseus-ai-symlinks.sh"

  # ---- Install the curated env file (post_install seeds the real one) ----
  install -Dm644 "$srcdir/odysseus-ai.env.dist" \
                 "$pkgdir/usr/share/odysseus-ai/odysseus-ai.env.example"

  # ---- Install documentation ----
  install -Dm644 "$srcdir/README.md" \
                 "$pkgdir/usr/share/doc/odysseus-ai/README.md"
  install -Dm644 "$srcdir/LICENSE" \
                 "$pkgdir/usr/share/licenses/odysseus-ai/LICENSE"

  # ---- Install the static SVG icon ----
  install -Dm644 "$srcdir/odysseus-ai-git.svg" \
                 "$pkgdir/usr/share/pixmaps/odysseus-ai-git.svg"

  # ---- Final pre-flight: verify the package tree is well-formed ----
  [[ -x "$pkgdir/usr/lib/odysseus-ai/venv/bin/python3.12" ]] || error "venv python3.12 missing"
  [[ -f "$pkgdir/usr/lib/odysseus-ai/app/app.py" ]]          || error "app.py missing"
  [[ -f "$pkgdir/usr/lib/systemd/system/odysseus-ai.service" ]] || error "unit file missing"
  [[ -f "$pkgdir/usr/bin/odysseus-ai" ]]                    || error "CLI wrapper missing"

  # ---- Defensive: strip every __pycache__ from the entire $pkgdir tree ----
  # Why this matters: the venv's site-packages .pyc files (from `uv pip sync`)
  # embed the absolute makepkg $srcdir path (e.g.
  # /home/<user>/.cache/yay/odysseus-ai-git/src/venv/lib/.../site-packages/.../).
  # The source tree's .pyc files would similarly embed the $srcdir if any
  # module was ever imported during build/check. Both of these leak the
  # build username + absolute layout into the installed package, and the
  # embedded paths are wrong on the target system anyway (target venv lives
  # at /usr/lib/odysseus-ai/venv/, not at the build's $srcdir/venv). Python
  # recompiles on first import with the correct path, so stripping is safe.
  find "$pkgdir" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  find "$pkgdir" -type f -name '*.pyc' -delete 2>/dev/null || true
}
