pkgname=quadrant-bin
_pkgname=Quadrant
pkgver=26.8.0
pkgrel=1
pkgdesc="An easy way to manage your Minecraft modpacks, written in React and Rust. (Prebuilt version)"
arch=(
    'aarch64'
    'x86_64'
)
url="https://usequadrant.dev/"
_ghurl="https://github.com/QuadrantMC/quadrant"
license=('MPL-2.0')
provides=("${pkgname%-bin}=${pkgver}")
conflicts=("${pkgname%-bin}")
depends=(
    'gtk3'
    'gdk-pixbuf2'
    'webkit2gtk-4.1'
    'libappindicator'
    'libsecret'
)
options=('!strip')
source_aarch64=("${pkgname%-bin}-${pkgver}-aarch64.rpm::${_ghurl}/releases/download/v${pkgver}-stable/${_pkgname}-${pkgver}-stable-1.aarch64.rpm")
source_x86_64=("${pkgname%-bin}-${pkgver}-x86_64.rpm::${_ghurl}/releases/download/v${pkgver}-stable/${_pkgname}-${pkgver}-stable-1.x86_64.rpm")
sha256sums_aarch64=('3cbb5d2841070744ec09e0a9d9c25b98513bffca032018652c1ca323b8067380')
sha256sums_x86_64=('85f78de248b7c53d61e644ed6d81c30b023b381352841243a733a5681ea5738a')

prepare() {
    local desktop="${srcdir}/usr/share/applications/${_pkgname}.desktop"
    # Rename the bundled quadrant_next binary/icon references to `quadrant`...
    sed -i "s/${pkgname%-bin}_next/${pkgname%-bin}/g" "$desktop"
    # ...and disable the built-in updater on the launcher, since on Arch the app
    # is kept up to date through the AUR (inserts --noupdater right after the
    # executable, before the %u placeholder).
    sed -i -E 's|^(Exec=\S+)|\1 --noupdater|' "$desktop"
}

package() {
    install -Dm755 "${srcdir}/usr/bin/${pkgname%-bin}_next" "${pkgdir}/usr/bin/${pkgname%-bin}"
    cp -a "${srcdir}/usr/lib" "${pkgdir}/usr"
    find "${srcdir}" -type f \( -name "*.png" -o -name "*.svg" \) -path "*share/icons/*" | while read -r _i; do
        _extension="${_i##*.}"
        _icon_path="${_i#*share/icons/}"
        _target_dir="/usr/share/icons/$(dirname "${_icon_path}")"
        install -Dm644 "${_i}" "${pkgdir}${_target_dir}/${pkgname%-bin}.${_extension}"
    done
    install -Dm644 "${srcdir}/usr/share/applications/${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname%-bin}.desktop"
}
