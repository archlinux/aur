license=('GPL3')
source=("${_pkgbin}-${pkgver}-${pkgrel}::${url}/releases/download/${pkgver}/${_pkgbin}")
sha512sums=('65aadaf315ad1478c05618327d6339a621463eab3406223f6a33fd0c15943d33e6b263da1555cde3b53726dd82d785474d7d9ee832bb9ec5ee0515cb51eb3b7f')
depends=(libxcrypt-compat ffmpeg)

package(){
  # Install Binary
  install -Dm755 ${_pkgbin}-${pkgver}-${pkgrel} ${pkgdir}/usr/bin/$_pkgbin
