sha256sums_aarch64=('a4abb91cf6d21775014793a2aae260877c3dfad59b4b876ab3872f4d193ca460'
                    'a5d13055ba968c3cc8ac449bdc7ecfc705aec2c95c9699ed79ac5c23b53270ef'
