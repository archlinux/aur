# Generated by .github/workflows/release.yml from packaging/aur/PKGBUILD.in; edit the template.
pkgname=creativecraft-bin
pkgver=0.3.3
pkgrel=1
pkgdesc="One home for open-source creative apps: installer, cloud sync and an AI assistant over MCP"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/CreativeCraft"
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi' 'libglvnd' 'vulkan-icd-loader' 'hicolor-icon-theme')
optdepends=('git: install apps from source'
            'rust: install apps from source'
            'noto-fonts: symbols in the assistant terminal')
provides=('creativecraft')
conflicts=('creativecraft')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/creativecraft-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/creativecraft-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('6077191be8d89741b445a419478f6e8854ec93e35c44c9413d314b717494565c')
sha256sums_aarch64=('a4244dad73c92ed3857fb0de5857b0dc3af6c5b647450b653f9235259e75f7dd')

package() {
  cd "creativecraft-$pkgver-linux-$CARCH"
  install -Dm755 creativecraft "$pkgdir/usr/bin/creativecraft"
  install -Dm755 creativecraft-cli "$pkgdir/usr/bin/creativecraft-cli"
  install -Dm644 share/applications/org.creativecraft.CreativeCraft.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/metainfo/org.creativecraft.CreativeCraft.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  for s in 128 256 512; do
    install -Dm644 "share/icons/hicolor/${s}x${s}/apps/org.creativecraft.CreativeCraft.png" -t "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps"
  done
  install -Dm644 LICENSE-MIT LICENSE-APACHE NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
