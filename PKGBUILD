sha256sums_aarch64=('0938784056c7233096e82dd1f42d525ca2bea718a62758acaceb6b4bd03ccbc4'
                    '45fdd99667143835a0c94ccf363364988ecbd93fd2d24a7732c815d4af124f9c'
