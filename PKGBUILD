# Maintainer: broisnees
# Generated by .github/workflows/nightly.yml (update-aur) on each nightly
# build, which fills in the version, the .deb checksum and the commit.
pkgname=stroke-nightly-bin
pkgver=3.8.4.nightly.202611250714
pkgrel=1
pkgdesc="Stroke Nightly: the daily build of the native database client, installed next to Stroke"
arch=('x86_64')
url="https://stroke.click"
license=('LicenseRef-Stroke')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=('stroke-nightly')
conflicts=('stroke-nightly')
options=('!strip' '!debug')
# The nightly release is replaced each night under the same tag, so the file
# is saved under this build's version and pinned by its checksum.
source=("stroke-nightly-${pkgver}.deb::https://github.com/stroke-app/stroke/releases/download/nightly/stroke-nightly_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/stroke-app/stroke/3c4f38de3db81d36a68aabed23dc94e3bb55ed9f/LICENSE")
sha256sums=('0788143231e015265b148eb4f69b611301abf0c02776f495ad6cdac20d5e8e95'
            'SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  # The .deb already names everything stroke-nightly; only the menu category
  # is empty.
  sed -i 's/^Categories=$/Categories=Development;Database;/' \
    "$pkgdir/usr/share/applications/Stroke Nightly.desktop"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
