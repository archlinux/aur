  install -dm755 "$dest"
  bsdtar -xf "$srcdir/aimp-skin-bw-minimal-3.archive" -C "$dest"
  find "$dest" -mindepth 2 -type f -exec mv -t "$dest" {} +
  find "$dest" -mindepth 1 -type d -empty -delete
  find "$dest" -type d -exec chmod 755 {} +
  find "$dest" -type f -exec chmod 644 {} +
}
