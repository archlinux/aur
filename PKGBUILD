_pkgbin=ytdl-sub
pkgname=$_pkgbin-bin
pkgver="2026.06.23"
pkgrel=1
pkgdesc="Automate downloading and metadata generation with yt-dlp"
arch=('x86_64')
url="https://github.com/jmbannon/ytdl-sub"
license=('GPL3')
source=("${_pkgbin}-${pkgver}-${pkgrel}::${url}/releases/download/${pkgver}/${_pkgbin}")
sha512sums=('ee0805f87debe82b8a0448adfb496ebc5ecc524bc54c01e6f6e011a1c368e1ec55e77b324ba2c92b909291a32e31b3a08b3076d03f31a0fca6fdfbc11f25db7b')
depends=(libxcrypt-compat ffmpeg)

package(){
  # Install Binary
  install -Dm755 ${_pkgbin}-${pkgver}-${pkgrel} ${pkgdir}/usr/bin/$_pkgbin
}
