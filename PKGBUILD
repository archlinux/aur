pkgname='jaguar-bin'
pkgver=1.41.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('4352acc3b8bf10062fd24cd8106e094dc7f30ee84e3e25a13d9505849f0e81ad')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
