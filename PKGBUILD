pkgname='jaguar-bin'
pkgver=1.46.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('a12d7be1d68a4c25c1aae72cfcb50d8f1f6aefc5c3c3029a9eda17f06e9b2840')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
