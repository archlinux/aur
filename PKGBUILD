sha256sums_aarch64=('1cf172b750e7dafdac2a0c146a317fb41026f2e7a751fce3edd47d4d27ccc8d4'
                    '186de3fe72c0afd1204121ff4dd37cf29e9cff6f73ca507eb02f5b0bc45acfb8'
