#
# Generated by scripts/render_packaging.py from packaging/aur/PKGBUILD.in in
# https://github.com/l1a/dog. Change the template there, not this file. The version and the source
# checksum are the only release-specific values: they are supplied when the package is published,
# from the tag and from the tarball actually downloaded, so nothing in the repository records a
# release and nothing can drift from one.

pkgname=dogdns
pkgver=0.7.12
pkgrel=1
pkgdesc="Command-line DNS client with colourful output, DoT, DoH and JSON"
arch=('x86_64' 'aarch64')
url="https://github.com/l1a/dog"
license=('GPL-3.0-or-later')
depends=('gcc-libs')
# `cargo` is provided by the `rust` package. The man page is Markdown in the tree and is
# rendered here rather than committed.
makedepends=('cargo' 'pandoc')
# ring (via rustls) compiles C and assembly through the `cc` crate. makepkg's default LTO flags make
# that C code GCC LTO bytecode, which Rust's linker cannot read, and the build fails with
# `undefined symbol: ring_core_*` at the final link. Rust packages with C dependencies disable LTO.
options=('!lto')
# The installed binary is `dog`, which is also what the official `dog` package ships (the
# unmaintained upstream tool), so the two cannot be installed together.
provides=('dog')
conflicts=('dog')
# The GitHub tag tarball unpacks to dog-$pkgver/ (the repository is `dog`, the package `dogdns`).
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c9f7a3a046f9e5862454e5e48ada70aa812a9d82ef16f296e605238b3eab2e34')

prepare() {
  cd "dog-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Fetch now so the build can run with --frozen (offline, and pinned by Cargo.lock).
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "dog-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release

  # The same substitution `just man` does; man/dog.1.md carries a literal VERSION placeholder.
  sed "s/{{VERSION}}/$pkgver/g" man/dog.1.md | pandoc --standalone -f markdown -t man > "$srcdir/dog.1"

  # Generated by the binary just built, so they cannot disagree with its actual CLI.
  ./target/release/dog --completions bash > "$srcdir/dog.bash"
  ./target/release/dog --completions zsh  > "$srcdir/_dog"
  ./target/release/dog --completions fish > "$srcdir/dog.fish"
}

check() {
  cd "dog-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # Hermetic: the suite parses arguments and renders output; it makes no DNS queries.
  cargo test --frozen
}

package() {
  cd "dog-$pkgver"
  install -Dm755 target/release/dog "$pkgdir/usr/bin/dog"
  install -Dm644 "$srcdir/dog.1" "$pkgdir/usr/share/man/man1/dog.1"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 "$srcdir/dog.bash" "$pkgdir/usr/share/bash-completion/completions/dog"
  install -Dm644 "$srcdir/_dog"     "$pkgdir/usr/share/zsh/site-functions/_dog"
  install -Dm644 "$srcdir/dog.fish" "$pkgdir/usr/share/fish/vendor_completions.d/dog.fish"
}
