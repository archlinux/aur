# >>>META-END:deps>>>

makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-wheel'
  'python-uv-build'
)
source=(
  "${_name}::git+${url}.git#tag=$pkgver"
)
sha256sums=('17c077c4601c8ff85d98ee78962de89f0357f7ff50b2cb1ba59d46fbca995ced')

prepare() {
  cd "${_name}"
  sed -i '/uv_build/s/,<[0-9.]\+//' pyproject.toml
}

build() {
  cd "${_name}"
  python -m build --wheel --no-isolation
}

package_python-py-key-value-aio() {
  cd "${_name}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgbase/README.md"
}

