pkgname=datui-bin
pkgver=0.2.39
pkgrel=1
pkgdesc="Data Exploration in the Terminal"
url="https://github.com/derekwisong/datui"
license=("MIT")
arch=("x86_64")
provides=("datui")
conflicts=("datui")
depends=("fontconfig")
source=("https://github.com/derekwisong/datui/releases/download/v$pkgver/datui-$pkgver-x86_64.tar.gz")
sha256sums=("453890a1694a486479578fde6cea15f017cf2fe812416516db5c016351dd2e75")

package() {
    install -Dm755 datui -t "$pkgdir/usr/bin"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "target/release/datui.1.gz" "$pkgdir/usr/share/man/man1/datui.1.gz"
}
