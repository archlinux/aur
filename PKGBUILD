pkgname='jaguar-bin'
pkgver=1.36.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('f8bf3dec1b6ccd52e5494b62d3576138182bf5533f53f54a49ea955a263847fb')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
