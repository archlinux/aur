sha256sums_aarch64=('bcb1540323e671fb65a58d1bf5786e04f7981fdd8b6b845632a9a781d4f4ad61'
                    'd4d68eeffb79e3ea6e65d86644d135d97eba87c429bcda60b4f8520128ce8dc9'
