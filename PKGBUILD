pkgname=turf-bin
pkgver=2.2.0
pkgrel=1
pkgdesc="TurfLang: a statically typed, LLVM-backed, ahead-of-time compiled language"
arch=('x86_64' 'aarch64')
url="https://github.com/turf-lang/turf-lang"
license=('Apache-2.0')
depends=('glibc')
provides=('turf')
conflicts=('turf')
options=('!strip' '!debug')
source_x86_64=("https://github.com/turf-lang/turf-lang/releases/download/v2.2.0/turf-v2.2.0-linux-x86_64.tar.gz")
sha256sums_x86_64=('576e20976e5d43b5001af7c8a30100abd6b37502bfe1c428cc1ff58e26bc1f72')
source_aarch64=("https://github.com/turf-lang/turf-lang/releases/download/v2.2.0/turf-v2.2.0-linux-arm64.tar.gz")
sha256sums_aarch64=('e7e3e16a61f02b6f3cca2805111a5c1d663ae847a29ebc349d7105846e0b0bbd')

package() {
  # One tree, as in the archive: turf finds turfc and lib/std from its real
  # path, so /usr/bin only gets links.
  local dir
  case "$CARCH" in
    aarch64) dir="turf-v2.2.0-linux-arm64" ;;
    *) dir="turf-v2.2.0-linux-x86_64" ;;
  esac
  install -dm755 "$pkgdir/opt/turf" "$pkgdir/usr/bin"
  cp -a "$srcdir/$dir/." "$pkgdir/opt/turf/"
  ln -s /opt/turf/bin/turf "$pkgdir/usr/bin/turf"
  ln -s /opt/turf/bin/turfc "$pkgdir/usr/bin/turfc"
  install -Dm644 "$srcdir/$dir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
