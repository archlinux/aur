# Maintainer: i am piou <i.am.piou@gmail.com>

pkgname=hatter-icon-theme
pkgver=4.2
pkgrel=1
pkgdesc="Rounded-square icon theme for GNOME with colour and Yaru variants"
arch=('any')
url="https://github.com/Mibea/Hatter"
license=('GPL-3.0-only')
depends=('hicolor-icon-theme' 'gtk-update-icon-cache')
makedepends=('rsync')
optdepends=('adwaita-icon-theme: fallback for icons not covered by Hatter')
options=('!strip')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Mibea/Hatter/archive/refs/tags/V$pkgver.tar.gz")
sha256sums=('e82a1a5a8049c0778b454fbb2a746cb344d65ad2f59ad3b715106ea1b7fea095')

build() {
  cd "Hatter-$pkgver"
  # Builds Hatter, the nine colour variants and the nine Yaru variants
  # (rsync is used for the Yaru recolouring).
  ./build.sh --all --dest "$srcdir/dist" --whitespace=ignore
}

package() {
  cd "Hatter-$pkgver"
  install -dm755 "$pkgdir/usr/share/icons"
  cp -a "$srcdir/dist/." "$pkgdir/usr/share/icons/"

  # Development helper shipped inside the generated theme, useless at runtime.
  find "$pkgdir/usr/share/icons" -name 'gen-index-theme.sh' -delete
  # Regenerated by the pacman hook provided by gtk-update-icon-cache.
  find "$pkgdir/usr/share/icons" -name 'icon-theme.cache' -delete

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 AUTHORS "$pkgdir/usr/share/licenses/$pkgname/AUTHORS"
}
