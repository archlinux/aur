# PKGBUILD - Arch User Repository recipe for hyprtilt
#
# Builds a release of hyprtilt from the source archive of its tag,
# following the Arch Linux Rust package guidelines, runs the test suite,
# and installs the binary, the man page, shell completions for bash, zsh
# and fish, the license and the README. The man page and the completions
# are generated by the freshly built binary.
#
# The release workflow sets pkgver and the checksum and publishes the
# recipe (scripts/publish-aur.sh); the checksum here stays SKIP until the
# first release exists.
#
# Usage: makepkg -si
#        makepkg --printsrcinfo > .SRCINFO   (after every change)
#
# shellcheck shell=bash disable=SC2034,SC2154,SC2164

pkgname=hyprtilt
pkgver=0.1.0
pkgrel=1
pkgdesc='TUI and CLI for Hyprland monitor layout that edits your Lua or hyprlang config in place'
arch=('x86_64' 'aarch64')
url='https://github.com/FPGArtktic/hyprtilt'
license=('GPL-3.0-only')
depends=('glibc' 'libgcc')
makedepends=('cargo')
optdepends=(
	'hyprland: the compositor whose monitors hyprtilt arranges'
	'lua: syntax check of Lua configuration files before hyprtilt writes them'
)
# The release profile strips the binary (Cargo.toml, profile.release), so a
# debug package would be empty.
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('21df6cc2a385fed4cb6f60d87956792f24a5d59ff665c04d1bd822f9e260e3af')

prepare()
{
	cd "${pkgname}-${pkgver}"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build()
{
	local out

	cd "${pkgname}-${pkgver}"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release --package hyprtilt
	out=target/assets
	mkdir -p "${out}"
	target/release/hyprtilt man >"${out}/hyprtilt.1"
	target/release/hyprtilt completions bash >"${out}/hyprtilt.bash"
	target/release/hyprtilt completions zsh >"${out}/_hyprtilt"
	target/release/hyprtilt completions fish >"${out}/hyprtilt.fish"
}

check()
{
	cd "${pkgname}-${pkgver}"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo test --frozen --workspace
}

package()
{
	local out=target/assets

	cd "${pkgname}-${pkgver}"
	install -Dm755 target/release/hyprtilt "${pkgdir}/usr/bin/hyprtilt"
	install -Dm644 "${out}/hyprtilt.1" "${pkgdir}/usr/share/man/man1/hyprtilt.1"
	install -Dm644 "${out}/hyprtilt.bash" "${pkgdir}/usr/share/bash-completion/completions/hyprtilt"
	install -Dm644 "${out}/_hyprtilt" "${pkgdir}/usr/share/zsh/site-functions/_hyprtilt"
	install -Dm644 "${out}/hyprtilt.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/hyprtilt.fish"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
