pkgname='jaguar-bin'
pkgver=1.66.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('c7314ea28f21e4964a2d7d4394f11d62a8168a6e63efa3d1295a1df4a32a9b87')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
