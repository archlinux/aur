license=('GPL3')
source=("${_pkgbin}-${pkgver}-${pkgrel}::${url}/releases/download/${pkgver}/${_pkgbin}")
sha512sums=('f4356c664eadc0fa340cc9d78412fa044b649488fb355cdafa6929eafc52d10dd5669b75c335312185958f6043a310225a35e76955725cc370a850538cdcadff')
depends=(libxcrypt-compat ffmpeg)

package(){
  # Install Binary
  install -Dm755 ${_pkgbin}-${pkgver}-${pkgrel} ${pkgdir}/usr/bin/$_pkgbin
}
