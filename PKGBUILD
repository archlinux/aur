license=('MIT')
depends=('git' 'pacman-contrib')
optdepends=('github-cli: prove a worktree finished from its merged pull request' 'expac: size orphaned packages' 'libnotify: desktop notifications for low disk and pending approvals' 'uv: prune the uv cache')
provides=('keeper')
conflicts=('keeper')
options=('!strip')
source=("keeper-${pkgver}.tar.gz::https://github.com/cjber/keeper/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('1ffa767cb6720c89c095c70dbd99d682a727594930bb95e3cc0fb54d51f70d56')
