pkgname=devserial-bin
pkgver=0.1.9
pkgrel=1
pkgdesc='MCP server bridging serial hardware to LLMs via SQLite-backed buffer'
arch=('x86_64' 'aarch64')
url='https://github.com/metaneutrons/devserial'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
provides=('devserial')
conflicts=('devserial')
options=('!strip')
source_x86_64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.9/devserial-0.1.9-x86_64-unknown-linux-gnu.tar.gz')
sha256sums_x86_64=('9c0c3dad4882ff2bd1076288008edf50a39d2cd5a1f007d54ea4887a19e5fb0d')
source_aarch64=('https://github.com/metaneutrons/devserial/releases/download/devserial-v0.1.9/devserial-0.1.9-aarch64-unknown-linux-gnu.tar.gz')
