# Maintainer: Ron Brand <ronb1964@gmail.com>
pkgname=python-onnx-asr
_name=onnx_asr
pkgver=0.12.0
pkgrel=1
pkgdesc="Speech recognition with ONNX models (Parakeet, Whisper, GigaAM and others)"
arch=('any')
url="https://github.com/istupakov/onnx-asr"
license=('MIT')
depends=('python' 'python-numpy' 'python-onnxruntime')
optdepends=('python-huggingface-hub: download models from the Hugging Face Hub')
# The build hook generates the preprocessors as .onnx files with onnxscript
# and ml-dtypes, so those two are needed to build but not to run.
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs'
             'python-onnxscript' 'python-ml-dtypes')
# Upstream's conftest.py imports huggingface_hub and test_build.py imports onnx.
checkdepends=('python-pytest' 'python-huggingface-hub' 'python-onnx')
source=("https://files.pythonhosted.org/packages/source/o/onnx-asr/${_name}-${pkgver}.tar.gz")
sha256sums=('c1fcacddbced392f9f769ed5c6223f4ce739a6e4549346de33b9b520d4ead713')

build() {
    cd "${_name}-${pkgver}"
    # Fixes the version so it never depends on git or the sdist's PKG-INFO.
    SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver" python -m build --wheel --no-isolation
}

# Most of upstream's tests download models from the Hugging Face Hub or
# compare against torch, NeMo and Whisper, which a build has neither. These
# three need neither, and the heredoc runs the preprocessor Parakeet uses,
# generated by the build hook, from the wheel just built. The Hub is offline
# with a cache of its own, so nothing is downloaded: test_file_not_found_error
# then passes on the Hub's LocalEntryNotFoundError, a FileNotFoundError.
# test_cli_run transcribes with whisper-base when python-soundfile is
# installed, a model an offline build doesn't have.
check() {
    cd "${_name}-${pkgver}"
    local site_packages
    site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
    rm -rf test_dir
    python -m installer --destdir=test_dir dist/*.whl
    # The wheel just built, and the sdist's root for the top-level
    # preprocessors package test_build.py imports, which the wheel leaves out.
    export PYTHONPATH="$PWD/test_dir$site_packages:$PWD"
    export HF_HUB_OFFLINE=1 HF_HOME="$PWD/test_dir/hf-home"
    python -m pytest -p no:cacheprovider tests/onnx_asr/test_cli.py \
        tests/onnx_asr/test_manager.py tests/preprocessors/test_build.py \
        --deselect tests/onnx_asr/test_cli.py::test_cli_run
    python - <<'EOF'
import numpy as np
from onnx_asr.preprocessors.preprocessor import OnnxPreprocessor

features, _ = OnnxPreprocessor("nemo128", {})(np.zeros((1, 16000), np.float32),
                                              np.array([16000]))
assert features.shape[1] == 128, features.shape
EOF
}

package() {
    cd "${_name}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
