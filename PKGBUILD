pkgname='jaguar-bin'
pkgver=1.43.3
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('4434f3dd4c8c47e1a8cefbcc01c0ef13d65525742cc67f034170bcc08309bb94')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
