pkgname=acnf
pkgver=1.0.0
pkgrel=1
pkgdesc="Advanced command-not-found handler with hook support and gettext translations"
arch=('any')
license=('MIT')
depends=('bash' 'gettext')
makedepends=('gettext')
source=("acnfctl.bash"
        "handler.bash"
        "locales.tar.gz"
	"README.md"
	"LICENSE")
sha256sums=('bffc622f10427afcd86627843f1563a06ddf36f07eb99b41e243cdba1cd17645'
            '2f8155223d412b01f71b85f8f297d96209f25b50fb3fc5a8d7978ab76884b412'
            '9a11f995d58016896dca15562b98071b4b2eb2100a0cc8038941d91529c0699c'
            '4f7a4b9b02a3c46390f1020e4a3bbfa06b535fb5b76d8fa544c313b376eed9b8'
            'ccb3be7fed18d0972a9ced5968c5bb686d0c779505483831aa72d28e2a434848')

prepare() {
    tar -xzf "$srcdir/locales.tar.gz" -C "$srcdir"
    cd "$srcdir/locales"

    # Compile .po → .mo for all languages
    for lang in */; do
        lang="${lang%/}"
        mkdir -p "$srcdir/locales/$lang/LC_MESSAGES"
        msgfmt "$srcdir/locales/$lang/LC_MESSAGES/acnfctl.po" \
            -o "$srcdir/locales/$lang/LC_MESSAGES/acnfctl.mo"
        msgfmt "$srcdir/locales/$lang/LC_MESSAGES/acnf_arch_handler.po" \
            -o "$srcdir/locales/$lang/LC_MESSAGES/acnf_arch_handler.mo"
    done
}

package() {
    # Install main scripts
    install -Dm755 "$srcdir/acnfctl.bash" "$pkgdir/usr/bin/acnfctl"
    install -Dm755 "$srcdir/handler.bash" "$pkgdir/usr/share/acnf/handler.bash"

    # Install README & LICENSE
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Install hooks directory (empty by default)
    install -d "$pkgdir/usr/share/acnf/hooks"

    # Install translations
    for lang in "$srcdir"/locales/*/; do
        langname=$(basename "$lang")
        install -d "$pkgdir/usr/share/locale/$langname/LC_MESSAGES"
        install -m644 "${lang}LC_MESSAGES/acnfctl.mo" \
                      "$pkgdir/usr/share/locale/$langname/LC_MESSAGES/acnfctl.mo"
        install -m644 "${lang}LC_MESSAGES/acnf_arch_handler.mo" \
                      "$pkgdir/usr/share/locale/$langname/LC_MESSAGES/acnf_arch_handler.mo"
    done

    install -d "$pkgdir/etc/profile.d"
    echo \
"# Auto-generated by 'acnf'
export ACNF_INSTALL_DIR=\"/usr/share/acnf\"
export ACNF_HOOK_DIR=\"\$ACNF_INSTALL_DIR/hooks\"" > "$pkgdir/etc/profile.d/acnf.sh"
    
    chmod 755 "$pkgdir/etc/profile.d/acnf.sh"
}
