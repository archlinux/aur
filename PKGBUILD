pkgname='jaguar-bin'
pkgver=1.44.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('d6b6a35ebdf8aee99113a331c42bee35d01832d5988c1e25504c206f7dbe8aef')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
