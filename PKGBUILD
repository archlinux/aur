# Generated by scripts/package-metadata.sh; edit PKGBUILD.in instead.
pkgname=yoo-bin
pkgver=1.1.1
pkgrel=1
pkgdesc='Local CLI for project, Git, and development environment information'
arch=('x86_64')
url='https://github.com/nihitdev/yo-cli'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
optdepends=('git: Git repository information')
provides=('yoo')
conflicts=('yoo')
source=("$url/releases/download/v$pkgver/yoo-v$pkgver-linux-x86_64.tar.gz")
sha256sums=('c842c0b09cbbab21e2e1b1972771c2d0a55af957e699f1d70402f303badde9a3')

package() {
  cd "$srcdir/yoo-v$pkgver-linux-x86_64"
  install -Dm755 yoo "$pkgdir/usr/bin/yoo"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  chmod +x yoo
  ./yoo completions bash > yoo.bash
  ./yoo completions zsh > _yoo
  ./yoo completions fish > yoo.fish
  install -Dm644 yoo.bash "$pkgdir/usr/share/bash-completion/completions/yoo"
  install -Dm644 _yoo "$pkgdir/usr/share/zsh/site-functions/_yoo"
  install -Dm644 yoo.fish "$pkgdir/usr/share/fish/vendor_completions.d/yoo.fish"
}
