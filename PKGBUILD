# Maintainer: Mathieu Grenet <mathieu@mgth.fr>
#
# orender — the Omniphony spatial audio engine: the `orender` CLI renderer plus
# the C shared library (liborender.so) consumed by embedded hosts such as the
# mpv `ad_orender` decoder (see the separate mpv-omniphony repo) or any C host.
#
# The format-decoder bridge is a runtime dlopen plugin and ships separately as
# `harletty-bridge` (Apache-2.0). It is optional: without it the engine still
# renders PCM input; the bridge adds compressed/object-audio decoding.

pkgname=orender
pkgver=0.5.1
pkgrel=1
pkgdesc="Omniphony spatial audio engine (orender CLI + liborender.so)"
arch=('x86_64')
url="https://github.com/mgth/Omniphony"
license=('GPL-3.0-only')
depends=('gcc-libs' 'pipewire')
optdepends=('harletty-bridge: decode compressed/object-audio formats via the orender bridge plugin')
makedepends=('rust' 'cargo')
# !lto: makepkg's -flto=auto CFLAGS turn the cc-built vendored Lua (mlua) into
# GCC LTO bitcode that the Rust linker cannot read (undefined lua_* symbols).
options=('!lto')
# Known build-time warning: makepkg reports a $srcdir reference in the
# binaries. It is the env!("CARGO_MANIFEST_DIR") dev-checkout fallback in
# orender_engine's layouts search list (virtual_bed.rs) — a dead path on user
# machines; the packaged /usr/share/orender/layouts candidate is used instead.
source=("omniphony-$pkgver.tar.gz::https://github.com/mgth/Omniphony/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('8bb07c9b014b5979d6b1420c952b92eebd7f9e133cd6b9734fb010a16583deaa')

# Workspace inside the extracted Omniphony source tree.
_src="Omniphony-$pkgver"
_workspace="$_src/omniphony-renderer"

build() {
    cd "$srcdir/$_workspace"
    # Keep $srcdir out of the binary (panic-location paths) for reproducibility.
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=src"
    # CLI (workspace root package, bin `orender`) + the cdylib (orender_ffi).
    cargo build --release -p omniphony-renderer -p orender_ffi
}

package() {
    cd "$srcdir/$_workspace"

    # The CLI renderer.
    install -Dm755 target/release/orender "$pkgdir/usr/bin/orender"

    # Versioned shared object + SemVer symlinks. The release cdylib already
    # carries DT_SONAME = liborender.so.0 (see orender_ffi/build.rs).
    install -Dm755 target/release/liborender.so \
        "$pkgdir/usr/lib/liborender.so.$pkgver"
    ln -s "liborender.so.$pkgver" "$pkgdir/usr/lib/liborender.so.0"
    ln -s "liborender.so.0"       "$pkgdir/usr/lib/liborender.so"

    # Public C header (generated by cbindgen during the build).
    install -Dm644 orender_ffi/include/orender.h \
        "$pkgdir/usr/include/orender.h"

    # pkg-config file (substitute @PREFIX@ / @VERSION@ from the template).
    sed -e "s|@PREFIX@|/usr|g" -e "s|@VERSION@|$pkgver|g" \
        orender_ffi/orender.pc.in > "$srcdir/orender.pc"
    install -Dm644 "$srcdir/orender.pc" \
        "$pkgdir/usr/lib/pkgconfig/orender.pc"

    # Speaker layouts (incl. legacy 2D beds). The engine's virtual-bed fallback
    # looks here (/usr/share/orender/layouts) when there is no cwd-relative
    # `layouts/`.
    for f in "$srcdir/$_src"/layouts/*.yaml; do
        install -Dm644 "$f" "$pkgdir/usr/share/orender/layouts/${f##*/}"
    done
    for f in "$srcdir/$_src"/layouts/legacy/*.yaml; do
        install -Dm644 "$f" "$pkgdir/usr/share/orender/layouts/legacy/${f##*/}"
    done

    # NB: no config is installed — every host (CLI, Studio, mpv's ad_orender)
    # reads the SAME per-user config (~/.config/omniphony/config.yaml), which
    # carries render.bridge_path when a decoder bridge is installed.

    # License text.
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
