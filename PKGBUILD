pkgname=ttf-dotgothic16
pkgver=0.1.101
pkgrel=1
pkgdesc='Dotgothic 16 is based on the old 16x16 Gothic bitmap font that can best recreate the feel of pixel fonts from old video games, cell phones and computer screens on print.'
arch=('any')
url='https://github.com/fontworks-fonts/DotGothic16/'
license=('OFL')
source=("https://github.com/fontworks-fonts/DotGothic16/raw/14517183ab2f75e8bccafc5a0bff6685d268c687/fonts/ttf/DotGothic16-Regular.ttf")
sha256sums=('155da8f318553c11d9dffc2affbc7c2114c6a46f9740bcf639ed5568af92be71')

package() {
    install -Dm644 "DotGothic16-Regular.ttf" "${pkgdir}/usr/share/fonts/TTF/DotGothic16-Regular.ttf"
}
