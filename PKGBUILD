sha256sums_aarch64=('d4e829eac2cd09e406b051d9f8757120f80c3f1cbd1d4c15e4acbe0f4d4493d2'
                    'fb510e01b11cc0ea550f3122c0ce833c8ed2004ab0ad22066927d3d060164a81'
