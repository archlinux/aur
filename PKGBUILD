_pkgname=repos-manager
pkgver=1.1.0
pkgrel=1
pkgdesc='Clone and update every Git repo you can access on GitHub, GitLab, Forgejo, Bitbucket, Sourcehut, OneDev, Radicle and plain git servers (prebuilt static binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/Dxsk/repos-manager'
license=('MIT')
depends=('git')
optdepends=('github-cli: GitHub provider'
            'glab: GitLab provider'
            'tea: Forgejo, Gitea and Gogs login'
            'hut: Sourcehut provider'
            'openssh: plain git server discovery')
provides=("$_pkgname")
conflicts=("$_pkgname")
_base="$url/releases/download/v$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_base/$_pkgname-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_base/$_pkgname-aarch64-unknown-linux-musl.tar.gz")
