package_python-onnxruntime-core-bin() {
    pkgdesc='The Python module of ONNX Runtime, the cross-platform inference engine for ONNX models (onnxruntime-core) (prebuilt)'
    depends=(
        'onnxruntime-core=1.29.0-7'
        'glibc'
        'libgcc'
        'libstdc++'
        'nccl'
        'python-numpy'
        'python-flatbuffers'
        'python-packaging'
        'python-protobuf'
        'python-cerberus'
        'python-h5py'
        'python-onnx'
        'python-sympy'
        'python-setuptools'
        'python>=3.14'
        'python<3.15'
    )
    optdepends=(
        'onnxruntime-provider-cuda: the CUDA execution provider'
        'onnxruntime-provider-tensorrt: the TensorRT execution provider'
        'onnxruntime-provider-openvino: the OpenVINO execution provider (Intel CPU, GPU and NPU)'
        'onnxruntime-provider-dnnl: the oneDNN execution provider (CPU)'
        'onnxruntime-provider-migraphx: the MIGraphX execution provider (AMD GPUs; AUR pkgbase onnxruntime-split-migraphx, untested on AMD hardware)'
        'python-pytorch: onnxruntime.training.ortmodule (import onnxruntime.training needs it)'
        'python-ml-dtypes: 4-bit and float8 quantization (the wheel'\''s quantization extra)'
        'python-psutil: the transformers optimisation and benchmark tools'
        'python-py-cpuinfo: the transformers optimisation and benchmark tools'
    )
    provides=(
        'python-onnxruntime-core=1.29.0-7'
        'python-onnxruntime=1.29.0'
    )
    conflicts=(
        'python-onnxruntime-core'
        'python-onnxruntime'
        'python-onnxruntime-cpu'
        'python-onnxruntime-cuda'
        'python-onnxruntime-opt-cuda'
        'python-onnxruntime-rocm'
        'python-onnxruntime-opt-rocm'
        'python-onnxruntime-full'
        'onnxruntime-core-nccloff'
    )
    replaces=(
        'python-onnxruntime-full'
    )

    bsdtar -xpf "$srcdir"/'python-onnxruntime-core-1.29.0-7-x86_64.pkg.tar.zst' -C "$pkgdir" usr
    if [[ -d $pkgdir/usr/share/licenses/python-onnxruntime-core ]]; then
        mv "$pkgdir/usr/share/licenses/python-onnxruntime-core" "$pkgdir/usr/share/licenses/python-onnxruntime-core-bin"
    fi
}
