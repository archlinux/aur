pkgname='jaguar-bin'
pkgver=1.50.1
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('9488cc9a7657804dee2be184cc2f785b1e570cb709e27588dc08b34ff036a9fa')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
