package() {
  local dest="$pkgdir$_skinsdir"
  install -dm755 "$dest"
  bsdtar -xf "$srcdir/aimp-skin-eclipse-393.archive" -C "$dest"
  find "$dest" -mindepth 2 -type f -exec mv -t "$dest" {} +
