# Maintainer: mistweaverco <oss@mistweaverco.com>
pkgname=kulala-desktop-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="A fully-featured HTTP/GraphQL/gRPC/Websocket-client interface for Linux, Mac and Window."
arch=('x86_64')
url="https://github.com/mistweaverco/kulala-desktop"
license=('MIT')
depends=('nss' 'at-spi2-core' 'libxss' 'gtk3' 'alsa-lib' 'libxtst')
provides=('kulala-desktop')
conflicts=('kulala-desktop')
options=('!strip')
_deb="${pkgname}-${pkgver}"
source=("LICENSE::https://raw.githubusercontent.com/mistweaverco/kulala-desktop/v${pkgver}/LICENSE")
source_x86_64=("${_deb}::https://github.com/mistweaverco/kulala-desktop/releases/download/v${pkgver}/kulala-desktop_amd64.deb")
noextract=("${_deb}")
# NOTE: Auto-generated by CI via updpkgsums
sha256sums=('9be55955a1292e7e0b31943c86edf8d173dce122219da900a48ee6cb9bc71491')
sha256sums_x86_64=('1c79b525700de85266bcee472febfa64f07a4eb6a09f7d2e509934d2bdbf74e4')

package() {
  local extract_dir="$srcdir/deb-extracted"

  rm -rf "$extract_dir"
  mkdir -p "$extract_dir"

  cd "$extract_dir"
  ar x "$srcdir/$_deb"

  local data_archive
  for data_archive in data.tar.*; do
    if [[ -f "$data_archive" ]]; then
      bsdtar -xpf "$data_archive" -C "$pkgdir"
      install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
      return 0
    fi
  done

  printf 'Could not find data.tar.* inside %s\n' "$_deb" >&2
  return 1
}
