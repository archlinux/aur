pkgname='jaguar-bin'
pkgver=1.69.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('ce2d5f02dcb7e2d0093e010eac0272c98a610d7462a55cb21520bfa75026af9a')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
