# Maintainer: Axel H. <noirbizarre@gmail.com>
#
# Source package. `0.1.0` and `6dab8adb3b3060e1dfd3efdb99ec026b5b9f8d253242c9f84abbf17c3080ca8d` are substituted by
# .github/workflows/aur.yaml from the published release, and the result is
# pushed to the AUR. Edit this template, never the PKGBUILD in the AUR
# repository: that one is regenerated at every release.

pkgname=over
pkgver=0.1.0
pkgrel=1
pkgdesc="A git-based file overlay manager (dotfiles as overlays)"
arch=('x86_64' 'aarch64')
url="https://github.com/noirbizarre/over"
license=('MIT')

# zlib because libgit2 links the system one rather than bundling it: the
# binaries really do need libz.so.1, and namcap errors on a needed library
# left undeclared.
depends=('gcc-libs' 'glibc' 'zlib')

# cmake, because `git2` is built with the `vendored` feature (vendored-libgit2
# + vendored-openssl) — libgit2 and OpenSSL are compiled from source rather
# than linked against the system copies, so a C toolchain is a build-time
# requirement even though nothing here is a C project.
makedepends=('cargo' 'cmake')

conflicts=('over-bin')

# !lto is not optional, and the failure it prevents is obscure. makepkg
# enables LTO globally, which puts `-flto=auto` into CFLAGS — and CFLAGS is
# what the libgit2-sys build script compiles vendored libgit2 with. The
# resulting libgit2.a holds LLVM bitcode rather than objects, and the link
# ends in a screenful of `undefined symbol: git_repository_open`. Nothing is
# lost by disabling it: Cargo.toml already sets `lto = true` on the release
# profile, so the Rust side is link-time optimised either way.
#
# !debug for a plainer reason: that same profile sets `strip = true`, so
# there is no debug data to split into a -debug package.
options=('!lto' '!debug')

source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha256sums=('6dab8adb3b3060e1dfd3efdb99ec026b5b9f8d253242c9f84abbf17c3080ca8d')

prepare() {
	cd "$pkgname-$pkgver"
	# Arch's Rust packaging guidelines: vendor the dependency graph up front so
	# build() can run offline with `--frozen`. Cargo.lock is tracked, so this
	# resolves exactly the graph upstream CI tested.
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release --features vendored
}

check() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	# No Git identity is exported here on purpose: the test harness scrubs
	# GIT_AUTHOR_* and GIT_COMMITTER_* from the environment and configures each
	# temporary repository itself, so anything set here would be discarded.
	cargo test --frozen --release --features vendored
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/over "$pkgdir/usr/bin/over"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

	# Generated by the binary just built, from the same command definition the
	# parser uses, so they cannot describe flags this build does not have.
	./target/release/over completion bash |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/over"
	./target/release/over completion zsh |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_over"
	./target/release/over completion fish |
		install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/over.fish"
}
