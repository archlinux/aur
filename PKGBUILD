pkgname=rencfs-bin
pkgver=0.13.71
pkgrel=1
pkgdesc="An encrypted file system that is mounted with FUSE on Linux. It can be used to create encrypted directories."
url="https://radumarias.github.io/rencfs"
license=("MIT OR Apache-2.0")
arch=("x86_64")
provides=("rencfs")
conflicts=("rencfs")
