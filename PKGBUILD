pkgname='jaguar-bin'
pkgver=1.40.0
pkgrel=1
pkgdesc="Tool to develop Toit programs for the ESP32"
arch=('x86_64')
url="https://github.com/toitlang/jaguar"
license=('MIT')
depends=('gcc-libs')
provides=('jaguar')
conflicts=('jaguar')
source=("$pkgname-$pkgver.tgz::$url/releases/download/v$pkgver/jag_linux.tgz")
sha256sums=('3b53a30d4290defad9a21b6f7bc34efd27a58949c838f64724526992a72fc6c1')

package() {
	install -D jag -t "$pkgdir/usr/bin/"
}
