# Maintainer: Stephano Cetola <stephano@cetola.net>

_select_dtb_links() {
    local model=""
    local dtb_target=""

    if [ ! -r /proc/device-tree/model ]; then
        echo "Warning: /proc/device-tree/model not found"
        echo "No DTB symlink will be created"
        return 0
    fi

    model="$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)"

    case "$model" in
        "MNT Pocket Reform with BPI-CM4 Module")
            dtb_target="meson-g12b-bananapi-cm4-mnt-pocket-reform-7.2.2-reform1.dtb"
            ;;
        "MNT Pocket Reform with i.MX8MP Module")
            dtb_target="imx8mp-mnt-pocket-reform-7.2.2-reform1.dtb"
            ;;
        "MNT Pocket Reform with RCORE RK3588 Module")
            dtb_target="rk3588-mnt-pocket-reform-7.2.2-reform1.dtb"
            ;;
        "MNT Reform Next with RCORE RK3588 Module")
            dtb_target="rk3588-mnt-reform-next-7.2.2-reform1.dtb"
            ;;
        "MNT Pocket Reform with Radxa CM5 RK3588S2 Module")
            dtb_target="rk3588s-mnt-pocket-reform-7.2.2-reform1.dtb"
            ;;
        *)
            echo "Warning: Unknown device model: $model"
            echo "No DTB symlink will be created"
            return 0
            ;;
    esac

    if [ -f "/boot/dtbs/$dtb_target" ]; then
        ln -sf "dtbs/$dtb_target" "/boot/mnt-reform-7.2.2-reform1.dtb"
        ln -sf "mnt-reform-7.2.2-reform1.dtb" /boot/mnt-reform.dtb
        echo "Created symlinks to $dtb_target for model: $model"
    else
        echo "Warning: Target DTB $dtb_target not found in /boot/dtbs"
    fi
}

_backup_kernel_image() {
    local boot_image=""
    local backup_image=""

    if [ -f /boot/Image-linux-mnt-reform ]; then
        boot_image="/boot/Image"
        backup_image="/boot/Image-old"
    elif [ -f /boot/vmlinuz-linux-mnt-reform ]; then
        boot_image="/boot/vmlinuz-linux"
        backup_image="/boot/vmlinuz-linux-old"
    else
        return 0
    fi

    if [ -L "$boot_image" ]; then
        IMAGE_TARGET=$(readlink -f "$boot_image")
        if [ -f "$IMAGE_TARGET" ]; then
            cp "$IMAGE_TARGET" "$backup_image"
            echo "Backed up ${boot_image} target: $IMAGE_TARGET -> $backup_image"
        fi
    elif [ -f "$boot_image" ]; then
        cp "$boot_image" "$backup_image"
        echo "Backed up $boot_image -> $backup_image"
    fi
}

pre_upgrade() {
    echo "==> Running pre-install backup for linux-mnt-reform..."

    _backup_kernel_image

    if [ ! -f /boot/Image-linux-mnt-reform ]; then
        return 0
    fi

    if [ -L /boot/mnt-reform.dtb ]; then
        DTB_TARGET=$(readlink -f /boot/mnt-reform.dtb)
        if [ -f "$DTB_TARGET" ]; then
            cp "$DTB_TARGET" /boot/mnt-reform-old.dtb
            echo "Backed up mnt-reform.dtb target: $DTB_TARGET -> /boot/mnt-reform-old.dtb"
        fi
    elif [ -f /boot/mnt-reform.dtb ]; then
        cp /boot/mnt-reform.dtb /boot/mnt-reform-old.dtb
        echo "Backed up mnt-reform.dtb -> /boot/mnt-reform-old.dtb"
    fi

    if [ -f /boot/initramfs-linux ]; then
        cp /boot/initramfs-linux /boot/initramfs-linux-old
        echo "Backed up initramfs-linux -> /boot/initramfs-linux-old"
    fi
}

post_install() {
    if [ -f /boot/Image-linux-mnt-reform ]; then
        _select_dtb_links
    fi
}

post_upgrade() {
    if [ -f /boot/Image-linux-mnt-reform ]; then
        _select_dtb_links
    fi
}
