_preserve_system_config() {
  local cfg=/etc/xdg/tray-idle-inhibitor/config.toml
  local keep=/etc/xdg/tray-idle-inhibitor/config.toml.keep
  # 0.1.1 ставил config.toml файлом пакета; 0.1.2 его больше не содержит,
  # поэтому при обновлении pacman удалил бы пользовательские настройки.
  if [ -f "$cfg" ] && [ ! -e "$keep" ]; then
    cp -a "$cfg" "$keep"
  fi
}

_restore_system_config() {
  local cfg=/etc/xdg/tray-idle-inhibitor/config.toml
  local keep=/etc/xdg/tray-idle-inhibitor/config.toml.keep
  if [ -f "$keep" ]; then
    if [ -e "$cfg" ]; then
      rm -f "$keep"
    else
      mv -f "$keep" "$cfg"
    fi
  fi
}

post_install() {
  cat <<'MSG'
Окончательный запуск выберите сами:

  * автозапуск при каждом входе — /etc/xdg/autostart/tray-idle-inhibitor.desktop;
    после установки он уже включён (флаг --auto);
  * разовый запуск — команда `tray-idle-inhibitor --auto` в терминале.

Для автовключения по медиа нужен playerctl (optdepends).

Пример конфига лежит в /etc/xdg/tray-idle-inhibitor/config.toml.example.
Копировать его не обязательно: значения по умолчанию в программе те же.
Кладите свой конфиг в ~/.config/tray-idle-inhibitor/config.toml — там
достаточно только изменяемых ключей.
MSG
}

pre_upgrade() {
  _preserve_system_config
}

post_upgrade() {
  _restore_system_config
  post_install
}
