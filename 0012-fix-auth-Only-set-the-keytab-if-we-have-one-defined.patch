From: Andreas Schneider <asn@cryptomilk.org>
Date: Mon, 3 Nov 2025 15:24:56 +0100
Subject: [PATCH 12/15] fix(auth): Only set the keytab if we have one defined

Fixes #57
---
 src/cepces/soap/auth.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/src/cepces/soap/auth.py b/src/cepces/soap/auth.py
index ef3ea88..5df7675 100644
--- a/src/cepces/soap/auth.py
+++ b/src/cepces/soap/auth.py
@@ -111,12 +111,16 @@ class TransportKerberosAuthentication(Authentication):
 
         os.environ["KRB5CCNAME"] = "MEMORY:cepces"
 
-        gssapi_cred = gssapi.raw.acquire_cred_from(
-            store={
+        store = None
+        if self._config["keytab"]:
+            store = {
                 b"client_keytab": self._config["keytab"],
                 # This doesn't work, we need to set KRB5CCNAME
                 # b"ccache": "MEMORY:cepces",
-            },
+            }
+
+        gssapi_cred = gssapi.raw.acquire_cred_from(
+            store=store,
             name=gss_name,
             mechs=[krb5_mech],
             usage="initiate",
-- 
