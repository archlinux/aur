post_install() {
  echo
  echo ":: Visor CLI installed. Ready to use."
  echo "::"
  echo ":: The EFI binary is at  /usr/lib/visor/visor_x64.efi"
  echo ":: Example config at     /usr/share/visor/boot.conf.example"
  echo "::"
  echo ":: Optional dependencies (install what you need):"
  echo "::   efibootmgr   UEFI boot entry management (recommended)"
  echo "::   sbctl        Secure Boot signing"
  echo "::   python       Kernel/initrd encryption (visor encrypt)"
  echo "::   python-pillow  Font baking (make bakefont)"
  echo "::"
  echo ":: To deploy visor to your ESP and add a UEFI boot entry, run:"
  echo "::   sudo visor install"
  echo "::"
  echo ":: Quick reference:"
  echo "::   visor build          Build the EFI binary"
  echo "::   visor install        Install to the ESP + register boot entry"
  echo "::   visor update        Pull latest, rebuild, reinstall"
  echo "::   visor doctor        Check that everything is set up correctly"
  echo "::   visor encrypt       Encrypt kernel/initrd for the ESP"
  echo "::   visor sign          Sign for Secure Boot with sbctl"
  echo "::"
  echo ":: Full config reference: https://visor-bootmanager.vercel.app/install"
  echo
}

post_upgrade() {
  post_install
}
