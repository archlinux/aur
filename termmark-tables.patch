+
+// Full-screen view for --watch on a terminal: scrolling, table of contents (t), jumps to sections.
+static void runPager(const fs::path& filePath, int intervalMs) {
+    using namespace termstyle;
+    tcgetattr(STDIN_FILENO, &savedTermios);
+    termios raw = savedTermios;
+    raw.c_lflag &= ~(ICANON | ECHO);
+    tcsetattr(STDIN_FILENO, TCSANOW, &raw);
+    std::signal(SIGINT, [](int) { leavePager(); _exit(130); });
+    std::signal(SIGTERM, [](int) { leavePager(); _exit(143); });
+    std::cout << "\033[?1049h\033[?25l\033[?7l"; // alternate screen, hide cursor, no autowrap
+
+    std::vector<Token> tokens;
+    std::vector<TocEntry> toc;
+    std::vector<std::string> rows;
+    std::vector<size_t> tokenRows;
+    std::string error;
+    winsize ws{};
