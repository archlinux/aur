+// Byte length of the UTF-8 char at s[i]; its terminal column width goes to w.
+static size_t nextChar(const std::string& s, size_t i, size_t& w) {
+    static const bool localeReady = [] {
+        std::setlocale(LC_CTYPE, "");
+        if (MB_CUR_MAX == 1) std::setlocale(LC_CTYPE, "C.UTF-8");
+        return true;
+    }();
+    (void)localeReady;
+    std::mbstate_t state{};
+    wchar_t wc;
+    size_t n = std::mbrtowc(&wc, s.data() + i, s.size() - i, &state);
+    if (n == 0 || n > s.size() - i) { w = 1; return 1; } // invalid byte: count as one column
+    int cw = wcwidth(wc);
+    w = cw < 0 ? 0 : cw;
+    return n;
+}
+
+static size_t displayWidth(const std::string& s) {
+    size_t total = 0, w;
+    for (size_t i = 0; i < s.size(); total += w) i += nextChar(s, i, w);
+    return total;
+}
+
+static size_t tokenWidth(const InlineToken& token) {
+    size_t w = displayWidth(token.text);
+    if (token.type == InlineType::HyperLink && !supportsHyperlink()) w += displayWidth(token.url) + 3; // "text (url)"
+    return w;
+}
+
+static size_t cellWidth(const std::vector<InlineToken>& cell) {
+    size_t w = 0;
+    for (const auto& token : cell) w += tokenWidth(token);
+    return w;
+}
+
+// Word-wraps a table cell to `width` columns, hard-splitting words that are longer than a line.
+static std::vector<std::vector<InlineToken>> wrapCell(const std::vector<InlineToken>& cell, size_t width) {
+    struct Word { std::vector<InlineToken> parts; size_t width = 0; InlineToken space; };
+    std::vector<Word> words;
+    bool pendingSpace = true;
+    InlineToken space{InlineType::Plain, " ", "", {}};
+    for (const auto& token : cell) {
+        // shortcut: links are kept whole and may overflow a narrow column; split them if that shows up.
+        if (token.type == InlineType::HyperLink) {
+            if (pendingSpace) words.push_back({{}, 0, space});
+            words.back().parts.push_back(token);
+            words.back().width += tokenWidth(token);
+            pendingSpace = false;
+            continue;
+        }
+        for (size_t i = 0; i < token.text.size();) {
+            if (token.text[i] == ' ') {
+                pendingSpace = true;
+                space = token;
+                space.text = " ";
+                ++i;
+                continue;
+            }
+            size_t end = std::min(token.text.find(' ', i), token.text.size());
+            if (pendingSpace) words.push_back({{}, 0, space});
+            pendingSpace = false;
+            InlineToken part = token;
+            part.text = token.text.substr(i, end - i);
+            words.back().width += displayWidth(part.text);
+            words.back().parts.push_back(part);
+            i = end;
+        }
+    }
+
+    std::vector<std::vector<InlineToken>> lines(1);
+    size_t lineWidth = 0;
+    for (const auto& word : words) {
+        if (lineWidth > 0 && lineWidth + 1 + word.width > width) {
+            lines.emplace_back();
+            lineWidth = 0;
+        } else if (lineWidth > 0) {
+            lines.back().push_back(word.space);
+            ++lineWidth;
+        }
+        for (const auto& part : word.parts) {
+            if (part.type == InlineType::HyperLink) {
+                lines.back().push_back(part);
+                lineWidth += tokenWidth(part);
+                continue;
+            }
+            for (size_t i = 0; i < part.text.size();) {
+                size_t start = i, pieceWidth = 0, w;
+                while (i < part.text.size()) {
+                    size_t n = nextChar(part.text, i, w);
+                    if (lineWidth + pieceWidth + w > width && lineWidth + pieceWidth > 0) break;
+                    i += n;
+                    pieceWidth += w;
+                }
+                if (i > start) {
+                    InlineToken piece = part;
+                    piece.text = part.text.substr(start, i - start);
+                    lines.back().push_back(piece);
+                    lineWidth += pieceWidth;
+                }
+                if (i < part.text.size()) {
+                    lines.emplace_back();
+                    lineWidth = 0;
+                }
+            }
+        }
+    }
+    return lines;
+}
+
 
