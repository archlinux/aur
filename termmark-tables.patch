--- /dev/null
+++ b/tests/parser_test.cpp
@@ -0,0 +1,86 @@
+// Parser checks. Build and run: cmake --build build && ctest --test-dir build
+#include "parser/MarkdownParser.h"
+#include <iostream>
+
+static int failures = 0;
+#define CHECK(cond) \
+    do { if (!(cond)) { std::cerr << __FILE__ << ":" << __LINE__ << ": CHECK failed: " #cond "\n"; ++failures; } } while (0)
+
+template <typename T> static const T& as(const Token& t) { return std::get<T>(t.data); }
+
+static std::string plainText(const std::vector<InlineToken>& tokens) {
+    std::string s;
+    for (const auto& t : tokens) s += t.text;
+    return s;
+}
+
+int main() {
+    { // source line breaks stay inside one paragraph
+        auto t = parseMarkdown("one\ntwo\n\nthree\n");
+        CHECK(t.size() == 2);
+        CHECK(plainText(as<ParagraphToken>(t[0]).content) == "one\ntwo");
+    }
+    { // setext headings, thematic breaks
+        auto t = parseMarkdown("Title\n=====\n\nSub\n---\n\n***\n\n* * *\n");
+        CHECK(t.size() == 4);
+        CHECK(as<HeadingToken>(t[0]).level == 1 && plainText(as<HeadingToken>(t[0]).content) == "Title");
+        CHECK(as<HeadingToken>(t[1]).level == 2);
+        CHECK(t[2].type == TokenType::HorizontalRule && t[3].type == TokenType::HorizontalRule);
+    }
+    { // nested lists, ordered start, tasks, continuation lines
+        auto t = parseMarkdown("- a\n  more\n  - b\n    3. c\n    4. d\n- [ ] todo\n- [x] done\n");
+        CHECK(t.size() == 1);
+        const auto& items = as<ListToken>(t[0]).items;
+        CHECK(items.size() == 6);
+        CHECK(items[0].marker == "•" && plainText(items[0].content) == "a\nmore");
+        CHECK(items[1].depth == 1 && items[1].marker == "◦");
+        CHECK(items[2].depth == 2 && items[2].marker == "3." && items[3].marker == "4.");
+        CHECK(items[4].depth == 0 && items[4].marker == "☐" && plainText(items[4].content) == "todo");
+        CHECK(items[5].marker == "☑");
+    }
+    { // multi-line quote
+        auto t = parseMarkdown("> a\n> b\n");
+        CHECK(t.size() == 1 && plainText(as<QuoteToken>(t[0]).content) == "a\nb");
+    }
+    { // nested emphasis is flattened into style bits
+        auto in = parseInline("**bold *both* bold** ~~gone~~");
+        CHECK(in.size() == 5);
+        CHECK(in[0].style == InlineStyle::Bold && in[0].text == "bold ");
+        CHECK(in[1].style == (InlineStyle::Bold | InlineStyle::Italic) && in[1].text == "both");
+        CHECK(in[4].style == InlineStyle::Strike && in[4].text == "gone");
+    }
+    { // things that must stay plain text
+        CHECK(plainText(parseInline("2 * 3 * 4")) == "2 * 3 * 4");
+        auto snake = parseInline("snake_case_name");
+        CHECK(snake.size() == 1 && snake[0].style == 0);
+        CHECK(plainText(parseInline("\\*not italic\\*")) == "*not italic*");
+        CHECK(parseInline("[a] and [b](c)")[1].type == InlineType::HyperLink);
+    }
+    { // code spans with backticks inside
+        auto in = parseInline("x `` a ` b `` y");
+        CHECK(in.size() == 3 && in[1].type == InlineType::Code && in[1].text == "a ` b");
+    }
+    { // links, images, autolinks
+        auto in = parseInline("![alt](p.png) <https://e.com>");
+        CHECK(in[0].type == InlineType::HyperLink && in[0].text == "alt" && in[0].url == "p.png");
+        CHECK(in[2].type == InlineType::HyperLink && in[2].url == "https://e.com");
+    }
+    { // table cells: escaped pipes and pipes inside code do not split
+        auto t = parseMarkdown("| a | b |\n|:--|--:|\n| `x | y` | p\\|q |\n");
+        const auto& table = as<TableToken>(t[0]);
+        CHECK(table.aligns == std::vector<char>({'l', 'r'}));
+        CHECK(table.rows.size() == 1 && plainText(table.rows[0][0]) == "x | y" && plainText(table.rows[0][1]) == "p|q");
+    }
+    { // footnotes: reference becomes a superscript, notes are appended at the end
+        auto t = parseMarkdown("text[^n]\n\n[^n]: the note\n");
+        CHECK(plainText(as<ParagraphToken>(t[0]).content) == "text¹");
+        CHECK(plainText(as<ParagraphToken>(t.back()).content) == "¹ the note");
+    }
+    { // unclosed code fence keeps its content
+        auto t = parseMarkdown("```sh\necho hi\n");
+        CHECK(t.size() == 1 && as<CodeBlockToken>(t[0]).code == "echo hi\n");
+    }
+
+    if (failures == 0) std::cout << "parser_test: all checks passed\n";
+    return failures == 0 ? 0 : 1;
+}
-- 
