+возраст: ${user.age}`;
+export default async function load() { return await fetch("/api"); }
+```
+
+## JSON
+
+```json
+{
+  "name": "termmark",
+  "version": 1.0,
+  "tags": ["cli", "markdown"],
+  "stable": true,
+  "parent": null
+}
+```
+
+## YAML
+
+```yaml
