diff --git a/include/highlight/highlight.h b/include/highlight/highlight.h
new file mode 100644
index 0000000..0e0b375
--- /dev/null
+++ b/include/highlight/highlight.h
@@ -0,0 +1,68 @@
+/* highlight: a small syntax highlighter for one line at a time. C99, no dependencies.
+ *
+ * Finds keywords, strings, comments, numbers and names (keys, shell variables, sections) in
+ * sh, C/C++, Python, JavaScript, JSON, YAML and INI. It only reports spans; the caller decides
+ * how they look: TermMark turns them into ANSI colors, an editor can turn them into text tags
+ * (for example GtkTextTag in l3afpad).
+ *
+ *     int state = 0;              // 0 before the first line; afterwards what the previous line left
+ *     hl_span spans[64];
+ *     size_t n = hl_line(HL_LANG_C, text, len, &state, spans, 64);
+ *     for (size_t i = 0; i < n; ++i) paint(spans[i].start, spans[i].length, spans[i].kind);
+ *
+ * `state` carries constructs that span lines (C block comments, Python triple-quoted strings,
+ * JavaScript template strings). An editor keeps one state per line and re-highlights the
+ * following lines while their incoming state changes.
+ *
+ * To reuse: copy highlight.h and highlight.c into the other project.
+ */
+#ifndef HIGHLIGHT_H
+#define HIGHLIGHT_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    HL_LANG_NONE,
+    HL_LANG_SH,
+    HL_LANG_C,      /* C and C++ */
+    HL_LANG_PYTHON,
+    HL_LANG_JS,     /* JavaScript and TypeScript */
+    HL_LANG_JSON,
+    HL_LANG_YAML,
+    HL_LANG_INI     /* also .conf, .desktop, TOML */
+} hl_lang;
+
+typedef enum {
+    HL_KEYWORD = 1,
+    HL_STRING,
+    HL_COMMENT,
+    HL_NUMBER,
+    HL_NAME         /* JSON/YAML/INI keys, INI sections, shell variables */
+} hl_kind;
+
+typedef struct {
+    size_t start;   /* byte offset in the line */
+    size_t length;  /* in bytes */
+    hl_kind kind;
+} hl_span;
+
+/* Language from a name such as a Markdown fence ("sh", "bash", "cpp", "py", "yml", ...),
+ * case-insensitive; text after the first space is ignored. HL_LANG_NONE if unknown. */
+hl_lang hl_lang_from_name(const char *name);
+
+/* Language from a file name by its extension ("x.c", "conf.ini", ".bashrc"). */
+hl_lang hl_lang_from_filename(const char *path);
+
+/* Highlights `line` (`len` bytes, without the newline). Writes at most `max_spans` spans in
+ * order and returns how many were written. Updates `*state` for the next line. */
+size_t hl_line(hl_lang lang, const char *line, size_t len, int *state, hl_span *spans, size_t max_spans);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/highlight/highlight.c b/src/highlight/highlight.c
new file mode 100644
index 0000000..079e62b
--- /dev/null
+++ b/src/highlight/highlight.c
@@ -0,0 +1,277 @@
+/* See highlight.h. */
+#include "highlight/highlight.h"
+
+#include <ctype.h>
+#include <string.h>
+
+/* Values of *state between lines. */
+enum { IN_CODE = 0, IN_BLOCK_COMMENT, IN_TRIPLE_DOUBLE, IN_TRIPLE_SINGLE, IN_TEMPLATE };
+
+static const char *const sh_words[] = {
+    "if", "then", "else", "elif", "fi", "for", "while", "until", "do", "done", "case", "esac",
+    "in", "function", "return", "local", "export", "readonly", "declare", "unset", "shift",
+    "exit", "break", "continue", "select", "source", "eval", "exec", "set", "trap", NULL};
+static const char *const c_words[] = {
+    "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else",
+    "enum", "extern", "float", "for", "goto", "if", "inline", "int", "long", "register",
+    "restrict", "return", "short", "signed", "sizeof", "static", "struct", "switch", "typedef",
+    "union", "unsigned", "void", "volatile", "while", "bool", "true", "false", "NULL", "nullptr",
+    "class", "namespace", "template", "typename", "public", "private", "protected", "virtual",
+    "override", "new", "delete", "this", "using", "try", "catch", "throw", "constexpr",
+    "noexcept", "friend", "operator", "explicit", "mutable", "static_cast", "const_cast",
+    "dynamic_cast", "reinterpret_cast", NULL};
+static const char *const py_words[] = {
+    "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class",
+    "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if",
+    "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try",
+    "while", "with", "yield", "match", "case", "self", NULL};
+static const char *const js_words[] = {
+    "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete",
+    "do", "else", "export", "extends", "false", "finally", "for", "function", "if", "import",
+    "in", "instanceof", "let", "new", "null", "return", "super", "switch", "this", "throw",
+    "true", "try", "typeof", "undefined", "var", "void", "while", "with", "yield", "async",
+    "await", "of", "static", "interface", "type", "enum", "implements", NULL};
+static const char *const value_words[] = {
+    "true", "false", "null", "yes", "no", "on", "off", "True", "False", "None", NULL};
+
+typedef struct {
+    hl_span *spans;
+    size_t max, count;
+} out_t;
+
+static void emit(out_t *out, size_t start, size_t end, hl_kind kind) {
+    if (end <= start || out->count >= out->max) return;
+    out->spans[out->count].start = start;
+    out->spans[out->count].length = end - start;
+    out->spans[out->count].kind = kind;
+    out->count++;
+}
+
+static int is_ident(char c) {
+    return isalnum((unsigned char)c) || c == '_';
+}
+
+static int same_word(const char *a, size_t len, const char *word) {
+    return strlen(word) == len && strncmp(a, word, len) == 0;
+}
+
+static int is_keyword(const char *const *words, const char *s, size_t len) {
+    for (; words && *words; ++words) {
+        if (same_word(s, len, *words)) return 1;
+    }
+    return 0;
+}
+
+/* Position of `needle` in line[from, len), or len if absent. */
+static size_t find(const char *line, size_t len, size_t from, const char *needle) {
+    size_t n = strlen(needle);
+    for (size_t i = from; i + n <= len; ++i) {
+        if (memcmp(line + i, needle, n) == 0) return i;
+    }
+    return len;
+}
+
+/* End of a string literal that starts with `quote` at `start` (past the closing quote, or len). */
+static size_t string_end(const char *line, size_t len, size_t start, char quote, int escapes) {
+    for (size_t i = start + 1; i < len; ++i) {
+        if (escapes && line[i] == '\\') ++i;
+        else if (line[i] == quote) return i + 1;
+    }
+    return len;
+}
+
+static size_t skip_space(const char *line, size_t len, size_t i) {
+    while (i < len && (line[i] == ' ' || line[i] == '\t')) ++i;
+    return i;
+}
+
+/* INI, .conf, .desktop, TOML: [section], key = value, ; or # comments. */
+static void ini_line(const char *line, size_t len, out_t *out) {
+    size_t i = skip_space(line, len, 0);
+    if (i >= len) return;
+    if (line[i] == ';' || line[i] == '#') {
+        emit(out, i, len, HL_COMMENT);
+    } else if (line[i] == '[') {
+        emit(out, i, len, HL_NAME);
+    } else {
+        size_t eq = i;
+        while (eq < len && line[eq] != '=' && line[eq] != ':') ++eq;
+        size_t key_end = eq;
+        while (key_end > i && (line[key_end - 1] == ' ' || line[key_end - 1] == '\t')) --key_end;
+        if (eq < len) emit(out, i, key_end, HL_NAME);
+        size_t v = skip_space(line, len, eq + 1);
+        if (eq < len && v < len && (line[v] == '"' || line[v] == '\'')) emit(out, v, string_end(line, len, v, line[v], 1), HL_STRING);
+    }
+}
+
+size_t hl_line(hl_lang lang, const char *line, size_t len, int *state, hl_span *spans, size_t max_spans) {
+    out_t out = {spans, max_spans, 0};
+    size_t i = 0;
+    const char *const *words = lang == HL_LANG_SH ? sh_words : lang == HL_LANG_C ? c_words
+                             : lang == HL_LANG_PYTHON ? py_words : lang == HL_LANG_JS ? js_words
+                             : value_words;
+    if (lang == HL_LANG_NONE) return 0;
+    if (lang == HL_LANG_INI) {
+        ini_line(line, len, &out);
+        return out.count;
+    }
+
+    /* Finish what the previous line left open. */
+    if (*state != IN_CODE) {
+        const char *close = *state == IN_BLOCK_COMMENT ? "*/" : *state == IN_TRIPLE_DOUBLE ? "\"\"\""
+                          : *state == IN_TRIPLE_SINGLE ? "'''" : "`";
+        size_t end = find(line, len, 0, close);
+        emit(&out, 0, end < len ? end + strlen(close) : len, *state == IN_BLOCK_COMMENT ? HL_COMMENT : HL_STRING);
+        if (end >= len) return out.count;
+        i = end + strlen(close);
+        *state = IN_CODE;
+    }
+
+    /* Line starts: C preprocessor lines, YAML keys ("key:" after optional "- "). */
+    if (i == 0) {
+        size_t s = skip_space(line, len, 0);
+        if (lang == HL_LANG_C && s < len && line[s] == '#') {
+            size_t e = skip_space(line, len, s + 1);
+            while (e < len && is_ident(line[e])) ++e;
+            emit(&out, s, e, HL_KEYWORD);
+            i = e;
+        } else if (lang == HL_LANG_YAML) {
+            while (s + 1 < len && line[s] == '-' && line[s + 1] == ' ') s = skip_space(line, len, s + 2);
+            size_t e = s;
+            while (e < len && line[e] != ':' && line[e] != '#' && line[e] != '"' && line[e] != '\'') ++e;
+            if (e > s && e < len && line[e] == ':' && (e + 1 == len || line[e + 1] == ' ')) {
+                emit(&out, s, e, HL_NAME);
+                i = e + 1;
+            }
+        }
+    }
+
+    while (i < len) {
+        const char c = line[i];
+        const char prev = i > 0 ? line[i - 1] : ' ';
+
+        /* Comments. */
+        if ((lang == HL_LANG_C || lang == HL_LANG_JS || lang == HL_LANG_JSON) && c == '/' && i + 1 < len) {
+            if (line[i + 1] == '/') {
+                emit(&out, i, len, HL_COMMENT);
+                break;
+            }
+            if (line[i + 1] == '*') {
+                size_t end = find(line, len, i + 2, "*/");
+                emit(&out, i, end < len ? end + 2 : len, HL_COMMENT);
+                if (end >= len) {
+                    *state = IN_BLOCK_COMMENT;
+                    break;
+                }
+                i = end + 2;
+                continue;
+            }
+        }
+        if (c == '#' && (lang == HL_LANG_PYTHON || ((lang == HL_LANG_SH || lang == HL_LANG_YAML) && (prev == ' ' || prev == '\t' || prev == ';' || i == 0)))) {
+            emit(&out, i, len, HL_COMMENT);
+            break;
+        }
+
+        /* Strings. */
+        if ((c == '"' || (c == '\'' && lang != HL_LANG_JSON) || (c == '`' && lang == HL_LANG_JS))
+            && !(lang == HL_LANG_YAML && is_ident(prev))) { /* YAML: "it's" is no string */
+            if (lang == HL_LANG_PYTHON && c != '`' && i + 2 < len && line[i + 1] == c && line[i + 2] == c) {
+                const char *triple = c == '"' ? "\"\"\"" : "'''";
+                size_t end = find(line, len, i + 3, triple);
+                emit(&out, i, end < len ? end + 3 : len, HL_STRING);
+                if (end >= len) {
+                    *state = c == '"' ? IN_TRIPLE_DOUBLE : IN_TRIPLE_SINGLE;
+                    break;
+                }
+                i = end + 3;
+                continue;
+            }
+            size_t end = string_end(line, len, i, c, !(lang == HL_LANG_SH && c == '\''));
+            if (c == '`' && (end == len && (len == i + 1 || line[len - 1] != '`'))) *state = IN_TEMPLATE;
+            /* A JSON string followed by ':' is a key. */
+            size_t after = skip_space(line, len, end);
+            emit(&out, i, end, lang == HL_LANG_JSON && after < len && line[after] == ':' ? HL_NAME : HL_STRING);
+            i = end;
+            continue;
+        }
+
+        /* Shell variables: $name, ${...}, $1, $?, ... */
+        if (lang == HL_LANG_SH && c == '$' && i + 1 < len) {
+            size_t end = i + 1;
+            if (line[end] == '{') {
+                while (end < len && line[end] != '}') ++end;
+                end = end < len ? end + 1 : len;
+            } else if (is_ident(line[end])) {
+                while (end < len && is_ident(line[end])) ++end;
+            } else if (line[end] && strchr("#?@*$!-", line[end])) {
+                ++end;
+            }
+            if (end > i + 1) {
+                emit(&out, i, end, HL_NAME);
+                i = end;
+                continue;
+            }
+        }
+
+        /* Numbers, not inside names such as "file2". */
+        if (isdigit((unsigned char)c) && !is_ident(prev) && prev != '.') {
+            size_t end = i;
+            while (end < len && (isalnum((unsigned char)line[end]) || line[end] == '.' || line[end] == '_')) ++end;
+            emit(&out, i, end, HL_NUMBER);
+            i = end;
+            continue;
+        }
+
+        /* Keywords. In sh, "a-b" and "x.if" are words of their own, not keywords. */
+        if (is_ident(c) && !isdigit((unsigned char)c)) {
+            size_t end = i;
+            while (end < len && is_ident(line[end])) ++end;
+            int whole = lang != HL_LANG_SH || ((i == 0 || (prev && strchr(" \t;|&(", prev)))
+                                               && (end == len || (line[end] && strchr(" \t;|&)", line[end]))));
+            if (whole && is_keyword(words, line + i, end - i)) emit(&out, i, end, HL_KEYWORD);
+            i = end;
+            continue;
+        }
+        ++i;
+    }
+    return out.count;
+}
+
+static int lower_equal(const char *a, size_t len, const char *b) {
+    if (strlen(b) != len) return 0;
+    for (size_t i = 0; i < len; ++i) {
+        if (tolower((unsigned char)a[i]) != b[i]) return 0;
+    }
+    return 1;
+}
+
+hl_lang hl_lang_from_name(const char *name) {
+    static const struct { const char *name; hl_lang lang; } names[] = {
+        {"sh", HL_LANG_SH}, {"bash", HL_LANG_SH}, {"zsh", HL_LANG_SH}, {"shell", HL_LANG_SH},
+        {"ksh", HL_LANG_SH}, {"bashrc", HL_LANG_SH}, {"profile", HL_LANG_SH}, {"zshrc", HL_LANG_SH},
+        {"c", HL_LANG_C}, {"h", HL_LANG_C}, {"cpp", HL_LANG_C}, {"c++", HL_LANG_C}, {"cc", HL_LANG_C},
+        {"cxx", HL_LANG_C}, {"hpp", HL_LANG_C}, {"hh", HL_LANG_C}, {"hxx", HL_LANG_C},
+        {"python", HL_LANG_PYTHON}, {"py", HL_LANG_PYTHON}, {"python3", HL_LANG_PYTHON},
+        {"js", HL_LANG_JS}, {"javascript", HL_LANG_JS}, {"mjs", HL_LANG_JS}, {"jsx", HL_LANG_JS},
+        {"ts", HL_LANG_JS}, {"typescript", HL_LANG_JS}, {"tsx", HL_LANG_JS},
+        {"json", HL_LANG_JSON}, {"jsonc", HL_LANG_JSON},
+        {"yaml", HL_LANG_YAML}, {"yml", HL_LANG_YAML},
+        {"ini", HL_LANG_INI}, {"conf", HL_LANG_INI}, {"cfg", HL_LANG_INI}, {"toml", HL_LANG_INI},
+        {"desktop", HL_LANG_INI}, {"service", HL_LANG_INI}, {"properties", HL_LANG_INI},
+    };
+    if (!name) return HL_LANG_NONE;
+    size_t len = 0;
+    while (name[len] && name[len] != ' ' && name[len] != '\t' && name[len] != '{') ++len;
+    for (size_t i = 0; i < sizeof names / sizeof names[0]; ++i) {
+        if (lower_equal(name, len, names[i].name)) return names[i].lang;
+    }
+    return HL_LANG_NONE;
+}
+
+hl_lang hl_lang_from_filename(const char *path) {
+    if (!path) return HL_LANG_NONE;
+    const char *slash = strrchr(path, '/');
+    const char *base = slash ? slash + 1 : path;
+    const char *dot = strrchr(base, '.');
+    return dot ? hl_lang_from_name(dot + 1) : HL_LANG_NONE;
+}
diff --git a/tests/highlight_test.cpp b/tests/highlight_test.cpp
new file mode 100644
index 0000000..8b9bf52
--- /dev/null
+++ b/tests/highlight_test.cpp
@@ -0,0 +1,75 @@
+// Checks for the highlight module (src/highlight/highlight.c). Run: ctest --test-dir build
+#include "highlight/highlight.h"
+#include <cstring>
+#include <iostream>
+#include <string>
+
+static int failures = 0;
+#define CHECK(cond) \
+    do { if (!(cond)) { std::cerr << __FILE__ << ":" << __LINE__ << ": CHECK failed: " #cond "\n"; ++failures; } } while (0)
+
+// The line with every highlighted span written as [kind:text], e.g. "[K:if] x".
+static std::string marked(hl_lang lang, const std::string& line, int& state) {
+    static const char* names = "?KSCNV";
+    hl_span spans[64];
+    const size_t n = hl_line(lang, line.data(), line.size(), &state, spans, 64);
+    std::string out;
+    size_t at = 0;
+    for (size_t i = 0; i < n; ++i) {
+        out += line.substr(at, spans[i].start - at);
+        out += std::string("[") + names[spans[i].kind] + ":" + line.substr(spans[i].start, spans[i].length) + "]";
+        at = spans[i].start + spans[i].length;
+    }
+    return out + line.substr(at);
+}
+
+static std::string marked(hl_lang lang, const std::string& line) {
+    int state = 0;
+    return marked(lang, line, state);
+}
+
+int main() {
+    CHECK(hl_lang_from_name("Bash") == HL_LANG_SH);
+    CHECK(hl_lang_from_name("cpp {.numberLines}") == HL_LANG_C);
+    CHECK(hl_lang_from_name("brainfuck") == HL_LANG_NONE);
+    CHECK(hl_lang_from_filename("/etc/x/app.YML") == HL_LANG_YAML);
+    CHECK(hl_lang_from_filename("/home/u/.bashrc") == HL_LANG_SH);
+    CHECK(hl_lang_from_filename("Makefile") == HL_LANG_NONE);
+
+    CHECK(marked(HL_LANG_SH, "if [ -f \"$f\" ]; then echo 'x' # done") ==
+          "[K:if] [ -f [S:\"$f\"] ]; [K:then] echo [S:'x'] [C:# done]");
+    CHECK(marked(HL_LANG_SH, "cp $HOME/a ${DIR}/b-if file2") == "cp [V:$HOME]/a [V:${DIR}]/b-if file2");
+    CHECK(marked(HL_LANG_SH, "echo a#b $#") == "echo a#b [V:$#]");
+
+    CHECK(marked(HL_LANG_C, "#include <stdio.h>") == "[K:#include] <stdio.h>");
+    CHECK(marked(HL_LANG_C, "int x = 0x1F; // hex") == "[K:int] x = [N:0x1F]; [C:// hex]");
+    {
+        int state = 0;
+        CHECK(marked(HL_LANG_C, "a /* start", state) == "a [C:/* start]");
+        CHECK(marked(HL_LANG_C, "still */ return 1;", state) == "[C:still */] [K:return] [N:1];");
+        CHECK(state == 0);
+    }
+
+    CHECK(marked(HL_LANG_PYTHON, "def f(x): return \"a\\\"b\"  # c") == "[K:def] f(x): [K:return] [S:\"a\\\"b\"]  [C:# c]");
+    {
+        int state = 0;
+        CHECK(marked(HL_LANG_PYTHON, "s = \"\"\"doc", state) == "s = [S:\"\"\"doc]");
+        CHECK(marked(HL_LANG_PYTHON, "end\"\"\" + 1", state) == "[S:end\"\"\"] + [N:1]");
+    }
+
+    CHECK(marked(HL_LANG_JS, "const s = `t ${x}`; // c") == "[K:const] s = [S:`t ${x}`]; [C:// c]");
+    CHECK(marked(HL_LANG_JSON, "{\"key\": \"value\", \"n\": 12, \"b\": true}") ==
+          "{[V:\"key\"]: [S:\"value\"], [V:\"n\"]: [N:12], [V:\"b\"]: [K:true]}");
+
+    CHECK(marked(HL_LANG_YAML, "  - name: it's 3 # note") == "  - [V:name]: it's [N:3] [C:# note]");
+    CHECK(marked(HL_LANG_YAML, "url: \"http://x#y\"") == "[V:url]: [S:\"http://x#y\"]");
+
+    CHECK(marked(HL_LANG_INI, "[Desktop Entry]") == "[V:[Desktop Entry]]");
+    CHECK(marked(HL_LANG_INI, "Name = \"TermMark\"") == "[V:Name] = [S:\"TermMark\"]");
+    CHECK(marked(HL_LANG_INI, "; comment") == "[C:; comment]");
+
+    CHECK(marked(HL_LANG_NONE, "if x") == "if x");
+
+    if (failures == 0) std::cout << "highlight_test: all checks passed\n";
+    return failures == 0 ? 0 : 1;
+}
