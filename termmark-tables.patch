+        md_inline(line, len, j + 3, state, out);
+        return;
+    }
+    if (s + 2 < len && (line[s] == '`' || line[s] == '~') && line[s + 1] == line[s] && line[s + 2] == line[s]) {
+        emit(out, 0, len, HL_STRING);
