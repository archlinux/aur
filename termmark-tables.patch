+        }
+        toc = tocEntries(tokens);
+        selected = std::min(selected, toc.empty() ? 0 : toc.size() - 1);
+    };
+    auto layout = [&] {
+        ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws);
+        rows = renderRows(tokens, tokenRows);
+    };
+    auto pageHeight = [&] { return static_cast<size_t>(std::max<int>(ws.ws_row, 2) - 1); }; // last row: status bar
+    auto maxTop = [&] { return rows.size() > pageHeight() ? rows.size() - pageHeight() : 0; };
+    auto jump = [&](size_t entry) {
+        if (entry >= toc.size()) return;
+        top = tokenRows[toc[entry].token];
+        tocMode = false;
+    };
+    auto jumpToSection = [&](int number) {
+        for (size_t i = 0; i < toc.size(); ++i) {
+            if (toc[i].number == number) jump(i);
+        }
+    };
+    auto draw = [&] {
+        const size_t height = pageHeight();
+        top = std::min(top, maxTop());
+        std::vector<std::string> tocRows;
+        const std::vector<std::string>* view = &rows;
+        size_t first = top;
+        if (tocMode) {
+            tocRows = renderTocRows(toc, selected);
+            view = &tocRows;
+            first = selected + 3 > height ? selected + 3 - height : 0; // keep the selection on screen
+        }
+        std::string out = "\033[H";
+        for (size_t i = 0; i < height; ++i) {
+            out += "\033[2K";
+            if (first + i < view->size()) out += (*view)[first + i];
+            out += std::string(RESET) + "\r\n";
