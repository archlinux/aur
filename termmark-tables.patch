+}
+
+// Headings for the table of contents, normalized like leaf: a single top heading is the
+// document title, so the outline starts one level below it; only two levels are shown.
+std::vector<TocEntry> tocEntries(const std::vector<Token>& tokens) {
+    std::vector<int> levels;
+    for (const auto& token : tokens) {
+        if (const auto* heading = std::get_if<HeadingToken>(&token.data)) levels.push_back(heading->level);
+    }
+    std::vector<int> distinct = levels;
+    std::sort(distinct.begin(), distinct.end());
+    distinct.erase(std::unique(distinct.begin(), distinct.end()), distinct.end());
+    if (distinct.empty()) return {};
+    const bool titleOnly = distinct.size() > 1 && std::count(levels.begin(), levels.end(), distinct[0]) == 1;
+    const int root = distinct[titleOnly ? 1 : 0];
+    const int sub = distinct.size() > (titleOnly ? 2u : 1u) ? distinct[titleOnly ? 2 : 1] : 0;
+
+    std::vector<TocEntry> toc;
+    int number = 0;
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        const auto* heading = std::get_if<HeadingToken>(&tokens[i].data);
+        if (!heading || (heading->level != root && heading->level != sub)) continue;
+        std::string title;
+        for (const auto& part : heading->content) title += part.text;
+        toc.push_back({i, heading->level == root ? ++number : 0, title});
+    }
+    return toc;
+}
+
+// Table of contents screen in leaf's sidebar style; `selected` gets the "▎" marker.
+std::vector<std::string> renderTocRows(const std::vector<TocEntry>& toc, size_t selected) {
+    using namespace termstyle;
+    const size_t width = std::max<size_t>(terminalWidth(), 20);
+    auto truncate = [](const std::string& s, size_t max) {
+        if (displayWidth(s) <= max) return s;
+        size_t i = 0, used = 0, w;
+        while (i < s.size()) {
+            size_t n = nextChar(s, i, w);
+            if (used + w >= max) break; // keep one column for "…"
+            i += n;
+            used += w;
+        }
+        return s.substr(0, i) + "…";
+    };
+    std::string rule;
+    for (size_t i = 0; i < width; ++i) rule += "─";
+
+    std::vector<std::string> rows = {std::string(BOLD) + DARK_GRAY + " TABLE OF CONTENTS" + RESET, DARK_GRAY + rule + RESET};
+    if (toc.empty()) rows.push_back("  (no headings)");
+    for (size_t i = 0; i < toc.size(); ++i) {
+        const bool active = i == selected;
+        std::string row = active ? std::string(BRIGHT_BLUE) + "▎" + RESET : " ";
+        if (toc[i].number > 0) {
+            char num[16];
+            std::snprintf(num, sizeof num, "%02d", toc[i].number);
+            row += std::string(" ") + BOLD + (active ? BRIGHT_BLUE : DARK_GRAY) + num + RESET + " " + BOLD
+                 + (active ? BRIGHT_WHITE : "") + truncate(toc[i].title, width - 6) + RESET;
+        } else {
+            row += std::string("    ") + (active ? BRIGHT_BLUE : DARK_GRAY) + "•" + RESET + " "
+                 + (active ? BOLD : "") + truncate(toc[i].title, width - 8) + RESET;
+        }
+        rows.push_back(row);
+    }
+    return rows;
+}
+
+// Splits one rendered line into terminal rows of `width` columns. Escape sequences take no
+// columns; colors active at a break are repeated on the next row.
+static void wrapAnsi(const std::string& line, size_t width, std::vector<std::string>& rows) {
+    std::string row, sgr;
+    size_t used = 0;
+    for (size_t i = 0; i < line.size();) {
+        if (line[i] == '\033') {
+            size_t end = i + 1;
+            if (end < line.size() && line[end] == '[') {
+                while (end < line.size() && !std::isalpha(static_cast<unsigned char>(line[end]))) ++end;
+                end = std::min(end + 1, line.size());
+                std::string seq = line.substr(i, end - i);
+                if (seq.back() == 'm') sgr = seq == termstyle::RESET ? "" : sgr + seq;
+            } else if (end < line.size() && line[end] == ']') { // OSC 8 hyperlink, ends with ESC '\'
+                end = line.find("\033\\", end);
+                end = end == std::string::npos ? line.size() : end + 2;
+            } else {
+                end = std::min(end + 1, line.size());
+            }
+            row += line.substr(i, end - i);
+            i = end;
+            continue;
+        }
+        size_t w, n = nextChar(line, i, w);
+        if (used + w > width && used > 0) {
+            rows.push_back(row + termstyle::RESET);
+            row = sgr;
+            used = 0;
+        }
+        row += line.substr(i, n);
+        used += w;
+        i += n;
+    }
+    rows.push_back(row);
+}
+
+// Renders the document into terminal rows for the pager; tokenRows[i] is the first row of tokens[i].
+std::vector<std::string> renderRows(const std::vector<Token>& tokens, std::vector<size_t>& tokenRows) {
+    const size_t width = terminalWidth();
+    std::vector<std::string> rows;
+    tokenRows.clear();
+    for (const auto& token : tokens) {
+        std::ostringstream out;
+        auto* previous = std::cout.rdbuf(out.rdbuf());
+        renderTokens({token});
+        std::cout.rdbuf(previous);
+        tokenRows.push_back(rows.size());
+        std::istringstream lines(out.str());
+        for (std::string line; std::getline(lines, line);) wrapAnsi(line, width, rows);
+    }
+    return rows;
+}
