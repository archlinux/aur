+// Colors active at a break continue on the next row.
+static std::vector<std::string> wrapWords(const std::string& line, size_t width) {
+    std::vector<std::string> rows;
+    std::string row, sgr, sgrAtSpace;
+    size_t used = 0, usedAtSpace = 0, spaceAt = std::string::npos;
+    for (size_t i = 0; i < line.size();) {
+        if (size_t esc = escapeLength(line, i)) {
+            trackSgr(line.substr(i, esc), sgr);
+            row += line.substr(i, esc);
+            i += esc;
+            continue;
