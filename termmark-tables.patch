+// Length of the code fence (3 or more ` or ~) starting at `first`, 0 if there is none.
+// A ``` line whose rest holds a backtick is inline code, not a fence (CommonMark).
+static size_t fenceOpen(const std::string& line, size_t first, char& mark) {
+    if (first == std::string::npos || (line[first] != '`' && line[first] != '~')) return 0;
+    mark = line[first];
+    const size_t end = line.find_first_not_of(mark, first);
+    const size_t length = (end == std::string::npos ? line.size() : end) - first;
+    if (length < 3 || (mark == '`' && end != std::string::npos && line.find('`', end) != std::string::npos)) return 0;
+    return length;
+}
+
+// The block opened by `length` x `mark` ends at a line of at least as many, and nothing else.
+static bool fenceCloses(const std::string& line, size_t first, char mark, size_t length) {
+    char m;
+    const size_t run = fenceOpen(line, first, m);
+    return run >= length && m == mark && line.find_first_not_of(" \t", first + run) == std::string::npos;
+}
