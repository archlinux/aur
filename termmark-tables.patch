+        bool validUtf8(const std::string& s) {
+            for (size_t i = 0; i < s.size();) {
+                const unsigned char c = s[i];
+                const size_t n = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 0;
+                if (!n || i + n > s.size()) return false;
+                for (size_t k = 1; k < n; ++k) {
+                    if ((static_cast<unsigned char>(s[i + k]) >> 6) != 2) return false;
+                }
+                i += n;
+            }
+            return true;
+        }
+
+        void appendUtf8(std::string& out, uint16_t c) {
+            if (c < 0x80) {
+                out += static_cast<char>(c);
+            } else if (c < 0x800) {
+                out += static_cast<char>(0xC0 | c >> 6);
+                out += static_cast<char>(0x80 | (c & 0x3F));
+            } else {
+                out += static_cast<char>(0xE0 | c >> 12);
+                out += static_cast<char>(0x80 | (c >> 6 & 0x3F));
+                out += static_cast<char>(0x80 | (c & 0x3F));
+            }
+        }
+
+        // How much `bytes` read with `table` look like Russian etc.: Cyrillic letters count, a
+        // capital inside a lower case word ("пРИВЕТ": KOI8-R read as CP1251) and symbols where
+        // letters are expected count against. As l3afpad does it.
+        long cyrillicScore(const std::string& bytes, const uint16_t* table) {
+            long score = 0;
+            bool prevLower = false;
+            for (unsigned char b : bytes) {
+                const uint16_t c = b < 0x80 ? b : table[b - 0x80];
+                const bool cyrillic = c >= 0x400 && c <= 0x45F;
+                const bool lower = cyrillic && (c >= 0x430);
+                if (cyrillic) {
+                    ++score;
+                    if (!lower && prevLower) score -= 10;
+                } else if (c >= 0x80 && c != 0xA0) {
+                    score -= 5;
+                }
+                prevLower = lower;
+            }
+            return score;
+        }
+    }
+
+    // shortcut: a file that is not UTF-8 is taken for Cyrillic (CP1251, KOI8-R or CP866,
+    // whichever reads best); add Latin-1 and the like if such files turn up.
+    std::string toUtf8(const std::string& bytes) {
+        if (validUtf8(bytes)) return bytes;
+        const uint16_t* best = cp1251;
+        for (const uint16_t* table : {koi8r, cp866}) {
+            if (cyrillicScore(bytes, table) > cyrillicScore(bytes, best)) best = table;
+        }
+        std::string out;
+        out.reserve(bytes.size() * 2);
+        for (unsigned char b : bytes) appendUtf8(out, b < 0x80 ? b : best[b - 0x80]);
+        return out;
+    }
