+/* Markdown spans inside a line: code, emphasis, links, autolinks, HTML, table pipes. */
+static void md_inline(const char *line, size_t len, size_t i, int *state, out_t *out) {
+    while (i < len) {
+        const char c = line[i];
+        const char prev = i > 0 ? line[i - 1] : ' ';
+        size_t j, k, run;
+
+        if (c == '\\' && i + 1 < len) { /* escaped character */
+            i += 2;
+            continue;
+        }
+        if (c == '`') { /* code span: closed by a run of the same length */
+            for (run = i; run < len && line[run] == '`'; ++run) {}
+            for (j = run; j < len;) {
+                if (line[j] != '`') { ++j; continue; }
+                for (k = j; k < len && line[k] == '`'; ++k) {}
+                if (k - j == run - i) break;
+                j = k;
+            }
+            if (j < len) {
+                emit(out, i, j + (run - i), HL_STRING);
+                i = j + (run - i);
+            } else {
+                i = run;
+            }
+            continue;
+        }
+        if (c == '<' && i + 3 < len && memcmp(line + i, "<!--", 4) == 0) {
+            j = find(line, len, i + 4, "-->");
+            emit(out, i, j < len ? j + 3 : len, HL_COMMENT);
+            if (j >= len) {
+                *state = IN_MD_HTML_COMMENT;
+                return;
+            }
+            i = j + 3;
+            continue;
+        }
+        if (c == '<' && i + 1 < len && (isalpha((unsigned char)line[i + 1]) || line[i + 1] == '/')) {
+            for (j = i + 1; j < len && line[j] != '>' && line[j] != ' ' && line[j] != '<'; ++j) {}
+            if (j < len && line[j] == '>' && (memchr(line + i, ':', j - i) || memchr(line + i, '@', j - i))) {
+                emit(out, i, j + 1, HL_FUNCTION); /* autolink <https://...> */
+                i = j + 1;
+                continue;
+            }
+            for (j = i + 1; j < len && line[j] != '>'; ++j) {}
+            if (j < len) {
+                emit(out, i, j + 1, HL_COMMENT); /* HTML tag */
+                i = j + 1;
+                continue;
+            }
