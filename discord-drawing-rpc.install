post_install() {
    echo "Discord Drawing RPC has been installed."
    echo "Run 'discord-drawing-rpc' to start the GUI application."
    echo "The daemon and tray components will be available as:"
    echo "  - discord-drawing-rpc-daemon"
    echo "  - discord-drawing-rpc-tray"
    
    # Update desktop database
    update-desktop-database -q
    
    # Update icon cache
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
}

post_upgrade() {
    post_install
}

post_remove() {
    # Update desktop database
    update-desktop-database -q
    
    # Update icon cache
    gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
    
    echo ""
    echo "Note: User configuration files may remain in:"
    echo "  ~/.config/discord-drawing-rpc/"
    echo "  ~/.local/share/discord-drawing-rpc/"
    echo "Remove these manually if desired."
}
