diff --git a/cmake/FindMiniaudio.cmake b/cmake/FindMiniaudio.cmake
new file mode 100644
index 0000000..62029c8
--- /dev/null
+++ b/cmake/FindMiniaudio.cmake
@@ -0,0 +1,33 @@
+find_package(PkgConfig QUIET)
+if(PkgConfig_FOUND)
+	pkg_check_modules(PC_${CMAKE_FIND_PACKAGE_NAME} QUIET miniaudio)
+endif()
+
+find_path(${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIR
+  NAMES miniaudio.h
+  HINTS ${PC_${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIRS}
+  PATH_SUFFIXES miniaudio
+)
+find_library(${CMAKE_FIND_PACKAGE_NAME}_LIBRARY
+  NAMES miniaudio
+  HINTS ${PC_${CMAKE_FIND_PACKAGE_NAME}_LIBRARY_DIRS}
+)
+
+include(FindPackageHandleStandardArgs)
+
+find_package_handle_standard_args(${CMAKE_FIND_PACKAGE_NAME}
+	REQUIRED_VARS ${CMAKE_FIND_PACKAGE_NAME}_LIBRARY ${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIR)
+
+if(${CMAKE_FIND_PACKAGE_NAME}_FOUND)
+	set(${CMAKE_FIND_PACKAGE_NAME}_LIBRARIES ${${CMAKE_FIND_PACKAGE_NAME}_LIBRARY})
+	set(${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIRS ${${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIR})
+	set(${CMAKE_FIND_PACKAGE_NAME}_DEFINITIONS ${PC_${CMAKE_FIND_PACKAGE_NAME}_CFLAGS_OTHER})
+
+	if (NOT TARGET miniaudio)
+		add_library(miniaudio UNKNOWN IMPORTED)
+		set_target_properties(miniaudio PROPERTIES
+			IMPORTED_LOCATION "${${CMAKE_FIND_PACKAGE_NAME}_LIBRARY}"
+			INTERFACE_INCLUDE_DIRECTORIES "${${CMAKE_FIND_PACKAGE_NAME}_INCLUDE_DIR}"
+		)
+	endif()
+endif()
