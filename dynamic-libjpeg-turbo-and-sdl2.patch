From 52634491601a488fb6c49df7de5613df98d3c3e9 Mon Sep 17 00:00:00 2001
From: oweissbarth <mail@oweissbarth.de>
Date: Wed, 8 Oct 2025 21:03:10 +0200
Subject: [PATCH] link the dynamic versions of libjpeg-turbo and sdl2

---
 lib/tlCore/CMakeLists.txt | 2 +-
 lib/tlIO/CMakeLists.txt   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib/tlCore/CMakeLists.txt b/lib/tlCore/CMakeLists.txt
index d02fa96a..f905cadd 100644
--- a/lib/tlCore/CMakeLists.txt
+++ b/lib/tlCore/CMakeLists.txt
@@ -45,7 +45,7 @@ if(TLRENDER_OCIO)
     list(APPEND LIBRARIES OpenColorIO::OpenColorIO)
 endif()
 if(TLRENDER_SDL2)
-    list(APPEND LIBRARIES_PRIVATE SDL2::SDL2-static)
+    list(APPEND LIBRARIES_PRIVATE SDL2::SDL2)
 endif()
 if(TLRENDER_SDL3)
     list(APPEND LIBRARIES_PRIVATE SDL3::SDL3-static)
diff --git a/lib/tlIO/CMakeLists.txt b/lib/tlIO/CMakeLists.txt
index cead0760..7f70eceb 100644
--- a/lib/tlIO/CMakeLists.txt
+++ b/lib/tlIO/CMakeLists.txt
@@ -44,7 +44,7 @@ if(TLRENDER_JPEG)
     list(APPEND HEADERS JPEG.h)
     list(APPEND HEADERS_PRIVATE JPEGPrivate.h)
     list(APPEND SOURCE JPEG.cpp JPEGRead.cpp JPEGWrite.cpp)
-    list(APPEND LIBRARIES_PRIVATE libjpeg-turbo::turbojpeg-static)
+    list(APPEND LIBRARIES_PRIVATE libjpeg-turbo::turbojpeg)
 endif()
 if(TLRENDER_TIFF)
     list(APPEND HEADERS TIFF.h)
-- 
2.51.0

