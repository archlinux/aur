message_to_user(){
   echo <<EOF
Before using MPLAB_XC32 you have to agree with the LICENSE at:
/usr/share/licenses/microchip-mplabxc32-bin/LICENSE

MPLAB IDE should automatically detect new compiler versions.
If it doesn't, you can add it manually by going to:
Tools->Options->Embedded->Add

and enter:
/opt/microchip/xc32/latest/bin

The xc32-* binaries are also symlinked to /usr/bin/xc32-* for use outside MPLAB X
EOF
}

post_install() {
  message_to_user
}

post_upgrade() {
  message_to_user
}
