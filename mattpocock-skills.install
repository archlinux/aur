post_install() {
  cat <<'MSG'
==> mattpocock-skills links each skill into ~/.agents/skills per user, via
==> /usr/lib/user-tmpfiles.d/mattpocock-skills.conf. Existing skills with the
==> same name are NOT replaced, so a clash is skipped silently.
==> Apply now (otherwise it happens at next login):
==>   systemd-tmpfiles --user --create
==> List skills that were skipped because the name is already taken:
==>   for s in /usr/share/agent-skills/mattpocock-skills/*; do [ "$(readlink ~/.agents/skills/${s##*/})" = "$s" ] || echo "not linked: ${s##*/}"; done
MSG
}

post_upgrade() {
  post_install
}

post_remove() {
  cat <<'MSG'
==> Skill links in ~/.agents/skills now dangle. Remove them with:
==>   find ~/.agents/skills -maxdepth 1 -xtype l -lname '/usr/share/agent-skills/mattpocock-skills/*' -delete
MSG
}
