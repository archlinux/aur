# Override this file with a modified version in /etc/tmpfiles.d/
d /etc/mautrix-twitter 0750 root mautrix-twitter
z /etc/mautrix-twitter/* 0640 mautrix-twitter mautrix-twitter -
d /var/log/mautrix-twitter 0700 mautrix-twitter mautrix-twitter
d /var/lib/mautrix-twitter 0700 mautrix-twitter mautrix-twitter
