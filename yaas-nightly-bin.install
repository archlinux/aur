post_install() {
  echo -e "\n===================================================================="
  echo -e "  To get the configuration file for game databases:"
  echo -e "  1. Join the Telegram bot: https://t.me/qlfixbot?start=YAAS"
  echo -e "  2. Follow the bot's instructions to obtain your config."
  echo -e ""
  echo -e "  Для получения файла конфигурации:"
  echo -e "  1. Перейдите в Telegram-бота: https://t.me/qlfixbot?start=YAAS"
  echo -e "  2. Следуйте инструкциям бота для получения личного конфига."
