_notes() {
  cat <<MSG
==> AdNauseam is an unpacked extension and must be loaded by hand:
      1. open opera://extensions and turn on "Developer mode"
      2. "Load unpacked" and pick  /usr/share/opera-extension-adnauseam-dist
    It is a Manifest V2 extension: it only works while the browser still loads MV2.
MSG
}

post_install() { _notes; }
post_upgrade() {
  echo "==> AdNauseam updated: press reload on its card in opera://extensions."
}
