diff --git a/PKGBUILD b/PKGBUILD
index d8e2439..1cbbdfb 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -11,6 +11,7 @@ url='https://www.openssl.org'
 license=('Apache')
 depends=('lib32-glibc' "${_pkgbasename}")
 optdepends=('ca-certificates')
+options=(staticlibs '!lto')
 provides=('libcrypto.so' 'libssl.so')
 source=("https://github.com/${_pkgbasename}/${_pkgbasename}/releases/download/${_pkgbasename}-${pkgver}/${_pkgbasename}-${pkgver}.tar.gz"{,.asc}
         'ca-dir.patch')
@@ -30,12 +31,14 @@ prepare() {
 build() {
 	export CC="gcc -m32"
 	export CXX="g++ -m32"
-	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"
+	export CFLAGS+=" -fPIC"
+	export CXXFLAGS+=" -fPIC"
+	export PKG_CONFIG_PATH=''

 	cd "$srcdir"/$_pkgbasename-$pkgver

 	./Configure --prefix=/usr --openssldir=/etc/ssl --libdir=lib32 \
-		shared enable-ktls linux-elf
+		no-shared no-apps no-legacy no-module enable-ktls linux-elf

 	make MAKEDEPPROG="${CC}" depend
 	make
@@ -56,5 +59,6 @@ package() {
 	cd "$srcdir"/$_pkgbasename-$pkgver
 	make DESTDIR="$pkgdir" install_sw

-	rm -r "$pkgdir"/usr/{include,bin}
+	rm -rf "$pkgdir"/usr/bin
+	install -Dm644 LICENSE.txt "${pkgdir}/usr/share/licenses/lib32-openssl/LICENSE.txt"
 }
