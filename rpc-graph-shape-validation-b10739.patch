diff --git a/tools/rpc/test-rpc-graph-shape-validation.py b/tools/rpc/test-rpc-graph-shape-validation.py
new file mode 100755
--- /dev/null
+++ b/tools/rpc/test-rpc-graph-shape-validation.py
@@ -0,0 +1,238 @@
+#!/usr/bin/env python3
+import socket
+import struct
+import subprocess
+import sys
+import time
+
+
+RPC_CMD_ALLOC_BUFFER = 0
+RPC_CMD_BUFFER_GET_BASE = 3
+RPC_CMD_SET_TENSOR = 6
+RPC_CMD_GET_TENSOR = 8
+RPC_CMD_GRAPH_COMPUTE = 10
+RPC_CMD_HELLO = 14
+
+GGML_OP_NONE = 0
+GGML_OP_GET_ROWS = 40
+GGML_OP_SET_ROWS = 42
+GGML_TYPE_F32 = 0
+GGML_TYPE_I32 = 26
+GGML_TENSOR_FLAG_COMPUTE = 16
+
+RPC_TENSOR_FMT = "<QIQ4I4II16ii10QQQQ64s4x"
+assert struct.calcsize(RPC_TENSOR_FMT) == 296
+
+
+def tensor(tensor_id, tensor_type, buffer, ne, nb, op, data, src=None,
+           view_src=0, flags=0):
+    src = (src or []) + [0] * (10 - len(src or []))
+    return struct.pack(
+        RPC_TENSOR_FMT,
+        tensor_id, tensor_type, buffer, *ne, *nb, op, *([0] * 16), flags,
+        *src, view_src, 0, data, b"shape-test".ljust(64, b"\0"),
+    )
+
+
+class Client:
+    def __init__(self, port):
+        self.sock = socket.create_connection(("127.0.0.1", port), timeout=2)
+        self.hello()
+
+    def close(self):
+        self.sock.close()
+
+    def receive_exact(self, size):
+        result = bytearray()
+        while len(result) < size:
+            chunk = self.sock.recv(size - len(result))
+            if not chunk:
+                raise ConnectionError("unexpected EOF")
+            result.extend(chunk)
+        return bytes(result)
+
+    def command(self, command, payload):
+        self.sock.sendall(struct.pack("<BQ", command, len(payload)) + payload)
+
+    def response(self, expected_size=None):
+        size, = struct.unpack("<Q", self.receive_exact(8))
+        if expected_size is not None and size != expected_size:
+            raise AssertionError(f"response size {size}, expected {expected_size}")
+        return self.receive_exact(size)
+
+    def hello(self):
+        self.command(RPC_CMD_HELLO, bytes(24))
+        self.response()
+
+    def allocate(self, size):
+        self.command(RPC_CMD_ALLOC_BUFFER, struct.pack("<IQ", 0, size))
+        remote, actual = struct.unpack("<QQ", self.response(16))
+        if actual < size:
+            raise AssertionError(f"allocated {actual}, requested {size}")
+        self.command(RPC_CMD_BUFFER_GET_BASE, struct.pack("<Q", remote))
+        base, = struct.unpack("<Q", self.response(8))
+        return remote, base
+
+    def set_tensor(self, description, data):
+        self.command(RPC_CMD_SET_TENSOR, description + struct.pack("<Q", 0) + data)
+
+    def compute(self, node_id, tensors):
+        payload = struct.pack("<IIQ", 0, 1, node_id)
+        payload += struct.pack("<I", len(tensors)) + b"".join(tensors)
+        self.command(RPC_CMD_GRAPH_COMPUTE, payload)
+
+    def get_tensor(self, description, size):
+        self.command(RPC_CMD_GET_TENSOR, description + struct.pack("<QQ", 0, size))
+        return self.response(size)
+
+
+def contiguous_ne_bytes(ne, element_size=4):
+    return element_size * ne[0] * ne[1] * ne[2] * ne[3]
+
+
+def contiguous_nb(ne, element_size=4):
+    return [element_size,
+            element_size * ne[0],
+            element_size * ne[0] * ne[1],
+            element_size * ne[0] * ne[1] * ne[2]]
+
+
+def make_get_rows(client, src_ne, idx_ne, dst_ne, src_data=None, idx_data=None):
+    src_size = contiguous_ne_bytes(src_ne)
+    idx_size = contiguous_ne_bytes(idx_ne)
+    dst_size = contiguous_ne_bytes(dst_ne)
+    src_buffer, src_base = client.allocate(src_size)
+    idx_buffer, idx_base = client.allocate(idx_size)
+    dst_buffer, dst_base = client.allocate(dst_size)
+    src = tensor(1, GGML_TYPE_F32, src_buffer, src_ne, contiguous_nb(src_ne),
+                 GGML_OP_NONE, src_base)
+    idx = tensor(2, GGML_TYPE_I32, idx_buffer, idx_ne, contiguous_nb(idx_ne),
+                 GGML_OP_NONE, idx_base)
+    dst = tensor(3, GGML_TYPE_F32, dst_buffer, dst_ne, contiguous_nb(dst_ne),
+                 GGML_OP_GET_ROWS, dst_base, [1, 2], flags=GGML_TENSOR_FLAG_COMPUTE)
+    client.set_tensor(src, src_data or bytes(src_size))
+    client.set_tensor(idx, idx_data or bytes(idx_size))
+    client.compute(3, [src, idx, dst])
+    return dst, dst_size
+
+
+def make_set_rows(client, dst_ne, src_ne, idx_ne, dst_data=None,
+                  src_data=None, idx_data=None):
+    dst_size = contiguous_ne_bytes(dst_ne)
+    src_size = contiguous_ne_bytes(src_ne)
+    idx_size = contiguous_ne_bytes(idx_ne)
+    dst_buffer, dst_base = client.allocate(dst_size)
+    src_buffer, src_base = client.allocate(src_size)
+    idx_buffer, idx_base = client.allocate(idx_size)
+    src = tensor(1, GGML_TYPE_F32, src_buffer, src_ne, contiguous_nb(src_ne),
+                 GGML_OP_NONE, src_base)
+    idx = tensor(2, GGML_TYPE_I32, idx_buffer, idx_ne, contiguous_nb(idx_ne),
+                 GGML_OP_NONE, idx_base)
+    original = tensor(4, GGML_TYPE_F32, dst_buffer, dst_ne, contiguous_nb(dst_ne),
+                      GGML_OP_NONE, dst_base)
+    dst = tensor(3, GGML_TYPE_F32, dst_buffer, dst_ne, contiguous_nb(dst_ne),
+                 GGML_OP_SET_ROWS, dst_base, [1, 2, 4], view_src=4,
+                 flags=GGML_TENSOR_FLAG_COMPUTE)
+    client.set_tensor(original, dst_data or bytes(dst_size))
+    client.set_tensor(src, src_data or bytes(src_size))
+    client.set_tensor(idx, idx_data or bytes(idx_size))
+    client.compute(3, [src, idx, original, dst])
+    return dst, dst_size
+
+
+def expect_rejected(port, build_graph):
+    client = Client(port)
+    try:
+        dst, size = build_graph(client)
+        time.sleep(0.05)
+        try:
+            client.get_tensor(dst, size)
+        except (ConnectionError, ConnectionResetError, BrokenPipeError, OSError):
+            return
+        raise AssertionError("malformed graph was executed")
+    finally:
+        client.close()
+
+
+def verify_valid_graphs(port):
+    client = Client(port)
+    try:
+        src_data = struct.pack("<8f", 1, 2, 3, 4, 5, 6, 7, 8)
+        dst, size = make_get_rows(
+            client, [4, 2, 1, 1], [1, 1, 1, 1], [4, 1, 1, 1],
+            src_data, struct.pack("<i", 1))
+        if struct.unpack("<4f", client.get_tensor(dst, size)) != (5, 6, 7, 8):
+            raise AssertionError("valid GET_ROWS returned incorrect data")
+    finally:
+        client.close()
+
+    client = Client(port)
+    try:
+        src_data = struct.pack("<4f", 9, 10, 11, 12)
+        dst, size = make_set_rows(
+            client, [4, 2, 1, 1], [4, 1, 1, 1], [1, 1, 1, 1],
+            src_data=src_data, idx_data=struct.pack("<i", 1))
+        expected = (0, 0, 0, 0, 9, 10, 11, 12)
+        if struct.unpack("<8f", client.get_tensor(dst, size)) != expected:
+            raise AssertionError("valid SET_ROWS returned incorrect data")
+    finally:
+        client.close()
+
+
+def reserve_port():
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+def wait_for_server(port):
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        try:
+            client = Client(port)
+            client.close()
+            return
+        except OSError:
+            time.sleep(0.03)
+    raise TimeoutError("RPC server did not bind")
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit(f"usage: {sys.argv[0]} <ggml-rpc-server>")
+    port = reserve_port()
+    server = subprocess.Popen(
+        [sys.argv[1], "-H", "127.0.0.1", "-p", str(port)],
+        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    error = None
+    try:
+        wait_for_server(port)
+        # Published #26912 and #26825 shapes.
+        expect_rejected(port, lambda c: make_set_rows(
+            c, [4, 1, 1, 1], [4, 1, 2, 1], [1, 1, 1, 1]))
+        expect_rejected(port, lambda c: make_get_rows(
+            c, [4, 1, 1, 1], [1, 2, 1, 1], [4, 1, 2, 1]))
+        # Additional mismatches that pass PR #26933's two original checks.
+        expect_rejected(port, lambda c: make_set_rows(
+            c, [4, 1, 1, 1], [8, 1, 1, 1], [1, 1, 1, 1]))
+        expect_rejected(port, lambda c: make_get_rows(
+            c, [4, 1, 1, 1], [1, 1, 2, 1], [4, 1, 1, 2]))
+        verify_valid_graphs(port)
+        if server.poll() is not None:
+            raise AssertionError(f"RPC server exited with {server.returncode}")
+    except Exception as caught:
+        error = caught
+    finally:
+        if server.poll() is None:
+            server.terminate()
+        try:
+            output, _ = server.communicate(timeout=3)
+        except subprocess.TimeoutExpired:
+            server.kill()
+            output, _ = server.communicate()
+    if error is not None:
+        raise AssertionError(f"{error}\nRPC server output:\n{output}") from error
+
+
+if __name__ == "__main__":
+    main()
