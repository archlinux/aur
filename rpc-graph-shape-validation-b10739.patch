# Local exact-context hardening for llama.cpp b10739.
diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -1742,6 +1742,74 @@ bool rpc_server::graph_compute(const std::vector<uint8_t> & input) {
         const size_t hash_pos = ggml_hash_insert(&graph->visited_hash_set, graph->nodes[i]);
         graph->use_counts[hash_pos] = tensor_ptrs.at(id)->use_count;
     }
+
+    // RPC graph reconstruction bypasses the invariants enforced by the public
+    // GET_ROWS and SET_ROWS constructors. Validate the complete tensor shapes
+    // before handing attacker-controlled graphs to backend kernels.
+    for (uint32_t i = 0; i < n_nodes; i++) {
+        struct ggml_tensor * node = graph->nodes[i];
+
+        if (node->op == GGML_OP_GET_ROWS) {
+            const struct ggml_tensor * src0 = node->src[0];
+            const struct ggml_tensor * src1 = node->src[1];
+            const enum ggml_type result_type = src0 != nullptr && src0->type == GGML_TYPE_I32
+                ? GGML_TYPE_I32 : GGML_TYPE_F32;
+            const struct ggml_type_traits * src0_traits = src0 != nullptr
+                ? ggml_get_type_traits(src0->type) : nullptr;
+            const bool src0_type_supported = src0 != nullptr &&
+                (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 ||
+                 src0->type == GGML_TYPE_BF16 || src0->type == GGML_TYPE_I32 ||
+                 (src0_traits->is_quantized && src0_traits->to_float != nullptr));
+
+            if (src0 == nullptr || src1 == nullptr ||
+                !src0_type_supported ||
+                src1->type != GGML_TYPE_I32 ||
+                src0->ne[2] != src1->ne[1] || src0->ne[3] != src1->ne[2] || src1->ne[3] != 1 ||
+                node->type != result_type ||
+                node->ne[0] != src0->ne[0] ||
+                node->ne[1] != src1->ne[0] || node->ne[2] != src1->ne[1] || node->ne[3] != src1->ne[2] ||
+                src0->ne[0] % ggml_blck_size(src0->type) != 0 ||
+                src0->nb[0] != ggml_type_size(src0->type) ||
+                src1->nb[0] != ggml_type_size(src1->type) ||
+                !ggml_is_contiguous(node) || node->view_src != nullptr || node->view_offs != 0 ||
+                !ggml_backend_supports_op(backends[device], node)) {
+                GGML_LOG_ERROR("[%s] malformed GET_ROWS graph detected\n", __func__);
+                return false;
+            }
+        }
+
+        if (node->op == GGML_OP_SET_ROWS) {
+            const struct ggml_tensor * src0 = node->src[0];
+            const struct ggml_tensor * src1 = node->src[1];
+            const struct ggml_tensor * src2 = node->src[2];
+            const struct ggml_type_traits * dst_traits = ggml_get_type_traits(node->type);
+            const bool dst_type_supported =
+                node->type == GGML_TYPE_F32 || node->type == GGML_TYPE_I32 ||
+                node->type == GGML_TYPE_Q8_K || dst_traits->from_float_ref != nullptr;
+
+            if (src0 == nullptr || src1 == nullptr || src2 == nullptr ||
+                (src0->type != GGML_TYPE_F32 && src0->type != GGML_TYPE_F16) ||
+                (src1->type != GGML_TYPE_I32 && src1->type != GGML_TYPE_I64) ||
+                !dst_type_supported ||
+                node->type != src2->type || !ggml_are_same_shape(node, src2) ||
+                node->ne[0] != src0->ne[0] || node->ne[2] != src0->ne[2] || node->ne[3] != src0->ne[3] ||
+                src0->ne[1] != src1->ne[0] ||
+                src1->ne[1] <= 0 || src1->ne[2] <= 0 || src1->ne[3] != 1 ||
+                src0->ne[2] % src1->ne[1] != 0 || src0->ne[3] % src1->ne[2] != 0 ||
+                node->ne[0] % ggml_blck_size(node->type) != 0 ||
+                !ggml_is_contiguous_rows(node) || !ggml_is_contiguous_rows(src0) ||
+                node->nb[0] != src2->nb[0] || node->nb[1] != src2->nb[1] ||
+                node->nb[2] != src2->nb[2] || node->nb[3] != src2->nb[3] ||
+                node->buffer != src2->buffer || node->data != src2->data ||
+                node->view_src != (src2->view_src != nullptr ? src2->view_src : src2) ||
+                node->view_offs != src2->view_offs ||
+                !ggml_backend_supports_op(backends[device], node)) {
+                GGML_LOG_ERROR("[%s] malformed SET_ROWS graph detected\n", __func__);
+                return false;
+            }
+        }
+    }
+
     ggml_status status = ggml_backend_graph_compute(backends[device], graph);
     GGML_ASSERT(status == GGML_STATUS_SUCCESS && "Unsuccessful graph computations are not supported with RPC");
     stored_graphs[device].graph = graph;
