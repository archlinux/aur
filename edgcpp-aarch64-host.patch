diff --git a/cmake/macro-conf/support/arch/aarch64/base.cmakedef b/cmake/macro-conf/support/arch/aarch64/base.cmakedef
new file mode 100644
index 0000000000..4032b9d611
--- /dev/null
+++ b/cmake/macro-conf/support/arch/aarch64/base.cmakedef
@@ -0,0 +1,42 @@
+# AArch64 as Linux uses it: the AAPCS64 procedure call standard with the
+# LP64 data model.  Apple's arm64 ABI (arch/arm64) differs: there plain char
+# is signed and long double is double.
+TYPE_FOR_PREFIX_ENTRY_NUMBER=unsigned long long
+
+# Plain char is unsigned and wchar_t is unsigned int.
+TARG_HAS_SIGNED_CHARS=0
+TARG_WCHAR_T_INT_KIND=((an_integer_kind)ik_unsigned_int)
+
+TARG_SIZEOF_LONG=8
+TARG_ALIGNOF_LONG=8
+TARG_SIZEOF_POINTER=8
+TARG_ALIGNOF_POINTER=8
+TARG_SIZEOF_DOUBLE=8
+TARG_ALIGNOF_DOUBLE=8
+TARG_ALIGNOF_LONG_LONG=8
+TARG_SIZEOF_LONG_DOUBLE=16
+TARG_ALIGNOF_LONG_DOUBLE=16
+TARG_SIZE_T_INT_KIND=((an_integer_kind)ik_unsigned_long)
+TARG_PTRDIFF_T_INT_KIND=((an_integer_kind)ik_long)
+TARG_DUAL_ALIGNMENTS_FOR_BUILTIN_TYPES=0
+HOST_ALIGNMENT_REQUIRED=8
+TYPE_FOR_AN_FP_VALUE_PART=unsigned int
+
+# glibc's jmp_buf is 312 bytes on AArch64.
+TARG_JMP_BUF_NUM_ELEMENTS=39
+TARG_JMP_BUF_ELEMENT_INT_KIND=((an_integer_kind)ik_long)
+
+# The C++ ABI for AArch64 is the generic one except for pointers to member
+# functions, where the virtual bit moves to the adjustment as on 32-bit ARM.
+# The front end's defaults for ARM64 select every 32-bit ARM variant.
+TARG_IA64_ABI_USE_VARIANT_PTR_TO_MEMBER_FUNCTION_REPR=1
+TARG_IA64_ABI_USE_VARIANT_ARRAY_COOKIES=0
+TARG_IA64_ABI_USE_INT_STATIC_INIT_GUARD=0
+TARG_IA64_ABI_VARIANT_CTORS_AND_DTORS_RETURN_THIS=0
+TARG_IA64_ABI_VARIANT_KEY_FUNCTION=0
+TARG_IA64_ABI_USE_GUARD_ACQUIRE_RELEASE=1
+
+# Zero-width and unnamed bit-fields raise the alignment of the struct to that
+# of their declared type.
+TARG_ZERO_WIDTH_BIT_FIELD_AFFECTS_STRUCT_ALIGNMENT=1
+TARG_UNNAMED_BIT_FIELD_AFFECTS_STRUCT_ALIGNMENT=1
diff --git a/cmake/macro-conf/support/compiler/gcc/linux-aarch64/base.cmakedef b/cmake/macro-conf/support/compiler/gcc/linux-aarch64/base.cmakedef
new file mode 100644
index 0000000000..4695b77d4f
--- /dev/null
+++ b/cmake/macro-conf/support/compiler/gcc/linux-aarch64/base.cmakedef
@@ -0,0 +1,12 @@
+# Import GCC Configuration
+import <support/compiler/gcc/linux/base>
+
+# GCC on AArch64 has no __float80, and builds libquadmath only on x86.
+FLOAT80_ENABLING_POSSIBLE=0
+USE_QUADMATH_LIBRARY=0
+# long double is binary128 on AArch64, so approximating __float128 with long
+# double loses nothing.
+APPROXIMATE_QUADMATH=1
+# FLOAT128_ENABLING_POSSIBLE stays on: it also enables the _Float128 keyword,
+# which glibc's headers need in C++.  GCC on AArch64 has no __float128, so
+# the C compiler behind eccp needs -D__float128=_Float128 (edg_eccp_config).
diff --git a/cmake/macro-conf/support/platform/linux-aarch64/base.cmakedef b/cmake/macro-conf/support/platform/linux-aarch64/base.cmakedef
new file mode 100644
index 0000000000..14c8f714ff
--- /dev/null
+++ b/cmake/macro-conf/support/platform/linux-aarch64/base.cmakedef
@@ -0,0 +1,15 @@
+# Import Base Linux Platform Configuration
+import <support/platform/linux/base>
+# Import AArch64 Configuration
+import <support/arch/aarch64/base>
+
+# long double is IEEE binary128, not the x87 format the base Linux
+# configuration assumes.
+delete FP_LONG_DOUBLE_IS_80BIT_EXTENDED
+FP_LONG_DOUBLE_IS_BINARY128=1
+
+# Allow 128-bit extensions on 64-bit linux configurations
+INT128_EXTENSIONS_ALLOWED=1
+
+# Use linux_aarch64 as the legacy configuration name
+LEGACY_TARGET_CONFIGURATION_NAME="linux_aarch64"
