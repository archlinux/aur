post_install() {
    systemctl daemon-reload
    systemctl enable --now squawker-vpn-helper.service
}

post_upgrade() {
    systemctl daemon-reload

    if systemctl is-active --quiet squawker-vpn-helper.service; then
        systemctl restart squawker-vpn-helper.service
    fi
}

pre_remove() {
    systemctl disable --now squawker-vpn-helper.service
}

post_remove() {
    systemctl daemon-reload
}
