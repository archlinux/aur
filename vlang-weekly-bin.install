post_install() {
    echo "==> vlang-weekly-bin has been installed."
    echo "==> The 'v' compiler is available at /usr/bin/v"
    echo "==> Run 'v help' to get started."
}

post_remove() {
    echo "==> vlang-weekly-bin has been removed."
    echo "==> You may need to refresh your PATH if v command is still found."
}
