# Override this file with a modified version in /etc/tmpfiles.d/
Z /etc/webapps/borgwarehouse/* - borgwarehouse borgwarehouse
z /etc/webapps/borgwarehouse/borgwarehouse.env 0640 borgwarehouse borgwarehouse
Z /usr/share/webapps/borgwarehouse/ - borgwarehouse borgwarehouse
d /var/lib/borgwarehouse 0750 borgwarehouse borgwarehouse
Z /var/lib/borgwarehouse/ - borgwarehouse borgwarehouse
d /var/lib/borgwarehouse/.ssh 0700 borgwarehouse borgwarehouse
f /var/lib/borgwarehouse/.ssh/authorized_keys 0600 borgwarehouse borgwarehouse
d /var/lib/borgwarehouse/repos 0750 borgwarehouse borgwarehouse
