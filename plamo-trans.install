post_install() {
    cat <<'MSG'
==> plamo-trans is installed as the command `trs`.
    plamo-trans は `trs` コマンドで使えます。

    The model is not included. Download one first, e.g.:
      trs --download 0.8b      # read the PLaMo Community License first
      echo 'Hello, world' | trs -ff
MSG
}

post_upgrade() {
    post_install
}
