post_install() {
    echo -e "\e[1m========================================================================================\e[0m"
    echo -e "\e[1m✅ 企业微信已安装 | WeCom has been installed\e[0m"
    echo -e "\e[1m----------------------------------------------------------------------------------------\e[0m"
    echo -e "\e[1m非拉丁语系用户请先运行一次企业微信，然后运行：\e[0m"
    echo -e "\e[1mFor non-latin users, please run WeCom once and run:\e[0m"
    echo -e ""
    echo -e "\e[1;36m  sudo /opt/apps/com.qq.weixin.work.deepin/files/system-fonts.sh\e[0m"
    echo -e ""
    echo -e "\e[1;36m  sed -i 's/WenQuanYi Micro Hei/\e[33mNoto Sans CJK SC\e[0m\e[1;36m/g' ~/.deepinwine/Deepin-WXWork/user.reg\e[0m"
    echo -e "\e[1;33m                                        ↑\e[0m"
    echo -e "\e[1;33m                                 更换为你的字体\e[0m"
    echo -e "\e[1;33m                            replace it with your font\e[0m"
    echo -e ""
    echo -e "\e[1m========================================================================================\e[0m"
}
