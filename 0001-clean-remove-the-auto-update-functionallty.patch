-        let _ = fs::rename(old, &relaunch);
-    }
-    if !succeeded {
-        let reason = match status {
-            Err(e) => format!(" ({e})"),
-            Ok(_) => String::new(),
-        };
-        eprintln!("\nThe update didn't finish{reason}. You can run it yourself: {shown}");
-    } else {
-        let installed = Command::new(&relaunch)
