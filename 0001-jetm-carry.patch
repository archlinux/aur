+        // its grace beat: with the job absent from active_jobs but present in
+        // last_active_jobs, the liveness path skips it, so the reap here can
+        // only come from the age-based backstop this test exercises.
+        scheduler
+            .servers
+            .lock()
+            .unwrap()
+            .get_mut(&server_id)
+            .unwrap()
+            .last_active_jobs
+            .insert(job_id);
+        let nonce = scheduler
+            .servers
+            .lock()
+            .unwrap()
+            .get(&server_id)
+            .unwrap()
+            .server_nonce
+            .clone();
