+    struct LockProbeReader<'a> {
+        data: io::Cursor<Vec<u8>>,
+        cache: &'a Mutex<TcCache>,
+        reads: usize,
+        lock_busy: bool,
+    }
+
+    impl io::Read for LockProbeReader<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            self.reads += 1;
+            if self.cache.try_lock().is_err() {
+                self.lock_busy = true;
+            }
+            self.data.read(buf)
+        }
+    }
