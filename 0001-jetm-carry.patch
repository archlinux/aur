From 7adee95f0f089aae697f21c5b9e69b9453119c4d Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 13:31:41 -0600
Subject: [PATCH 36/48] dist/server: bound the shutdown deregister and poll the
 stop flag faster

The SIGINT/SIGTERM handler installed for graceful deregistration runs a
watcher thread that polls the stop flag every 200 ms, and its deregister
request is bounded at 5 s. With the scheduler unreachable, a stopping
build server therefore takes up to about 5 s to exit, and always up to
200 ms longer than needed even when the scheduler answers.

Poll the flag every 20 ms and bound the deregister request at 2 s, so
the stop path returns promptly. The 90 s heartbeat timeout stays the
backstop for a server whose deregister never reaches the scheduler.

Signed-off-by: Javier Tia <floss@jetm.me>
Signed-off-by: Javier Tia <javier@peridio.com>
---
 src/dist/http.rs | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/dist/http.rs b/src/dist/http.rs
index d7383077..82092b08 100644
--- a/src/dist/http.rs
+++ b/src/dist/http.rs
@@ -1022,7 +1022,9 @@ mod server {
                     // so keep-alive connections are reused, not rebuilt.
                     .pool_max_idle_per_host(2)
                     .pool_idle_timeout(Duration::from_secs(90))
-                    .timeout(Duration::from_secs(5))
+                    // Bounds connect + request: a stop must not hang on a
+                    // scheduler that is down, systemd's stop timeout is longer.
+                    .timeout(Duration::from_secs(2))
                     .build()
                     .expect("deregister http client must build");
                 loop {
@@ -1041,7 +1043,7 @@ mod server {
                         }
                         std::process::exit(0);
                     }
-                    thread::sleep(Duration::from_millis(200));
+                    thread::sleep(Duration::from_millis(20));
                 }
             });
 
-- 
Javier Tia


From 4e4b035d0f3758b3f5d69810b4f0bce1957ecc42 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
Date: Mon, 26 Oct 2026 13:33:13 -0600
Subject: [PATCH 37/48] tests/harness: wait for dist servers to exit on
 teardown

DistSystem::drop sent SIGINT to each dist server, slept a fixed 100 ms
and made one non-blocking waitpid call. The server now deregisters from
the scheduler before it exits, so it can take longer than 100 ms to go
away. test_dist_failingserver then fell through to SIGKILL, and the
non-blocking waitpid right after SIGKILL raced the kernel and was
reported as "process alive after sigkill".

Poll waitpid(WNOHANG) every 10 ms for up to 5 s after SIGINT, which
tolerates the asynchronous exit without slowing the common case. If the
server is still alive after that, send SIGKILL and use a blocking
waitpid, which cannot be ignored and has no race to lose.

Signed-off-by: Javier Tia <floss@jetm.me>
Signed-off-by: Javier Tia <javier@peridio.com>
---
 tests/harness/mod.rs | 37 +++++++++++++++++++++----------------
 1 file changed, 21 insertions(+), 16 deletions(-)

diff --git a/tests/harness/mod.rs b/tests/harness/mod.rs
index 581bd0a0..50ca8296 100644
--- a/tests/harness/mod.rs
+++ b/tests/harness/mod.rs
@@ -646,29 +646,34 @@ impl Drop for DistSystem {
         }
         for &pid in self.server_pids.iter() {
             droperr!(nix::sys::signal::kill(pid, Signal::SIGINT));
-            thread::sleep(Duration::from_millis(100));
+            // On SIGINT the server deregisters from the scheduler before it
+            // exits, so poll for the exit instead of sleeping a fixed time.
             let mut killagain = true; // Default to trying to kill again, e.g. if there was an error waiting on the pid
-            droperr!(
-                nix::sys::wait::waitpid(pid, Some(WaitPidFlag::WNOHANG)).map(|ws| {
-                    if ws != WaitStatus::StillAlive {
+            let deadline = Instant::now() + Duration::from_secs(5);
+            loop {
+                match nix::sys::wait::waitpid(pid, Some(WaitPidFlag::WNOHANG)) {
+                    Ok(WaitStatus::StillAlive) if Instant::now() < deadline => {
+                        thread::sleep(Duration::from_millis(10));
+                    }
+                    Ok(WaitStatus::StillAlive) => break,
+                    Ok(ws) => {
                         killagain = false;
                         exits.push(ws);
+                        break;
                     }
-                })
-            );
+                    Err(e) => {
+                        did_err = true;
+                        eprintln!("Error waiting on server pid after SIGINT: {}", e);
+                        break;
+                    }
+                }
+            }
             if killagain {
                 eprintln!("SIGINT didn't kill process, trying SIGKILL");
                 droperr!(nix::sys::signal::kill(pid, Signal::SIGKILL));
-                droperr!(
-                    nix::sys::wait::waitpid(pid, Some(WaitPidFlag::WNOHANG))
-                        .map_err(|e| e.to_string())
-                        .and_then(|ws| if ws == WaitStatus::StillAlive {
-                            Err("process alive after sigkill".to_owned())
-                        } else {
-                            exits.push(ws);
-                            Ok(())
-                        })
-                );
+                // Blocking: SIGKILL cannot be ignored, and a non-blocking wait
+                // right after the signal races the kernel tearing the process down.
+                droperr!(nix::sys::wait::waitpid(pid, None).map(|ws| exits.push(ws)));
             }
         }
 
-- 
Javier Tia


From 7b5b6d0a5bab86b150c6b0f823f56aba0351d071 Mon Sep 17 00:00:00 2001
From: Javier Tia <javier@peridio.com>
