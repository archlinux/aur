+        // start of a comment would hide the directive after it and serve a stale
+        // object.
+        assert_eq!(
+            find_asm_dependencies(b"__asm__(\"/* x \\n.incbin \\\"blob.bin\\\"\");\n"),
+            vec![AsmDependency::Embedded(b"blob.bin".to_vec())]
