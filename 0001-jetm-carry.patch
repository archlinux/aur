+            let second = scope.spawn(|| {
+                let mut rdr = CountingReader {
+                    data: io::Cursor::new(bytes.clone()),
+                    read: second_read.clone(),
+                };
+                store_toolchain(&cache, &locks, &tc, &mut rdr)
+            });
