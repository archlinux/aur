[Desktop Entry]
Version=1.0
Name=Lark
Name[zh_CN]=Lark
# Only KDE 4 seems to use GenericName, so we reuse the KDE strings.
# From Ubuntu's language-pack-kde-XX-base packages, version 9.04-20090413.
GenericName=Lark
GenericName[zh_CN]=Lark
# Not translated in KDE, from Epiphany 2.26.1-0ubuntu1.
# Gnome and KDE 3 uses Comment.
Comment=Lark is a next-generation office suite that integrates messaging, schedule management, collaborative documents, video meeting, and various apps in one platform.
Comment[ja]=Lark は、メッセージ、スケジュール管理、文書の共同編集、ビデオ会議などの様々な機能を統合し、仕事を効率化する新世代のビジネスツールです。
Comment[zh_CN]=Lark 整合即时沟通、云文档、音视频会议、工作台等功能于一体，助力个人与企业开启未来办公新模式！
Exec=/usr/lib/larksuite-portable/larksuite.sh %U
StartupNotify=true
StartupWMClass=lark
Terminal=false
Icon=bytedance-lark
Type=Application
Categories=Office;
MimeType=message/rfc822;x-scheme-handler/feishu;x-scheme-handler/feishu-open;x-scheme-handler/lark;x-scheme-handler/x-lark;
X-KDE-DBUS-Restricted-Interfaces=org.kde.kwin.Screenshot,org.kde.KWin.ScreenShot2
# Additional config to ensure portable works properly
Actions=nosandbox;opendir;share;quit;
X-Flatpak-RenamedFrom=lark.desktop;
X-Flatpak-Tags=proprietary;
X-Flatpak=com.larksuite.suite;

[Desktop Action nosandbox]
Name=Toggle Sandbox...
Name[zh_CN]=更改沙盒偏好...
Exec=/usr/lib/larksuite-portable/larksuite.sh --actions f5aaebc6-0014-4d30-beba-72bce57e0650
Icon=security-low-symbolic

[Desktop Action opendir]
Name=Open Lark Home
Name[zh_CN]=打开数据目录
Exec=/usr/lib/larksuite-portable/larksuite.sh --actions opendir
Icon=go-home-symbolic

[Desktop Action share]
Name=Share files with Lark
Name[zh_CN]=向 Lark 传输文件
Exec=/usr/lib/larksuite-portable/larksuite.sh --actions share-files
Icon=insert-image-symbolic

[Desktop Action quit]
Name=Quit Lark
Name[zh_CN]=退出 Lark
Exec=/usr/lib/larksuite-portable/larksuite.sh --actions quit
Icon=system-log-out-symbolic
