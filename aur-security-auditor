    def worker(self, options):
        started = dt.datetime.now(dt.timezone.utc).isoformat()
        previous_report = load_json(self.p["state"] / "latest-report.json")
        try:
            core.require_arch()
            self.set_phase("Threat-Feed", "Lokale und aktuelle Kampagnenindikatoren laden")
            feed, feed_meta = campaign_feed(self.p, bool(options.get("refresh_feed", True)))
            suppressions = load_suppressions(self.p)
            dates = pacman_dates()

            self.set_phase("Paketinventar", "Installierte Fremd- und AUR-Pakete ermitteln")
            installed = core.foreign_packages()
            file_map = {}
            for index, (name, _) in enumerate(installed, 1):
                if self.cancel.is_set():
                    raise Cancelled()
                self.state["current_package"] = name
                self.state["detail"] = f"Dateiliste erfassen ({index}/{len(installed)})"
                file_map[name] = core.package_files(name)
            with self.lock:
                self.state["packages_total"] = len(installed)
                self.state["files_total"] = sum(map(len, file_map.values()))
                self.add_event("inventory", f"{len(installed)} Pakete und {self.state['files_total']} Dateien erfasst")

            aur_data = {}
            if options.get("aur_rpc", True) and installed:
                self.set_phase("AUR-Metadaten", "AUR-Zuordnung und Maintainerstatus abrufen")
                try:
                    aur_data = core.aur_rpc([name for name, _ in installed])
                except Exception as exc:
                    with self.lock:
                        self.state["warnings"].append(str(exc))
                        self.add_event("warning", f"AUR RPC: {exc}", severity="warning")

            args = SimpleNamespace(
                aur_rpc=bool(options.get("aur_rpc", True)),
                integrity=bool(options.get("integrity", True)),
                deep_binaries=bool(options.get("deep_binaries", True)),
                build_cache=bool(options.get("build_cache", True)),
            )
            cache_roots = core.cache_roots_for_users()
            results = []
            self.set_phase("Paketprüfung", "Dateien, Install-Hooks, Build-Caches und AUR-Quellen prüfen")
            jobs = max(1, min(int(options.get("jobs", 6)), 12))
            remote_source = bool(options.get("remote_source", True))
            aur_history = bool(options.get("aur_history", False))
            with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
                futures = {
                    pool.submit(
                        scan_package_task, pkg, file_map[pkg[0]], args, cache_roots,
                        aur_data, self.event, remote_source, aur_history,
                    ): pkg for pkg in installed
                }
                for future in concurrent.futures.as_completed(futures):
                    if self.cancel.is_set():
                        raise Cancelled()
                    name, _ = futures[future]
                    try:
                        raw = future.result()
                    except Cancelled:
                        raise
                    except Exception as exc:
                        with self.lock:
                            self.state["warnings"].append(f"{name}: {exc}")
                            self.add_event("warning", str(exc), name, "warning")
                        continue
                    exposure = []
                    if name in feed and name in dates:
                        try:
                            value = dt.datetime.fromisoformat(dates[name])
                            value = value.replace(tzinfo=value.tzinfo or dt.timezone.utc)
                            if CAMPAIGN_START <= value.astimezone(dt.timezone.utc) < CAMPAIGN_END:
                                exposure = ["Paketname in veröffentlichter Kampagnenliste", f"Installation/Update: {dates[name]}"]
                        except ValueError:
                            pass
                    normalized = normalize_result(raw, exposure, suppressions)
                    results.append(normalized)
                    with self.lock:
                        self.state["packages_done"] += 1
                        self.state["partial"][name] = normalized
                        self.add_event(
                            "package_done",
                            f"{normalized['verdict']} · {normalized['finding_count']} bewertete Funde",
                            name,
                            "critical" if normalized["verdict"] == "threat" else "high" if normalized["verdict"] == "suspicious" else "info",
                        )

            self.set_phase("System-IOCs", "Paketmanager-Caches und bekannte Persistenzartefakte prüfen")
            globals_ = scan_cache_iocs() if options.get("package_caches", True) else []
            for item in globals_:
                sup = suppressions.get(item["fingerprint"])
                if sup:
                    item["suppressed"], item["suppression_reason"] = True, sup.get("reason", "")

            self.set_phase("Netzwerk-Kontext", "Laufende Prozesse installierter Fremdpakete zuordnen")
            network = core.live_connections({name for name, _ in installed}) if options.get("live_network", True) else []

            self.set_phase("Bericht erstellen", "Ergebnisse korrelieren und Report speichern")
            report = make_report(results, globals_, started, feed_meta, [asdict(item) for item in network])
            report["delta"] = compare_reports(previous_report, report)
            stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
            target = self.p["reports"] / stamp
            private_directory(target)
            atomic_json(target / "report.json", report)
            bundle_path = target / "evidence.zip"
            atomic_bytes(bundle_path, evidence_bundle(report))
            atomic_json(self.p["state"] / "latest-report.json", report)
            with self.lock:
                final_elapsed = int(time.monotonic() - self.state["started"]) if self.state["started"] else 0
                self.state.update({
                    "status": "complete", "phase": "Abgeschlossen", "detail": str(target),
                    "report": report, "progress_percent": 100.0, "eta_seconds": 0,
                    "finished_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                    "elapsed_seconds": final_elapsed, "current_package": "",
                })
                self.add_event("scan_complete", "Vollständiger Scan abgeschlossen",
                               message_code="eventScanComplete", message_args={})
        except Cancelled:
            with self.lock:
                final_elapsed = int(time.monotonic() - self.state["started"]) if self.state["started"] else 0
                self.state.update({
                    "status": "cancelled", "phase": "Abgebrochen", "detail": "Scan wurde abgebrochen",
                    "finished_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                    "elapsed_seconds": final_elapsed, "eta_seconds": None,
                })
                self.add_event("scan_cancelled", "Scan abgebrochen", severity="warning",
                               message_code="eventScanCancelled", message_args={})
        except BaseException as exc:
            with self.lock:
                final_elapsed = int(time.monotonic() - self.state["started"]) if self.state["started"] else 0
                self.state.update({
                    "status": "failed", "phase": "Fehler", "error": str(exc), "detail": str(exc),
                    "finished_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                    "elapsed_seconds": final_elapsed, "eta_seconds": None,
                })
                self.add_event("scan_failed", str(exc), severity="critical")

    def public(self):
        with self.lock:
            report = self.state["report"]
            data = {key: value for key, value in self.state.items() if key not in {"report", "partial"}}
            data["preflight"] = json.loads(json.dumps(self.preflight_state))
            data["deep"] = json.loads(json.dumps(self.deep_state))
            data["update_guard"] = {"approvals": len(load_approvals(self.p).get("packages", {}))}
            if self.state["status"] == "running" and self.state["started"]:
                data["elapsed_seconds"] = int(time.monotonic() - self.state["started"])
            else:
                data["elapsed_seconds"] = int(self.state.get("elapsed_seconds", 0))
            if report:
                data.update({
                    "report_summary": report["summary"], "packages": report["packages"],
                    "global_findings": report["global_findings"], "network_context": report["network_context"],
                    "feed": report["feed"], "delta": report.get("delta", {}),
                })
            else:
                data.update({
                    "report_summary": None,
                    "packages": sorted(self.state["partial"].values(), key=lambda item: (-RANK[item["verdict"]], -item["score"], item["name"])),
                    "global_findings": [], "network_context": [], "feed": {}, "delta": {},
                })
            return json.loads(json.dumps(data))

    def package(self, name):
        report = self.state.get("report")
        if report:
            return next((item for item in report["packages"] if item["name"] == name), None)
        return self.state["partial"].get(name)

    def graph(self, name, depth=2):
        if not PACKAGE_RE.fullmatch(name):
            raise ValueError("Ungültiger Paketname")
        depth = max(0, min(int(depth), 3))
        cache_key = (name, depth)
        cached = self.graph_cache.get(cache_key)
        if cached and time.monotonic() - cached[0] < 300:
            return json.loads(json.dumps(cached[1]))
        nodes, edges, seen = {}, [], set()
        def walk(current, remaining):
            if current in seen or len(nodes) >= 80:
                return
            seen.add(current)
            meta = package_metadata(current)
            nodes[current] = {"id": current, "description": meta.get("description", "")}
            if remaining <= 0:
                return
            for dep in meta.get("depends", [])[:20]:
                edges.append({"source": current, "target": dep, "type": "depends"})
                walk(dep, remaining - 1)
            for parent in meta.get("required_by", [])[:20]:
                edges.append({"source": parent, "target": current, "type": "required-by"})
                walk(parent, remaining - 1)
        walk(name, depth)
        result = {"root": name, "nodes": list(nodes.values()), "edges": edges}
        self.graph_cache[cache_key] = (time.monotonic(), result)
        return json.loads(json.dumps(result))

    def preview(self, name):
        if not PACKAGE_RE.fullmatch(name):
            raise ValueError("Ungültiger Paketname")
        if name not in {pkg for pkg, _ in core.foreign_packages()}:
            raise ValueError("Kein installiertes Fremd-/AUR-Paket")
        meta = package_metadata(name)
        return {
            "name": name, "version": meta.get("version", ""), "description": meta.get("description", ""),
            "required_by": meta.get("required_by", []), "depends": meta.get("depends", []),
            "installed_size": meta.get("installed_size", ""), "can_remove": os.geteuid() == 0,
        }

    def uninstall(self, name, confirmation):
        if os.geteuid() != 0:
            raise PermissionError("Deinstallation benötigt root")
        if confirmation != f"REMOVE {name}":
            raise ValueError("Bestätigung stimmt nicht")
        if self.thread and self.thread.is_alive():
            raise RuntimeError("Während des Scans nicht möglich")
        preview = self.preview(name)
        cp = core.run(["pacman", "-Rns", "--noconfirm", "--", name], timeout=900)
        append_private_json_line(self.p["audit"], {
            "time": dt.datetime.now().isoformat(), "action": "uninstall",
            "package": name, "returncode": cp.returncode,
        })
        return {"ok": cp.returncode == 0, "stdout": cp.stdout, "stderr": cp.stderr, "preview": preview}

    def suppress(self, fingerprint, reason, remove=False):
        if not re.fullmatch(r"[0-9a-f]{64}", fingerprint):
            raise ValueError("Ungültiger Fingerprint")
        affected_name = ""
        data = load_suppressions(self.p)
        if remove:
            data.pop(fingerprint, None)
        else:
            data[fingerprint] = {
                "reason": reason[:300] or "Als legitim markiert",
                "created": dt.datetime.now().isoformat(),
            }
        atomic_json(self.p["suppressions"], data)
        report = self.state.get("report")
        if report:
            for pkg in report["packages"]:
                for item in pkg["findings"]:
                    if item["fingerprint"] == fingerprint:
                        affected_name = pkg.get("name", "")
                        item["suppressed"] = not remove
                        item["suppression_reason"] = "" if remove else data[fingerprint]["reason"]
                active = [item for item in pkg["findings"] if not item["suppressed"]]
                pkg["finding_count"] = len(active)
                pkg["score"] = sum(SEV[item["severity"]] for item in active)
                pkg["confidence"] = max([item["confidence"] for item in active] or [0])
                pkg["verdict"] = (
                    "threat" if any(item["severity"] == "critical" for item in active)
                    else "suspicious" if any(item["severity"] == "high" for item in active)
                    else "review" if active else "clean"
                )
            updated = make_report(
                report["packages"], report["global_findings"], report["started"],
                report["feed"], report["network_context"],
            )
            updated["delta"] = report.get("delta", {})
            self.state["report"] = updated
            atomic_json(self.p["state"] / "latest-report.json", updated)
        return self.package(affected_name) if affected_name else None


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "AURSecurityAuditor"
    sys_version = ""
    manager: Manager
    token: str
    nonce: str
    expected_host: str

    def log_message(self, *args):
        pass

    def local(self):
        try:
            return ipaddress.ip_address(self.client_address[0]).is_loopback
        except ValueError:
            return False

    def expected_request_host(self):
        return getattr(self, "expected_host", f"127.0.0.1:{self.server.server_address[1]}")

    def valid_host(self):
        return secrets.compare_digest(self.headers.get("Host", ""), self.expected_request_host())

    def valid_origin(self):
        origin = self.headers.get("Origin")
        if origin and not secrets.compare_digest(origin, f"http://{self.expected_request_host()}"):
            return False
        fetch_site = self.headers.get("Sec-Fetch-Site", "")
        return fetch_site in {"", "same-origin", "none"}

    def headers_common(self, ctype):
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("Permissions-Policy", "camera=(), microphone=(), geolocation=(), payment=(), usb=()")
        self.send_header(
            "Content-Security-Policy",
            f"default-src 'self'; script-src 'nonce-{self.nonce}'; style-src 'nonce-{self.nonce}'; "
            "connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; "
            "base-uri 'none'; form-action 'none'",
        )

    def json(self, data, status=200):
        payload = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(status)
        self.headers_common("application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def error(self, msg, status=400):
        self.json({"error": msg}, status)

    def csrf(self):
        return secrets.compare_digest(self.headers.get("X-AUR-CSRF", ""), self.token)

    def body(self):
        raw_length = self.headers.get("Content-Length", "0")
        try:
            length = int(raw_length)
        except ValueError as exc:
            raise ValueError("Ungültige Request-Länge") from exc
        if length < 0 or length > 1_000_000:
            raise ValueError("Request zu groß oder ungültig")
        try:
            data = json.loads(self.rfile.read(length) or b"{}")
        except json.JSONDecodeError as exc:
            raise ValueError("Ungültiger JSON-Request") from exc
        if not isinstance(data, dict):
            raise ValueError("JSON-Objekt erwartet")
        return data

    def request_allowed(self):
        return self.local() and self.valid_host()

    def do_GET(self):
        if not self.request_allowed():
            return self.error("Ungültiger lokaler Request", 403)
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/":
            text = data_file("dashboard.html").read_text().replace("__TOKEN__", self.token).replace("__NONCE__", self.nonce).replace("__VERSION__", VERSION)
            payload = text.encode()
            self.send_response(200)
            self.headers_common("text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return
        if parsed.path == "/icon.svg":
            payload = data_file("aur-security-auditor.svg").read_bytes()
            self.send_response(200)
            self.headers_common("image/svg+xml; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return
        if not self.csrf():
            return self.error("CSRF-Token fehlt", 403)
        query = urllib.parse.parse_qs(parsed.query)
        try:
            if parsed.path == "/api/state":
                self.json(self.manager.public())
            elif parsed.path == "/api/package":
                item = self.manager.package(query.get("name", [""])[0])
                self.json(item) if item else self.error("Nicht gefunden", 404)
            elif parsed.path == "/api/dependencies":
                self.json(self.manager.graph(query.get("name", [""])[0], query.get("depth", ["2"])[0]))
            elif parsed.path == "/api/report.json":
                self.json(self.manager.state["report"]) if self.manager.state["report"] else self.error("Noch kein Report", 404)
            elif parsed.path == "/api/preflight/report.json":
                report = self.manager.preflight_state.get("report")
                self.json(report) if report else self.error("Noch kein Preflight-Report", 404)
            elif parsed.path == "/api/deep/report.json":
                report = self.manager.deep_state.get("report")
                self.json(report) if report else self.error("Noch kein Tiefenprüfungs-Report", 404)
            elif parsed.path == "/api/update-guard/approvals":
                self.json(self.manager.approvals_public())
            elif parsed.path == "/api/deep/evidence.zip":
                report = self.manager.deep_state.get("report")
                if not report:
                    return self.error("Noch kein Tiefenprüfungs-Report", 404)
                payload = deep_evidence_bundle(report)
                self.send_response(200)
                self.headers_common("application/zip")
                self.send_header("Content-Disposition", f'attachment; filename="aur-security-auditor-{VERSION}-deep-evidence.zip"')
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)
            elif parsed.path == "/api/evidence.zip":
                report = self.manager.state["report"]
                if not report:
                    return self.error("Noch kein Report", 404)
                payload = evidence_bundle(report)
                self.send_response(200)
                self.headers_common("application/zip")
                self.send_header("Content-Disposition", f'attachment; filename="aur-security-auditor-{VERSION}-evidence.zip"')
                self.send_header("Content-Length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)
            else:
                self.error("Nicht gefunden", 404)
        except Exception as exc:
            self.error(str(exc), 500)

    def do_POST(self):
        if not self.request_allowed() or not self.valid_origin() or not self.csrf():
            return self.error("Lokaler Request-Schutz fehlgeschlagen", 403)
        if self.headers.get_content_type() != "application/json":
            return self.error("Content-Type application/json erforderlich", 415)
        try:
            body = self.body()
            if self.path == "/api/scan/start":
                ok, msg = self.manager.start(body)
                self.json({"ok": ok, "message": msg}, 200 if ok else 409)
            elif self.path == "/api/preflight/start":
                ok, msg = self.manager.start_preflight(str(body.get("target", "")), bool(body.get("history", False)))
                self.json({"ok": ok, "message": msg}, 200 if ok else 409)
            elif self.path == "/api/preflight/clear":
                ok, msg = self.manager.clear_preflight()
                self.json({"ok": ok, "message": msg})
            elif self.path == "/api/update-guard/approve":
                self.json({"ok": True, "approval": self.manager.approve_preflight()})
            elif self.path == "/api/update-guard/remove":
                self.json({"ok": True, "removed": self.manager.remove_guard_approval(str(body.get("package", "")))})
            elif self.path == "/api/deep/start":
                ok, msg = self.manager.start_deep(str(body.get("target", "")), bool(body.get("history", True)))
                self.json({"ok": ok, "message": msg}, 200 if ok else 409)
            elif self.path == "/api/deep/clear":
                ok, msg = self.manager.clear_deep()
                self.json({"ok": ok, "message": msg})
            elif self.path == "/api/deep/cancel":
                ok, msg = self.manager.cancel_deep()
                self.json({"ok": ok, "message": msg}, 200 if ok else 409)
            elif self.path == "/api/scan/cancel":
                ok, msg = self.manager.stop()
                self.json({"ok": ok, "message": msg}, 200 if ok else 409)
            elif self.path == "/api/package/uninstall/preview":
                self.json(self.manager.preview(str(body.get("name", ""))))
            elif self.path == "/api/package/uninstall":
                result = self.manager.uninstall(str(body.get("name", "")), str(body.get("confirmation", "")))
                self.json(result, 200 if result["ok"] else 409)
            elif self.path == "/api/suppress":
                package = self.manager.suppress(str(body.get("fingerprint", "")), str(body.get("reason", "")))
                self.json({"ok": True, "package": package})
            elif self.path == "/api/suppress/remove":
                package = self.manager.suppress(str(body.get("fingerprint", "")), "", True)
                self.json({"ok": True, "package": package})
            else:
                self.error("Nicht gefunden", 404)
        except PermissionError as exc:
            self.error(str(exc), 403)
        except ValueError as exc:
            self.error(str(exc), 400)
        except RuntimeError as exc:
            self.error(str(exc), 409)
        except Exception as exc:
            self.error(str(exc), 500)


