def utc_timestamp(value):
    try:
        return dt.datetime.fromtimestamp(int(value), dt.timezone.utc).isoformat()
    except (TypeError, ValueError, OSError):
        return None


def compare_versions(installed: str, available: str):
    if not installed or not available:
        return "unknown"
    if installed == available:
        return "current"
    if shutil.which("vercmp"):
        cp = core.run(["vercmp", installed, available], timeout=10)
        try:
            value = int(cp.stdout.strip())
        except (TypeError, ValueError):
            value = 0
        if value < 0:
            return "behind"
        if value > 0:
            return "ahead"
        return "current"
    return "different"


def _is_valid_declared_source_url(value: str) -> bool:
    value = value.strip()
    if not value:
        return False
    # Filter obvious placeholders such as http://[IP or https://[HOST.
    if "[" in value or "]" in value:
        return False
    try:
        parsed = urllib.parse.urlparse(value)
    except ValueError:
        return False
    if parsed.scheme not in {"http", "https", "git", "git+http", "git+https", "hg+http", "hg+https", "svn+http", "svn+https", "bzr+http", "bzr+https"}:
        return False
    host = (parsed.hostname or "").strip()
    return bool(host)


def _declared_source_urls(documents: dict[str, str]) -> list[str]:
    """Extract only declared package sources without executing PKGBUILD code.

    Prefer the expanded .SRCINFO values. PKGBUILD source arrays are used only
    when .SRCINFO provides no source entries, preventing duplicate unresolved
    ${variables} and unrelated URLs from comments, docs, tests or local UIs.
    Malformed placeholder URLs such as http://[IP are discarded.
    """
    srcinfo_urls: set[str] = set()
    for name, text in documents.items():
        if Path(name).name != ".SRCINFO":
            continue
        for line in text.splitlines():
            match = re.match(r"^\s*source(?:_[A-Za-z0-9_]+)?\s*=\s*(.+?)\s*$", line)
            if match:
                srcinfo_urls.update(url for url in core.URL_RE.findall(match.group(1)) if _is_valid_declared_source_url(url))
    if srcinfo_urls:
        return sorted(srcinfo_urls)[:100]

    pkgbuild_urls: set[str] = set()
    for name, text in documents.items():
        if Path(name).name != "PKGBUILD":
            continue
        # Static, bounded parsing of source()/source_arch=() assignments. This
        # deliberately does not expand variables or source the shell file.
        for match in re.finditer(
            r"(?ms)^\s*source(?:_[A-Za-z0-9_]+)?\s*=\s*\((.*?)\)", text
        ):
            pkgbuild_urls.update(url for url in core.URL_RE.findall(match.group(1)) if _is_valid_declared_source_url(url))
        for match in re.finditer(
            r"(?m)^\s*source(?:_[A-Za-z0-9_]+)?\s*=\s*([^\n(].*)$", text
        ):
            pkgbuild_urls.update(url for url in core.URL_RE.findall(match.group(1)) if _is_valid_declared_source_url(url))
    return sorted(pkgbuild_urls)[:100]


def _sanitize_report_source_provenance(report: dict[str, Any]) -> bool:
    """Remove malformed source placeholders from a loaded report in-place."""
    if not isinstance(report, dict):
        return False
    provenance = report.get("provenance")
    if not isinstance(provenance, dict):
        return False
    original = list(provenance.get("source_urls") or [])
    cleaned = sorted({
        str(value).strip() for value in original
        if _is_valid_declared_source_url(str(value))
    })[:100]
    if cleaned == original:
        return False
    hosts: list[str] = []
    insecure: list[str] = []
    direct_ip: list[str] = []
    for value in cleaned:
        try:
            parsed = urllib.parse.urlparse(value)
            host = (parsed.hostname or "").lower()
        except ValueError:
            continue
        if host:
            hosts.append(host)
            try:
                if ipaddress.ip_address(host):
                    direct_ip.append(value)
            except ValueError:
                pass
        if value.lower().startswith("http://"):
            insecure.append(value)
    provenance["source_urls"] = cleaned
    provenance["source_hosts"] = sorted(set(hosts))
    provenance["insecure_sources"] = insecure
    provenance["direct_ip_sources"] = direct_ip
    return True


def source_document_metadata(documents, snapshot_url="", snapshot_sha256=""):
    urls = set(_declared_source_urls(documents))
    checksum_algorithms = set()
    skip_count = 0
    install_files = []
    for name, text in documents.items():
        checksum_algorithms.update(
            match.group(1).lower()
            for match in re.finditer(r"\b(md5|sha1|sha224|sha256|sha384|sha512|b2)sums(?:_[a-z0-9_]+)?\s*[= ]", text, re.I)
        )
        skip_count += len(re.findall(r"(?:^|[=(\s'\"])SKIP(?:$|[)\s'\"])", text, re.I))
        if name.lower().endswith((".install", ".hook")):
            install_files.append(name)
    normalized_urls = sorted(urls)[:100]
    hosts = []
    insecure = []
    direct_ip = []
    ephemeral_hosts = []
    ephemeral = {"pastebin.com", "paste.ee", "transfer.sh", "temp.sh", "ngrok.io", "ngrok-free.app", "webhook.site"}
    vcs_count = 0
    for value in normalized_urls:
        try:
            parsed = urllib.parse.urlparse(value)
            host = (parsed.hostname or "").lower()
        except ValueError:
            host = ""
            parsed = None
        if host:
            hosts.append(host)
            if host in ephemeral or host.endswith(".onion"):
                ephemeral_hosts.append(host)
            try:
                if ipaddress.ip_address(host):
                    direct_ip.append(value)
            except ValueError:
                pass
        if value.lower().startswith("http://"):
            insecure.append(value)
        if value.lower().startswith(("git+", "hg+", "svn+", "bzr+")) or value.lower().endswith(".git"):
            vcs_count += 1
    return {
        "snapshot_url": snapshot_url,
        "snapshot_sha256": snapshot_sha256,
        "files_inspected": sorted(documents),
        "source_urls": normalized_urls,
        "source_hosts": sorted(set(hosts)),
        "checksum_algorithms": sorted(checksum_algorithms),
        "skip_count": skip_count,
        "install_files": sorted(install_files),
        "insecure_sources": insecure,
        "direct_ip_sources": direct_ip,
        "ephemeral_hosts": sorted(set(ephemeral_hosts)),
        "vcs_sources": vcs_count,
    }


def _run_git(args, cwd=None, timeout=45):
    env = os.environ.copy()
    env.update({
        "LC_ALL": "C", "LANG": "C", "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": os.devnull,
    })
    safe_args = [
        "-c", "core.hooksPath=/dev/null",
        "-c", "protocol.file.allow=never",
        "-c", "protocol.ext.allow=never",
        *args,
    ]
    try:
        return subprocess.run(
            ["git", *safe_args], cwd=cwd, text=True, capture_output=True,
            timeout=timeout, check=False, env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(["git", *args], 127, "", str(exc))


def fetch_aur_history_analysis(package, callback=None, commits=5):
    """Inspect a bounded recent AUR Git history. This is optional because it is network-heavy."""
    if not PACKAGE_RE.fullmatch(package) or not shutil.which("git"):
        return [], {"available": False, "error": "git unavailable or invalid package"}
    url = f"https://aur.archlinux.org/{urllib.parse.quote(package, safe='')}.git"
    with tempfile.TemporaryDirectory(prefix="aur-malware-history-") as temp:
        repo = Path(temp) / "repo"
        clone = _run_git(["clone", "--quiet", "--no-checkout", "--depth", str(max(2, commits + 1)), "--filter=blob:none", url, str(repo)], timeout=50)
        if clone.returncode != 0:
            clone = _run_git(["clone", "--quiet", "--no-checkout", "--depth", str(max(2, commits + 1)), url, str(repo)], timeout=50)
        if clone.returncode != 0:
            return [], {"available": False, "url": url, "error": (clone.stderr or clone.stdout).strip()[:500]}
        log = _run_git(["log", "-n", str(commits + 1), "--format=%H%x09%ct%x09%an%x09%s"], cwd=repo, timeout=20)
        rows = []
        for line in log.stdout.splitlines():
            parts = line.split("\t", 3)
            if len(parts) != 4:
                continue
            commit, timestamp, author, subject = parts
            rows.append({
                "commit": commit,
                "short": commit[:12],
                "time": utc_timestamp(timestamp),
                "author": author[:120],
                "subject": subject[:240],
            })
        current = _run_git(["show", "HEAD:PKGBUILD"], cwd=repo, timeout=15)
        previous = _run_git(["show", "HEAD^:PKGBUILD"], cwd=repo, timeout=15)
        current_text = current.stdout if current.returncode == 0 else ""
        previous_text = previous.stdout if previous.returncode == 0 else ""
        current_meta = source_document_metadata({"PKGBUILD": current_text}) if current_text else {}
        previous_meta = source_document_metadata({"PKGBUILD": previous_text}) if previous_text else {}
        current_hosts = set(current_meta.get("source_hosts", []))
        previous_hosts = set(previous_meta.get("source_hosts", []))
        added_hosts = sorted(current_hosts - previous_hosts)
        removed_hosts = sorted(previous_hosts - current_hosts)
        new_skip = max(0, int(current_meta.get("skip_count", 0)) - int(previous_meta.get("skip_count", 0)))
        findings = []
        diff = _run_git(["diff", "--no-ext-diff", "--unified=0", "HEAD^", "HEAD", "--", "PKGBUILD", ".SRCINFO", "*.install"], cwd=repo, timeout=20)
        added_lines = "\n".join(
            line[1:] for line in diff.stdout.splitlines()
            if line.startswith("+") and not line.startswith("+++")
        )[:core.MAX_TEXT_BYTES]
        if added_lines:
            latest = rows[0]["short"] if rows else "HEAD"
            found = core.scan_text(package, f"AUR history:{latest}:added-lines", added_lines)
            findings.extend(found)
            if callback:
                callback("aux", package, f"AUR-Historie: {latest}", found)
        if new_skip:
            findings.append(core.Finding(
                "medium", "aur-new-checksum-skip", package, "AUR history:PKGBUILD",
                "Recent AUR change introduced additional skipped source checksums",
                f"new SKIP entries={new_skip}", 0, "",
            ))
        if added_hosts:
            findings.append(core.Finding(
                "low", "aur-source-host-change", package, "AUR history:PKGBUILD",
                "Recent AUR change introduced new source hosts",
                ", ".join(added_hosts)[:500], 0, "",
            ))
        return findings, {
            "available": True,
            "url": url,
            "commits": rows[:commits],
            "added_source_hosts": added_hosts,
            "removed_source_hosts": removed_hosts,
            "new_skip_count": new_skip,
        }


def refresh_feed(p):
    req = urllib.request.Request(FEED_URL, headers={"User-Agent": f"aur-security-auditor/{VERSION}"})
    with urllib.request.urlopen(req, timeout=25) as response:
        raw = response.read(5_000_001)
    if len(raw) > 5_000_000:
        raise RuntimeError("Threat-Feed ist zu groß")
    text = raw.decode("utf-8")
    names = {line.strip() for line in text.splitlines() if PACKAGE_RE.fullmatch(line.strip())}
    if len(names) < 100:
        raise RuntimeError("Threat-Feed ist unvollständig")
    private_text(p["feed"], "\n".join(sorted(names)) + "\n")
    return names, {"source": FEED_URL, "entries": len(names), "updated": dt.datetime.now(dt.timezone.utc).isoformat()}


def campaign_feed(p, refresh: bool):
    bundled = read_names(data_file("atomic-arch-packages.txt"))
    cached = read_names(p["feed"])
    names = cached or bundled
    meta = {"source": "cached" if cached else "bundled", "entries": len(names)}
    if refresh:
        try:
            names, meta = refresh_feed(p)
        except Exception as exc:
            meta["refresh_error"] = str(exc)
    return names, meta


def package_metadata(name: str):
    if not PACKAGE_RE.fullmatch(name):
        return {"name": name, "depends": [], "required_by": [], "error": "Ungültiger Paketname"}
    try:
        cp = core.run(["pacman", "-Qi", name], timeout=45)
    except (OSError, FileNotFoundError) as exc:
        return {"name": name, "depends": [], "required_by": [], "error": str(exc)}
    if cp.returncode != 0:
        return {"name": name, "depends": [], "required_by": [], "error": cp.stderr.strip()}
    fields = {}
    current = None
    for line in cp.stdout.splitlines():
        if " : " in line and not line.startswith(" "):
            current, value = line.split(" : ", 1)
            fields[current.strip()] = value.strip()
        elif current and line.startswith(" "):
            fields[current.strip()] += " " + line.strip()
    def list_field(key):
        value = fields.get(key, "")
        return [] if value in {"", "None"} else value.split()
    def clean(items):
        return [re.split(r"[<>=]", item, maxsplit=1)[0] for item in items if item and item != "None"]
    return {
        "name": fields.get("Name", name), "version": fields.get("Version", ""),
        "description": fields.get("Description", ""), "url": fields.get("URL", ""),
        "installed_size": fields.get("Installed Size", ""), "install_date": fields.get("Install Date", ""),
        "packager": fields.get("Packager", ""), "depends": clean(list_field("Depends On")),
        "required_by": clean(list_field("Required By")), "optional_for": clean(list_field("Optional For")),
    }


def pacman_dates():
    result = {}
    pattern = re.compile(r"^\[(?P<date>[^\]]+)\]\s+\[ALPM\]\s+(?:installed|upgraded|downgraded)\s+(?P<name>[A-Za-z0-9@._+:-]+)\s+")
    for path in sorted(Path("/var/log").glob("pacman.log*")):
        if path.suffix not in {"", ".log"}:
            continue
        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for line in lines:
            match = pattern.match(line)
            if match:
                result[match.group("name")] = match.group("date")
    return result


def fp(finding):
    value = "\0".join([finding.package, finding.rule, finding.path, finding.sha256, finding.evidence[:500]])
    return hashlib.sha256(value.encode(errors="replace")).hexdigest()


def new_finding(severity, rule, package, path, message, evidence, confidence, reasons, source=None):
    obj = {
        "severity": severity, "rule": rule, "package": package, "path": path,
        "message": message, "evidence": evidence, "line": getattr(source, "line", 0) if source else 0,
        "sha256": getattr(source, "sha256", "") if source else "", "confidence": confidence,
        "reasons": reasons, "suppressed": False, "suppression_reason": "",
    }
    obj["fingerprint"] = hashlib.sha256("\0".join([
        package, rule, path, obj["sha256"], evidence[:500]
    ]).encode(errors="replace")).hexdigest()
    return obj


def normalize_result(result, exposure, suppressions):
    """Turn raw indicators into context-aware, explainable package verdicts.

    String matches remain available as raw evidence, but only executable, build,
    install, service or native-binary contexts may create behavioral findings.
    Documentation, wordlists, CI definitions, tests, fixtures, static assets and
    foreign-platform binaries never become a package alarm on wording alone.
    """
    raw = result.findings
    by_rule = {}
    for item in raw:
        by_rule.setdefault(item.rule, []).append(item)
    rules = set(by_rule)
    active = []

    def clean_path(item):
        value = str(item.path or "").replace(" [strings]", "")
        return value.replace("\\", "/")

    def signal_context(item):
        path = clean_path(item)
        lower = path.lower()
        base = Path(lower).name
        suffix = Path(base).suffix
        parts = {part for part in lower.split("/") if part}

        foreign_names = (
            "-macos", "_macos", "-darwin", "_darwin", "macos-", "darwin-",
            "-windows", "_windows", "windows-", "win32", "win64",
        )
        if base.endswith((".exe", ".dll", ".dylib", ".app")) or any(marker in base for marker in foreign_names):
            return "foreign-binary"
        if any(marker in lower for marker in ("/.github/workflows/", "/.gitlab/", "/.circleci/")) or base in {
                ".gitlab-ci.yml", "azure-pipelines.yml", "jenkinsfile"}:
            return "ci"
        if any(marker in lower for marker in ("/.cache/yay/", "/.cache/paru/clone/", "/.cache/pikaur/build/")):
            return "build"
        if lower.startswith(("aur snapshot:", "aur history:")):
            return "build"
        if base in {"pkgbuild", ".srcinfo"}:
            return "build"
        if any(marker in parts for marker in {"tests", "testing", "fixture", "fixtures", "demo", "demos", "example", "examples", "sample", "samples"}):
            return "test-data"
        if any(marker in parts for marker in {"doc", "docs", "documentation"}) or base.startswith(("readme", "changelog", "changes", "authors", "contributing")) or suffix in {".md", ".mdx", ".rst", ".adoc"}:
            return "documentation"
        if base in {"metadata", "record", "entry_points.txt", "top_level.txt"} or ".dist-info/" in lower or ".egg-info/" in lower:
            return "metadata"
        if base in {"dockerfile", "containerfile", "makefile", "cmakelists.txt", "meson.build"}:
            return "build-recipe"
        if any(token in base for token in ("wordlist", "word-list", "dictionary", "dicc")) or any(marker in parts for marker in {"wordlists", "dictionaries"}):
            return "wordlist"
        if suffix in {".css", ".svg", ".woff", ".woff2", ".ttf", ".otf", ".map"} or "/static/vendor/" in lower or "/vendor/" in lower or base.endswith((".min.js", ".min.css")):
            return "asset"
        if base in {"package.json", "package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "pyproject.toml", "cargo.lock", "go.sum"}:
            return "manifest"
        if base.endswith((".install", ".hook")) or "/var/lib/pacman/local/" in lower and base == "install":
            return "install"
        if base.endswith((".service", ".timer", ".socket", ".path")) or "/systemd/" in lower:
            return "service"
        if str(item.path).lower().endswith(" [strings]"):
            return "binary"
        if base.endswith((".sh", ".bash", ".zsh", ".fish", ".py", ".pl", ".rb", ".js", ".mjs", ".cjs", ".desktop")):
            return "executable"
        if lower.startswith(("/usr/bin/", "/usr/sbin/", "/opt/")) and suffix not in {".txt", ".json", ".yaml", ".yml", ".conf", ".env"}:
            return "executable"
        if suffix in {".txt", ".csv", ".json", ".yaml", ".yml", ".toml", ".ini", ".conf", ".env"}:
            return "data"
        return "other"

    behavioral_contexts = {"build", "install", "service", "executable", "binary"}

    def actionable(item):
        return signal_context(item) in behavioral_contexts

    def first(names, predicate=None):
        for name in names:
            for item in by_rule.get(name, []):
                if predicate is None or predicate(item):
                    return item
        return None

    def same_path_items(rule_a, rule_b, predicate=None):
        for left in by_rule.get(rule_a, []):
            for right in by_rule.get(rule_b, []):
                if clean_path(left) != clean_path(right):
                    continue
                if predicate is None or predicate(left, right):
                    return left, right
        return None

    def same_path(rule_a, rule_b, predicate=None):
        return same_path_items(rule_a, rule_b, predicate) is not None

    def correlated(primary, secondaries, predicate=None):
        for secondary in secondaries:
            pair = same_path_items(primary, secondary, predicate)
            if pair:
                return pair
        return None

    def add(severity, rule, message, confidence, reasons, preferred, predicate=None):
        src = first(preferred, predicate)
        path = src.path if src else "package"
        evidence = src.evidence if src else ""
        active.append(new_finding(severity, rule, result.name, path, message, evidence, confidence, reasons, src))

    def public_direct_ip(item):
        for value in re.findall(r"https?://((?:\d{1,3}\.){3}\d{1,3})", item.evidence or "", re.I):
            try:
                address = ipaddress.ip_address(value)
            except ValueError:
                continue
            if not (address.is_private or address.is_loopback or address.is_link_local or address.is_reserved or address.is_unspecified):
                return True
        return False

    def strong_hiding(item):
        return bool(re.search(
            r"(?:hide[_ -]?(?:process|file|port|socket|pid)|hidden[_ -]?(?:pids?|names?|inodes?|ports?|sockets?)|"
            r"NETLINK_SOCK_DIAG|inet_diag|/proc/\d+/(?:mem|maps)|/sys/fs/bpf/hidden_)",
            item.evidence or "", re.I,
        ))

    # Exact cryptographic indicators remain hard evidence regardless of context.
    if "known-malware-hash" in rules:
        add("critical", "confirmed-malware-hash", "Datei stimmt exakt mit einem bestätigten Malware-Hash überein", 100,
            ["Exakter SHA256-Treffer", "Kein heuristischer oder textbasierter Treffer"], ["known-malware-hash"])

    c2_exec = first(["atomic-arch-c2"], actionable)
    if c2_exec and (same_path("atomic-arch-c2", "network-client", lambda a, b: actionable(a) and actionable(b)) or signal_context(c2_exec) == "build"):
        add("critical", "confirmed-atomic-arch-c2", "Bestätigter Atomic-Arch-C2-Endpunkt in ausführbarem Netzwerk-Kontext", 99,
            ["Exakter veröffentlichter C2", "Ausführbarer oder Build-Kontext", "Netzwerkfähige Logik"], ["atomic-arch-c2"],
            lambda item: item is c2_exec)
    elif "atomic-arch-c2" in rules:
        add("medium", "ioc-reference-review", "Bekannter C2-Indikator wird als Text oder Datenreferenz geführt", 68,
            ["Exakter IOC-String", "Kein nachgewiesener Verbindungs- oder Ausführungskontext"], ["atomic-arch-c2"])

    dep_rules = ["atomic-arch-dependency", "atomic-arch-ioc"]
    dep_src = first(dep_rules, lambda item: signal_context(item) in {"build", "install", "manifest"})
    if result.name in MALICIOUS_DEPS:
        add("critical", "confirmed-malicious-package", "Installierter Paketname entspricht einem bestätigten Kampagnenartefakt", 100,
            ["Exakter bösartiger Paketname", "Paket ist lokal installiert"], dep_rules)
    elif dep_src:
        add("critical", "confirmed-atomic-arch-dependency", "Bekannte bösartige Atomic-Arch-Abhängigkeit wird im Build eingebunden", 99,
            ["Exakter Kampagnen-Paketname", "PKGBUILD-, Lockfile-, Manifest- oder Installationskontext"], dep_rules,
            lambda item: item is dep_src)
    elif set(dep_rules) & rules:
        add("low", "ioc-name-reference", "Bekannter Kampagnenname wird außerhalb eines Build-/Installationskontexts erwähnt", 35,
            ["Nur Textreferenz", "Kein Nachweis, dass die Abhängigkeit installiert oder ausgeführt wird"], dep_rules)

    download_exec = first(["shell-download-exec"], actionable)
    if download_exec:
        add("high", "download-execute-chain", "Remote-Inhalt wird unmittelbar an eine Shell übergeben", 96,
            ["Download und Ausführung in derselben Befehlskette", "Keine Integritätsprüfung zwischen beiden Schritten", f"Kontext: {signal_context(download_exec)}"],
            ["shell-download-exec"], lambda item: item is download_exec)

    encoded_exec = first(["encoded-payload-exec"], actionable)
    if encoded_exec:
        add("high", "encoded-execution", "Dekodierte oder verschleierte Payload wird direkt ausgeführt", 97,
            ["Dekodierung/Obfuscation", "Direkte Shell-Ausführung", f"Kontext: {signal_context(encoded_exec)}"],
