def invoking_user():
    name = os.environ.get("SUDO_USER") if os.geteuid() == 0 else None
    try:
        entry = pwd.getpwnam(name) if name else pwd.getpwuid(os.getuid())
    except KeyError:
        entry = pwd.getpwuid(os.getuid())
    return entry.pw_name, Path(entry.pw_dir), entry.pw_uid


def ownership():
    name, _, uid = invoking_user()
    try:
        gid = pwd.getpwnam(name).pw_gid
    except KeyError:
        gid = os.getgid()
    return uid, gid


def chown_to_user(path: Path):
    if os.geteuid() != 0:
        return
    try:
        uid, gid = ownership()
        os.chown(path, uid, gid)
    except OSError:
        pass


def private_directory(path: Path) -> None:
    if path.is_symlink():
        raise RuntimeError(f"Unsicherer Datenpfad (Symlink): {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    try:
        os.fchmod(fd, 0o700)
        if os.geteuid() == 0:
            try:
                uid, gid = ownership()
                os.fchown(fd, uid, gid)
            except OSError:
                pass
    finally:
        os.close(fd)


def atomic_bytes(path: Path, payload: bytes, mode: int = 0o600) -> None:
    parent_existed = path.parent.exists()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if not parent_existed:
        try:
            path.parent.chmod(0o700)
        except OSError:
            pass
        chown_to_user(path.parent)
    temp = path.with_name(path.name + ".tmp-" + secrets.token_hex(6))
    fd = None
    try:
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        with os.fdopen(fd, "wb") as handle:
            fd = None
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp, path)
        try:
            path.chmod(mode)
        except OSError:
            pass
        chown_to_user(path)
        try:
            directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except OSError:
            pass
    finally:
        if fd is not None:
            os.close(fd)
        try:
            temp.unlink(missing_ok=True)
        except OSError:
            pass


def private_text(path: Path, text: str) -> None:
    atomic_bytes(path, text.encode("utf-8"), 0o600)


def append_private_json_line(path: Path, data: dict) -> None:
    private_directory(path.parent)
    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as handle:
            fd = -1
            handle.write(json.dumps(data, ensure_ascii=False) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        if fd >= 0:
            os.close(fd)
    chown_to_user(path)


