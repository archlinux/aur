def load_core():
    candidates = [
        Path(__file__).resolve().with_name("core.py"),
        Path("/usr/lib/aur-security-auditor/core.py"),
        Path("/usr/local/lib/aur-security-auditor/core.py"),
    ]
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location("aur_security_auditor_core", path)
            module = importlib.util.module_from_spec(spec)
            assert spec and spec.loader
            sys.modules[spec.name] = module
            spec.loader.exec_module(module)
            return module
    raise RuntimeError("Scanner-Core wurde nicht gefunden")


