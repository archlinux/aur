def scan_cache_iocs():
    alerts = []
    _, home, _ = invoking_user()
    roots = [home / ".npm", home / ".bun/install/cache", home / ".cache/yarn", home / ".yarn/berry/cache", home / ".local/share/pnpm"]
    seen = 0
    for root in roots:
        if not root.exists(): continue
        for path in root.rglob("*"):
            seen += 1
            if seen > 50000: return alerts
            low = path.name.lower()
            dep = next((name for name in MALICIOUS_DEPS if name in low), None)
            if dep:
                alerts.append(new_finding("critical", "malicious-package-cache", "[system]", str(path),
                    f"Bekanntes bösartiges JavaScript-Paket im lokalen Cache: {dep}", str(path), 99,
                    ["Exakter Kampagnen-Paketname", "Lokaler Paketmanager-Cache"] ))
    for path in BPF_MAPS:
        if Path(path).exists():
            alerts.append(new_finding("critical", "known-ebpf-map", "[system]", path,
                "Bekannte Atomic-Arch-eBPF-Map vorhanden", path, 100,
                ["Exakter veröffentlichter Rootkit-Indikator"] ))
    return alerts


def make_report(packages, globals_, started, feed_meta, network):
    verdicts = {name: 0 for name in ["threat", "suspicious", "review", "clean", "unknown"]}
    severities = {name: 0 for name in SEV}
    categories = {}
    surfaces = {}
    for pkg in packages:
        verdicts[pkg["verdict"]] += 1
        for kind, count in pkg.get("surface_counts", {}).items():
            surfaces[kind] = surfaces.get(kind, 0) + count
        for finding in pkg["findings"]:
            if finding["suppressed"]: continue
            severities[finding["severity"]] += 1
            categories[finding["rule"]] = categories.get(finding["rule"], 0) + 1
    for finding in globals_:
        if not finding["suppressed"]:
            severities[finding["severity"]] += 1
            categories[finding["rule"]] = categories.get(finding["rule"], 0) + 1
    packages.sort(key=lambda item: (-RANK[item["verdict"]], -item["score"], item["name"]))
    return {
        "tool": "AUR Security Auditor", "version": VERSION, "schema_version": 2,
        "hostname": os.uname().nodename, "kernel": os.uname().release, "started": started,
        "finished": dt.datetime.now(dt.timezone.utc).isoformat(), "root": os.geteuid() == 0,
        "capabilities": [
            "installed-file-analysis", "elf-hardening", "security-surface-inventory",
            "aur-source-provenance", "optional-aur-history", "runtime-network-context",
            "baseline-delta", "evidence-bundle", "pre-install-static-analysis",
            "update-guard", "local-package-source-analysis",
        ],
        "feed": feed_meta, "summary": {
            "packages": len(packages), "files_checked": sum(item["files_checked"] for item in packages),
            "bytes_checked": sum(item["bytes_checked"] for item in packages), "package_verdicts": verdicts,
            "findings": severities, "categories": categories, "security_surface": dict(sorted(surfaces.items())),
            "provenance_packages": sum(bool(item.get("source_provenance", {}).get("available")) for item in packages),
            "history_packages": sum(bool(item.get("aur_history", {}).get("available")) for item in packages),
            "suppressed": sum(item["suppressed_count"] for item in packages),
        }, "packages": packages, "global_findings": globals_, "network_context": network,
    }


def _active_findings(report):
    output = {}
    if not report:
        return output
    for package in report.get("packages", []):
        for finding in package.get("findings", []):
            if not finding.get("suppressed") and finding.get("fingerprint"):
                output[finding["fingerprint"]] = {**finding, "package": package.get("name", finding.get("package", ""))}
    for finding in report.get("global_findings", []):
        if not finding.get("suppressed") and finding.get("fingerprint"):
            output[finding["fingerprint"]] = finding
    return output


def compare_reports(previous, current):
    if not previous or not previous.get("packages"):
        for package in current.get("packages", []):
            package["delta"] = {"status": "baseline", "new_findings": 0, "resolved_findings": 0}
        return {
            "baseline_available": False, "baseline_finished": None,
            "summary": {"new_findings": 0, "resolved_findings": 0, "new_packages": 0, "removed_packages": 0, "version_changes": 0, "verdict_changes": 0, "changed_packages": 0},
            "new_findings": [], "resolved_findings": [], "new_packages": [], "removed_packages": [],
            "version_changes": [], "verdict_changes": [],
        }
    old_packages = {item.get("name"): item for item in previous.get("packages", []) if item.get("name")}
    new_packages_by_name = {item.get("name"): item for item in current.get("packages", []) if item.get("name")}
    old_findings = _active_findings(previous)
    new_findings_map = _active_findings(current)
    added_keys = sorted(set(new_findings_map) - set(old_findings))
    resolved_keys = sorted(set(old_findings) - set(new_findings_map))
    new_names = sorted(set(new_packages_by_name) - set(old_packages))
    removed_names = sorted(set(old_packages) - set(new_packages_by_name))
    version_changes = []
    verdict_changes = []
    changed = set(new_names) | set(removed_names)
    for name in sorted(set(old_packages) & set(new_packages_by_name)):
        old, new = old_packages[name], new_packages_by_name[name]
        if old.get("version") != new.get("version"):
            version_changes.append({"package": name, "from": old.get("version", ""), "to": new.get("version", "")})
            changed.add(name)
        if old.get("verdict") != new.get("verdict"):
            verdict_changes.append({"package": name, "from": old.get("verdict", "unknown"), "to": new.get("verdict", "unknown")})
            changed.add(name)
    added_by_package = {}
    resolved_by_package = {}
    for key in added_keys:
        added_by_package[new_findings_map[key].get("package", "")] = added_by_package.get(new_findings_map[key].get("package", ""), 0) + 1
        changed.add(new_findings_map[key].get("package", ""))
    for key in resolved_keys:
        resolved_by_package[old_findings[key].get("package", "")] = resolved_by_package.get(old_findings[key].get("package", ""), 0) + 1
        changed.add(old_findings[key].get("package", ""))
    for package in current.get("packages", []):
        name = package.get("name", "")
        status = "new" if name in new_names else "changed" if name in changed else "unchanged"
        package["delta"] = {
            "status": status,
            "new_findings": added_by_package.get(name, 0),
            "resolved_findings": resolved_by_package.get(name, 0),
        }
        for finding in package.get("findings", []):
            if finding.get("fingerprint") in added_keys:
                finding["delta_status"] = "new"
            elif finding.get("fingerprint"):
                finding["delta_status"] = "existing"
    compact = lambda item: {key: item.get(key) for key in ("fingerprint", "package", "severity", "rule", "message", "path", "confidence")}
    return {
        "baseline_available": True,
        "baseline_finished": previous.get("finished"),
        "summary": {
            "new_findings": len(added_keys), "resolved_findings": len(resolved_keys),
            "new_packages": len(new_names), "removed_packages": len(removed_names),
            "version_changes": len(version_changes), "verdict_changes": len(verdict_changes),
            "changed_packages": len({name for name in changed if name}),
        },
        "new_findings": [compact(new_findings_map[key]) for key in added_keys[:500]],
        "resolved_findings": [compact(old_findings[key]) for key in resolved_keys[:500]],
        "new_packages": new_names, "removed_packages": removed_names,
        "version_changes": version_changes, "verdict_changes": verdict_changes,
    }


def evidence_bundle(report):
    report_bytes = json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True).encode()
    summary = report.get("summary", {})
    delta = report.get("delta", {}).get("summary", {})
    readme = (
        f"AUR Security Auditor evidence bundle\n"
        f"Version: {report.get('version', '')}\n"
        f"Schema: {report.get('schema_version', '')}\n"
        f"Host: {report.get('hostname', '')}\n"
        f"Finished: {report.get('finished', '')}\n"
        f"Packages: {summary.get('packages', 0)}\n"
        f"Files checked: {summary.get('files_checked', 0)}\n"
        f"New findings since baseline: {delta.get('new_findings', 0)}\n\n"
        "The SHA-256 manifest authenticates the files inside this archive. It is not a digital signature.\n"
    ).encode()
    manifest = (
        f"{hashlib.sha256(report_bytes).hexdigest()}  report.json\n"
        f"{hashlib.sha256(readme).hexdigest()}  README.txt\n"
    ).encode()
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        archive.writestr("report.json", report_bytes)
        archive.writestr("README.txt", readme)
        archive.writestr("manifest.sha256", manifest)
    return buffer.getvalue()


