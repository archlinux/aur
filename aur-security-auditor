    credential_pair = same_path_items(
        "credential-targeting", "network-client",
        lambda credential, network: actionable(credential) and actionable(network) and upload_pattern.search(network.evidence or "") is not None,
    )
    credential_upload = credential_pair is not None
    if credential_upload:
        credential_src, _ = credential_pair
        add("high", "credential-exfiltration", "Konkreter Credential-/Session-Zugriff wird in derselben ausführbaren Datei mit Upload-Logik kombiniert", 95,
            ["Konkreter lokaler Secret-/Session-Pfad", "Outbound-Upload", "Korrelation innerhalb derselben ausführbaren Datei"],
            ["credential-targeting"], lambda item: item is credential_src)

    ebpf_pair = same_path_items(
        "kernel-ebpf", "process-hiding",
        lambda ebpf, hiding: actionable(ebpf) and actionable(hiding) and strong_hiding(hiding),
    )
    if ebpf_pair:
        ebpf_src, _ = ebpf_pair
        same_file_extra = any(
            clean_path(item) == clean_path(ebpf_src) and actionable(item)
            for rule in ("credential-targeting", "shell-download-exec", "encoded-payload-exec", "suspicious-temp-exec")
            for item in by_rule.get(rule, [])
        )
        if same_file_extra or exposure:
            add("high", "ebpf-stealth-chain", "eBPF-Funktionen werden mit expliziten Hiding-Primitiven und weiterem Angriffskontext kombiniert", 95,
                ["eBPF", "Explizites Prozess-/Datei-/Socket-Hiding in derselben Datei", "Zusätzlicher Payload- oder Kampagnenkontext"],
                ["kernel-ebpf"], lambda item: item is ebpf_src)
        else:
            add("medium", "ebpf-stealth-review", "eBPF und explizite Hiding-Primitiven treten gemeinsam auf und benötigen Kontextprüfung", 78,
                ["Technisch starke Kombination", "Ohne Exfiltration oder Payload kein HIGH-Urteil"],
                ["kernel-ebpf"], lambda item: item is ebpf_src)

    strong_payload_rules = {"shell-download-exec", "encoded-payload-exec", "suspicious-temp-exec", "security-disable"}
    persistence_pair = correlated(
        "persistence-systemd", strong_payload_rules,
        lambda persistence, payload: actionable(persistence) and actionable(payload),
    )
    if persistence_pair:
        persistence_src, _ = persistence_pair
        add("high", "payload-persistence", "Ausgeführte oder nachgeladene Payload richtet systemd-Persistenz ein", 96,
            ["Ausführungskette", "Persistenzmechanismus in derselben Datei"], ["persistence-systemd"],
