def scan_path_with_hash(package: str, path: str, deep_binaries: bool):
    findings, size = _original_scan_path(package, path, deep_binaries)
    p = Path(path)
    if p.is_file():
        try:
            digest = core.sha256_file(p)
        except OSError:
            digest = ""
        if digest in KNOWN_HASHES:
            findings.append(core.Finding(
                "critical", "known-malware-hash", package, path,
                KNOWN_HASHES[digest], digest, 0, digest,
            ))
    return findings, size

core.scan_path = scan_path_with_hash


class Cancelled(Exception):
