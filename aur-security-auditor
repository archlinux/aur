        if ip_pair:
            break
    if ip_pair:
        direct_src, _ = ip_pair
        add("high", "direct-ip-execution", "Öffentliche Direkt-IP-Quelle wird mit Payload-Ausführung kombiniert", 93,
            ["Öffentliche Direkt-IP statt nachvollziehbarer Paketquelle", "Ausführungslogik in derselben Datei"],
            ["direct-ip-url"], lambda item: item is direct_src)

    defense_pair = correlated(
        "security-disable", {"shell-download-exec", "encoded-payload-exec", "suspicious-temp-exec"},
        lambda defense, payload: actionable(defense) and actionable(payload),
    )
    if defense_pair:
        defense_src, _ = defense_pair
        add("high", "defense-evasion", "Sicherheitskontrollen werden im Payload-Kontext deaktiviert", 95,
            ["Security-Control-Manipulation", "Konkrete Payload-Ausführung in derselben Datei"],
            ["security-disable"], lambda item: item is defense_src)

    privilege_pair = correlated(
        "suid-capability", {"shell-download-exec", "encoded-payload-exec", "suspicious-temp-exec", "security-disable"},
        lambda privilege, payload: actionable(privilege) and actionable(payload),
    )
    installed_privileged = first(["installed-suid", "installed-sgid"])
    privilege_setters = [item for item in by_rule.get("suid-capability", []) if actionable(item)]

    def setter_explains(installed):
        if not installed:
            return None
        installed_path = clean_path(installed)
        basename = Path(installed_path).name
        for setter in privilege_setters:
            evidence = setter.evidence or ""
            if installed_path in evidence or (basename and re.search(rf"(?:/|\\){re.escape(basename)}(?:[\s\"'`;]|$)", evidence)):
                return setter
        return None

    explained_setter = setter_explains(installed_privileged)
    if privilege_pair:
        privilege_src, _ = privilege_pair
        add("high", "privileged-payload", "Payload-Kontext erhält SUID oder mächtige Capabilities", 93,
            ["Privilegienänderung", "Payload-Signal in derselben Datei"], ["suid-capability"],
            lambda item: item is privilege_src)
    elif installed_privileged and explained_setter:
        add("low", "expected-privileged-surface", "Paketinstallationsskript setzt nachvollziehbar SUID/SGID auf eine paketverwaltete Datei", 55,
            ["Installierte privilegierte Datei", "Gleicher Dateiname im Installationsskript", "Sicherheitsoberfläche bleibt sichtbar, ist aber kein Malware-Beweis"],
            [installed_privileged.rule], lambda item: item is installed_privileged)
    elif installed_privileged:
        add("medium", "privileged-installed-file", "Paket installiert eine SUID-/SGID-Datei ohne passende Erklärung im Installationsskript", 70,
            ["Erweiterte lokale Rechte", "Zweck und Herkunft sollten geprüft werden"],
            [installed_privileged.rule], lambda item: item is installed_privileged)

    if "elf-unsafe-interpreter" in rules:
        add("high", "unsafe-elf-interpreter", "ELF verwendet einen unsicheren oder relativen Programminterpreter", 96,
            ["Loader-Pfad ist relativ oder liegt in einem temporären Verzeichnis", "Ausführung wird vor dem Programmeinstieg umgeleitet"],
            ["elf-unsafe-interpreter"])
    if "elf-unsafe-rpath" in rules:
        correlated_network = same_path("elf-unsafe-rpath", "network-client", lambda a, b: actionable(a) and actionable(b)) or same_path(
            "elf-unsafe-rpath", "direct-ip-url", lambda a, b: actionable(a) and actionable(b) and public_direct_ip(b))
        add("high" if correlated_network else "medium", "unsafe-elf-search-path",
            "ELF enthält einen unsicheren Bibliothekssuchpfad", 92 if correlated_network else 78,
            ["Relativer, leerer oder beschreibbarer RPATH/RUNPATH", "Zusätzlicher Netzwerkbezug" if correlated_network else "Kann Bibliotheks-Hijacking ermöglichen"],
            ["elf-unsafe-rpath"])
    if "elf-wx-segment" in rules:
        packed = same_path("elf-wx-segment", "elf-high-entropy")
        networked = same_path("elf-wx-segment", "network-client", lambda a, b: actionable(a) and actionable(b)) or same_path(
            "elf-wx-segment", "direct-ip-url", lambda a, b: actionable(a) and actionable(b) and public_direct_ip(b))
        severity = "high" if packed and networked else "medium"
        add(severity, "writable-executable-elf", "ELF besitzt gleichzeitig beschreibbaren und ausführbaren Speicher", 91 if severity == "high" else 76,
            ["W+X-LOAD-Segment", "Hohe Entropie und Netzwerkbezug" if severity == "high" else "Ungewöhnliche Speicherhärtung; kann bei JIT-Software legitim sein"],
            ["elf-wx-segment"])
    if "elf-executable-stack" in rules:
        add("low", "executable-elf-stack", "ELF fordert einen ausführbaren Prozess-Stack an", 52,
            ["GNU_STACK ist ausführbar", "Allein kein Malware-Beweis"], ["elf-executable-stack"])
    if "file-capabilities" in rules:
        capability_src = first(["file-capabilities"], actionable)
        if capability_src:
            payload = any(
                clean_path(item) == clean_path(capability_src) and actionable(item)
                for rule in strong_payload_rules | {"persistence-loader"}
                for item in by_rule.get(rule, [])
            )
            add("high" if payload else "medium", "privileged-file-capabilities",
                "Installierte ELF-Datei besitzt Linux-Datei-Capabilities", 94 if payload else 74,
                ["Kernel-vergebene Prozessprivilegien", "Zusätzlicher Payload-Kontext in derselben Datei" if payload else "Privilegien müssen zum Paket zweckmäßig passen"],
                ["file-capabilities"], lambda item: item is capability_src)

    high_surface = [item for item in getattr(result, "security_surface", []) if item.get("impact") in {"critical", "high"}]
    actionable_payloads = [
        item for rule in strong_payload_rules | {"persistence-loader"}
        for item in by_rule.get(rule, []) if actionable(item)
    ]
    if high_surface and actionable_payloads:
        active.append(new_finding(
            "high", "privileged-security-surface", result.name, high_surface[0]["path"],
            "Paket kombiniert ausführbare Payload-Signale mit einer hochprivilegierten Systemerweiterung",
            ", ".join(sorted({item["kind"] for item in high_surface}))[:500], 96,
            ["Privilegierte Security-Surface", "Korrelierter ausführbarer Payload-Kontext"],
        ))

    entropy_src = first(["elf-high-entropy"], actionable)
    if entropy_src:
        network_pair = any(
            clean_path(item) == clean_path(entropy_src) and actionable(item)
            for rule in ("direct-ip-url", "suspicious-host")
            for item in by_rule.get(rule, [])
            if rule != "direct-ip-url" or public_direct_ip(item)
        )
        if network_pair:
            add("medium", "high-entropy-network-elf", "Hochentropische ELF-Datei enthält Netzwerkindikatoren", 80,
                ["Mögliche Kompression oder Verschleierung", "Netzwerkfähige Logik in derselben Binärdatei"],
                ["elf-high-entropy"], lambda item: item is entropy_src)

    if "integrity-warning" in rules:
        integrity_src = first(["integrity-warning"])
        expected_permission_only = bool(
            integrity_src and explained_setter and
            "permissions mismatch" in (integrity_src.evidence or "").lower() and
            not re.search(r"(?:missing file|size mismatch|checksum mismatch|modification time mismatch)", integrity_src.evidence or "", re.I)
        )
        if expected_permission_only:
            add("low", "expected-permission-change", "Pacman meldet eine durch das Installationsskript nachvollziehbare Berechtigungsänderung", 54,
                ["Nur Berechtigungsabweichung", "Passende SUID/SGID-Anweisung im Paketinstallationsskript", "Kein Inhalts- oder Prüfsummenunterschied"],
                ["integrity-warning"], lambda item: item is integrity_src)
        else:
            add("medium", "integrity-change", "Pacman meldet veränderte oder fehlende Paketdateien", 72,
                ["Abweichung zur lokalen Pacman-Datenbank", "Kann durch legitime Konfiguration entstehen"], ["integrity-warning"])

    if exposure:
        active.append(new_finding("medium", "campaign-exposure", result.name, "pacman.log",
            "Paketname und Installationszeit passen zum bekannten Kampagnenfenster", " · ".join(exposure), 74, exposure))
    if "aur-new-checksum-skip" in rules:
        add("medium", "recent-checksum-downgrade", "Ein aktueller AUR-Commit hat zusätzliche SKIP-Prüfsummen eingeführt", 82,
            ["Historischer Diff statt nur aktueller Zustand", "Quellverifikation wurde im letzten Commit geschwächt"], ["aur-new-checksum-skip"])
    if "aur-source-host-change" in rules:
        add("low", "recent-source-host-change", "Ein aktueller AUR-Commit hat neue Quellhosts eingeführt", 48,
            ["Änderung der Supply-Chain-Herkunft", "Neue Hosts sind nicht automatisch bösartig"], ["aur-source-host-change"])
    if "aur-insecure-source" in rules:
        add("medium", "insecure-aur-source", "AUR-Quellmetadaten verwenden unverschlüsseltes HTTP", 68,
            ["Transport kann manipuliert werden", "Prüfsummen können das Risiko teilweise reduzieren"], ["aur-insecure-source"])
    if "aur-ephemeral-source" in rules:
        add("medium", "ephemeral-aur-source", "AUR-Quellmetadaten verwenden einen kurzlebigen oder anonymen Hostingdienst", 72,
            ["Schwer reproduzierbare Quelle", "Erhöhtes Supply-Chain-Risiko"], ["aur-ephemeral-source"])
    if "aur-orphaned" in rules:
        add("low", "orphaned-aur-package", "Installiertes AUR-Paket ist aktuell verwaist", 38,
            ["Kein aktiver Maintainer", "Allein kein Malware-Beweis"], ["aur-orphaned"])
    if "checksum-skipped" in rules:
        add("low", "checksum-skipped", "PKGBUILD überspringt mindestens eine Quellprüfsumme", 45,
            ["Schwächere Supply-Chain-Absicherung", "Allein kein Malware-Beweis"], ["checksum-skipped"])

    package_manager_src = first(["npm-bun-install-hook"], actionable)
    if package_manager_src and not dep_src:
        add("low", "runtime-package-manager", "Ausführbare Build-/Installationslogik startet einen JavaScript-Paketmanager", 40,
            ["Kann legitim sein", "Wird nur im tatsächlichen Build-, Installations- oder Programmkontext bewertet"],
            ["npm-bun-install-hook"], lambda item: item is package_manager_src)

    unique = {}
    for item in active:
        suppression = suppressions.get(item["fingerprint"])
        if suppression:
            item["suppressed"] = True
            item["suppression_reason"] = suppression.get("reason", "Als legitim markiert")
        unique[item["fingerprint"]] = item
    findings = sorted(unique.values(), key=lambda item: (item["suppressed"], -SEV[item["severity"]], -item["confidence"]))
    unsuppressed = [item for item in findings if not item["suppressed"]]
    if any(item["severity"] == "critical" for item in unsuppressed):
        verdict = "threat"
    elif any(item["severity"] == "high" for item in unsuppressed):
        verdict = "suspicious"
    elif unsuppressed:
        verdict = "review"
    else:
        verdict = "clean"

    metadata = package_metadata(result.name)
    counts = {name: 0 for name in SEV}
    for item in unsuppressed:
        counts[item["severity"]] += 1
    context_counts = {}
    for item in raw:
        context = signal_context(item)
        context_counts[context] = context_counts.get(context, 0) + 1
    actionable_count = sum(count for context, count in context_counts.items() if context in behavioral_contexts)
    filtered_count = sum(count for context, count in context_counts.items() if context in {
        "documentation", "metadata", "build-recipe", "wordlist", "ci", "test-data", "asset", "foreign-binary", "data"
    })

    return {
        "name": result.name, "version": result.version, "verdict": verdict,
        "confidence": max([item["confidence"] for item in unsuppressed] or [0]),
        "score": sum(SEV[item["severity"]] for item in unsuppressed),
        "findings": findings, "raw_signals": [asdict(item) for item in raw],
        "context_summary": {
            "raw_signals": len(raw), "actionable_signals": actionable_count,
            "filtered_non_executable": filtered_count, "by_context": dict(sorted(context_counts.items())),
        },
        "aur_status": result.aur_status, "aur_maintainer": result.aur_maintainer,
        "aur_url": (f"https://aur.archlinux.org/packages/{urllib.parse.quote(result.name, safe='')}"
                    if result.aur_status == "aur" else ""),
        "aur_out_of_date": result.aur_out_of_date, "aur_version": getattr(result, "aur_version", ""),
        "aur_votes": getattr(result, "aur_votes", 0), "aur_popularity": getattr(result, "aur_popularity", 0.0),
        "aur_first_submitted": utc_timestamp(getattr(result, "aur_first_submitted", None)),
        "aur_last_modified": utc_timestamp(getattr(result, "aur_last_modified", None)),
        "version_relation": compare_versions(result.version, getattr(result, "aur_version", "")),
        "security_surface": getattr(result, "security_surface", []),
        "surface_counts": dict(sorted({kind: sum(1 for item in getattr(result, "security_surface", []) if item.get("kind") == kind) for kind in {item.get("kind") for item in getattr(result, "security_surface", [])}}.items())),
        "source_provenance": getattr(result, "source_provenance", {}),
        "aur_history": getattr(result, "aur_history", {}),
        "files_checked": result.files_checked,
        "bytes_checked": result.bytes_checked, "integrity_output": result.integrity_output,
        "errors": result.errors, "metadata": metadata,
        "finding_count": len(unsuppressed), "suppressed_count": len(findings) - len(unsuppressed),
        "finding_counts": counts, "depends_count": len(metadata.get("depends", [])),
        "required_by_count": len(metadata.get("required_by", [])), "description": metadata.get("description", ""),
    }

def fetch_aur_snapshot_analysis(package, callback=None):
    """Inspect current AUR build metadata without extracting archive members to disk."""
    if not PACKAGE_RE.fullmatch(package):
        return [], {}
    url = f"https://aur.archlinux.org/cgit/aur.git/snapshot/{urllib.parse.quote(package, safe='')}.tar.gz"
    req = urllib.request.Request(url, headers={"User-Agent": f"aur-security-auditor/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=25) as response:
            raw = response.read(20 * 1024 * 1024 + 1)
    except Exception as exc:
        return [], {"snapshot_url": url, "available": False, "error": str(exc)[:500]}
    if len(raw) > 20 * 1024 * 1024:
        return [], {"snapshot_url": url, "available": False, "error": "snapshot exceeds 20 MiB limit"}
    findings = []
    documents = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
            for member in archive.getmembers():
                if not member.isfile() or member.size > core.MAX_TEXT_BYTES:
                    continue
                path = Path(member.name)
                if path.is_absolute() or ".." in path.parts:
                    continue
                base = path.name.lower()
                if not (
                    base in {"pkgbuild", ".srcinfo", "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb"}
                    or base.endswith((".install", ".sh", ".hook", ".service", ".timer"))
                ):
                    continue
                handle = archive.extractfile(member)
                if handle is None:
                    continue
                payload = handle.read(core.MAX_TEXT_BYTES + 1)
                if len(payload) > core.MAX_TEXT_BYTES:
                    continue
                text = payload.decode("utf-8", errors="replace")
                documents[member.name] = text
                digest = hashlib.sha256(payload).hexdigest()
                found = core.scan_text(package, f"AUR snapshot:{member.name}", text, digest)
                findings.extend(found)
                if callback:
                    callback("aux", package, f"AUR-Snapshot: {member.name}", found)
    except (tarfile.TarError, OSError) as exc:
        return findings, {"snapshot_url": url, "available": False, "error": str(exc)[:500]}
    provenance = source_document_metadata(documents, url, hashlib.sha256(raw).hexdigest())
    provenance["available"] = True
    if provenance.get("insecure_sources"):
        findings.append(core.Finding(
            "medium", "aur-insecure-source", package, "AUR snapshot:.SRCINFO",
            "AUR source metadata uses unencrypted HTTP",
            "\n".join(provenance["insecure_sources"])[:500], 0, provenance["snapshot_sha256"],
        ))
    if provenance.get("ephemeral_hosts"):
        findings.append(core.Finding(
            "medium", "aur-ephemeral-source", package, "AUR snapshot:.SRCINFO",
            "AUR source metadata uses an ephemeral or anonymous hosting service",
            ", ".join(provenance["ephemeral_hosts"])[:500], 0, provenance["snapshot_sha256"],
        ))
    return findings, provenance



PREFLIGHT_MEMBER_LIMIT = 160
PREFLIGHT_MEMBER_BYTES = 4 * 1024 * 1024
PREFLIGHT_TOTAL_BYTES = 20 * 1024 * 1024
PREFLIGHT_ARCHIVE_BYTES = 24 * 1024 * 1024
PREFLIGHT_DECOMPRESSED_ARCHIVE_BYTES = 64 * 1024 * 1024
PREFLIGHT_TEXT_NAMES = {
    "pkgbuild", ".srcinfo", "package.json", "package-lock.json", "npm-shrinkwrap.json",
    "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "meson.build", "cmakelists.txt",
}
PREFLIGHT_TEXT_SUFFIXES = {
    ".install", ".sh", ".bash", ".zsh", ".fish", ".py", ".pl", ".rb", ".js", ".mjs", ".cjs",
    ".patch", ".diff", ".service", ".timer", ".socket", ".path", ".hook", ".desktop", ".rules",
    ".conf", ".toml", ".yaml", ".yml", ".json", ".xml", ".ini", ".env",
}


def parse_aur_target(value: str) -> str:
    """Accept an AUR package base name or a canonical AUR URL."""
    raw = str(value or "").strip()
    if not raw:
        raise ValueError("AUR-Paketname oder AUR-URL fehlt")
    if "://" in raw:
        try:
            parsed = urllib.parse.urlparse(raw)
        except ValueError as exc:
            raise ValueError("Ungültige AUR-URL") from exc
        if parsed.scheme != "https" or (parsed.hostname or "").lower() != "aur.archlinux.org":
            raise ValueError("Erlaubt sind nur HTTPS-URLs von aur.archlinux.org")
        path = urllib.parse.unquote(parsed.path).strip("/")
        candidates = []
        if path.startswith("packages/"):
            candidates.append(path.split("/", 1)[1])
        elif path.endswith(".git"):
            candidates.append(Path(path).name[:-4])
        elif "/snapshot/" in path and path.endswith(".tar.gz"):
            candidates.append(Path(path).name[:-7])
        else:
            candidates.append(Path(path).name)
        raw = next((item for item in candidates if item), "")
    raw = raw.removesuffix(".git").strip()
    if not PACKAGE_RE.fullmatch(raw):
        raise ValueError("Ungültiger AUR-Paketname")
    return raw


def _looks_like_preflight_text(name: str, payload: bytes) -> bool:
    base = Path(name).name.lower()
    suffix = Path(name).suffix.lower()
    if base in PREFLIGHT_TEXT_NAMES or suffix in PREFLIGHT_TEXT_SUFFIXES:
        return b"\0" not in payload[:8192]
    if b"\0" in payload[:8192]:
        return False
    sample = payload[:8192]
    if not sample:
        return True
    printable = sum(byte in b"\t\n\r" or 32 <= byte < 127 or byte >= 128 for byte in sample)
    return printable / len(sample) >= 0.86


def download_preflight_snapshot(package: str) -> tuple[dict, dict]:
    """Download and parse an AUR snapshot without extracting or executing its contents."""
    package = parse_aur_target(package)
    quoted = urllib.parse.quote(package, safe="")
    url = f"https://aur.archlinux.org/cgit/aur.git/snapshot/{quoted}.tar.gz"
    req = urllib.request.Request(url, headers={"User-Agent": f"aur-security-auditor/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            final_url = response.geturl()
            final = urllib.parse.urlparse(final_url)
            if final.scheme != "https" or final.hostname != "aur.archlinux.org" or final.port not in {None, 443}:
                raise RuntimeError("AUR-Snapshot wurde unsicher oder auf einen fremden Host umgeleitet")
            raw = response.read(PREFLIGHT_ARCHIVE_BYTES + 1)
    except Exception as exc:
        raise RuntimeError(f"AUR-Snapshot konnte nicht geladen werden: {exc}") from exc
    if len(raw) > PREFLIGHT_ARCHIVE_BYTES:
        raise RuntimeError("AUR-Snapshot überschreitet das sichere Größenlimit")

    documents = {}
    total = 0
    members_seen = 0
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
            for member in archive.getmembers():
                if not member.isfile():
                    continue
                members_seen += 1
                if members_seen > PREFLIGHT_MEMBER_LIMIT:
                    raise RuntimeError("AUR-Snapshot enthält ungewöhnlich viele Dateien")
                path = Path(member.name)
                if path.is_absolute() or ".." in path.parts or member.size < 0:
                    raise RuntimeError("AUR-Snapshot enthält einen unsicheren Dateipfad")
                if member.size > PREFLIGHT_MEMBER_BYTES:
                    continue
                handle = archive.extractfile(member)
                if handle is None:
                    continue
                payload = handle.read(PREFLIGHT_MEMBER_BYTES + 1)
                if len(payload) > PREFLIGHT_MEMBER_BYTES:
                    continue
                if not _looks_like_preflight_text(member.name, payload):
                    continue
                total += len(payload)
                if total > PREFLIGHT_TOTAL_BYTES:
                    raise RuntimeError("Textdaten im AUR-Snapshot überschreiten das sichere Größenlimit")
                relative = "/".join(path.parts[1:]) if len(path.parts) > 1 else path.name
                documents[relative] = {
                    "text": payload.decode("utf-8", errors="replace"),
                    "size": len(payload),
                    "sha256": hashlib.sha256(payload).hexdigest(),
                }
    except (tarfile.TarError, OSError) as exc:
        raise RuntimeError(f"AUR-Snapshot ist kein gültiges Tar-Archiv: {exc}") from exc
    if not any(Path(name).name == "PKGBUILD" for name in documents):
        raise RuntimeError("AUR-Snapshot enthält kein lesbares PKGBUILD")
    return documents, {
        "snapshot_url": url,
        "snapshot_sha256": hashlib.sha256(raw).hexdigest(),
        "snapshot_bytes": len(raw),
        "documents": len(documents),
    }



LOCAL_PREFLIGHT_SUFFIXES = (".tar.gz", ".tgz", ".tar.xz", ".tar.zst", ".tar.bz2", ".tar")


def _user_supplied_path(value: str) -> Path:
    raw = str(value or "")
    if raw == "~" or raw.startswith("~/"):
        _, home, _ = invoking_user()
        return home if raw == "~" else home / raw[2:]
    return Path(raw).expanduser()


def _preflight_document_from_payload(name: str, payload: bytes) -> Optional[dict]:
    if len(payload) > PREFLIGHT_MEMBER_BYTES or not _looks_like_preflight_text(name, payload):
        return None
    return {
        "text": payload.decode("utf-8", errors="replace"),
        "size": len(payload),
        "sha256": hashlib.sha256(payload).hexdigest(),
    }


def _infer_local_package(documents: dict, fallback: str) -> str:
    srcinfo = next((item["text"] for name, item in documents.items() if Path(name).name == ".SRCINFO"), "")
    for key in ("pkgbase", "pkgname"):
        match = re.search(rf"^\s*{key}\s*=\s*([^\s#]+)", srcinfo, re.M)
        if match and PACKAGE_RE.fullmatch(match.group(1).strip()):
            return match.group(1).strip()
    pkgbuild = next((item["text"] for name, item in documents.items() if Path(name).name == "PKGBUILD"), "")
    masked = _mask_shell_comments(pkgbuild) if "_mask_shell_comments" in globals() else pkgbuild
    for key in ("pkgbase", "pkgname"):
        match = re.search(rf"^\s*{key}\s*=\s*['\"]?([A-Za-z0-9@._+:-]+)", masked, re.M)
        if match and PACKAGE_RE.fullmatch(match.group(1)):
            return match.group(1)
    cleaned = re.sub(r"[^A-Za-z0-9@._+:-]+", "-", fallback).strip("-.")[:200]
    return cleaned if PACKAGE_RE.fullmatch(cleaned) else "local-package"


def _document_set_digest(documents: dict) -> str:
    digest = hashlib.sha256()
    for name, item in sorted(documents.items()):
        digest.update(name.encode(errors="replace"))
        digest.update(b"\0")
        digest.update(str(item.get("sha256", "")).encode())
        digest.update(b"\n")
    return digest.hexdigest()


def _read_local_directory(root: Path) -> dict:
    documents = {}
    total = 0
    members = 0
    root = root.resolve()
    for current, dirs, files in os.walk(root, followlinks=False):
        current_path = Path(current)
        dirs[:] = sorted(name for name in dirs if not (current_path / name).is_symlink() and name not in {".git", "pkg", "src"})
        for filename in sorted(files):
            path = current_path / filename
            if path.is_symlink() or not path.is_file():
                continue
            members += 1
            if members > PREFLIGHT_MEMBER_LIMIT:
                raise RuntimeError("Lokale Paketquelle enthält ungewöhnlich viele Dateien")
            try:
                size = path.stat().st_size
            except OSError:
                continue
            if size < 0 or size > PREFLIGHT_MEMBER_BYTES:
                continue
            try:
                payload = path.read_bytes()
            except OSError:
                continue
            relative = path.relative_to(root).as_posix()
            item = _preflight_document_from_payload(relative, payload)
            if item is None:
                continue
            total += len(payload)
            if total > PREFLIGHT_TOTAL_BYTES:
                raise RuntimeError("Textdaten der lokalen Paketquelle überschreiten das sichere Größenlimit")
            documents[relative] = item
    return documents


def _read_local_archive(path: Path) -> dict:
    if path.stat().st_size > PREFLIGHT_ARCHIVE_BYTES:
        raise RuntimeError("Lokales Paketarchiv überschreitet das sichere Größenlimit")
    documents = {}
    total = 0
    members_seen = 0
    archive = None
    try:
        if path.name.lower().endswith(".tar.zst"):
            zstd = shutil.which("zstd")
            if not zstd:
                raise RuntimeError("Für lokale .tar.zst-Archive wird das Programm zstd benötigt")
            process = subprocess.Popen(
                [zstd, "-dc", "--no-progress", "--", str(path)],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            )
            assert process.stdout is not None
            raw = bytearray()
            while True:
                chunk = process.stdout.read(1024 * 1024)
                if not chunk:
                    break
                raw.extend(chunk)
                if len(raw) > PREFLIGHT_DECOMPRESSED_ARCHIVE_BYTES:
                    process.kill()
                    process.wait(timeout=5)
                    raise RuntimeError("Dekomprimiertes lokales Paketarchiv überschreitet das sichere Größenlimit")
            returncode = process.wait(timeout=30)
            if returncode != 0:
                raise RuntimeError("Lokales .tar.zst-Archiv konnte nicht sicher dekomprimiert werden")
            archive = tarfile.open(fileobj=io.BytesIO(raw), mode="r:")
        else:
            archive = tarfile.open(path, mode="r:*")
        for member in archive.getmembers():
            if not member.isfile():
                continue
            members_seen += 1
            if members_seen > PREFLIGHT_MEMBER_LIMIT:
                raise RuntimeError("Lokales Paketarchiv enthält ungewöhnlich viele Dateien")
            member_path = Path(member.name)
            if member_path.is_absolute() or ".." in member_path.parts or member.size < 0:
                raise RuntimeError("Lokales Paketarchiv enthält einen unsicheren Dateipfad")
            if member.size > PREFLIGHT_MEMBER_BYTES:
                continue
            handle = archive.extractfile(member)
            if handle is None:
                continue
            payload = handle.read(PREFLIGHT_MEMBER_BYTES + 1)
            if len(payload) > PREFLIGHT_MEMBER_BYTES:
                continue
            relative = "/".join(member_path.parts[1:]) if len(member_path.parts) > 1 else member_path.name
            item = _preflight_document_from_payload(relative, payload)
            if item is None:
                continue
            total += len(payload)
            if total > PREFLIGHT_TOTAL_BYTES:
                raise RuntimeError("Textdaten im lokalen Paketarchiv überschreiten das sichere Größenlimit")
            documents[relative] = item
    except (tarfile.TarError, OSError, subprocess.SubprocessError) as exc:
        raise RuntimeError(f"Lokales Paketarchiv ist ungültig: {exc}") from exc
    finally:
        if archive is not None:
            archive.close()
    return documents


def load_preflight_target(target: str) -> tuple[str, dict, dict]:
    """Load an AUR target or local package source without executing package code."""
    raw = str(target or "").strip()
    if not raw:
        raise ValueError("AUR-Paketname, AUR-URL oder lokaler Pfad fehlt")
    candidate = _user_supplied_path(raw)
    if candidate.exists():
        resolved = candidate.resolve()
        if resolved.is_dir():
            root = resolved
            documents = _read_local_directory(root)
            input_type = "local-directory"
        elif resolved.is_file() and resolved.name == "PKGBUILD":
            root = resolved.parent
            documents = _read_local_directory(root)
            input_type = "local-directory"
        elif resolved.is_file() and any(resolved.name.lower().endswith(suffix) for suffix in LOCAL_PREFLIGHT_SUFFIXES):
            root = resolved
            documents = _read_local_archive(resolved)
            input_type = "local-archive"
        elif resolved.is_file():
            payload = resolved.read_bytes()
            item = _preflight_document_from_payload(resolved.name, payload)
            if item is None:
                raise RuntimeError("Lokale Datei ist nicht als statisch analysierbarer Pakettext geeignet")
            root = resolved
            documents = {resolved.name: item}
            input_type = "local-file"
        else:
            raise RuntimeError("Lokaler Pfad ist nicht lesbar")
        if not any(Path(name).name == "PKGBUILD" for name in documents):
            raise RuntimeError("Lokale Paketquelle enthält kein lesbares PKGBUILD")
        package = _infer_local_package(documents, root.stem if root.is_file() else root.name)
        snapshot = {
            "snapshot_url": "",
            "snapshot_sha256": _document_set_digest(documents),
            "snapshot_bytes": sum(item["size"] for item in documents.values()),
            "documents": len(documents),
            "input_type": input_type,
            "local_path": str(resolved),
        }
        return package, documents, snapshot
    package = parse_aur_target(raw)
    documents, snapshot = download_preflight_snapshot(package)
    snapshot["input_type"] = "aur"
    return package, documents, snapshot


def _srcinfo_value(documents: dict, key: str) -> str:
    srcinfo = next((item["text"] for name, item in documents.items() if Path(name).name == ".SRCINFO"), "")
    match = re.search(rf"^\s*{re.escape(key)}\s*=\s*(.+?)\s*$", srcinfo, re.M)
    return match.group(1).strip() if match else ""


def _guard_finding_key(item: dict) -> str:
    evidence = re.sub(r"\s+", " ", str(item.get("evidence", ""))).strip()[:360]
    payload = "\0".join([
        str(item.get("rule", "")), str(item.get("document", item.get("path", ""))), evidence,
    ])
    return hashlib.sha256(payload.encode(errors="replace")).hexdigest()


def build_guard_signature(package: str, documents: dict, provenance: dict, metadata: dict, findings: list[dict]) -> dict:
    pkgbuild = next((item["text"] for name, item in documents.items() if Path(name).name == "PKGBUILD"), "")
    masked = _mask_shell_comments(pkgbuild)
    functions = sorted(set(re.findall(r"^\s*([A-Za-z_][A-Za-z0-9_]*)\s*\(\s*\)\s*\{", masked, re.M)))
    install_scripts = sorted(name for name in documents if Path(name).name.lower().endswith((".install", ".hook")))
    surface_files = sorted(name for name in documents if Path(name).suffix.lower() in {
        ".service", ".timer", ".socket", ".path", ".hook", ".rules", ".desktop",
    })
    sensitive_patterns = {
        "sudoers": r"/(?:etc/)?sudoers(?:\.d)?/|/etc/sudoers",
        "polkit": r"/(?:usr/share|etc)/polkit-1/",
        "pam": r"/etc/pam\.d/",
        "kernel-module": r"/(?:usr/)?lib/modules/",
        "pacman-hook": r"/(?:usr/share|etc)/libalpm/hooks/",
        "systemd": r"/(?:usr/)?lib/systemd/|/etc/systemd/",
        "autostart": r"/(?:etc/xdg|\.config)/autostart/",
    }
    combined = "\n".join(item.get("analysis_text", item["text"]) for item in documents.values())
    sensitive_surfaces = sorted(name for name, pattern in sensitive_patterns.items() if re.search(pattern, combined, re.I))
    normalized_findings = []
    for item in findings:
        normalized_findings.append({
            "key": _guard_finding_key(item),
            "severity": item.get("severity", "info"),
            "rule": item.get("rule", ""),
            "document": item.get("document", item.get("path", "")),
            "message": item.get("message", ""),
        })
    version = str(metadata.get("Version") or metadata.get("version") or _srcinfo_value(documents, "pkgver") or "")
    pkgrel = _srcinfo_value(documents, "pkgrel")
    if version and pkgrel and not version.endswith("-" + pkgrel):
        version = f"{version}-{pkgrel}"
    return {
        "schema_version": 1,
        "package": package,
        "version": version,
        "snapshot_sha256": _document_set_digest(documents),
        "documents": {name: item["sha256"] for name, item in sorted(documents.items())},
        "sources": sorted(_preflight_source_entries(documents)),
        "source_hosts": sorted(provenance.get("source_hosts", [])),
        "checksum_algorithms": sorted(provenance.get("checksum_algorithms", [])),
        "skip_count": int(provenance.get("skip_count", 0) or 0),
        "functions": functions,
        "install_scripts": install_scripts,
        "surface_files": surface_files,
        "sensitive_surfaces": sensitive_surfaces,
        "maintainer": metadata.get("Maintainer") or metadata.get("maintainer"),
        "findings": sorted(normalized_findings, key=lambda item: item["key"]),
    }


def _guard_change(kind: str, severity: str, before: Any = None, after: Any = None, detail: str = "") -> dict:
    return {"kind": kind, "severity": severity, "before": before, "after": after, "detail": detail}


def compare_guard_signatures(approval: Optional[dict], current: dict) -> dict:
    if not approval or not isinstance(approval.get("signature"), dict):
        return {
            "baseline_available": False, "exact_match": False, "risk": "unknown",
            "reviewed_at": None, "reviewed_version": "", "current_version": current.get("version", ""),
            "summary": {"changes": 0, "security_relevant": 0, "new_findings": 0, "resolved_findings": 0, "changed_documents": 0, "changed_percent": 0},
            "changes": [], "new_findings": [], "resolved_findings": [],
        }
    old = approval["signature"]
    changes = []
    if old.get("version") != current.get("version"):
        changes.append(_guard_change("version-changed", "low", old.get("version", ""), current.get("version", "")))
    old_sources, new_sources = set(old.get("sources", [])), set(current.get("sources", []))
    for value in sorted(new_sources - old_sources):
        changes.append(_guard_change("source-added", "medium", None, value))
    for value in sorted(old_sources - new_sources):
        changes.append(_guard_change("source-removed", "low", value, None))
    old_hosts, new_hosts = set(old.get("source_hosts", [])), set(current.get("source_hosts", []))
    for value in sorted(new_hosts - old_hosts):
        changes.append(_guard_change("source-host-added", "medium", None, value))
    for value in sorted(old_hosts - new_hosts):
        changes.append(_guard_change("source-host-removed", "info", value, None))
    old_checks, new_checks = set(old.get("checksum_algorithms", [])), set(current.get("checksum_algorithms", []))
    strong = {"sha256", "sha384", "sha512", "b2"}
    for value in sorted(new_checks - old_checks):
        changes.append(_guard_change("checksum-added", "info", None, value))
    for value in sorted(old_checks - new_checks):
        changes.append(_guard_change("checksum-removed", "high" if value in strong else "medium", value, None))
    old_skip, new_skip = int(old.get("skip_count", 0) or 0), int(current.get("skip_count", 0) or 0)
    if new_skip > old_skip:
        changes.append(_guard_change("skip-increased", "high", old_skip, new_skip))
    elif new_skip < old_skip:
        changes.append(_guard_change("skip-decreased", "info", old_skip, new_skip))
    for field, added_kind, removed_kind, severity in [
        ("functions", "function-added", "function-removed", "low"),
        ("install_scripts", "install-script-added", "install-script-removed", "high"),
        ("surface_files", "surface-file-added", "surface-file-removed", "medium"),
        ("sensitive_surfaces", "sensitive-surface-added", "sensitive-surface-removed", "high"),
    ]:
        old_set, new_set = set(old.get(field, [])), set(current.get(field, []))
        for value in sorted(new_set - old_set):
            changes.append(_guard_change(added_kind, severity, None, value))
        for value in sorted(old_set - new_set):
            changes.append(_guard_change(removed_kind, "info", value, None))
    if old.get("maintainer") != current.get("maintainer") and (old.get("maintainer") or current.get("maintainer")):
        changes.append(_guard_change("maintainer-changed", "medium", old.get("maintainer"), current.get("maintainer")))
    old_findings = {item["key"]: item for item in old.get("findings", []) if item.get("key")}
    new_findings = {item["key"]: item for item in current.get("findings", []) if item.get("key")}
    added_findings = [new_findings[key] for key in sorted(set(new_findings) - set(old_findings))]
    resolved_findings = [old_findings[key] for key in sorted(set(old_findings) - set(new_findings))]
    for item in added_findings:
        changes.append(_guard_change("finding-added", item.get("severity", "medium"), None, item.get("rule", ""), item.get("document", "")))
    for item in resolved_findings:
        changes.append(_guard_change("finding-resolved", "info", item.get("rule", ""), None, item.get("document", "")))
    old_docs, new_docs = old.get("documents", {}), current.get("documents", {})
    changed_documents = sorted(name for name in set(old_docs) | set(new_docs) if old_docs.get(name) != new_docs.get(name))
    total_docs = max(1, len(set(old_docs) | set(new_docs)))
    exact_match = old.get("snapshot_sha256") == current.get("snapshot_sha256") and not changes
    max_points = max((SEV.get(item["severity"], 0) for item in changes), default=0)
    risk = "critical" if max_points >= SEV["critical"] else "high" if max_points >= SEV["high"] else "moderate" if max_points >= SEV["medium"] else "low" if changes else "minimal"
    return {
        "baseline_available": True,
        "exact_match": exact_match,
        "risk": risk,
        "reviewed_at": approval.get("reviewed_at"),
        "reviewed_version": old.get("version", approval.get("version", "")),
        "current_version": current.get("version", ""),
        "reviewed_snapshot_sha256": old.get("snapshot_sha256", ""),
        "current_snapshot_sha256": current.get("snapshot_sha256", ""),
        "summary": {
            "changes": len(changes),
            "security_relevant": sum(item["severity"] in {"critical", "high", "medium"} for item in changes),
            "new_findings": len(added_findings),
            "resolved_findings": len(resolved_findings),
            "unchanged_findings": len(set(old_findings) & set(new_findings)),
            "changed_documents": len(changed_documents),
            "total_documents": total_docs,
            "changed_percent": round(len(changed_documents) / total_docs * 100),
        },
        "changes": changes[:500],
        "new_findings": added_findings[:250],
        "resolved_findings": resolved_findings[:250],
        "changed_documents": changed_documents[:250],
    }


def load_approvals(p: Optional[dict] = None) -> dict:
    p = p or paths()
    data = load_json(p["approvals"])
    if not data or not isinstance(data.get("packages"), dict):
        return {"schema_version": 1, "packages": {}}
    return data


def attach_update_guard(report: dict, p: Optional[dict] = None) -> dict:
    approvals = load_approvals(p)
    approval = approvals["packages"].get(report.get("package", ""))
    report["update_guard"] = compare_guard_signatures(approval, report.get("guard_signature", {}))
    return report


def approve_report(report: dict, p: Optional[dict] = None) -> dict:
    p = p or paths()
    package = str(report.get("package", ""))
    signature = report.get("guard_signature")
    if not PACKAGE_RE.fullmatch(package) or not isinstance(signature, dict):
        raise ValueError("Vorabprüfungs-Report ist nicht als geprüfte Version geeignet")
    approvals = load_approvals(p)
    record = {
        "package": package,
        "version": signature.get("version", ""),
        "snapshot_sha256": signature.get("snapshot_sha256", ""),
        "reviewed_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "risk_at_review": report.get("risk", "unknown"),
        "input_type": report.get("input_type", "aur"),
        "signature": signature,
    }
    approvals["packages"][package] = record
    atomic_json(p["approvals"], approvals)
    return record


def remove_approval(package: str, p: Optional[dict] = None) -> bool:
    if not PACKAGE_RE.fullmatch(package or ""):
        raise ValueError("Ungültiger Paketname")
    p = p or paths()
    approvals = load_approvals(p)
    existed = package in approvals["packages"]
    approvals["packages"].pop(package, None)
    atomic_json(p["approvals"], approvals)
    return existed

def _preflight_line(text: str, match: re.Match) -> tuple[int, str]:
    line = text.count("\n", 0, match.start()) + 1
    start = max(0, match.start() - 180)
    end = min(len(text), match.end() + 220)
    evidence = text[start:end].replace("\r", "")
    evidence = re.sub(r"[ \t]+", " ", evidence).strip()
    return line, evidence[:800]


def _preflight_finding(package, severity, rule, document, message, evidence="", line=0,
                       confidence=60, reasons=None):
    item = {
        "package": package, "severity": severity, "rule": rule, "document": document,
        "path": f"AUR snapshot:{document}", "message": message, "evidence": evidence,
        "line": int(line or 0), "confidence": int(max(0, min(100, confidence))),
        "reasons": list(reasons or []),
    }
    item["fingerprint"] = hashlib.sha256("\0".join([
        package, rule, document, str(item["line"]), evidence[:500]
    ]).encode(errors="replace")).hexdigest()
    return item


def _preflight_source_entries(documents: dict) -> list[str]:
    """Collect literal source entries from both .SRCINFO and PKGBUILD.

    .SRCINFO is useful because variables are expanded, but it can be stale. The
    PKGBUILD is therefore inspected independently instead of trusting either
    representation as the sole source of truth.
    """
    entries = []
    srcinfo = next((item["text"] for name, item in documents.items() if Path(name).name == ".SRCINFO"), "")
    for line in srcinfo.splitlines():
        match = re.match(r"\s*source(?:_[a-z0-9_]+)?\s*=\s*(.+?)\s*$", line, re.I)
        if match:
            entries.append(match.group(1).strip())
    pkgbuild = next((item["text"] for name, item in documents.items() if Path(name).name == "PKGBUILD"), "")
    for match in re.finditer(r"\bsource(?:_[a-z0-9_]+)?\s*=\s*\((.*?)\)", pkgbuild, re.I | re.S):
        entries.extend(re.findall(r"['\"]([^'\"]+)['\"]", match.group(1)))
    return list(dict.fromkeys(entry for entry in entries if entry))



def _mask_shell_comments(text: str) -> str:
    """Mask shell comments while preserving byte positions and line numbers."""
    output = []
    single = False
    double = False
    escaped = False
    at_word_start = True
    index = 0
    while index < len(text):
        char = text[index]
        if char == "\n":
            output.append(char)
            single = double = escaped = False
            at_word_start = True
            index += 1
            continue
        if escaped:
            output.append(char)
            escaped = False
            at_word_start = char.isspace()
            index += 1
            continue
        if char == "\\" and not single:
            output.append(char)
            escaped = True
            at_word_start = False
            index += 1
            continue
        if char == "'" and not double:
            single = not single
            output.append(char)
            at_word_start = False
            index += 1
            continue
        if char == '"' and not single:
            double = not double
            output.append(char)
            at_word_start = False
            index += 1
            continue
        if char == "#" and not single and not double and at_word_start:
            while index < len(text) and text[index] != "\n":
                output.append(" ")
                index += 1
            continue
        output.append(char)
        at_word_start = char.isspace() or char in ";|&(){}"
        index += 1
    return "".join(output)


def _preflight_analysis_text(name: str, text: str) -> str:
    base = Path(name).name.lower()
    if base == "pkgbuild" or base.endswith((".install", ".sh", ".bash", ".zsh", ".fish")):
        return _mask_shell_comments(text)
    return text

def _preflight_normalize_raw(package: str, raw_findings: list) -> list[dict]:
    output = []
    mapping = {
        "known-malware-hash": ("critical", 100, "Bekannter Malware-Hash in AUR-Datei"),
        "atomic-arch-c2": ("critical", 100, "Bekannter Atomic-Arch-C2-Indikator"),
        "atomic-arch-dependency": ("critical", 99, "Bekannte bösartige Atomic-Arch-Abhängigkeit"),
        "shell-download-exec": ("critical", 98, "Heruntergeladene Daten werden unmittelbar als Shellcode ausgeführt"),
        "encoded-payload-exec": ("critical", 97, "Kodierte Daten werden dekodiert und unmittelbar ausgeführt"),
        "security-disable": ("high", 92, "Build- oder Installationscode deaktiviert Sicherheitskontrollen"),
        "suid-capability": ("high", 90, "Build- oder Installationscode setzt privilegierte Dateirechte oder Capabilities"),
        "credential-targeting": ("high", 86, "Code referenziert konkrete lokale Credential- oder Session-Speicher"),
        "persistence-loader": ("high", 89, "Code verändert einen Loader- oder Shell-Persistenzmechanismus"),
        "suspicious-temp-exec": ("high", 88, "Code führt Inhalte aus einem temporären Verzeichnis aus"),
        "suspicious-host": ("high", 90, "Verdächtiger externer Host in Build- oder Installationsdatei"),
        "direct-ip-url": ("medium", 72, "Direkte IP-Adresse statt nachvollziehbarem Quellhost"),
        "shell-eval": ("medium", 74, "Dynamische Shell-Auswertung erschwert die Nachvollziehbarkeit"),
        "checksum-skipped": ("low", 52, "Mindestens eine deklarierte Quellprüfung wird übersprungen"),
        "npm-bun-install-hook": ("low", 42, "Build- oder Installationslogik startet einen JavaScript-Paketmanager"),
        "install-script": ("low", 40, "Paket enthält automatisch ausgeführte Installations-Lifecycle-Hooks"),
    }
    allowed_context = {"PKGBUILD", ".SRCINFO"}
    for finding in raw_findings:
        document = finding.path.removeprefix("AUR preflight:")
        base = Path(document).name
        if finding.rule == "network-client":
            # curl/wget in PKGBUILD or install files is relevant; plain source URLs are not matched by this rule.
            severity, confidence, message = "medium", 70, "Build- oder Installationscode startet einen Netzwerk-Client"
        elif finding.rule in mapping:
            severity, confidence, message = mapping[finding.rule]
        else:
            continue
        if finding.rule in {"credential-targeting", "persistence-loader"} and base not in allowed_context and not base.endswith((".install", ".sh", ".py", ".js")):
            continue
        output.append(_preflight_finding(
            package, severity, finding.rule, document, message,
            finding.evidence, finding.line, confidence,
            ["Statische Textanalyse", "Konkrete Fundstelle wird angezeigt"],
        ))
    return output


def preflight_package_hint(target: str) -> str:
    raw = str(target or "").strip()
    candidate = _user_supplied_path(raw)
    if raw and candidate.exists():
        base = candidate.parent.name if candidate.is_file() and candidate.name == "PKGBUILD" else candidate.stem if candidate.is_file() else candidate.name
        cleaned = re.sub(r"[^A-Za-z0-9@._+:-]+", "-", base).strip("-.")[:200]
        return cleaned if PACKAGE_RE.fullmatch(cleaned) else "local-package"
    return parse_aur_target(raw)


def preflight_analysis(target: str, include_history: bool = False) -> dict:
    started = dt.datetime.now(dt.timezone.utc).isoformat()
    package, documents, snapshot = load_preflight_target(target)
    input_type = snapshot.get("input_type", "aur")
    remote_aur = input_type == "aur"
    raw = []
    analysis_documents = {name: {**doc, "analysis_text": _preflight_analysis_text(name, doc["text"])} for name, doc in documents.items()}
    for name, doc in analysis_documents.items():
        raw.extend(core.scan_text(package, f"AUR preflight:{name}", doc["analysis_text"], doc["sha256"]))
    findings = _preflight_normalize_raw(package, raw)
    text_documents = {name: item["analysis_text"] for name, item in analysis_documents.items()}
    provenance = source_document_metadata(text_documents, snapshot["snapshot_url"], snapshot["snapshot_sha256"])
    provenance["available"] = True

    pkgbuild_name, pkgbuild = next(
        ((name, item["analysis_text"]) for name, item in analysis_documents.items() if Path(name).name == "PKGBUILD"),
        ("PKGBUILD", ""),
    )
    install_names = [name for name in documents if name.lower().endswith(".install")]
    sources = _preflight_source_entries({name: {**item, "text": item["analysis_text"]} for name, item in analysis_documents.items()})
    source_urls = list(provenance.get("source_urls", []))

    def scan_custom(pattern, severity, rule, message, confidence, reasons, names=None, flags=re.I | re.M):
        selected = names or list(documents)
        for name in selected:
            text = documents[name]["text"]
            analysis_text = analysis_documents[name]["analysis_text"]
            for match in re.finditer(pattern, analysis_text, flags):
                line, evidence = _preflight_line(text, match)
                findings.append(_preflight_finding(package, severity, rule, name, message, evidence, line, confidence, reasons))

    scan_custom(
        r"(?:^|[;&|]\s*)(?:sudo|doas)\b|\bsu\s+-c\b",
        "high", "preflight-privilege-escalation",
        "PKGBUILD oder Hilfsskript versucht während des Builds Privilegien zu erhöhen", 94,
        ["AUR-Builds sollen als normaler Benutzer laufen", "Privilegierte Befehle vor der Installation sind hochriskant"],
    )
    scan_custom(
        r"\b(?:curl|wget)\b[^\n]{0,500}(?:\|\s*(?:ba|z|fi|da)?sh\b|(?:ba|z|fi|da)?sh\s+-c|chmod\s+\+x|/tmp/|/dev/shm/)",
        "critical", "preflight-runtime-download-exec",
        "Build- oder Installationscode lädt zur Laufzeit Inhalt nach und führt ihn aus", 98,
        ["Download erfolgt außerhalb der deklarativen Quellprüfung", "Direkte Ausführung der nachgeladenen Daten"],
    )
    scan_custom(
        r"\b(?:curl|wget)\b",
        "medium", "preflight-runtime-download",
        "Build- oder Installationscode lädt Daten außerhalb des source-Arrays nach", 78,
        ["Download ist nicht automatisch durch makepkg-Prüfsummen abgesichert", "Manuelle Prüfung der Ziel-URL empfohlen"],
        names=[name for name in documents if Path(name).name != ".SRCINFO"],
    )
    scan_custom(
        r"\b(?:systemctl\s+(?:--user\s+)?(?:enable|start|restart)|useradd|groupadd|passwd|visudo)\b",
        "high", "preflight-system-modification",
        "Build- oder Installationscode verändert unmittelbar Systemzustand oder Benutzerverwaltung", 90,
        ["Seiteneffekt außerhalb des Paket-Dateiinhalts", "Sollte bei AUR-Paketen besonders begründet sein"],
    )
    scan_custom(
        r"(?:/etc/sudoers(?:\.d/)?|/etc/ld\.so\.preload|/etc/pam\.d/|/usr/lib/security/)",
        "high", "preflight-sensitive-target",
        "Paketdatei adressiert eine hochprivilegierte Sicherheitsfläche", 86,
        ["Privilegierter Zielpfad", "Nicht automatisch Malware, aber zwingend prüfbedürftig"],
    )
    scan_custom(
        r"(?:rm\s+-rf\s+/(?:\s|$)|mkfs(?:\.|\s)|dd\s+[^\n]{0,120}\bof=/dev/)",
        "critical", "preflight-destructive-command",
        "Paketdatei enthält einen potenziell destruktiven Systembefehl", 99,
        ["Kann System- oder Datenträgerdaten zerstören", "Manuelle Blockierung vor Installation empfohlen"],
    )
    scan_custom(
        r"\b(?:eval|source|\.)\s+(?:<\(|/dev/stdin|\$\(|`)",
        "high", "preflight-dynamic-source",
        "Dynamisch erzeugter Inhalt wird in die laufende Shell eingelesen", 91,
        ["Ausgeführter Inhalt ist statisch schwer nachvollziehbar", "Typisches Supply-Chain-Risikomuster"],
    )

    checksum_algorithms = set(provenance.get("checksum_algorithms", []))
    skip_count = int(provenance.get("skip_count", 0) or 0)
    strong = checksum_algorithms & {"sha256", "sha384", "sha512", "b2"}
    weak = checksum_algorithms & {"md5", "sha1"}
    vcs_sources = [value for value in sources if re.search(r"(?:^|\+)(?:git|hg|svn|bzr)\+|\.git(?:#|$)", value, re.I)]
    mutable_vcs = [value for value in vcs_sources if not re.search(r"#(?:commit|tag)=[^&#]+", value, re.I)]
    signed_source = any(re.search(r"\.(?:sig|asc)(?:$|[?#])", value, re.I) for value in sources)
    validpgp = bool(re.search(r"\bvalidpgpkeys\s*=", pkgbuild, re.I))

    if sources and not checksum_algorithms:
        findings.append(_preflight_finding(
            package, "medium", "preflight-no-checksums", pkgbuild_name,
            "Für deklarierte Quellen wurde keine unterstützte Prüfsummenliste erkannt",
            f"sources={len(sources)}", 0, 76,
            ["Quellintegrität ist nicht nachvollziehbar", "VCS-Pakete können begründete Ausnahmen besitzen"],
        ))
    if weak and not strong:
        findings.append(_preflight_finding(
            package, "low", "preflight-weak-checksums", pkgbuild_name,
            "Quellen werden ausschließlich mit veralteten Prüfsummenverfahren geprüft",
            ", ".join(sorted(weak)), 0, 62,
            ["MD5 und SHA-1 gelten nicht als moderne Kollisionsabsicherung"],
        ))
    if skip_count:
        findings.append(_preflight_finding(
            package, "low" if vcs_sources else "medium", "preflight-skip-checksums", pkgbuild_name,
            "Mindestens eine Quelle verwendet SKIP statt einer Inhaltsprüfung",
            f"SKIP={skip_count}", 0, 58 if vcs_sources else 72,
            ["Bei VCS-Quellen verbreitet, bei direkten Downloads deutlich schwächer"],
        ))
    for source in mutable_vcs[:8]:
        findings.append(_preflight_finding(
            package, "low", "preflight-mutable-vcs", pkgbuild_name,
            "VCS-Quelle ist nicht auf einen unveränderlichen Commit festgelegt",
            source[:800], 0, 50,
            ["Branch- oder ungebundene Git-Quellen können sich ohne PKGBUILD-Änderung verändern"],
        ))
    if provenance.get("insecure_sources"):
        findings.append(_preflight_finding(
            package, "medium", "preflight-http-source", ".SRCINFO",
            "Mindestens eine Quell-URL verwendet unverschlüsseltes HTTP",
            "\n".join(provenance["insecure_sources"])[:800], 0, 74,
            ["Transport kann manipuliert werden", "Starke Prüfsummen reduzieren, beseitigen das Risiko aber nicht vollständig"],
        ))
    if provenance.get("ephemeral_hosts"):
        findings.append(_preflight_finding(
            package, "high", "preflight-ephemeral-host", ".SRCINFO",
            "Eine Quelle liegt auf einem kurzlebigen oder anonymen Hostingdienst",
            ", ".join(provenance["ephemeral_hosts"])[:800], 0, 88,
            ["Schwer reproduzierbare Herkunft", "Erhöhtes Supply-Chain-Risiko"],
        ))
    if provenance.get("direct_ip_sources"):
        findings.append(_preflight_finding(
            package, "medium", "preflight-direct-ip-source", ".SRCINFO",
            "Eine Quell-URL verwendet eine direkte IP-Adresse",
            "\n".join(provenance["direct_ip_sources"])[:800], 0, 76,
            ["Keine nachvollziehbare Domainidentität", "Zertifikats- und Herkunftsprüfung erschwert"],
        ))

    metadata = {}
    rpc_error = ""
    if remote_aur:
        try:
            metadata = core.aur_rpc([package]).get(package, {})
            if not metadata:
                rpc_error = "Paket wurde über AUR RPC nicht gefunden"
        except Exception as exc:
            rpc_error = str(exc)[:500]
    else:
        metadata = {
            "Version": _srcinfo_value(documents, "pkgver"),
            "Description": _srcinfo_value(documents, "pkgdesc"),
            "Maintainer": None,
        }
        rpc_error = "Für lokale Paketquellen nicht anwendbar"

    history = {}
    if include_history and remote_aur:
        history_raw, history = fetch_aur_history_analysis(package, commits=6)
        findings.extend(_preflight_normalize_raw(package, history_raw))
        if history.get("new_skip_count"):
            findings.append(_preflight_finding(
                package, "medium", "preflight-recent-checksum-downgrade", "AUR Git history",
                "Der jüngste AUR-Commit hat zusätzliche SKIP-Prüfsummen eingeführt",
                f"new SKIP={history['new_skip_count']}", 0, 84,
                ["Historischer Diff", "Quellverifikation wurde zuletzt geschwächt"],
            ))
        if history.get("added_source_hosts"):
            findings.append(_preflight_finding(
                package, "low", "preflight-recent-host-change", "AUR Git history",
                "Der jüngste AUR-Commit hat neue Quellhosts eingeführt",
                ", ".join(history["added_source_hosts"])[:800], 0, 57,
                ["Änderung der Supply-Chain-Herkunft", "Neue Hosts sind nicht automatisch bösartig"],
            ))

    # Deduplicate exact and overlapping generic rules. Keep the stronger, more specific finding.
    generic_rules = {"network-client", "preflight-runtime-download"}
    specific_download = any(item["rule"] in {"shell-download-exec", "preflight-runtime-download-exec", "encoded-payload-exec"} for item in findings)
    unique = {}
    for item in findings:
        if specific_download and item["rule"] in generic_rules and any(
            other["document"] == item["document"] and abs(other.get("line", 0) - item.get("line", 0)) <= 2
            and other["rule"] in {"shell-download-exec", "preflight-runtime-download-exec", "encoded-payload-exec"}
            for other in findings
        ):
            continue
        key = (item["rule"], item["document"], item["line"], item["evidence"][:120])
        if key not in unique or item["confidence"] > unique[key]["confidence"]:
            unique[key] = item
    findings = sorted(unique.values(), key=lambda item: (-SEV.get(item["severity"], 0), -item["confidence"], item["document"], item["line"]))

    highest = max((SEV.get(item["severity"], 0) for item in findings), default=0)
    if highest >= SEV["critical"]:
        risk = "critical"
    elif highest >= SEV["high"]:
        risk = "high"
    elif highest >= SEV["medium"]:
        risk = "moderate"
    elif findings:
        risk = "low"
    else:
        risk = "minimal"
    max_confidence = max((item["confidence"] for item in findings), default=72 if documents else 0)
    confidence = "high" if max_confidence >= 88 else "medium" if max_confidence >= 65 else "low"

    coverage = [
        {"id": "snapshot", "label": "AUR snapshot" if remote_aur else "Local package source", "status": "complete", "detail": f"{len(documents)} text files"},
        {"id": "pkgbuild", "label": "PKGBUILD", "status": "complete", "detail": pkgbuild_name},
        {"id": "srcinfo", "label": ".SRCINFO", "status": "complete" if any(Path(n).name == ".SRCINFO" for n in documents) else "unavailable", "detail": ""},
        {"id": "install", "label": "Install scripts", "status": "complete", "detail": str(len(install_names))},
        {"id": "provenance", "label": "Source provenance", "status": "complete", "detail": str(len(source_urls))},
        {"id": "aur-rpc", "label": "AUR metadata", "status": "complete" if remote_aur and metadata else "disabled" if not remote_aur else "unavailable", "detail": rpc_error},
        {"id": "history", "label": "Recent AUR Git history", "status": "complete" if include_history and remote_aur and history.get("available") else "disabled" if not include_history or not remote_aur else "unavailable", "detail": history.get("error", "") if include_history and remote_aur else "optional" if remote_aur else "not applicable"},
    ]
    completed = sum(item["status"] == "complete" for item in coverage)
    enabled = sum(item["status"] != "disabled" for item in coverage)

    positives = []
    if source_urls and not provenance.get("insecure_sources"):
        positives.append("Alle erkannten HTTP-Quellen verwenden TLS")
    if strong:
        positives.append("Moderne kryptografische Quellprüfsummen vorhanden")
    if signed_source and validpgp:
        positives.append("Signaturquelle und validpgpkeys erkannt")
    if vcs_sources and not mutable_vcs:
        positives.append("VCS-Quellen sind auf Commit oder Tag festgelegt")
    if metadata.get("Maintainer"):
        positives.append("AUR-Paket besitzt einen aktiven Maintainer")
    if not findings:
        positives.append("Keine bewerteten statischen Risikomuster erkannt")

    recommendation = {
        "critical": "Nicht installieren, bevor sämtliche kritischen Fundstellen manuell geklärt sind.",
        "high": "Installation pausieren und die hervorgehobenen Fundstellen manuell prüfen.",
        "moderate": "Vor der Installation Quellen, Prüfsummen und markierte Build-Schritte prüfen.",
        "low": "Keine starken Malware-Indikatoren; Hinweise vor der Installation kurz prüfen.",
        "minimal": "Keine bewerteten Risikomuster erkannt. Das ist keine Garantie für Schadensfreiheit.",
    }[risk]

    guard_signature = build_guard_signature(package, analysis_documents, provenance, metadata, findings)

    return {
        "tool": "AUR Security Auditor", "version": VERSION, "schema_version": 2,
        "mode": "preflight", "package": package, "input": str(target), "input_type": input_type,
        "aur_url": f"https://aur.archlinux.org/packages/{urllib.parse.quote(package, safe='')}" if remote_aur else "",
        "started": started, "finished": dt.datetime.now(dt.timezone.utc).isoformat(),
        "safety": {
            "pkgbuild_executed": False,
            "shell_used": False,
            "archive_extracted_to_disk": False,
            "statement": "Static analysis only; PKGBUILD and included scripts were not executed.",
            "local_input": not remote_aur,
        },
        "risk": risk, "confidence": confidence, "confidence_score": max_confidence,
        "coverage": {"completed": completed, "enabled": enabled, "checks": coverage},
        "recommendation": recommendation, "positive_signals": positives,
        "summary": {
            "findings": len(findings),
            "critical": sum(item["severity"] == "critical" for item in findings),
            "high": sum(item["severity"] == "high" for item in findings),
            "medium": sum(item["severity"] == "medium" for item in findings),
            "low": sum(item["severity"] == "low" for item in findings),
            "documents": len(documents), "sources": len(sources), "source_hosts": len(provenance.get("source_hosts", [])),
        },
        "findings": findings, "provenance": provenance, "history": history,
        "metadata": {
            "version": metadata.get("Version", ""), "description": metadata.get("Description", ""),
            "maintainer": metadata.get("Maintainer"), "votes": int(metadata.get("NumVotes") or 0),
            "popularity": float(metadata.get("Popularity") or 0),
            "last_modified": utc_timestamp(metadata.get("LastModified")), "out_of_date": metadata.get("OutOfDate"),
            "rpc_error": rpc_error,
        },
        "documents": [
            {"name": name, "size": item["size"], "sha256": item["sha256"], "lines": item["text"].count("\n") + 1}
            for name, item in sorted(documents.items())
        ],
        "snapshot": snapshot,
        "guard_signature": guard_signature,
    }




DEEP_BUILD_TIMEOUT = 60 * 60
DEEP_LOG_LIMIT = 8 * 1024 * 1024
DEEP_MEMBER_LIMIT = 120000
DEEP_TOTAL_MEMBER_BYTES = 8 * 1024 * 1024 * 1024


class DeepCancelled(Cancelled):
    """Raised when the user explicitly cancels an isolated build."""


class DeepBuildError(RuntimeError):
    def __init__(
        self,
        message: str,
        report: Optional[dict] = None,
        *,
        code: str = "",
        args: Optional[dict[str, Any]] = None,
        status: str = "failed",
    ):
        super().__init__(message)
        self.report = report
        self.code = code
        self.error_args = args or {}
        self.status = status


def _download_aur_snapshot_bytes(package: str) -> tuple[bytes, dict]:
    package = parse_aur_target(package)
    quoted = urllib.parse.quote(package, safe="")
    url = f"https://aur.archlinux.org/cgit/aur.git/snapshot/{quoted}.tar.gz"
    req = urllib.request.Request(url, headers={"User-Agent": f"aur-security-auditor/{VERSION}"})
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            final_url = response.geturl()
            final = urllib.parse.urlparse(final_url)
            if final.scheme != "https" or final.hostname != "aur.archlinux.org" or final.port not in {None, 443}:
                raise RuntimeError("AUR-Snapshot wurde unsicher oder auf einen fremden Host umgeleitet")
            raw = response.read(PREFLIGHT_ARCHIVE_BYTES + 1)
    except Exception as exc:
        raise RuntimeError(f"AUR-Snapshot konnte nicht geladen werden: {exc}") from exc
    if len(raw) > PREFLIGHT_ARCHIVE_BYTES:
        raise RuntimeError("AUR-Snapshot überschreitet das sichere Größenlimit")
    return raw, {
        "snapshot_url": url,
        "snapshot_sha256": hashlib.sha256(raw).hexdigest(),
        "snapshot_bytes": len(raw),
    }


def _deep_archive_parts(name: str) -> tuple[str, ...]:
    """Return a normalized archive path while rejecting host/path traversal tricks."""
    value = str(name or "")
    if not value or "\x00" in value or "\\" in value or value.startswith("/"):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Dateipfad")
    normalized = posixpath.normpath(value)
    if normalized in {"", ".", ".."} or normalized.startswith("../"):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Dateipfad")
    parts = PurePosixPath(normalized).parts
    if not parts or any(part in {"", ".", ".."} for part in parts):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Dateipfad")
    return tuple(parts)


def _deep_link_target(member_parts: tuple[str, ...], linkname: str, root: str, hardlink: bool = False) -> tuple[str, ...]:
    """Resolve a tar link lexically and guarantee that it stays inside the package root."""
    value = str(linkname or "")
    if not value or "\x00" in value or "\\" in value or value.startswith("/"):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Linkeintrag")
    base = PurePosixPath() if hardlink else PurePosixPath(*member_parts[:-1])
    normalized = posixpath.normpath(str(base / value))
    if normalized in {"", ".", ".."} or normalized.startswith("../"):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Linkeintrag")
    parts = PurePosixPath(normalized).parts
    if not parts or parts[0] != root or any(part in {"", ".", ".."} for part in parts):
        raise RuntimeError("AUR-Snapshot enthält einen unsicheren Linkeintrag")
    return tuple(parts)


def _safe_extract_deep_snapshot(raw: bytes, package: str, destination: Path) -> Path:
    """Extract an AUR recipe after strict validation, including safe in-tree Git symlinks."""
    destination.mkdir(parents=True, exist_ok=True)
    destination.chmod(0o700)
    files = 0
    total = 0
    roots: set[str] = set()
    validated: list[tuple[tarfile.TarInfo, tuple[str, ...]]] = []
    member_types: dict[tuple[str, ...], str] = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
            members = archive.getmembers()
            for member in members:
                parts = _deep_archive_parts(member.name)
                roots.add(parts[0])
                if member.isdev() or member.isfifo():
                    raise RuntimeError("AUR-Snapshot enthält einen nicht erlaubten Spezialeintrag")
                if not (member.isdir() or member.isfile() or member.issym() or member.islnk()):
                    raise RuntimeError("AUR-Snapshot enthält einen nicht unterstützten Archiveintrag")
                if parts in member_types:
                    raise RuntimeError("AUR-Snapshot enthält einen doppelten Dateipfad")
                kind = "dir" if member.isdir() else "file" if member.isfile() else "symlink" if member.issym() else "hardlink"
                member_types[parts] = kind
                validated.append((member, parts))

            if len(roots) != 1 or package not in roots:
                raise RuntimeError("AUR-Snapshot besitzt keine eindeutige erwartete Paketwurzel")
            root = package

            # Link entries are allowed only when their lexical target exists inside the same snapshot.
            link_targets: dict[tuple[str, ...], tuple[str, ...]] = {}
            for member, parts in validated:
                kind = member_types[parts]
                if kind not in {"symlink", "hardlink"}:
                    continue
                target_parts = _deep_link_target(parts, member.linkname, root, hardlink=kind == "hardlink")
                if target_parts not in member_types:
                    raise RuntimeError("AUR-Snapshot enthält einen Link auf einen fehlenden Archiveintrag")
                if kind == "hardlink" and member_types[target_parts] != "file":
                    raise RuntimeError("AUR-Snapshot enthält einen ungültigen Hardlink")
                # Never let an archive use a symlink as a parent path for another entry.
                if any(len(other) > len(parts) and other[:len(parts)] == parts for other in member_types):
                    raise RuntimeError("AUR-Snapshot enthält einen Link als übergeordneten Dateipfad")
                link_targets[parts] = target_parts

            # Create directories and regular files first. Links are materialized only afterwards.
            for member, parts in validated:
                relative_parts = parts[1:]
                if not relative_parts:
                    continue
                kind = member_types[parts]
                target = destination.joinpath(*relative_parts)
                if kind == "dir":
                    target.mkdir(parents=True, exist_ok=True)
                    target.chmod(0o700)
                    continue
                if kind != "file":
                    continue
                files += 1
                total += max(0, int(member.size))
                if files > PREFLIGHT_MEMBER_LIMIT or total > PREFLIGHT_TOTAL_BYTES * 4:
                    raise RuntimeError("AUR-Snapshot überschreitet die sicheren Extraktionsgrenzen")
                target.parent.mkdir(parents=True, exist_ok=True)
                handle = archive.extractfile(member)
                if handle is None:
                    raise RuntimeError("AUR-Snapshot enthält eine nicht lesbare Datei")
                payload = handle.read(PREFLIGHT_MEMBER_BYTES + 1)
                if len(payload) > PREFLIGHT_MEMBER_BYTES:
                    raise RuntimeError(f"AUR-Datei ist für eine Build-Rezeptdatei ungewöhnlich groß: {parts[-1]}")
                target.write_bytes(payload)
                mode = int(member.mode) & 0o755
                target.chmod(mode or 0o600)

            for member, parts in validated:
                kind = member_types[parts]
                if kind not in {"symlink", "hardlink"}:
                    continue
                relative_parts = parts[1:]
                target_path = destination.joinpath(*relative_parts)
                target_path.parent.mkdir(parents=True, exist_ok=True)
                linked_parts = link_targets[parts][1:]
                linked_path = destination.joinpath(*linked_parts)
                if kind == "hardlink":
                    os.link(linked_path, target_path)
                else:
                    rewritten = os.path.relpath(linked_path, start=target_path.parent)
                    os.symlink(rewritten, target_path)
    except (tarfile.TarError, OSError) as exc:
        raise RuntimeError(f"AUR-Snapshot konnte nicht sicher extrahiert werden: {exc}") from exc
    pkgbuild = destination / "PKGBUILD"
    if not pkgbuild.is_file():
        raise RuntimeError("AUR-Snapshot enthält kein PKGBUILD")
    return destination


def _deep_builder_command() -> tuple[list[str], str]:
    override = os.environ.get("AUR_SECURITY_AUDITOR_DEEP_BUILDER", "").strip()
    if override:
        command = shlex.split(override)
        if not command or not Path(command[0]).is_file():
            raise RuntimeError("Konfigurierter Deep-Build-Runner wurde nicht gefunden")
        return command, Path(command[0]).name
    builder = shutil.which("extra-x86_64-build")
    if builder:
        return [builder, "-c"], "extra-x86_64-build"
    pkgctl = shutil.which("pkgctl")
    if pkgctl:
        return [pkgctl, "build", "--clean", "--repo", "extra", "."], "pkgctl build"
    raise RuntimeError("Für die isolierte Tiefenprüfung fehlt das Arch-Paket devtools (extra-x86_64-build oder pkgctl)")


def _terminate_process_group(process: subprocess.Popen, grace: float = 3.0) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        try:
            process.terminate()
        except OSError:
            return
    try:
        process.wait(timeout=grace)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        try:
            process.kill()
        except OSError:
            pass
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def _run_deep_command(
    command: list[str],
    cwd: Path,
    timeout: int = DEEP_BUILD_TIMEOUT,
    cancel_event: Optional[threading.Event] = None,
) -> tuple[int, str, float]:
    env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": str(invoking_user()[1]),
        "USER": invoking_user()[0],
        "LOGNAME": invoking_user()[0],
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_TERMINAL_PROMPT": "0",
        "PAGER": "cat",
        "SYSTEMD_PAGER": "cat",
    }
    started = time.monotonic()
    process = subprocess.Popen(
        command,
        cwd=cwd,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=False,
        start_new_session=True,
    )
    try:
        while True:
            if cancel_event is not None and cancel_event.is_set():
                _terminate_process_group(process)
                raw, _ = process.communicate(timeout=2)
                raise DeepCancelled("Isolierte Tiefenprüfung wurde abgebrochen")
            elapsed = time.monotonic() - started
            if elapsed >= timeout:
                _terminate_process_group(process)
                raw, _ = process.communicate(timeout=2)
                clipped = (raw or b"")[-DEEP_LOG_LIMIT:]
                text = clipped.decode("utf-8", errors="replace")
                raise DeepBuildError(
                    f"Isolierter Build hat das Zeitlimit von {timeout // 60} Minuten überschritten",
                    code="deepTimedOut",
                    args={"minutes": str(timeout // 60)},
                    status="timeout",
                )
            try:
                raw, _ = process.communicate(timeout=min(0.4, max(0.05, timeout - elapsed)))
                break
            except subprocess.TimeoutExpired:
                continue
        clipped = (raw or b"")[-DEEP_LOG_LIMIT:]
        text = clipped.decode("utf-8", errors="replace")
        if raw and len(raw) > len(clipped):
            text = "[earlier build output truncated]\n" + text
        return int(process.returncode or 0), text, round(time.monotonic() - started, 3)
    finally:
        if process.poll() is None:
            _terminate_process_group(process)


def _archive_tool() -> str:
    tool = shutil.which("bsdtar") or shutil.which("tar")
    if not tool:
        raise RuntimeError("Zur Paketarchiv-Analyse fehlt bsdtar/libarchive oder tar")
    return tool


def _archive_read(path: Path, member: str, limit: int = 2 * 1024 * 1024) -> str:
    tool = _archive_tool()
    cp = subprocess.run([tool, "-xOf", str(path), member], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=25)
    if cp.returncode != 0:
        return ""
    return cp.stdout[:limit].decode("utf-8", errors="replace")


def _archive_inventory(path: Path) -> dict:
    tool = _archive_tool()
    names_cp = subprocess.run([tool, "-tf", str(path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    if names_cp.returncode != 0:
        raise RuntimeError(f"Paketarchiv konnte nicht gelesen werden: {names_cp.stderr.strip()[:1000]}")
    verbose_cp = subprocess.run([tool, "-tvf", str(path)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    names = [line.rstrip("\n") for line in names_cp.stdout.splitlines() if line.strip()]
    if len(names) > DEEP_MEMBER_LIMIT:
        raise RuntimeError("Paketarchiv enthält ungewöhnlich viele Einträge")
    verbose = verbose_cp.stdout.splitlines() if verbose_cp.returncode == 0 else []
    entries = []
    total_size = 0
    for index, name in enumerate(names):
        clean = name.lstrip("./")
        if not clean or clean.startswith("../") or "/../" in f"/{clean}/":
            raise RuntimeError("Paketarchiv enthält einen unsicheren Pfad")
        line = verbose[index] if index < len(verbose) else ""
        parts = line.split()
        mode = parts[0] if parts and re.fullmatch(r"[bcdlps-][rwxStTs-]{9}[+@.]?", parts[0]) else ""
        size = 0
        for token in parts[1:7]:
            if token.isdigit():
                size = int(token)
        total_size += size
        if total_size > DEEP_TOTAL_MEMBER_BYTES:
            raise RuntimeError("Paketarchiv überschreitet das Analysegrößenlimit")
        entries.append({"path": clean, "mode": mode[:10], "size": size})
    return {"entries": entries, "files": len(entries), "bytes": total_size, "tool": Path(tool).name}


def _deep_package_findings(package: str, artifact: Path, inventory: dict) -> tuple[list[dict], dict]:
    findings = []
    surfaces = {}
    suid = []
    sgid = []
    world_writable_exec = []
    executables = 0
    for item in inventory["entries"]:
        path = item["path"]
        mode = item.get("mode", "")
        if len(mode) >= 10:
            if "x" in mode[1:]:
                executables += 1
            if mode[3:4] in {"s", "S"}:
                suid.append(path)
            if mode[6:7] in {"s", "S"}:
                sgid.append(path)
            if mode[8:9] == "w" and "x" in mode[7:10]:
                world_writable_exec.append(path)
        surface = core.security_surface_for_path("/" + path)
        if surface:
            kind = surface.get("kind", "other")
            surfaces[kind] = surfaces.get(kind, 0) + 1
    for path in suid:
        findings.append(_preflight_finding(package, "high", "deep-suid-file", path,
            "Gebautes Paket enthält eine SUID-Datei", path, 0, 96,
            ["SUID kann Ausführung mit Dateibesitzer-Rechten erlauben", "Muss für den Paketzweck zwingend nachvollziehbar sein"]))
    for path in sgid:
        findings.append(_preflight_finding(package, "medium", "deep-sgid-file", path,
            "Gebautes Paket enthält eine SGID-Datei", path, 0, 86,
            ["SGID kann zusätzliche Gruppenrechte verleihen", "Privilegierte Dateimodi benötigen manuelle Prüfung"]))
    for path in world_writable_exec:
        findings.append(_preflight_finding(package, "high", "deep-world-writable-executable", path,
            "Ausführbare Paketdatei ist für andere Benutzer beschreibbar", path, 0, 97,
            ["Ermöglicht lokale Manipulation ausführbaren Codes"]))
    privileged_surface = sum(count for kind, count in surfaces.items() if kind in {"sudoers", "pam", "polkit", "kernel-module", "pacman-hook"})
    if privileged_surface:
        findings.append(_preflight_finding(package, "low", "deep-privileged-surface", artifact.name,
            "Gebautes Paket erweitert privilegierte Systemflächen", ", ".join(f"{k}={v}" for k, v in sorted(surfaces.items())), 0, 60,
            ["Systemintegration ist nicht automatisch bösartig", "Installierte Sicherheitsflächen sollten zum Paketzweck passen"]))
    install_text = _archive_read(artifact, ".INSTALL")
    if install_text:
        raw = core.scan_text(package, "AUR preflight:.INSTALL", _preflight_analysis_text(".INSTALL", install_text), hashlib.sha256(install_text.encode()).hexdigest())
        findings.extend(_preflight_normalize_raw(package, raw))
    metadata = {
        "suid_files": suid,
        "sgid_files": sgid,
        "world_writable_executables": world_writable_exec,
        "executables": executables,
        "security_surface": surfaces,
        "pkginfo": _archive_read(artifact, ".PKGINFO"),
        "buildinfo": _archive_read(artifact, ".BUILDINFO"),
        "install_script_present": bool(install_text),
    }
    return findings, metadata


def _run_namcap(source_dir: Path, artifacts: list[Path]) -> dict:
    namcap = shutil.which("namcap")
    if not namcap:
        return {"available": False, "output": "", "returncode": None, "issues": 0}
    command = [namcap, str(source_dir / "PKGBUILD"), *map(str, artifacts)]
    cp = subprocess.run(command, cwd=source_dir, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=180, check=False)
    output = cp.stdout[-2 * 1024 * 1024:]
    issues = sum(1 for line in output.splitlines() if re.search(r"\b(?:W|E):", line))
    return {"available": True, "output": output, "returncode": cp.returncode, "issues": issues}


def _classify_deep_build(rc: int, build_log: str, artifacts: list[Path]) -> tuple[str, str, dict[str, Any], str]:
    if rc == 0 and artifacts:
        return "complete", "", {}, ""
    if rc == 0 and not artifacts:
        return "failed", "deepNoArtifact", {}, "Clean-Chroot-Build lieferte kein Paketarchiv"

    dependencies = []
    if re.search(r"(?im)^==> Missing dependencies:\s*$", build_log) or "Could not resolve all dependencies" in build_log:
        dependencies = sorted(set(re.findall(r"(?m)^\s*->\s*([A-Za-z0-9@._+:-]+)", build_log)))
        joined = ", ".join(dependencies) if dependencies else "—"
        return (
            "blocked",
            "deepBlockedDependencies",
            {"dependencies": joined, "count": len(dependencies)},
            f"Clean-Chroot-Build durch nicht auflösbare Abhängigkeiten blockiert: {joined}",
        )
    if re.search(r"(?i)(running makepkg as root is not allowed|do not run makepkg as root)", build_log):
        return "failed", "deepBuilderPrivilegeError", {}, "Clean-Chroot-Builder wurde mit ungeeigneten Rechten gestartet"
    if re.search(r"(?i)(one or more pgp signatures could not be verified|unknown public key|signature.*failed)", build_log):
        return "failed", "deepSignatureError", {}, "Signaturprüfung der Build-Quellen fehlgeschlagen"
    if re.search(r"(?i)(did not pass the validity check|validating source files.*failed|integrity checks.*failed|checksum.*failed)", build_log):
        return "failed", "deepChecksumError", {}, "Prüfsummenprüfung der Build-Quellen fehlgeschlagen"
    if re.search(r"(?i)(could not resolve host|failed to connect|connection timed out|network is unreachable|ssl certificate problem|curl: \([0-9]+\)|wget: unable)", build_log):
        return "failed", "deepSourceError", {}, "Build-Quelle konnte nicht geladen werden"
    if re.search(r"(?i)(failed to synchronize all databases|database file.*does not exist|unable to lock database|failed retrieving file)", build_log):
        return "failed", "deepChrootError", {}, "Clean-Chroot- oder Pacman-Umgebung ist nicht einsatzbereit"
    return "failed", "deepBuildExit", {"exit": str(rc)}, f"Clean-Chroot-Build fehlgeschlagen (Exit {rc})"


def deep_analysis(
    target: str,
    include_history: bool = True,
    callback=None,
    cancel_event: Optional[threading.Event] = None,
) -> dict:
    package = parse_aur_target(target)
    if os.geteuid() != 0 and os.environ.get("AUR_SECURITY_AUDITOR_DEEP_ALLOW_UNPRIVILEGED") != "1":
        raise RuntimeError("Die isolierte Tiefenprüfung benötigt Root-Rechte für den Clean-Chroot-Build")
    if cancel_event is not None and cancel_event.is_set():
        raise DeepCancelled("Isolierte Tiefenprüfung wurde abgebrochen")
    started = dt.datetime.now(dt.timezone.utc).isoformat()
    if callback:
        callback("deep_preflight", package, "Statische Vorprüfung läuft", [])
    preflight = preflight_analysis(target, include_history)
    if cancel_event is not None and cancel_event.is_set():
        raise DeepCancelled("Isolierte Tiefenprüfung wurde abgebrochen")
    if callback:
        callback("deep_snapshot", package, "AUR-Snapshot wird geladen und validiert", [])
    raw, snapshot = _download_aur_snapshot_bytes(package)
    with tempfile.TemporaryDirectory(prefix=f"aur-security-auditor-deep-{package}-") as temp:
        work = Path(temp)
        if callback:
            callback("deep_extract", package, "Validierter Snapshot wird für den Clean-Chroot-Build vorbereitet", [])
        source_dir = _safe_extract_deep_snapshot(raw, package, work / "source")
        uid, gid = ownership()
        if os.geteuid() == 0:
            for node in [source_dir, *source_dir.rglob("*")]:
                try:
                    os.chown(node, uid, gid)
                except OSError:
                    pass
        if cancel_event is not None and cancel_event.is_set():
            raise DeepCancelled("Isolierte Tiefenprüfung wurde abgebrochen")
        command, builder_name = _deep_builder_command()
        if callback:
            callback("deep_build", package, f"Isolierter Build mit {builder_name} läuft", [])
        rc, build_log, duration = _run_deep_command(command, source_dir, cancel_event=cancel_event)
        artifacts = sorted(
            path for path in source_dir.glob("*.pkg.tar.*")
            if path.is_file() and not path.name.endswith(".sig") and ".src.tar." not in path.name
        )
        build_status, failure_code, failure_args, failure_message = _classify_deep_build(rc, build_log, artifacts)
        if callback:
            callback("deep_artifacts", package, "Erzeugte Paketarchive werden inventarisiert", [])
        artifact_reports = []
        findings = list(preflight.get("findings", []))
        for artifact in artifacts:
            if cancel_event is not None and cancel_event.is_set():
                raise DeepCancelled("Isolierte Tiefenprüfung wurde abgebrochen")
            inventory = _archive_inventory(artifact)
            artifact_findings, package_meta = _deep_package_findings(package, artifact, inventory)
            findings.extend(artifact_findings)
            artifact_reports.append({
                "name": artifact.name,
                "sha256": core.sha256_file(artifact),
                "size": artifact.stat().st_size,
                "inventory": {"files": inventory["files"], "bytes": inventory["bytes"], "tool": inventory["tool"]},
                "analysis": package_meta,
            })
        if callback:
            callback("deep_namcap", package, "Paketqualität und Metadaten werden geprüft", [])
        namcap = _run_namcap(source_dir, artifacts) if artifacts else {"available": bool(shutil.which("namcap")), "output": "", "returncode": None, "issues": 0}
        coverage = [
            {"id": "preflight", "label": "Preflight analysis", "status": "complete", "detail": preflight["risk"]},
            {"id": "clean-chroot", "label": "Clean chroot build", "status": "complete" if rc == 0 else build_status, "detail": builder_name},
            {"id": "artifact", "label": "Built package archive", "status": "complete" if artifacts else "unavailable", "detail": str(len(artifacts))},
            {"id": "archive", "label": "Package file inventory", "status": "complete" if artifact_reports else "unavailable", "detail": str(sum(x["inventory"]["files"] for x in artifact_reports))},
            {"id": "namcap", "label": "Namcap", "status": "complete" if namcap["available"] else "unavailable", "detail": str(namcap["issues"]) if namcap["available"] else "not installed"},
        ]
        highest = max((SEV.get(item.get("severity", "info"), 0) for item in findings), default=0)
        risk = "critical" if highest >= SEV["critical"] else "high" if highest >= SEV["high"] else "moderate" if highest >= SEV["medium"] else "low" if findings else "minimal"
        confidence_score = max((int(item.get("confidence", 0)) for item in findings), default=72)
        report = {
            "tool": "AUR Security Auditor", "version": VERSION, "schema_version": 2,
            "mode": "deep", "package": package, "input": str(target),
            "started": started, "finished": dt.datetime.now(dt.timezone.utc).isoformat(),
            "status": build_status, "risk": risk,
            "confidence": "high" if confidence_score >= 88 else "medium" if confidence_score >= 65 else "low",
            "confidence_score": confidence_score,
            "coverage": {"completed": sum(x["status"] == "complete" for x in coverage), "enabled": len(coverage), "checks": coverage},
            "safety": {
                "host_install_performed": False,
                "build_environment": "clean chroot",
                "source_snapshot_sha256": snapshot["snapshot_sha256"],
                "statement": "PKGBUILD execution was confined to an Arch clean chroot; built packages were not installed on the host.",
            },
            "build": {
                "tool": builder_name, "returncode": rc, "duration_seconds": duration,
                "artifacts": len(artifact_reports), "log": build_log,
                "status": build_status,
                "failure": {"code": failure_code, "args": failure_args, "message": failure_message} if failure_code else None,
            },
            "namcap": namcap,
            "artifacts": artifact_reports,
            "findings": sorted(findings, key=lambda x: (-SEV.get(x.get("severity", "info"), 0), x.get("document", ""), x.get("line", 0))),
            "summary": {
                "findings": len(findings),
                "critical": sum(x.get("severity") == "critical" for x in findings),
                "high": sum(x.get("severity") == "high" for x in findings),
                "medium": sum(x.get("severity") == "medium" for x in findings),
                "low": sum(x.get("severity") == "low" for x in findings),
                "artifacts": len(artifact_reports),
                "files": sum(x["inventory"]["files"] for x in artifact_reports),
                "suid": sum(len(x["analysis"]["suid_files"]) for x in artifact_reports),
                "sgid": sum(len(x["analysis"]["sgid_files"]) for x in artifact_reports),
                "namcap_issues": namcap["issues"],
            },
            "preflight": {k: v for k, v in preflight.items() if k not in {"documents"}},
        }
        if callback:
            callback("deep_report", package, "Tiefenprüfungsbericht wird finalisiert", [])
        if build_status != "complete":
            raise DeepBuildError(
                failure_message,
                report,
                code=failure_code,
                args=failure_args,
                status=build_status,
            )
        return report


def deep_evidence_bundle(report: dict) -> bytes:
    report_copy = json.loads(json.dumps(report))
    build_log = str(report_copy.get("build", {}).pop("log", ""))
    namcap_output = str(report_copy.get("namcap", {}).pop("output", ""))
    files = {
        "deep-report.json": json.dumps(report_copy, ensure_ascii=False, indent=2).encode(),
        "build.log": build_log.encode("utf-8", errors="replace"),
        "namcap.txt": namcap_output.encode("utf-8", errors="replace"),
    }
    manifest = "".join(f"{hashlib.sha256(payload).hexdigest()}  {name}\n" for name, payload in files.items()).encode()
    files["manifest.sha256"] = manifest
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for name, payload in files.items():
            archive.writestr(name, payload)
    return buffer.getvalue()


