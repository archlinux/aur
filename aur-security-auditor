]


def deep_error_descriptor(error: BaseException | str) -> tuple[str, dict[str, Any]]:
    if isinstance(error, DeepBuildError) and error.code:
        return error.code, dict(error.error_args)
    if isinstance(error, DeepCancelled):
        return "deepCancelled", {}
    message = str(error)
    for pattern, code in _DEEP_ERROR_CODES:
        match = pattern.search(message)
        if match:
            return code, {"exit": match.group(1)} if match.groups() else {}
    return "", {}


