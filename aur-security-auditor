    def add_event(self, kind, message, package="", severity="info", message_code="", message_args=None):
        self.state["events"].append({
            "time": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            "kind": kind, "message": message, "package": package, "severity": severity,
            "message_code": message_code, "message_args": message_args or {},
        })
        cutoff = dt.datetime.now().astimezone() - dt.timedelta(minutes=10)
        recent = []
        for item in self.state["events"]:
            try:
                timestamp = dt.datetime.fromisoformat(str(item.get("time", "")))
                if timestamp.tzinfo is None:
                    timestamp = timestamp.replace(tzinfo=cutoff.tzinfo)
                if timestamp >= cutoff:
                    recent.append(item)
            except (TypeError, ValueError):
                recent.append(item)
        self.state["events"] = recent[-2000:]

    def set_phase(self, phase, detail=""):
        with self.lock:
            self.state["phase"] = phase
            if detail:
                self.state["detail"] = detail
            self.state["progress_percent"] = max(
                self.state.get("progress_percent", 0.0), self.PHASE_PROGRESS.get(phase, 0.0)
            )
            self.add_event("phase", detail or phase)

    def event(self, kind, package, detail, findings):
        with self.lock:
            if self.cancel.is_set():
                raise Cancelled()
            self.state["current_package"], self.state["detail"] = package, detail
            if kind == "start":
                self.add_event("package_start", f"Prüfung gestartet: {detail}", package)
            elif kind == "file":
                self.state["files_done"] += 1
                for item in findings:
                    if item.severity in self.state["current_findings"]:
                        self.state["current_findings"][item.severity] += 1
                total = max(1, self.state["files_total"])
                ratio = min(1.0, self.state["files_done"] / total)
                self.state["progress_percent"] = 15.0 + ratio * 75.0
                elapsed = time.monotonic() - self.state["started"] if self.state["started"] else 0
                if self.state["files_done"] > 20 and ratio > 0:
                    self.state["eta_seconds"] = max(0, int(elapsed / ratio - elapsed))
            elif kind in {"stage", "aux"}:
                if findings:
                    for item in findings:
                        if item.severity in self.state["current_findings"]:
                            self.state["current_findings"][item.severity] += 1
                    strongest = max(findings, key=lambda item: SEV.get(item.severity, 0))
                    if strongest.severity in {"critical", "high"}:
                        self.add_event("raw_signal", strongest.message, package, strongest.severity)

    def start(self, options=None):
        with self.lock:
            if self.thread and self.thread.is_alive():
                return False, "Ein Scan läuft bereits"
            self.cancel.clear()
            scan_id = dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + secrets.token_hex(3)
            self.state.update({
                "status": "running", "phase": "Initialisierung", "detail": "Vollständiger Scan wird vorbereitet",
                "current_package": "", "packages_total": 0, "packages_done": 0,
                "files_total": 0, "files_done": 0, "started": time.monotonic(),
                "started_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"), "finished_at": None,
                "elapsed_seconds": 0, "error": "", "warnings": [], "events": [], "partial": {}, "report": None,
                "progress_percent": 1.0, "eta_seconds": None, "scan_id": scan_id,
                "current_findings": {"critical": 0, "high": 0, "medium": 0, "low": 0},
            })
            self.add_event("scan_start", "Vollständiger Scan gestartet",
                           message_code="eventScanStart", message_args={})
            self.thread = threading.Thread(target=self.worker, args=(options or {},), daemon=True, name="aur-security-auditor-worker")
