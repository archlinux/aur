    )
    if loader_pair:
        loader_src, _ = loader_pair
        add("high", "loader-persistence", "Payload-Kontext verändert Loader- oder Shell-Persistenz", 94,
            ["Persistenzmechanismus", "Konkrete Payload-Ausführung in derselben Datei"], ["persistence-loader"],
            lambda item: item is loader_src)

    ip_pair = None
    for payload_rule in strong_payload_rules:
        ip_pair = same_path_items(
            "direct-ip-url", payload_rule,
