note() {
	printf "${blue}==>${yellow} NOTE:${bold} $1${all_off}\n"
}

all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
yellow="${bold}$(tput setaf 3)"

post_install() {
	note "Custom modules should be placed in: ~/.local/lib/pay-respects/"
	note "If you use different nested shell, set SHELL to the working shell before initialization"
}

post_upgrade() {
	post_install
}
