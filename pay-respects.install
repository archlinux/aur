note() {
	printf "${blue}==>${yellow} NOTE:${bold} $1${all_off}\n"
}

all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
yellow="${bold}$(tput setaf 3)"

post_install() {
	note "Default _DEF_PR_LIB set to /usr/lib/pay-respects"
	note "Default _DEF_PACKAGE_MANAGER set to pacman"
}

post_upgrade() {
	post_install
}
