note() {
	printf "${blue}==>${yellow} NOTE:${bold} $1${all_off}\n"
}

all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
yellow="${bold}$(tput setaf 3)"

post_install() {
	note "If you use different nested shells, set SHELL to the working shell before initialization"
	note "Default values set by this package:
	_PR_LIB: /usr/lib/pay-respects
	_PACKAGE_MANAGER: pacman"
}

post_upgrade() {
	post_install
}
