note() {
	printf "${blue}==>${yellow} NOTE:${bold} $1${all_off}\n"
}

all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
yellow="${bold}$(tput setaf 3)"

post_install() {
	note "Default values set by this package:
	_DEF_PR_LIB: /usr/lib/pay-respects
	_DEF_PACKAGE_MANAGER: pacman"
}

post_upgrade() {
	post_install
}
