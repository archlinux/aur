From 30f70e486660a109330cb2536f3999a0c92fe4d3 Mon Sep 17 00:00:00 2001
From: basalt <basalt@localhost>
Date: Tue, 3 Nov 2026 07:20:57 +0300
Subject: [PATCH] ram-guard: --ram-guard-mib N (0 = the RAM guard off)

The serve RAM guard's floor is the automatic margin plus one prompt chunk's file
reads. --ram-guard-mib N replaces it; 0 turns the guard off: nothing is shed and
no request stops for the guard, so the OS reclaims its page cache and swaps
instead. Placement, the tiers and the chunk sizes are untouched.

Base: 1b3f6964 (v0.2.1).  Deliberately source-only: no docs/ and no tests/
hunks.  Those files churn every release - docs/running.md is exactly where this
patch conflicted at v0.2.1 - and they change nothing the package ships; the flag
is documented in the package README instead.  Keep it that way when rebasing.
---
 include/basalt/platform/memory.hpp |  3 ++-
 include/basalt/program/options.hpp |  5 +++++
 src/platform/memory.cpp            |  2 +-
 src/program/cli/arguments.cpp      | 10 ++++++++++
 src/program/cli/help.cpp           |  6 +++++-
 src/program/serve/memory.cpp       |  5 ++++-
 6 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/include/basalt/platform/memory.hpp b/include/basalt/platform/memory.hpp
index 8525cf11..1fbc5f4e 100644
--- a/include/basalt/platform/memory.hpp
+++ b/include/basalt/platform/memory.hpp
@@ -146,9 +146,10 @@ inline bool ram_below_floor(uint64_t avail, uint64_t floor) { return avail > 0 &
 /// give-back (0 = none yet) and `since_ms` the time since it.  Within `lead` of `floor`, the first give-back is due at
 /// once; later ones need the cooldown over and the reading down by `refill` since `after`, i.e. the view has been
 /// read in again.  A reading that stays low with nothing refilling therefore causes no repeated give-backs.
+/// A `floor` of 0 is the guard off (`--ram-guard-mib 0`): nothing is ever given back.
 inline bool reclaim_due(uint64_t avail, uint64_t floor, uint64_t lead, uint64_t after, uint64_t since_ms,
                         uint64_t refill = 256ull << 20, uint64_t cooldown_ms = 250) {
-    if (!ram_below_floor(avail, floor + lead)) return false;
+    if (floor == 0 || !ram_below_floor(avail, floor + lead)) return false;
     if (after == 0) return true;
     return since_ms >= cooldown_ms && avail + refill <= after;
 }
diff --git a/include/basalt/program/options.hpp b/include/basalt/program/options.hpp
index 6348b90d..18131967 100644
--- a/include/basalt/program/options.hpp
+++ b/include/basalt/program/options.hpp
@@ -113,6 +113,11 @@ struct Options {
     /// this reserve for the graphs, the hit scratch and the head.
     int vram_reserve_mib = 700;
     bool vram_reserve_given = false;   // --vram-reserve-mib on the command line (no smaller automatic reserve)
+    /// `--ram-guard-mib N`: the free RAM (MemAvailable) a serving request must stay above; below it a request stops
+    /// with an error instead of the machine swapping.  -1 = the automatic floor (the RAM margin plus one prompt
+    /// chunk's file reads, `ram_guard_floor`); 0 = the guard off: requests run however far the RAM goes and the OS
+    /// reclaims its cache and swaps instead.  Placement and the tiers stay as they are; the RAM-home reserve follows.
+    int64_t ram_guard_mib = -1;
     /// Opt-in: the expert cache in physical segments (CUDA virtual memory management), so the serve loop's
     /// `VRAM <reserve_mib>` command can give part of it back to other programs and take it again.  Off: one cudaMalloc.
     bool vram_elastic = false;
diff --git a/src/platform/memory.cpp b/src/platform/memory.cpp
index 6085fb8c..5d04380a 100644
--- a/src/platform/memory.cpp
+++ b/src/platform/memory.cpp
@@ -301,7 +301,7 @@ std::string ram_stop_message(uint64_t avail, uint64_t floor, uint64_t hard, cons
                       (unsigned long long) (floor >> 20));
     char tail[160] = "";
     if (own > others)
-        std::snprintf(tail, sizeof tail, "; lower --resident-budget-gib");
+        std::snprintf(tail, sizeof tail, "; lower --resident-budget-gib or set --ram-guard-mib");
     else if (others >= (1ull << 20))
         std::snprintf(tail, sizeof tail, "; other programs took %llu MiB since the engine was ready",
                       (unsigned long long) (others >> 20));
diff --git a/src/program/cli/arguments.cpp b/src/program/cli/arguments.cpp
index 7ad86c2a..152255fc 100644
--- a/src/program/cli/arguments.cpp
+++ b/src/program/cli/arguments.cpp
@@ -92,6 +92,16 @@ std::optional<int> parse_options(int argc, char** argv, Options& o, std::string&
         else if (a == "--gpu") o.gpu = next("--gpu");
         else if (a == "--gpu-plan") o.gpu_plan = true;
         else if (a == "--vram-reserve-mib") { o.vram_reserve_mib = std::atoi(next("--vram-reserve-mib")); o.vram_reserve_given = true; }
+        else if (a == "--ram-guard-mib") {
+            const char* v = next("--ram-guard-mib");
+            char* end = nullptr;
+            const long mib = std::strtol(v, &end, 10);
+            if (mib < 0 || end == v || *end != '\0') {
+                basalt::log::error("basalt generate", "--ram-guard-mib needs N >= 0 MiB (0 = the guard off)");
+                return 2;
+            }
+            o.ram_guard_mib = mib;
+        }
         else if (a == "--prefill") {
             const std::string v = next("--prefill");
             o.prefill_given = true;
diff --git a/src/program/cli/help.cpp b/src/program/cli/help.cpp
index 61c0e0d7..bd88986a 100644
--- a/src/program/cli/help.cpp
+++ b/src/program/cli/help.cpp
@@ -203,7 +203,11 @@ void usage() {
                  "  --resident-budget-gib N  the resident mode with at most N GiB of experts in RAM (hottest first;\n"
                  "                       auto when not set: what fits);\n"
                  "                       a budget that would leave less than the RAM floor free is refused, naming\n"
-                 "                       the largest safe value.\n");
+                 "                       the largest safe value.\n"
+                 "  --ram-guard-mib N  the RAM (MemAvailable) a serving request must stay above: below it the request\n"
+                 "                       stops with an error instead of the machine swapping.  Auto when not set: the\n"
+                 "                       RAM margin (the larger of 2 GiB and 5% of the RAM) plus one prompt chunk's\n"
+                 "                       file reads; 0 = the guard off (the OS reclaims and swaps instead).\n");
 }
 
 }  // namespace basalt::program::cli
diff --git a/src/program/serve/memory.cpp b/src/program/serve/memory.cpp
index f364f969..b2f9d691 100644
--- a/src/program/serve/memory.cpp
+++ b/src/program/serve/memory.cpp
@@ -284,7 +284,10 @@ int Runtime::init_memory() {
     basalt::platform::stop_memory_watchdog();
     // from here the RAM guard watches: below its floor the engine sheds and new requests wait, and a running
     // request stops only once the RAM is critical
-    guard_floor = basalt::platform::ram_guard_floor(basalt::platform::ram_margin(), tier_file_bytes, prompt_file_bytes);
+    // (--ram-guard-mib overrides that floor; 0 turns the guard off, the placement and the tiers stay as sized)
+    guard_floor = o.ram_guard_mib >= 0
+                      ? (uint64_t) o.ram_guard_mib << 20
+                      : basalt::platform::ram_guard_floor(basalt::platform::ram_margin(), tier_file_bytes, prompt_file_bytes);
     basalt::platform::start_ram_guard(guard_floor);
     disk_floor = guard_floor + (1ull << 30);   // a disk-tier capture or read stays a GiB above the guard
     // what a stop's error compares against, to tell the engine's own growth from other programs'
-- 
2.56.0

