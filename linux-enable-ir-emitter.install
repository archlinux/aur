post_install() {
  cat <<'EOF'

==> linux-enable-ir-emitter is rootless and runs on demand (no systemd service).

    1. Configure your camera (run as your normal user, not root):
         linux-enable-ir-emitter configure
       This writes the config to ~/.config/linux-enable-ir-emitter.toml

    2. Enable the emitter when the IR camera is used. Pick one:

       * Howdy / PAM (automatic): in every file listed by
           grep -rl howdy /etc/pam.d
         add the following line BEFORE the line mentioning "howdy"
         (replace <USER> with your username):
           auth optional pam_exec.so /usr/bin/linux-enable-ir-emitter run --config /home/<USER>/.config/linux-enable-ir-emitter.toml

       * Manual / other programs: run this before using the camera:
           linux-enable-ir-emitter run

    See /usr/share/doc/linux-enable-ir-emitter-git/README.md for details.

EOF
}

post_upgrade() {
  # v7 (Rust) is a full rewrite: the systemd service and udev rules are gone,
  # and the config format/location changed (now ~/.config/linux-enable-ir-emitter.toml).
  if (( $(vercmp "$2" 7.0.0) < 0 )); then
    echo "==> Upgraded from v6: config format/location changed (now"
    echo "    ~/.config/linux-enable-ir-emitter.toml) and is NOT migrated automatically."
    echo "    REBOOT FIRST, then run 'linux-enable-ir-emitter configure'."
    echo "    If the emitter is still enabled from v6, configure detects it as"
    echo "    'already working', aborts, and saves an EMPTY config that fails on"
    echo "    next boot. A reboot resets the camera so configure can search properly."
    echo "    Also re-add your PAM/launch hook; the old systemd service is gone."
  fi
  post_install
}
