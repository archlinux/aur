post_install() {
  echo ">>> upi installed."
  echo ">>>"
  echo ">>> Edit /etc/upi/config.yml to configure tasks."
  echo ">>>"
  echo ">>> Start and enable the service:"
  echo ">>>   sudo systemctl enable --now upi"
}

post_upgrade() {
  echo ">>> Remember to restart the upi service if configurations changed."
  echo ">>>   sudo systemctl restart upi"
}
