post_install() {
    echo "==> Reloading udev rules..."
    udevadm control --reload-rules
    udevadm trigger

    echo "==> Enabling and starting ajazz-mouse.service..."
    systemctl daemon-reload
    systemctl enable --now ajazz-mouse.service || true
    
    echo "==> Done! Battery status will be written to /tmp/ajazz_battery"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "==> Stopping and disabling ajazz-mouse.service..."
    systemctl disable --now ajazz-mouse.service || true
}
