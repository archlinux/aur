+    # NCCL-EP invokes its own host compiler and nvcc commands with the
+    # distribution flags verbatim. Arch's LTO bytecode is compiler-version
+    # specific, while the CUDA host compiler is GCC 15; additionally the
+    # NCCL-EP shared-library rule relinks pre-generated CUDA registration glue,
+    # which makes host LTO emit duplicate registration symbols. Disable LTO
+    # only for this subprocess.
+    for variable in ("CFLAGS", "CXXFLAGS"):
+        env[variable] = shlex.join(
+            flag
+            for flag in shlex.split(env.get(variable, ""))
+            if not flag.startswith("-flto")
+        )
+
+    # nvcc does not understand compiler-driver -Wl,... spelling. Translate
+    # linker options and forward other host flags while preserving -L/-l.
+    nvcc_ldflags: list[str] = []
+    for flag in shlex.split(env.get("LDFLAGS", "")):
+        if flag.startswith("-flto"):
+            continue
+        if flag.startswith("-Wl,"):
+            nvcc_ldflags.extend(
+                f"-Xlinker={option}" for option in flag.removeprefix("-Wl,").split(",")
+            )
+        elif flag.startswith(("-L", "-l")):
+            nvcc_ldflags.append(flag)
+        else:
+            nvcc_ldflags.append(f"-Xcompiler={flag}")
+    env["LDFLAGS"] = shlex.join(nvcc_ldflags)
 
