+++ b/setup-desktop-entry.sh
@@ -1,29 +1,25 @@
-#!/usr/bin/env sh
+#!/usr/bin/env bash
 
 # This script generates a desktop entry in the current directory.
-# Stop if shell has root privilege.
-[ `id -u` -eq 0 ] && exit 1
 
