pkgbase = rustconn-appimage
	pkgdesc = Modern GTK4 connection manager for SSH, RDP, VNC and SPICE (AppImage)
	pkgver = 0.24.2
	pkgrel = 1
	url = https://github.com/totoshko88/RustConn
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = desktop-file-utils
	depends = alsa-lib
	depends = bash
	depends = coreutils
	depends = dbus
	depends = e2fsprogs
	depends = fontconfig
	depends = fribidi
	depends = fuse2
