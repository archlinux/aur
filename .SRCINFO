pkgname = mozc-ut-full-common
	pkgdesc = A Japanese Input Method for Chromium OS, Windows, Mac and Linux (the Open Source Edition of Google Japanese Input)
	optdepends = qt6-base: Display GUI of mozc_tool
	options = !docs

