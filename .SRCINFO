pkgbase = waywallen-display
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/waywallen/waywallen-display
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	makedepends = libglvnd
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = glib2
	makedepends = gobject-introspection
	makedepends = gtk4
	makedepends = cargo
	makedepends = glslang
	depends = libgcc
	depends = libstdc++
	depends = glibc
	options = !lto
	source = waywallen-display-0.3.1.tar.gz::https://github.com/waywallen/waywallen-display/archive/refs/tags/v0.3.1.tar.gz
	source = 0001-cmake-Install-kde-wallpaper-to-correct-path.patch
	source = 0002-cmake-Install-gnome-extensions-separately.patch
	sha256sums = 08439e8990da002f2a6d781edfe6b16aabd2025e6e8fb39f32200f33a788efc9
	sha256sums = 1cfbc0f7388e2be1e9a4385d5d0310fabf28e930ad4c0fc8ff17d82795e98140
	sha256sums = 5593469af684d71870cc6d41678ac2201879617f0538cc5c947fc990cb057c30

pkgname = waywallen-display
	pkgdesc = Desktop integration for the waywallen wallpaper daemon.
	optdepends = libglvnd: EGL backend
	optdepends = vulkan-icd-loader: Vulkan backend
	optdepends = qt6-base: The qml plugin
	optdepends = qt6-declarative: The qml plugin
	optdepends = gtk4: The gobject plugin
	optdepends = graphene: The gobject plugin

pkgname = plasma-wallpaper-waywallen
	pkgdesc = Plasma 6 Wallpaper plugin for waywallen.
	arch = any
	depends = waywallen-display
	depends = qt6-base
	depends = qt6-declarative
	depends = libplasma
	depends = kirigami
	depends = plasma-workspace

pkgname = gnome-shell-extension-waywallen
	pkgdesc = GNOME extension for waywallen.
	arch = any
	depends = waywallen-display
	depends = gtk4
	depends = graphene
	depends = dconf
	depends = gnome-shell
