pkgbase = fastsapp
	pkgdesc = Fast native WhatsApp client built with Rust and egui
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/crmne/fastsapp
	install = fastsapp.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = libglvnd
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	optdepends = libxkbcommon-x11: keyboard handling in X11 sessions
	optdepends = noto-fonts-emoji: colour emoji in messages and reactions
	optdepends = ffmpeg: playing GIFs
	optdepends = xdg-desktop-portal: the file picker for attachments
	conflicts = fastsapp-bin
	conflicts = fastsapp-git
	options = !debug
	options = !lto
	source = fastsapp-0.2.0.tar.gz::https://github.com/crmne/fastsapp/archive/refs/tags/v0.2.0.tar.gz
