pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.61
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.61-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.61-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.61-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.6.61-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.6.61-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.6.61-1-x86_64.pkg.tar.zst
	sha256sums = 1f54e6e09d7d3bd6a039201d18f57da0ea7dd7df8d98a3aa1969dec73632c9f1
	sha256sums = e7ffb730813b65b16c4b1e813ca459ec13e4a88535f30b7848919941622f035a
	sha256sums = 9bcb101354e76562352652b5183c4f3ef8e1c6660d5aadfc2cbbf2e9e3305332

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.6.61-1-lts-bin
	depends = linux6.6.61-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.6.61-1-lts-headers-bin
	depends = linux6.6.61-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.6.61-1-lts-docs-bin
	depends = linux6.6.61-1-lts-docs-bin

pkgname = linux6.6.61-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.6.61-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.6.61-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.6.61-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.6.61-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.6.61-1-lts
	conflicts = linux-lts-docs
