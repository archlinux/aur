pkgbase = ionix-link-git
	pkgdesc = Ionix Link desktop daemon: pair a phone for notifications, media, commands and remote input (git)
	pkgver = r10.580e4ca
	pkgrel = 1
	url = https://github.com/LucasionGS/ionix-link
	arch = any
	license = MIT
	makedepends = git
	depends = python
	depends = openssl
	depends = systemd
	optdepends = qrencode: show the pairing QR code in the terminal
	optdepends = libnotify: confirm a pairing by code from a desktop notification
	optdepends = playerctl: media remote
	optdepends = wireplumber: volume control (wpctl)
	optdepends = libpulse: instant volume updates (pactl subscribe)
	optdepends = wl-clipboard: clipboard push and pull
	optdepends = wtype: typing from the phone keyboard
	optdepends = grim: screen view
	optdepends = wf-recorder: video in the screen view (H.264)
	optdepends = hyprland: list monitors for the screen view
	optdepends = wlr-randr: list monitors on other wlroots compositors
	optdepends = imagemagick: cover art and the wallpaper on the phone (ffmpeg works too)
	optdepends = xdg-utils: open shared links and files, and find the download folder
	provides = ionix-link
	conflicts = ionix-link
	source = ionix-link::git+https://github.com/LucasionGS/ionix-link.git
	sha256sums = SKIP

pkgname = ionix-link-git
