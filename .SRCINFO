	source = accelerator.ini
	source = acc_version.ini
	source = fake_product_name
	source = fake_os_release
	source = fake_version
	source = ensure-wlan0.sh
	source = run.sh
	source = sslh-guard.cfg
	source = device.conf
	source = mirror.conf.example
	source = leigod.conf
