	optdepends = xdg-desktop-portal-gnome: portal backend for GNOME
	optdepends = xdg-desktop-portal-kde: portal backend for KDE Plasma (KWin ScreenShot2)
	optdepends = xdg-desktop-portal-hyprland: portal backend for Hyprland
	optdepends = xdg-desktop-portal-wlr: portal backend for wlroots compositors (Sway)
	optdepends = vulkan-driver: Vulkan implementation for the GPU-accelerated overlay
	optdepends = gnome-shell-extension-appindicator: system tray icon under GNOME
