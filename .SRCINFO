pkgbase = viewport-wpe-git
	pkgdesc = Wayland compositor whose entire shell is a web page — the Smithay rewrite (git)
	pkgver = 0.1.8.r167.gff59517
	pkgrel = 1
	url = https://github.com/codebam/viewport
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = rust
