pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.45
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.45-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.45-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.45-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.45-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.45-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.45-1-x86_64.pkg.tar.zst
	sha256sums = 8401e89a33144f3fd75cca32026b36e7393d68c6ec2dad3d34f2258f3a087ff7
	sha256sums = 5a1585e6f108297e0576fe255a44a7e9e3b60edec79f28737fe2794c4101b436
	sha256sums = 4d89ff9bab7d07b421c5aae291c5ec16dc69a8a2f4fc12611bd4200b093a58eb

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.45-1-lts-bin
	depends = linux6.12.45-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.45-1-lts-headers-bin
	depends = linux6.12.45-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.45-1-lts-docs-bin
	depends = linux6.12.45-1-lts-docs-bin

pkgname = linux6.12.45-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.45-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.45-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.45-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.45-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.45-1-lts
	conflicts = linux-lts-docs
