pkgbase = repo-notes-git
	pkgdesc = Standalone CLI and MCP server for repo-scoped Markdown notes (git version)
	pkgver = 0.1.0.r29.gbca0eb4
	pkgrel = 1
	url = https://github.com/timmo001/notes
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	makedepends = git
	makedepends = bun
	depends = glibc
	depends = git
	provides = repo-notes
	conflicts = repo-notes
	conflicts = repo-notes-bin
	options = !strip
	source = repo-notes-git::git+https://github.com/timmo001/notes.git
	md5sums = SKIP

pkgname = repo-notes-git
