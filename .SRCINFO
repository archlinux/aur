pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.34
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.34-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.34-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.34-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.34-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.34-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.34-1-x86_64.pkg.tar.zst
	sha256sums = 613ce3005a9763d0029d445ad33c9a7bbdb4a0a0625c13048bbfd834dc10e907
	sha256sums = 9f1c4119e1892d43fa8270eb215ef7759d2b3d67f4abc6716ff1b8a7982a5d3a
	sha256sums = 67c788cf89b0f18f4c09d078edea955952b81e524e1fe7304a547d5e6111b4c6

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.34-1-lts-bin
	depends = linux6.12.34-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.34-1-lts-headers-bin
	depends = linux6.12.34-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.34-1-lts-docs-bin
	depends = linux6.12.34-1-lts-docs-bin

pkgname = linux6.12.34-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.34-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.34-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.34-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.34-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.34-1-lts
	conflicts = linux-lts-docs
