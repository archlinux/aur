pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.23
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.23-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.23-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.23-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-6.6.23-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-headers-6.6.23-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-docs-6.6.23-1-x86_64.pkg.tar.zst
	sha256sums = 6dc9a2a38221858da72f22e7de31d6d0789c36143a1b7d6a194479bebcb45f52
	sha256sums = 0ae9ff18b82ff3d67a66a95ac8b41992918b2ab19c238163e5e310dcdd43140c
	sha256sums = f019d36b56e89482e816b758a84919627a678990e6350cf00121550bee6d0616

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.6.23-1-lts-bin
	depends = linux6.6.23-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.6.23-1-lts-headers-bin
	depends = linux6.6.23-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.6.23-1-lts-docs-bin
	depends = linux6.6.23-1-lts-docs-bin

pkgname = linux6.6.23-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.6.23-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.6.23-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.6.23-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.6.23-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.6.23-1-lts
	conflicts = linux-lts-docs
