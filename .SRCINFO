	optdepends = rate-mirrors: Artix mirror rating
	optdepends = alacritty: run external commands in a terminal
	optdepends = kitty: run external commands in a terminal
	optdepends = ghostty: run external commands in a terminal
	optdepends = xterm: run external commands in a terminal
	optdepends = gnome-terminal: run external commands in a terminal
	optdepends = konsole: run external commands in a terminal
	optdepends = xfce4-terminal: run external commands in a terminal
