pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.48
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.48-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.48-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.48-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.48-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.48-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.48-1-x86_64.pkg.tar.zst
	sha256sums = ffef80b270d0847cc6f7977ddfb391cb4b268ea6140a70b297eaf50f8e7404bb
	sha256sums = d3b24034d02c1e3eaf3182eac42cb34c358184f879dc669154b70ab2e7e72d2d
	sha256sums = c4a85667c25d42f8d3e35e7822e74ef1cd07dfde7ca40b6d8c3d1b8ee7de4f5b

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.48-1-lts-bin
	depends = linux6.18.48-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.48-1-lts-headers-bin
	depends = linux6.18.48-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.48-1-lts-docs-bin
	depends = linux6.18.48-1-lts-docs-bin

pkgname = linux6.18.48-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.48-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.48-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.48-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.48-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.48-1-lts
	conflicts = linux-lts-docs
