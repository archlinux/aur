pkgname = bacularis-common
	pkgdesc = Shared Bacularis application shell, libraries, assets and state paths
	depends = php
	optdepends = php-fpm: FastCGI backend for web servers
	optdepends = nginx: use the provided example virtual host

pkgname = bacularis-web
	pkgdesc = Bacularis Web frontend (can run without local Bacula)
	depends = bacularis-common=7.0.0-2
	optdepends = php-fpm: PHP FastCGI backend

pkgname = bacularis-api
	pkgdesc = Bacularis REST API and local Bacula integration with scoped sudoers
	install = bacularis-api.install
	depends = bacularis-common=7.0.0-2
	depends = sudo
	optdepends = bacula-console: bconsole access to Bacula Director
	optdepends = php-pgsql: connect to PostgreSQL Bacula catalog
	optdepends = php-fpm: PHP FastCGI backend

pkgname = bacularis
	pkgdesc = Bacularis Web and API together (metapackage)
	depends = bacularis-common=7.0.0-2
	depends = bacularis-web=7.0.0-2
	depends = bacularis-api=7.0.0-2
