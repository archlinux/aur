pkgbase = chatwithwork-desktop
	pkgdesc = Chat with Work Desktop: the desktop app, terminal interface and background agent
	pkgver = 0.7.0
	pkgrel = 1
	url = https://github.com/crmne/chatwithwork-desktop
	install = chatwithwork-desktop.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	makedepends = pkgconf
	makedepends = cmake
	makedepends = clang
	depends = alsa-lib
	depends = libpipewire
	depends = glibc
	depends = gcc-libs
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libayatana-appindicator
	depends = dbus
	optdepends = org.freedesktop.secrets: store the device key in your keyring
	optdepends = xdg-desktop-portal: native folder picker
	optdepends = sane: scan with a USB scanner
	optdepends = tesseract: make scans searchable (with tesseract-data-<language>)
	optdepends = systemd: start the agent now and at login with cww daemon install
	provides = cww
	provides = cww-app
	conflicts = cww
	conflicts = chatwithwork-desktop-bin
	conflicts = chatwithwork-desktop-git
	options = !debug
	options = !lto
