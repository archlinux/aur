pkgbase = libfronius
	pkgver = 1.4.0
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.4.0::git+https://github.com/ahpohl/libfronius.git#tag=v1.4.0
	sha256sums = a4d0620db92f047d7dd4f86942ba76aab2629aed7f046523fc84c5892a3ac06d

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters and meters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
