	source = 0009-Fix-dependency-of-xcb-image-on-xcb-util.patch
	source = 0010-Allow-using-properties-of-PkgConfig-targets-for-glib.patch
	source = 0011-Allow-using-properties-of-PkgConfig-targets-for-Wayl.patch
	source = 0012-Allow-overriding-preference-for-shared-libzstd-libra.patch
	source = 0013-Workaround-Unknown-CMake-command-_qt_test_emscripten.patch
	source = 0014-Fix-configuration-when-EMSCRIPTEN_ROOT-is-an-absolut.patch
	source = 0015-Allow-keeping-Android-app-in-background-with-QtQuick.patch
	source = 0016-Allow-configuring-use-of-OpenSSL-in-QPasswordDigesto.patch
	source = 0017-Workaround-linker-error-about-missing-symbol-__sync_.patch
	source = 0018-Fix-Android-build-after-ec2e3e7ac92d000e0df0c693b9a6.patch
	source = 0019-Fix-inclusion-of-OpenGL-header-after-Qt-6-header.patch
	source = 0020-Use-a-more-reasonable-fallback-directory-for-fonts-o.patch
	source = 0021-Undefine-mingw-stat.patch
	source = 0022-Export-some-constexpr-variables.patch
	source = 0023-Android-implement-system-locale-in-QtCore-directly.patch
	source = 0024-Android-refresh-QLocale-system-on-OS-language-change.patch
