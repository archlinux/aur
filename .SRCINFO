pkgbase = wine-gohryt-wayland-wow64
	pkgdesc = Compatibility layer for running Windows programs. This is my custom build with special fixes for wayland, vulkan and wow64. No steam flickering, Unreal and Unity games are working properly without shaman dances. Now with gamepad and affinity design suite support.
	pkgver = 11.14
	pkgrel = 2
	url = https://www.winehq.org
	install = wine.install
	arch = x86_64
	license = LGPL-2.1-or-later
	makedepends = alsa-lib
	makedepends = dbus
	makedepends = ffmpeg
	makedepends = git
	makedepends = gnutls
	makedepends = gst-plugins-base-libs
	makedepends = libpulse
	makedepends = mesa
	makedepends = mingw-w64-gcc
	makedepends = sdl2
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	depends = desktop-file-utils
	depends = fontconfig
	depends = freetype2
	depends = gettext
	depends = glib2
	depends = glibc
	depends = libgcc
	depends = libpcap
	depends = libunwind
	depends = libxkbcommon
	depends = systemd-libs
	depends = wayland
	optdepends = alsa-lib: ALSA audio driver
	optdepends = alsa-plugins: ALSA audio plugins
	optdepends = dbus: system tray icons (StatusNotifierItem)
	optdepends = ffmpeg: WMA decoding (winedmo)
	optdepends = gnutls: TLS/SSL support (strongly recommended)
	optdepends = gst-plugins-bad: extra media codecs
	optdepends = gst-plugins-base: media playback
	optdepends = gst-plugins-base-libs: GStreamer media support
	optdepends = gst-plugins-good: extra media codecs
	optdepends = gst-plugins-ugly: extra media codecs
	optdepends = libpulse: PulseAudio/PipeWire audio driver
	optdepends = sdl2: game controller support
	optdepends = vulkan-icd-loader: Vulkan support
	provides = wine=11.14
	provides = wine-mono=11.2.0
	provides = wine-gecko=2.47.4
	conflicts = wine
	conflicts = wine-staging
	conflicts = wine-mono
	conflicts = wine-gecko
	noextract = wine-mono-11.2.0-x86.tar.xz
	noextract = wine-gecko-2.47.4-x86.tar.xz
	noextract = wine-gecko-2.47.4-x86_64.tar.xz
	options = lto
	options = !debug
	source = git+https://gitlab.winehq.org/gohryt/wine.git#branch=wayland-wow64
	source = https://dl.winehq.org/wine/wine-mono/11.2.0/wine-mono-11.2.0-x86.tar.xz
	source = https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86.tar.xz
	source = https://dl.winehq.org/wine/wine-gecko/2.47.4/wine-gecko-2.47.4-x86_64.tar.xz
	source = 30-win32-aliases.conf
	source = wine-binfmt.conf
	source = ntsync.conf
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP

pkgname = wine-gohryt-wayland-wow64
