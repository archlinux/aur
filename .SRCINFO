	optdepends = pulseaudio: audio playback and recording via PulseAudio
	optdepends = wayland: native Wayland display support
	optdepends = libx11: X11 and XWayland display support
	optdepends = libxcursor: X11 cursor handling
	optdepends = libxi: X11 input handling
	optdepends = libxrandr: X11 display resolution handling
	optdepends = libglvnd: GPU rendering through EGL
	optdepends = mesa: GPU rendering through EGL
	optdepends = vulkan-driver: GPU rendering through Vulkan
	optdepends = xdg-desktop-portal: native desktop integration and file dialogs
	optdepends = cups: printing support
