pkgbase = appvol
	pkgver = 0.8.1
	pkgrel = 1
	url = https://github.com/YaBulochka/appvol
	arch = any
	license = MIT
	source = https://github.com/YaBulochka/appvol/releases/download/v0.8.1/appvol-0.8.1.tar.gz
	sha256sums = 76422db1471629c772523c9168e7ead629c4491e9cd9a8b33241a0ccc5ff8793

pkgname = appvol
	pkgdesc = Volume control for the audio streams of the focused window (KDE Plasma 6 on Wayland)
	install = appvol.install
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = python-pulsectl
	optdepends = plasma-desktop: the Plasma session the daemon drives (KWin script, OSD, shortcuts)
	optdepends = kwin: loads the script that reports the focused window
	optdepends = kglobalacceld: binds the hotkeys in System Settings -> Shortcuts
	optdepends = pipewire-pulse: the audio server the daemon talks to
	optdepends = appvol-gui: the window for the profiles

pkgname = appvol-gui
	pkgdesc = Qt-based configurator for appvol (PySide6 and Kirigami)
	depends = appvol
	depends = pyside6
	depends = kirigami
	depends = qqc2-desktop-style
	depends = breeze-icons
	optdepends = plasma-desktop: the desktop whose shortcut dialog the window opens
