pkgbase = zapfast-git
	pkgdesc = Fast native WhatsApp client built with Rust and egui
	pkgver = 0.13.0.r0.e6bddc9
	pkgrel = 1
	url = https://zapfast.rocks
	install = zapfast-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	depends = alsa-lib
	depends = libglvnd
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	optdepends = libxkbcommon-x11: keyboard handling in X11 sessions
	optdepends = noto-fonts-emoji: colour emoji in messages and reactions
	optdepends = xdg-desktop-portal: the file picker for attachments
	provides = zapfast
	provides = fastsapp
	conflicts = zapfast
	conflicts = zapfast-bin
	conflicts = fastsapp
	conflicts = fastsapp-bin
	conflicts = fastsapp-git
	replaces = fastsapp-git
	options = !debug
	options = !lto
	source = zapfast-git::git+https://github.com/crmne/zapfast.git
	sha256sums = SKIP

pkgname = zapfast-git
