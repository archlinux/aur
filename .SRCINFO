pkgbase = pinky-bin
	pkgdesc = Let AI agents use an Android phone or iPhone, with you approving the risky steps: drives the phone over MCP, records every run, and brings its own adb
	pkgver = 2026.1125.7
	pkgrel = 1
	url = https://github.com/DIYgod/pinky
	arch = x86_64
	license = Apache-2.0
	depends = glibc
	depends = gtk3
	depends = dbus
	optdepends = android-udev: open an Android phone over USB without root
	optdepends = usbmuxd: open an iPhone or iPad over USB
	optdepends = libsecret: save the phone PIN in your keyring
	optdepends = libayatana-appindicator: show Pinky in the system tray
	optdepends = gtk-layer-shell: place the window through the compositor layer shell
	optdepends = libva: decode the phone screen stream on the GPU
	optdepends = webkit2gtk-4.1: show HTML pages, such as an exported run report
	optdepends = xdg-utils: open a link from the phone in your browser
