pkgbase = grabit-bin
	pkgdesc = Screenshot, screen-recording, OCR, and uploader for wlroots and KDE Plasma 6 Wayland compositors (prebuilt binary)
	pkgver = 0.9.0
	pkgrel = 2
	url = https://heliopolis.live/creations/grabit
	arch = x86_64
	license = AGPL-3.0-or-later
	depends = cairo
	depends = curl
	depends = dbus
	depends = file
	depends = json-c
	depends = libpng
	depends = libxkbcommon
	depends = wayland
	optdepends = ffmpeg: --record support, and video thumbnails and playback in the settings history
	optdepends = tesseract: --tesseract (OCR) support
	optdepends = tesseract-data-eng: english OCR data
	optdepends = translate-shell: --translate (OCR -> translated text) support
	optdepends = xdg-utils: open links, files and folders from previews, pins, history and settings
	optdepends = pipewire: pw-play (default shutter-sound player)
	optdepends = libpulse: paplay (alternative sound player)
	optdepends = alsa-utils: aplay (alternative sound player)
	optdepends = sox: play (alternative sound player)
	provides = grabit=0.9.0
	conflicts = grabit
	conflicts = grabit-git
	options = !debug
