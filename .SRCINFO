pkgbase = ruroco
	pkgdesc = Run Remote Command — encrypted, one-way UDP remote command execution
	pkgver = 0.14.1
	pkgrel = 1
	url = https://github.com/beac0n/ruroco
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = openssl
	makedepends = gcc-libs
	makedepends = fontconfig
	makedepends = libglvnd
	makedepends = libxkbcommon
	makedepends = wayland
	makedepends = libx11
	makedepends = libxi
	makedepends = libxcursor
	makedepends = libxrandr
	options = !lto
	source = ruroco-0.14.1.tar.gz::https://github.com/beac0n/ruroco/archive/refs/tags/v0.14.1.tar.gz
	source = ruroco.sysusers
	sha256sums = 3236dc6ccb73af6fc58b8f43f01a32594550a82dddf896554a0be41ce88acfa3
	sha256sums = e0899988bf07d43f878b813c47e510924f1705fa61fc88ff47913c7c5eae2f6f

pkgname = ruroco-client
	pkgdesc = ruroco client CLI — sends the encrypted UDP packets
	depends = openssl
	depends = gcc-libs
	depends = glibc

pkgname = ruroco-client-ui
	pkgdesc = ruroco client GUI (egui) — graphical front-end for ruroco-client
	depends = openssl
	depends = gcc-libs
	depends = glibc
	depends = fontconfig
	depends = libglvnd
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxi
	depends = libxcursor
	depends = libxrandr

pkgname = ruroco-server
	pkgdesc = ruroco server + commander — validates packets and runs configured commands
	install = ruroco-server.install
	depends = openssl
	depends = gcc-libs
	depends = glibc
	backup = etc/ruroco/config.toml
