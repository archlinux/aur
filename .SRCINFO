pkgbase = live-photo-conv
	pkgdesc = A cross-platform tool to process live photos of Google Android
	pkgver = 0.1.11
	pkgrel = 1
	url = https://github.com/wszqkzqk/live-photo-conv
	arch = x86_64
	arch = aarch64
	arch = riscv64
	arch = loong64
	license = LGPL-2.1-or-later
