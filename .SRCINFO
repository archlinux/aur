pkgbase = mascot
	pkgdesc = Shimeji-style desktop mascots for Wayland that you can talk to (a chat bubble for local or hosted language models)
	pkgver = 0.8.1
	pkgrel = 1
	url = https://github.com/HexRebel/mascot
	install = mascot.install
	arch = x86_64
	license = GPL-2.0-or-later
	license = CC0-1.0
	license = LicenseRef-Shimeji
	makedepends = git
	makedepends = wayland-protocols
	makedepends = uthash
	depends = wayland
	depends = libarchive
	depends = python
	depends = python-pillow
	depends = quickshell
	depends = aichat
	optdepends = ollama: local language models
	optdepends = curl: keep a local model loaded while the bubble is open
	optdepends = ttf-nerd-fonts-symbols: the icons in the chat bubble
	optdepends = xdg-utils: mascot prototypes poses opens its page in the browser
	source = mascot::git+https://github.com/HexRebel/mascot.git#tag=v0.8.1
