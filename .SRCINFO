pkgbase = libfronius
	pkgver = 1.3.3
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.3.3::git+https://github.com/ahpohl/libfronius.git#tag=v1.3.3
	sha256sums = 2ab9daf5944712057afbda779afe1faca4c4a9cba9b570e9419159fb29235fd4

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters and meters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
