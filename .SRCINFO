pkgbase = hornero-config
	pkgdesc = HorneroOS curated desktop defaults (compositor, terminal, GTK, fonts, XDG handlers)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/HorneroOS/config
	arch = any
	license = MIT
	makedepends = librsvg
	depends = bash
	depends = git
	depends = python
	optdepends = hyprland: compositor defaults under /etc/xdg/hypr
	optdepends = kitty: terminal defaults under /etc/xdg/kitty
	optdepends = gtk3: GTK 3 defaults under /etc/xdg/gtk-3.0
	optdepends = fontconfig: font defaults under /etc/xdg/fontconfig
	optdepends = fastfetch: system info defaults under /etc/xdg/fastfetch
	optdepends = btop: monitor defaults under /etc/xdg/btop
	optdepends = cava: visualizer defaults under /etc/xdg/cava
	optdepends = thunar: file manager defaults under /etc/xdg/Thunar
	optdepends = copyq: clipboard defaults under /etc/xdg/copyq
	optdepends = handlr: default-application handler under /etc/xdg/handlr
	optdepends = qt6ct: Qt6 platform-theme defaults under /etc/xdg/qt6ct
	optdepends = papirus-icon-theme: Papirus-Dark factory icons
	optdepends = orchis-theme: Orchis factory GTK themes
	optdepends = ttf-material-symbols-variable: Material Symbols shell icon font
	source = config::git+https://github.com/HorneroOS/config.git
	sha256sums = SKIP

pkgname = hornero-config
