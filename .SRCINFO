pkgbase = shorin-pac-git
	pkgdesc = Simple fzf-based TUI to install/remove pacman, AUR and Flatpak packages on Arch, with AI-assisted AUR review and leftover cleanup
	pkgver = r30.15f0004
	pkgrel = 1
	url = https://github.com/SHORiN-KiWATA/shorin-pac
	install = shorin-pac.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = bash
	depends = curl
	depends = fzf
	depends = jq
	depends = pacman
	optdepends = paru: preferred AUR helper
	optdepends = yay: fallback AUR helper (pac can install it for you)
	optdepends = flatpak: list and remove Flatpak apps in pacr
	optdepends = trash-cli: send leftovers to the trash instead of deleting
	optdepends = claude-code: AI backend via the claude CLI subscription
	optdepends = opencode: AI backend via the opencode CLI
	optdepends = miyu: AI backend via Miyu, and import of Miyu provider settings
	provides = shorin-pac
	conflicts = shorin-pac
	source = git+https://github.com/SHORiN-KiWATA/shorin-pac.git
	sha256sums = SKIP

pkgname = shorin-pac-git
