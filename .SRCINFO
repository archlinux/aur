pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.48
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.48-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.48-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.48-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.48-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.48-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.48-1-x86_64.pkg.tar.zst
	sha256sums = f302b35321ad963fecac916424035f7c20dc3fdf7a3a6f9936cb428fef0ff89b
	sha256sums = 4f1a307b1f0fc4a7f9c8fd515f782562e8649c77a9bb55bd6717fca8d8ba48db
	sha256sums = 20c71d81f046dc99eeb3e94ee201e39a7c85de2e98ccebc4129b8618d986f6f1

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.48-1-lts-bin
	depends = linux6.12.48-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.48-1-lts-headers-bin
	depends = linux6.12.48-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.48-1-lts-docs-bin
	depends = linux6.12.48-1-lts-docs-bin

pkgname = linux6.12.48-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.48-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.48-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.48-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.48-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.48-1-lts
	conflicts = linux-lts-docs
