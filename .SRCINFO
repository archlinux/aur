pkgbase = dank-niri-git
	pkgdesc = Complete niri desktop environment with DankMaterialShell, themes, and all dependencies
	pkgver = 0.0.1
	pkgrel = 4
	url = https://github.com/bbedward/DankMaterialShell
	arch = x86_64
	arch = aarch64
	license = GPL-3.0
	makedepends = git
	makedepends = clang
	makedepends = rust
	makedepends = makepkg-git-lfs-proto
	makedepends = git-lfs
	depends = dankmaterialshell-git
	depends = ghostty
	depends = matugen-bin
	depends = wl-clipboard
	depends = cliphist
	depends = cava
	depends = qt5ct
	depends = qt6ct
	depends = xdg-desktop-portal-gtk
	depends = xdg-desktop-portal-gnome
	depends = gnome-keyring
	depends = polkit-gnome
	depends = makepkg-git-lfs-proto
	depends = cairo
	depends = glib2
	depends = libdisplay-info
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = accountsservice
	depends = seatd
	provides = dank-niri
	provides = niri
	conflicts = dank-niri
	conflicts = niri
	conflicts = niri-git
	conflicts = niri-bin
	options = !debug
	options = !lto
	options = !strip
	backup = etc/xdg/kdeglobals
	backup = etc/xdg/ghostty/config
	source = niri::git-lfs+https://github.com/YaLTeR/niri.git
	source = niri-config.kdl
	source = ghostty-config
	source = kdeglobals
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = dank-niri-git
