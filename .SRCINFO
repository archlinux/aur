	optdepends = ffmpeg: read voice notes that are not WAV
	optdepends = python-openai-whisper: transcribe voice notes locally (the default command)
	optdepends = whisper-cpp: transcribe voice notes locally (whisper-cli)
	optdepends = libsecret: read the remote transcription API key from the keyring
	options = !lto
	options = !debug
