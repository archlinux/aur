	depends = python-forgekit>=0.10.0
	depends = python-gobject
	depends = wlsunset
	optdepends = sway: the desktop it is made for, with hypeForge (runs nightforge start at login)
	optdepends = alacritty: the tray menu's Open nightForge
	optdepends = libnotify: a message when the night light cannot start
