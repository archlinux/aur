pkgbase = makepkg-jail-local
	pkgdesc = Local bubblewrap makepkg sandbox with AppArmor and a restricted paru adapter
	pkgver = 0.2.0
	pkgrel = 1
	install = makepkg-jail-local.install
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = shellcheck
	makedepends = python
	makedepends = python-libseccomp
	depends = apparmor
	depends = base-devel
	depends = bash
	depends = bubblewrap
	depends = coreutils
	depends = gnupg
	depends = pacman
	depends = util-linux
	optdepends = paru: use the paru-makepkg-jail adapter
	optdepends = traur: pre-fetch trust scan hook
	options = !debug
	options = !strip
	backup = etc/apparmor.d/makepkg-jail-build
	backup = etc/apparmor.d/makepkg-jail-setup
	source = makepkg-jail
	source = paru-makepkg-jail
	source = gen-seccomp.py
	source = hook-traur
