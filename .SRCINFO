	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-7.0.9.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-7.0.9.zen2-1-x86_64.pkg.tar.zst
