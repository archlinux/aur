pkgbase = caribou
	pkgver = 0.4.22
	pkgrel = 2
	url = https://wiki.gnome.org/Projects/Caribou
	arch = x86_64
	license = LGPL
	makedepends = intltool
	makedepends = docbook-xsl
	makedepends = gobject-introspection
	makedepends = vala
	makedepends = git
	makedepends = gnome-common
	options = !emptydirs
	options = !debug
	source = git+https://github.com/nardholio/caribou.git#tag=0.4.22
	sha256sums = 5b4b43b546884560805eb94d841717e62155d0aab1941567a079119344dd4355

pkgname = caribou
	pkgdesc = A text entry and UI navigation application (on-screen keyboard)
	depends = at-spi2-atk
	depends = python-atspi
	depends = python-gobject
	depends = gtk3
	depends = libxklavier
	depends = libgee
	depends = clutter
	depends = dconf
	depends = libcaribou

pkgname = libcaribou
	pkgdesc = Input assistance library for caribou
	depends = gtk3
	depends = libxklavier
	depends = libgee
	depends = clutter
	provides = libcaribou.so
