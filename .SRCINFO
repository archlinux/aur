pkgbase = windinput-bin
	pkgdesc = 清风输入法，适用于 Fcitx5 的官方 Linux 预览版二进制包
	pkgver = 0.125.0
	pkgrel = 1
	url = https://windinput.com
	install = windinput.install
	arch = x86_64
	arch = aarch64
	license = MIT
	license = LGPL-3.0-only
	depends = bash
	depends = dbus
	depends = fcitx5>=5.0.14
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libxcb
	depends = libxkbcommon
	depends = procps-ng
	depends = python
	depends = wayland
	depends = xz
	optdepends = fcitx5-configtool: add WindInput to your input method group
	optdepends = fcitx5-gtk: input method support for GTK applications
	optdepends = fcitx5-qt: input method support for Qt applications
	optdepends = noto-fonts-cjk: Chinese text rendering, unless another CJK font is installed
	optdepends = noto-fonts-emoji: color emoji rendering
	optdepends = xclip: clipboard support on X11
	optdepends = wl-clipboard: clipboard support on Wayland
	optdepends = xdg-utils: open links and associated files
	optdepends = xdg-desktop-portal: file dialogs, requires a desktop-specific portal backend
	optdepends = zenity: fallback file dialogs
	provides = windinput=0.125.0
	conflicts = windinput
	options = !strip
	options = !debug
