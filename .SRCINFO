	optdepends = libglvnd: OpenGL support for zensmu-gui
	optdepends = libxkbcommon: keyboard support for zensmu-gui on Wayland/X11
	optdepends = wayland: native Wayland windowing for zensmu-gui
	optdepends = libxcb: X11 windowing for zensmu-gui
	provides = zensmu
	conflicts = zensmu
