	optdepends = swaybg: suggested Wayland wallpaper tool
	optdepends = swaylock: suggested Wayland screen locker
	optdepends = waybar: suggested Wayland bar
	optdepends = xdg-desktop-portal-gnome: required for screencasting
	optdepends = xdg-desktop-portal-gtk: fallback portal configured by tiri-portals.conf
	optdepends = xwayland-satellite: required for running X11 applications
