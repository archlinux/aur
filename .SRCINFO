pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux7.3.6.arch1-1-bin
	depends = linux7.3.6.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux7.3.6.arch1-1-headers-bin
	depends = linux7.3.6.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux7.3.6.arch1-1-docs-bin
	depends = linux7.3.6.arch1-1-docs-bin

pkgname = linux7.3.6.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 7.3.6-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux7.3.6.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 7.3.6-arch1-1
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-headers

pkgname = linux7.3.6.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 7.3.6-arch1-1
	conflicts = linux-docs
