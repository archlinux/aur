pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.52
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.52-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.52-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.52-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-6.6.52-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-headers-6.6.52-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-docs-6.6.52-1-x86_64.pkg.tar.zst
	sha256sums = 33eff3c34287619e641b1d4888d7614b3d5f25b4d75bc48219702fe85dcdefd6
	sha256sums = f60c7b885fa1639ad92a347e07eaa926de5b611ed064b20408448459175e01f3
	sha256sums = 96f8abad62fe42cc712cbffe7709680db330c70b7d79c370c3bd4b9e845086b8

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.6.52-1-lts-bin
	depends = linux6.6.52-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.6.52-1-lts-headers-bin
	depends = linux6.6.52-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.6.52-1-lts-docs-bin
	depends = linux6.6.52-1-lts-docs-bin

pkgname = linux6.6.52-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.6.52-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.6.52-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.6.52-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.6.52-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.6.52-1-lts
	conflicts = linux-lts-docs
