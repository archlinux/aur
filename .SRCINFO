pkgbase = go-sponge-git
	pkgdesc = Effortlessly build stable, reliable, and high-performance backend services with a "low-code" approach
	pkgver = 1.16.1.r0.gbeef9ee
	pkgrel = 1
	url = https://go-sponge.com
	arch = aarch64
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = go
	source = go-sponge::git+https://github.com/go-dev-frame/sponge.git
	sha256sums = SKIP

pkgname = go-sponge-git
	depends = glibc
	depends = go
	depends = protobuf
	depends = protoc-gen-doc
	depends = protoc-gen-go
	depends = protoc-gen-go-gin-git>=1.16.1.r0.gbeef9ee-1
	depends = protoc-gen-go-grpc
	depends = protoc-gen-go-rpc-tmpl-git>=1.16.1.r0.gbeef9ee-1
	depends = protoc-gen-gotag
	depends = protoc-gen-json-field-git>=1.16.1.r0.gbeef9ee-1
	depends = protoc-gen-openapiv2
	depends = protoc-gen-validate
	depends = swag
	provides = go-sponge=1.16.1
	conflicts = go-sponge
	replaces = sponge-git<=1.16.1.r0.gbeef9ee-1

pkgname = protoc-gen-go-gin-git
	pkgdesc = Protobuf plugin to generate Gin routes, handlers, RPC stubs, and error codes
	url = https://github.com/go-dev-frame/sponge/tree/main/cmd/protoc-gen-go-gin
	depends = glibc
	depends = protobuf
	depends = protoc-gen-go
	depends = protoc-gen-go-grpc
	provides = protoc-gen-go-gin=1.16.1
	conflicts = protoc-gen-go-gin

pkgname = protoc-gen-go-rpc-tmpl-git
	pkgdesc = Protobuf plugin to generate RPC service templates and RPC error codes
