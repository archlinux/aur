pkgbase = ionix-quickshell-git
	pkgdesc = Ionix Quickshell desktop shell — bar, popouts and OSD (git)
	pkgver = r28.7388d3c
	pkgrel = 1
	url = https://github.com/LucasionGS/ionix-quickshell
	arch = any
	license = MIT
	makedepends = git
	depends = quickshell
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-wayland
	depends = pipewire
	depends = wireplumber
	depends = networkmanager
	depends = bluez
	depends = bluez-utils
	depends = upower
	depends = polkit
	depends = python
	depends = libnotify
	optdepends = swaync: notification centre integration for the bell module
	optdepends = brightnessctl: backlight control and brightness OSD
	optdepends = pavucontrol: advanced audio settings from the audio popout
	optdepends = blueman: bluetooth manager GUI fallback
	optdepends = nm-connection-editor: advanced network settings from the network popout
	optdepends = hyprland: workspace, window and blur integration
	optdepends = hyprlock: lock action in the power menu
	optdepends = ioexplorer-git: application launcher target for the logo button
	optdepends = toxen-mini: Toxen music player integration
	optdepends = ttf-jetbrains-mono-nerd: the glyph font the bar is designed around
	optdepends = libsecret: keep the calendar sign-in token in the keyring instead of a file
	optdepends = gnome-keyring: a Secret Service for libsecret to store that token in
	optdepends = wl-clipboard: copy the calendar sign-in code from the popout
	optdepends = xdg-utils: open meeting links and the sign-in page in your browser
	provides = ionix-quickshell
	conflicts = ionix-quickshell
	source = ionix-quickshell::git+https://github.com/LucasionGS/ionix-quickshell.git
	sha256sums = SKIP

pkgname = ionix-quickshell-git
