pkgname = angie
	pkgdesc = Lightweight HTTP server and IMAP/POP3 proxy server, drop-in replacement for nginx
	depends = pcre2
	depends = zlib
	depends = openssl
	depends = geoip
	depends = mailcap
	depends = libxcrypt
	provides = nginx
	conflicts = nginx
	backup = etc/nginx/fastcgi.conf
	backup = etc/nginx/fastcgi_params
	backup = etc/nginx/koi-win
	backup = etc/nginx/koi-utf
	backup = etc/nginx/nginx.conf
	backup = etc/nginx/scgi_params
	backup = etc/nginx/uwsgi_params
	backup = etc/nginx/win-utf
	backup = etc/logrotate.d/nginx

pkgname = angie-src
	pkgdesc = Source code of angie 1.8.1, useful for building modules
	conflicts = nginx-src
