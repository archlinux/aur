pkgbase = sirikali-bin
	pkgdesc = A Qt/C++ GUI front end to sshfs, ecryptfs-simple, cryfs, gocryptfs, securefs, fscrypt and encfs
	pkgver = 1.8.1
	pkgrel = 1
	url = https://mhogomchungu.github.io/sirikali/
	arch = i686
	arch = x86_64
	license = GPL
	depends = qt5-base
	depends = libpwquality
	depends = hicolor-icon-theme
	optdepends = lxqt_wallet: use an external lxqt_wallet (must recompile)
	optdepends = libsecret: support for Gnome libsecret password storage (must recompile)
	optdepends = kwallet5: support for KDE wallet storage (must recompile)
	optdepends = cryfs: for CryFS backend
	optdepends = ecryptfs-simple: for eCryptfs backend
	optdepends = encfs: for EncFS backend
	optdepends = fscrypt: for fscrypt backend
	optdepends = gocryptfs: for gocryptfs backend
	optdepends = securefs: for securefs backend
	optdepends = sshfs: for SSHFS backend
