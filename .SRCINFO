pkgbase = glimpse-desktop-bin
	pkgdesc = Desktop shell suite for Wayland compositors: panel, wallpaper, lock screen and night light
	pkgver = 0.16.0
	pkgrel = 1
	url = https://github.com/alex-oleshkevich/glimpse
	arch = x86_64
	license = BSD-3-Clause
	depends = gtk4
	depends = libadwaita
	depends = gtk4-layer-shell
	depends = geoclue
	depends = libpulse
	depends = pam
	depends = glib2>=2.80
	optdepends = upower: battery level and peripheral charge
	optdepends = power-profiles-daemon: power modes in the battery popover
	optdepends = networkmanager: the network applet
	optdepends = bluez: the bluetooth applet
	optdepends = bluez-obex: receiving files over bluetooth
	optdepends = udisks2: the removable-media applet
	optdepends = cups: the printing applet
	optdepends = kdeconnect: the phone applet
	optdepends = ddcutil: its udev rule lets the brightness applet reach external displays
	optdepends = xdg-desktop-portal: routes app inhibit requests to glimpse-idle
	optdepends = libnotify: notifications from SDK applets
	optdepends = wl-clipboard: clipboard from SDK applets
	provides = glimpse-desktop
	conflicts = glimpse-desktop
	options = !debug
	backup = etc/geoclue/conf.d/glimpse.conf
	backup = etc/pam.d/glimpse-lock
	backup = etc/xdg-desktop-portal/glimpse-portals.conf
	backup = etc/xdg-desktop-portal/niri-portals.conf
	backup = etc/xdg-desktop-portal/hyprland-portals.conf
	source_x86_64 = glimpse-0.16.0-x86_64.tar.zst::https://github.com/alex-oleshkevich/glimpse/releases/download/v0.16.0/glimpse-0.16.0-x86_64.tar.zst
