	optdepends = intel-npu-driver: Intel Core Ultra NPU acceleration driver
	optdepends = openvino-intel-npu-plugin: Intel Core Ultra NPU OpenVINO plugin
	optdepends = python-openvino: OpenVINO Python runtime for NPU
