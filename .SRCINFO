pkgbase = linux-cachyos-jetm
	pkgdesc = CachyOS kernel tuned for Yocto/OE development on a desktop workstation rather than gaming
	pkgver = 7.3.1
	pkgrel = 1
	url = https://github.com/CachyOS/linux-cachyos
	arch = x86_64
