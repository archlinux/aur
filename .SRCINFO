pkgbase = mopytui-git
	pkgdesc = A feature-rich TUI client for Mopidy with cover art rendering
	pkgver = r1.0000000
	pkgrel = 1
	url = https://github.com/prietus/mopytui
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = rust
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
	optdepends = mopidy: server this client connects to
	optdepends = chafa: better halfblocks rendering on terminals without Kitty/iTerm2/Sixel
	provides = mopytui
	conflicts = mopytui
	conflicts = mopytui-bin
	options = !lto
	source = mopytui::git+https://github.com/prietus/mopytui.git
	sha256sums = SKIP

pkgname = mopytui-git
