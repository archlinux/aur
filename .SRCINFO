	sha256sums_x86_64 = 827dd53d5cfcaec440e81c5795d2575e610f9f5fc5f449523f569b88c2cdcfff
	source_aarch64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.2/gitcomet-v0.3.2-linux-arm64.tar.gz
	sha256sums_aarch64 = 8897d5a3fc327dc8803de71d9002f2623b859a38eaac8d9b36199d82f9e442c6

