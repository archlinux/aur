pkgbase = aur-security-auditor
	pkgdesc = Explainable security auditor for AUR packages and supply-chain risks
	pkgver = 1.4.7
	pkgrel = 1
	url = https://altbox.de/
	arch = any
	license = GPL-3.0-or-later
