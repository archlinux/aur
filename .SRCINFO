pkgbase = liney-bin
	pkgdesc = Unofficial LINE desktop client for Linux, packaged from the upstream Liney release
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/Cytech-Team/Liney
	arch = x86_64
	license = LicenseRef-TLL-1.0
