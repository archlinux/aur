pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.17.1.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.17.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.17.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.17.1.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.17.1.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.17.1.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.17.1.arch1-1-x86_64.pkg.tar.zst
	sha256sums = fc84050ebc4ba2c8d06eaf9a0bb9caf9ec4e23c36bed3753cb2271d3f2bf81a0
	sha256sums = 3c4ed806680b6dd1aca00e8f867dea3b012174e32f117b3caec41d0d8dcea8c5
	sha256sums = 679f7d86165f086209f24e7badeb183f1bbef955ed6f078425286339b18a8782

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.17.1.arch1-1-bin
	depends = linux6.17.1.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.17.1.arch1-1-headers-bin
	depends = linux6.17.1.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.17.1.arch1-1-docs-bin
	depends = linux6.17.1.arch1-1-docs-bin

pkgname = linux6.17.1.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.17.1-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.17.1.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.17.1-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.17.1.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.17.1-arch1-1
	conflicts = linux-docs
