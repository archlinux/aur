pkgbase = rusty-inbox
	pkgdesc = Fast, native email client with a Rust engine, a Qt 6/QML interface and an optional AI assistant
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/karem505/rusty-inbox
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	depends = ca-certificates
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = qt6-webengine
	optdepends = ollama: run the AI assistant locally
	optdepends = xdg-utils: open links and set Rusty Inbox as the mailto handler
	options = !lto
