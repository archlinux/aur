pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.8.7.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.8.7.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.8.7.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.8.7.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-6.8.7.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.8.7.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.8.7.arch1-1-x86_64.pkg.tar.zst
	sha256sums = ebc051bfd8de0e731e692cee987048dca3ffbfe656c53af4c291cd9f2a1fd1c9
	sha256sums = f6fadff98204456c4701dae88ea143822773c11d28184e9182a46d2db2f28738
