pkgbase = archcanary
	pkgdesc = Layered security detection stack for Arch Linux — malicious AUR packages, systemd/eBPF persistence, npm/bun cache poisoning, kernel module tampering
	pkgver = 0.1.41
	pkgrel = 2
	url = https://github.com/musqz/archcanary
	install = archcanary.install
	arch = any
	license = GPL-3.0-only
	depends = bash
	depends = pacman
	optdepends = libnotify: desktop alerts on infected scan result
	optdepends = polkit: privileged remediation commands (allowlist edits, audit-rules/lynis-config writes)
	optdepends = bpf: bpftool for eBPF rootkit detection
	optdepends = audit: auditd records which AUR builds ran, appended to last-scan.log by the system scan service
	optdepends = yay: AUR helper with Lua hook support
	optdepends = paru: AUR helper with PreBuildCommand hook support
	optdepends = bash-completion: tab-completion for archcanary/canary flags
	backup = etc/archcanary/dkms_allowlist.conf
	backup = etc/archcanary/systemd_allowlist.conf
	backup = etc/archcanary/bpftool_allowlist.conf
	backup = etc/archcanary/autostart_allowlist.conf
	backup = etc/archcanary/package_allowlist.conf
	source = archcanary-0.1.41.tar.gz::https://github.com/musqz/archcanary/archive/v0.1.41.tar.gz
