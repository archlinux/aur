pkgbase = tscsync
	pkgdesc = Pre-boot TSC sync for AMD (UEFI) so Linux keeps the TSC clocksource
	pkgver = 2.2.2
	pkgrel = 1
	url = https://github.com/Zanasin/tscsync
	install = tscsync.install
	arch = x86_64
	license = MIT
	makedepends = curl
	makedepends = binutils
	makedepends = gcc
	makedepends = make
	depends = bash
	depends = util-linux
	depends = systemd
	optdepends = sbsigntools: sign the EFI binary during tscsync-setup (needed if Secure Boot is on)
	optdepends = sbctl: enroll/sign with your Secure Boot keys
	optdepends = mokutil: detect Secure Boot / MOK state during setup
	conflicts = tscsync-git
	options = !strip
	options = !lto
	source = tscsync-2.2.2.tar.gz::https://github.com/Zanasin/tscsync/archive/refs/tags/v2.2.2.tar.gz
	source = 0001-arch-usr-paths.patch
	sha256sums = b37e81e3a99eb9038e41522fa868022b5b6759c9ba84639cc5b874bbb0fb542e
	sha256sums = c220ba2b09414a4b6099ced814e11c0b1f524abe7eaeb6824476974430e80f65

pkgname = tscsync
