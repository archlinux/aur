pkgbase = radiance-inference-git
	pkgdesc = C++20 LLM inference server for AMD GPUs (primarily gfx1201) with OpenAI-compatible HTTP API (git HEAD)
	pkgver = 1.6.0.r0
	pkgrel = 1
	url = https://codeberg.org/StillDeadcode/radiance
	arch = x86_64
	license = Apache-2.0
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	depends = gcc-libs
	depends = glibc
	depends = ffmpeg
	depends = rocm-gfx120x-bin
	provides = radiance-inference
	conflicts = radiance-inference
	options = !lto
	options = !debug
	backup = etc/radiance/radiance.conf
	source = radiance-inference::git+https://codeberg.org/StillDeadcode/radiance.git#branch=main
	sha256sums = SKIP

pkgname = radiance-inference-git
