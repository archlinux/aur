pkgbase = coolvlviewer-bin
	pkgdesc = A third-party viewer for Second Life and OpenSim grids.
	pkgver = 1.32.2.14
	pkgrel = 1
	url = http://sldev.free.fr
	install = coolvlviewer.install
	arch = x86_64
	license = GPL-2.0-only
	depends = apr-util
	depends = atk
	depends = gconf
	depends = glib2>=2.32
	depends = glu
	depends = lib32-libidn
	depends = lib32-libsndfile
	depends = lib32-util-linux
	depends = lib32-zlib
	depends = libcups
	depends = libgl
	depends = libgl
	depends = libidn
	depends = libxcomposite
	depends = libxcursor
	depends = libxrandr
	depends = libxss
	depends = libxtst
	depends = mesa
	depends = pangox-compat
	depends = sdl
	optdepends = alsa-lib: for ALSA support
	optdepends = gst-plugins-bad: for video support
	optdepends = gst-plugins-good: for video support
	optdepends = gst-plugins-ugly: for video support
	optdepends = lib32-alsa-lib: for ALSA support
	optdepends = lib32-freealut: for OpenAL support
	optdepends = lib32-libidn11: for voice support
	optdepends = libpulse: for PulseAudio support
	optdepends = nvidia-utils: for NVIDIA support
	optdepends = pepper-flash: for inworld Flash support
	optdepends = wine: for SLVoice support
