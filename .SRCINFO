pkgbase = xzram
	pkgdesc = Cross-distro Linux swap management (zram, swap files, sysctl tuning)
	pkgver = 0.7.3
	pkgrel = 1
	url = https://github.com/asafelobotomy/XZram
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	makedepends = cmake
	makedepends = qt6-base
	makedepends = polkit
	makedepends = systemd
	makedepends = util-linux
	source = XZram-0.7.3.tar.gz::https://github.com/asafelobotomy/XZram/archive/refs/tags/v0.7.3.tar.gz
	sha256sums = e312b9557f209bcab3dae058d36c05f0540e22fc09d196084d5ea70c5c380196

pkgname = xzram
	pkgdesc = CLI, helper, and D-Bus daemon for Linux swap management
	install = xzram.install
	depends = polkit
	depends = systemd
	depends = util-linux
	optdepends = zram-generator: zram swap via zram-generator
	optdepends = btrfs-progs: swapfiles on btrfs
	optdepends = xzram-gui: Qt6 desktop GUI
	optdepends = uq: the Memory and swap page in uQ Settings

pkgname = xzram-gui
	pkgdesc = Qt6 GUI for XZram swap management
	depends = xzram
	depends = qt6-base
	depends = hicolor-icon-theme
