pkgbase = prostir-bin
	pkgdesc = Extra KDE Plasma 6 and Hyprland monitors in a Meta Quest 3 or 3S headset (PC part)
	pkgver = 0.1.1
	pkgrel = 1
	url = https://prostir.ishawyha.dev
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = gstreamer
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gst-plugins-bad-libs
	depends = gst-plugin-va
	depends = gst-plugin-pipewire
	depends = pipewire
	depends = pipewire-audio
	depends = pulse-native-provider
	depends = libpulse
	depends = mesa
	depends = curl
	optdepends = gst-plugins-ugly: encoding on the CPU with x264 (NVIDIA, or no VA-API encoder)
	optdepends = intel-media-driver: hardware encoding on Intel graphics
	optdepends = libkscreen: arranging the monitors on KDE Plasma (kscreen-doctor)
	optdepends = qt6-tools: matching wallpapers on every monitor on KDE Plasma (qdbus6)
	optdepends = kdialog: the pairing dialog (or zenity, fuzzel, wofi, rofi)
	optdepends = zenity: the pairing dialog (or kdialog, fuzzel, wofi, rofi)
	optdepends = libnotify: notifications
	optdepends = grim: screenshots on Hyprland
	optdepends = spectacle: whole-desktop screenshots on KDE when a monitor cannot be captured
	optdepends = android-tools: connecting the headset over USB (developer mode)
	provides = prostir
	conflicts = prostir
	source = https://github.com/OlexiyOdarchuk/prostir/releases/download/v0.1.1/prostir-0.1.1-x86_64-linux.tar.gz
	sha256sums = ef5466873ab95c72f4ba2e7196dce89499a6fe17d8cfddcf89b357c3611889fe

pkgname = prostir-bin
