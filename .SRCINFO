pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.10.8.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.10.8.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.10.8.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.10.8.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-6.10.8.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.10.8.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.10.8.arch1-1-x86_64.pkg.tar.zst
	sha256sums = 0423349dc70fae6cb58f763960e85508cd7df28f9cd651e0a0dd70aa0b8a004d
	sha256sums = 349d2d341ff0bdb19acf7e8eaeabe0d25b42befd736edd1d59453167fb3136e4
	sha256sums = 78f173ec2d238cb6a5847202f85436165f45d7e1238fa524c17c30fbf8694ae2

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.10.8.arch1-1-bin
	depends = linux6.10.8.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.10.8.arch1-1-headers-bin
	depends = linux6.10.8.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.10.8.arch1-1-docs-bin
	depends = linux6.10.8.arch1-1-docs-bin

pkgname = linux6.10.8.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.10.8-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.10.8.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.10.8-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.10.8.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.10.8-arch1-1
	conflicts = linux-docs
