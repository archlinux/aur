pkgbase = agentic-hive-git
	pkgdesc = Persistent Unix habitat for Claude Code, Codex, OpenCode and Antigravity agents sharing projects
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/tctinh/agentic-hive
	install = agentic-hive.install
	arch = any
	license = MIT
	makedepends = git
	depends = acl
	depends = bash
	depends = coreutils
	depends = findutils
	depends = gawk
	depends = git
	depends = grep
	depends = jq
	depends = ncurses
	depends = python
	depends = python-markdown-it-py
	depends = ripgrep
	depends = sed
	depends = sudo
	depends = systemd
	depends = tmux
	depends = util-linux
	optdepends = claude-code: Claude Code member harness
	optdepends = openai-codex: Codex member harness
	optdepends = opencode: OpenCode member harness
	optdepends = antigravity-cli: Antigravity (agy) member harness
	provides = agentic-hive
	conflicts = agentic-hive
	backup = etc/profile.d/agentic-hive.sh
	backup = etc/tmux.conf.d/agentic-hive.conf
	source = agentic-hive::git+https://github.com/tctinh/agentic-hive.git
	sha256sums = SKIP

pkgname = agentic-hive-git
