pkgbase = elide-bin
	pkgdesc = A fast batteries-included runtime, combining support for Kotlin, JavaScript, TypeScript, and Python.
	pkgver = 1.0.0_beta10
	pkgrel = 1
	url = https://elide.dev/
	arch = x86_64
	license = MIT
	depends = bash
	depends = zlib
	depends = glibc
	depends = gcc-libs
	optdepends = python: if using elide python runtime
	optdepends = java-runtime: if using elide java runtime
	optdepends = libxrender: if using java AWT
	optdepends = libxi: if using java AWT
	optdepends = libxext: if using java AWT
	optdepends = libxtst: if using java AWT
	optdepends = libx11: if using java AWT
	optdepends = alsa-lib: if using java Sound API
	optdepends = freetype2: if using java AWT or fontmanager
