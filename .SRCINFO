pkgbase = owlry
	pkgdesc = Lightweight Wayland application launcher — UI, daemon, and providers in one binary
	pkgver = 2.8.1
	pkgrel = 1
	url = https://somegit.dev/Owlibou/owlry
	install = owlry.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	depends = gcc-libs
	depends = gtk4
	depends = gtk4-layer-shell
	depends = bash
	depends = coreutils
	depends = util-linux
	depends = systemd
	optdepends = cliphist: clipboard history provider
	optdepends = wl-clipboard: clipboard write and emoji copy
	optdepends = rofimoji: emoji, kaomoji, and Unicode character picker
	optdepends = xdotool: optional X11 rofimoji typer
	optdepends = wtype: optional Wayland rofimoji typer
	optdepends = ydotool: optional fallback Wayland rofimoji typer
	optdepends = wl-ime-type: optional Wayland IME rofimoji typer
	optdepends = fd: filesystem search provider (primary backend)
	optdepends = plocate: filesystem search provider (fallback backend)
