pkgbase = rustconn-bin
	pkgdesc = Modern GTK4 connection manager for SSH, RDP, VNC and SPICE (prebuilt)
	pkgver = 0.24.0
	pkgrel = 1
	url = https://github.com/totoshko88/RustConn
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = appstream
	checkdepends = desktop-file-utils
	depends = alsa-lib
	depends = cairo
	depends = dbus
	depends = gcc-libs
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc>=2.39
	depends = graphene
	depends = gtk4>=4.14
	depends = libadwaita>=1.5
	depends = openssh
	depends = openssl>=3.0
	depends = pango
	depends = vte4>=0.76
	depends = webkitgtk-6.0>=2.40
	depends = which
	depends = zlib
	optdepends = 1password-cli: 1Password credential storage
	optdepends = aws-cli: AWS connections
	optdepends = aws-session-manager-plugin: AWS SSM connections
	optdepends = azure-cli: Azure connections
	optdepends = bitwarden-cli: Bitwarden credential storage
	optdepends = boundary: Boundary connections
	optdepends = cloudflared: Cloudflare connections
	optdepends = freerdp: External RDP client fallback
	optdepends = google-cloud-cli: Google Cloud connections
	optdepends = keepassxc: KeePassXC credential storage
	optdepends = kubectl: Shell access to Kubernetes pods
	optdepends = libappindicator: Display icon in system tray
	optdepends = libsecret: secret-tool for importing credentials
	optdepends = mc: SFTP via Midnight Commander FISH VFS
	optdepends = mosh: MOSH connections
	optdepends = oci-cli: Oracle Cloud connections
	optdepends = openh264: H.264 decoding for embedded RDP
	optdepends = pass: Password Store credential storage
	optdepends = passbolt-cli: Passbolt credential storage
	optdepends = picocom: Serial connections
	optdepends = tailscale: Tailscale connections
	optdepends = teleport: Teleport connections
	optdepends = tigervnc: External VNC client fallback
	optdepends = virt-viewer: External SPICE client
	optdepends = waypipe: Wayland application forwarding over SSH
	provides = rustconn=0.24.0
	conflicts = rustconn
	conflicts = rustconn-appimage
	noextract = rustconn_0.24.0_amd64.deb
	options = !strip
	options = !debug
	source = https://github.com/totoshko88/RustConn/releases/download/v0.24.0/rustconn_0.24.0_amd64.deb
	source = io.github.totoshko88.RustConn-rdp.xml
	source = io.github.totoshko88.RustConn-vv.xml
	sha256sums = b4e4a333e42faf5dfea19f2cd1ae3d3895d1d60026d2fa0aca7f54a210c83e30
	sha256sums = 6752641f8272fae15901cc4de4052514e846821fbeba797baa8d81850d508cda
	sha256sums = e833e539337e3a348f21a6757f015bfc7994df0789771880550350f0d04c45f0

pkgname = rustconn-bin
