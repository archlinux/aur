pkgbase = wolf-lang-bin
	pkgdesc = The wolf systems language: the wolfgang compiler, its runtime and the C importer (release archive)
	pkgver = 0.2.24
	pkgrel = 1
	url = https://github.com/wolffe-lang/wolf-lang
