pkgbase = wdm
	pkgdesc = A Wayland display manager that is its own compositor
	pkgver = 0.8.0
	pkgrel = 1
	url = https://github.com/quinnjr/wdm
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = libinput
	makedepends = seatd
	makedepends = systemd-libs
	makedepends = mesa
	makedepends = libdrm
	makedepends = libxkbcommon
	makedepends = pam
	source = wdm-0.8.0.tar.gz::https://github.com/quinnjr/wdm/archive/refs/tags/v0.8.0.tar.gz
	sha256sums = 8928a26d7b192fa739ed5e9f11013d88f6dcc604c9f58b88edee82c9682a39cd

pkgname = wdm
	install = wdm.install
	depends = libinput
	depends = seatd
	depends = systemd-libs
	depends = mesa
	depends = libdrm
	depends = libxkbcommon
	depends = pam
	depends = wdm-greeter-implementation
	optdepends = wdm-gtk-greeter: GTK4 greeter
	optdepends = wdm-webkit-greeter: WebKitGTK greeter, themed in HTML and CSS
	optdepends = wdm-plasma-greeter: Qt6/QML greeter, themed in QML
	backup = etc/pam.d/wdm
	backup = etc/wdm/wdm.toml

pkgname = wdm-greeter
	pkgdesc = Reference greeter for wdm, software-rendered with no toolkit
	depends = libxkbcommon
	provides = wdm-greeter-implementation
