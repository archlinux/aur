pkgbase = rosec-bin
	pkgdesc = Multi-provider Secret Service daemon with SSH agent, FUSE mount, and PAM unlock
	pkgver = 0.0.28
	pkgrel = 1
	url = https://github.com/jmylchreest/rosec
	install = rosec.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = dbus
	depends = pam
	optdepends = fuse3: SSH key FUSE filesystem at $XDG_RUNTIME_DIR/rosec/ssh
	optdepends = openssh: SSH agent support
	optdepends = libnotify: desktop notifications on lock/unlock
	optdepends = rosec-provider-bitwarden-pm-bin: Bitwarden Password Manager provider (sync, SSH keys)
	optdepends = rosec-provider-bitwarden-sm-bin: Bitwarden Secrets Manager provider (sync)
	optdepends = rosec-provider-gnome-keyring-bin: GNOME Keyring read-only provider
	optdepends = rosec-provider-keepassxc-file-bin: KeePassXC (.kdbx file) read-only provider (experimental)
	provides = rosec
	provides = org.freedesktop.secrets
	conflicts = rosec
	source_x86_64 = rosec-0.0.28-x86_64.tar.gz::https://github.com/jmylchreest/rosec/releases/download/v0.0.28/rosec-0.0.28-x86_64-unknown-linux-gnu.tar.gz
	sha256sums_x86_64 = 60d5101418d8b2e0bcc7b3d70a5b27b6440a5e0d8a4557c9b6ccccea4874ec35
	source_aarch64 = rosec-0.0.28-aarch64.tar.gz::https://github.com/jmylchreest/rosec/releases/download/v0.0.28/rosec-0.0.28-aarch64-unknown-linux-gnu.tar.gz
	sha256sums_aarch64 = @AARCH64_SHA256@

pkgname = rosec-bin
