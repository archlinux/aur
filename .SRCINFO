pkgbase = podman-bcachefs-bin
	pkgdesc = A tool for managing OCI containers and pods, with the bcachefs graphdriver compiled in
	pkgver = 6.1.2
	pkgrel = 1
	url = https://github.com/ticpu/bcachefs-storage-driver
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	depends = catatonit
	depends = conmon
	depends = containers-common
	depends = oci-runtime
	depends = glibc
	depends = nftables
	depends = gpgme
	depends = libgpgme.so
	depends = libgcc
	depends = libseccomp
	depends = libseccomp.so
	depends = passt
	depends = shadow
	depends = sqlite
	optdepends = apparmor: for AppArmor support
	optdepends = bcachefs-tools: inspect the bcachefs backend subvolumes
	optdepends = btrfs-progs: support btrfs backend devices
	optdepends = fuse-overlayfs: for deprecated storage driver in rootless environment
	optdepends = podlet: Generate Podman Quadlet files from a Podman command, compose file, or existing object
	optdepends = podman-compose: for docker-compose compatibility
	optdepends = podman-desktop: GUI and tray to manage Podman containers (and Kubernetes pods)
	provides = podman=6.1.2
	provides = podman-bcachefs=6.1.2
	conflicts = podman
	conflicts = podman-bcachefs
