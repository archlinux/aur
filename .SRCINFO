pkgbase = openhouse-bin
	pkgdesc = Drop-in open-source replacement for SteamVR's lighthouse driver
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/YusufOzmen01/openhouse
	install = openhouse-bin.install
	arch = x86_64
