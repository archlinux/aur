pkgbase = mbdyn-git
	pkgdesc = The first *free* general purpose Multibody Dynamics analysis software
	pkgver = r18.fbacc87
	pkgrel = 1
	url = https://www.mbdyn.org
	install = mbdyn.install
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = git
	makedepends = autoconf
	makedepends = automake
	makedepends = gcc-fortran
	makedepends = libtool
	depends = suitesparse
	depends = netcdf
	depends = netcdf-cxx
	depends = hdf5
	depends = arpack
	depends = lapack
	depends = blas
	depends = python
	depends = python-numpy
	depends = octave
	depends = gtest
	depends = boost
	optdepends = trilinos: advanced nonlinear solver support (NOX) - requires version 16.1.0 from AUR
	optdepends = ginac: symbolic elements support
	optdepends = intel-oneapi-mkl: Intel MKL PARDISO sparse solver support
	options = !buildflags
	source = mbdyn-git::git+https://public.gitlab.polimi.it/DAER/mbdyn.git#branch=develop
	sha256sums = SKIP

pkgname = mbdyn-git
