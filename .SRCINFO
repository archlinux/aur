pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 7.0.8.zen1
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-7.0.8.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-7.0.8.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-7.0.8.zen1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-zen-7.0.8.zen1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-zen-headers-7.0.8.zen1-1-x86_64.pkg.tar.zst
