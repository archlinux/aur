pkgname = linux-hardened-versioned-bin
	pkgdesc = Metapackage depending on linux6.17.13.hardened1-3-hardened-bin
	depends = linux6.17.13.hardened1-3-hardened-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-hardened-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.17.13.hardened1-3-hardened-headers-bin
	depends = linux6.17.13.hardened1-3-hardened-headers-bin

pkgname = linux-hardened-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.17.13.hardened1-3-hardened-docs-bin
	depends = linux6.17.13.hardened1-3-hardened-docs-bin

pkgname = linux6.17.13.hardened1-3-hardened-bin
	pkgdesc = The Security-Hardened Linux kernel and modules, version 6.17.13-hardened1-3-hardened
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = usbctl: deny_new_usb control
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-hardened

pkgname = linux6.17.13.hardened1-3-hardened-headers-bin
	pkgdesc = Headers and scripts for building modules for the Security-Hardened Linux kernel 6.17.13-hardened1-3-hardened
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-hardened-headers

pkgname = linux6.17.13.hardened1-3-hardened-docs-bin
	pkgdesc = Documentation for the Security-Hardened Linux kernel 6.17.13-hardened1-3-hardened
	conflicts = linux-hardened-docs
