pkgbase = castr
	pkgdesc = Cast your Hyprland screen to an Apple TV or a Chromecast: mirror or extend, from a menu or the CLI
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/mrCode/castr
	install = castr.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = go
	makedepends = git
	depends = avahi
	optdepends = doubletake-git: AirPlay streaming (REQUIRED for AirPlay; 0.4.0 cannot capture on Hyprland)
	optdepends = gst-plugin-pipewire: screen capture for Chromecast (REQUIRED for Chromecast)
	optdepends = gst-plugins-base: scaling and rate control (REQUIRED for Chromecast)
	optdepends = gst-plugins-good: AAC parsing (REQUIRED for Chromecast)
	optdepends = gst-plugins-bad: HLS output and H.264 parsing (REQUIRED for Chromecast)
	optdepends = gst-libav: the silent AAC track a receiver refuses to play without (REQUIRED for Chromecast)
	optdepends = gst-plugin-va: hardware H.264 encoding on Intel and AMD
	optdepends = gst-plugins-ugly: x264, the software encoding fallback
	optdepends = hyprland: required in practice — castr drives its outputs and screen-share portal
	optdepends = libnotify: desktop notifications
	optdepends = quickshell: bar widget on Omarchy Quarto and later (see castr-indicator)
	optdepends = waybar: bar indicator on earlier setups
	options = !debug
	source = castr-0.2.0.tar.gz::https://github.com/mrCode/castr/archive/refs/tags/v0.2.0.tar.gz
	sha256sums = 2c293ba5e69866a5c36016a2f3097887b9a92cdb6a84e70049dd094269feba8f

pkgname = castr
