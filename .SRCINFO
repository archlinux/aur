pkgbase = kodexbar-suite
	pkgdesc = KodexBar Suite: Plasma widget, ai CLI, native Claude/Codex/Grok quotas (optional codexbar for Antigravity)
	pkgver = 0.12.1
	pkgrel = 2
	url = https://github.com/Karasowl/KodexBar-Suite
	install = kodexbar-suite.install
	arch = any
	license = MIT
	depends = python
	optdepends = codexbar-cli-bin: Antigravity quotas and Codex/Grok fallback when the native path fails
	optdepends = plasma-workspace: Plasma 6 widget for ordered multi-provider quotas
	optdepends = plasma5support: DataEngine/DataSource backend used by the Plasma widget
	optdepends = konsole: open the ai selector in a terminal from the Plasma widget
	optdepends = python-gobject: required by kodexbar-tray StatusNotifierItem indicator
	optdepends = libayatana-appindicator: AppIndicator bindings for kodexbar-tray
	optdepends = wl-clipboard: Wayland clipboard support for ai recover --copy
	optdepends = xclip: X11 clipboard support for ai recover --copy
	optdepends = xsel: alternate X11 clipboard support for ai recover --copy
	source = kodexbar-suite-0.12.1.tar.gz::https://github.com/Karasowl/KodexBar-Suite/archive/refs/tags/v0.12.1.tar.gz
