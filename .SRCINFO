pkgbase = facelock-git
	pkgdesc = Face authentication PAM module for Linux (development build)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/tyvsmith/facelock
	install = facelock.install
	arch = x86_64
	license = MIT OR Apache-2.0
	makedepends = rust
	makedepends = cargo
	makedepends = clang
	makedepends = wayland
	makedepends = libxkbcommon
	makedepends = git
	depends = glibc
	depends = dbus
	depends = pam
	depends = gcc-libs
	depends = tpm2-tss
	depends = libxkbcommon
	depends = onnxruntime
	provides = facelock
	conflicts = facelock
	options = !lto
	backup = etc/facelock/config.toml
	source = facelock-git::git+https://github.com/tyvsmith/facelock.git
	sha256sums = SKIP

pkgname = facelock-git
