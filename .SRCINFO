pkgbase = rom-properties
	pkgdesc = Shell extension for displaying ROM and disc image metadata in file managers
	pkgver = 2.8
	pkgrel = 1
	url = https://github.com/GerbilSoft/rom-properties
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = cairo
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = fmt
	makedepends = gdk-pixbuf2
	makedepends = gettext
	makedepends = glib2-devel
	makedepends = gsound
	makedepends = gtk3
	makedepends = gtk4
	makedepends = kcrash
	makedepends = kio
	makedepends = kfilemetadata
	makedepends = kwidgetsaddons
	makedepends = libnautilus-extension
	makedepends = pkgconf
	makedepends = pugixml
	makedepends = python
	makedepends = qt5-base
	makedepends = qt6-base
	makedepends = qt6-tools
	options = !debug
	source = rom-properties-2.8.tar.gz::https://github.com/GerbilSoft/rom-properties/archive/v2.8.tar.gz
	sha256sums = c9eccc8d57751878c115073cd3b61ae6b7a0380bf5a07e229bc4d8683675aa71

pkgname = rom-properties
	depends = curl
	depends = fmt
	depends = glibc
	depends = libgcc
	depends = libgomp
	depends = libjpeg-turbo
	depends = libpng
	depends = libseccomp
	depends = libstdc++
	depends = nettle
	depends = pugixml
	depends = zlib
	depends = zstd
	optdepends = libwebp: WebP image decoding support (for Android APK packages)
	optdepends = lz4: For PSP CISOv2 and ZISO compressed disc decompression
	optdepends = lzo: For PSP JISO compressed disc decompression
	optdepends = rom-properties-gtk: GTK extensions for file managers (Nautilus, Desktop Search, Caja, Nemo, Thunar)
	optdepends = rom-properties-kde: Qt6/KF6 plugins for Dolphin and KFileMetaData

pkgname = rom-properties-gtk
	pkgdesc = Nautilus and other GTK-based file manager extensions for rom-properties
	depends = cairo
	depends = fmt
	depends = glib2
	depends = glibc
	depends = gsound
	depends = gtk3
	depends = gtk4
	depends = libgcc
	depends = libstdc++
	depends = pango
	depends = rom-properties

pkgname = rom-properties-kde
	pkgdesc = Dolphin, KFileMetaData, and KF6 plugins for rom-properties
	depends = fmt
	depends = glibc
	depends = kcoreaddons
	depends = kfilemetadata
	depends = kio
	depends = kwidgetsaddons
	depends = libgcc
	depends = libstdc++
	depends = qt6-base
	depends = rom-properties
