pkgbase = python-sherpa
	pkgdesc = Modeling and fitting package for scientific data analysis
	pkgver = 4.19.0
	pkgrel = 1
	url = http://cxc.cfa.harvard.edu/contrib/sherpa
	arch = i686
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = meson-python
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-numpy
	makedepends = fftw
	source = https://files.pythonhosted.org/packages/source/s/sherpa/sherpa-4.19.0.tar.gz
	md5sums = f4862bd898564fe1d4938253f5cc237e

pkgname = python-sherpa
	depends = python>=3.11
	depends = python-numpy>=1.21.0
	depends = fftw
	optdepends = python-matplotlib: for visualisation
	optdepends = python-astropy: for visualisation
	optdepends = python-arviz: sherpa.sim.MCMC results
	optdepends = python-optimagic: sherpa.optmethods.optoptmagic
	optdepends = python-scipy: for the sherpa.optmethods.optscipy module
	optdepends = ds9: for interactive display and manipulation of 2-D images
	optdepends = xpa: for interactive display and manipulation of 2-D images
	optdepends = python-sherpa-doc: Documentation for Sherpa
