pkgbase = cnmplayer-git
	pkgdesc = A terminal-based Netease cloud music player with spectrum visualizer, lyrics support. (Development version)
	pkgver = preview
	pkgrel = 2
	url = https://github.com/professor-lee/CNMPlayer
	arch = x86_64
	arch = aarch64
	license = AGPL3
	makedepends = cargo
	makedepends = cmake
	makedepends = pkgconf
	makedepends = git
	depends = alsa-lib
	depends = chafa
	depends = glib2
	depends = openssl
	depends = pipewire
	optdepends = cava: spectrum visualization
	optdepends = ttf-nerd-fonts-symbols: For icons and spectrum visualizer
	optdepends = ttf-jetbrains-mono-nerd: Recommended monospace font
	provides = cnmplayer
	conflicts = cnmplayer
	options = !lto
	source = cnmplayer-git::git+https://github.com/professor-lee/CNMPlayer.git#branch=develop
	sha256sums = SKIP

pkgname = cnmplayer-git
