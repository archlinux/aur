pkgbase = fontpreview_sixel
	pkgdesc = A blazing-fast terminal font previewer with sixel graphics support, leveraging fzf for interactive selection and ImageMagick for rendering. Perfect for designers and developers working with typography in Linux/Unix environments. Features customizable text samples, adjustable size/colors, and outputs to both Sixel-capable terminals and image files.
	pkgver = 1.0.1
	pkgrel = 2
	url = https://github.com/felipefacundes/fontpreview
	arch = any
	license = GPL
	depends = bash
	depends = fzf
	depends = libsixel
	depends = imagemagick
	optdepends = feh: fallback image viewer for terminals without Sixel support
	optdepends = file: for identifying file
	source = git+https://github.com/felipefacundes/fontpreview.git
	md5sums = SKIP

pkgname = fontpreview_sixel
