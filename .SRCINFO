pkgbase = anima-engine
	pkgdesc = Animated desktop overlays, a Workshop browser, and AI background removal. Builds from source with every feature: about ten to twenty minutes, because the release profile uses fat LTO and one codegen unit.
	pkgver = 0.1.2
	pkgrel = 1
	url = https://github.com/swordreforge/linux_animeengine_git
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = gcc
	depends = glibc
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = mesa: a Vulkan driver, without which the overlay and the studio cannot render
	optdepends = ffmpeg: render and probe video for the mp4 tools and the AI removal (ffprobe comes with it)
	optdepends = steamcmd: download and sync Workshop items
	optdepends = xdg-desktop-portal: file dialogs in the studio
	optdepends = libsteam_api: Steam presence, if built with the steamworks feature
	options = !lto
	source = anima-engine-0.1.2.tar.gz::https://github.com/swordreforge/linux_animeengine_git/archive/v0.1.2.tar.gz
	sha256sums = d7da229b6b716fd8fc4c354c0f8ea8f5bcb17db172e3be51a50bfa26b08cefb5

pkgname = anima-engine
