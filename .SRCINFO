pkgbase = mingw-w64-fpc
	pkgdesc = Free Pascal cross-compilers and RTL for the win32 (i386) and win64 (x86_64) targets
	pkgver = 3.2.2
	pkgrel = 2
	url = https://www.freepascal.org/
	install = mingw-w64-fpc.install
	arch = x86_64
	license = GPL-2.0-only
	license = LicenseRef-modifiedLGPL
	depends = mingw-w64-binutils
	optdepends = fpc: fpc(1) driver, enables "fpc -Twin32" / "fpc -Twin64"
	optdepends = mingw-w64-crt: linking against the mingw-w64 C runtime
	optdepends = mingw-w64-headers: Win32 API headers for C interfacing
	noextract = fpc-3.2.2.x86_64-linux.tar
	options = !strip
	options = !debug
	options = !buildflags
	options = !lto
	options = !makeflags
	options = staticlibs
	options = !emptydirs
