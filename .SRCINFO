pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.29
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.29-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.29-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.29-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.29-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.29-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.29-1-x86_64.pkg.tar.zst
	sha256sums = 9478bf62c9a26420078765ea57b5aeed9bd1d2f6cc8154ae9e024e6e2efd03e5
	sha256sums = 3d4961da2842bd34bf7bac6bca4d3909a3bf20150baaabecb7e4b86f0f5bc289
	sha256sums = 544814ee1cbca58eac3559091ed7ba6887bc6a2b9b572d1d411550211002b944

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.29-1-lts-bin
	depends = linux6.12.29-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.29-1-lts-headers-bin
	depends = linux6.12.29-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.29-1-lts-docs-bin
	depends = linux6.12.29-1-lts-docs-bin

pkgname = linux6.12.29-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.29-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.29-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.29-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.29-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.29-1-lts
	conflicts = linux-lts-docs
