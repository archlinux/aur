pkgbase = thyra-bin
	pkgdesc = Browser and PWA door into your Herdr terminals and agents, with first-class mobile support
	pkgver = 0.10.1
	pkgrel = 1
	url = https://github.com/Yubo-Cao/thyra
	install = thyra-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	depends = hicolor-icon-theme
	optdepends = herdr: local Herdr server (Thyra works with stock Herdr 0.9.x; the Yubo-Cao/herdr fork adds collaboration and live handoff)
	optdepends = openssh: connect to remote Herdr servers
	optdepends = cloudflared: public access through thyra-tunnel.service
	optdepends = xdg-utils: open the browser with --open
	provides = thyra=0.10.1
	conflicts = thyra
	options = !strip
	options = !debug
