pkgbase = castr
	pkgdesc = Cast your Hyprland screen to an Apple TV or a Chromecast: mirror or extend, from a menu or the CLI
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/mrCode/castr
	install = castr.install
	arch = x86_64
	arch = aarch64
	license = MIT
	license = LGPL-3.0-only
	makedepends = go
	makedepends = git
	depends = avahi
	depends = gstreamer
	depends = gst-plugin-pipewire
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gst-plugins-bad
	depends = gst-libav
	optdepends = gst-plugin-va: hardware H.264 encoding on Intel and AMD
	optdepends = gst-plugins-ugly: x264, the software encoding fallback
	optdepends = libpulse: pactl, which castr-airplay uses to send audio to an Apple TV
	optdepends = hyprland: required in practice — castr drives its outputs and screen-share portal
	optdepends = libnotify: desktop notifications
	optdepends = quickshell: bar widget on Omarchy Quarto and later (see castr-indicator)
	optdepends = waybar: bar indicator on earlier setups
	options = !debug
	source = castr-0.3.0.tar.gz::https://github.com/mrCode/castr/archive/refs/tags/v0.3.0.tar.gz
	source = castr-airplay-1.tar.gz::https://github.com/mrCode/doubletake/archive/refs/tags/castr-airplay-1.tar.gz
	sha256sums = 00fb40ff544f5ee1a5647e723223b1a4d654bd2d46747d0aee592f0425b454d8
	sha256sums = 7452cd9a3c8c6feac063b6d60977ea5d8448a75aeb62b54a6d40eaed9753d8db

pkgname = castr
