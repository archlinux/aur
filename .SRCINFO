pkgbase = repos-manager
	pkgdesc = Clone and update every Git repo you can access on GitHub, GitLab, Forgejo, Bitbucket, Sourcehut, OneDev, Radicle and plain git servers
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/Dxsk/repos-manager
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = git
	depends = gcc-libs
	depends = glibc
	optdepends = github-cli: GitHub provider
	optdepends = glab: GitLab provider
	optdepends = tea: Forgejo, Gitea and Gogs login
	optdepends = hut: Sourcehut provider
	optdepends = openssh: plain git server discovery
	conflicts = repos-manager-bin
	options = !lto
