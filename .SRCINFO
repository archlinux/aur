pkgbase = reshade-linux-bin
	pkgdesc = crosire's ReShade post-processing injector as a native Vulkan layer, enabled with RESHADE=1 (works with Proton via DXVK/VKD3D) (prebuilt)
	pkgver = 6.8.0.1
	pkgrel = 1
	url = https://github.com/TheElevatedOne/reshade-linux
	arch = x86_64
	license = BSD-3-Clause
	depends = glibc
	depends = libxcb
	depends = libxkbcommon
	depends = wayland
	depends = dbus
	depends = vulkan-icd-loader
	depends = bash
	depends = git
	optdepends = lib32-reshade-linux: 32-bit games (lib32-reshade-linux-bin or lib32-reshade-linux-git)
	optdepends = curl: download the depth buffer compatibility list with reshade --download-shaders
	optdepends = xdg-desktop-portal: global shortcuts (e.g. xdg-desktop-portal-kde or xdg-desktop-portal-hyprland)
	optdepends = pipewire-audio: screenshot sound (pw-play)
	optdepends = xdg-utils: open folders and links from the overlay
	provides = reshade-linux=6.8.0.1
	conflicts = reshade-linux
	options = !debug
	options = !strip
