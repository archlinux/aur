pkgbase = homemesh-git
	pkgdesc = Open the home folders of your other computers in any file manager; pair them with a code (development version)
	pkgver = 0.5.0.r15.gf24fb77
	pkgrel = 1
	url = https://github.com/MikolajQ/homemesh
	install = homemesh.install
	arch = any
	license = MIT
	makedepends = git
	makedepends = fakeroot
	makedepends = gettext
	makedepends = make
	depends = gtk4
	depends = openssh
	depends = polkit
	depends = python
	depends = python-gobject
	optdepends = gvfs: open the computers in Nautilus, Nemo, Thunar and Caja
	optdepends = kio-extras: open the computers in Dolphin
	optdepends = bubblewrap: share only chosen folders
	optdepends = avahi: name.local addresses on systems without systemd-resolved
	optdepends = nss-mdns: name.local addresses together with avahi
	optdepends = tailscale: reach the computers away from home (or another VPN)
	provides = homemesh
	conflicts = homemesh
	options = !strip
	options = !debug
	source = git+https://github.com/MikolajQ/homemesh.git
	sha256sums = SKIP

pkgname = homemesh-git
