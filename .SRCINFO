pkgname = mod_tile-git
	pkgdesc = An Apache 2 module to deliver map tiles
	install = mod_tile-git.install
	depends = apache
	depends = apr
	depends = glib2
	depends = iniparser
	provides = mod_tile
	conflicts = mod_tile

pkgname = renderd-git
	pkgdesc = A daemon that renders map tiles using mapnik
	depends = glib2
	depends = iniparser
	depends = mapnik
	provides = renderd
	conflicts = renderd
	backup = etc/renderd.conf
