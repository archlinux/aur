pkgname = kiri-bin
	pkgdesc = Tiny, fast container runtime speaking the Docker API (bundled docker CLI, Compose, buildx; GUI on x86_64)
	install = kiri.install
	depends = glibc
	depends = polkit
	optdepends = docker: system docker CLI (preferred over the bundled one when installed)
	optdepends = docker-compose: system Compose plugin (preferred over the bundled one)
	optdepends = docker-buildx: system buildx plugin (preferred over the bundled one)
	conflicts = kiri-lite-bin
	conflicts = kiri-git
	depends_x86_64 = gcc-libs
	depends_x86_64 = gdk-pixbuf2
	depends_x86_64 = glib2
	depends_x86_64 = gtk3
	depends_x86_64 = webkit2gtk-4.1

pkgname = kiri-lite-bin
	pkgdesc = Tiny, fast container runtime speaking the Docker API (engine only)
	install = kiri.install
	depends = glibc
	optdepends = docker: docker CLI to talk to the engine
	optdepends = polkit: pkexec for kiri host-access
	conflicts = kiri-bin
	conflicts = kiri-git
