pkgbase = mmsimpulse-git
	pkgdesc = A Wayland session of KWin plus the illogical-impulse shell — no desktop environment
	pkgver = r20.c493a00
	pkgrel = 1
	url = https://github.com/mahirsn/mmsimpulse
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = kwin
	depends = kglobalacceld
	depends = quickshell
	depends = xdg-desktop-portal-kde
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = rsync
	depends = git
	depends = jq
	depends = systemd
	optdepends = kineticwe: KWin fork with native tiling, which mmsimpulse runs with tiling off
	optdepends = powerdevil: idle timeouts, DPMS, suspend and brightness
	optdepends = upower: battery status
	optdepends = illogical-impulse-basic: the widget set this shell is built on
	optdepends = illogical-impulse-audio: audio widgets and OSDs
	optdepends = illogical-impulse-backlight: brightness control
	optdepends = illogical-impulse-fonts-themes: Material Symbols and the shell fonts
	optdepends = illogical-impulse-portal: file pickers and screen sharing
	optdepends = illogical-impulse-python: colour generation for the theming scripts
	optdepends = illogical-impulse-screencapture: region screenshot and recording
	optdepends = ydotool: cursor warping, which KWin exposes no D-Bus call for
	provides = mmsimpulse
	conflicts = mmsimpulse
	source = mmsimpulse-git::git+https://github.com/mahirsn/mmsimpulse.git
	sha256sums = SKIP

pkgname = mmsimpulse-git
