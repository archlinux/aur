pkgbase = slint
	pkgdesc = Declarative GUI toolkit to build native user interfaces
	pkgver = 1.17.1
	pkgrel = 1
	url = https://github.com/slint-ui/slint/
	arch = x86_64
	license = GPL-3.0-or-later OR LicenseRef-Slint-Royalty-free-2.0 OR LicenseRef-Slint-Software-3.0
	makedepends = cargo
	makedepends = cmake
	makedepends = fontconfig
	makedepends = freetype2
	makedepends = git
	makedepends = gstreamer
	makedepends = libinput
	makedepends = libxkbcommon
	makedepends = mesa
	makedepends = python
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-maturin
	makedepends = python-setuptools
	makedepends = python-wheel
	makedepends = systemd-libs
	source = https://github.com/slint-ui/slint/archive/v1.17.1/slint-1.17.1.tar.gz
	source = 010-slint-remove-jemalloc.patch
	source = 020-slint-allow-python-maturin-0.14.1.patch
	sha256sums = 68222567f8c70ff677cd4a98cd94fb4765ac0f797eb8f8608a646911c908dc2a
	sha256sums = d124acb5002d71d8efc0c580b1a49cc9432fa78a8599af3a44085d000ff4f28a
