	depends = dbus
	depends = libxkbcommon
	depends = wayland
	depends = gtk3
	optdepends = qt6-wayland: native Wayland window
	optdepends = tesseract: text recognition blocks
	optdepends = grim: screen blocks on wlroots desktops
	optdepends = kdotool: window blocks on KDE Plasma
