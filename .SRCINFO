pkgbase = hoja-git
	pkgdesc = GPU-accelerated file manager with splittable panes, built on GPUI
	pkgver = r245.073131f
	pkgrel = 1
	url = https://github.com/slastra/hoja
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = pkgconf
	makedepends = wayland-protocols
	depends = fontconfig
	depends = freetype2
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	optdepends = hoja-model-thumbnailer-git: pictures of STL, 3MF and G-code files
	optdepends = git: colour file names by version control status
	optdepends = xdg-utils: open files with their default application
	optdepends = wl-clipboard: copy and paste files with other applications
	optdepends = libnotify: desktop notification when a long transfer finishes
	optdepends = udisks2: mount attached drives from the place finder
	optdepends = shared-mime-info: identify file types for the Open With menu
	optdepends = ffmpegthumbnailer: pictures of videos in previews and the grid
	optdepends = papers: pictures of PDFs in previews and the grid
	optdepends = poppler: page count and page shape of a PDF preview
	optdepends = vulkan-radeon: Vulkan driver for AMD graphics
	optdepends = nvidia-utils: Vulkan driver for NVIDIA graphics
	optdepends = vulkan-intel: Vulkan driver for Intel graphics
	provides = hoja
	conflicts = hoja
	options = !lto
	source = git+https://github.com/slastra/hoja.git
	b2sums = SKIP

pkgname = hoja-git

pkgname = hoja-model-thumbnailer-git
	pkgdesc = Thumbnailer for STL, 3MF and G-code files, drawn on the CPU
	depends = glibc
	depends = libgcc
	optdepends = 
