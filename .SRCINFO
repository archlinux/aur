pkgname = linux-sp7
	pkgdesc = The Linux (Surface Pro 7) kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = iptsd: multi-touch and pen support for the IPTS touchscreen
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-sp7-headers
	pkgdesc = Headers and scripts for building modules for the Linux (Surface Pro 7) kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
