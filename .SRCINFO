pkgbase = gulchce-bin
	pkgdesc = OpenCE fork with experimental features such as Halo MCC custom maps (needs your own Xbox disc image)
	pkgver = 256
	pkgrel = 1
	url = https://github.com/chestahh/GulchCE
	install = gulchce-bin.install
	arch = x86_64
	license = AGPL-3.0-or-later
	license = Apache-2.0
	license = BSD-3-Clause
	license = BSD-4-Clause
	license = ISC
	license = MIT
	license = OFL-1.1
	license = Zlib
	depends = lib32-glibc
	depends = lib32-gcc-libs
	depends = lib32-libx11
	depends = lib32-libxext
	depends = lib32-mesa
	depends = hicolor-icon-theme
	optdepends = lib32-nvidia-utils: graphics on NVIDIA cards
	optdepends = lib32-pipewire: sound through PipeWire (one of the sound libraries is needed for sound)
	optdepends = lib32-libpulse: sound through PulseAudio
	optdepends = lib32-alsa-lib: sound through ALSA
	optdepends = lib32-wayland: a native Wayland window instead of XWayland (with lib32-libxkbcommon)
	optdepends = lib32-libxkbcommon: a native Wayland window instead of XWayland (with lib32-wayland)
	optdepends = lib32-libdecor: window borders on GNOME under Wayland
	optdepends = zenity: the disc image picker at the first start, where there is no desktop portal
	optdepends = xdg-utils: invite links that open the game
	provides = gulchce
	conflicts = gulchce
	options = !strip
	options = !debug
	source = halo-linux-release-256.zip::https://github.com/chestahh/GulchCE/releases/download/build-256/halo-linux-release.zip
	source = LINUX-256.md::https://raw.githubusercontent.com/chestahh/GulchCE/95d098ca348ed193322315cca1bb7841ee631a66/port/linux/README.md
	source = MCC-256.md::https://raw.githubusercontent.com/chestahh/GulchCE/95d098ca348ed193322315cca1bb7841ee631a66/docs/mcc_maps.md
	source = icon-256-256.png::https://raw.githubusercontent.com/chestahh/GulchCE/95d098ca348ed193322315cca1bb7841ee631a66/port/assets/icon/opence-icon-256.png
	source = icon-512-256.png::https://raw.githubusercontent.com/chestahh/GulchCE/95d098ca348ed193322315cca1bb7841ee631a66/port/assets/icon/opence-icon.png
