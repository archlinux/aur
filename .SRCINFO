pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.17
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.17-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.17-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.17-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.17-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.17-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.17-1-x86_64.pkg.tar.zst
	sha256sums = 84591c692ff23521157f940877ccb6ff58d6d7eb23908268cdc81c397eb65419
	sha256sums = d269718be06f0238e217aa7e7746317d0b20c487fde54dce16c21e256870f9dc
	sha256sums = c10f48fd6beccdf748593fe41ed2f27e3afef02938a7bbb3cd70072bfc7e07d6

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.17-1-lts-bin
	depends = linux6.18.17-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.17-1-lts-headers-bin
	depends = linux6.18.17-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.17-1-lts-docs-bin
	depends = linux6.18.17-1-lts-docs-bin

pkgname = linux6.18.17-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.17-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.17-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.17-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.17-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.17-1-lts
	conflicts = linux-lts-docs
