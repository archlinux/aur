pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.11.1.zen1
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.11.1.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.11.1.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.11.1.zen1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-6.11.1.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-headers-6.11.1.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-docs-6.11.1.zen1-1-x86_64.pkg.tar.zst
	sha256sums = dc5f3609769e88f5f8df4cb50af63f017eaa4af399f987b86573c769a5ac9840
	sha256sums = 027c22184f3a77bb422927e12c14fa86ca88d67d1f68a4be3e04244d5c242158
