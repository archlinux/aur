pkgname = stalwart-mail
	pkgdesc = Stalwart Mail and Collaboration Server
	install = stalwart-mail.install
	optdepends = mariadb: for using MariaDB as storage backend on the same host
	optdepends = postgresql: for using PostgreSQL as storage backend on the same host
	optdepends = redis: for using Redis as lookup storage backend on the same host
	optdepends = sqlite: for using SQLite as storage backend on the same host
	optdepends = stalwart-cli: for using the CLI to the mail server on the same host
	conflicts = stalwart-mail-server
	backup = etc/stalwart-mail/config.toml

pkgname = stalwart-cli
	pkgdesc = Stalwart Server CLI
	conflicts = stalwart-mail-server
