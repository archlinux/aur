pkgbase = merlin-git
	pkgdesc = Context sensitive completion for OCaml in Vim and Emacs (ocamlmerlin binary only)
	pkgver = 20251119
	pkgrel = 1
	url = https://github.com/ocaml/merlin
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = dune
	depends = ocaml
