pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.35
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.35-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.35-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.35-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.35-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.35-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.35-1-x86_64.pkg.tar.zst
	sha256sums = 232331fc89429b742c3ec6d17ab7c46fe8f91f5e5df2ff4f3bc942caf66fd18a
	sha256sums = 6857ca62112fbe794911e498503d05f4b9165d92ae92d2d000b5483d2e0e3d73
	sha256sums = e8e7c9299c683676a534449d293cd53846c2b992936100d5c7dfeba01ac204ce

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.35-1-lts-bin
	depends = linux6.12.35-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.35-1-lts-headers-bin
	depends = linux6.12.35-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.35-1-lts-docs-bin
	depends = linux6.12.35-1-lts-docs-bin

pkgname = linux6.12.35-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.35-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.35-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.35-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.35-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.35-1-lts
	conflicts = linux-lts-docs
