pkgbase = aivpn
	pkgver = 0.9.2
	pkgrel = 1
	url = https://github.com/infosave2007/aivpn
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	source = aivpn-0.9.2.tar.gz::https://github.com/infosave2007/aivpn/archive/refs/tags/v0.9.2.tar.gz
	source = aivpn-server.service
	source = aivpn-server.sysusers
	source = aivpn-server.tmpfiles
	source = aivpn-server.install
	source = aivpn-client@.service
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP

pkgname = aivpn-client
	pkgdesc = AIVPN client — connects to an aivpn-server endpoint
	depends = 
	optdepends = aivpn-kernel-dkms: optional kernel-accelerated data path

pkgname = aivpn-server
	pkgdesc = AIVPN server — gateway with traffic mimicry and DPI evasion
	install = aivpn-server.install
	depends = 
	optdepends = aivpn-kernel-dkms: optional kernel-accelerated data path
	backup = etc/aivpn/server.json
	backup = etc/aivpn/clients.json

pkgname = aivpn-kernel-dkms
	pkgdesc = AIVPN kernel module (DKMS) — in-kernel fast path (Linux 6.1+, CONFIG_RUST=y required)
	arch = any
	depends = dkms
	optdepends = linux-headers: build against the default kernel
	optdepends = linux-lts-headers: build against linux-lts
	optdepends = rust-bindgen: required for Rust-for-Linux module compilation
	optdepends = clang: optional — enables XDP fast-path filter
