pkgbase = aura-emerge
	pkgdesc = Portage-like wrapper for Arch Linux using Aura
	pkgver = 1.30.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = aura
	optdepends = devtools: for --abs support (build from ABS source via pkgctl)
	optdepends = gnupg: for PGP verification when building from ABS
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v1.30.0
	sha256sums = caabac1a260b49b7710be8fbfeede95c19dcb12e02bd8e336ce7ba08de55cc5c

pkgname = aura-emerge
