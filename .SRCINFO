pkgbase = cone-simple
	pkgdesc = Curses text-based mail client - inspired by Alpine - handles multiple POP3, IMAP accounts, and local mail folders. contains a simple newsreader. This version has no dependencies to courier libraries (other than the mandatory courier-unicode).
	pkgver = 2.0
	pkgrel = 1
	url = http://courier-mta.org/cone/
	arch = i686
	arch = x86_64
	license = GPL-3.0-only
	makedepends = procps-ng
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libxml2
	depends = libidn2
	depends = libldap
	depends = courier-unicode
	depends = ncurses
	depends = openssl
	depends = aspell
	provides = cone
	source = http://sourceforge.net/projects/courier/files/cone/2.0/cone-2.0.tar.bz2
