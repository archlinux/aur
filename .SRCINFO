	optdepends = python-structlog: distributed runtime structured logging
	optdepends = python-sympy: PyTorch Export symbolic-shape import
	optdepends = python-tflite: TFLite model schema
	optdepends = python-tornado: RPC tracker and proxy
	optdepends = python-tqdm: meta-schedule progress reporting
	optdepends = python-triton: Triton frontend
	optdepends = python-xgboost: meta-schedule XGBoost cost model
