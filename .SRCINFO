pkgbase = scale_tail
	pkgdesc = System-tray control centre for the Tailscale CLI
	pkgver = 0.6.0
	pkgrel = 1
	url = https://github.com/asafelobotomy/scale_tail
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = tailscale
	depends = gcc-libs
	depends = glibc
	depends = dbus
	depends = hicolor-icon-theme
	optdepends = libnotify: notifications (notify-send)
	optdepends = xdg-utils: open login and release pages in the browser
	optdepends = wl-clipboard: copy IPs and names (Wayland)
	optdepends = xclip: copy IPs and names (X11)
	optdepends = zenity: pick files to send with Taildrop
	optdepends = uq: Tailscale tile in uQ quick settings instead of the tray
	options = !lto
	options = !debug
