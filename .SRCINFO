pkgbase = osc-dreamchatbox
	pkgdesc = Native Linux alternative to MagicChatbox (VRCOSC) - VRChat OSC chatbox companion (status, now-playing, hardware, speech-to-text, OSCQuery)
	pkgver = 1.4.7
	pkgrel = 1
