pkgbase = mingw-w64-gnutls
	pkgdesc = A library which provides a secure layer over a reliable transport layer (mingw-w64)
	pkgver = 3.8.13
	pkgrel = 1
	url = https://www.gnutls.org/
	arch = any
	license = GPL-3.0-or-later AND LGPL-2.1-or-later
	checkdepends = mingw-w64-wine
	makedepends = mingw-w64-configure
	makedepends = autogen
	depends = mingw-w64-crt
	depends = mingw-w64-libtasn1
	depends = mingw-w64-readline
	depends = mingw-w64-zlib
	depends = mingw-w64-nettle
	depends = mingw-w64-p11-kit
	depends = mingw-w64-libunistring
	optdepends = mingw-w64-openssl: libgnutls-openssl
	options = staticlibs
	options = !strip
	options = !buildflags
	source = https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz
	source = https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz.sig
