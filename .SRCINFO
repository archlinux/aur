pkgbase = pince-git
	pkgdesc = A Linux reverse engineering tool inspired by Cheat Engine.
	pkgver = r1477.0e0ae0b
	pkgrel = 1
	url = https://github.com/korcankaraokcu/PINCE
	install = note.install
	arch = any
	license = GPL-3.0-or-later WITH CC-BY-3.0
	makedepends = python-pip
	makedepends = qt6-tools
	makedepends = lsb-release
	makedepends = pkgconf
	makedepends = git
	makedepends = sed
	optdepends = qt6-wayland: wayland support
	source = pince-git::git+https://github.com/korcankaraokcu/PINCE.git
	source = PINCE.desktop
	sha1sums = SKIP
	sha1sums = 719d18d69abc299f739cc04041967e9d05a34104

pkgname = pince-git
	depend = gdb
	depend = gobject-introspection-runtime
	depend = python-distorm
	depend = python-gobject
	depend = python-keyboard
	depend = python-keystone
	depend = python-pexpect
	depend = python-pygdbmi
	depend = python-pyqt6
