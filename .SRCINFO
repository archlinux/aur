pkgname = rustpython-build-bootstrap
	pkgdesc = A simple, correct PEP 517 build frontend (bootstrap)
	depends = rustpython
	depends = rustpython-packaging
	depends = rustpython-pyproject-hooks
	provides = rustpython-build
	conflicts = rustpython-build

pkgname = rustpython-flit-core-bootstrap
	pkgdesc = Simplified packaging of Python modules (core backend) (bootstrap)
	license = BSD-3-Clause
	provides = rustpython-flit-core
	conflicts = rustpython-flit-core

pkgname = rustpython-installer-bootstrap
	pkgdesc = Low-level library for installing a Python package from a wheel distribution (bootstrap)
	provides = rustpython-installer
	conflicts = rustpython-installer

pkgname = rustpython-packaging-bootstrap
	pkgdesc = Core utilities for Python packages (bootstrap)
	license = Apache-2.0 OR BSD-2-Clause
	provides = rustpython-packaging
	conflicts = rustpython-packaging

pkgname = rustpython-pyproject-hooks-bootstrap
	pkgdesc = A low-level library for calling build-backends in pyproject.toml-based project (bootstrap)
	provides = rustpython-pyproject-hooks
	conflicts = rustpython-pyproject-hooks

pkgname = rustpython-setuptools-bootstrap
	pkgdesc = Easily download, build, install, upgrade, and uninstall Python packages (bootstrap)
	provides = rustpython-setuptools
	conflicts = rustpython-setuptools

pkgname = rustpython-wheel-bootstrap
	pkgdesc = A built-package format for Python (bootstrap)
	provides = rustpython-wheel
	conflicts = rustpython-wheel
