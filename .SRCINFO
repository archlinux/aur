	source = LICENSE-1.3.2::https://raw.githubusercontent.com/peteonrails/voxtype/v1.3.2/LICENSE
	source = README-1.3.2.md::https://raw.githubusercontent.com/peteonrails/voxtype/v1.3.2/README.md
