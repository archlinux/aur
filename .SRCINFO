pkgname = skwd-wall-v2-bin
	pkgdesc = Prebuilt GPU-rendered graphical client for the Skwd wallpaper suite v2
	depends = gcc-libs
	depends = libxkbcommon
	depends = skwd-deck-bin
	depends = skwd-paper-bin
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = skwd-lens-bin: semantic wallpaper search
	optdepends = skwd-paper-plasma: KDE Plasma wallpaper integration
	provides = skwd-wall-v2=1.0.0_beta.14.2
	conflicts = skwd-wall-v2

