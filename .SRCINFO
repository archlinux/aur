	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-7.1.4.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-7.1.4.zen1-1-x86_64.pkg.tar.zst
