pkgname = python-photutils
	depends = python>=3.12
	depends = python-numpy>=2.0
	depends = python-astropy>=7.0
	depends = python-scipy>=1.15.0
	optdepends = python-matplotlib>=3.10: To power a variety of plotting features (e.g. plotting apertures)
	optdepends = python-gwcs>=0.22: Required in make_gwcs to create a simple celestial gwcs object.
	optdepends = python-bottleneck>=1.4: Improves the performance of sigma clipping and other functionality that may require computing statistics on arrays with NaN values
	optdepends = python-tqdm>=4.67: Required to display optional progress bars
	optdepends = python-rasterio>=1.4: Required to convert source segments into polygon objects
	optdepends = python-regions>=0.10: Required to perform aperture photometry using region objects
	optdepends = python-shapely>=2.1: Required to convert source segments into polygon objects
	optdepends = python-photutils-doc: Documentation for python-photutils

pkgname = python-photutils-doc
	pkgdesc = Documentation for Python Photutils module
	arch = any
