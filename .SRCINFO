pkgbase = tde-ariadne
	pkgdesc = A Nautilus-style file manager built with Qt 6
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/zskamljic/tde-ariadne
	install = ariadne.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = ninja
	depends = glibc
	depends = libarchive
	depends = libgcc
	depends = libstdc++
	depends = libtde>=0.2.0
	depends = qt6-base
	depends = qt6-svg
	depends = wayland
	optdepends = udisks2: mounting and ejecting drives, unlocking encrypted ones
	optdepends = gvfs-mtp: phones and cameras
	optdepends = gvfs-smb: Windows shares (gvfs itself covers SFTP, FTP and WebDAV)
	optdepends = papers: PDF and comic book thumbnails
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = bubblewrap: running thumbnailers in a sandbox
	optdepends = librsvg: drawing icons that Qt draws with black patches
	optdepends = qt6-imageformats: thumbnails for WebP, TIFF and other image formats
	optdepends = adwaita-icon-theme: fallback for icons missing from the icon theme
	optdepends = xdg-desktop-portal: picking files for other applications
	source = tde-ariadne-0.3.0.tar.gz::https://github.com/zskamljic/tde-ariadne/archive/refs/tags/v0.3.0.tar.gz
	sha256sums = 55ada0cf1e1ef85078548fa72e3357c30902d9570ce8fb9d25231fd3f65c9357

pkgname = tde-ariadne
