pkgbase = talkey-git
	pkgdesc = Push-to-talk voice input for X11/i3 - hold a key, speak, the text is typed. Offline, no API key.
	pkgver = 0.2.0.r39.gd2339e8
	pkgrel = 1
	url = https://github.com/yogh-io/talkey
	install = talkey-git.install
	arch = any
	license = MIT
	license = BSD-2-Clause
	license = Apache-2.0
	makedepends = git
	depends = bash
	depends = util-linux
	depends = whisper-cpp
	depends = ffmpeg
	depends = xdotool
	depends = xorg-xset
	depends = libpulse
	depends = curl
	depends = eww
	depends = inotify-tools
	depends = jq
	depends = xorg-xev
	optdepends = whisper.cpp-model-large-v3-turbo: the default speech model (AUR) - talkey needs some model
	optdepends = python: automatic speech detection, voice commands, live text in the HUD and translate mode
	optdepends = python-numpy: optional Smart Turn feature extraction, and the talkey camera
	optdepends = python-pillow: the talkey camera, subtitles on your video
	optdepends = v4l2loopback-dkms: the talkey camera, subtitles on your video
	optdepends = python-onnxruntime: optional Smart Turn CPU inference
	optdepends = libnotify: desktop notifications alongside the HUD, and the only feedback if you disable it
	optdepends = ollama: translate mode (translategemma:4b) and naming archived recordings (qwen2.5:3b)
	optdepends = uv: Python 3.10 for the optional Seamless translate engine; its weights are CC-BY-NC-4.0 (non-commercial), downloaded by talkey-setup seamless
	optdepends = xclip: paste mode (TALKEY_PASTE=1) instead of typing
	optdepends = sxhkd: key bindings without i3
	optdepends = xbindkeys: key bindings without i3
	provides = talkey
	conflicts = talkey
	source = talkey-git::git+https://github.com/yogh-io/talkey.git
	sha256sums = SKIP

pkgname = talkey-git
