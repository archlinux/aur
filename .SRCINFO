	optdepends = python-watchdog: live code-graph reindexing (--code-graph)
	optdepends = python-sqlite-vec: vector index for --memory
	optdepends = python-transformers: required by headroom proxy and wrap
	optdepends = python-tree-sitter-language-pack: AST-based code compression
	optdepends = python-numpy: relevance scoring, evals, and memory adapters
	optdepends = python-datasets: evaluation and voice training datasets
	optdepends = python-huggingface-hub: Kompress model downloads
	optdepends = python-hnswlib: HNSW vector memory adapter
