pkgbase = lituus-bin
	pkgdesc = Settings for Hyprland: network, Bluetooth, sound and displays (prebuilt binary)
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/giosuel/lituus
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	license = OFL-1.1
	depends = fontconfig
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxrandr
	depends = networkmanager
	depends = wayland
	optdepends = networkmanager-openvpn: OpenVPN connections
	optdepends = networkmanager-openconnect: Cisco AnyConnect connections, with web sign-in
	optdepends = bluez: Bluetooth, and files over Bluetooth (its obexd)
	optdepends = pipewire-pulse: the Sound page and Bluetooth audio profiles
	optdepends = hyprland: the Displays page
	optdepends = xdg-desktop-portal: file dialogs (certificates, VPN files, files to send)
	optdepends = gnome-keyring: passwords kept "for me only" (or KWallet)
	provides = lituus=0.3.0
	conflicts = lituus
