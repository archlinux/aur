	depends = libxkbcommon-x11
	depends = libxkbfile
	depends = libxrandr
	depends = libxss
	depends = libxtst
	depends = mesa
	depends = nss
	depends = pango
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = vulkan-driver: GPU drawing (vulkan-radeon, vulkan-intel or nvidia-utils)
	optdepends = libsecret: Chromium can store its cookies encrypted with the keyring
	optdepends = ffmpeg: animated album artwork (without it the covers stay still)
