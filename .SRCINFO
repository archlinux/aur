pkgbase = ele-messenger
	pkgdesc = ELE Messenger: household chat that keeps working without internet, router or server
	pkgver = 1.4.3
	pkgrel = 1
	url = https://github.com/thefangeddeity/ele-messenger
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = dbus
	options = !lto
	source = ele-messenger-1.4.3.tar.gz::https://github.com/thefangeddeity/ele-messenger/archive/refs/tags/v1.4.3.tar.gz
	source = ele-messenger.install
	source = ele-messenger-app.install
	sha256sums = 7cc17cb6e310991c2a7aa415aa51171bd09f54cb6889d7be2c9b93e59fb68d82
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = ele-messenger
	pkgdesc = ELE Messenger app and mesh service: chat between nearby machines over Bluetooth and Wi-Fi, no router, server or internet
	install = ele-messenger-app.install
	depends = bluez
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = libgl
	depends = hicolor-icon-theme
	optdepends = libx11: desktop app on X11
	optdepends = wayland: desktop app on Wayland
	optdepends = ele-messenger-server: also run the server on this machine
	provides = elemesh
	provides = ele-messenger-client
	conflicts = elemesh
	conflicts = ele-messenger-client
	replaces = elemesh
	replaces = ele-messenger-client

pkgname = ele-messenger-server
	pkgdesc = ELE Messenger server: accounts, direct messages, groups and images over the LAN, with a web client
	install = ele-messenger.install
	arch = any
	depends = python
	depends = python-fastapi
	depends = uvicorn
	depends = python-websockets
	depends = python-aiosqlite
	depends = python-bcrypt
	depends = nginx
	depends = avahi
	optdepends = ele-messenger: make this server a node of the ELE Mesh too
	optdepends = tailscale: reach the server off-site
	backup = usr/lib/ele-messenger/config.json
	backup = etc/avahi/services/ele-messenger.service
	backup = etc/nginx/sites-available/ele-messenger
	backup = etc/nginx/snippets/ele-messenger.conf
