pkgbase = clarion-git
	pkgdesc = Wayland compositor with native Vulkan rendering, HDR10/scRGB color management and an integrated GPUI desktop shell (git version)
	pkgver = 0.1.0.r93.ga758930
	pkgrel = 1
	url = https://github.com/123llyrr/clarion
	arch = x86_64
	arch = aarch64
