pkgbase = wegame-launcher
	pkgdesc = 开箱即用的简易 WeGame 启动器，使用 WE-Proton 运行
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/SHORiN-KiWATA/wegame-launcher
	arch = any
	license = GPL-3.0-only
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libx11
	depends = libxext
	depends = libxrandr
	depends = libxrender
	depends = libxi
	depends = libxcursor
	depends = libxinerama
	depends = libxcomposite
	depends = libxfixes
	depends = libxxf86vm
	depends = freetype2
	depends = fontconfig
	depends = gnutls
	depends = vulkan-icd-loader
	optdepends = vulkan-driver: 显卡的 Vulkan 驱动（DXVK 渲染需要）
	optdepends = libglvnd: OpenGL
	optdepends = libpulse: 声音
	optdepends = xdg-utils: 在文件管理器里打开文件夹
	optdepends = 7zip: 解压 WeGame 离线安装包（没有时自动下载）
	optdepends = gamescope: run WeGame nested in its own compositor
	optdepends = mangohud: performance overlay
	optdepends = passt: 独立网络命名空间，TUN 模式的加速器需要
	source = wegame-launcher-0.3.0.tar.gz::https://github.com/SHORiN-KiWATA/wegame-launcher/archive/refs/tags/v0.3.0.tar.gz
	sha256sums = 1644d414effd5c6561de81fb7ab22613c864226bd57522c522d41b1112e324c6

pkgname = wegame-launcher
