pkgbase = kappa-file-manager
	pkgdesc = Brutalist file manager for Ryoku OS (Rust core, Quickshell UI); independent community project
	pkgver = 0.1.4
	pkgrel = 1
	url = https://github.com/satodu/kappa-file-manager
	arch = x86_64
	arch = aarch64
	license = 0BSD
	makedepends = cargo
	depends = quickshell
	depends = ryoku-desktop
	depends = xdg-utils
	depends = udisks2
	depends = gcc-libs
	depends = glibc
	optdepends = kdeconnect: phone pairing, ping, ring and sharing
	optdepends = kio-fuse: browse phone folders as local files
	optdepends = rclone: browse Google Drive and OneDrive remotes (read-only mount)
	optdepends = matugen: Kappa-only color schemes (Appearance)
	optdepends = swww: set an image as wallpaper from the details panel
	optdepends = ghostty: default terminal for "Open terminal here" (any terminal in $TERMINAL also works)
