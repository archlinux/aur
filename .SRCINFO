pkgbase = limine-tool
	pkgdesc = Rust Limine boot entry manager and mkinitcpio integration tool
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/CatOS-dev/limine-tool
	arch = x86_64
	license = GPL-3.0-only
	makedepends = cargo
	depends = bash
	depends = coreutils
	depends = efibootmgr
	depends = limine
	depends = mkinitcpio
	depends = pacman
	depends = systemd
	depends = tar
	depends = util-linux
	optdepends = btrfs-progs: boot read-only Btrfs snapshots through the optional overlay hooks
	optdepends = doas: privilege escalation when limine-tool is run as a user
	optdepends = journalctl-desktop-notification: desktop notifications for hook failures
	optdepends = kernel-modules-hook: preserve a working kernel when an upgrade fails
	optdepends = sbctl: sign EFI binaries for Secure Boot
	optdepends = snapper: snapshot-aware UKI command-line handling
	optdepends = sudo: privilege escalation when limine-tool is run as a user
	provides = limine-entry-tool
	provides = limine-mkinitcpio-hook
	conflicts = limine-entry-tool
	conflicts = limine-mkinitcpio-hook
	options = !debug
	options = !lto
	backup = etc/limine-entry-tool.conf
	source = limine-tool-1.0.0.tar.gz::https://github.com/CatOS-dev/limine-tool/releases/download/v1.0.0/limine-tool-1.0.0.tar.gz
	sha256sums = 698cc18697ec508a7aec7d0f2f5fc4dae989a7f077a9a9a757232f99bf5b3e95

pkgname = limine-tool
