pkgbase = waft-git
	pkgdesc = Waft central daemon and plugin ecosystem (entity-based Wayland desktop services)
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/readyplayernan/waft
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = rust
	depends = gcc-libs
	depends = glibc
	depends = dbus
	optdepends = brightnessctl: laptop backlight control (brightness plugin)
	optdepends = ddcutil: external monitor brightness control (brightness plugin)
	optdepends = networkmanager: WiFi/Ethernet/VPN management (networkmanager plugin)
	optdepends = bluez: Bluetooth device management (bluez plugin)
	optdepends = bluez-utils: Bluetooth CLI tooling (bluez plugin)
	optdepends = pipewire-pulse: audio device control via pactl (audio plugin)
	optdepends = libpulse: audio device control via pactl (audio plugin)
	optdepends = upower: battery monitoring (battery plugin)
	optdepends = evolution-data-server: calendar integration (eds plugin)
	optdepends = gnome-online-accounts: online account integration (gnome-online-accounts plugin)
	optdepends = gsettings-desktop-schemas: GTK appearance configuration (gsettings plugin)
	optdepends = darkman: dark mode toggle (darkman plugin)
	optdepends = sunsetr: night light control (sunsetr plugin)
	optdepends = syncthing: file sync service toggle (syncthing plugin)
	optdepends = niri: niri compositor integration (niri plugin)
	provides = waft
	conflicts = waft
	conflicts = waft-plugin-audio-git
	conflicts = waft-plugin-battery-git
	conflicts = waft-plugin-bluez-git
	conflicts = waft-plugin-brightness-git
	conflicts = waft-plugin-caffeine-git
	conflicts = waft-plugin-darkman-git
	conflicts = waft-plugin-eds-git
	conflicts = waft-plugin-keyboard-layout-git
	conflicts = waft-plugin-networkmanager-git
	conflicts = waft-plugin-niri-git
	conflicts = waft-plugin-notifications-git
	conflicts = waft-plugin-sunsetr-git
	conflicts = waft-plugin-syncthing-git
	conflicts = waft-plugin-weather-git
	replaces = waft-plugin-audio-git
	replaces = waft-plugin-battery-git
	replaces = waft-plugin-bluez-git
	replaces = waft-plugin-brightness-git
	replaces = waft-plugin-caffeine-git
	replaces = waft-plugin-darkman-git
	replaces = waft-plugin-eds-git
	replaces = waft-plugin-keyboard-layout-git
	replaces = waft-plugin-networkmanager-git
	replaces = waft-plugin-niri-git
	replaces = waft-plugin-notifications-git
	replaces = waft-plugin-sunsetr-git
	replaces = waft-plugin-syncthing-git
	replaces = waft-plugin-weather-git
	source = waft-git::git+https://github.com/readyplayernan/waft.git
	sha256sums = SKIP

pkgname = waft-git
