pkgbase = viewport-wpe-bin
	pkgdesc = Wayland compositor whose entire shell is a web page — WPE WebKit, in-process (binary release)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/codebam/viewport
	arch = x86_64
	license = GPL-3.0-or-later
	depends = wayland
	depends = libxkbcommon
	depends = libdrm
	depends = libinput
	depends = seatd
	depends = systemd-libs
	depends = mesa
	depends = libglvnd
	depends = vulkan-icd-loader
	depends = wpewebkit
	depends = glib2
	depends = libxcb
	depends = pipewire
	depends = shared-mime-info
	optdepends = xorg-xwayland: X11 clients
	optdepends = xdg-desktop-portal-gtk: the portal interfaces the compositor does not answer itself
	optdepends = vulkan-radeon: AMD hardware
	optdepends = vulkan-intel: Intel hardware
	optdepends = nvidia-utils: NVIDIA hardware, and hardware video decode with it
	optdepends = vulkan-virtio: a virtual machine with 3D acceleration
	optdepends = vulkan-swrast: software Vulkan, for tests rather than a session
	optdepends = libva-mesa-driver: hardware video decode on AMD and Intel, for zero-copy video
	optdepends = ttf-firacode-nerd: the icons in the bar, and the font the shell names first
	optdepends = ttf-nerd-fonts-symbols: the icons in the bar, without the patched monospace family
