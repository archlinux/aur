pkgbase = rust-anything
	pkgdesc = Incrementally port applications to Rust and verify them against recorded behavior
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/erkamyaman/rust-anything
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = rust>=1:1.97
	depends = glibc
	depends = libgcc
	optdepends = rust: build Rust ports and run gate checks with Cargo, rustfmt, and Clippy
	optdepends = nodejs: record JavaScript and TypeScript behavior
	optdepends = python: run the Python and C recording and replay harnesses
	optdepends = gcc: compile C originals for recording
	optdepends = go: record Go behavior
	optdepends = ruby: record Ruby behavior
	optdepends = java-environment: provide javac and java for the Java harness
	conflicts = rust-anything-bin
	options = !lto
	source = rust-anything-2.0.0.tar.gz::https://github.com/erkamyaman/rust-anything/archive/refs/tags/v2.0.0.tar.gz
