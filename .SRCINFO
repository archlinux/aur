pkgbase = hex-bin
	pkgdesc = Hex voice dictation app by Anomaly: hold a key, speak, and it types (Linux beta; not the hex dump tool)
	pkgver = 3.0.0
	pkgrel = 1
	url = https://github.com/anomalyco/hex
	install = hex-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = alsa-lib
	depends = curl
	depends = gcc-libs
	depends = glibc
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = openblas
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = wl-clipboard: paste on Wayland
	optdepends = wtype: paste on Wayland
	optdepends = vulkan-driver: GPU transcription
	optdepends = wireplumber: mute output while dictating (or libpulse for pactl)
	optdepends = xdg-utils: open links from voice commands
	options = !strip
	options = !debug
	source = hex.desktop
	source = hex.service
	source = LICENSE
