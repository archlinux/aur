pkgname = shelly-bin
	pkgdesc = Shelly: A Modern Arch Package Manager (prebuilt binary)
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
