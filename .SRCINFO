pkgbase = wallpaperx-bin
	pkgdesc = Browse, manage, and apply Wallpaper Engine wallpapers on Linux
	pkgver = 0.4.15
	pkgrel = 1
	url = https://github.com/jagrat7/linux-wallpaper-engine
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = gtk3
