pkgbase = systempanel-git
	pkgdesc = Adaptive GTK4 system control panel
	pkgver = r20.36856cc
	pkgrel = 1
	url = https://github.com/cookiengineer/systempanel
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = go
	makedepends = git
	depends = gtk4
	optdepends = brightnessctl: Brightness View
	optdepends = bluez-utils: Bluetooth View (bluetoothctl)
	optdepends = feh: Wallpaper View (alternative to hsetroot)
	optdepends = hsetroot: Wallpaper View (alternative to feh)
	optdepends = networkmanager: LAN and Wi-Fi Views
	optdepends = power-profiles-daemon: Power Profile View (powerprofilesctl)
	optdepends = pulseaudio: Volume View (pactl)
	optdepends = smartmontools: S.M.A.R.T. details in Disks View
	optdepends = systemd: Services, Journal, Time & Date View (systemctl, journalctl, timedatectl)
	optdepends = udisks2: Disks View (udiskctl)
	optdepends = upower: Batteries View
	optdepends = util-linux: Disks View (lsblk)
	optdepends = xorg-xrandr: Monitors view
	source = systempanel::git+https://github.com/cookiengineer/systempanel.git
	sha256sums = SKIP

pkgname = systempanel-git
