	pkgrel = 2
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-7.1.3.zen2-2-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-7.1.3.zen2-2-x86_64.pkg.tar.zst
