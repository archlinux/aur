pkgbase = bbscord
	pkgdesc = Retro BBS-styled Rust Discord TUI with DAVE E2EE voice, WebRTC video, and GIFs
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/Bit-Loop/bbscord
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	checkdepends = gst-libav
	checkdepends = gst-plugins-ugly
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = pkgconf
	depends = alsa-lib
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gst-plugins-bad
	depends = gst-plugins-bad-libs
	depends = gst-plugins-base
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gstreamer
	depends = opus
	optdepends = btop: system btop .theme palettes auto-discovered in /usr/share/btop/themes
	optdepends = gst-libav: software H.264/VP8/VP9 fallback decoding for Go Live screenshares
	optdepends = gst-plugins-ugly: x264enc software H.264 broadcasting fallback
	optdepends = mpv: low-latency borderless pop-out window sink for Go Live screenshares
	optdepends = pipewire: Wayland screen capture and low-latency audio routing
	optdepends = wl-clipboard: Wayland clipboard copy and Ctrl+V image paste
	optdepends = xclip: X11 clipboard copy and Ctrl+V image paste
	optdepends = xdg-desktop-portal: Wayland/X11 portal monitor and window picker for Go Live
