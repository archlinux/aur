pkgbase = neuralrack
	pkgdesc = A neural model and impulse response file loader
	pkgver = 0.4.1
	pkgrel = 2
	url = https://github.com/brummer10/NeuralRack
	arch = aarch64
	arch = x86_64
	groups = pro-audio
	license = BSD-3-Clause
	checkdepends = lv2lint
	makedepends = cairo
	makedepends = freetype2
	makedepends = jack
	makedepends = libsndfile
	makedepends = lv2
	makedepends = xxd
	source = https://github.com/brummer10/NeuralRack/releases/download/v0.4.1/NeuralRack-v0.4.1-src.tar.xz
	sha256sums = 82b88d2aa20155d7522b7eea030b5e888eb1ca5559af47be9a4870fa5d6226f7

pkgname = neuralrack
	arch = any
	depends = neuralrack-clap
	depends = neuralrack-lv2
	depends = neuralrack-standalone
	depends = neuralrack-vst
	depends = neuralrack-vst3

pkgname = neuralrack-clap
	pkgdesc = A neural model and impulse response file loader – CLAP
	groups = pro-audio
	groups = clap-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = clap-host: for loading the CLAP plugin

pkgname = neuralrack-lv2
	pkgdesc = A neural model and impulse response file loader – LV2
	groups = pro-audio
	groups = lv2-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = lv2-host: for loading the LV2 plugin

pkgname = neuralrack-standalone
	pkgdesc = A neural model and impulse response file loader – JACK standalone
	depends = glibc
	depends = libasound.so
	depends = libcairo.so
	depends = libfreetype.so
	depends = libgcc
	depends = libjack.so
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11

pkgname = neuralrack-vst
	pkgdesc = A neural model and impulse response file loader – VST2
	groups = pro-audio
	groups = vst-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = vst-host: for loading the VST2 plugin

pkgname = neuralrack-vst3
	pkgdesc = A neural model and impulse response file loader – VST3
	groups = pro-audio
	groups = vst3-plugins
	depends = glibc
