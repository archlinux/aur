	optdepends = gvfs-mtp: Android phones over MTP
	optdepends = gvfs-smb: Windows and Samba shares
	optdepends = gvfs-gphoto2: cameras
	optdepends = ffmpeg: video thumbnails in folders that are not indexed
	optdepends = poppler: PDF thumbnails in folders that are not indexed
