pkgbase = libpamac-flatpak
	pkgdesc = Pamac package manager library based on libalpm. With Flatpak support
	pkgver = 11.7.2
	pkgrel = 1
	epoch = 1
	url = https://github.com/manjaro/libpamac
	install = pamac.install
	arch = i686
