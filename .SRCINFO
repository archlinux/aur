pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.16.zen2
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.16.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.16.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.16.zen2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-zen-6.16.zen2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-zen-headers-6.16.zen2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-zen-docs-6.16.zen2-1-x86_64.pkg.tar.zst
	sha256sums = 2dba6d634c89784ce336e6c4f15621200eab35a4cea16e946cd4e9aab8b81907
	sha256sums = fa564e1fc51f3cf8374f27b40771661971ce0e7a411ba8aabd6000df4edccd22
	sha256sums = 05911e89d587961c2d7b2f7582e7598538a5339b4ead3e312c6fca972451c9e8

pkgname = linux-zen-versioned-bin
	pkgdesc = Metapackage depending on linux6.16.zen2-1-zen-bin
	depends = linux6.16.zen2-1-zen-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-zen-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.16.zen2-1-zen-headers-bin
	depends = linux6.16.zen2-1-zen-headers-bin

pkgname = linux-zen-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.16.zen2-1-zen-docs-bin
	depends = linux6.16.zen2-1-zen-docs-bin

pkgname = linux6.16.zen2-1-zen-bin
	pkgdesc = The Linux ZEN kernel and modules, version 6.16.0-zen2-1-zen
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-zen

pkgname = linux6.16.zen2-1-zen-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux ZEN kernel 6.16.0-zen2-1-zen
	depends = pahole
	conflicts = linux-zen-headers

pkgname = linux6.16.zen2-1-zen-docs-bin
	pkgdesc = Documentation for the Linux ZEN kernel 6.16.0-zen2-1-zen
	conflicts = linux-zen-docs
