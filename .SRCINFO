pkgbase = eddie-cli-git
	pkgdesc = Eddie - VPN tunnel - CLI
	pkgver = 2.27.1
	pkgrel = 1
	url = https://eddie.website
	install = eddie-cli.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cmake
	makedepends = patchelf
	makedepends = dotnet-runtime>=10
	makedepends = dotnet-sdk>=10
	depends = curl
	depends = openvpn
	depends = sudo
	optdepends = stunnel: VPN over SSL
	optdepends = openssh: VPN over SSH
	provides = eddie-cli
	conflicts = airvpn
	conflicts = airvpn-beta-bin
	conflicts = airvpn-git
	conflicts = eddie-cli
	options = !strip
	source = git+https://github.com/AirVPN/Eddie.git
	sha256sums = SKIP

pkgname = eddie-cli-git
