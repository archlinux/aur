pkgname = linux-mainline-um5606
	pkgdesc = The Linux Mainline with patches for the Asus UM5606(WA) laptop kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware-git: linux firmware
	optdepends = linux-firmware-amd-staging-um5606-git: firmware cherry-picked for the UM5606
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-mainline-um5606-headers
	pkgdesc = Headers and scripts for building modules for the Linux Mainline with patches for the Asus UM5606(WA) laptop kernel
	depends = pahole

pkgname = linux-mainline-um5606-docs
	pkgdesc = Documentation for the Linux Mainline with patches for the Asus UM5606(WA) laptop kernel
