pkgname = blueferry-backend
	pkgdesc = iPhone Bluetooth bridge backend, daemon, CLI, and terminal client
	install = blueferry-backend.install
	depends = bluez>=5.86
	depends = bluez-obex
	depends = bluez-utils
	depends = git
	depends = libsecret
	depends = org.freedesktop.secrets
	depends = polkit
	depends = python
	depends = python-cryptography>=42
	depends = python-dbus
	depends = python-gobject
	depends = python-phonenumbers
	depends = python-regex>=2022.10.31
	depends = python-textual>=8.0
	depends = python-typer>=0.12
	depends = systemd
	optdepends = ofono: experimental phone calls (off by default)
	optdepends = wl-clipboard: copy one-time codes on Wayland (BLUEFERRY_OTP_AUTOCOPY)
	optdepends = xclip: copy one-time codes on X11 (BLUEFERRY_OTP_AUTOCOPY)
	optdepends = xsel: copy one-time codes on X11 (BLUEFERRY_OTP_AUTOCOPY)
	provides = blueferry-tui
	conflicts = blueferry-tui

pkgname = blueferry-gtk
	pkgdesc = GTK4/libadwaita client for BlueFerry
