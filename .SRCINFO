pkgbase = mavernix
	pkgdesc = A lightweight Wayland desktop session with a classic look
	pkgver = 0.6.2
	pkgrel = 1
	url = https://github.com/Mavernix/mavernix
	arch = x86_64
	license = GPL-3.0-or-later
	license = MIT
	makedepends = meson
	makedepends = ninja
	makedepends = glm
	makedepends = vulkan-headers
	depends = wayfire>=0.11.0
	depends = wayfire<0.12
	depends = quickshell
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = qt6-wayland
	depends = qt6-svg
	depends = qt6-imageformats
	depends = librsvg
	depends = glib2
	depends = tomlplusplus
	depends = libxcb
	depends = python
	depends = python-pillow
	depends = kvantum
	depends = gsettings-desktop-schemas
	depends = gvfs
	depends = adwaita-icon-theme
	depends = adwaita-icon-theme-legacy
	depends = adwaita-cursors
	depends = ttf-dejavu
	depends = 7zip
	depends = cpio
	depends = bzip2
	depends = lbzip2
	depends = libicns
	depends = ffmpeg
	depends = poppler
	depends = bubblewrap
	optdepends = foot: the terminal the dock and Super+Enter open
	optdepends = pipewire: sound, and the panel's volume item
	optdepends = wireplumber: sound
	optdepends = networkmanager: the panel's network item
	optdepends = bluez: the panel's Bluetooth item
	optdepends = upower: the panel's battery item
	optdepends = grim: pictures of the screen
	optdepends = slurp: pictures of a part of the screen
	optdepends = wl-clipboard: pictures of the screen into the clipboard
	optdepends = brightnessctl: brightness keys
	optdepends = playerctl: media keys
	optdepends = network-manager-applet: asking for a network password NetworkManager needs again, and networks that sign in with a user name or a certificate
	optdepends = dex: starting the programs in ~/.config/autostart
	optdepends = hwdata: the graphics card's name in About This Computer
	optdepends = xdg-desktop-portal-gtk: file choosers for sandboxed programs
	optdepends = xdg-desktop-portal-wlr: screen sharing
