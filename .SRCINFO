pkgbase = aura-emerge
	pkgdesc = Gentoo-style emerge for Arch Linux - installs from official repos, the AUR, and ABS, scans PKGBUILDs for supply-chain red flags before building, and runs untrusted build steps inside a bwrap sandbox.
	pkgver = 2.4.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0
	makedepends = rust
	makedepends = cargo
	depends = git
	depends = sudo
	optdepends = devtools: for --abs support (pkgctl repo clone)
	optdepends = gnupg: for PGP verification when building from ABS
	optdepends = bubblewrap: sandboxed builds (falls back to unsandboxed with --no-sandbox)
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	conflicts = aura-emerge-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v2.4.0
	sha256sums = 91a2bb9463356da162f4942c924e0ac852c37940888d102df57f496c5608cdff

pkgname = aura-emerge
