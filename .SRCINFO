	depends = libgcc
	depends = libstdc++
	depends = openvino>=2026.4
	depends = openvino<2026.5
	optdepends = openvino-intel-gpu-plugin: the OpenVINO GPU device (Intel graphics)
	optdepends = openvino-intel-npu-plugin: the OpenVINO NPU device (Intel NPU)
	optdepends = intel-compute-runtime: Intel graphics compute runtime (OpenVINO GPU device)
	optdepends = level-zero-loader: oneAPI Level Zero loader (OpenVINO GPU and NPU devices)
