pkgbase = markview-bin
	pkgdesc = A fast, native Markdown reader with publication-quality typography.
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/szdytom/markview
	install = markview-bin.install
	arch = x86_64
	license = MIT
	depends = fontconfig
	depends = glibc
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = wayland
	depends = vulkan-icd-loader
	depends = xdg-desktop-portal
	optdepends = noto-fonts-cjk: CJK glyphs for Chinese, Japanese, and Korean text
	optdepends = noto-fonts-emoji: colour Emoji glyphs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = vulkan-nouveau: Vulkan driver for NVIDIA GPUs with Nouveau
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	provides = markview
	conflicts = markview
	options = !strip
	options = !debug
	source = markview-bin-0.5.0.tar.gz::https://github.com/szdytom/markview/releases/download/v0.5.0/markview-x86_64-unknown-linux-gnu.tar.gz
