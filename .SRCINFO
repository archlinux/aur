pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.10.3.arch1-2-bin
	depends = linux6.10.3.arch1-2-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.10.3.arch1-2-headers-bin
	depends = linux6.10.3.arch1-2-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.10.3.arch1-2-docs-bin
	depends = linux6.10.3.arch1-2-docs-bin

pkgname = linux6.10.3.arch1-2-bin
	pkgdesc = The Linux kernel and modules, version 6.10.3-arch1-2
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.10.3.arch1-2-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.10.3-arch1-2
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.10.3.arch1-2-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.10.3-arch1-2
	conflicts = linux-docs
