pkgbase = nog
	pkgdesc = A tier-aware package manager for Arch Linux — pacman with a safety net, in Rust; one tool for the repos, the AUR, Flatpak and Snap: install, search, update, lock, clean. Arch and Arch-based distros; no desktop needed; works on a text console (tty)
	pkgver = 2.1.0
	pkgrel = 1
	url = https://github.com/jetomev/nog
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	depends = pacman
	depends = pacman-contrib
	depends = fakeroot
	depends = sudo
	depends = zstd
	optdepends = yay: AUR helper integration (preferred if installed)
	optdepends = paru: AUR helper integration (alternative)
	optdepends = flatpak: Flatpak apps installed, removed and updated through nog (offered when the install chain reaches it; off when absent)
	optdepends = snapd: snaps installed, removed and updated through nog (offered when the install chain reaches it; off when absent)
	options = !debug
	backup = etc/nog/nog.conf
	backup = etc/nog/tier-pins.toml
	source = nog-2.1.0.tar.gz::https://github.com/jetomev/nog/releases/download/v2.1.0/nog-2.1.0.tar.gz
	source = nog-2.1.0.tar.gz.asc::https://github.com/jetomev/nog/releases/download/v2.1.0/nog-2.1.0.tar.gz.asc
	validpgpkeys = 32E1D2AB9380BFD6BFE3BC1EAC2A3407CC070F9E
	sha256sums = fc6ed6880e7ce1294b095571d58bc59cec804859d63d9923ecc54832485fd897
	sha256sums = SKIP

pkgname = nog
