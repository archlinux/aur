	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.16.6.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.16.6.arch1-1-x86_64.pkg.tar.zst
