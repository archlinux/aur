pkgbase = mingw-w64-dlib
	pkgdesc = A general purpose cross-platform C++ library designed using contract programming and modern C++ techniques (mingw-w64)
	pkgver = 20.0.1
	pkgrel = 1
	url = http://dlib.net
	arch = any
	license = custom
	makedepends = mingw-w64-cmake
	depends = mingw-w64-crt
	depends = mingw-w64-cblas
	depends = mingw-w64-lapack
	depends = mingw-w64-libjpeg-turbo
	depends = mingw-w64-libpng
	optdepends = mingw-w64-ffmpeg: for FFmpeg support
	optdepends = mingw-w64-giflib: for GIF support
	optdepends = mingw-w64-libwebp: for WebP support
	optdepends = mingw-w64-sqlite: for sqlite support
	options = !strip
	options = staticlibs
	options = !buildflags
