pkgbase = linux-pf
	pkgdesc = pf-kernel
	pkgver = 6.19.pf2
	pkgrel = 1
	url = https://pfkernel.natalenko.name
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = cpio
	makedepends = gettext
	makedepends = libelf
	makedepends = pahole
	makedepends = perl
	makedepends = python
	makedepends = rust
	makedepends = rust-bindgen
	makedepends = rust-src
	makedepends = tar
	makedepends = xz
	options = !debug
	options = !strip
	source = https://codeberg.org/pf-kernel/linux/archive/9bbda1d89d7fedc8e2c9a6ece1addb9a75bd92b7.tar.gz
	source = config
	b2sums = SKIP
	b2sums = b81c55c7df09efe78c8add388e4c296bc9d091b037e2e53ef3574611b9fe59c72c1614ac8a361397d672b2c95084cb8d27152bcdcb56d108544ad5d251ccec9d

pkgname = linux-pf
	pkgdesc = The pf-kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-pf-headers: headers and scripts for building modules
	optdepends = ksmbd-tools: userspace tools for the ksmbd kernel SMB server
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = linux-pf
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = OVPN-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-pf-headers
	pkgdesc = Headers and scripts for building modules for the pf-kernel
	depends = pahole
	provides = LINUX-HEADERS
	provides = linux-pf-headers
