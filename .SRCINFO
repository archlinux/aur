pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 7.2.6.arch2
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-7.2.6.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-headers-7.2.6.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-docs-7.2.6.arch2-1-x86_64.pkg.tar.zst
