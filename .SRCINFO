pkgbase = modulejail
	pkgdesc = Proactively shrink Linux kernel-module attack surface by blacklisting unused modules
	pkgver = 1.6.0
	pkgrel = 1
	url = https://modulejail.com
	install = modulejail.install
	arch = any
	license = GPL-3.0-only
