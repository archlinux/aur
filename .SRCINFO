pkgbase = rustypaint
	pkgdesc = Paint 3D's 2D editor, without the 3D
	pkgver = 0.2.2
	pkgrel = 1
	url = https://github.com/ItzELECTR0/RustyPaint
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cargo
	makedepends = git
	depends = fontconfig
	depends = libxkbcommon
	depends = vulkan-icd-loader
	optdepends = xdg-desktop-portal: native file dialogs, and following the system colour scheme
	optdepends = vulkan-radeon: AMD GPU driver
	optdepends = nvidia-utils: NVIDIA GPU driver
	optdepends = vulkan-intel: Intel GPU driver
	options = !debug
	source = rustypaint::git+https://github.com/ItzELECTR0/RustyPaint.git#tag=v0.2.2
	b2sums = SKIP

pkgname = rustypaint
