pkgbase = loom-niri-git
	pkgdesc = Loom: a connected desktop ecosystem built around niri
	pkgver = r3929.g7989ab3
	pkgrel = 1
	url = https://github.com/fram446742/loom-niri
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = git
	makedepends = pkgconf
	makedepends = rust
	source = loom-niri::git+https://github.com/fram446742/loom-niri.git#branch=main
	source = loom-settings.desktop
	source = loom-desktop-git.README.md
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = loom-niri-git
	pkgdesc = niri-based compositor for Loom, coexisting with niri
	depends = cairo
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = libdisplay-info
	depends = libdrm
	depends = libglvnd
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = seatd
	depends = systemd-libs
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = xdg-desktop-portal: portal broker
	optdepends = xdg-desktop-portal-gtk: file chooser, notifications and fallback portals
	optdepends = xdg-desktop-portal-gnome: fallback ScreenCast backend
	optdepends = dbus: dbus-update-activation-environment used by the session script
	optdepends = systemd: systemctl, loginctl and busctl for session and idle integration
	optdepends = pipewire: screencasting server
	optdepends = wireplumber: PipeWire session manager
	optdepends = libnotify: notify-send for user hooks and scripts
	optdepends = alacritty: terminal in the default configuration
	optdepends = fuzzel: application launcher in the default configuration
	optdepends = mako: notification daemon
	optdepends = waybar: panel used by the default configuration
	optdepends = swaylock: screen locker in the default configuration
	optdepends = polkit-gnome: authentication agent for privileged applications
	optdepends = xwayland-satellite: run X11 applications in XWayland
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: GL/Vulkan driver for NVIDIA GPUs
	provides = loom-niri=0
	provides = wayland-compositor
	provides = xdg-desktop-portal-impl
	options = !strip

pkgname = loom-niri-replace-git
	pkgdesc = niri-based compositor for Loom, installed as niri
	depends = cairo
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = libdisplay-info
	depends = libdrm
	depends = libglvnd
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = seatd
	depends = systemd-libs
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = xdg-desktop-portal: portal broker
	optdepends = xdg-desktop-portal-gtk: file chooser, notifications and fallback portals
	optdepends = xdg-desktop-portal-gnome: fallback ScreenCast backend
	optdepends = dbus: dbus-update-activation-environment used by the session script
	optdepends = systemd: systemctl, loginctl and busctl for session and idle integration
	optdepends = pipewire: screencasting server
	optdepends = wireplumber: PipeWire session manager
	optdepends = libnotify: notify-send for user hooks and scripts
	optdepends = alacritty: terminal in the default configuration
	optdepends = fuzzel: application launcher in the default configuration
	optdepends = mako: notification daemon
	optdepends = waybar: panel used by the default configuration
	optdepends = swaylock: screen locker in the default configuration
	optdepends = polkit-gnome: authentication agent for privileged applications
	optdepends = xwayland-satellite: run X11 applications in XWayland
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: GL/Vulkan driver for NVIDIA GPUs
	provides = niri=0
	provides = loom-niri-replace=0
	provides = wayland-compositor
	provides = xdg-desktop-portal-impl
	conflicts = niri
	conflicts = niri-git
	options = !strip

pkgname = loom-portal-git
	pkgdesc = Standalone Screenshot/ScreenCast portal backend for Loom
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = systemd
	optdepends = xdg-desktop-portal: broker that loads loom.portal
	optdepends = xdg-desktop-portal-gtk: fallback for interfaces loom-portal does not implement

pkgname = loom-companion-git
	pkgdesc = Automation and parking daemon for Loom
	depends = gcc-libs
	depends = glibc
	optdepends = systemd: loginctl, busctl and systemctl for idle and lock actions, plus the optional user unit
	optdepends = libpulse: pactl probe for idle detection
	optdepends = libnotify: notify-send in user hooks

pkgname = loom-monitor-git
	pkgdesc = Output profile save, apply and rollback for Loom
	depends = gcc-libs
	depends = glibc
	optdepends = wl-mirror: apply profile mirror relations

pkgname = loom-session-git
	pkgdesc = Named workspace, window and output contexts for Loom
	depends = gcc-libs
	depends = glibc

pkgname = loom-shot-git
	pkgdesc = Screenshot capture for Loom with annotations and clipboard support
	depends = gcc-libs
	depends = glibc
	optdepends = satty: interactive annotation for loom-shot --annotate
	optdepends = wl-clipboard: wl-copy/wl-paste for loom-shot --copy

pkgname = loom-wallpaper-git
	pkgdesc = Per-workspace wallpaper scenes for Loom
	depends = gcc-libs
	depends = glibc
	depends = wayland
	optdepends = swaybg: default wallpaper command for the command backend
	optdepends = swww: alternative wallpaper daemon for the command backend

pkgname = loom-settings-git
	pkgdesc = GTK4/libadwaita control center and CLI for Loom
	depends = gcc-libs
	depends = glibc
	depends = gtk4
	depends = libadwaita

pkgname = loom-audio-git
	pkgdesc = Rule-based PipeWire audio routing for Loom
	depends = gcc-libs
	depends = glibc
	depends = libpipewire
	optdepends = pipewire: audio server used by the native backend
	optdepends = wireplumber: PipeWire session manager providing wpctl
	optdepends = libpulse: pactl backend for PipeWire PulseAudio compatibility
	optdepends = pulseaudio: alternative sound server providing pactl

pkgname = loom-sidepanels-git
	pkgdesc = Layer-shell panels with exclusive zones for Loom
	depends = cairo
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = wayland
	optdepends = playerctl: media module
	optdepends = libpulse: pactl backend for the volume module
	optdepends = wireplumber: wpctl backend for the volume module
	optdepends = libnotify: notify-send actions

pkgname = loom-tui-git
	pkgdesc = Loom dashboard for outputs, workspaces and windows
	depends = gcc-libs
	depends = glibc
	optdepends = loom-niri-git: live compositor state

pkgname = loom-noctalia-plugins-git
	pkgdesc = Noctalia bar plugins for the Loom tools
	arch = any
	depends = 
	optdepends = noctalia: shell that loads these Luau plugins
	optdepends = loom-companion: status and action widgets
	optdepends = loom-monitor: output profile widget
	optdepends = loom-session: context switcher widget
	optdepends = loom-shot: screenshot widget
	optdepends = loom-audio: default sink widget
	optdepends = loom-wallpaper: scene widget
	optdepends = loom-sidepanels: panel reload widget

pkgname = loom-desktop-git
	pkgdesc = Meta package for Loom: coexisting compositor, portal and tools
	install = loom-desktop-git.install
	depends = loom-niri-git
	depends = loom-portal-git
	depends = loom-companion-git
	depends = loom-monitor-git
	depends = loom-session-git
	depends = loom-shot-git
	depends = loom-wallpaper-git
	depends = loom-settings-git
	depends = loom-audio-git
	depends = loom-sidepanels-git
	depends = loom-tui-git
	depends = loom-noctalia-plugins-git
	optdepends = xdg-desktop-portal: portal broker for loom-niri.portal and loom.portal
	optdepends = xdg-desktop-portal-gtk: fallback portal for file chooser and friends
	optdepends = pipewire: audio and screencasting server
	optdepends = wireplumber: PipeWire session manager and wpctl
	optdepends = dbus: dbus-update-activation-environment used by loom-niri-session
	optdepends = systemd: systemctl, loginctl and busctl integration
