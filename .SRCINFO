pkgbase = cachy-auto-update
	pkgdesc = Unattended background updates for CachyOS, aware of battery, gaming and manual package management
	pkgver = 2.0.1
	pkgrel = 1
	url = https://github.com/LoonixTools/cachy-auto-update
	install = cachy-auto-update.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = scdoc
	depends = bash
	depends = coreutils
	depends = gcc-libs
	depends = glibc
	depends = pacman
	depends = polkit
	depends = procps-ng
	depends = sudo
	depends = systemd
	depends = util-linux
	depends = fontconfig
	depends = hicolor-icon-theme
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
