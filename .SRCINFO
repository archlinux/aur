pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.38
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.38-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.38-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.38-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.38-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.38-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.38-1-x86_64.pkg.tar.zst
	sha256sums = 08e3a0863312da668891aa9664d4e08779df567f5eeb87637e14e7dcf628db37
