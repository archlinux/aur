pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.49
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.49-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.49-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.49-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.49-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.49-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.49-1-x86_64.pkg.tar.zst
	sha256sums = 5ea6f36f1a52b00018b218baf852836021f48c34667606195f68767556c4e183
	sha256sums = e9ff5be359e1cba271318c0d0da9f483d1834b346c1d248fd42da5fc8a8c2fb3
	sha256sums = 0f8e7b6fa2a84e5c15908b98674f335fd15b2d07eba7cfe0072ceee4ae5e5a63

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.49-1-lts-bin
	depends = linux6.18.49-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.49-1-lts-headers-bin
	depends = linux6.18.49-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.49-1-lts-docs-bin
	depends = linux6.18.49-1-lts-docs-bin

pkgname = linux6.18.49-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.49-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.49-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.49-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.49-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.49-1-lts
	conflicts = linux-lts-docs
