	optdepends = gdb: native GNU debugger
	optdepends = lldb: native LLVM debugger
	optdepends = gcc: GNU compiler
	optdepends = clang: LLVM compiler
	optdepends = gtest: C++ testing
	optdepends = python: Python language support
