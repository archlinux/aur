pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.66
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.66-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.66-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.66-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.66-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.66-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.66-1-x86_64.pkg.tar.zst
	sha256sums = ca46a52db2b43d0e4cdcf79f45c2a0c88cbac4b4f017e2cf0da2a987b6767461
	sha256sums = 61bb55193c043f4bdef77a98886fcbaef3fdee342681a9cbfd3ad0de8ee8764e
	sha256sums = bb1df3dee431995f158b50a1aaab2dcc7b85ba6dfaa3c1a9b8f6091fb2ba3309

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.66-1-lts-bin
	depends = linux6.12.66-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.66-1-lts-headers-bin
	depends = linux6.12.66-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.66-1-lts-docs-bin
	depends = linux6.12.66-1-lts-docs-bin

pkgname = linux6.12.66-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.66-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.66-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.66-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.66-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.66-1-lts
	conflicts = linux-lts-docs
