pkgbase = thinkrail
	pkgdesc = Lightweight IDE for vibe coding with the pi agent (desktop app and browser-based CLI)
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/JetBrains/thinkrail
	arch = x86_64
	license = Apache-2.0
	makedepends = bun
	makedepends = patch
	depends = cairo
	depends = gcc-libs
	depends = gdk-pixbuf2
	depends = git
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = icu
	depends = libayatana-appindicator
	depends = librsvg
	depends = libsoup3
	depends = libx11
	depends = webkit2gtk-4.1
	optdepends = xdg-utils: open the browser when launching the CLI
	optdepends = xorg-xwayland: run the desktop app on Wayland, it only speaks X11
	optdepends = ripgrep: otherwise pi downloads its own copy on first use
	optdepends = fd: otherwise pi downloads its own copy on first use
	conflicts = thinkrail-bin
	noextract = electrobun-core-2.0.5-x64.tar.gz
	options = !strip
	options = !debug
	source = thinkrail-0.3.1.tar.gz::https://github.com/JetBrains/thinkrail/archive/refs/tags/v0.3.1.tar.gz
	source = pacman-managed.patch
	source = thinkrail-desktop.sh
	source = thinkrail.desktop
