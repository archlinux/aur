pkgbase = neuralrack
	pkgdesc = A neural model and impulse response file loader
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/brummer10/NeuralRack
	arch = aarch64
	arch = x86_64
	groups = pro-audio
	license = BSD-3-Clause
	checkdepends = lv2lint
	makedepends = cairo
	makedepends = jack
	makedepends = libsndfile
	makedepends = lv2
	makedepends = portaudio
	makedepends = xxd
	depends = glibc
	depends = gcc-libs
	depends = libx11
	source = https://github.com/brummer10/NeuralRack/releases/download/v0.3.1/NeuralRack-v0.3.1-src.tar.xz
	sha256sums = d1c491531274e4bf0cbccfc43298b6b2b6980fbb0d3538eac015edb606d481d5

pkgname = neuralrack
	arch = any
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = neuralrack-clap
	depends = neuralrack-lv2
	depends = neuralrack-standalone
	depends = neuralrack-vst

pkgname = neuralrack-clap
	pkgdesc = A neural model and impulse response file loader – CLAP
	groups = pro-audio
	groups = clap-plugins
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libcairo.so
	depends = libsndfile.so
	optdepends = clap-host: for loading the CLAP plugin

pkgname = neuralrack-lv2
	pkgdesc = A neural model and impulse response file loader – LV2
	groups = pro-audio
	groups = lv2-plugins
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libcairo.so
	depends = libsndfile.so
	optdepends = lv2-host: for loading the LV2 plugin

pkgname = neuralrack-standalone
	pkgdesc = A neural model and impulse response file loader – JACK standalone
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libasound.so
	depends = libcairo.so
	depends = libjack.so
	depends = libportaudio.so
	depends = libsndfile.so

pkgname = neuralrack-vst
	pkgdesc = A neural model and impulse response file loader – VST2
	groups = pro-audio
	groups = vst-plugins
	depends = glibc
	depends = gcc-libs
	depends = libx11
	depends = libcairo.so
	depends = libsndfile.so
	optdepends = vst-host: for loading the VST2 plugin
