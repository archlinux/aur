pkgname = onnxruntime-provider-openvino
	pkgdesc = The OpenVINO execution provider of ONNX Runtime, for onnxruntime-core (Intel CPU, GPU and NPU)
	depends = onnxruntime-core=1.29.0-7
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = openvino
	optdepends = openvino-intel-gpu-plugin: the OpenVINO GPU device (Intel graphics)
	optdepends = openvino-intel-npu-plugin: the OpenVINO NPU device (Intel NPU)
	optdepends = intel-compute-runtime: Intel graphics compute runtime (OpenVINO GPU device)
	optdepends = level-zero-loader: oneAPI Level Zero loader (OpenVINO GPU and NPU devices)
	optdepends = intel-npu-driver: Intel NPU user-space driver (OpenVINO NPU device)
	conflicts = onnxruntime-core-nccloff

pkgname = onnxruntime-provider-dnnl
	pkgdesc = The oneDNN execution provider of ONNX Runtime, for onnxruntime-core (CPU)
