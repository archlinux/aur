pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.10.zen1
	pkgrel = 2
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.10.zen1-2-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.10.zen1-2-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.10.zen1-2-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-6.10.zen1-2-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-headers-6.10.zen1-2-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-docs-6.10.zen1-2-x86_64.pkg.tar.zst
	sha256sums = f5572e8d58d4021e8ae3259845efbe33542667b988f431d7c089d278c4c5081b
	sha256sums = 87671a2a2d99e13181264aba779638a0563922a067f8ff299aad9eebf3e6b986
	sha256sums = 530b325b4dd8840c7e83d855cd3f82f42b3e3841221fe477685889c1bbdc36fc

pkgname = linux-zen-versioned-bin
	pkgdesc = Metapackage depending on linux6.10.zen1-2-zen-bin
	depends = linux6.10.zen1-2-zen-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-zen-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.10.zen1-2-zen-headers-bin
	depends = linux6.10.zen1-2-zen-headers-bin

pkgname = linux-zen-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.10.zen1-2-zen-docs-bin
	depends = linux6.10.zen1-2-zen-docs-bin

pkgname = linux6.10.zen1-2-zen-bin
	pkgdesc = The Linux ZEN kernel and modules, version 6.10.0-zen1-2-zen
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = UKSMD-BUILTIN
	provides = VHBA-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-zen

pkgname = linux6.10.zen1-2-zen-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux ZEN kernel 6.10.0-zen1-2-zen
	depends = pahole
	conflicts = linux-zen-headers

pkgname = linux6.10.zen1-2-zen-docs-bin
	pkgdesc = Documentation for the Linux ZEN kernel 6.10.0-zen1-2-zen
	conflicts = linux-zen-docs
