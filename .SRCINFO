pkgbase = linux-trackpad-driver
	pkgdesc = Extensible userspace Linux driver for enhanced trackpad functionality, currently supporting Apple Magic Trackpad 2
	pkgver = 0.1.3
	pkgrel = 2
	url = https://github.com/aaronroquefonseca/linux-trackpad-driver
	install = ltd.install
	arch = x86_64
	arch = aarch64
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	depends = gcc-libs
	depends = glibc
	depends = systemd
	optdepends = libinput: pointer/palm processing for passthrough events and hwdb quirks (see INSTALL.md "hwdb note")
	conflicts = linux-trackpad-driver-bin
	conflicts = linux-trackpad-driver-git
	backup = etc/linux-trackpad-driver/config.toml
	source = linux-trackpad-driver-0.1.3.tar.gz::https://github.com/aaronroquefonseca/linux-trackpad-driver/archive/refs/tags/v0.1.3.tar.gz
	sha256sums = 62159ecf136f8467829c27659a01915568931c854bff7ee1ef976ae9d4de9f97

