	optdepends = ydotool: for Wayland mousepad support
	optdepends = xdotool: for X11 mousepad support
	optdepends = wtype: for Wayland keyboard emulation
	optdepends = python-nautilus: for Nautilus file manager integration
	provides = kcd
	conflicts = kcd
	options = !strip
	options = !debug
