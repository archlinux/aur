pkgbase = waycast-bin
	pkgdesc = Miracast source for wlroots compositors, with Hyprland extend-desktop support (prebuilt)
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/alchemy/waycast
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glib2
	depends = gstreamer
	depends = gst-plugins-base-libs
	depends = gst-plugin-pipewire
	depends = gst-plugins-good
	depends = gst-plugins-bad
	depends = gst-plugins-bad-libs
	depends = gst-plugins-ugly
	depends = pipewire
	depends = wireplumber
	depends = networkmanager
	depends = wpa_supplicant
	depends = xdg-desktop-portal
	optdepends = xdg-desktop-portal-hyprland: screen capture on Hyprland
	optdepends = xdg-desktop-portal-wlr: screen capture on Sway, River, Labwc
	optdepends = hyprland: extend-desktop mode via a headless output
	optdepends = gst-plugin-va: hardware H.264 encoding on Intel and AMD (VA-API)
	optdepends = intel-media-driver: VA-API driver for Intel Broadwell and newer
	optdepends = mesa: VA-API driver for AMD (provides libva-mesa-driver)
	optdepends = dnsmasq: DHCP for the sink when waycast becomes the Wi-Fi Direct group owner
