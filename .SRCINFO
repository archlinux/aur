pkgbase = venture-git
	pkgdesc = Meta Quest emulator for PC VR (git main)
	pkgver = 0.2.4.r0.gf5cca87
	pkgrel = 1
	url = https://venture-emu.org/
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = lld
	makedepends = llvm
	makedepends = cmake
	makedepends = ninja
	makedepends = git
	makedepends = python
	makedepends = make
	makedepends = pkgconf
	makedepends = curl
	depends = glibc
	depends = gcc-libs
	depends = vulkan-icd-loader
	optdepends = libsecret: keep sign-ins in the desktop keyring
	optdepends = fontconfig: system fonts in the launcher
	optdepends = monado: OpenXR runtime
	optdepends = wivrn-server: OpenXR runtime for streaming to a standalone headset
	provides = venture
	conflicts = venture
	conflicts = venture-bin
	options = !strip
	options = !debug
	options = !lto
	source = venture::git+https://github.com/Villagers654/Venture.git#branch=main
	sha256sums = SKIP

pkgname = venture-git
