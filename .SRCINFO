pkgbase = system-bridge
	pkgdesc = A bridge for your systems
	pkgver = 5.32.0
	pkgrel = 1
	epoch = 2
	url = https://github.com/timmo001/system-bridge
	install = system-bridge.install
	arch = x86_64
	license = Apache-2.0
	makedepends = git
	makedepends = mise
	depends = libx11
	depends = libxtst
	depends = libxkbcommon
	depends = libxkbcommon-x11
	optdepends = lm_sensors: broader temperature and fan sensor coverage
	optdepends = nvidia-utils: NVIDIA GPU metrics via nvidia-smi
	optdepends = pciutils: GPU model identification via lspci
	optdepends = pipewire: name apps using the microphone or camera via pw-dump
	optdepends = zenity: tray and desktop confirmation prompts
	optdepends = libpulse: audio devices, controls and notification sounds via pactl and paplay
	optdepends = alsa-utils: notification sounds via aplay
	optdepends = bluez: Bluetooth devices and controls
	optdepends = ddcutil: external monitor brightness and power over DDC/CI
	provides = system-bridge
	conflicts = system-bridge-git
	conflicts = system-bridge-git-debug
	options = !strip
