	optdepends_aarch64 = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends_aarch64 = dotool: keyboard simulation with layout support (KDE/GNOME compatible)
	optdepends_aarch64 = ydotool: keyboard simulation fallback (X11/TTY support)
	optdepends_aarch64 = wl-clipboard: clipboard support
	optdepends_aarch64 = libnotify: desktop notifications
	optdepends_aarch64 = pipewire: audio server (recommended)
	optdepends_aarch64 = pipewire-alsa: ALSA compatibility for PipeWire (required if using PipeWire)
	optdepends_aarch64 = pulseaudio: audio server (alternative to PipeWire)
	optdepends_aarch64 = ollama: local AI summarization for meeting mode
	optdepends_aarch64 = gtk4-layer-shell: runtime for the GTK4 on-screen mic visualizer (voxtype-osd-gtk4)
	optdepends_aarch64 = quickshell: Quickshell-based OSD frontend (opt in via [osd] frontend = "quickshell")
