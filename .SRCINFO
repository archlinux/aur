	depends = qt6-declarative
	depends = qt6-5compat
	depends = cairo
	depends = wayland
	depends = gdk-pixbuf2
	depends = libjxl
	depends = libavif
	depends = libheif
	depends = libpng
	optdepends = asteroidz: the compositor this draws the bar for
	optdepends = cava: the media visualiser
	optdepends = pipewire: the volume module
	optdepends = pipewire-audio: audible notifications (pw-play)
