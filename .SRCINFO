	source = Shelly-ALPM-linux-x64-3.1.1.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/releases/download/v3.1.1/Shelly-ALPM-linux-x64.tar.gz
	source = Shelly-Flatpak-Backend-linux-x64-3.1.1.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/releases/download/v3.1.1/Shelly-Flatpak-Backend-linux-x64.tar.gz
	source = shellybuild.conf
	sha256sums = 88e5af418457211d4848ebf28886b9f667a347bbe8355339821cbf5d386267dd
	sha256sums = a6db86a40816351bd79aff037206267bcf2488e272262d50622d134ee6ca3b61
