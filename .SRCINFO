pkgbase = wap-bin
	pkgdesc = Wap - Chromium-based browser with a local AI agent daemon and CLI (prebuilt)
	pkgver = 0.0.50
	pkgrel = 1
	url = https://github.com/minpeter/wap
	install = wap-bin.install
	arch = x86_64
	license = LicenseRef-Wap
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = libcups
	depends = libx11
	depends = libxcb
	depends = libxcomposite
	depends = libxdamage
	depends = libxext
	depends = libxfixes
	depends = libxkbcommon
	depends = libxrandr
	depends = mesa
	depends = nspr
	depends = nss
	depends = pango
	depends = systemd-libs
	optdepends = xorg-server-xvfb: run the browser when no X display is available
	optdepends = bubblewrap: sandbox agent shell commands when WAP_ENABLE_BWRAP_SANDBOX=1
	optdepends = libpulse: PulseAudio/PipeWire audio output (ALSA is used otherwise)
	optdepends = pciutils: GPU detection for hardware acceleration
	optdepends = qt5-base: Qt 5 UI integration
	optdepends = qt6-base: Qt 6 UI integration
	optdepends = python: run the Context Awareness capture helper
	optdepends = python-gobject: observe other apps for Context Awareness (AT-SPI bindings)
	optdepends = tesseract: on-device screen text (OCR) for Context Awareness
	optdepends = tesseract-data-eng: English OCR data for Context Awareness
	optdepends = grim: Wayland screenshots for Context Awareness screen text
	optdepends = 1password-cli: 1Password integration
	provides = wap
	conflicts = wap
	options = !strip
	options = !debug
	source = wap-0.0.50-linux-x64.tar.gz::https://github.com/minpeter/wap/releases/download/wap@0.0.50/wap-0.0.50-linux-x64.tar.gz
	source = wap-0.0.50-LICENSE::https://raw.githubusercontent.com/minpeter/wap/wap@0.0.50/LICENSE
	source = wap-0.0.50-THIRD_PARTY_NOTICES.md::https://github.com/minpeter/wap/releases/download/wap@0.0.50/wap-0.0.50-THIRD_PARTY_NOTICES.md
