pkgbase = intel-ipu7-ir-dkms
	pkgdesc = Infrared camera and face-unlock support for Intel IPU7 laptops (Himax HM1092 behind a Synaptics SVP7500 bridge)
	pkgver = 1.0.3
	pkgrel = 1
	url = https://github.com/jibsta210/svp7500-camera-fix-pack
	install = intel-ipu7-ir-dkms.install
	arch = any
	license = GPL-2.0-only
	depends = dkms
	optdepends = intel-ipu7-dkms-git: the IPU7 ISYS/PSYS vendor drivers — the camera cannot work without them
	optdepends = howdy: infrared face authentication (this package ships the IR recorder it needs)
	optdepends = libcamera: to enumerate and test the cameras
	optdepends = v4l-utils: media-ctl and v4l2-ctl, used by the verification tooling
	optdepends = zstd: lets verify.sh read compressed modules to check what was actually built
	source = intel-ipu7-ir-dkms-1.0.3.tar.gz::https://github.com/jibsta210/svp7500-camera-fix-pack/archive/refs/tags/v1.0.3.tar.gz
	sha256sums = cc1b9d381cc3e7068fcb370cbb5b7ca45f6a9b325bb44dcfa23a627c092174a6

pkgname = intel-ipu7-ir-dkms
