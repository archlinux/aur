pkgbase = dffy-bin
	pkgdesc = Fast terminal diff viewer for git, built for large repositories: file tree and split or unified view, syntax-aware diff, watch mode, JSON output and an MCP server for coding agents
	pkgver = 0.4.1
	pkgrel = 1
	url = https://github.com/amalucelli/dffy
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	optdepends = git: reviewing a repository, which is what dffy is for (it also diffs two files on its own)
	optdepends = dffy-render-markdown-bin: render Markdown files, after adding "render = md:markdown" to ~/.config/dffy/config
	optdepends = dffy-render-mermaid-bin: draw Mermaid diagrams, after adding "render = mmd:mermaid mermaid:mermaid" to ~/.config/dffy/config
	provides = dffy
	conflicts = dffy
	conflicts = dffy-git
	noextract = dffy_0.4.1_linux_amd64.tar.gz
	noextract = dffy_0.4.1_linux_arm64.tar.gz
	options = !strip
	options = !debug
	source_x86_64 = dffy_0.4.1_linux_amd64.tar.gz::https://github.com/amalucelli/dffy/releases/download/v0.4.1/dffy_linux_amd64.tar.gz
	sha256sums_x86_64 = ada7a2f8d50c9cad28cce1de951774a5facc3441c75a622bfcf397b968f536a6
	source_aarch64 = dffy_0.4.1_linux_arm64.tar.gz::https://github.com/amalucelli/dffy/releases/download/v0.4.1/dffy_linux_arm64.tar.gz
	sha256sums_aarch64 = cc4acf442143d80647a0c0f8e48222ec430c820b89345c38e7740198c3e075f5

pkgname = dffy-bin
