pkgbase = linux-zenith
	pkgdesc = Android™ Generic Project's Zenith linux kernel - 6.18 branch
	pkgver = 6.18.21
	pkgrel = 1
	url = https://github.com/android-generic/kernel-zenith.git
	arch = x86
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = clang-android
	makedepends = cpio
	makedepends = gettext
	makedepends = git
	makedepends = libelf
	makedepends = lld
	makedepends = llvm
	makedepends = pahole
	makedepends = perl
	makedepends = python
	makedepends = rust
	makedepends = rust-bindgen
	makedepends = rust-src
	makedepends = tar
	makedepends = xz
	makedepends = zstd
	optdepends = modloader: for loading Android kernel modules
	options = !strip
	options = !debug
	options = !lto
	source = linux-zenith::shallowclone+https://github.com/android-generic/kernel-zenith.git?branch=6.18&depth=1
	source = zenith_linux-x86_64_defconfig
	sha256sums = SKIP
	sha256sums = 159f072734e2624a395e45dace1cd2052b27eaff07a6a98d24833d0c633db9da

pkgname = linux-zenith-git
	pkgdesc = The Android™ Generic Project's Zenith linux kernel - 6.18 branch kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE

pkgname = linux-zenith-git-headers
	pkgdesc = Headers and scripts for building modules for the Android™ Generic Project's Zenith linux kernel - 6.18 branch kernel
	depends = pahole
	depends = linux-zenith-git
