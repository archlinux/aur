pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.47
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.47-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.47-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.47-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.47-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.47-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.47-1-x86_64.pkg.tar.zst
	sha256sums = c18db0356cc270692d0f5ef48daca3c3a8066fca33c302df33d7d35ff332a1ca
	sha256sums = baa803874471e26a2edade9b3568db3fc026db5da6977b781c4949c02ceb70e4
	sha256sums = 0f6600a9db7ab8f377c76d22871b4a5e776d7c7edb5bfe222a72fe8176a7d9cd

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.47-1-lts-bin
	depends = linux6.12.47-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.47-1-lts-headers-bin
	depends = linux6.12.47-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.47-1-lts-docs-bin
	depends = linux6.12.47-1-lts-docs-bin

pkgname = linux6.12.47-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.47-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.47-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.47-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.47-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.47-1-lts
	conflicts = linux-lts-docs
