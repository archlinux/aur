	makedepends_x86_64 = gcc-multilib
	makedepends_x86_64 = lib32-gcc-libs

pkgname = noaidarling-git
	pkgdesc = Translation layer for running macOS software on Linux. Clean room: without AI contamination
	depends = noaidarling-cli-git
	depends = noaidarling-python2-git
	depends = noaidarling-ruby-git
	depends = noaidarling-perl-git
	depends = noaidarling-gui-git
	depends = noaidarling-gui-stubs-git
	depends = noaidarling-pyobjc-git
	provides = noaidarling
	provides = noaidarling-cli-devenv
	provides = darling
	provides = darling-cli-devenv
	conflicts = darling
	conflicts = darling-git

pkgname = noaidarling-extra-git
	pkgdesc = Extra components for NoAiDarling that are not part of a typical ("stock") installation
	depends = noaidarling-git
	depends = noaidarling-jsc-git
	depends = noaidarling-cli-extra-git
	provides = noaidarling-extra
	provides = darling-extra
	conflicts = darling-extra
	conflicts = darling-extra-git

pkgname = noaidarling-core-git
	pkgdesc = Core components of NoAiDarling
	depends = glibc
	depends = gcc-libs
	depends = xdg-user-dirs
	provides = noaidarling-core
	provides = darling-core
	conflicts = darling-core
	conflicts = darling-core-git
	depends_x86_64 = lib32-glibc
	depends_x86_64 = lib32-gcc-libs

pkgname = noaidarling-system-git
	pkgdesc = System components of NoAiDarling
	depends = noaidarling-core-git
	provides = noaidarling-system
	provides = darling-system
	conflicts = darling-system
	conflicts = darling-system-git

pkgname = noaidarling-cli-git
	pkgdesc = CLI components of NoAiDarling
	depends = noaidarling-system-git
	depends = noaidarling-cli-gui-common-git
	depends = noaidarling-cli-python2-common-git
	depends = fuse
	provides = noaidarling-cli
	provides = darling-cli
	conflicts = darling-cli
	conflicts = darling-cli-git

pkgname = noaidarling-ffi-git
	pkgdesc = libffi built for use within NoAiDarling
	depends = noaidarling-core-git
	provides = noaidarling-ffi
	provides = darling-ffi
	conflicts = darling-ffi
	conflicts = darling-ffi-git

pkgname = noaidarling-cli-devenv-git
	pkgdesc = A NoAiDarling environment for CLI-only programs for building and developing using the command line developer tools
	depends = noaidarling-cli-git
	depends = noaidarling-python2-git
	depends = noaidarling-ruby-git
	depends = noaidarling-perl-git
	depends = noaidarling-cli-devenv-gui-common-git
	depends = noaidarling-cli-devenv-gui-stubs-common-git
	depends = noaidarling-iosurface-git
	provides = noaidarling-cli-devenv
	provides = darling-cli-devenv
	conflicts = darling-cli-devenv
	conflicts = darling-gui
	conflicts = darling-gui-stubs
	conflicts = darling-cli-devenv-git

pkgname = noaidarling-cli-gui-common-git
	pkgdesc = Components of NoAiDarling that are shared between the CLI and GUI components
	depends = noaidarling-system-git
	provides = noaidarling-cli-gui-common
	provides = darling-cli-gui-common
	conflicts = darling-cli-gui-common
	conflicts = darling-cli-gui-common-git

pkgname = noaidarling-iokitd-git
	pkgdesc = IOKit daemon for NoAiDarling
	depends = noaidarling-system-git
	depends = noaidarling-iosurface-git
	provides = noaidarling-iokitd
	provides = darling-iokitd
	conflicts = darling-iokitd
	conflicts = darling-iokitd-git

pkgname = noaidarling-cli-devenv-gui-common-git
	pkgdesc = Components of NoAiDarling that are shared between the developer environment and the GUI components
	depends = noaidarling-system-git
	provides = noaidarling-cli-devenv-gui-common
	provides = darling-cli-devenv-gui-common
	conflicts = darling-cli-devenv-gui-common
	conflicts = darling-cli-devenv-gui-common-git

pkgname = noaidarling-cli-extra-git
	pkgdesc = Non-standard CLI components of NoAiDarling
	depends = noaidarling-cli-git
	provides = noaidarling-cli-extra
	provides = darling-cli-extra
	conflicts = darling-cli-extra
	conflicts = darling-cli-extra-git

