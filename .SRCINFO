	pkgver = 6.7.2
	pkgrel = 1
	url = https://www.qt.io
	arch = any
	groups = mingw-w64-qt6
	license = GPL3
	license = LGPL3
	license = FDL
	license = custom
	makedepends = mingw-w64-cmake-static
