	pkgrel = 1
	url = https://github.com/vicrodh/steamos-add-to-steam
	arch = x86_64
	license = MIT
	depends = kdialog
	depends = kmimetypefinder
	depends = python
	depends = steam
	depends = flatpak
	source = git+https://github.com/vicrodh/steamos-add-to-steam.git
	sha256sums = SKIP

pkgname = steamos-add-to-steam
