pkgbase = equibop-git
	pkgdesc = A custom Discord desktop app with Equicord pre-installed (git version)
	pkgver = 3.2.0
	pkgrel = 1
	url = https://github.com/Equicord/Equibop
	arch = any
	license = GPL-3.0-only
	makedepends = git
	makedepends = bun
	makedepends = cmake
	makedepends = gcc
	makedepends = nodejs
	makedepends = npm
	depends = electron
	optdepends = libnotify: Notifications
	optdepends = xdg-utils: Open links, files, etc
	provides = equibop=3.2.0
	conflicts = equibop
	conflicts = equibop
	options = !strip
	source = equibop::git+https://github.com/Equicord/Equibop.git
	sha256sums = SKIP

pkgname = equibop-git
