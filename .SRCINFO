pkgbase = snapper-git
	pkgdesc = A tool for managing BTRFS and LVM snapshots. It can create, diff and restore snapshots and provides timelined auto-snapping.
	pkgver = 0.13.1.git.3111.f25abd5d
	pkgrel = 1
	url = http://snapper.io
	arch = x86_64
	arch = aarch64
	license = GPL2
	makedepends = boost
	makedepends = lvm2
