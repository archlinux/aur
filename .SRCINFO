pkgbase = aura-emerge
	pkgdesc = Portage-like wrapper for Arch Linux using Aura
	pkgver = 1.31.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = aura
	optdepends = devtools: for --abs support (build from ABS source via pkgctl)
	optdepends = gnupg: for PGP verification when building from ABS
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v1.31.0
	sha256sums = 43f1178677ed509856df3163165c5898e155270064021951cbe5e380953ebe35

pkgname = aura-emerge
