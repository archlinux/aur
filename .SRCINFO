pkgbase = gitcomet-bin
	pkgdesc = Fast, resource-efficient Git GUI written in Rust
	pkgver = 0.3.0
	pkgrel = 1
	url = https://gitcomet.dev/
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	depends = git
	depends = glibc
	depends = libgcc
	depends = fontconfig
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = zlib
	depends = hicolor-icon-theme
	depends = libglvnd
	optdepends = vulkan-icd-loader: preferred Vulkan renderer (otherwise uses EGL)
	optdepends = wayland: native Wayland sessions (otherwise uses X11)
	optdepends = git-lfs: Git LFS support
	optdepends = gnupg: commit signing and verification
	optdepends = openssh: SSH remotes and commit signing
	optdepends = xdg-utils: open files and links in external applications
	optdepends = xdg-desktop-portal: file pickers and desktop settings
	optdepends = noto-fonts-cjk: CJK font coverage
	optdepends = noto-fonts-emoji: emoji font coverage
	provides = gitcomet=0.3.0
	conflicts = gitcomet
	options = !strip
	options = !debug
	source = gitcomet-source-v0.3.0.tar.gz::https://github.com/Auto-Explore/GitComet/archive/refs/tags/v0.3.0.tar.gz
	sha256sums = e6ea369f6888772884cdd57e44930d2b4a7ea98c058819bd62981ac22a4387d5
	source_x86_64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.0/gitcomet-v0.3.0-linux-x86_64.tar.gz
	sha256sums_x86_64 = 0cbaef3ad36b8f8a6f42a564809ee4c652ce56778c7c7c50d48dd91773bfc903
	source_aarch64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.0/gitcomet-v0.3.0-linux-arm64.tar.gz
	sha256sums_aarch64 = c162b4d616e406f40fd92832ffb4782762d6a16532888d9d68eb03327033fc02

pkgname = gitcomet-bin
