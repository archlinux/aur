pkgbase = heatsync-chat-bin
	pkgdesc = twitch, kick and youtube chat in one native window, with heatsync emotes (prebuilt release)
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/mellen9999/heatsync-chat
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	depends = fontconfig
	depends = libxkbcommon
