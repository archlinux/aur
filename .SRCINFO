pkgbase = nspawn
	pkgdesc = Docker-like management of systemd-nspawn machines: OCI images from a hub, shared layers, a bridge network, driven over D-Bus
	pkgver = 2.1.0
	pkgrel = 1
	url = https://github.com/nspawn/nspawn
	arch = x86_64
	arch = aarch64
	license = MIT
