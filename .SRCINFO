pkgbase = dffy-bin
	pkgdesc = Fast terminal diff viewer for git, built for large repositories: file tree and split or unified view, syntax-aware diff, watch mode, JSON output and an MCP server for coding agents
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/amalucelli/dffy
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	optdepends = git: reviewing a repository, which is what dffy is for (it also diffs two files on its own)
	optdepends = dffy-render-markdown-bin: render Markdown files, after adding "render = md:markdown" to ~/.config/dffy/config
	optdepends = dffy-render-mermaid-bin: draw Mermaid diagrams, after adding "render = mmd:mermaid mermaid:mermaid" to ~/.config/dffy/config
	provides = dffy
	conflicts = dffy
	conflicts = dffy-git
	noextract = dffy_0.5.0_linux_amd64.tar.gz
	noextract = dffy_0.5.0_linux_arm64.tar.gz
	options = !strip
	options = !debug
	source_x86_64 = dffy_0.5.0_linux_amd64.tar.gz::https://github.com/amalucelli/dffy/releases/download/v0.5.0/dffy_linux_amd64.tar.gz
	sha256sums_x86_64 = fbc6c345f50f389a2a3632bafaa78dc447fb1653f6792a0f81fd2173679e3a2b
	source_aarch64 = dffy_0.5.0_linux_arm64.tar.gz::https://github.com/amalucelli/dffy/releases/download/v0.5.0/dffy_linux_arm64.tar.gz
	sha256sums_aarch64 = 65e80113026058cfa93048f22b6e64b4231f82ea7da8aab1e702b298d32a69ff

pkgname = dffy-bin
