pkgbase = dream-llmchatbox
	pkgdesc = Chat with local AI models (Ollama) - tools, folders, memory, groups, speech, German/English
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/yakuda-stack/Dream-LLMChatBox
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = cmake
	makedepends = clang
	depends = glibc
	depends = gcc-libs
	depends = alsa-lib
	depends = fontconfig
	depends = freetype2
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = hicolor-icon-theme
	optdepends = ollama: run the local AI models (or ollama-vulkan / ollama-rocm)
	optdepends = xdg-utils: open links, files and folders
	optdepends = polkit: start/stop the Ollama service and switch its graphics backend
	optdepends = libnotify: desktop notification when an automation is done
	optdepends = poppler: read PDF files and PDF preview
	optdepends = unzip: read DOCX/ODT files
	optdepends = tesseract: read text from images
	optdepends = ffmpeg: audio and video attachments
	optdepends = pandoc: create PDF/DOCX/ODT/PPTX/EPUB documents
	optdepends = texlive-xetex: PDF documents via pandoc
	optdepends = libreoffice-fresh: PDF documents via pandoc (fallback)
	optdepends = piper-tts-bin: read answers aloud
	optdepends = podman: run test environment commands in a container
	optdepends = docker: run test environment commands in a container
	options = !lto
	source = dream-llmchatbox-0.1.1.tar.gz::https://github.com/yakuda-stack/Dream-LLMChatBox/archive/refs/tags/v0.1.1.tar.gz
	sha256sums = aed38f8ac0378ec302bf277c7c441e06e55a3dc70bd566da245eed7e958b80b3

pkgname = dream-llmchatbox
