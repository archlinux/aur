pkgname = python-onnxruntime-core-bin
	pkgdesc = The Python module of ONNX Runtime, the cross-platform inference engine for ONNX models (onnxruntime-core) (prebuilt)
	depends = onnxruntime-core=1.29.0-6
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = python-numpy
	depends = python-flatbuffers
	depends = python-packaging
	depends = python-protobuf
	depends = python>=3.14
	depends = python<3.15
	optdepends = onnxruntime-provider-cuda: the CUDA execution provider
	optdepends = onnxruntime-provider-tensorrt: the TensorRT execution provider
	optdepends = onnxruntime-provider-openvino: the OpenVINO execution provider (Intel CPU, GPU and NPU)
	optdepends = python-onnx: the quantization, transformers optimisation and model tools
	optdepends = python-ml-dtypes: 4-bit and float8 quantization (the wheel's quantization extra)
	optdepends = python-sympy: symbolic shape inference (onnxruntime.tools)
	optdepends = python-psutil: the transformers optimisation and benchmark tools
	optdepends = python-py-cpuinfo: the transformers optimisation and benchmark tools
	provides = python-onnxruntime-core=1.29.0-6
	provides = python-onnxruntime=1.29.0
	conflicts = python-onnxruntime-core
	conflicts = python-onnxruntime
	conflicts = python-onnxruntime-cpu
	conflicts = python-onnxruntime-cuda
	conflicts = python-onnxruntime-opt-cuda
	conflicts = python-onnxruntime-rocm
	conflicts = python-onnxruntime-opt-rocm
	conflicts = python-onnxruntime-full
	replaces = python-onnxruntime-full
