pkgbase = ico-pc-bin
	pkgdesc = PC port of ICO (PS2), built from the nathanialf/ico decompilation; needs your own disc image (prebuilt release)
	pkgver = 0.11.13
	pkgrel = 1
	url = https://github.com/nathanialf/ico-pc
	arch = x86_64
	license = MIT
	license = Zlib
	depends = glibc
	depends = vulkan-icd-loader
	depends = libx11
	depends = libxext
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = libxkbcommon
	depends = alsa-lib
	optdepends = vulkan-driver: Vulkan renderer (the default)
	optdepends = libgl: OpenGL renderer, used when there is no Vulkan driver
	optdepends = wayland: native Wayland window instead of XWayland
	optdepends = libdecor: window decorations on Wayland
	optdepends = libpulse: PulseAudio audio output
	optdepends = pipewire: PipeWire audio output
	provides = ico-pc
	conflicts = ico-pc
	noextract = ico-pc-v0.11.13-linux.tar.gz
	options = !strip
	options = !debug
	source = ico-pc-v0.11.13-linux.tar.gz::https://github.com/nathanialf/ico-pc/releases/download/v0.11.13/ico-pc-v0.11.13-linux.tar.gz
