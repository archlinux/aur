pkgbase = rust-dos
	pkgver = 1.7.3
	pkgrel = 1
	url = https://github.com/dividebysandwich/rust-dos
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	makedepends = cargo
	options = !lto
	source = rust-dos-1.7.3.tar.gz::https://github.com/dividebysandwich/rust-dos/archive/refs/tags/v1.7.3.tar.gz
	sha256sums = e0229cbd1160824896d73d29da3820fe74b6b6dc57b2499bcbc890c740725a9a

pkgname = rust-dos
	pkgdesc = A fast x86 DOS emulator with optional VR support featuring 386 to Pentium CPUs, DPMI host, VGA/VESA/S3/Voodoo, SB16/GUS/MT-32/GM, IDE, PnP, PCI, Win3x, Win95, NE2000 with NAT, IPX and serial multiplayer, RetroAchievements, save states, rewind, and WASM.
	depends = alsa-lib
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = munt
	depends = sdl2
	optdepends = soundfont-fluid: General MIDI SoundFont for the MPU-401 (soundfont= in [sound])
	optdepends = fluidsynth: software synthesizer to play the MIDI sent out of a MIDI port (midisynth=host)
	optdepends = openxr: OpenXR loader for VR headsets through SteamVR or Monado (mode=headset in [vr])

pkgname = libretro-rust-dos
	pkgdesc = Rust-DOS fast x86 DOS emulator as a libretro core, for RetroArch and the other libretro frontends
	depends = glibc
	depends = libgcc
	optdepends = retroarch: the libretro frontend
	optdepends = munt: Roland MT-32 emulation (midisynth=mt32)
	optdepends = soundfont-fluid: General MIDI SoundFont for the MPU-401 (soundfont= in rust-dos.conf)
