pkgbase = scdr
	pkgdesc = Process scheduling and priority daemon for EEVDF and sched_ext kernels
	pkgver = 0.4.1
	pkgrel = 1
	url = https://github.com/asafelobotomy/scdr
	arch = x86_64
	arch = aarch64
	license = MPL-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = bpf
	makedepends = libbpf
	makedepends = libelf
	makedepends = zlib
	makedepends = dbus
	makedepends = systemd
	source = scdr-0.4.1.tar.gz::https://github.com/asafelobotomy/scdr/releases/download/v0.4.1/scdr-0.4.1.tar.gz
	sha256sums = 542d5860df651d6f217e436903c4e79b1b4a7b77575a2466d526559716aeede8

pkgname = scdr
	install = scdr.install
	depends = libgcc
	depends = glibc
	depends = dbus
	depends = systemd
	optdepends = scx-scheds: sched_ext schedulers ([sched_ext])
	optdepends = scx-tools: scx_loader, which scdr drives ([sched_ext])
	optdepends = scx-devbox: sched_ext scheduler that follows scdr profiles
	optdepends = pipewire: audio-client role (pw-dump)
	optdepends = gamemode: game role
	optdepends = power-profiles-daemon: per-power-profile roles
	optdepends = uq: the Scheduling page and bar widget in uQ
	optdepends = plasma-workspace: the SCDR panel widget in KDE Plasma
	optdepends = kquickcharts: live graphs in the Plasma panel widget
	optdepends = kcmutils: settings pages of the Plasma panel widget

pkgname = scx-devbox
	pkgdesc = sched_ext scheduler for low-end machines doing development with LLM agent apps
	install = scx-devbox.install
	license = GPL-2.0-only
	depends = glibc
	depends = libbpf
	optdepends = scdr: per-process hints (batch builds, latency slices, nice) and focus hints
