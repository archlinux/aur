pkgbase = adduser-deb
	pkgdesc = Debian's 'adduser' and 'deluser' commands for creating and removing users
	pkgver = 3.155
	pkgrel = 1
	url = https://salsa.debian.org/debian/adduser
	arch = any
	license = GPL-2.0-or-later
	makedepends = dpkg
	makedepends = po4a
	depends = findutils
	depends = perl
	depends = shadow
	depends = util-linux
	optdepends = perl-locale-gettext: needed for localised/non-English output
	optdepends = quota-tools: needed if enabling the `QUOTAUSER` option in `adduser.conf`
	optdepends = tar: needed for `deluser --backup` or if enabling the `BACKUP*` options in `deluser.conf`
	conflicts = adduser
	backup = etc/adduser.conf
	backup = etc/deluser.conf
	source = https://salsa.debian.org/debian/adduser/-/archive/debian/3.155/adduser-debian-3.155.tar.gz
	source = arch-license-path.patch
	source = arch-policy.patch
