pkgbase = libfronius
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.3.0::git+https://github.com/ahpohl/libfronius.git#tag=v1.3.0
	sha256sums = f40f1124bf270d464cd1d651f4f14804bda7d192d2d66164311235271075bdd6

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters and meters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
