pkgbase = webkvm-bin
	pkgdesc = Native libvirt + QEMU/KVM and Incus manager with embedded web UI (prebuilt binary)
	pkgver = 0.1.11
	pkgrel = 1
	url = https://github.com/Slaker19/webkvm
	install = webkvm-bin.install
	arch = x86_64
	license = AGPL-3.0-only
	depends = bash
	depends = glibc
	depends = libvirt
	depends = qemu-system-x86
	depends = qemu-img
	depends = edk2-ovmf
	depends = dnsmasq
	depends = qemu-hw-display-virtio-vga
	depends = qemu-hw-display-virtio-gpu
	depends = nftables
	depends = iptables
	depends = ca-certificates
	depends = iproute2
	depends = procps-ng
	depends = util-linux
	depends = tar
	depends = zstd
	depends = xz
	depends = e2fsprogs
	optdepends = swtpm: virtual TPM 2.0/1.2 for q35 VMs (Windows 11)
	optdepends = libisoburn: xorriso for cloud-init seed ISOs (Image Hub cloud images)
	optdepends = qemu-ui-spice-core: SPICE graphics for VMs (browser SPICE console, .vv files)
	optdepends = qemu-chardev-spice: SPICE agent channel (clipboard, display resize)
	optdepends = qemu-hw-display-qxl: QXL video model
	optdepends = qemu-hw-display-virtio-gpu-gl: 3D acceleration (virgl) for virtio video
	optdepends = qemu-hw-display-virtio-vga-gl: 3D acceleration (virgl), primary virtio display
	optdepends = qemu-ui-egl-headless: 3D acceleration (virgl) renderer, needs /dev/dri/renderD*
	optdepends = qemu-audio-spice: guest audio over SPICE
	optdepends = virt-viewer: open downloaded .vv files (remote-viewer)
	optdepends = freerdp: open downloaded .rdp files (Windows guests with RDP enabled)
	optdepends = incus: LXC system containers
	optdepends = mdadm: software RAID management
	optdepends = nfs-utils: NFS storage pools and backup targets
	optdepends = cifs-utils: SMB/CIFS mounts
	optdepends = smbclient: SMB share browsing
	optdepends = gptfdisk: disk partitioning (sgdisk)
	optdepends = parted: disk partitioning (fallback for sgdisk)
	optdepends = xfsprogs: XFS formatting
	optdepends = btrfs-progs: Btrfs formatting
	optdepends = f2fs-tools: F2FS formatting
	provides = webkvm
	conflicts = webkvm
	options = !strip
	options = !debug
	backup = etc/default/webkvm
	source = https://github.com/Slaker19/webkvm/releases/download/v0.1.11/webkvm-0.1.11.tar.gz
	sha256sums = d8db7d695c57da70c792b1d6a8eca6c2a432ed41c7e1bd40ed63013cb04776f1

pkgname = webkvm-bin
