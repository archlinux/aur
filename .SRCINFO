pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.12
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.12-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.12-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.12-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.12-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.12-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.12-1-x86_64.pkg.tar.zst
	sha256sums = 6efd1cdff2afd5267322a61d299920da9addb1b891a18438c0ec06abe4e8e02c
	sha256sums = 5c2629342bbc11af80532bac864f5b8d86ff2ff0fb3b27f7a2c3cec5bb945801
	sha256sums = fe960e0be49bcd2f3b98828aec8e6127034f053119b21484377d0eab82212719

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.12-1-lts-bin
	depends = linux6.12.12-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.12-1-lts-headers-bin
	depends = linux6.12.12-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.12-1-lts-docs-bin
	depends = linux6.12.12-1-lts-docs-bin

pkgname = linux6.12.12-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.12-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.12-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.12-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.12-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.12-1-lts
	conflicts = linux-lts-docs
