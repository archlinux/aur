pkgbase = openq4-bin
	pkgdesc = Open-source Quake 4 engine and game code replacement (binary release). You need the retail Quake 4 data to play.
	pkgver = 0.13.2
	pkgrel = 1
	url = https://github.com/themuffinator/openQ4
	install = openq4-bin.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	license = LicenseRef-Quake4-SDK
	license = LicenseRef-Quake4-EULA
	depends = gcc-libs
	depends = glibc
	depends = libgl
	depends = libx11
	depends = libxcursor
	depends = libxext
	depends = libxi
	depends = libxrandr
	depends = openal
	optdepends = quake4-data: retail Quake 4 data in /opt/quake4 (otherwise a Steam/GOG install is detected)
	optdepends = vulkan-icd-loader: experimental Vulkan renderer (r_renderApi vulkan)
	optdepends = wayland: native Wayland video
	optdepends = libxkbcommon: native Wayland keyboard input
	optdepends = libdecor: Wayland window decorations
	provides = openq4=0.13.2
	conflicts = openq4
	conflicts = openq4-git
	noextract = quake4-linux-1.4.2.x86.run
	options = !strip
	options = !debug
	source = openq4.sh
	source = https://aur.slashbunny.com/quake4/quake4-linux-1.4.2.x86.run
