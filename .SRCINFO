pkgbase = pomotui-git
	pkgdesc = Terminal Pomodoro timer with TUI, CLI, and Waybar frontends (git build)
	pkgver = r0.1.0
	pkgrel = 1
	url = https://github.com/SaintFore/pomotui
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = gcc-libs
	depends = sqlite
	optdepends = libnotify: desktop notifications via notify-send
	optdepends = pulseaudio: sound playback via paplay
	optdepends = waybar: Waybar module integration
	provides = pomotui
	conflicts = pomotui
	source = pomotui::git+https://github.com/SaintFore/pomotui.git
	sha256sums = SKIP

pkgname = pomotui-git
