pkgbase = faiss
	pkgver = 1.15.0
	pkgrel = 1
	url = https://github.com/facebookresearch/faiss
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = python-build
	makedepends = python-scikit-build-core
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = swig
	depends = blas
	depends = lapack
	depends = openmp
	depends = python-numpy
	options = !debug
	options = !lto
	source = https://github.com/facebookresearch/faiss/archive/refs/tags/v1.15.0.tar.gz
	sha256sums = SKIP

pkgname = faiss-cpu
	pkgdesc = A library for efficient similarity search and clustering of dense vectors.
	optdepends = intel-mkl: for x86_64
	provides = libfaiss
	provides = python-faiss

pkgname = faiss-gpu
	pkgdesc = A library for efficient similarity search and clustering of dense vectors (cuda or rocm accelarated).
	optdepends = cuda
	optdepends = hip-runtime-amd
	optdepends = openmp
	provides = libfaiss
	provides = python-faiss
	provides = python-faiss-gpu
	conflicts = faiss-cpu
