pkgbase = hal-9001
	pkgdesc = Pure Rust TUI system control hub for Arch users (BTW) tired of 14 separate tools (No AI!)
	pkgver = 0.1.3
	pkgrel = 1
	url = https://github.com/IvelOt/hal-9001
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = rust
	depends = dbus
	depends = glibc
	depends = gcc-libs
	optdepends = networkmanager: suporte ao gerenciamento de Wi-Fi e rede (D-Bus)
	optdepends = bluez: suporte a descoberta, pareamento e telemetria de Bluetooth
	optdepends = udisks2: gerenciamento, montagem e ejeção de unidades de armazenamento
	optdepends = upower: monitoramento de bateria e perfis de energia
	optdepends = pipewire: mixer de áudio e controle de volume por aplicativo (via wpctl)
	optdepends = pulseaudio: fallback de mixer de áudio (via pactl)
	optdepends = xorg-xrandr: gerenciamento e auto-expansão de múltiplos monitores sob X11
	optdepends = wlr-randr: gerenciamento de múltiplos monitores sob Wayland (wlroots)
	optdepends = hyprland: gerenciamento de múltiplos monitores sob Hyprland (hyprctl)
	optdepends = sudo: elevação de privilégios para formatação de partições e gravação de ISO
	provides = hal-9001
	provides = hal9001
	conflicts = hal-9001-bin
