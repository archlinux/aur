pkgbase = void-git
	pkgdesc = Void is the open-source Cursor alternative. This repo contains the full sourcecode for Void. We have a waitlist for downloading the official release, but you can build and develop Void right now. https://voideditor.com/
	pkgver = 1.94.0
	pkgrel = 1
	url = https://voideditor.com/
	arch = x86_64
	arch = aarch64
	arch = armv7h
	license = MIT
	makedepends = base-devel
	makedepends = libx11
	makedepends = libxkbfile
	makedepends = libsecret
	makedepends = npm
	makedepends = nodejs
	makedepends = pkg-config
	depends = libx11
	depends = libxkbfile
	depends = libsecret
	depends = gnupg
	depends = gtk3
	depends = nss
	depends = gcc-libs
	depends = libnotify
	depends = libxss
	depends = glibc
	depends = lsof
	depends = shared-mime-info
	depends = xdg-utils
	depends = alsa-lib
	optdepends = glib2: Needed for move to trash functionality
	optdepends = gvfs: For move to trash functionality
	optdepends = libdbusmenu-glib: For KDE global menu
	optdepends = org.freedesktop.secrets: Needed for settings sync
	optdepends = icu69: Needed for live share
	provides = void
	options = !strip
	options = !debug
	source = git+https://github.com/voideditor/void.git
	sha256sums = SKIP

pkgname = void-git
