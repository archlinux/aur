pkgbase = stirling-pdf-bin
	pkgdesc = Locally hosted web application that allows you to perform various operations on PDF files
	pkgver = 2.10.1
	pkgrel = 1
	url = https://github.com/Stirling-Tools/Stirling-PDF
	arch = any
	license = MIT
	depends = fontconfig
	depends = ghostscript
	depends = imagemagick
	depends = java-runtime-headless>=21
	depends = libreoffice
	depends = ocrmypdf
	depends = poppler
	depends = python-opencv
	depends = python-pdf2image
	depends = python-pillow
	depends = python-unoserver
	depends = python-weasyprint
	depends = qpdf
	depends = tesseract-data-eng
	depends = tesseract-data-osd
	depends = unpaper
	optdepends = calibre: for ebook conversion
	optdepends = jbig2enc: for certain OCR functionality
	optdepends = tesseract-data-chi_sim: Chinese Simplified language OCR
	optdepends = tesseract-data-deu: German language OCR
	optdepends = tesseract-data-fra: French language OCR
	optdepends = tesseract-data-por: Portuguese language OCR
	optdepends = noto-fonts: google noto ttf fonts
	optdepends = noto-fonts-cjk: google noto Chinese/Japanese/Korean fonts
	optdepends = noto-fonts-extra: google noto ttf fonts additional variants
	optdepends = terminus-font: monospace bitmap font
	optdepends = ttf-dejavu: based on the Bitstream Vera Fonts with a wider range of characters
	optdepends = ttf-liberation: which aims at metric compatibility with Arial, Times New Roman, and Courier New
	optdepends = ttf-libertinus: extended math fonts support
	optdepends = ttf-ms-win11-auto: Microsoft windows 11 fonts
	optdepends = ttf-ms-win11-auto-zh_cn: Microsoft windows 11 Chinese Simplified fonts
	optdepends = ttf-wps-fonts: WPS office fonts
	provides = stirling-pdf
	conflicts = stirling-pdf
	noextract = stirling-pdf-2.10.1.jar
	backup = etc/stirling-pdf/stirling-pdf.env
