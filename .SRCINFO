	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-hardened-headers-6.9.6.hardened1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-hardened-docs-6.9.6.hardened1-1-x86_64.pkg.tar.zst
