pkgbase = digit-git
	pkgdesc = A calm GTK4 desktop for Hyprland and niri
	pkgver = r298.29b963c
	pkgrel = 1
	url = https://github.com/altugcetin/digit
	install = digit.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = gtk4
	depends = gtk4-layer-shell
	depends = glib2
	depends = cairo
	depends = pango
	depends = gdk-pixbuf2
	depends = graphene
	depends = wayland
	depends = pam
	depends = gvfs
	depends = polkit
	depends = upower
	depends = playerctl
	depends = wtype
	depends = curl
	depends = slurp
	depends = xdg-desktop-portal-gtk
	depends = ttf-material-symbols-variable
	depends = ttf-readex-pro-variable
	depends = ttf-rubik-vf
	optdepends = hyprland: compositor for the "Hyprland with Digit" session
	optdepends = xdg-desktop-portal-hyprland: screen sharing on Hyprland
	optdepends = niri: compositor for the "niri with Digit" session
	optdepends = xdg-desktop-portal-gnome: screen sharing on niri
	optdepends = kitty: terminal for Super+Return when no other is installed
	optdepends = pipewire-pulse: volume and the sound mixer
	optdepends = wireplumber: volume when the PulseAudio connection is missing
	optdepends = networkmanager: Wi-Fi and network in Control Center and Settings
	optdepends = bluez: Bluetooth in Control Center and Settings
	optdepends = power-profiles-daemon: power modes in Control Center
	optdepends = fwupd: firmware updates in Settings
	optdepends = wl-clipboard: screenshots stay on the clipboard after Snap closes
	optdepends = tesseract: copying text from a screenshot
	optdepends = scrcpy: mirroring a phone screen
	optdepends = android-tools: mirroring a phone over USB
	optdepends = bubblewrap: thumbnails from other apps in Digit Files
	optdepends = libjxl: JPEG XL app icons in Digit Store
	optdepends = flatpak: apps from Flathub in Digit Store
	optdepends = archlinux-appstream-data: system apps in Digit Store
	optdepends = packagekit: installing drivers and packages from Settings and Files
	optdepends = gvfs-mtp: phones plugged in over USB in Digit Files
	optdepends = gvfs-afc: iPhones plugged in over USB in Digit Files
	optdepends = kdeconnect: phones over Wi-Fi in Digit Files
	optdepends = gst-plugins-good: video and audio previews in Digit Files
	optdepends = gst-libav: more video formats in Digit Files
	optdepends = gpu-screen-recorder: screen recording
	optdepends = cava: the audio visualizer
	optdepends = squashfs-tools: opening AppImages in Digit Store
	optdepends = fuse2: running AppImages
	optdepends = adw-gtk-theme: GTK 3 apps in the Digit look
	optdepends = breeze: Qt apps in the Digit look
	optdepends = qt6ct: Qt apps following Digit colors
	provides = digit
	conflicts = digit
	backup = etc/pam.d/digit
	source = digit::git+https://github.com/altugcetin/digit.git
	sha256sums = SKIP

pkgname = digit-git
