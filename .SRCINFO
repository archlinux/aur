pkgbase = arch-smart-update
	pkgdesc = This script helps you decide when to update Arch Linux or its derivatives.
	pkgver = 3.21.2
	pkgrel = 1
	url = https://github.com/motorrin/arch-smart-update
	arch = any
	license = MIT
	depends = bash
