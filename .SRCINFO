pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.42
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.42-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.42-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.42-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-6.6.42-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-headers-6.6.42-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-docs-6.6.42-1-x86_64.pkg.tar.zst
	sha256sums = 690244abc37c39c4f3f14a4f84dd14234d58eb66337e30baac94e9ae0bc5b652
	sha256sums = dfbf32ee49ec3c825d7375e72d4925d1f33c7c8557fb18f862a2d751933a1717
	sha256sums = d02b4572c89da1e28cc959a357afe67275617c53d1bbc53ef252826a564f49ef

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.6.42-1-lts-bin
	depends = linux6.6.42-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.6.42-1-lts-headers-bin
	depends = linux6.6.42-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.6.42-1-lts-docs-bin
	depends = linux6.6.42-1-lts-docs-bin

pkgname = linux6.6.42-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.6.42-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.6.42-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.6.42-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.6.42-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.6.42-1-lts
	conflicts = linux-lts-docs
