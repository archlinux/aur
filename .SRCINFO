pkgbase = go-sponge
	pkgdesc = Effortlessly build stable, reliable, and high-performance backend services with a "low-code" approach
	pkgver = 1.16.1
	pkgrel = 3
	url = https://go-sponge.com
	arch = aarch64
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = go
	source = go-sponge::git+https://github.com/go-dev-frame/sponge.git#tag=v1.16.1
	sha256sums = 02148ed775f0cd9b4b41faf63087e86e491ae563a51e90e06c14d5b4e1a0bffe

pkgname = go-sponge
	depends = glibc
	depends = go
	depends = protobuf
	depends = protoc-gen-doc
	depends = protoc-gen-go
	depends = protoc-gen-go-gin>=1.16.1-3
	depends = protoc-gen-go-grpc
	depends = protoc-gen-go-rpc-tmpl>=1.16.1-3
	depends = protoc-gen-gotag
	depends = protoc-gen-json-field>=1.16.1-3
	depends = protoc-gen-openapiv2
	depends = protoc-gen-validate
	depends = swag
	conflicts = sponge<=1.16.1-1
	replaces = sponge<=1.16.1-1

pkgname = protoc-gen-go-gin
	pkgdesc = Protobuf plugin to generate Gin routes, handlers, RPC stubs, and error codes
	url = https://github.com/go-dev-frame/sponge/tree/main/cmd/protoc-gen-go-gin
	depends = glibc
	depends = protobuf
	depends = protoc-gen-go
	depends = protoc-gen-go-grpc

pkgname = protoc-gen-go-rpc-tmpl
	pkgdesc = Protobuf plugin to generate RPC service templates and RPC error codes
	url = https://github.com/go-dev-frame/sponge/tree/main/cmd/protoc-gen-go-rpc-tmpl
	depends = glibc
	depends = protobuf
	depends = protoc-gen-go
	depends = protoc-gen-go-grpc

pkgname = protoc-gen-json-field
	pkgdesc = Protobuf plugin to generate JSON field code from proto files
	url = https://github.com/go-dev-frame/sponge/tree/main/cmd/protoc-gen-json-field
	depends = glibc
	depends = protobuf
