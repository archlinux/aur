pkgbase = twilightmc-git
	pkgdesc = TwilightMC launcher - Rust/Tauri Minecraft launcher & client (built from main)
	pkgver = 0.8.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/BlackCatOfficialytb/TwilightMC-OSS
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	license = Apache-2.0
	makedepends = cargo
	makedepends = git
	makedepends = nodejs
	makedepends = npm
	makedepends = pkgconf
	depends = cairo
	depends = dbus
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk3
	depends = libsoup3
	depends = openssl
	depends = webkit2gtk-4.1
	optdepends = java-runtime: required to launch Minecraft instances
	optdepends = jre21-openjdk: recommended Java runtime for modern Minecraft versions
	provides = twilightmc
	provides = twilight
	provides = twilight-ui
	conflicts = twilightmc
	conflicts = twilightmc-bin
	conflicts = twilightmc-star-bin
	conflicts = twilightmc-bolide-bin
	conflicts = twilightmc-snapshot-bin
	options = !lto
	source = twilightmc-oss::git+https://github.com/BlackCatOfficialytb/TwilightMC-OSS.git#branch=main
	sha256sums = SKIP

pkgname = twilightmc-git
