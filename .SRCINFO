pkgname = onnxruntime-core-bin
	pkgdesc = Cross-platform inference engine for ONNX models: the C and C++ library with the CPU execution provider (prebuilt)
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = onnxruntime-provider-cuda: the CUDA execution provider
	optdepends = onnxruntime-provider-tensorrt: the TensorRT execution provider
	optdepends = onnxruntime-provider-openvino: the OpenVINO execution provider (Intel CPU, GPU and NPU)
	optdepends = onnxruntime-provider-migraphx: the MIGraphX execution provider (AMD GPUs, untested)
	provides = onnxruntime-core=1.29.0-5
	provides = onnxruntime=1.29.0
	provides = libonnxruntime.so=1-64
	conflicts = onnxruntime-core
	conflicts = onnxruntime
	conflicts = onnxruntime-cpu
	conflicts = onnxruntime-cuda
	conflicts = onnxruntime-opt-cuda
	conflicts = onnxruntime-rocm
	conflicts = onnxruntime-opt-rocm
	conflicts = onnxruntime-git
	conflicts = onnxruntime-full
	replaces = onnxruntime-full

