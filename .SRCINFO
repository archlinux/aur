pkgbase = screen-relay
	pkgdesc = Stream a desktop to a browser, and drive it from a CLI, an HTTP API, or a Node SDK
	pkgver = 0.1.2
	pkgrel = 1
	url = https://screen-relay.dev
	arch = x86_64
	license = Apache-2.0
	license = GPL-3.0-only
	makedepends = npm
	depends = nodejs
	depends = x264
	depends = libwebsockets
	depends = wayland
	depends = libxkbcommon
	depends = libx11
	depends = libxext
	depends = libxdamage
	depends = libxfixes
	depends = libxtst
	depends = zlib
	depends = gcc-libs
	depends = xorg-server-xvfb
	depends = xorg-xauth
	optdepends = xprop: inspect the desktop windows a session starts
	optdepends = xwininfo: window geometry for the desktop check
	optdepends = xorg-setxkbmap: keyboard layouts other than us
	optdepends = dbus: session bus for the desktop (dbus-run-session)
	optdepends = xfce4-session: default X11 desktop
	optdepends = xfwm4: window manager and compositor for the default X11 desktop
	optdepends = xfce4-panel: panel for the default X11 desktop
	optdepends = xfdesktop: desktop background and icons for the default X11 desktop
	optdepends = xfce4-settings: settings daemon for the default X11 desktop
	optdepends = xfce4-terminal: terminal the quick start opens
	optdepends = sway: Wayland desktop for a headless Wayland session
	optdepends = xorg-xwayland: X11 applications inside a Wayland session
	optdepends = foot: Wayland terminal
	source = screen-relay-0.1.2.tar.gz::https://github.com/vercel-labs/screen-relay/archive/refs/tags/v0.1.2.tar.gz
