pkgbase = objfw
	pkgdesc = Portable, lightweight framework for the Objective-C language
	pkgver = 1.5.7
	pkgrel = 1
	url = https://objfw.nil.im/
	arch = x86_64
	groups = objfw
	license = LGPL3
	makedepends = clang
	source = https://objfw.nil.im/downloads/objfw-1.5.7.tar.gz
	sha256sums = e637c32731dc07396b812c4019f34d1417a3f7aa39d450b7f27c9bcdc23b3e12

pkgname = libobjfw
	pkgdesc = ObjFW library
	depends = glibc
	depends = gcc-libs
	depends = libobjfwrt
	depends = bash

pkgname = libobjfwrt
	pkgdesc = ObjFW Objective-C runtime library
	depends = glibc
	depends = gcc-libs

pkgname = libobjfwtls
	pkgdesc = TLS support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = openssl

pkgname = libobjfwhid
	pkgdesc = HID support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofarc
	pkgdesc = Utility for handling ZIP, Tar, LHA and Zoo archives
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls

pkgname = ofdns
	pkgdesc = Utility for performing DNS requests on the command line
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofgctester
	pkgdesc = Game controller tester for the terminal
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwhid

pkgname = ofhash
	pkgdesc = Utility to hash files with various cryptographic hash functions
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls

pkgname = ofhttp
	pkgdesc = Command line downloader for HTTP(S)
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls
