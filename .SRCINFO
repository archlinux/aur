pkgbase = sticky-rs-git
	pkgdesc = Image sticky note app that enables users to stick pictures to the desktop and have them always visible
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/FengZhongShaoNian/sticky-rs
	arch = any
	license = GPL2
	makedepends = nodejs
	makedepends = pnpm
	makedepends = rust
	makedepends = dpkg
	depends = cairo
	depends = desktop-file-utils
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libsoup
	depends = pango
	depends = webkit2gtk
	provides = sticky-rs
	conflicts = sticky-rs
	options = !strip
	options = !emptydirs
	source = git+https://github.com/FengZhongShaoNian/sticky-rs
	sha256sums = SKIP

pkgname = sticky-rs-git
