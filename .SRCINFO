	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.10.3.arch1-2-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.10.3.arch1-2-x86_64.pkg.tar.zst
