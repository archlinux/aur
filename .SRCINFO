pkgname = xcc-wcc-git
	pkgdesc = A very tiny, very fast C compiler, assembler, linker, and libc, which can directly output wasm files.
	depends = xcc-common
	depends = glibc
	depends = sh
	provides = wcc
	conflicts = wcc

pkgname = xcc-common-git
