	depends = cairo
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = gvfs
	depends = hicolor-icon-theme
	depends = libgcc
	depends = pango
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = ffmpeg: video thumbnails without ffmpegthumbnailer
	optdepends = mediainfo: the Media Info tab in Properties
	optdepends = gvfs-mtp: phones and media players over MTP
	optdepends = gvfs-gphoto2: cameras
	optdepends = gvfs-smb: Windows and Samba network shares
	optdepends = engrampa: creating and extracting archives
	optdepends = file-roller: creating and extracting archives
	optdepends = xarchiver: creating and extracting archives
