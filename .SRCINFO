pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.29
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.29-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.29-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.29-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.29-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.29-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.29-1-x86_64.pkg.tar.zst
	sha256sums = b5c3da936b72a94e0b4dca53b7cffdfdcd91bdf1bf283551803c0ef7cb24f3e2
	sha256sums = f4c462883b2f1ed4b7e715faada383bc5d3aaed40414579b2d427c039f4a7fb0
	sha256sums = c5768022ff0677ae1cbf8d7c03986c37385fe083583450f9057cf24a45fb968e

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.29-1-lts-bin
	depends = linux6.18.29-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.29-1-lts-headers-bin
	depends = linux6.18.29-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.29-1-lts-docs-bin
	depends = linux6.18.29-1-lts-docs-bin

pkgname = linux6.18.29-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.29-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.29-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.29-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.29-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.29-1-lts
	conflicts = linux-lts-docs
