pkgbase = atmosphera
	pkgdesc = Atmosphera - a customizable desktop shell for Niri and Hyprland, built with Quickshell
	pkgver = 0.12.0
	pkgrel = 2
	url = https://github.com/atmosphera-dev/atmosphera
	install = atmosphera.install
	arch = any
	license = GPL-3.0-or-later
	depends = quickshell
	depends = qt6-dbusqml>=1.1.0
	depends = qt6-configqml>=0.5.5
	depends = qt6-mpvqml>=0.3.0
	depends = qt6-imvqml>=0.1.6
	depends = qt6-pipewirespectrum
	depends = qt6-xdgiconqml-git
	depends = brightnessctl
	depends = qt6-multimedia
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = wlr-randr
	depends = wl-clipboard
	depends = glib2
	depends = udisks2
	depends = git
	optdepends = cliphist: For clipboard history support
	optdepends = wlsunset: For supporting NightLight
	optdepends = power-profiles-daemon: For power profile management
	optdepends = ddcutil: For external display brightness control
	optdepends = qt6-niriqml>=0.3.0: niri IPC integration (workspaces, windows, session config)
	optdepends = qt6-mangowcqml: mangowc IPC integration (workspaces, windows, session config)
	optdepends = keyd: hardware-level keyboard remapping (bindings environments)
	optdepends = xremap-niri-bin: session-level app-scoped keymaps (macos bindings)
	optdepends = qt6-5compat: required by some registry plugins (e.g. cookie-clock)
	optdepends = qt6-websockets: required by some registry plugins (e.g. hassio)
	optdepends = xdg-desktop-portal-gnome: screencast / screen-sharing support (niri cannot use -wlr)
	optdepends = fcitx5: input method framework (launched at session start by default)
	optdepends = bluez-utils: Bluetooth pairing with PIN entry and signal-strength polling
	optdepends = evolution-data-server: calendar events in the clock panel
	optdepends = python-dateutil: recurring monthly/yearly calendar events
	optdepends = qt6-webengine: PDF previews in the file chooser
	provides = atmosphera
	provides = xdg-desktop-portal-impl
	conflicts = atmosphera-git
	source = atmosphera-0.12.0.tar.gz::https://github.com/atmosphera-dev/atmosphera/archive/refs/tags/v0.12.0.tar.gz
