pkgbase = appzones
	pkgdesc = Long-lived sandboxes for desktop apps, dev tools and AI agents (bubblewrap, pasta, nftables)
	pkgver = 0.11.1
	pkgrel = 1
	url = https://github.com/mirql/appzones
	install = appzones.install
	arch = x86_64
	license = MIT
	makedepends = pkgconf
	makedepends = wayland
	depends = python>=3.11
	depends = bubblewrap
	depends = passt
	depends = nftables
	depends = iproute2
	optdepends = wayland: desktop apps (each zone's own Wayland socket, zone-wayland)
	optdepends = xdg-dbus-proxy: the session bus in zones (portals, notifications, tray)
	optdepends = dbus: apps with bus = "zone" (their own bus in the zone)
	optdepends = sudo: appzones mount (for members of the appzones group)
	optdepends = hyprland: zone border colours and window tags
	optdepends = nix: the packages setting
	backup = etc/sudoers.d/appzones
	source = appzones-0.11.1.tar.gz::https://github.com/mirql/appzones/archive/refs/tags/v0.11.1.tar.gz
	source = appzones.sysusers
	sha256sums = ea72e30bdff6b61a08181c6d3473392d03136d030691756c3ca5ee6c7343cd73
	sha256sums = SKIP

pkgname = appzones
