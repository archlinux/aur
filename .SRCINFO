pkgbase = x3d-toggle
	pkgver = 2.0.0
	pkgrel = 2
	url = https://github.com/X3D-Toggle/x3d-toggle-main
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = llvm
	makedepends = make
	makedepends = bpf
	makedepends = libbpf
	makedepends = pkgconf
	makedepends = glib2-devel
	makedepends = gtk4
	makedepends = libadwaita
	options = !strip
	options = !lto
	source = x3d-toggle-2.0.0.tar.gz::https://github.com/X3D-Toggle/x3d-toggle-main/archive/refs/tags/v2.0.0.tar.gz
	sha256sums = ee1163b87e35f91b4d3f1481b6b5ea0bf8b4c32f9c681426bf882a3aed695b55

pkgname = x3d-toggle
	pkgdesc = AMD Ryzen X3D V-Cache CCD priority optimizer daemon and CLI (POSIX C / eBPF)
	install = x3d-toggle.install
	depends = glibc
	depends = libbpf
	depends = systemd-libs
	optdepends = x3d-toggle-gui: GTK4/libadwaita desktop dashboard
	optdepends = polkit: Passwordless x3d-toggle group service control
	optdepends = ethtool: NIC IRQ coalescing tuning
	optdepends = gzip: Diagnostic session log archiving
	backup = etc/x3d-toggle.d/settings.conf
	backup = etc/x3d-toggle.d/games.conf
	backup = etc/x3d-toggle.d/irq.conf
	backup = etc/x3d-toggle.d/networking.conf
	backup = etc/x3d-toggle.d/advanced.conf
	backup = etc/x3d-toggle.d/daemon.conf

pkgname = x3d-toggle-gui
	pkgdesc = GTK4/libadwaita desktop dashboard for X3D Toggle
	depends = x3d-toggle=2.0.0-2
	depends = gtk4
	depends = libadwaita
	optdepends = lact: AMD GPU clocks, voltages, power limits, and fan curves
	optdepends = corectrl: Application-specific AMD GPU performance profiles
