pkgbase = stoat-server
	pkgdesc = Stoat chat server
	pkgver = 0.16.5
	pkgrel = 1
	url = https://stoat.chat
	arch = x86_64
	license = AGPL-3.0-or-later
	makedepends = git
	makedepends = rust>=1.92.0
	makedepends = pkgconf
	makedepends = cmake
	depends = bash
	depends = coreutils
	depends = glibc
	depends = gcc-libs
	depends = openssl
	depends = zlib
	depends = curl
	depends = lcms2
	depends = dav1d
	depends = ca-certificates
	depends = ffmpeg
	depends = systemd
	optdepends = mongodb: local MongoDB server (may be hosted remotely)
	optdepends = valkey: local Redis-compatible server (may be hosted remotely)
	optdepends = rabbitmq: local AMQP broker (may be hosted remotely)
	optdepends = minio: local S3-compatible object store (may be hosted remotely)
	optdepends = livekit: local voice server (only needed for voice calls)
	optdepends = clamav: optional upload scanning when files.clamd_host is configured
	options = !lto
	backup = etc/stoat/Revolt.toml
	source = stoatchat::git+https://github.com/stoatchat/stoatchat.git#commit=7eaa89a1a38b26e359cec3c77818ac6de36e2647
	source = stoat-api.service
	source = stoat-crond.service
	source = stoat-events.service
	source = stoat-file-server.service
	source = stoat-gifbox.service
	source = stoat-proxy.service
	source = stoat-pushd.service
	source = stoat-voice-ingress.service
	source = stoat.conf
	source = stoat-wait-api
	source = stoat.tmpfiles
	source = stoat-Revolt.toml
	source = README.arch.md
