pkgbase = ocsinventory-agent
	pkgdesc = Hardware and software inventory tool (client)
	pkgver = 2.10.5
	pkgrel = 2
	url = http://www.ocsinventory-ng.org
	install = ocsinventory-agent.install
	arch = x86_64
	arch = aarch64
	license = GPL
	depends = perl
	depends = which
	depends = dmidecode
	depends = pciutils
	depends = perl-libwww
	depends = perl-lwp-protocol-https
	depends = perl-io-socket-ssl
	depends = perl-net-ip
	depends = perl-xml-simple
	depends = perl-net-snmp
	optdepends = perl-proc-daemon: daemon mode (--daemon)
	optdepends = perl-proc-pid-file: prevent concurrent runs
	optdepends = perl-edid: monitor inventory
	optdepends = perl-net-netmask: SNMP network scan
	optdepends = smartmontools: disk model, firmware and serial numbers
	optdepends = upower: battery inventory
	optdepends = ipmitool: BMC network interface inventory
	backup = etc/ocsinventory/ocsinventory-agent.cfg
	backup = etc/ocsinventory/modules.conf
	backup = etc/cron.d/ocsinventory-agent
