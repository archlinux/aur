pkgname = shelly-bin
	pkgdesc = Shelly: A Modern Arch Package Manager (prebuilt binary)
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = dconf
	depends = gnupg
	depends = zstd
	depends = json-glib
	optdepends = fish: Fish shell completions
	optdepends = zsh: Zsh shell completions
	optdepends = libstarfish: dependency viewer for arch packages
	optdepends = shelly-flatpak-backend-bin: Flatpak package management support
	optdepends = fuse2: run AppImages that require FUSE 2
	provides = shelly
	conflicts = shelly
	conflicts = shelly-git
	backup = etc/shellybuild.conf

pkgname = shelly-flatpak-backend-bin
	pkgdesc = Optional native Flatpak backend for Shelly (prebuilt binary)
	depends = shelly-bin=3.1.1-1
	depends = flatpak
	provides = shelly-flatpak-backend=3.1.1
	conflicts = shelly-flatpak-backend
	conflicts = shelly-flatpak-backend-git
