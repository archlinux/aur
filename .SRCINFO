	source = 0015-Allow-keeping-Android-app-in-background-with-QtQuick.patch
	source = 0016-Enable-minimal-and-offscreen-plugins-when-compiling-.patch
	source = 0017-Allow-configuring-use-of-OpenSSL-in-QPasswordDigesto.patch
	source = 0018-Drop-CMAKE_SYSTEM_VERSION-from-modules-json-if-Linux.patch
	source = 0019-Workaround-linker-error-about-missing-symbol-__sync_.patch
