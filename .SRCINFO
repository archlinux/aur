pkgbase = waymobar
	pkgdesc = Wayland status bar written and configured in Haskell, with rivermonad widgets
	pkgver = 0.4.0
	pkgrel = 1
	url = https://github.com/prietus/waymobar
	arch = x86_64
	arch = aarch64
	license = BSD-3-Clause
	depends = ghc
	depends = ghc-libs
	depends = haskell-network
	depends = cairo
	depends = pango
	depends = glib2
	depends = gdk-pixbuf2
	depends = libpulse
	optdepends = rivermonad: workspaces, layout and window title widgets
	optdepends = curl: weather and calendar widgets
	optdepends = ttf-nerd-fonts-symbols: icons
	optdepends = ttf-material-symbols-variable: icons (the ones of rivermonad-dotfiles)
	optdepends = libnotify: notifications when the configuration fails to compile
	optdepends = geoclue: locate the weather without a fixed place
	optdepends = power-profiles-daemon: the power profile widget
	optdepends = mako: the notifications widget (makoctl)
	source = waymobar-0.4.0.tar.gz::https://github.com/prietus/waymobar/archive/v0.4.0.tar.gz
	sha256sums = 91e47785539d4539c1b5542fe4838778c5c0334b0c8ccc16404ff6ddcec7ede1

pkgname = waymobar
