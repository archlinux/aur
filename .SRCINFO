pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.11.1.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.11.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.11.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.11.1.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-6.11.1.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.11.1.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.11.1.arch1-1-x86_64.pkg.tar.zst
	sha256sums = cd4e61e74b7691d24b7b3a9ed463c23c063c28fde3a7ea7910bbf5bcb91c071e
	sha256sums = 793c54b23a733cd01b9ea4940fbc64db6ed78ca3bf3c59d8c8ed5372fdb271ee
	sha256sums = 72dd1d9e51e4bf2b8df8620398dddd27377922d19f96c468ccf350ec0683feda

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.11.1.arch1-1-bin
	depends = linux6.11.1.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.11.1.arch1-1-headers-bin
	depends = linux6.11.1.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.11.1.arch1-1-docs-bin
	depends = linux6.11.1.arch1-1-docs-bin

pkgname = linux6.11.1.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.11.1-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.11.1.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.11.1-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.11.1.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.11.1-arch1-1
	conflicts = linux-docs
