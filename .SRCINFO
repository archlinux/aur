	url = https://github.com/crmne/chatwithwork-desktop
	install = chatwithwork-desktop-bin.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	depends = alsa-lib
	depends = libpipewire
	depends = glibc
	depends = gcc-libs
