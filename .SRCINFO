pkgbase = uq
	pkgdesc = Themeable Hyprland desktop: shell, theme and layout daemon, CLI and base config
	pkgver = 0.3.15
	pkgrel = 1
	url = https://github.com/asafelobotomy/uq
	install = uq.install
	arch = x86_64
	license = MIT
	checkdepends = lua
	checkdepends = qt6-declarative
	makedepends = cargo
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = kcolorscheme
	makedepends = kconfig
	depends = uq-hyprland-pin>=0.56.2
	depends = dbus
	depends = glib2
	depends = qt6ct
	depends = gcc-libs
	depends = quickshell>=0.3.1
	depends = quickshell<0.4
	depends = brightnessctl
	depends = upower
	depends = systemd
	depends = noto-fonts-emoji
	depends = gnome-keyring
	depends = kirigami
	depends = qqc2-desktop-style
	depends = qt6-declarative
	depends = kvantum
	depends = polkit
	depends = kcolorscheme
	depends = kconfig
	optdepends = kitty: default terminal (SUPER+Return)
	optdepends = adw-gtk-theme: makes GTK 3 apps follow the uQ theme (stock Adwaita stays light)
	optdepends = papirus-icon-theme: icon theme used by every uQ theme
	optdepends = bibata-cursor-theme: cursor theme used by every uQ theme
	optdepends = ttf-jetbrains-mono: monospace font
	optdepends = inter-font: interface font
	optdepends = wireplumber: volume keys and the Sound settings page
	optdepends = playerctl: media keys
	optdepends = networkmanager: network status in the shell and the Network settings page
	optdepends = scdr: CPU priorities for the focused app and builds (enable scdr-session; uQ starts it)
	optdepends = tailscale: exit-node and VPN status in the shell
	optdepends = bluez: Bluetooth status in the shell and the Bluetooth settings page
	optdepends = power-profiles-daemon: power profile switching
	optdepends = hyprlock: fallback lock for the SUPER+CTRL+L recovery bind
	optdepends = noti-fi: notification backend
	optdepends = fprintd: fingerprint unlock
	optdepends = crum-bs: uninstall apps with their leftovers and clean up storage
	optdepends = xzram: the Memory and swap page in Settings
	optdepends = scale_tail: the Tailscale page and quick-settings tile
	optdepends = greetd: the uQ login screen (run0 uqctl greeter enable)
	optdepends = kwallet-pam: unlock KDE Wallet at the uQ login screen
	optdepends = networkmanager-openvpn: OpenVPN connections on the Network settings page
	optdepends = sound-theme-freedesktop: the test sound on the Sound settings page
	optdepends = xorg-xrandr: tells X11 apps which display is the main one
	optdepends = grim: screenshots (Print)
	optdepends = slurp: pick an area for a screenshot (Print)
	optdepends = wl-clipboard: copy screenshots to the clipboard (Copy in the preview)
	optdepends = kate: KWrite, a plain text editor
	options = !lto
	backup = etc/pam.d/uq-greetd
	backup = etc/pam.d/uq-greeter
	backup = etc/pam.d/uq-lock
	backup = etc/pam.d/uq-lock-fingerprint
	backup = etc/uq/greetd.toml
	backup = etc/uq/greeter.toml
	source = uq-0.3.15.tar.gz::https://github.com/asafelobotomy/uq/releases/download/v0.3.15/uq-0.3.15.tar.gz
	sha256sums = 0e3910fc34dfed7ac2825329ab9254b7529da595949d8613aca6ced9650ec064

pkgname = uq
