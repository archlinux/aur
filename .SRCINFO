pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 7.1.3.arch2
	pkgrel = 2
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-7.1.3.arch2-2-x86_64.pkg.tar.zst
	noextract = linux-headers-7.1.3.arch2-2-x86_64.pkg.tar.zst
	noextract = linux-docs-7.1.3.arch2-2-x86_64.pkg.tar.zst
	options = !strip
