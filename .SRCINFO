pkgbase = rust-anything-bin
	pkgdesc = Incrementally port applications to Rust and verify them against recorded behavior
	pkgver = 3.3.0
	pkgrel = 1
	url = https://github.com/erkamyaman/rust-anything
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc>=2.34
	depends = libgcc
	optdepends = rust>=1:1.97: build Rust ports and run gate checks with Cargo, rustfmt, and Clippy
	optdepends = nodejs>=22.6: record JavaScript and TypeScript behavior (profiling requires Node.js 24 or newer)
	optdepends = python>=3.9: run the Python and C recording and replay harnesses
	optdepends = gcc: compile C originals for recording
	optdepends = go>=1.22: record Go behavior
	optdepends = ruby>=3: record Ruby behavior
	optdepends = java-environment>=17: provide javac and java for the Java harness
	optdepends = kotlin: compile Kotlin originals for recording and replay
	optdepends = php>=8: run the PHP recording and replay harness
	optdepends = dotnet-sdk: build and run the C# recording and replay harness
	optdepends = wasm-bindgen: build WebAssembly bindings (must match the port’s locked crate version)
	optdepends = android-tools: provide adb for Android on-device recording and replay
	provides = rust-anything=3.3.0
	conflicts = rust-anything
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/erkamyaman/rust-anything/releases/download/v3.3.0/rust-anything-v3.3.0-x86_64-unknown-linux-gnu.tar.gz
	sha256sums_x86_64 = e0b3456a9b1a6ae2f1205397815f21f3797be1e3ca505985d5ae9e054ee5dcc0
	source_aarch64 = https://github.com/erkamyaman/rust-anything/releases/download/v3.3.0/rust-anything-v3.3.0-aarch64-unknown-linux-gnu.tar.gz
	sha256sums_aarch64 = a56790fbc6a0615deb969b272ce53114d66032da462f061818cf6206513d4b02

pkgname = rust-anything-bin
