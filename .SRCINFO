pkgbase = pw-live-danmaku-git
	pkgdesc = Render a Bilibili live chat as a transparent PipeWire video node for OBS
	pkgver = r24.6070b8a
	pkgrel = 1
	url = https://github.com/zlinux-live-util/pw-live-danmaku
	install = pw-live-danmaku-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	depends = cairo
	depends = pango
	depends = gdk-pixbuf2
	depends = glib2
	depends = libpipewire
	depends = curl
	depends = openssl
	depends = brotli
	depends = zlib
	depends = pipewire
	optdepends = obs-pwvideo: OBS source plugin able to pick this PipeWire node (the bundled linux-pipewire plugin cannot)
	optdepends = noto-fonts-cjk: CJK glyphs for the chat, which is mostly Chinese
	provides = pw-live-danmaku
	conflicts = pw-live-danmaku
	source = pw-live-danmaku-git::git+https://github.com/zlinux-live-util/pw-live-danmaku.git
	source = pw-video-simple-interface::git+https://github.com/zlinux-live-util/pw-video-simple-interface.git
