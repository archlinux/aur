pkgbase = tscsync
	pkgdesc = Pre-boot TSC sync for AMD (UEFI) so Linux keeps the TSC clocksource
	pkgver = 2.2.3
	pkgrel = 1
	url = https://github.com/Zanasin/tscsync
	install = tscsync.install
	arch = x86_64
	license = MIT
	makedepends = curl
	makedepends = binutils
	makedepends = gcc
	makedepends = make
	depends = bash
	depends = util-linux
	depends = systemd
	optdepends = sbsigntools: sign the EFI binary during tscsync-setup (needed if Secure Boot is on)
	optdepends = sbctl: enroll/sign with your Secure Boot keys
	optdepends = mokutil: detect Secure Boot / MOK state during setup
	conflicts = tscsync-git
	options = !strip
	options = !lto
	source = tscsync-2.2.3.tar.gz::https://github.com/Zanasin/tscsync/archive/refs/tags/v2.2.3.tar.gz
	source = 0001-arch-usr-paths.patch
	sha256sums = d0e53df3c3938c185d7331a375a127a6ffc8f52d1e1c135022e0a5ebb7460faa
	sha256sums = eb97a977731fe1e652be401a4f906f238bcf677b488b96c53ca7a374fb1cae0f

pkgname = tscsync
