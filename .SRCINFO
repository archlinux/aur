pkgbase = ahfail
	pkgdesc = Screen locker that says 'ah ah ah, you didn't say the magic word' on a wrong password
	pkgver = 0.10.1
	pkgrel = 1
	url = https://gitea.weircon.dk/agw/gtk-ahfail
	install = ahfail.install
	arch = x86_64
	license = AGPL-3.0-only
	makedepends = meson
	makedepends = ninja
	makedepends = cargo
	depends = gtk3
	depends = gtk-session-lock
	depends = gstreamer
	depends = gst-plugins-bad-libs
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = pam
	depends = glib2
	depends = gdk-pixbuf2
	depends = cairo
	depends = pango
	depends = at-spi2-core
	depends = gst-plugins-base-libs
	depends = glibc
	depends = libgcc
	depends = libx11
	optdepends = pipewire-pulse: raise the volume to 100% on a failed attempt (or libpulse)
	optdepends = libpulse: raise the volume to 100% on a failed attempt
	optdepends = swayidle: lock automatically on Wayland
	optdepends = xss-lock: lock automatically on X11
	optdepends = gtklock: legacy gtklock module (/usr/lib/gtklock/ahfail-module.so)
	options = !lto
	backup = etc/pam.d/ahfail
