pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.50-2-lts-bin
	depends = linux6.18.50-2-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.50-2-lts-headers-bin
	depends = linux6.18.50-2-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.50-2-lts-docs-bin
	depends = linux6.18.50-2-lts-docs-bin

pkgname = linux6.18.50-2-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.50-2-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.50-2-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.50-2-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.50-2-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.50-2-lts
	conflicts = linux-lts-docs
