pkgbase = linux-pf
	pkgdesc = pf-kernel
	pkgver = 6.12.pf4
	pkgrel = 1
	url = https://pfkernel.natalenko.name
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = cpio
	makedepends = gettext
	makedepends = libelf
	makedepends = pahole
	makedepends = perl
	makedepends = python
	makedepends = tar
	makedepends = xz
	options = !debug
	options = !strip
	source = https://codeberg.org/pf-kernel/linux/archive/4fcf93768329ba26eab86a1bab57248215c993b2.tar.gz
	source = config
	b2sums = SKIP
	b2sums = de33c2b10ff57f434234e15681ff93b2afa00cfbe69aa9bea36492557cf13acc9d4f74f0b27f697a750162637aca0949668e20edbd4fbbd7aad96a8fed267a8a

pkgname = linux-pf
	pkgdesc = The pf-kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = ksmbd-tools: userspace tools for the ksmbd kernel SMB server
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = uksmd: userspace KSM helper daemon
	optdepends = v4l2loopback-utils: v4l2-loopback device utilities
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = linux-pf
	provides = KSMBD-MODULE
	provides = NTFS3-MODULE
	provides = UKSMD-BUILTIN
	provides = V4L2LOOPBACK-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-pf-headers
	pkgdesc = Headers and scripts for building modules for the pf-kernel
	depends = pahole
	provides = linux-pf-headers
