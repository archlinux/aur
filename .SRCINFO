pkgbase = linux-rvkernel-bore-clang
	pkgdesc = RvKernel Linux is a custom Linux kernel, a fork of CachyOS kernel
	pkgver = 6.19.3
	pkgrel = 1
	url = https://github.com/Rve27/RvKernel-Linux
	arch = x86_64
	license = GPL-2.0-only
	noextract = linux-rvkernel-bore-lto-6.19.3-1-x86_64.pkg.tar.zst
	source = https://github.com/Rve27/RvKernel-Linux/releases/download/6.19.3/linux-rvkernel-bore-lto-6.19.3-1-x86_64.pkg.tar.zst
	sha256sums = 6144618892ed082fecc592ef75df6497e8bde894f9fb6362fcf5f41699593d2d

pkgname = linux-rvkernel-bore-clang
	pkgdesc = RvKernel Linux kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE
