pkgbase = clock-tui-bin
	pkgdesc = A terminal clock app with clock, timer, stopwatch, countdown, and clock widgets (prebuilt binary)
	pkgver = 0.16.0
	pkgrel = 1
	url = https://github.com/akitaonrails/clock-tui
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = gcc-libs
	optdepends = curl: fetch weather data for the tclock-weather example widget
	optdepends = jq: faster JSON parsing in the tclock-weather and tclock-system-health example widgets
	optdepends = btrfs-progs: btrfs health row in the tclock-system-health example widget
	provides = clock-tui=0.16.0
	conflicts = clock-tui
	conflicts = clock-tui-debug
	options = !strip
	options = !debug
	source_x86_64 = clock-tui-0.16.0-x86_64.tar.gz::https://github.com/akitaonrails/clock-tui/releases/download/v0.16.0/clock-tui-linux-x86_64.tar.gz
	sha256sums_x86_64 = 8e607de226477bf3bf6cbe95be39a181028c8636965ceda8eb63c73887f6b57a
	source_aarch64 = clock-tui-0.16.0-aarch64.tar.gz::https://github.com/akitaonrails/clock-tui/releases/download/v0.16.0/clock-tui-linux-aarch64.tar.gz
	sha256sums_aarch64 = c0e0f8e3f0eda839667a980907c4a5e35708820bd84682393eeb7cfa1d9acf3f

