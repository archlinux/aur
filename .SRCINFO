pkgbase = kappa-file-manager
	pkgdesc = Brutalist file manager for Ryoku OS and any Wayland desktop (Rust core, Quickshell UI); independent community project
	pkgver = 0.1.11
	pkgrel = 1
	url = https://github.com/satodu/kappa-file-manager
	arch = x86_64
	arch = aarch64
	license = 0BSD
	makedepends = cargo
	depends = quickshell
	depends = xdg-utils
	depends = glib2
	depends = udisks2
	depends = gcc-libs
	depends = glibc
	optdepends = ryoku-desktop: follow the Ryoku theme, radius and language
	optdepends = ttf-space-grotesk: interface font
	optdepends = ttf-fraunces-variable: title font
	optdepends = ttf-jetbrains-mono-nerd: icon glyphs and metadata font
	optdepends = noto-fonts-cjk: kanji watermark
	optdepends = kdeconnect: phone pairing, ping, ring and sharing
	optdepends = kio-fuse: browse phone folders as local files
	optdepends = sshfs: browse SSH (SFTP) servers as local folders
	optdepends = rclone: browse Google Drive and OneDrive remotes (mount)
	optdepends = matugen: Kappa-only color schemes (Appearance)
	optdepends = swww: set an image as wallpaper from the details panel
	optdepends = ghostty: default terminal for "Open terminal here" (any terminal in $TERMINAL also works)
	source = kappa-file-manager-0.1.11.tar.gz::https://github.com/satodu/kappa-file-manager/archive/refs/tags/v0.1.11.tar.gz
	sha256sums = 5ca67e3dea1d7cd018ab177dfe67c9a73148cf0b3f03172bdfbfb655c2e74773

pkgname = kappa-file-manager
