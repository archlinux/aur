pkgbase = chatwithwork-local-agent-git
	pkgdesc = Chat with Work: desktop app, terminal interface and local background agent (development version)
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/crmne/chatwithwork-local-agent
	install = chatwithwork-local-agent-git.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = git
	makedepends = cargo
	depends = glibc
	depends = gcc-libs
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	optdepends = org.freedesktop.secrets: store the device key in your keyring
	optdepends = xdg-desktop-portal: native folder picker
	optdepends = systemd: start the agent now and at login with cww daemon install
	provides = cww
	provides = cww-app
	provides = chatwithwork-local-agent
	conflicts = cww
	conflicts = chatwithwork-local-agent
	conflicts = chatwithwork-local-agent-bin
	options = !debug
	options = !lto
	source = chatwithwork-local-agent-git::git+https://github.com/crmne/chatwithwork-local-agent.git
	sha256sums = SKIP

pkgname = chatwithwork-local-agent-git
