pkgbase = kanidm
	pkgdesc = A identity management service and clients.
	pkgver = 1.12.1
	pkgrel = 1
	url = https://github.com/kanidm/kanidm
	arch = x86_64
	arch = aarch64
	license = MPL-2.0
	makedepends = cargo
	makedepends = systemd
	makedepends = clang
	makedepends = tpm2-tss
	makedepends = lld
	options = !buildflags
	source = kanidm-1.12.1.tar.gz::https://github.com/kanidm/kanidm/archive/refs/tags/v1.12.1.tar.gz
	sha256sums = d31453a6d78b774eb4109622ac13eada112ba144f2772358920c7c28e9be1fc1

pkgname = kanidm
	depends = kanidm-server=1.12.1
	depends = kanidm-clients=1.12.1
	depends = kanidm-unixd-clients=1.12.1

pkgname = kanidm-clients
	pkgdesc = kanidm client to interact with kanidm identity management server.
	depends = libgit2
	backup = etc/kanidm/config

pkgname = kanidm-server
	pkgdesc = kanidm server for idendity management, supports RADIUS, ssh key management.
	depends = libgit2
	backup = etc/kanidm/server.toml

pkgname = kanidm-unixd-clients
	pkgdesc = kanidm localhost resolver to resolve posix identities to a kanidm instance.
	depends = tpm2-tss
	backup = etc/kanidm/unixd
