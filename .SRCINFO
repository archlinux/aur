	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.10.9.zen1-2-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.10.9.zen1-2-x86_64.pkg.tar.zst
