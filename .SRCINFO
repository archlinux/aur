pkgbase = matuwall-bin
	pkgdesc = Fast and lightweight wallpaper picker for Wayland
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/naurissteins/Matuwall
	arch = x86_64
	license = GPL-3.0-or-later
	depends = wayland
	depends = libxkbcommon
	depends = libpng
	depends = libjpeg-turbo
	depends = libwebp
	optdepends = awww: apply wallpapers
	optdepends = sweetbg: apply wallpapers
	optdepends = matugen: generate colorschemes from the applied wallpaper
	optdepends = python-pywal: generate colorschemes from the applied wallpaper
	provides = matuwall=0.2.0
	conflicts = matuwall
	conflicts = matuwall-git
	options = !debug
