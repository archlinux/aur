	url = https://github.com/openlawsvpn/go-openlawsvpn
	install = openlawsvpn.install
	arch = x86_64
	arch = aarch64
	arch = powerpc64le
	license = LGPL-2.1-or-later
	makedepends = go
	makedepends = rust
	makedepends = gtk4
	makedepends = libadwaita
	makedepends = openssl
