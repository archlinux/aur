pkgbase = sumi-bin
	pkgdesc = Paint, draw and sketch: the Sumi desktop app (prebuilt binary)
	pkgver = 0.1.2
	pkgrel = 1
	url = https://github.com/mafuzyk/sumi
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = vulkan-icd-loader
	optdepends = mesa: OpenGL/EGL fallback when the GPU has no Vulkan
	optdepends = vulkan-intel: Vulkan driver for Intel integrated GPUs
	optdepends = vulkan-radeon: Vulkan driver for AMD Radeon GPUs
	optdepends = vulkan-nouveau: Vulkan driver for NVIDIA GPUs (open-source Nouveau)
	optdepends = vulkan-swrast: software Vulkan driver (CPU rendering, no GPU required)
	optdepends = ffmpeg: time-lapse, animation and video import/export
	optdepends = poppler: open PDF files as frames
	optdepends = pipewire-audio: Feedback Sounds and brush sounds via pw-play/pw-cat (PipeWire)
	optdepends = libpulse: Feedback Sounds and brush sounds via paplay/pacat (PulseAudio client)
	optdepends = alsa-utils: Feedback Sounds and brush sounds via aplay (ALSA)
	provides = sumi
	conflicts = sumi
	options = !strip
	source = sumi-bin-0.1.2-linux-x86_64.tar.gz::https://github.com/mafuzyk/sumi/releases/download/v0.1.2/sumi-0.1.2-linux-x86_64.tar.gz
