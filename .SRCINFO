pkgbase = agent-glovebox
	pkgdesc = Hardware-isolated, allowlist-firewalled sandbox for running Claude Code
	pkgver = 0.20.0
	pkgrel = 1
	url = https://github.com/AlexanderMattTurner/agent-glovebox
	install = agent-glovebox.install
	arch = any
