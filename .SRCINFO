pkgbase = ps-vulkanplay-bin
	pkgdesc = Remote Play client for PS5 and PS4 consoles, with its own Vulkan renderer
	pkgver = 0.0.3
	pkgrel = 1
	url = https://github.com/codingncaffeine/PS-VulkanPlay
	arch = x86_64
	license = AGPL-3.0-only
	depends = glibc
	depends = gcc-libs
	depends = vulkan-icd-loader
	depends = libpulse
	depends = openssl
	depends = fontconfig
	depends = freetype2
	depends = libx11
	depends = libice
	depends = libsm
	depends = libxrandr
	depends = libxi
	depends = libxcursor
	depends = libxext
	depends = libxrender
	optdepends = webkit2gtk-4.1: the PSN sign-in page in a window of the app (otherwise it opens in the browser)
	optdepends = vulkan-driver: a graphics driver with Vulkan 1.2
	optdepends = libdecor: window borders on Wayland desktops that draw none
	optdepends = xdg-utils: open the sign-in page in the browser
	provides = ps-vulkanplay
	conflicts = ps-vulkanplay
	options = !strip
	source = https://github.com/codingncaffeine/PS-VulkanPlay/releases/download/v0.0.3/PS-VulkanPlay-0.0.3-linux-x64.tar.gz
