pkgname = socalabs-wavetable-lv2-bin
	pkgdesc = Socalabs Retro Wavetable Synth (LV2)
	groups = pro-audio
	groups = lv2-plugins
	depends = fontconfig
	depends = freetype2
	depends = glibc
	depends = gcc-libs
	depends = libcurl.so
