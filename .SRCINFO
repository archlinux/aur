pkgbase = niri-bin
	pkgdesc = Scrollable-tiling Wayland compositor
	pkgver = 0.1.4
	pkgrel = 1
	url = https://github.com/YaLTeR/niri
	install = niri.install
	arch = aarch64
	arch = x86_64
	license = GPL-3.0-or-later
