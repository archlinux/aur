	optdepends = alsa-lib: звук через ALSA (старые системы)
	optdepends = libpulse: звук через PulseAudio
	optdepends = pipewire-jack: JACK-аудио для профессиональной звукозаписи
	optdepends = libcups: печать через CUPS
	optdepends = gnutls: TLS/SSL в приложениях
	optdepends = libgcrypt: криптографические функции
	optdepends = libsasl: SASL-аутентификация (SMTP, LDAP)
	optdepends = krb5: Kerberos (домены Windows/AD)
	optdepends = unixodbc: ODBC-драйверы баз данных
	optdepends = vulkan-icd-loader: Vulkan (DirectX 10+, vkd3d)
	optdepends = ocl-icd: OpenCL
	optdepends = libva: аппаратное декодирование видео
	optdepends = v4l-utils: захват видео (веб-камеры)
	optdepends = glu: GLU-утилиты OpenGL
	optdepends = ffmpeg: мультимедиа-кодеки (видео в MF)
	optdepends = libgphoto2: цифровые камеры
	optdepends = sane: сканеры
	optdepends = pcsclite: смарт-карты и токены
	optdepends = libusb: USB-устройства
	optdepends = sdl2-compat: геймпады через SDL
	optdepends = dbus: устройства Bluetooth через BlueZ
	optdepends = libpng: PNG-изображения
	optdepends = libjpeg-turbo: JPEG-изображения
	optdepends = libtiff: TIFF-изображения
	optdepends = libxml2: XML-парсер
	optdepends = libxslt: XSLT-трансформации
	optdepends = wine-mono: .NET-приложения (Office, 1С)
	optdepends = wine-gecko: HTML-рендеринг внутри Wine
	optdepends = winetricks: установка Windows-библиотек в префикс
	optdepends = xorg-xwayland: X11-драйвер в Wayland-сессии (рекомендуется)
	optdepends = perl: для winemaker и function_grep.pl (разработка)
	optdepends = samba: netapi32 (интеграция с AD, сетевые SMB-шары)
