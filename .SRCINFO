pkgbase = clockwork-orange-git
	pkgdesc = Wallpaper manager and downloader with plugin support (Wallhaven, DuckDuckGo Images) for KDE Plasma 6
	pkgver = 4.3.1
	pkgrel = 1
	url = https://github.com/ushineko/clockwork-orange
	install = clockwork-orange.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = go
	makedepends = git
	makedepends = gcc
	makedepends = pkgconf
	makedepends = mesa
	makedepends = wayland-protocols
	depends = libgl
	depends = libx11
	depends = libxcursor
	depends = libxrandr
	depends = libxinerama
	depends = libxi
	depends = libxxf86vm
	depends = libxkbcommon
	depends = wayland
	depends = qt6-tools
	depends = kconfig
	provides = clockwork-orange
	conflicts = clockwork-orange
	options = !strip
	options = !debug
	source = clockwork-orange-git::git+https://github.com/ushineko/clockwork-orange.git
	sha256sums = SKIP

pkgname = clockwork-orange-git
