pkgbase = lazarus-git
	pkgdesc = Delphi-like IDE for FreePascal
	pkgver = 3.4.r1807.g258a7a4
	pkgrel = 1
	url = https://gitlab.com/freepascal.org/lazarus/lazarus
	arch = x86_64
	license = GPL-2.0-only
	license = Apache-2.0
	license = LGPL-2.0-only
	license = LicenseRef-LGPL-exception
	license = CC-BY-SA-4.0
	makedepends = git
	makedepends = fpc
	makedepends = fpc-src
	makedepends = gtk2
	makedepends = gtk3
	makedepends = qt5pas
	makedepends = qt6pas
	makedepends = rsync
	options = !makeflags
	options = libtool
	options = staticlibs
	options = !strip
	source = lazarus::git+https://gitlab.com/freepascal.org/lazarus/lazarus.git
	sha256sums = SKIP

pkgname = lazarus-git
	pkgdesc = Delphi-like IDE for FreePascal - common files
	depends = fpc
	depends = fpc-src
	depends = gdb
	optdepends = perl: to run some scripts in the tools directory
	optdepends = gtk2: to compile gtk2 apps
	optdepends = gtk3: to compile gtk3 apps
	optdepends = qt5pas: to compile Qt5 apps
	optdepends = qt6pas: to compile Qt6 apps
	provides = lazarus=3.4
	conflicts = lazarus

pkgname = lazarus-gtk3-git
	pkgdesc = Delphi-like IDE for FreePascal - gtk3 version
	depends = lazarus
	depends = desktop-file-utils
	depends = gtk3
	provides = lazarus-gtk3=3.4
	conflicts = lazarus-gtk2
	conflicts = lazarus-gtk3
	conflicts = lazarus-qt5
	conflicts = lazarus-qt6

pkgname = lazarus-qt6-git
	pkgdesc = Delphi-like IDE for FreePascal - qt6 version
	depends = lazarus
	depends = qt6pas
	provides = lazarus-qt6=3.4
	conflicts = lazarus-gtk2
	conflicts = lazarus-gtk3
	conflicts = lazarus-qt5
	conflicts = lazarus-qt6
