	makedepends = lv2
	makedepends = pkgconf
	makedepends = python
	depends = aspnet-runtime
	depends = pipewire
	depends = pipewire-pulse
	depends = wireplumber
	depends = libpulse
	depends = libusb
	depends = lilv
	depends = fontconfig
	depends = libx11
	depends = libice
	depends = libsm
	depends = glib2
	optdepends = swh-plugins: software ClipGuard for the XLR Dock
	optdepends = lsp-plugins-lv2: a starter set of LV2 plugins for the inserts
	optdepends = opendeck: Stream Deck control through the bundled plugin
	optdepends = gdk-pixbuf2: SVG application icons in the UI
	optdepends = librsvg: SVG application icons in the UI
