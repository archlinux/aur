pkgbase = source2viewer
	pkgdesc = Valve's Source 2 resource file format parser, decompiler, and exporter.
	pkgver = 21.1
	pkgrel = 1
	url = https://github.com/ValveResourceFormat/ValveResourceFormat
	arch = x86_64
	license = MIT
	license = CC-BY-2.5
	makedepends = dotnet-sdk-bin
	makedepends = gendesk
	conflicts = valveresourceformat
	replaces = valveresourcefromat
	options = !strip
	options = !debug
	source = https://github.com/ValveResourceFormat/ValveResourceFormat/archive/refs/tags/21.1.tar.gz
	sha256sums = 6700eb517c5969464d7867f240ecfe6c6ba57ceecf6ba0e82779ef5dbb7a9928

pkgname = source2viewer
	install = source2viewer.install
	depends = bash
	depends = hicolor-icon-theme
	depends = wine

pkgname = source2viewer-cli
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = dotnet-runtime>=10
