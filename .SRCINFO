pkgname = nvidia-565xx-utils
	pkgdesc = NVIDIA drivers utilities, 565 branch
	install = nvidia-565xx-utils.install
	depends = libglvnd
	depends = egl-wayland
	optdepends = nvidia-settings: configuration tool
	optdepends = xorg-server: Xorg support
	optdepends = xorg-server-devel: nvidia-xconfig
	optdepends = opencl-nvidia: OpenCL support
	provides = nvidia-utils=565.77
