	makedepends = ripgrep
	makedepends = go-md2man
	source = shelly-git::git+https://github.com/Seafoam-Labs/Shelly-ALPM.git#branch=development
	sha256sums = SKIP

pkgname = shelly-git
	pkgdesc = Shelly: A Modern Arch Package Manager (git version)
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = dconf
	depends = gnupg
	depends = zstd
	depends = json-glib
	optdepends = fish: Fish shell completions
	optdepends = zsh: Zsh shell completions
	optdepends = libstarfish: dependency viewer for arch packages
	optdepends = shelly-flatpak-backend-git: Flatpak package management support
	optdepends = fuse2: run AppImages that require FUSE 2
