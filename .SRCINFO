pkgbase = artcraft-launcher-bin
	pkgdesc = Install, update and launch the Craft App Suite (prebuilt binary)
	pkgver = 0.16.1
	pkgrel = 1
	url = https://github.com/storytold/craft-launcher
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	optdepends = alsa-lib: sound support
	optdepends = pipewire-alsa: audio playback and recording via PipeWire
	optdepends = pulseaudio: audio playback and recording via PulseAudio
	optdepends = wayland: native Wayland display support
	optdepends = libx11: X11 and XWayland display support
	optdepends = libxcursor: X11 cursor handling
	optdepends = libxi: X11 input handling
	optdepends = libxrandr: X11 display resolution handling
	optdepends = libglvnd: GPU rendering through EGL
	optdepends = mesa: GPU rendering through EGL
	optdepends = vulkan-driver: GPU rendering through Vulkan
	optdepends = xdg-desktop-portal: native desktop integration and file dialogs
	optdepends = cups: printing support
	provides = artcraft-launcher=0.16.1
	conflicts = artcraft-launcher
	conflicts = artcraft-launcher-git
	conflicts = artcraft-launcher-appimage
	options = !strip
	options = !debug
