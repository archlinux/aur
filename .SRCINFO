	depends = alsa-lib
	depends = libglvnd
	depends = wayland
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libx11
	depends = libxcursor
	depends = libxrandr
	depends = libxi
	depends = dbus
	depends = ffmpeg
	depends = gpu-screen-recorder
	depends = hicolor-icon-theme
	optdepends = xdg-desktop-portal: file dialogs
	optdepends = zenity: file dialogs without a portal
	optdepends = mpv: hardware-accelerated video preview in the trimmer
	provides = lapse
	conflicts = lapse
