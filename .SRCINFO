pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.13.1.arch2
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.13.1.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.13.1.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.13.1.arch2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.13.1.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.13.1.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.13.1.arch2-1-x86_64.pkg.tar.zst
	sha256sums = a93f449bc6a031d10b51e0212f1b18c21abc0c5aafea294d0aceeb37a8b99b2f
	sha256sums = 95af9867b772ebc58570e360d37a4e40cd81c6468ead5209b5c2dfd2ee8b68f3
	sha256sums = 70468b89bb8a3c53789103acccf7f777f512025cd0460135527d3b6e1386cb12

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.13.1.arch2-1-bin
	depends = linux6.13.1.arch2-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.13.1.arch2-1-headers-bin
	depends = linux6.13.1.arch2-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.13.1.arch2-1-docs-bin
	depends = linux6.13.1.arch2-1-docs-bin

pkgname = linux6.13.1.arch2-1-bin
	pkgdesc = The Linux kernel and modules, version 6.13.1-arch2-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.13.1.arch2-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.13.1-arch2-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.13.1.arch2-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.13.1-arch2-1
	conflicts = linux-docs
