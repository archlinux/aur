pkgbase = mod_tile-git
	pkgdesc = A daemon and apache module for rendering and serving Mapnik raster tiles
	pkgver = 0.9.1.r2.gd77dca7
	pkgrel = 1
	url = https://github.com/openstreetmap/mod_tile
	arch = aarch64
	arch = i686
	arch = x86_64
	license = GPL-2.0-or-later
	checkdepends = curl
	checkdepends = jq
	checkdepends = procps-ng
	makedepends = apache
	makedepends = apr
	makedepends = boost
	makedepends = cmake
	makedepends = git
	makedepends = glib2
	makedepends = iniparser
	makedepends = mapnik
	source = mod_tile-git::git+https://github.com/openstreetmap/mod_tile.git
	source = renderd-postgresql.service
	source = renderd.service
	source = renderd.sysusers
	source = renderd.tmpfiles
	sha256sums = SKIP
	sha256sums = 6f4bae7a7c7e52344633941db5a5720c448bef0282aa306347f336a475d0d44f
	sha256sums = 7a90d0f27e8a0fea4c8bcad141eb99ec57e65b42638e60a04d3b760b0460ed6f
	sha256sums = 9d36c0aec084797d4bd8f641bc204a4f04491a5e65724c65f0c1e701b1453966
