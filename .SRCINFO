	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libxml2
	depends = libidn2
	depends = libldap
	depends = courier-unicode
	depends = ncurses
	depends = openssl
	provides = cone
	source = https://sourceforge.net/projects/courier/files/cone/2.6/cone-2.6.tar.bz2
