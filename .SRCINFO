pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.23
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.23-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.23-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.23-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.23-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.23-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.23-1-x86_64.pkg.tar.zst
	sha256sums = 98a375a4fe024204655f0f05859f2a5ecd01a2aba4ec040433e28e5690f1c64e
	sha256sums = 60a4a850db5a5d44d8ce44cba3132ad2301f08ef8935ef585456c7238ec09027
	sha256sums = a40e7e5495b326ba6e7babca9d07f1b7d97496af5407a80222689afa4673156b

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.23-1-lts-bin
	depends = linux6.18.23-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.23-1-lts-headers-bin
	depends = linux6.18.23-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.23-1-lts-docs-bin
	depends = linux6.18.23-1-lts-docs-bin

pkgname = linux6.18.23-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.23-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.23-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.23-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.23-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.23-1-lts
	conflicts = linux-lts-docs
