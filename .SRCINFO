pkgbase = vector-view
	pkgdesc = Vector View: GTK4 viewer for images, videos (mpv), PDFs and office documents
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/Not-Bad-Company/vector
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = gtk4
	depends = glib2
	depends = gdk-pixbuf2
	depends = mpv
	depends = poppler-glib
	depends = cairo
	depends = libglvnd
	depends = graphene
	depends = glibc
	depends = libgcc
	depends = hicolor-icon-theme
	optdepends = ttf-jetbrains-mono-nerd: the intended font and icons
	optdepends = libreoffice-fresh: preview Word, Excel and PowerPoint files (or libreoffice-still)
	optdepends = ffmpegthumbnailer: video thumbnails in the gallery
	optdepends = ffmpeg: video details (ffprobe)
	optdepends = poppler: PDF details (pdfinfo)
	optdepends = webp-pixbuf-loader: WebP images
	optdepends = libavif: AVIF images
	optdepends = libheif: HEIC images
	optdepends = libjxl: JPEG XL images
	optdepends = librsvg: SVG images
	options = !lto
