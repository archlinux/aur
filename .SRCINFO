pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.26
	pkgrel = 2
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.26-2-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.26-2-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.26-2-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.26-2-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.26-2-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.26-2-x86_64.pkg.tar.zst
	sha256sums = d92efa1562d0aefc258d7ef2cef891845130f6f060877c9ff086fe8adcf69dff
	sha256sums = 2c80bb2a3a06440414c0c42277bd438b007e32541ed1a03df4c0494cb8f9a179
	sha256sums = 3e0cecf4a839b514a8ad616f994d0f0da713f8fefff18ba6ca03642ae4f6aa85

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.26-2-lts-bin
	depends = linux6.18.26-2-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.26-2-lts-headers-bin
	depends = linux6.18.26-2-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.26-2-lts-docs-bin
	depends = linux6.18.26-2-lts-docs-bin

pkgname = linux6.18.26-2-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.26-2-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.26-2-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.26-2-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.26-2-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.26-2-lts
	conflicts = linux-lts-docs
