pkgname = nginx-without-server-header
	pkgdesc = Lightweight web server, IMAP/POP3 and TCP/UDP proxy server, without HTTP server header
	depends = pcre2
	depends = zlib
	depends = openssl
	depends = geoip
	depends = mailcap
	depends = libxcrypt
