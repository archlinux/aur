pkgbase = arch-update-full
	pkgdesc = Sentinel Protocol: Update automation (Pacman/AUR/Flatpak/Snap) and auditing.
	pkgver = 4.0
	pkgrel = 2.1
	url = https://github.com/GustavoGianeli/arch-update-full
