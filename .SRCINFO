pkgbase = bountytool
	pkgdesc = End-to-end bug bounty reconnaissance, vulnerability triage and reporting suite
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/SaisakthiM/BountyTool
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = rust
	depends = gcc-libs
	depends = glibc
	optdepends = nuclei: template based vulnerability scanning (nuclei stage)
	optdepends = subfinder: passive subdomain enumeration (passive stage)
	optdepends = httpx: HTTP probing and technology detection (probe stage)
	optdepends = katana: crawling for endpoints and parameters (urls stage)
	optdepends = ffuf: content and directory discovery (content stage)
	optdepends = gobuster: content discovery fallback when ffuf is absent
	optdepends = dalfox: XSS verification of reflected parameters
	optdepends = sqlmap: SQL injection confirmation of native hits
	optdepends = nmap: port and service discovery (deep profile, ports stage)
	optdepends = naabu: fast port discovery before nmap
	optdepends = findomain: second opinion on passive subdomains
	optdepends = interactsh-client: out-of-band callbacks for blind SSRF (OAST)
	optdepends = seclists: real wordlists for content discovery
	options = !lto
	source = bountytool-0.1.0.tar.gz::https://github.com/SaisakthiM/BountyTool/archive/v0.1.0.tar.gz
