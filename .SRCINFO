	source = 0015-Workaround-linker-error-about-missing-symbol-__sync_.patch
	source = 0016-Workaround-Unknown-CMake-command-_qt_test_emscripten.patch
	source = 0017-Fix-configuration-when-EMSCRIPTEN_ROOT-is-an-absolut.patch
	source = 0018-Allow-handling-Android-activity-lifecycle-by-user-pr.patch
	source = 0019-Avoid-compile-error-due-to-inconsistent-use-of-noexc.patch
