	depends = glibc
	depends = ca-certificates
	depends = p11-kit
	optdepends = kubo: open .eth sites on IPFS
	optdepends = tor: open .eth sites that are Tor onion services
	optdepends = networkmanager: handled by `enclavedns enable`
	options = !lto
	backup = etc/enclavedns/config.toml
