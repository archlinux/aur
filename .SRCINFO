pkgbase = hornero-shell
	pkgdesc = Hornero OS desktop shell, built with Quickshell, QML and Qt for Wayland
	pkgver = 1.3.9
	pkgrel = 2
	url = https://github.com/HorneroOS/shell
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = git
	makedepends = ninja
	makedepends = pkgconf
	makedepends = qt6-tools
	depends = aubio
	depends = hornero-config>=0.4.3
	depends = horneroctl-bin>=0.2.0_preview51
	depends = libqalculate
	depends = pipewire
	depends = wireplumber
	depends = pipewire-pulse
	depends = pipewire-alsa
	depends = python
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = ttf-ibm-plex
	depends = quickshell>=0.3.2
	optdepends = app2unit: launch apps as systemd user units
	optdepends = libcava: audio spectrum visualiser (resolved at runtime; a missing or ABI-broken libcava only silences the spectrum)
	optdepends = brightnessctl: laptop backlight control
	optdepends = ddcutil: external monitor brightness control
	optdepends = ffmpeg: Hornero Chromatic colours from video wallpapers (one frame)
	optdepends = fish: shell used by helper scripts
	optdepends = hyprland: compositor integration via hyprctl
	optdepends = lm_sensors: temperature sensor readings
	optdepends = networkmanager: network status via nmcli
	optdepends = qt6-imageformats: Hornero Chromatic colours from WebP, AVIF, TIFF and more wallpaper formats
	optdepends = swappy: screenshot annotation
	optdepends = wl-clipboard: clipboard integration via wl-copy
	source = hornero-shell::git+https://github.com/HorneroOS/shell.git#commit=1c0e7e02a627804603ce6392f6fe2fca31271011
	sha256sums = SKIP

pkgname = hornero-shell
