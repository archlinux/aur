pkgbase = scdr-git
	pkgdesc = Process scheduling and priority daemon for EEVDF and sched_ext kernels (git)
	pkgver = 0.4.0.r3.ga65d13b
	pkgrel = 1
	url = https://github.com/asafelobotomy/scdr
	arch = x86_64
	arch = aarch64
	license = MPL-2.0
	makedepends = cargo
	makedepends = git
	makedepends = clang
	makedepends = bpf
	makedepends = libbpf
	makedepends = libelf
	makedepends = zlib
	makedepends = dbus
	makedepends = systemd
	source = scdr::git+https://github.com/asafelobotomy/scdr.git
	sha256sums = SKIP

pkgname = scdr-git
	install = scdr.install
	depends = libgcc
	depends = glibc
	depends = dbus
	depends = systemd
	optdepends = scx-scheds: sched_ext schedulers ([sched_ext])
	optdepends = scx-tools: scx_loader, which scdr drives ([sched_ext])
	optdepends = scx-devbox: sched_ext scheduler that follows scdr profiles
	optdepends = pipewire: audio-client role (pw-dump)
	optdepends = gamemode: game role
	optdepends = power-profiles-daemon: per-power-profile roles
	optdepends = uq: the Scheduling page and bar widget in uQ
	optdepends = plasma-workspace: the SCDR panel widget in KDE Plasma
	optdepends = kquickcharts: live graphs in the Plasma panel widget
	optdepends = kcmutils: settings pages of the Plasma panel widget
	provides = scdr
	conflicts = scdr

pkgname = scx-devbox-git
	pkgdesc = sched_ext scheduler for low-end machines doing development with LLM agent apps (git)
	install = scx-devbox.install
	license = GPL-2.0-only
	depends = glibc
	depends = libbpf
	optdepends = scdr: per-process hints (batch builds, latency slices, nice)
	provides = scx-devbox
	conflicts = scx-devbox
