pkgbase = syn-vm-git
	pkgdesc = synshell virtual machines on QEMU/KVM: wizard, built-in display, snapshots, USB and PCI passthrough, guest agent, CLI and MCP
	pkgver = 0.2.0.r0
	pkgrel = 1
	url = https://github.com/VitaminDB/synshell
	arch = x86_64
	arch = aarch64
	groups = synshell-apps
	license = GPL-3.0-only
	makedepends = rustup
	makedepends = git
	makedepends = clang
	makedepends = pkgconf
	makedepends = mesa
	makedepends = libinput
	makedepends = seatd
	makedepends = libxkbcommon
	makedepends = libdrm
	makedepends = fontconfig
	makedepends = freetype2
	makedepends = dbus
	makedepends = ffmpeg
	makedepends = sqlite
	makedepends = libarchive
	makedepends = pipewire
	makedepends = alsa-lib
	makedepends = fuse3
	makedepends = mingw-w64-gcc
	depends = synshell-core
	optdepends = qemu-desktop: the virtual machines themselves
	optdepends = edk2-ovmf: UEFI
	optdepends = swtpm: TPM 2.0 for Windows 11
	optdepends = virtiofsd: virtiofs shared folder (Windows)
	optdepends = samba: SMB shared folder
	optdepends = virtio-win: Windows drivers and guest agent (AUR)
	optdepends = libisoburn: syn-vm guest tools image (xorriso)
	provides = syn-vm
	conflicts = syn-vm
	conflicts = syn-vm-bin
	options = !lto
	source = synshell::git+https://github.com/VitaminDB/synshell.git
	sha256sums = SKIP

pkgname = syn-vm-git
