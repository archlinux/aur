pkgbase = mingw-w64-qt5-base-static
	pkgdesc = A cross-platform application and UI framework, native OpenGL backend (mingw-w64)
	pkgver = 5.15.19+kde+r96
	pkgrel = 1
	url = https://www.qt.io/
	arch = any
	groups = mingw-w64-qt5
	license = GPL3
	license = LGPL3
	license = FDL
	license = custom
	makedepends = mingw-w64-gcc
