pkgbase = sysforge
	pkgdesc = AUR helper that builds and tracks packages tuned to your CPU with PGO, BOLT and LTO
	pkgver = 4.0.0
	pkgrel = 1
	url = https://github.com/KeithRaghubar/sysforge
	install = sysforge.install
	arch = any
	license = MIT
	makedepends = uv
	makedepends = python-installer
	depends = python>=3.11
	depends = git
	depends = sudo
	depends = gnupg
	depends = base-devel
	optdepends = bash-completion: bash tab completions
	optdepends = ccache: compiler cache support
	optdepends = sccache: Rust compiler cache support
	optdepends = uv: required for bootstrap pipeline (configure stage)
	optdepends = zsh: zsh shell support
	optdepends = glow: in-shell markdown rendering for docs
	optdepends = zsh-completions: additional zsh completions
	optdepends = clang: build packages and kernels with the LLVM profiles (pulls in llvm and compiler-rt)
	optdepends = lld: link with -fuse-ld=lld (the LLVM and optimized profiles)
	optdepends = mesa-utils: post-install mesa smoke check (eglinfo)
	optdepends = vulkan-tools: post-install mesa smoke check (vulkaninfo)
	conflicts = sysforge-git
	backup = etc/sysforge/sysforge.toml
	backup = etc/sysforge/profiles.toml
	backup = etc/sysforge/packages.toml
	backup = etc/sysforge/kernel.toml
	backup = etc/sysforge/toolchain.toml
	source = sysforge-4.0.0.tar.gz::https://github.com/KeithRaghubar/sysforge/archive/v4.0.0.tar.gz
	source = sysforge-4.0.0.tar.gz.asc::https://github.com/KeithRaghubar/sysforge/releases/download/v4.0.0/sysforge-4.0.0.tar.gz.asc
	validpgpkeys = 23774499080F9288FEFB49CE7AAE22E6E1B4B22C
	sha256sums = e9b748430796edfd4ed25f545d2415f4a00a97d88ad1ba9c24791efa1e1fbe69
	sha256sums = SKIP

pkgname = sysforge
