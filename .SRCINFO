pkgname = linux-wsl
	pkgdesc = The Linux (WSL without Microsoft out-of-tree patches) kernel and modules
	depends = coreutils
	depends = kmod
	optdepends = linux-wsl-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = WIREGUARD-MODULE

pkgname = linux-wsl-headers
	pkgdesc = Headers and scripts for building modules for the Linux (WSL without Microsoft out-of-tree patches) kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS

pkgname = linux-wsl-docs
	pkgdesc = Documentation for the Linux (WSL without Microsoft out-of-tree patches) kernel
