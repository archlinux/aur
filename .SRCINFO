pkgbase = minicom-hangfix
	pkgdesc = A serial communication program (fixes UI hang on zero-width chars, shows port in terminal title, BLE serial mode)
	pkgver = 2.11.1
	pkgrel = 3
	url = https://salsa.debian.org/minicom-team/minicom
	arch = x86_64
