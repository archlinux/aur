pkgbase = wwal-bin
	pkgdesc = Fast Wayland wallpaper, video, shader, and Steam Workshop engine with Material You color extraction (prebuilt binary)
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/Execorn/wwal
	arch = x86_64
	license = GPL-3.0-or-later
