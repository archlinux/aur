pkgbase = dogelog
	pkgver = 1.2.4
	pkgrel = 1
	url = https://www.dogelog.ch/
	arch = any
	groups = dogelog
	license = custom
	makedepends = npm
	options = !strip
	source = dogelog::git+https://www.dogelog.ch/dogelog/.git
	sha256sums = SKIP

pkgname = dogelog-node
	pkgdesc = The avant-garde of logic programming (NodeJS backend)
	depends = nodejs

pkgname = dogelog-py
	pkgdesc = The avant-garde of logic programming (Python backend)
	depends = python

pkgname = dogelog-java
	pkgdesc = The avant-garde of logic programming (Java backend)
	depends = java-runtime
