pkgname = protonmail-bridge-free
	pkgdesc = Integrate ProtonMail account with any program that supports IMAP and SMTP (Qt desktop application)
	depends = protonmail-bridge-free-core
	depends = abseil-cpp
	depends = libgcc
	depends = libstdc++
	depends = glibc
	depends = grpc
	depends = hicolor-icon-theme
	depends = protobuf
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = sentry-native
	provides = protonmail-bridge
	conflicts = protonmail-bridge

pkgname = protonmail-bridge-free-core
	pkgdesc = Integrate ProtonMail account with any program that supports IMAP and SMTP (core executable and daemon)
	depends = glib2
	depends = glibc
	depends = libfido2
	depends = libsecret
	optdepends = gnome-keyring: gnome-keyring support
	optdepends = org.freedesktop.secrets: Applications that support Freedesktop secrets api
	optdepends = pass: pass support
	provides = protonmail-bridge-core
	conflicts = protonmail-bridge-core
