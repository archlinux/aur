pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.41
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.41-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.41-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.41-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.41-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.41-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.41-1-x86_64.pkg.tar.zst
	sha256sums = 24a3d6a66e73482722e34cc351acdc2170d39aff531b25bb4e7c4cdf81544ebf
	sha256sums = 308b7339ead506974f0c22b0d33c48cca3c2a65b127aa46398c9433930f01ce0
	sha256sums = a9ee5078b72166f0540034abd0713f5ab437f0f2b892bbbefc5abbeb2c6add39

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.41-1-lts-bin
	depends = linux6.18.41-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.41-1-lts-headers-bin
	depends = linux6.18.41-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.41-1-lts-docs-bin
	depends = linux6.18.41-1-lts-docs-bin

pkgname = linux6.18.41-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.41-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.41-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.41-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.41-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.41-1-lts
	conflicts = linux-lts-docs
