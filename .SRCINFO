pkgbase = nzlauncher-bin
	pkgdesc = Launcher for Hyprland that learns how you use it (prebuilt)
	pkgver = 0.4.6
	pkgrel = 1
	url = https://github.com/tuklu/nZlauncher
	arch = x86_64
	license = MIT
	depends = gtk4
	depends = gtk4-layer-shell
	depends = glib2
	depends = hyprland
	optdepends = ghostty: TUI face
	optdepends = cliphist: clipboard provider
	optdepends = wl-clipboard: clipboard provider, copying results
	optdepends = bluez-utils: bluetooth connect and power
	optdepends = iwd: wifi provider (or networkmanager)
	optdepends = networkmanager: wifi provider (or iwd)
	optdepends = hyprsunset: nightlight
	optdepends = power-profiles-daemon: power profiles (tlp-pd or tuned-ppd work too)
	optdepends = fd: file search before the daemon has built its index
	optdepends = fzf: nzlauncher pick
	optdepends = hyprmoncfg: monitor provider
	optdepends = swaybg: default wallpaper command
	provides = nzlauncher
	conflicts = nzlauncher
	conflicts = nzlauncher-git
	options = !strip
	options = !debug
	source = nzlauncher-0.4.6::https://github.com/tuklu/nZlauncher/releases/download/v0.4.6/nzlauncher-linux-amd64
	source = nzlauncher-gtk-0.4.6::https://github.com/tuklu/nZlauncher/releases/download/v0.4.6/nzlauncher-gtk-linux-amd64
	source = LICENSE-0.4.6::https://raw.githubusercontent.com/tuklu/nZlauncher/v0.4.6/LICENSE
	source = nzlauncher-0.4.6.service::https://raw.githubusercontent.com/tuklu/nZlauncher/v0.4.6/packaging/systemd/nzlauncher.service
	sha256sums = 65cb2f3d8c9d36b3b8a54ed714def910c33e3340282ee266174bb7f5da9a56f4
