pkgbase = claude-desktop-extra
	pkgdesc = Claude Desktop (official Linux build) with extra features: Computer Use, custom themes, multi-profile, Quick Entry - for distros upstream does not ship
	pkgver = 2.31226.1
	pkgrel = 1
	url = https://github.com/patrickjaja/claude-desktop-extra
	install = claude-desktop-extra.install
	arch = x86_64
	arch = aarch64
	license = custom:Claude
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libcap-ng
	depends = libcups
	depends = libdrm
	depends = libnotify
	depends = libpipewire
	depends = libseccomp
	depends = libsecret
	depends = libx11
	depends = libxcb
	depends = libxcomposite
	depends = libxdamage
	depends = libxext
	depends = libxfixes
	depends = libxkbcommon
	depends = libxrandr
	depends = mesa
	depends = nspr
	depends = nss
	depends = pango
	depends = systemd-libs
	depends = xdg-desktop-portal
	depends = xdg-utils
	optdepends = nodejs: System Node.js for MCP extensions that require specific versions (Electron bundles Node.js as fallback)
	optdepends = claude-code: optional pinned Claude Code CLI. NOT required - the app auto-downloads a checksum-verified CLI matching its required version. To force a system binary set CLAUDE_CODE_LOCAL_BINARY=/path/to/claude (npm i -g @anthropic-ai/claude-code)
	optdepends = virtiofsd: Cowork agent workspace VM - shares $HOME into the guest
	optdepends = imagemagick: Computer Use screenshot crop via convert - ONLY for the residual KDE-without-kwin-bridge spectacle tier (bundled bridges cover X11/wlroots/GNOME/KDE 6.6+)
	optdepends = ydotool: Computer Use input on exotic Wayland compositors ONLY (non-wlroots, non-GNOME, non-KDE; requires ydotoold daemon, v1.0+) - wlroots/GNOME/KDE use the bundled bridges
	optdepends = bubblewrap: Claude Code shell sandbox (needed with socat when an organization sandbox policy applies)
	optdepends = socat: Claude Code shell sandbox (with bubblewrap); also a faster Quick Entry toggle via socket (~2ms vs ~25ms python3)
	optdepends = bluez: Hardware Buddy (Nibblet BLE pet) - the daemon Web Bluetooth talks to; without it the in-app device scan finds nothing
	optdepends = gnome-keyring: credential storage backend for libsecret (KDE users: kwallet works too - upstream Recommends gnome-keyring | kwalletd)
	optdepends = xdg-desktop-portal-gtk: portal backend for DEs without their own (GNOME/KDE ship xdg-desktop-portal-gnome/-kde) - file dialogs, screen sharing
	optdepends = gjs: GNOME Shell search provider (Claude sessions in the Activities search; GNOME Shell already pulls it in)
	optdepends = desktop-file-utils: refreshes the desktop entry cache (update-desktop-database) on install
	provides = claude-desktop
	conflicts = claude-desktop
	conflicts = claude-desktop-bin
	replaces = claude-desktop-bin
	options = !strip
	options = !emptydirs
	source_x86_64 = claude-desktop-2.31226.1-1-linux.tar.gz::https://github.com/patrickjaja/claude-desktop-extra/releases/download/v2.31226.1/claude-desktop-2.31226.1-linux.tar.gz
	optdepends_x86_64 = qemu-system-x86: Cowork agent workspace VM (needs /dev/kvm + user in kvm group)
	optdepends_x86_64 = edk2-ovmf: Cowork agent workspace VM UEFI firmware (OVMF)
	sha256sums_x86_64 = a23cab763f0792e8ae2b80d516d7c1ec375a3049716524a604a32f6b5a3e8f5f
	source_aarch64 = claude-desktop-2.31226.1-1-linux-aarch64.tar.gz::https://github.com/patrickjaja/claude-desktop-extra/releases/download/v2.31226.1/claude-desktop-2.31226.1-linux-aarch64.tar.gz
	optdepends_aarch64 = qemu-system-aarch64: Cowork agent workspace VM (needs /dev/kvm + user in kvm group)
	optdepends_aarch64 = edk2-aarch64: Cowork agent workspace VM UEFI firmware (AAVMF)
	sha256sums_aarch64 = d43afacb530c9118e4f1d1573fb60f87f7c733fdf446bcae55cbd0255cc5888d

pkgname = claude-desktop-extra
