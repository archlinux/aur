pkgbase = bioma-shell
	pkgdesc = A desktop shell for niri, built with Quickshell: living surfaces rather than a bar
	pkgver = 1.0.0beta58
	pkgrel = 1
	url = https://github.com/AkusenArcade/Bioma
	install = bioma-shell.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = clang
	depends = niri
	depends = quickshell
	depends = qt6-5compat
	depends = vulkan-icd-loader
	depends = python
	depends = python-dateutil
	depends = libsecret
	depends = glib2
	depends = wl-clipboard
	depends = noto-fonts-emoji
	depends = imagemagick
	depends = libpipewire
	depends = gcc-libs
	depends = glibc
	depends = util-linux
	depends = fontconfig
	depends = ttf-spectral
	depends = ttf-orbitron
	depends = matugen
	depends = zenity
	depends = librsvg
	depends = udisks2
	depends = fd
	depends = libqalculate
	depends = xdg-utils
	depends = curl
	depends = grim
	depends = tesseract
	depends = tesseract-data-eng
	depends = wl-screenrec
	depends = pipewire
	depends = pipewire-audio
	depends = networkmanager
	depends = bluez
	depends = bluez-utils
	depends = cups
	depends = avahi
	depends = brightnessctl
	depends = ddcutil
	depends = upower
	depends = power-profiles-daemon
	depends = pciutils
	depends = libnotify
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gtk
	depends = hyprlock
	depends = greetd
	depends = greetd-agreety
	depends = polkit
	optdepends = whisper-cpp: dictation, the engine
	optdepends = ggml-vulkan: dictation on the GPU; without it, the CPU
	optdepends = whisper.cpp-model-large-v3-turbo-q5_0: dictation, the model (AUR)
	optdepends = python-evdev: dictation and the emoji cell, pasting into the window
	optdepends = business-network-wizard: company network setup (NTLM proxy, VPN, 802.1X, shares), opened from the connectivity cell
	optdepends = gnome-online-accounts: the calendars of Google, Microsoft, Nextcloud and WebDAV accounts in the clock
	optdepends = gnome-online-accounts-gtk: adding those accounts outside GNOME Settings
	optdepends = gamemode: performance mode, on by itself while a game runs
	optdepends = vulkan-driver: the shell drawn through Vulkan, a third lighter than OpenGL (vulkan-radeon, vulkan-intel, nvidia-utils)
	options = !lto
	backup = etc/xdg/autostart/bioma.desktop
	source = bioma-shell-1.0.0beta58.tar.gz::https://github.com/AkusenArcade/Bioma/archive/refs/tags/v1.0.0-beta.58.tar.gz
	sha256sums = 5bf1dd60684ff4dd8db04478fa532d70d79fd8dd3d0c2aafd57929092ec01886

pkgname = bioma-shell
