pkgname = linux-libre-hardened
	pkgdesc = The Security-Hardened Linux-libre kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-libre-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = usbctl: deny_new_usb control
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = LINUX-ABI_VERSION=6.17.13.hardened1
	conflicts = linux-hardened

pkgname = linux-libre-hardened-headers
	pkgdesc = Headers and scripts for building modules for the Security-Hardened Linux-libre kernel
	depends = pahole
	provides = 
	conflicts = linux-hardened-headers

pkgname = linux-libre-hardened-docs
	pkgdesc = Documentation for the Security-Hardened Linux-libre kernel
	provides = 
	conflicts = linux-hardened-docs
