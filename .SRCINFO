	depends = xdg-utils
	optdepends = bluez: org.bluez Bluetooth service (bluetooth.service) for Web Bluetooth peripherals
	optdepends = cups: org.cups.cupsd printing service (socket-activated cups.socket) for the Chromium portal Print interface and the libcups.so.2 client
	optdepends = xdg-desktop-portal: file-picker and screen-share dialogs
	optdepends = xdg-desktop-portal-gnome: file-picker, settings and screen-share backend on GNOME
	optdepends = xdg-desktop-portal-gtk: file-picker and settings backend on GTK desktops
	optdepends = xdg-desktop-portal-kde: file-picker and screen-share backend on KDE Plasma
	optdepends = xdg-desktop-portal-wlr: screen-share backend on wlroots compositors
	optdepends = xdg-desktop-portal-hyprland: window and region screen share plus portal global shortcuts on Hyprland
	optdepends = pipewire: PipeWire daemon that feeds the portal ScreenCast capture
	optdepends = wireplumber: PipeWire session and policy manager for voice and audio devices
	optdepends = pipewire-pulse: PulseAudio-compatible server for voice and audio devices
	optdepends = pipewire-alsa: ALSA client bridge to the PipeWire audio server for voice and audio devices
	optdepends = dunst: org.freedesktop.Notifications daemon for sessions without one
	optdepends = gnome-keyring: org.freedesktop.secrets service for session-token and password storage on GNOME and GTK desktops
	optdepends = gnome-shell-extension-appindicator: org.kde.StatusNotifierItem tray host on GNOME
	optdepends = plasma-desktop: org.kde.StatusNotifierWatcher tray host on KDE Plasma
	optdepends = fcitx5: org.fcitx.Fcitx input-method service for Avalonia D-Bus IME on Fcitx (alternative to ibus)
	optdepends = ibus: org.freedesktop.IBus.InputContext/Portal/Service input-method service probed by the payload (Avalonia IME); Arch ships it as ibus
	optdepends = kwallet: Plasma 6 secret storage (ksecretd) and kwalletd6 wallet for session-token and password storage on KDE Plasma
	optdepends = snixembed: StatusNotifierItem-to-XEmbed bridge for trays on minimal X11 sessions
	optdepends = waybar: org.kde.StatusNotifierWatcher tray host on wlroots compositors
	optdepends = speech-dispatcher: text-to-speech service for the Chromium libspeechd.so.2 probe (pulls libspeechd)
	optdepends = libvlc: LibVLC runtime probed by the Root player (libvlc.so.5, libvlccore.so.9)
	optdepends = vlc-plugin-ffmpeg: video and stream codecs for LibVLC playback (pulls libvlc)
	optdepends = vlc-plugin-pulse: audio output for LibVLC playback on PipeWire and PulseAudio (pulls libvlc)
	optdepends = curl: crash report uploads for the bundled Chromium crash handler (chrome_crashpad_handler dlopens libcurl.so.4)
	optdepends = nvidia-utils: hardware video decode/encode on NVIDIA GPUs (provides libcuda.so.1, libnvcuvid.so.1, libnvidia-encode.so.1, libGLX_nvidia.so.0)
	optdepends = vulkan-intel: Intel GPU Vulkan driver and ICD (provides libvulkan_intel.so probed by the bundled Chromium GPU process)
	optdepends = vulkan-radeon: AMD GPU Vulkan driver and ICD (provides libvulkan_radeon.so probed by the bundled Chromium GPU process)
	optdepends = vulkan-swrast: lavapipe software Vulkan ICD (provides libvulkan_lvp.so probed by the bundled Chromium GPU process; Mesa ships no ICD by default)
	optdepends = vulkan-mesa-implicit-layers: Mesa implicit Vulkan layers (libVkLayer_MESA_device_select.so, libVkLayer_MESA_anti_lag.so) probed by the bundled Chromium GPU process; picks the right GPU on hybrid/multi-GPU systems
	provides = rootapp
	conflicts = rootapp
