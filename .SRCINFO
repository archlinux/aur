pkgbase = pigment-launcher-git
	pkgdesc = Roblox launcher and manager for Linux (drives the Sober runtime) — latest git
	pkgver = 0.2.2.r0.gfd47704
	pkgrel = 1
	url = https://github.com/SpeeNotPee/Pigment
	install = pigment-launcher-git.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = gtk4
	depends = libadwaita
	optdepends = flatpak: required to install and run the Sober runtime
	optdepends = xdg-utils: to set Pigment as the default roblox:// handler
	optdepends = kservice: kbuildsycoca6, refreshes KDE menus after a handler change
	provides = pigment-launcher
	conflicts = pigment-launcher
	options = !lto
	source = pigment-launcher-git::git+https://github.com/SpeeNotPee/Pigment.git
	sha256sums = SKIP

pkgname = pigment-launcher-git
