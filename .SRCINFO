	optdepends = openresearch-cli: standalone headless orx command
	optdepends = git: local project version control
	optdepends = zenity: graphical startup error dialogs
	optdepends = xorg-xwayland: desktop app on Wayland
	provides = openresearch=0.2.17
	conflicts = openresearch
	options = !strip
	options = !debug

