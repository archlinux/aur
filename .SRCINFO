pkgbase = picom-motion-git
	pkgdesc = picom with workspace and window animations for i3, from a fork that stages changes offered to picom
	pkgver = 13.r2999.g7cbdb17
	pkgrel = 1
	url = https://jornc.github.io/picom-motion/
	install = picom-motion-git.install
	arch = x86_64
	license = MPL-2.0 AND MIT
	checkdepends = python
	checkdepends = python-numpy
	makedepends = asciidoctor
	makedepends = git
	makedepends = mesa
	makedepends = meson
	makedepends = ninja
	makedepends = uthash
	depends = hicolor-icon-theme
	depends = libconfig
	depends = libdbus
	depends = libepoxy
	depends = libev
	depends = libgl
	depends = libxcb
	depends = pcre2
	depends = pixman
	depends = xcb-util-image
	depends = xcb-util-renderutil
	optdepends = i3-wm: win-cause needs i3; ws-direction works with any EWMH window manager
	optdepends = dbus: for controlling picom via D-Bus
	optdepends = python: for running picom-convgen.py
	optdepends = rtkit: for realtime scheduling priority
	optdepends = xorg-xprop: for picom-trans
	optdepends = xorg-xwininfo: for picom-trans
	provides = picom=13
	conflicts = picom
