pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.16
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.16-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.16-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.16-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.16-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.16-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.16-1-x86_64.pkg.tar.zst
	sha256sums = 7e99b65f31e407743bf537a3b41dd7089844922a8682c9ab65cab32b8e6932f8
	sha256sums = 112edc0bdba7cc7e62d2c83c60fd653127d67a986756b92570eeff499f3edd35
	sha256sums = ee6e505c1430fefd5ac4a34b311f17828f0135cc49868dbd6318ace39b03884c

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.16-1-lts-bin
	depends = linux6.18.16-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.16-1-lts-headers-bin
	depends = linux6.18.16-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.16-1-lts-docs-bin
	depends = linux6.18.16-1-lts-docs-bin

pkgname = linux6.18.16-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.16-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.16-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.16-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.16-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.16-1-lts
	conflicts = linux-lts-docs
