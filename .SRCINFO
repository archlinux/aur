	source = wycheproof::git+https://github.com/google/wycheproof.git
	source = berkeley-softfloat-3::git+https://github.com/ucb-bar/berkeley-softfloat-3.git
	source = edk2-cmocka::git+https://github.com/tianocore/edk2-cmocka.git
	source = oniguruma::git+https://github.com/kkos/oniguruma.git
	source = brotli::git+https://github.com/google/brotli.git
	source = jansson::git+https://github.com/akheron/jansson.git
	source = googletest::git+https://github.com/google/googletest.git
	source = edk2-subhook::git+https://github.com/tianocore/edk2-subhook.git
	source = pylibfdt::git+https://github.com/devicetree-org/pylibfdt.git
	source = public-mipi-sys-t::git+https://github.com/MIPI-Alliance/public-mipi-sys-t.git
	source = pugixml::git+https://github.com/zeux/pugixml.git
	source = mbedtls::git+https://github.com/Mbed-TLS/mbedtls.git
	source = libspdm::git+https://github.com/DMTF/libspdm.git
	source = cmocka::git+https://gitlab.com/cmocka/cmocka.git
