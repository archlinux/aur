pkgbase = maly
	pkgdesc = Local terminal music player (daemon + TUI + CLI) with mpv backend, gapless playback and MPRIS2
	pkgver = 1.17.0
	pkgrel = 1
	url = https://github.com/kitasael-burakku/Malody-Mallow
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = go
	makedepends = git
	depends = mpv
	optdepends = yt-dlp: buscar y descargar música (maly get y ctrl+g en la TUI)
	optdepends = ffmpeg: postprocesado de maly get y duraciones (ffprobe) en el escaneo
	optdepends = pipewire: visualizador de espectro (pw-record)
	optdepends = pulseaudio: visualizador de espectro (parec), alternativa a pipewire
