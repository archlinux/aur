pkgname = solana-bin
	pkgdesc = Solana CLI tools for wallets, staking, and token management
	install = solana-bin.install
	depends = glibc
	depends = libgcc
	depends = systemd-libs
	provides = solana=4.0.2
	provides = spl-token
	conflicts = solana

pkgname = solana-dev-bin
	pkgdesc = Solana developer tools: SBF compiler toolchain, test validator, and ledger tool
	depends = bash
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = cargo: required for cargo-build-sbf and cargo-test-sbf
	optdepends = solana-bin=4.0.2: CLI tools for interacting with clusters
	conflicts = solana
