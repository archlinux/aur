pkgbase = spotube
	pkgdesc = Open source Spotify client that doesn't require Premium nor uses Electron! Available for both desktop & mobile!
	pkgver = 4.0.0
	pkgrel = 1
	url = https://spotube.krtirtho.dev/
	arch = x86_64
	arch = aarch64
	license = BSD-4-Clause
	makedepends = clang
