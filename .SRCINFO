pkgbase = hyprpilot-mcp
	pkgdesc = Programmatic control of Hyprland for AI agents and humans: typed IPC client, daemon with undo/snapshots, CLI, MCP server, input synthesis, screen capture + OCR, and accessibility (AT-SPI) reading
	pkgver = 1.1.0
	pkgrel = 1
	url = https://github.com/sumerchoudhary78/HyprPilot
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = cargo
	depends = hyprland
	depends = gcc-libs
	depends = glibc
	optdepends = grim: screen capture for the Vision tools
	optdepends = slurp: interactive region selection for capture
	optdepends = tesseract: OCR for the Vision tools
	optdepends = tesseract-data-eng: English language data for OCR
	optdepends = wtype: text and key-chord input synthesis
	optdepends = ydotool: input-synthesis fallback that drives Hyprland keybinds
	optdepends = at-spi2-core: accessibility (AT-SPI) bus for the a11y tools
	source = hyprpilot-mcp-1.1.0.tar.gz::https://github.com/sumerchoudhary78/HyprPilot/archive/refs/tags/v1.1.0.tar.gz
