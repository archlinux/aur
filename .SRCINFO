pkgbase = minetest-git-dill
	pkgdesc = Minetest from git. This version uses github and allows aur helper devel functions to work properly. Also the PKGBUILD script is much simpler.
	pkgver = 1.0
	pkgrel = 2
	url = https://github.com/minetest/minetest
	arch = x86_64
	license = GPL
	depends = base-devel
	depends = libcurl-gnutls
	depends = cmake
	depends = libpng
	depends = sqlite
	depends = libogg
	depends = libvorbis
	depends = openal
	depends = freetype2
	depends = jsoncpp
	depends = gmp
	depends = luajit
	depends = leveldb
	depends = ncurses
	depends = zstd
	depends = gettext
	depends = sdl2
	depends = gcc
	depends = make
	depends = git
	source = git+https://github.com/minetest/minetest.git
	md5sums = SKIP

pkgname = minetest-git-dill
