pkgbase = hyprlogin-git
	pkgdesc = Work-in-progress greetd greeter forked from hyprlock
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/AuthenticSm1les/hyprlogin
	arch = x86_64
	license = BSD-3-Clause
	makedepends = cmake
	makedepends = git
	makedepends = hyprwayland-scanner
	makedepends = pkgconf
	depends = cairo
	depends = gcc-libs
	depends = glibc
	depends = hyprgraphics
	depends = hyprlang
	depends = hyprutils
	depends = libdrm
	depends = mesa
	depends = pango
	depends = pam
	depends = sdbus-cpp
	depends = wayland
	depends = wayland-protocols
	depends = libxkbcommon
	optdepends = greetd: login manager integration
	optdepends = hyprland: greeter compositor session
	provides = hyprlogin
	conflicts = hyprlogin
	options = !debug
	backup = etc/hyprlogin/hyprlogin.conf
	source = git+https://github.com/AuthenticSm1les/hyprlogin.git
	sha256sums = SKIP

pkgname = hyprlogin-git
