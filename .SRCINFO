pkgbase = cachymonitor
	pkgdesc = Gaming-oriented system monitor: FPS, 1% low, frametime, CPU/GPU/RAM/VRAM via MangoHud
	pkgver = 1.6.1
	pkgrel = 1
	url = https://github.com/YOUNES-2-wq/cachymonitor-linux
	arch = any
	license = MIT
	depends = python
	depends = pyside6
	optdepends = mangohud: in-game stats (FPS, 1% low, frametime)
	optdepends = nvidia-utils: NVIDIA GPU readings via nvidia-smi
	optdepends = pciutils: GPU marketing name via lspci
	optdepends = dmidecode: RAM type and speed (requires root)
	optdepends = yay: in-app updates (or paru)
	optdepends = polkit: password prompt for in-app updates
