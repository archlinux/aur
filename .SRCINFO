pkgbase = gramtty-bin
	pkgdesc = A terminal Telegram client (prebuilt binary, TDLib linked statically)
	pkgver = 1.5.1
	pkgrel = 1
	url = https://github.com/methamphetaminelab/gramtty
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = mpv: libmpv for playback inside the viewer, and the separate player (x)
	optdepends = ffmpeg: video and sticker previews, upload thumbnails, voice encoding
	optdepends = pipewire-audio: pw-record for voice messages, pw-play for notification sound
	optdepends = opus-tools: opusenc for voice messages (alternative to ffmpeg)
	optdepends = libnotify: desktop notifications (notify-send)
	optdepends = libcanberra: notification sound (canberra-gtk-play, alternative to pw-play)
	optdepends = wl-clipboard: clipboard copy and Ctrl+V paste on Wayland
	optdepends = xdg-utils: opening files and links externally (xdg-open)
	optdepends = kitty: recommended terminal for inline images (kitty graphics protocol)
	provides = gramtty
	conflicts = gramtty
	options = !strip
	options = !debug
	source = https://github.com/methamphetaminelab/gramtty/releases/download/v1.5.1/gramtty-1.5.1-x86_64-linux.tar.gz
	sha256sums = 9a134ca2f550c5e9b395e8136698a5574e1551a406b4276206e0590bff6386a1

pkgname = gramtty-bin
