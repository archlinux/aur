pkgbase = spitfire
	pkgdesc = Tiling Wayland compositor with a live-reloadable Lua config, in the spirit of dwm
	pkgver = 0.7.0
	pkgrel = 1
	url = https://github.com/dani-77/spitfire
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = wayland-protocols
	depends = wayland
	depends = libxkbcommon
	depends = mesa
	depends = seatd
	depends = libinput
	depends = libdisplay-info
	depends = pixman
	depends = dbus
	depends = gcc-libs
	depends = glibc
	optdepends = xwayland-satellite: run X11-only apps (preferred: menus and popups behave like native ones)
	optdepends = xorg-xwayland: run X11-only apps with the built-in XWayland support
	optdepends = xdg-desktop-portal: file-open dialogs, notifications and other portal prompts
	optdepends = iw: wifi widget in the bar
	optdepends = alacritty: terminal bound to Mod4+Return in the example config
	optdepends = greetd: use spitfire as a login-screen session
	options = !lto
	backup = etc/xdg-desktop-portal/spitfire-portals.conf
	source = spitfire-0.7.0.tar.gz::https://github.com/dani-77/spitfire/archive/refs/tags/v0.7.0.tar.gz
	sha256sums = 070ac35dfe8704855b5f072cefb0e7e38b1e773bd768120dac79c0779aca4191

pkgname = spitfire
