pkgbase = kairo-git
	pkgdesc = Safe, interactive Arch workstation installer and curated Wayland dotfiles
	pkgver = 0.1.0.r96.gea6c5ec
	pkgrel = 2
	url = https://github.com/nihitdev/kairo
	arch = any
	license = GPL-3.0-only
	license = MIT
	depends = bash
	depends = git
	optdepends = hyprland: Hyprland compositor configuration
	optdepends = kitty: terminal configuration
	optdepends = wezterm: modular terminal configuration
	optdepends = zsh: WezTerm default shell
	optdepends = zsh-autosuggestions: Zsh inline command suggestions
	optdepends = zsh-completions: Extra Zsh completions
	optdepends = zsh-history-substring-search: Zsh prefix/history search bindings
	optdepends = zsh-syntax-highlighting: Zsh command-line syntax highlighting
	optdepends = ttf-jetbrains-mono-nerd: WezTerm font and UI icons
	optdepends = rofi: Wayland launcher and menu configuration
	optdepends = waybar: status bar configuration
	optdepends = quickshell: Kairo desktop shell runtime
	optdepends = swaync: notification center configuration
	optdepends = hyprpaper: Hyprland wallpapers
	optdepends = hypridle: Hyprland idle management
	optdepends = hyprlock: lock screen configuration
	optdepends = cliphist: clipboard history menus
	optdepends = wl-clipboard: Wayland clipboard and screenshots
	optdepends = grim: screenshots
	optdepends = slurp: screenshot region selection
	optdepends = libnotify: screenshot and battery notifications
	optdepends = wireplumber: volume controls
	optdepends = brightnessctl: brightness controls
	optdepends = playerctl: media controls
	optdepends = python: desktop helpers and configuration validation
	optdepends = jq: desktop IPC and JSON processing
	optdepends = ttf-iosevka-nerd: desktop font and icons
	optdepends = neovim: editor configuration
	optdepends = fish: Fish shell configuration
	optdepends = nushell: Nushell configuration
	optdepends = starship: shell prompts
	optdepends = btop: Waybar system monitor action
	optdepends = pulsemixer: Waybar audio action
	optdepends = networkmanager: Waybar network action
	optdepends = bluetui: Waybar Bluetooth action
	optdepends = cava: Waybar music visualizer action
	optdepends = calcurse: Waybar calendar action
	optdepends = yazi: file manager configuration and Waybar action
	provides = kairo
	conflicts = kairo
	source = git+https://github.com/nihitdev/kairo.git#branch=main
	b2sums = SKIP

pkgname = kairo-git
