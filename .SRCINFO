	makedepends = git
	makedepends = ninja
	makedepends = pkgconf
	makedepends = rapidassist
	depends = gcc-libs
	depends = glibc
	provides = bin2cpp
	conflicts = bin2cpp
	options = !strip
	options = !lto
	options = !debug
	source = bin2cpp::git+https://github.com/end2endzone/bin2cpp.git#tag=3.1.0
