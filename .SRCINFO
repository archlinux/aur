pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.60
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.60-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.60-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.60-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.60-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.60-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.60-1-x86_64.pkg.tar.zst
	sha256sums = f396c6f9de91f37f74987b3bf793cdf48a0b23ea36b10e34a0554caae8089a95
	sha256sums = 7ccd24be4eb5a99d9fcacc0df9f9a06041aaf52cde278e7a8c6416d267455739
	sha256sums = bf0e03fd4bdf63b1dbd78a02e9bd8b6d81d83ace6b1229e89e5bf90f60127679

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.60-1-lts-bin
	depends = linux6.18.60-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.60-1-lts-headers-bin
	depends = linux6.18.60-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.60-1-lts-docs-bin
	depends = linux6.18.60-1-lts-docs-bin

pkgname = linux6.18.60-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.60-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.60-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.60-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.60-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.60-1-lts
	conflicts = linux-lts-docs
