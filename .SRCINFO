pkgbase = yt-x-git
	pkgdesc = Browse youtube from your terminal
	pkgver = v0.8.7.r4.ge321147
	pkgrel = 1
	url = https://github.com/Benexl/yt-x
	arch = any
	license = MIT
	makedepends = git
	depends = jq
	depends = curl
	depends = yt-dlp
	depends = fzf
	depends = sh
	depends = ffmpeg
	depends = ttf-jetbrains-mono-nerd
	optdepends = mpv: default media player
	optdepends = vlc: alternative media player
	optdepends = chafa: image previews (default renderer)
	optdepends = kitty: image previews via kitten icat
	optdepends = viu: image previews
	optdepends = ffmpegthumbnailer: thumbnails in the downloads extension
	optdepends = rofi: alternative launcher
	optdepends = libnotify: desktop notifications when not run from a terminal
	optdepends = wl-clipboard: copy video url on Wayland
	optdepends = xclip: copy video url on X11
	optdepends = xdg-utils: open videos and channels in the browser
	optdepends = gum: improved prompts and loaders
	optdepends = bat: default pager
	provides = yt-x
	conflicts = yt-x
	options = !strip
	source = yt-x-git::git+https://github.com/Benexl/yt-x.git
	md5sums = SKIP

pkgname = yt-x-git
