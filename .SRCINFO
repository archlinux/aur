	optdepends = zsh: the terminal setup Zenworks offers (installed when you accept it)
	optdepends = zoxide: the terminal setup Zenworks offers (installed when you accept it)
	optdepends = noto-fonts-cjk: Chinese, Japanese and Korean text
	optdepends = noto-fonts-extra: more weights and rare scripts
	optdepends = tesseract: copying text out of a picture (Picasso)
	optdepends = tesseract-data-eng: copying English text out of a picture
	optdepends = unrar: opening RAR archives in Terminus
	optdepends = ratarmount: browsing big archives without unpacking them
	optdepends = ntfsprogs: repairing and formatting NTFS drives
	optdepends = btrfs-progs: formatting Btrfs drives
	optdepends = xfsprogs: formatting XFS drives
	optdepends = f2fs-tools: formatting F2FS drives
	optdepends = solaar: Logitech mice and keyboards
	optdepends = bandwhich: network use per app in Zeus
	optdepends = iotop: disk use per process in Zeus
	optdepends = flatpak: the App Store in Ceres, once you opt in
	optdepends = github-cli: signing in to GitHub in Delphi
	optdepends = nodejs: the test suite (Oracle > Health > Tests)
	optdepends = openssh: SSH keys and SSH remotes in Delphi (installed when first needed)
	optdepends = ddcutil: monitor brightness in Control Hub (installed when first needed)
	optdepends = hyprsunset: night light in Control Hub (installed when first needed)
	optdepends = fwupd: firmware updates in Hestia (installed when first needed)
	optdepends = qt6-webengine: PDFs in Minerva (installed when the first PDF is opened)
	optdepends = python-pykeepass: KeePassXC vaults in Calypso (installed when first needed)
	optdepends = fcitx5: typing Chinese, Japanese, Korean and more (installed when Input methods is turned on)
	conflicts = zen-browser
