pkgbase = waybar-minimal-git
	pkgdesc = Highly customizable bar for Sway, wlroots-based, and other Wayland compositors; PKGBUILD tweaked minutely to eliminate (potentially) unnecessary dependency on gpsd.
	pkgver = 0.14.0.r144.ga02180a
	pkgrel = 1
	url = https://github.com/Alexays/Waybar
	arch = x86_64
	license = MIT
	makedepends = catch2
	makedepends = cmake
	makedepends = git
	makedepends = glib2-devel
	makedepends = meson
	makedepends = python-setuptools
	makedepends = scdoc
	makedepends = wayland-protocols
	depends = fmt
	depends = gtk-layer-shell
	depends = gtkmm3
	depends = jack
	depends = jsoncpp
	depends = libdbusmenu-gtk3
	depends = libevdev
	depends = libinput
	depends = libnl
	depends = libpulse
	depends = libsigc++
	depends = libwireplumber
	depends = libxkbcommon
	depends = playerctl
	depends = sndio
	depends = spdlog
	depends = upower
	depends = wayland
	optdepends = otf-font-awesome: Icons in the default configuration
	provides = waybar=0.14.0.r144
	conflicts = waybar
	backup = etc/xdg/waybar/config.jsonc
	backup = etc/xdg/waybar/style.css
	source = waybar::git+https://github.com/Alexays/Waybar.git
	sha256sums = SKIP

pkgname = waybar-minimal-git
