pkgname = faiss-gpu
	pkgdesc = A library for efficient similarity search and clustering of dense vectors (cuda or rocm accelarated).
	depends = blas
	depends = lapack
	depends = openmp
	depends = python-numpy
	depends = rocm-hip-runtime
	depends = cuda
	optdepends = cuda
