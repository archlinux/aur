pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.8.arch2
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.18.8.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.18.8.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.18.8.arch2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.18.8.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.18.8.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.18.8.arch2-1-x86_64.pkg.tar.zst
	sha256sums = 02a5e6c6d67c53de6954de63aa2e69187851f4a726112572b6e920bfe1621d6f
	sha256sums = 14019e9b829f55f7140ef703ae56db161f74a51f058ae7d47088b5f959ff03c1
	sha256sums = c1c09bf49abd68862cc728f03761b437e7fbbb1081be27885df9d49ecbe58848

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.8.arch2-1-bin
	depends = linux6.18.8.arch2-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.8.arch2-1-headers-bin
	depends = linux6.18.8.arch2-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.8.arch2-1-docs-bin
	depends = linux6.18.8.arch2-1-docs-bin

pkgname = linux6.18.8.arch2-1-bin
	pkgdesc = The Linux kernel and modules, version 6.18.8-arch2-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.18.8.arch2-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.18.8-arch2-1
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-headers

pkgname = linux6.18.8.arch2-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.18.8-arch2-1
	conflicts = linux-docs
