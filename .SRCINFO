pkgbase = tinox-bin
	pkgdesc = Native, statically typed programming language with an LLVM backend, garbage collection, and concurrency support (prebuilt binary)
	pkgver = 2.7.0
	pkgrel = 1
	url = https://github.com/subnix-work/tinox
	arch = x86_64
	license = MIT
	license = Apache-2.0
	depends = glibc
	depends = gc
	depends = openssl
	depends = llvm
	depends = gcc
	depends = xz
	depends = bzip2
	optdepends = clang: tinox repl / dev-mode on-the-fly runtime recompilation
	optdepends = sqlite: DB feature with driver = "sqlite" in tinox.toml
	optdepends = postgresql-libs: DB feature with driver = "postgres" in tinox.toml
	optdepends = mariadb-libs: DB feature with driver = "mysql" in tinox.toml
	provides = tinox=2.7.0
	conflicts = tinox
	source = https://github.com/subnix-work/tinox/releases/download/v2.7.0/tinox-2.7.0-linux-x86_64.tar.gz
	sha256sums = 01028754b604a16356353dc890d8fa39a74f7f788570a17bb6d2d469bdeada89

pkgname = tinox-bin
