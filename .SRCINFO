	url = https://github.com/brauliobo/zensmu
	install = zensmu.install
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = polkit
	depends = gcc-libs
	depends = glibc
	optdepends = dkms: automatically build and install bundled ryzen_smu kernel driver on package install/upgrade
