pkgbase = acer-sense-git
	pkgdesc = Linux alternative for AcerSense (Fan control, Battery limit, Profiles, Hyprland)
	pkgver = 2.1
	pkgrel = 1
	url = https://github.com/MaksSuRitik/acer-sense
	install = acer-sense.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = python-pyqt6
	depends = python-psutil
	depends = polkit
	depends = power-profiles-daemon
	depends = alsa-tools
	depends = smartmontools
	depends = dbus
	optdepends = hyprsunset: BluelightShield на Hyprland
	optdepends = wlsunset: BluelightShield на других Wayland-композиторах
	optdepends = hyprland: интеграция горячих клавиш (XF86Launch6 → микрофон, Fn+F → профили)
	optdepends = wireplumber: wpctl для управления громкостью и микрофоном
	provides = acer-sense
	conflicts = acer-sense
	source = git+https://github.com/MaksSuRitik/acer-sense.git
	sha256sums = SKIP

pkgname = acer-sense-git
