pkgname = solara-kernel
	pkgdesc = The Solara Linux Kernel — BORE scheduler, CachyOS patches, maximum POWER kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: correct wireless channels for your country
	optdepends = linux-firmware: firmware for various devices
	optdepends = modprobed-db: track kernel modules for localmodconfig
	optdepends = scx-scheds: sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE
	provides = linux
	conflicts = linux
	conflicts = linux-zen
	conflicts = linux-hardened
	replaces = linux
	replaces = linux-zen
	replaces = linux-hardened

pkgname = solara-kernel-hdr
	pkgdesc = Headers and scripts for building modules for the Solara Linux Kernel — BORE scheduler, CachyOS patches, maximum POWER kernel
	depends = binutils
