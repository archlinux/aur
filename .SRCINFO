pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.38
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.38-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.38-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.38-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.38-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.38-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.38-1-x86_64.pkg.tar.zst
	sha256sums = 19ef4078518430fb522b67b91395d8b4f4745b7346b13987f1464ed0edcf8c75
	sha256sums = 31f77b820a306d26403c0e337ebbf2d1d0b292c1e38b4b3c7604a3df742a54b2
	sha256sums = 5110bd61e8956599913447acac1517b41c3349a659358d946629d1034d922625

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.38-1-lts-bin
	depends = linux6.12.38-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.38-1-lts-headers-bin
	depends = linux6.12.38-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.38-1-lts-docs-bin
	depends = linux6.12.38-1-lts-docs-bin

pkgname = linux6.12.38-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.38-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.38-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.38-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.38-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.38-1-lts
	conflicts = linux-lts-docs
