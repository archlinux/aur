pkgbase = nzlauncher-bin
	pkgdesc = Launcher for Hyprland that learns how you use it (prebuilt)
	pkgver = 0.4.2
	pkgrel = 1
	url = https://github.com/tuklu/nZlauncher
	arch = x86_64
	license = MIT
	depends = gtk4
	depends = gtk4-layer-shell
	depends = glib2
	depends = hyprland
	optdepends = ghostty: TUI face
	optdepends = cliphist: clipboard provider
	optdepends = wl-clipboard: clipboard provider, copying results
	optdepends = bluez-utils: bluetooth connect and power
	optdepends = iwd: wifi provider (or networkmanager)
	optdepends = networkmanager: wifi provider (or iwd)
	optdepends = hyprsunset: nightlight
	optdepends = power-profiles-daemon: power profiles (tlp-pd or tuned-ppd work too)
	optdepends = fd: file search before the daemon has built its index
	optdepends = fzf: nzlauncher pick
	optdepends = hyprmoncfg: monitor provider
	optdepends = swaybg: default wallpaper command
	provides = nzlauncher
	conflicts = nzlauncher
	conflicts = nzlauncher-git
	options = !strip
	options = !debug
	source = nzlauncher-0.4.2::https://github.com/tuklu/nZlauncher/releases/download/v0.4.2/nzlauncher-linux-amd64
	source = nzlauncher-gtk-0.4.2::https://github.com/tuklu/nZlauncher/releases/download/v0.4.2/nzlauncher-gtk-linux-amd64
	source = LICENSE-0.4.2::https://raw.githubusercontent.com/tuklu/nZlauncher/v0.4.2/LICENSE
	source = nzlauncher-0.4.2.service::https://raw.githubusercontent.com/tuklu/nZlauncher/v0.4.2/packaging/systemd/nzlauncher.service
	sha256sums = 7a382454ae7ea744acba87dbe4ef4614a532c19eab825ab51a287724dff5a1fe
	sha256sums = 8d6aece6178c6f82cdce056dac2616298d4040d69f3d9e33d5ed33288f6cb6ec
	sha256sums = cffff6a257a267deefebc1866d636e5f1bd098550007dcd75e8de8fbb38375dc
	sha256sums = 0a66c4572ddf8c6759815f211d3838a5bdb91da3f971cda0ddfe7b6fcb9b1c9d

pkgname = nzlauncher-bin
