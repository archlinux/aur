pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.56
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.56-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.56-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.56-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.6.56-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.6.56-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.6.56-1-x86_64.pkg.tar.zst
	sha256sums = 8665c2eae14281c17601039fcf6bc9e74c16871f774d6c8c5e3bc098ae7b9b3f
	sha256sums = a6e676548e9b6c53c4bb5ab0fad20ff16e486e5317e424b150dfc0d01333a2ed
	sha256sums = 28f8e86cf8f9831df558d56ffa4ba6346741ec69868ead4c01204ebf73cf634d

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.6.56-1-lts-bin
	depends = linux6.6.56-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.6.56-1-lts-headers-bin
	depends = linux6.6.56-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.6.56-1-lts-docs-bin
	depends = linux6.6.56-1-lts-docs-bin

pkgname = linux6.6.56-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.6.56-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.6.56-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.6.56-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.6.56-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.6.56-1-lts
	conflicts = linux-lts-docs
