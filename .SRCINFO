pkgbase = libpamac-full
	pkgdesc = Library for Pamac package manager based on libalpm - flatpak and snap support enabled
	pkgver = 11.7.1
	pkgrel = 1
	epoch = 1
	url = https://github.com/manjaro/libpamac
	install = pamac.install
	arch = i686
	arch = pentium4
	arch = x86_64
	arch = arm
	arch = armv6h
	arch = armv7h
	arch = aarch64
	license = GPL3
	makedepends = vala
	makedepends = meson
	makedepends = gobject-introspection
	depends = libalpm.so=15
	depends = flatpak
	depends = snapd
	depends = snapd-glib
	depends = archlinux-appstream-data
	depends = appstream
	depends = polkit
	depends = libsoup3
	depends = git
	depends = json-glib
	depends = dbus-glib
	provides = libpamac
	conflicts = libpamac-aur
	conflicts = libpamac-flatpak
	conflicts = libpamac
	conflicts = libpamac-full-dev
	options = !emptydirs
	source = git+https://github.com/manjaro/libpamac.git#commit=9a9caef858a3d9314d927ff93f47b417ec965a95
	sha256sums = 7de20f4f4a96b516d9cf9d548195ba7105d8ac838ae6a6aa3a765b42ebce8ae8

pkgname = libpamac-full
	backup = etc/pamac.conf
