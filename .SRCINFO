pkgbase = rustnet
	pkgdesc = A cross-platform network monitoring terminal UI tool built with Rust.
	pkgver = 0.11.0
	pkgrel = 2
	url = https://github.com/domcyrus/rustnet
	install = rustnet.install
	arch = x86_64
