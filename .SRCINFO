pkgbase = linuwu-sense-dkms
	pkgdesc = Acer Laptop WMI Extras Driver (DKMS) with clang/gcc support for options
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/0x7375646F/Linuwu-Sense
	install = linuwu-sense.install
	arch = any
	license = GPL
	makedepends = git
	depends = dkms
	optdepends = linux-headers: for standard kernel
	optdepends = linux-lts-headers: for lts kernel
	optdepends = linux-cachyos-headers: for cachyos
	optdepends = linux-zen-headers: for zen kernel
	optdepends = linux-hardened-headers: for hardened kernel
	optdepends = linux-ck-headers: for ck kernel
	optdepends = linux-xanmod-headers: for xanmod kernel
	optdepends = linux-rt-headers: for real-time kernel
	optdepends = linux-bfq-headers: for bfq scheduler kernel
	optdepends = linux-xanmod-rt-headers: for xanmod real-time kernel
	optdepends = clang: to build with clang compiler support
	optdepends = gcc: to build with gcc compiler support
	source = git+https://github.com/0x7375646F/Linuwu-Sense.git
	source = dkms.conf
	source = linuwu-sense.hook
	source = linuwu-sense-setup.sh
	source = linuwu-sense-check.sh
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = linuwu-sense-dkms
