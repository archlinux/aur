pkgname = amdgpu-exporter
	pkgdesc = AMD GPU metrics exporter for Prometheus
	depends = glibc
	depends = zlib
	depends = amdsmi
	depends = rocprofiler
	depends = hip-runtime-amd
	depends = rocm-gpu-agent
	depends = rocprofiler-client
