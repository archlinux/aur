pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.31
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.31-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.31-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.31-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.31-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.31-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.31-1-x86_64.pkg.tar.zst
	sha256sums = 5e33f7c7587b9da1831c5a10a816a71a0ea8f2be0da8b3b53a0ab2ec36d7851c
	sha256sums = 566e21683edadaee3963dc7f132e1400f514a1131e249e87f13bb95d745a29bb
	sha256sums = 1e72abbeee45aeebaaad09b7fb115e72434dfd5b1bca4121d0ffc011f6eab118

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.31-1-lts-bin
	depends = linux6.18.31-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.31-1-lts-headers-bin
	depends = linux6.18.31-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.31-1-lts-docs-bin
	depends = linux6.18.31-1-lts-docs-bin

pkgname = linux6.18.31-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.31-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.31-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.31-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.31-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.31-1-lts
	conflicts = linux-lts-docs
