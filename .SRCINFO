pkgbase = shelly
	pkgver = 3.1.1
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/Shelly-ALPM
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = git
	makedepends = pkgconf
	makedepends = gtk4
	makedepends = zig>=0.16
	makedepends = clang
	makedepends = gettext
	makedepends = flatpak
	makedepends = ripgrep
	makedepends = go-md2man
	source = shelly-3.1.1.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/archive/v3.1.1.tar.gz
	source = shellybuild.conf
	sha256sums = 70b3bb45f7f6a38ae01bf00c702282b9dbdf79330d2c84b21d9620ace452f4ea
	sha256sums = 0aff9177498bd94e90c937076d15ac76116c628ec3504a7c1b8c9ea086336ca6

pkgname = shelly
	pkgdesc = Shelly: A Modern Arch Package Manager
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = dconf
	depends = gnupg
	depends = zstd
	depends = json-glib
	optdepends = fish: Fish shell completions
	optdepends = zsh: Zsh shell completions
	optdepends = libstarfish: dependency viewer for arch packages
	optdepends = shelly-flatpak-backend: Flatpak package management support
	optdepends = fuse2: run AppImages that require FUSE 2
	provides = shelly
	conflicts = shelly-git
	conflicts = shelly-bin
	backup = etc/shellybuild.conf

pkgname = shelly-flatpak-backend
	pkgdesc = Optional native Flatpak backend for Shelly
	depends = shelly=3.1.1
	depends = flatpak
	provides = shelly-flatpak-backend=3.1.1
	conflicts = shelly-flatpak-backend-git
	conflicts = shelly-flatpak-backend-bin
