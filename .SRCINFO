pkgbase = rust-dos
	pkgdesc = x86 DOS emulator featuring 386 to Pentium CPUs, DPMI host, VGA/VSA/S3/Voodoo, SB16GUS/MT-32/GM, IDE, PnP, PCI, Win3x, Win95, NE200 with NAT, IPX over a relay, save states, rewnd, and WASM.
