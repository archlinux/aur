pkgbase = rokast
	pkgdesc = Mirror your Linux screen to a Roku TV over native Miracast, with nothing installed on the TV
	pkgver = 0.8.0
	pkgrel = 1
	url = https://github.com/papacasper/rokast
	arch = x86_64
	license = MIT
	makedepends = cargo
	depends = ffmpeg
	depends = iw
	depends = dhcpcd
	depends = wpa_supplicant
	depends = sudo
	depends = openssh
	depends = libnl
	depends = openssl
	depends = gtk4
	depends = glib2
	depends = libgcc
	depends = glibc
	depends = hicolor-icon-theme
	optdepends = xorg-xrandr: mirror one monitor on X11 instead of the whole X screen
	optdepends = libpulse: send audio (pactl finds the audio output to capture)
	optdepends = gstreamer: Wayland capture
	optdepends = gst-plugins-base: Wayland capture
	optdepends = gst-plugin-pipewire: Wayland capture
	optdepends = xdg-desktop-portal: Wayland capture
	options = !lto
	source = rokast-0.8.0.tar.gz::https://github.com/papacasper/rokast/archive/v0.8.0.tar.gz
	source = https://w1.fi/releases/wpa_supplicant-2.11.tar.gz
