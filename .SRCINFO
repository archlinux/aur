pkgbase = astra-airlock-bin
	pkgdesc = A beautiful m3expressive greetd frontend based on Caelestia (prebuilt binary)
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/AstraSuite/Airlock
	install = astra-airlock.install
	arch = x86_64
	license = GPL-3.0-only
	depends = glibc
	depends = greetd
	depends = libgcc
	depends = libstdc++
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-m3shapes-git
	optdepends = caelestia-cli: dynamic color scheme syncing with Caelestia
	optdepends = cage: kiosk compositor, if not using Hyprland
	optdepends = hyprland: kiosk compositor, if not using Cage
	optdepends = wlr-randr: the monitor flags
	provides = astra-airlock
	conflicts = astra-airlock
	conflicts = astra-airlock-git
	options = !strip
	options = !debug
	source = astra-airlock-v2.0.0::https://github.com/AstraSuite/Airlock/releases/download/v2.0.0/astra-airlock-v2.0.0
	source = LICENSE-2.0.0::https://raw.githubusercontent.com/AstraSuite/Airlock/v2.0.0/LICENSE
	sha256sums = 076a0fff70fec34c5ade30e5194a1e3ec06580050f19bd526856ae41bbd0b919
	sha256sums = 3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986

