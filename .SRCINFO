pkgbase = waywallen-display
	pkgver = 0.4.3
	pkgrel = 1
	url = https://github.com/waywallen/waywallen-display
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = vulkan-headers
	makedepends = vulkan-icd-loader
	makedepends = libglvnd
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = glib2
	makedepends = gobject-introspection
	makedepends = gtk4
	makedepends = cargo
	makedepends = glslang
	depends = libgcc
	depends = libstdc++
	depends = glibc
	options = !lto
	source = waywallen-display-0.4.3.tar.gz::https://github.com/waywallen/waywallen-display/archive/refs/tags/v0.4.3.tar.gz
	source = 0001-cmake-Install-kde-wallpaper-to-correct-path.patch
	source = 0002-cmake-Install-gnome-extensions-separately.patch
	sha256sums = a8581e7d0c9b3410a5c9bdc195c0c9850f9c6e6744ac9715b525905112378d10
	sha256sums = d05552ecf884b63e8ecdb59814ba1706f699ae2a8cb0497e34bb90759d3f91a4
