pkgbase = tde-session
	pkgdesc = The TDE desktop session: a wlroots compositor, overview, bar, lock screen and settings
	pkgver = 0.3.7
	pkgrel = 1
	url = https://github.com/zskamljic/tde-session
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = ninja
	makedepends = wayland-protocols
	makedepends = wlr-protocols
	depends = glibc
	depends = layer-shell-qt
	depends = libcanberra
	depends = libgcc
	depends = libinput
	depends = libpulse
	depends = libsecret
	depends = libstdc++
	depends = libtde>=0.3.0
	depends = libxkbcommon
	depends = lua
	depends = openssh
	depends = pam
	depends = pango
	depends = pixman
	depends = polkit-qt6
	depends = qt6-base
	depends = qt6-wayland
	depends = sound-theme-freedesktop
	depends = systemd
	depends = wayland
	depends = wlroots0.20
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gtk
	depends = xdg-desktop-portal-wlr
	optdepends = tde-ariadne: the file manager, which picks files for other programs too
	optdepends = xorg-xwayland: X11 programs
	optdepends = networkmanager: networks and Wi-Fi in the bar and the settings
	optdepends = bluez: Bluetooth in the bar and the settings
	optdepends = upower: the battery, and suspending sooner on it
	optdepends = power-profiles-daemon: the power mode
	optdepends = pipewire-pulse: sound, with its volume in the bar
	optdepends = gnome-keyring: remembering the passphrases of SSH keys
	optdepends = fprintd: unlocking the screen with a finger
	optdepends = brightnessctl: the keyboard light keys, where the keyboard does not change it itself
