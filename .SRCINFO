pkgbase = rime-llm-translator-git
	pkgdesc = 给Rime输入法接入大模型进行拼音联想，支持TUI图形化配置
	pkgver = r72.accb8ec
	pkgrel = 1
	url = https://github.com/SHORiN-KiWATA/rime-llm-translator
	install = rime-llm-translator-git.install
	arch = any
	license = AGPL3
	makedepends = git
	depends = python
	depends = fcitx5-rime
	depends = curl
	optdepends = litemiyu-bin: 用 miyu: 前缀在输入法里直接跟 LiteMiyu 对话，并导入它配好的供应商
	optdepends = miyu: 用 miyu: 前缀在输入法里直接跟 Miyu 对话（2026 年起的新版，不支持 0.7.x）
	optdepends = libnotify: 跟 LiteMiyu / Miyu 的长问答转后台后用桌面通知送达答案
	provides = rime-llm-translator
	conflicts = rime-llm-translator
	source = git+https://github.com/SHORiN-KiWATA/rime-llm-translator.git
	sha256sums = SKIP

pkgname = rime-llm-translator-git
