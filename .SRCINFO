	optdepends = gvfs: the Recycle Bin and the drive and phone list
	optdepends = gvfs-smb: SMB shares
	optdepends = gvfs-mtp: phones
	optdepends = xdg-utils: making OpenXplorer the default file manager
	optdepends = xdg-desktop-portal-gtk: Share on GNOME (its Email portal)
	optdepends = gnome-keyring: remembering SMB passwords
	optdepends = file-roller: Open in archive manager
