pkgbase = gulchce-bin
	pkgdesc = OpenCE fork with experimental features such as Halo MCC custom maps (needs your own Xbox disc image)
	pkgver = 105
	pkgrel = 1
	url = https://github.com/chestahh/GulchCE
	install = gulchce-bin.install
	arch = x86_64
	license = CC0-1.0
	license = Apache-2.0
	license = BSD-3-Clause
	license = BSD-4-Clause
	license = ISC
	license = MIT
	license = OFL-1.1
	license = Zlib
	depends = lib32-glibc
	depends = lib32-gcc-libs
	depends = lib32-libx11
	depends = lib32-libxext
	depends = lib32-mesa
	depends = hicolor-icon-theme
	optdepends = lib32-nvidia-utils: graphics on NVIDIA cards
	optdepends = lib32-pipewire: sound through PipeWire (one of the sound libraries is needed for sound)
	optdepends = lib32-libpulse: sound through PulseAudio
	optdepends = lib32-alsa-lib: sound through ALSA
	optdepends = lib32-wayland: a native Wayland window instead of XWayland (with lib32-libxkbcommon)
	optdepends = lib32-libxkbcommon: a native Wayland window instead of XWayland (with lib32-wayland)
	optdepends = lib32-libdecor: window borders on GNOME under Wayland
	optdepends = zenity: the disc image picker at the first start, where there is no desktop portal
	optdepends = xdg-utils: invite links that open the game
	provides = gulchce
	conflicts = gulchce
	options = !strip
	options = !debug
	source = halo-linux-release-105.zip::https://github.com/chestahh/GulchCE/releases/download/build-105/halo-linux-release.zip
	source = LICENSE-105.md::https://raw.githubusercontent.com/chestahh/GulchCE/c1d20723ce47b719bcdb355c6e47cb894722f324/LICENSE.md
	source = LINUX-105.md::https://raw.githubusercontent.com/chestahh/GulchCE/c1d20723ce47b719bcdb355c6e47cb894722f324/port/linux/README.md
	source = MCC-105.md::https://raw.githubusercontent.com/chestahh/GulchCE/c1d20723ce47b719bcdb355c6e47cb894722f324/docs/mcc_maps.md
