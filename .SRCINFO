pkgbase = aura-emerge
	pkgdesc = Portage-like wrapper for Arch Linux using Aura
	pkgver = 1.28.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = aura
	optdepends = devtools: for --abs support (build from ABS source via pkgctl)
	optdepends = gnupg: for PGP verification when building from ABS
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v1.28.0
	sha256sums = 993450cd67878182bbde4a023107635c6c5a747e2ccb5926f17c517825fd7029

pkgname = aura-emerge
