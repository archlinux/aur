pkgbase = socalabs-wavetable
	pkgver = 1.0.21
	pkgrel = 3
	url = https://socalabs.com/synths/wavetable/
	arch = x86_64
	groups = pro-audio
	license = BSD-3-Clause
	makedepends = xdg-user-dirs
	makedepends = unzip
	depends = freetype2
	depends = glibc
	depends = gcc-libs
	source = socalabs-wavetable-1.0.21.zip::https://socalabs.com/files/get.php?id=Wavetable_Linux.zip
	source = LICENSE-socalabs-wavetable::https://raw.githubusercontent.com/FigBug/Wavetable/1.0.21/LICENSE
