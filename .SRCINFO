pkgbase = luanti-modern
	pkgdesc = Luanti (formerly “Minetest”) as split-package build for server and client and common data and documentation, using a more modern and strict approach and explicitly trying to only use the new name only.
	pkgver = 5.10.0
	pkgrel = 1
	url = https://luanti.org/
	arch = x86_64
	license = LGPL
	makedepends = cmake
	makedepends = curl
	makedepends = freetype2
	makedepends = git
	makedepends = hicolor-icon-theme
	makedepends = hiredis
	makedepends = leveldb
	makedepends = libgl
	makedepends = libjpeg-turbo
	makedepends = libvorbis
	makedepends = libxi
	makedepends = luajit
	makedepends = ninja
	makedepends = openal
	makedepends = postgresql
	makedepends = spatialindex
	makedepends = sqlite
	source = https://github.com/minetest/minetest/archive/refs/tags/5.10.0.tar.gz
	source = tmpfiles.d
	source = sysusers.d
	source = luanti.service
	sha256sums = 2a3161c04e7389608006f01280eda30507f8bacfa1d6b64c2af1b820a62d2677
	sha256sums = c9a0c78a49461f56381e5615045d036cd594b741c910129eccf43e475c40cca1
	sha256sums = 542811f61dd5798daffb94bda28620a34bde3d4a71b32f72ac596cb6386e2650
	sha256sums = 7293c667abeab61ba535dff9c83713d43fc81738adb6541f8848161b100a4db2

pkgname = luanti-client
	pkgdesc = Luanti voxel game engine client
	depends = curl
	depends = desktop-file-utils
	depends = freetype2
	depends = hicolor-icon-theme
	depends = jsoncpp
	depends = libgl
	depends = libjpeg-turbo
	depends = libvorbis
	depends = libxi
	depends = luajit
	depends = luanti-common
	depends = openal
	depends = postgresql-libs
	depends = spatialindex
	depends = sqlite
	depends = xdg-utils
	provides = minetest
	conflicts = minetest

pkgname = luanti-server
	pkgdesc = Server for the Luanti voxel game engine
	depends = curl
	depends = hiredis
	depends = jsoncpp
	depends = leveldb
	depends = luajit
	depends = luanti-common
	depends = postgresql-libs
	depends = spatialindex
	depends = sqlite
	provides = minetest-server
	conflicts = minetest-server

pkgname = luanti-common
	pkgdesc = Common files for the Luanti client and server
	license = custom
	provides = minetest-common
	conflicts = minetest-common

pkgname = luanti-documentation
	pkgdesc = (Mostly) Markdown documentation for the Luanti voxel game engine, including client and server manpages
	license = custom
	depends = luanti-common
