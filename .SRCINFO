pkgbase = openchatbox
	pkgdesc = Desktop GUI for sending customized OSC chat messages to VRChat
	pkgver = 0.0.7
	pkgrel = 1
	url = https://github.com/ZorudaRinku/OpenChatbox
	arch = any
	license = MIT
	makedepends = python-pip
	makedepends = qt6-base
	makedepends = imagemagick
	depends = python
	depends = pyside6
	depends = python-psutil
	depends = python-websockets
	depends = hicolor-icon-theme
	optdepends = playerctl: <song>, <artist>, <nowplaying>, <song_progress> tokens
	optdepends = xdotool: <window> token on X11
	optdepends = kdotool: <window> token on KDE Wayland
	optdepends = wmctrl: <wm> token
	optdepends = wireless_tools: <network> token fallback (when NetworkManager is not in use)
	optdepends = libpulse: <volume> token (provides pactl; works against PulseAudio or PipeWire)
	source = openchatbox-0.0.7.tar.gz::https://github.com/ZorudaRinku/OpenChatbox/archive/v0.0.7.tar.gz
	sha256sums = 7193287daf1882551dab40b61f14070496318fb9c97f0d0ecd78ce9a5900a88b

pkgname = openchatbox
