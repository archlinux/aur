pkgbase = printbar-bin
	pkgdesc = Generic printer monitor for Waybar (IPP + SNMP + CUPS) — supplies, trays, jobs, panel text; instant push on print; Omarchy theming (prebuilt binary)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/mryll/printbar
	arch = x86_64
	license = MIT
	depends = gcc-libs
	optdepends = cups: CUPS source, queue action and the instant-push service
	optdepends = libnotify: desktop notifications
	optdepends = xdg-utils: open the EWS / queue on click
	provides = printbar
	conflicts = printbar
	options = !debug
	source = printbar-0.1.0::https://github.com/mryll/printbar/releases/download/v0.1.0/printbar-0.1.0-x86_64-linux
	source = printbar-watch-0.1.0::https://raw.githubusercontent.com/mryll/printbar/v0.1.0/printbar-watch
	source = printbar-watch.service-0.1.0::https://raw.githubusercontent.com/mryll/printbar/v0.1.0/printbar-watch.service
	source = config.example.toml-0.1.0::https://raw.githubusercontent.com/mryll/printbar/v0.1.0/config.example.toml
	source = LICENSE-0.1.0::https://raw.githubusercontent.com/mryll/printbar/v0.1.0/LICENSE
