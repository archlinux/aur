pkgbase = spotifast-git
	pkgdesc = Native Spotify client
	pkgver = 0.14.0
	pkgrel = 1
	url = https://github.com/crmne/spotifast
	install = spotifast-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = clang
	depends = dbus
	depends = alsa-lib
	depends = libpipewire
	depends = libglvnd
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	optdepends = libxkbcommon-x11: keyboard handling in X11 sessions
	optdepends = pipewire-pulse: PipeWire as the PulseAudio server
	provides = spotifast=0.14.0
	conflicts = spotifast
	conflicts = spotifast-bin
	options = !debug
	options = !lto
	source = spotifast-git::git+https://github.com/crmne/spotifast.git
	sha256sums = SKIP

pkgname = spotifast-git
