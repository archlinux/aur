	provides = edge-extension-bitwarden
	conflicts = edge-extension-bitwarden
	conflicts = edge-extension-bitwarden-git

pkgname = firefox-extension-bitwarden-dist
	pkgdesc = Bitwarden browser extension for Firefox, LibreWolf, Floorp and Firefox Nightly (official dist build)
	install = firefox-extension-bitwarden-dist.install
	groups = firefox-addons
	optdepends = firefox: installed for the system Firefox
	optdepends = librewolf: installed for LibreWolf (needs unsigned add-ons allowed)
	optdepends = floorp: installed for Floorp
	optdepends = firefox-nightly: installed for Firefox Nightly (needs unsigned add-ons allowed)
	provides = firefox-extension-bitwarden
	provides = librewolf-extension-bitwarden
	provides = floorp-extension-bitwarden
	conflicts = firefox-extension-bitwarden
	conflicts = firefox-extension-bitwarden-git
	conflicts = librewolf-extension-bitwarden
	conflicts = librewolf-extension-bitwarden-git
	conflicts = librewolf-extension-bitwarden-dist
	conflicts = floorp-extension-bitwarden
	replaces = librewolf-extension-bitwarden-dist

pkgname = opera-extension-bitwarden-dist
	pkgdesc = Bitwarden browser extension for Opera (official dist build)
	install = opera-extension-bitwarden-dist.install
	optdepends = opera: the browser this extension is for
	provides = opera-extension-bitwarden
	conflicts = opera-extension-bitwarden
	conflicts = opera-extension-bitwarden-git
