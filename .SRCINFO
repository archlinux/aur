pkgbase = novabrowser-webkit-bin
	pkgdesc = Keyboard-driven browser on WebKitGTK 6.0, configured in TypeScript (prebuilt)
	pkgver = 0.1.6
	pkgrel = 1
	url = https://github.com/Novaturiente/novabrowser-webkit
	arch = x86_64
	license = GPL-3.0-or-later
	depends = libwebkitgtk-6.0.so
	depends = gtk4
	depends = glib2
	depends = sqlite
	depends = curl
	depends = gst-plugins-base
	depends = gst-plugins-good
	optdepends = webkitgtk-6.0-nova-bin: our WebKitGTK build (Chromium-like dark mode, PGO, AVX2 CPUs)
	optdepends = gst-libav: H.264/AAC and most web video
	optdepends = gst-plugins-bad: more codecs (AV1, HLS)
	optdepends = gst-plugin-va: hardware video decoding
	optdepends = aria2: faster downloads (8 connections), resume after restart, magnet links and torrents
	optdepends = rbw: Bitwarden passwords
	optdepends = pass: password-store passwords
	optdepends = bitwarden-cli: Bitwarden passwords (bw)
	optdepends = xdg-utils: download-open and default-browser setup
	provides = novabrowser-webkit
	conflicts = novabrowser-webkit
	conflicts = novabrowser-webkit-git
	options = !strip
	options = !debug
	source = novabrowser-webkit-0.1.6-x86_64.tar.zst::https://github.com/Novaturiente/novabrowser-webkit/releases/download/v0.1.6/novabrowser-webkit-0.1.6-x86_64.tar.zst
