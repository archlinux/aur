pkgbase = linux-pf
	pkgdesc = pf-kernel
	pkgver = 7.2.pf3
	pkgrel = 1
	url = https://pfkernel.natalenko.name
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = binutils
	makedepends = cpio
