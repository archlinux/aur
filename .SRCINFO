pkgbase = toneshifteq
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/brummer10/ToneShiftEQ
	arch = aarch64
	arch = x86_64
	groups = pro-audio
	license = BSD-3-Clause
	checkdepends = lv2lint
	makedepends = cairo
	makedepends = fftw
	makedepends = freetype2
	makedepends = jack
	makedepends = libsndfile
	makedepends = lv2
	makedepends = xxd
	source = https://github.com/brummer10/ToneShiftEQ/releases/download/v1.0.0/ToneShiftEQ-v1.0.0-src.tar.xz
	sha256sums = f58d0323fabcd22829676a6b75c09a239efcbc780770d1b3f565c5af71f203bc

pkgname = toneshifteq
	arch = any
	depends = toneshifteq-clap
	depends = toneshifteq-lv2
	depends = toneshifteq-standalone
	depends = toneshifteq-vst3

pkgname = toneshifteq-clap
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – CLAP
	groups = pro-audio
	groups = clap-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = clap-host: for loading the CLAP plugin

pkgname = toneshifteq-lv2
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – LV2
	groups = pro-audio
	groups = lv2-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libstdc++
	depends = libx11
	optdepends = lv2-host: for loading the LV2 plugin

pkgname = toneshifteq-standalone
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – JACK standalone
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libjack.so
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11

pkgname = toneshifteq-vst3
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – VST3
	groups = pro-audio
	groups = vst3-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = vst3-host: for loading the VST3 plugin
