pkgbase = file-manager-bin
	pkgdesc = Linux desktop file manager written in Rust and Iced
	pkgver = 0.1.10
	pkgrel = 1
	url = https://github.com/nsjsv/File_Manager
	arch = x86_64
	license = GPL-3.0-or-later
	depends = acl
	depends = alsa-lib
	depends = dav1d
	depends = fontconfig
	depends = glib2
	depends = libnotify
	depends = libxkbcommon
	depends = wayland
	depends = wl-clipboard
	depends = xdg-utils
	optdepends = 7zip: 7z and rar preview and extraction, plus 7z creation
	optdepends = ffmpeg: video preview and metadata support
	optdepends = ffmpegthumbnailer: video thumbnail generation
	optdepends = gvfs: SFTP and WebDAV network locations
	optdepends = gvfs-afc: Apple/AFC portable device support
	optdepends = gvfs-gphoto2: digital camera/GPhoto support
	optdepends = gvfs-mtp: Android and media-player MTP support
	optdepends = gvfs-smb: SMB network locations
	optdepends = libreoffice: Office document preview (provided by libreoffice-fresh or libreoffice-still)
	optdepends = libsecret: saved network passwords
	optdepends = poppler: PDF and Office document preview
	optdepends = udisks2: storage device discovery and management
