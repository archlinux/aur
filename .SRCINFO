	makedepends = mingw-w64-vulkan-icd-loader
	makedepends = qt6-shadertools
	makedepends = ninja
	depends = mingw-w64-qt6-base-static
	optdepends = qt6-shadertools: development tools
	options = !strip
	options = !buildflags
	options = staticlibs
	options = !emptydirs
