pkgbase = libfronius
	pkgver = 1.0.7
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.7::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.7
	sha256sums = 0c905959ac80932b756d69bb3efa99b4c53fc584721eb4ca4ffb18bd3a558455

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
