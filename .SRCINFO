	depends = linux6.11.8.zen1-2-zen-docs-bin

pkgname = linux6.11.8.zen1-2-zen-bin
	pkgdesc = The Linux ZEN kernel and modules, version 6.11.8-zen1-2-zen
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = UKSMD-BUILTIN
	provides = VHBA-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-zen

pkgname = linux6.11.8.zen1-2-zen-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux ZEN kernel 6.11.8-zen1-2-zen
	depends = pahole
	conflicts = linux-zen-headers

pkgname = linux6.11.8.zen1-2-zen-docs-bin
	pkgdesc = Documentation for the Linux ZEN kernel 6.11.8-zen1-2-zen
	conflicts = linux-zen-docs
