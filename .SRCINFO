pkgname = linux-bore
	pkgdesc = The Linux kernel and modules - With BORE (Burst-Oriented Response Enhancer) CPU Scheduler by Masahito Suzuki
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = wireless-regdb: to set the correct wireless channels of your country
