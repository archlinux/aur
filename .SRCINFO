pkgbase = foldav-git
	pkgdesc = A file manager for the files in your Nextcloud
	pkgver = 0.0.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/AperteDev/foldav
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = blueprint-compiler
	makedepends = gettext
	depends = gtk4
	depends = libadwaita>=1:1.8
	depends = libsecret
	depends = sqlite
	depends = glib2
	depends = libgcc
	depends = glibc
	optdepends = gnome-online-accounts: sign in with a GNOME Online Accounts account
	optdepends = org.freedesktop.secrets: keep the passwords in the system keyring
	provides = foldav
	conflicts = foldav
	options = !lto
	source = foldav::git+https://github.com/AperteDev/foldav.git
	sha256sums = SKIP

pkgname = foldav-git
