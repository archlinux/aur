pkgbase = tuxtalk
	pkgdesc = Voice dictation for Linux: hold a key, talk, and your words are typed for you
	pkgver = 0.23.0
	pkgrel = 1
	url = https://tuxtalk.app/
	install = tuxtalk.install
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-poetry-core
	depends = python
	depends = python-gobject
	depends = python-cairo
	depends = python-dbus
	depends = python-evdev
	depends = gtk3
	depends = libayatana-appindicator
	depends = hicolor-icon-theme
	depends = polkit
	depends = wl-clipboard
	depends = python-numpy
	depends = python-toml
	depends = python-faster-whisper
	depends = python-ctranslate2
	depends = python-onnx-asr
	depends = python-onnxruntime
	depends = python-sounddevice
	depends = python-text2num
	depends = python-huggingface-hub
	depends = python-av
	depends = python-tqdm
	optdepends = pipewire-pulse: turn other sound down and set the mic volume, on PipeWire (pactl, paplay)
	optdepends = pulseaudio: turn other sound down and set the mic volume, on PulseAudio (pactl, paplay)
	optdepends = vulkan-icd-loader: run speech models on the graphics card (Vulkan)
