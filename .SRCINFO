pkgbase = bromigos-lab
	pkgdesc = Standalone homelab console, adapters, model catalog and reviewed provisioning
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/bromigos-org/bromigOS
	arch = any
	license = MIT OR Apache-2.0
	checkdepends = python-textual
	checkdepends = python-cairo
	checkdepends = python-gobject
	checkdepends = pango
	checkdepends = python-psutil
	makedepends = python
	makedepends = gnupg
	depends = python
	depends = python-textual
	optdepends = gnupg: verify signed model catalog updates
	optdepends = ansible-core: apply a reviewed lab provision plan
	optdepends = libvirt-python: manage VMs on a local libvirt host
	optdepends = qemu-base: run local KVM guests and manage their disks
	optdepends = cloud-image-utils: make cloud-init seeds for local KVM guests
	optdepends = helm: provision an existing Kubernetes cluster
	optdepends = sops: encrypt generated lab credentials without Vault
	optdepends = age: recipients for encrypted lab credentials
	optdepends = openssh: provision a Linux box over SSH
	optdepends = bromigos-homelab: desktop panels, live decks and VECTOR plugins
	optdepends = bromigos-core: desktop target commands, art jobs and Den TV media tools
	optdepends = kubectl: the kubernetes source (read-only kubeconfig)
	optdepends = github-cli: the github source (CI, PRs)
	optdepends = vault: @vault: references in homelab.toml
	optdepends = python-numpy: VECTOR Gnosis memory mirror
	optdepends = python-huggingface-hub: bromigos lab models refresh --hf (newer models on Hugging Face)
	optdepends = python-boto3: s3 sources: bucket sizes (with a read-only key)
	optdepends = poppler: the ocr job kind: PDF pages
	options = !debug
	source = bromigos-lab-bromigos-lab-v0.1.0.tar.gz::https://github.com/bromigos-org/bromigOS/archive/refs/tags/bromigos-lab-v0.1.0.tar.gz
