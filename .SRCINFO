	sha256sums_x86_64 = b1ac7fb07f033eaa3cf1dfd310097c0777cc31f5ae8cfb5d6d8a02fc3a21ddf2
	source_aarch64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.3/gitcomet-v0.3.3-linux-arm64.tar.gz
	sha256sums_aarch64 = b95a9e75ae4be751bc09ba398c60937c49f3777a36365241cd086b7a47b74b33

