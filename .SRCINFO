pkgbase = faro
	pkgdesc = Terminal client for Signal, built for people who live in tmux
	pkgver = 0.1.2
	pkgrel = 1
	url = https://getfaro.dev
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	license = MIT
	makedepends = cargo
	makedepends = protobuf
	makedepends = cmake
