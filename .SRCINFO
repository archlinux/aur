pkgbase = capri-desktop-bin
	pkgdesc = Unofficial Capri desktop companion: she sits on your windows, chats and does things for you (upstream binary)
	pkgver = 0.8.7
	pkgrel = 1
	url = https://github.com/lachydotmcg/capri-desktop
	arch = x86_64
	license = PolyForm-Noncommercial-1.0.0
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = icu
	depends = openssl
	depends = krb5
	depends = fontconfig
	depends = libx11
	depends = libice
	depends = libsm
	depends = libxcursor
	depends = libxext
	depends = libxfixes
	depends = libxi
	depends = libxrandr
	depends = hicolor-icon-theme
	optdepends = ollama: her brain on this computer
	optdepends = wmctrl: switch and close windows on X11
	optdepends = xdotool: minimise windows and close tabs on X11
	optdepends = xorg-xprop: see the active window on X11
	optdepends = libpulse: set the volume
	optdepends = xclip: copy to the clipboard on X11
	optdepends = wl-clipboard: copy to the clipboard on Wayland
	optdepends = spectacle: screenshots on KDE Plasma
	optdepends = gnome-screenshot: screenshots on GNOME
	optdepends = grim: screenshots on other Wayland desktops
	optdepends = scrot: screenshots on X11
	provides = capri-desktop
	conflicts = capri-desktop
	options = !strip
	options = !debug
