	sha256sums_x86_64 = c565491778f404cd966a0f48722b7f5a75c75e1f23a48af7ef3dcb50839991bd
	source_aarch64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.1/gitcomet-v0.3.1-linux-arm64.tar.gz
	sha256sums_aarch64 = a985988bb64e6b75e84ca9c776b5e2b5a78a0637c98584a05558bb9667b40cac

