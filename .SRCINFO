pkgbase = aura-emerge
	pkgdesc = A standalone Gentoo-style emerge for Arch Linux - installs from official repos, the AUR, and ABS, scans PKGBUILDs for supply-chain red flags before building, and runs untrusted build steps inside a bwrap sandbox.
	pkgver = 2.6.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0-only
	makedepends = rust
	makedepends = cargo
	depends = git
	depends = sudo
	optdepends = devtools: for --abs support (pkgctl repo clone)
	optdepends = gnupg: for PGP verification when building from ABS
	optdepends = bubblewrap: sandboxed builds (falls back to unsandboxed with --no-sandbox)
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	conflicts = aura-emerge-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v2.6.0
	sha256sums = bafe7ed5d8c81fee1225d7ff851986807b136fdf9aa28fa94b6aea80d0be6bee

pkgname = aura-emerge
