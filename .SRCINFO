pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.10.3.arch1
	pkgrel = 2
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.10.3.arch1-2-x86_64.pkg.tar.zst
	noextract = linux-headers-6.10.3.arch1-2-x86_64.pkg.tar.zst
