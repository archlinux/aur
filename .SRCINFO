pkgbase = mcommander-bin
	pkgdesc = Twin-panel text-mode file manager with loadable panel plugins (binary release)
	pkgver = 6.1.0
	pkgrel = 1
	url = https://github.com/blue-panels/mcommander
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = glib2
	depends = slang
	depends = gpm
	depends = e2fsprogs
	depends = file
	optdepends = libssh2: SFTP panel
	optdepends = curl: S3 and FTP panels
	optdepends = smbclient: Samba panel
	optdepends = libarchive: archive panel
	optdepends = mongo-c-driver: MongoDB panel
	optdepends = sqlite: SQLite panel
	optdepends = lua: Lua runtime (pictures, markdown and PDF in the viewer)
	optdepends = git: the Git panel
	optdepends = docker: the Docker panel
	optdepends = kubectl: the Kubernetes panel
	optdepends = openssh: shell links where libssh2 cannot serve the host
	optdepends = chafa: pictures in the terminal
	optdepends = poppler: text and pages of a PDF
	optdepends = groff: man pages and nroff text in the viewer
	optdepends = man-db: man pages in the viewer
	optdepends = python: three of the extfs helpers
	optdepends = libx11: keyboard modifiers under X
	optdepends = aspell: spell checking in the editor
	optdepends = hunspell: spell checking in the editor
	optdepends = ctags: the tag index the editor reads
	provides = mcommander
	provides = mcommander-plugins
	provides = mcommander-lua
	provides = mc6
	conflicts = mcommander
	conflicts = mcommander-plugins
	conflicts = mcommander-lua
	conflicts = mc6
	noextract = mcommander-6.1.0-1-x86_64.pkg.tar.zst
	noextract = mcommander-plugins-6.1.0-1-x86_64.pkg.tar.zst
	noextract = mcommander-lua-6.1.0-1-x86_64.pkg.tar.zst
	noextract = mcommander_6.1.0-1.debian13.1_arm64.deb
	noextract = mcommander-plugins_6.1.0-1.debian13.1_arm64.deb
	noextract = mcommander-lua_6.1.0-1.debian13.1_arm64.deb
	options = !strip
	options = !debug
	backup = etc/mcommander/ctags.keymap
	backup = etc/mcommander/edit.indent.rc
	backup = etc/mcommander/extensions.ini
	backup = etc/mcommander/filehighlight.ini
	backup = etc/mcommander/keymap.default.ini
	backup = etc/mcommander/keymap.emacs.ini
	backup = etc/mcommander/keymap.ini
	backup = etc/mcommander/keymap.vim.ini
	backup = etc/mcommander/mcedit.menu
	backup = etc/mcommander/panels.ftp.ini
	backup = etc/mcommander/panels.git.ini
	backup = etc/mcommander/sfs.ini
	backup = etc/mcommander/spell.keymap
	source = COPYING-6.1.0::https://raw.githubusercontent.com/blue-panels/mcommander/v6.1.0/doc/COPYING
