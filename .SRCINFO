pkgbase = maly
	pkgdesc = Local terminal music player (daemon + TUI + CLI) with mpv backend, gapless playback and MPRIS2
	pkgver = 1.16.3
	pkgrel = 1
	url = https://github.com/kitasael-burakku/Malody-Mallow
