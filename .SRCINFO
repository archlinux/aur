	pkgdesc = LLVM runtime libraries, trimmed down trunk version
	depends = gcc-libs
	depends = zlib
	depends = libffi
	depends = libedit
	depends = ncurses
	depends = libxml2

pkgname = clang-minimal-git
	pkgdesc = C language family frontend for LLVM (trimmed down git version)
	depends = llvm-libs-minimal-git
	depends = clang-libs-minimal-git
	depends = gcc
	optdepends = openmp: OpenMP support in clang with -fopenmp
	optdepends = python: for scan-view, scan-build, git-clang-format, clang-rename and python bindings
	optdepends = llvm-minimal-git: referenced by some clang headers
	provides = compiler-rt
	provides = clang
	provides = clang-analyzer
	provides = clang-tools-extra
	conflicts = compiler-rt
	conflicts = clang

