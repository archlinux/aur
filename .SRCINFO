pkgbase = libfronius
	pkgver = 1.0.6
	pkgrel = 3
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.6::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.6
	sha256sums = 18a66d5609ef2af2d3e0ea5c320d5350ad80082b03091fb1634cb3f2bf60e77a

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
	options = staticlibs
