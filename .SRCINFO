pkgbase = asusctl
	pkgdesc = A control daemon, tools, and a collection of crates for interacting with ASUS ROG laptops
	pkgver = 5.0.10
	pkgrel = 0.3
	url = https://asus-linux.org
	arch = x86_64
	license = MPL-2.0
	makedepends = clang
	makedepends = cmake
	makedepends = fontconfig
	makedepends = git
	makedepends = hicolor-icon-theme
	makedepends = libayatana-appindicator
	makedepends = libusb
	makedepends = power-profiles-daemon
	makedepends = rust
	makedepends = systemd
	makedepends = npm
	makedepends = unzip
	makedepends = yarn
	source = git+https://gitlab.com/asus-linux/asusctl.git#tag=5.0.10
	b2sums = 2be7cd61489d223e511e71c8d62b4f68903a6efed98848491d7824cceb87e4cd3c90db015c1159020ec493aa088472572549126ac36349c475098ded0842fe88

pkgname = asusctl
	pkgdesc = A control daemon, CLI tools, and a collection of crates for interacting with ASUS ROG laptops
	install = asusctl.install
	depends = hicolor-icon-theme
	depends = libusb
	depends = power-profiles-daemon
	depends = systemd
	optdepends = acpi_call: fan control
	optdepends = supergfxctl: hybrid GPU control
	optdepends = asusctltray: tray profile switcher
	optdepends = rog-control-center: app to control asusctl
	optdepends = gnome-shell-extension-asusctl-gnome: GNOME-shell extensions

pkgname = rog-control-center
	pkgdesc = App to control asusctl
	depends = asusctl
	depends = fontconfig
	depends = glib2
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libayatana-appindicator

pkgname = gnome-shell-extension-asusctl-gnome
	pkgdesc = A gnome extension exposing some of the base features of asusd in a helpful and easy to use way
	install = gnome-shell-extension-asusctl-gnome.install
	arch = any
	depends = asusctl
	depends = dconf
	depends = gnome-shell
