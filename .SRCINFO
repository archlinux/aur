pkgbase = libpamac-full
	pkgdesc = Library for Pamac package manager based on libalpm - flatpak and snap support enabled
	pkgver = 12.0.0
	pkgrel = 1
	epoch = 1
	url = https://github.com/manjaro/libpamac
	install = pamac.install
	arch = i686
	arch = pentium4
	arch = x86_64
	arch = arm
	arch = armv6h
	arch = armv7h
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = vala
	makedepends = meson
	makedepends = gobject-introspection
	depends = libalpm.so=16
	depends = flatpak
	depends = snapd
	depends = snapd-glib
	depends = archlinux-appstream-data
	depends = appstream
	depends = polkit
	depends = libsoup3
	depends = git
	depends = json-glib
	depends = dbus-glib
	provides = libpamac
	conflicts = libpamac-aur
	conflicts = libpamac-flatpak
	conflicts = libpamac
	conflicts = libpamac-full-dev
	options = !emptydirs
	source = git+https://github.com/manjaro/libpamac.git#tag=12.0.0
	sha256sums = 051e1101ef03b3ff161d6f934f49dfdc46e6661f6dfeabcc01879e189ee9979d

pkgname = libpamac-full
	backup = etc/pamac.conf
