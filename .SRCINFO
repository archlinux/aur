pkgbase = vuurmuur
	pkgdesc = powerful front-end for iptables aimed at system-administrators who need a decent firewall, but dont have netfilter specific knowledge
	pkgver = 0.8.2
	pkgrel = 1
	url = http://www.vuurmuur.org
	install = vuurmuur.install
	arch = i686
	arch = x86_64
	arch = armv7h
	arch = aarch64
	license = GPL-2.0-or-later
	depends = libnetfilter_log
	depends = libnetfilter_conntrack
	depends = libmnl
	depends = iptables
	depends = ncurses
	optdepends = conntrack-tools: for connection tracking
	optdepends = iproute2: for traffic shapping
	optdepends = iptrafvol: for traffic volume logging
	backup = etc/vuurmuur/config.conf
	backup = etc/vuurmuur/modules.conf
	backup = etc/vuurmuur/vuurmuur_conf.conf
	backup = etc/vuurmuur/plugins/textdir.conf
	source = https://www.vuurmuur.org/releases/0.8.2/vuurmuur-0.8.2.tar.gz
	source = modules.conf
	source = vuurmuur.service
	source = vuurmuur.script
