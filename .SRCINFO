pkgbase = lamco-rdp-server
	pkgdesc = Native Wayland RDP server for GNOME, KDE, Sway, and Hyprland with H.264 encoding and VA-API acceleration
	pkgver = 1.4.5
	pkgrel = 1
	url = https://github.com/lamco-admin/lamco-rdp-server
	install = lamco-rdp-server.install
	arch = x86_64
	arch = aarch64
	license = BUSL-1.1
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = make
	makedepends = nasm
	makedepends = pkg-config
	depends = gcc-libs
	depends = glibc
	depends = dbus
	depends = pipewire
	depends = libpipewire
	depends = xdg-desktop-portal
	depends = libxkbcommon
	depends = pam
	depends = fuse3
	depends = libva
	optdepends = vulkan-icd-loader: GPU-accelerated GUI rendering via wgpu
	optdepends = xdg-desktop-portal-gnome: screen capture and remote input for GNOME
	optdepends = xdg-desktop-portal-kde: screen capture and remote input for KDE Plasma
	optdepends = xdg-desktop-portal-wlr: screen capture for Sway and wlroots compositors
	optdepends = xdg-desktop-portal-hyprland: screen capture for Hyprland
	optdepends = openh264: H.264 software encoding via EGFX (Cisco binary, BSD-2-Clause)
	options = !lto
	backup = etc/dbus-1/system.d/io.lamco.RdpServer.System.conf
	source = lamco-rdp-server-1.4.5.tar.xz::https://github.com/lamco-admin/lamco-rdp-server/releases/download/v1.4.5/lamco-rdp-server-1.4.5.tar.xz
