	arch = any
	license = 0BSD
	depends = pcsclite
	depends = ccid
	depends = opensc
	depends = nss
	depends = p11-kit
	depends = openssl
	depends = ca-certificates-utils
	options = !strip
	options = !debug
	source = certs.zip
