pkgbase = mingw-w64-qt6-base-static
	pkgdesc = A cross-platform application and UI framework (mingw-w64)
	pkgver = 6.9.2
	pkgrel = 1
	url = https://www.qt.io
	arch = any
	groups = mingw-w64-qt6
	license = GPL3
	license = LGPL3
	license = FDL
	license = custom
	makedepends = qt6-base
	makedepends = ninja
	makedepends = mingw-w64-cmake-static
	makedepends = mingw-w64-vulkan-headers
	makedepends = mingw-w64-vulkan-icd-loader
	makedepends = mingw-w64-pkg-config
	makedepends = mingw-w64-postgresql
	makedepends = mingw-w64-mariadb-connector-c
	depends = mingw-w64-crt
	depends = mingw-w64-cppwinrt
	depends = mingw-w64-zlib
	depends = mingw-w64-libjpeg-turbo
	depends = mingw-w64-sqlite
	depends = mingw-w64-libpng
	depends = mingw-w64-openssl
	depends = mingw-w64-dbus
	depends = mingw-w64-harfbuzz
	depends = mingw-w64-brotli
	depends = mingw-w64-pcre2
	depends = mingw-w64-zstd
	optdepends = qt6-base: development tools
	optdepends = mingw-w64-postgresql: PostgreSQL driver
	optdepends = mingw-w64-mariadb-connector-c: MariaDB driver
	options = !strip
	options = !buildflags
	options = staticlibs
	options = !emptydirs
	source = https://download.qt.io/official_releases/qt/6.9/6.9.2/submodules/qtbase-everywhere-src-6.9.2.tar.xz
	source = 0001-Use-CMake-s-default-import-library-suffix.patch
	source = 0002-Fix-finding-D-Bus.patch
	source = 0003-Fix-using-static-PCRE2-and-DBus-1.patch
	source = 0004-Fix-transitive-dependencies-of-static-libraries.patch
	source = 0005-Fix-libjpeg-workaround-for-conflict-with-rpcndr.h.patch
	source = 0006-Support-finding-static-MariaDB-client-library.patch
	source = 0007-Allow-overriding-CMAKE_FIND_LIBRARY_SUFFIXES-to-pref.patch
	source = 0008-Find-fontconfig-via-pkg-config-for-correct-handling-.patch
	source = 0009-Fix-dependency-of-xcb-image-on-xcb-util.patch
	source = 0010-Allow-using-properties-of-PkgConfig-targets-for-glib.patch
	source = 0011-Allow-using-properties-of-PkgConfig-targets-for-Wayl.patch
	source = 0012-Allow-overriding-preference-for-shared-libzstd-libra.patch
	source = 0013-Fix-errors-due-to-disabled-exceptions-with-cpp_winrt.patch
	source = 0014-Link-corelib-correctly-against-runtimeobject-when-co.patch
	source = 0015-Workaround-linker-error-about-missing-symbol-__sync_.patch
	source = 0016-Workaround-Unknown-CMake-command-_qt_test_emscripten.patch
	source = 0017-Fix-configuration-when-EMSCRIPTEN_ROOT-is-an-absolut.patch
	source = 0018-Allow-handling-Android-activity-lifecycle-by-user-pr.patch
	source = 0019-Avoid-compile-error-due-to-inconsistent-use-of-noexc.patch
	source = 0020-Allow-keeping-Android-app-in-background-with-QtQuick.patch
	source = 0021-Allow-resuming-native-app-when-Android-activity-is-r.patch
	source = 0022-Enable-minimal-and-offscreen-plugins-when-compiling-.patch
	source = 0023-Allow-configuring-use-of-OpenSSL-in-QPasswordDigesto.patch
	source = 0024-Drop-CMAKE_SYSTEM_VERSION-from-modules-json-if-Linux.patch
	source = 0025-Revert-Re-land-Android-destroy-the-window-surface-on.patch
