pkgbase = cryptpad
	pkgdesc = Realtime collaborative visual editor with zero knowledge server
	pkgver = 2026.10.1
	pkgrel = 2
	url = https://github.com/cryptpad/cryptpad
	install = cryptpad.install
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	makedepends = npm
	makedepends = git
	makedepends = unzip
	depends = glibc
	depends = nodejs
	optdepends = nginx: reverse proxy for HTTPS, configured in /etc/nginx/sites-available/cryptpad.conf
	optdepends = certbot: certificates from Let's Encrypt
	optdepends = certbot-nginx: certbot plugin to get and renew the certificates through nginx
	optdepends = cryptpad-sso: single sign-on with OpenID Connect or SAML
	conflicts = cryptpad-sso<1.0.0
	options = !strip
	options = !debug
	backup = etc/webapps/cryptpad/config.js
	backup = etc/webapps/cryptpad/infra.js
	backup = etc/webapps/cryptpad/customize/application_config.js
	backup = etc/nginx/sites-available/cryptpad.conf
	source = cryptpad-2026.10.1.tar.gz::https://github.com/cryptpad/cryptpad/archive/2026.10.1.tar.gz
	source = cryptpad.service
	source = cryptpad.sysusers
	source = cryptpad.tmpfiles
	source = migrate-infra.js
	source = build-pages
	source = cryptpad-build-pages.hook
