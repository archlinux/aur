pkgbase = lumen-kde-git
	pkgdesc = Windows 11 style desktop for KDE Plasma 6: widget style, window decoration, Mica and Acrylic, taskbar, Start, Quick Settings, File Explorer
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/dzcorp/kdewin
	install = lumen-kde.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	license = GPL-2.0-or-later
	license = LGPL-2.0-or-later
	makedepends = cargo
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = git
	makedepends = ninja
	makedepends = plasma-wayland-protocols
	makedepends = vulkan-headers
	depends = baloo
	depends = baloo-widgets
	depends = dolphin
	depends = kbd
	depends = kcmutils
	depends = kdecoration
	depends = kio
	depends = kirigami
	depends = kirigami-addons
	depends = knewstuff
	depends = kparts
	depends = kpipewire
	depends = kquickcharts
	depends = kstatusnotifieritem
	depends = kuserfeedback
	depends = kwin
	depends = kxmlgui
	depends = libksysguard
	depends = libplasma
	depends = patch
	depends = plasma-activities
	depends = plasma-activities-stats
	depends = plasma-desktop
	depends = plasma-workspace
	depends = qqc2-desktop-style
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = qt6-tools
	depends = inter-font
	depends = ttf-liberation
	optdepends = bluedevil: Bluetooth tile in Quick Settings
	optdepends = ttf-ms-win11-auto: Segoe UI, Segoe UI Variable, Segoe Fluent Icons and Consolas (needs a Windows licence)
	optdepends = ttf-selawik: open Segoe UI look-alike, preferred over Inter
	optdepends = kde-gtk-config: GTK apps follow light and dark
	optdepends = limine: boot menu theme (lumen boot on)
	optdepends = plasma-login-manager: Lumen login screen (lumen login on)
	optdepends = plasma-nm: Wi-Fi tile in Quick Settings
	optdepends = plasma-pa: volume tile in Quick Settings
	optdepends = plymouth: boot splash (lumen boot on)
	optdepends = powerdevil: brightness, battery and power profile tiles
