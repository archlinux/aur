pkgbase = pipedal-bin
	pkgdesc = IoT guitar effect pedal for Raspberry Pi, with phone-friendly web interface
	pkgver = 2.0.110
	pkgrel = 4
	url = https://rerdavies.github.io/pipedal/
	install = pipedal-bin.install
	arch = x86_64
	license = MIT
