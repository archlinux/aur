pkgbase = luciole-git
	pkgdesc = A smooth, native Wayland file manager with fast previews, tabs, split view and Miller columns
	pkgver = 0.1.0.r0.g000000000
	pkgrel = 4
	url = https://github.com/noctalia-dev/luciole
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = meson
	makedepends = ninja
	makedepends = nlohmann-json
	makedepends = pkgconf
	makedepends = stb
	makedepends = wayland-protocols
	depends = acl
	depends = adwaita-icon-theme
	depends = cairo
	depends = curl
	depends = dconf
	depends = fontconfig
	depends = freetype2
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gsettings-desktop-schemas
	depends = gvfs
	depends = harfbuzz
	depends = hicolor-icon-theme
	depends = libarchive
	depends = libgcc
	depends = libglvnd
	depends = libpng
	depends = librsvg
	depends = libstdc++
	depends = libxkbcommon
	depends = libxml2
	depends = pango
	depends = shared-mime-info
	depends = tomlplusplus
	depends = wayland
	depends = xz
	optdepends = ffmpeg: video and audio thumbnails and metadata
	optdepends = ffmpegthumbnailer: filmstrip edges on video thumbnails
	optdepends = poppler: PDF thumbnails and metadata
	optdepends = 7zip: encrypted 7z archives
	optdepends = gvfs-smb: SMB network locations
	optdepends = gvfs-dnssd: WebDAV and DNS-SD network discovery
	optdepends = glib-networking: secure WebDAV (TLS)
	optdepends = xdg-terminal-exec: automatic terminal selection
	optdepends = xdg-desktop-portal: use Luciole as the Open and Save file picker
