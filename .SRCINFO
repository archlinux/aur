pkgbase = volt-gui
	pkgdesc = A graphical user interface for configuring GPU related environment variables and more for Linux gaming.
	pkgver = 1.2.1
	pkgrel = 1
	url = https://github.com/pythonlover02/volt-gui
	install = volt-gui.install
	arch = any
