	pkgrel = 1
	url = https://github.com/adswill/OnAir
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = pkgconf
	makedepends = rust
	depends = ffmpeg
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = glfw
	depends = hackrf
	depends = hicolor-icon-theme
	depends = libusb
	depends = soapysdr
	optdepends = codec2: FreeDV and M17 speech (dlopened at run time, searched in /usr/lib)
	optdepends = mbelib: DMR/P25/NXDN/dPMR/D-STAR voice (dlopened at run time, searched in /usr/lib)
	optdepends = zenity: file dialogs
	optdepends = soapyrtlsdr: RTL-SDR support through SoapySDR
	optdepends = soapyairspy: Airspy support through SoapySDR
	optdepends = soapysdrplay: SDRplay support through SoapySDR
	optdepends = onair-dra: DRA/DRA+ audio decoder for CDR radio sound (dlopened at run time)
	optdepends = faad2: HE-AAC SBR/PS decoding for DAB/DAB+ (dlopened at run time)
	optdepends = libfdk-aac: xHE-AAC (USAC) decoding for DRM (dlopened at run time)
