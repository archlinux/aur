	optdepends = python-docling: docling document parser (Settings → Document Parsing)
	optdepends = python-pymupdf4llm: PyMuPDF4LLM document parser — lightest image-capable engine (Settings → Document Parsing)
	optdepends = manim: Math Animator addon — renders math animations to video
	optdepends = texlive-core: LaTeX renderer required by Manim
	optdepends = ffmpeg: video encoder required by Manim
	optdepends = cairo: 2D graphics library required by Manim
	optdepends = pkgconf: build tool required by Manim native deps
	optdepends = python-graphrag: GraphRAG knowledge-base engine (pulls LiteLLM + lancedb)
	optdepends = python-raganything: LightRAG knowledge-base engine with multimodal parsing
	optdepends = python-mcp: MCP client used by Partners
