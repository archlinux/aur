pkgbase = ppsspp-git
	pkgdesc = A PSP emulator written in C++
	pkgver = 1.20.4.r4907.1aebad2c65
	pkgrel = 1
	url = https://www.ppsspp.org/
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	makedepends = clang
	makedepends = cmake
	makedepends = git
	makedepends = glew
	makedepends = glu
	makedepends = libglvnd
	makedepends = libpng
	makedepends = libzip
	makedepends = ninja
	makedepends = openxr
	makedepends = python
	makedepends = sdl3
	makedepends = sdl3_ttf
	makedepends = snappy
	makedepends = zlib
	options = !lto
	source = git+https://github.com/hrydgard/ppsspp.git
	b2sums = SKIP

pkgname = ppsspp-git
	depends = glew
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libgl
	depends = libpng
	depends = libstdc++
	depends = libzip
	depends = openxr
	depends = ppsspp-assets-git
	depends = sdl2
	depends = sdl2_ttf
	depends = snappy
	depends = zlib
	depends = zstd
	provides = ppsspp
	conflicts = ppsspp

pkgname = ppsspp-assets-git
	provides = ppsspp-assets
	conflicts = ppsspp-assets
