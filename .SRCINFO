pkgbase = onair
	pkgdesc = SDR receiver for digital TV (DVB-T/T2, DVB-S/S2, ATSC), DAB+, FM, DRM, ADS-B, GNSS and DMR
	pkgver = 3.9.0
	pkgrel = 3
	url = https://github.com/adswill/OnAir
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cmake
	makedepends = pkgconf
	makedepends = rust
	depends = ffmpeg
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = glfw
	depends = hackrf
	depends = hicolor-icon-theme
	depends = libusb
	depends = soapysdr
	depends = openssl
	optdepends = codec2: FreeDV and M17 speech (dlopened at run time, searched in /usr/lib)
	optdepends = mbelib: DMR/P25/NXDN/dPMR/D-STAR voice (dlopened at run time, searched in /usr/lib)
	optdepends = zenity: file dialogs
	optdepends = soapyrtlsdr: RTL-SDR support through SoapySDR
	optdepends = soapyairspy: Airspy support through SoapySDR
	optdepends = soapysdrplay: SDRplay support through SoapySDR
	optdepends = onair-dra: DRA/DRA+ audio decoder for CDR radio sound (dlopened at run time)
	optdepends = onair-avsplus: AVS+ (Guangdian) video for Chinese DTMB TV, decoded natively (dlopened at run time)
	optdepends = faad2: HE-AAC SBR/PS decoding for DAB/DAB+ (dlopened at run time)
	optdepends = libfdk-aac: xHE-AAC (USAC) decoding for DRM (dlopened at run time)
	optdepends = wireshark-qt: View > Wireshark output (pcapng files and the onair-extcap live capture)
	optdepends = wireshark-cli: tshark, the same Wireshark output without the GUI
	optdepends = alsa-lib: ALSA audio output (dlopened at run time)
	optdepends = libpulse: PulseAudio audio output (dlopened at run time)
	optdepends = jack2: JACK audio output (dlopened at run time; pipewire-jack also provides it)
	optdepends = lame: MP3 recording (dlopened at run time)
	optdepends = vulkan-icd-loader: GPU-accelerated LDPC decoding (dlopened at run time)
	optdepends = rtl-sdr: native RTL-SDR driver (dlopened at run time)
	optdepends = airspy: native Airspy driver (dlopened at run time)
	optdepends = bladerf: native bladeRF driver (dlopened at run time)
	optdepends = libiio: native IIO/PlutoSDR driver (dlopened at run time)
	optdepends = libuhd: native USRP/UHD driver (dlopened at run time)
	conflicts = onair-bin
	source = onair-3.9.0.tar.gz::https://github.com/adswill/OnAir/archive/refs/tags/v3.9.0.tar.gz
	sha256sums = ccda2df7a715cb0ecf2cb5eca7330336b5864503d9846d86bad458a698ffbba4

pkgname = onair
