pkgbase = immuarch-git
	pkgdesc = Immutable Archlinux setup with transactional & atomic updates
	pkgver = 0.1.1.r222.5fba346
	pkgrel = 1
	url = https://framagit.org/Brumaire/immuarch
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = util-linux
	depends = btrfs-progs
	depends = grub
	depends = bash
	depends = grep
	depends = sed
	depends = mkinitcpio
	optdepends = gzip: for immuarch-backup
	optdepends = openssh: for immuarch-backup
	optdepends = podman: import OCI images as immuarch root filesystem
	source = git+https://framagit.org/Brumaire/immuarch
	md5sums = SKIP

pkgname = immuarch-core-git
	install = immuarch.install
	depends = util-linux
	depends = btrfs-progs
	depends = grub
	depends = bash
	depends = grep
	depends = sed
	depends = mkinitcpio
	depends = immuarch-utils-git=0.1.1.r222.5fba346
	provides = immuarch-core
	replaces = immuarch-git
	options = emptydirs
	backup = immuarch/immuarch-etc/env.conf
	backup = immuarch/immuarch-etc/subvolumes.conf
	backup = immuarch/immuarch-etc/add-bind-mount-runtime.conf
	backup = immuarch/immuarch-etc/add-fstab.conf

pkgname = immuarch-utils-git
	provides = immuarch-utils
