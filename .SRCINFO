pkgbase = hypr-wallpaper-git
	pkgdesc = Per-monitor wallpaper manager and ratatui TUI for Hyprland (Rust)
	pkgver = 0.0.0
	pkgrel = 1
	url = https://github.com/jaehho/hypr-tools
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = rust
	makedepends = cargo
	depends = hyprland
	depends = sqlite
	depends = libnotify
	optdepends = awww: wayland wallpaper daemon backend
	optdepends = kitty: terminal for the TUI (any terminal works)
	provides = hypr-wallpaper
	conflicts = hypr-wallpaper
	options = !lto
	source = git+https://github.com/jaehho/hypr-tools.git
	sha256sums = SKIP

pkgname = hypr-wallpaper-git
