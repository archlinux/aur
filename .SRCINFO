pkgbase = azur-promilia-launcher
	pkgdesc = 蓝色星原：旅谣 Linux 启动器（dwproton + azur 补丁 + SDK 桥接登录）
	pkgver = 1.0.0
	pkgrel = 9
	url = https://github.com/puji4810/azur-sdk-qt
	install = azur-promilia-launcher.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = mingw-w64-gcc
	depends = python
	depends = python-pyqt6
	depends = dwproton-bin
	depends = dwproton-azur-patch
	optdepends = libnotify: 桌面通知（从图标启动失败时提示原因）
	optdepends = xdg-utils: --install 时打开官方下载页
	optdepends = lsof: X11 连接数预检
	options = !strip
	source = azur-sdk-qt::git+https://github.com/puji4810/azur-sdk-qt.git
	source = azur-promilia.sh
	source = azur-promilia.desktop
	source = azur-promilia-login.desktop
	source = azur-promilia.png
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = azur-promilia-launcher
