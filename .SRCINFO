pkgbase = quicklook-bin
	pkgdesc = Quick Look image, document and folder preview for KDE Plasma 6 with optional soft blur (prebuilt)
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/13Stokes31/quicklook
	install = quicklook.install
	arch = x86_64
	license = GPL-3.0-or-later
	license = GPL-2.0-or-later
	depends = glibc>=2.39
	depends = gcc-libs
	depends = qt6-base>=6.12
	depends = qt6-wayland
	depends = kwindowsystem
	depends = libglvnd
	optdepends = dolphin: file manager service menu and Space shortcut (26.04+)
	optdepends = qt6-webengine: optional PDF and Office preview module
	optdepends = libreoffice: optional ODT/DOC/DOCX/ODS/XLS/XLSX preview via PDF
	optdepends = kwin: window centering and blur (soft module requires 6.7.5)
	optdepends = qt6-declarative>=6.12: optional KWin soft blur module
	optdepends = libepoxy: optional KWin soft blur module
	optdepends = python: optional quicklook-dolphin-shortcut command
	provides = quicklook=1.0.1
	conflicts = quicklook
	options = !debug
	options = !strip
	source = https://github.com/13Stokes31/quicklook/releases/download/v1.0.1/quicklook-1.0.1-linux-x86_64.tar.gz
	sha256sums = 50c29e8665543e64c96669f46564d8d42d633eaf1fb7df674aa3a9dfe2271c9b

pkgname = quicklook-bin
