pkgbase = unsloth-desktop-bin
	pkgdesc = Unsloth Desktop - train and run open models locally (prebuilt)
	pkgver = 0.1.800.beta
	pkgrel = 1
	url = https://unsloth.ai/
	arch = x86_64
