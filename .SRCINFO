pkgbase = cfait-bin
	pkgdesc = Powerful, fast and elegant task / TODO manager. (GUI & TUI, CalDAV & local)
	pkgver = 1.0.5
	pkgrel = 1
	url = https://codeberg.org/trougnouf/cfait
	arch = x86_64
	license = GPL-3.0-or-later
	depends = gcc-libs
	depends = glibc
	depends = fontconfig
	depends = libxkbcommon
	depends = vulkan-icd-loader
	depends = org.freedesktop.secrets
	optdepends = vulkan-driver: Required by the GUI for hardware-accelerated rendering
	optdepends = wayland: Required by the GUI for Wayland session support
	optdepends = libx11: Required by the GUI for X11 session support
	optdepends = libxcursor: Required by the GUI for X11 cursor support
	optdepends = libxi: Required by the GUI for X11 input devices
	optdepends = libxrandr: Required by the GUI for X11 monitor layout support
	optdepends = xdg-desktop-portal: Required by the GUI for the file picker (export/import)
	provides = cfait
	provides = cfait-gui
	conflicts = cfait
	replaces = rustycal
	replaces = rustache
	replaces = fairouille
	options = !strip
	options = !emptydirs
	source = https://codeberg.org/trougnouf/cfait/releases/download/v1.0.5/cfait-linux-v1.0.5.tar.xz
	sha256sums = c24f38e3af9ee9d7beec09a215f3137a25d6d8d32bdf2aa901da90461fe4dfb0

pkgname = cfait-bin
