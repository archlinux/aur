pkgbase = webcam-blur
	pkgdesc = Background blur for any webcam, as virtual cameras usable in every app (tray toggle, GPU accelerated)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/JiPaix/webcam-blur
	install = webcam-blur.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	depends = python
	depends = python-numpy
	depends = python-onnx
	depends = python-onnxruntime
	depends = python-opencv
	depends = python-pyqt6
	depends = python-pyudev
	optdepends = python-onnxruntime-rocm: AMD GPU acceleration (MIGraphX)
	optdepends = python-onnxruntime-cuda: NVIDIA GPU acceleration
	optdepends = v4l2loopback-dkms: if your kernel does not ship the v4l2loopback module
