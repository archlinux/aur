	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libxkbcommon
	depends = noto-fonts-cjk
	depends = noto-fonts-emoji
	depends = pixman
	depends = python
	depends = ttf-jetbrains-mono-nerd
	depends = wayland
	depends = xdg-terminal-exec
	optdepends = fcitx5: Wayland text-input support
	optdepends = splinterm-mcp-bin: explicitly configured MCP stdio adapter
	provides = splinterm=0.1.0beta1-1
	conflicts = splinterm

pkgname = splinterm-mcp-bin
