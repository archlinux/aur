pkgbase = uzumaki
	pkgdesc = Native desktop client for Apple Music, GPU-rendered in Rust (needs a subscription)
	pkgver = 0.4.4
	pkgrel = 1
	url = https://getuzumaki.app
	arch = x86_64
	license = GPL-3.0-or-later
	license = GPL-3.0-only
	makedepends = cargo
	makedepends = npm
	makedepends = git
	makedepends = pkgconf
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = gcc-libs
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
