pkgbase = isabelle
	pkgdesc = A generic proof assistant. It allows mathematical formulas to be expressed in a formal language and provides tools for proving those formulas in a logical calculus.
	pkgver = 2026
	pkgrel = 1
	url = https://www.cl.cam.ac.uk/research/hvg/Isabelle/
	arch = x86_64
	arch = aarch64
	groups = science
	license = custom:BSD
	depends = fontconfig
	depends = libgomp
	depends = libx11
	depends = libxext
	depends = libxi
	depends = libxrender
	depends = libxtst
	optdepends = texlive-latexextra: document preparation
	optdepends = texlive-bibtexextra: document preparation
	optdepends = texlive-fontsextra: document preparation
	optdepends = texlive-fontutils: document preparation
	optdepends = texlive-mathscience: document preparation
	optdepends = perl: HTML presentation of BibTeX databases (bib2xhtml)
	optdepends = rlwrap: line editing in "isabelle console"
	optdepends = openssh: SSH connections and remote builds
	optdepends = gtk3: Isabelle/VSCode (bundled VSCodium)
	optdepends = nss: Isabelle/VSCode (bundled VSCodium)
	optdepends = alsa-lib: Isabelle/VSCode (bundled VSCodium)
	optdepends = libxkbfile: Isabelle/VSCode (bundled VSCodium)
	options = !strip
