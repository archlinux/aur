pkgbase = gpui-greeter
	pkgdesc = A greeter for greetd on X11, drawn with GPUI
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/crazyboycjr/gpui-greeter
	install = gpui-greeter.install
	arch = x86_64
	license = Apache-2.0
	license = OFL-1.1
	makedepends = cargo
	makedepends = fontconfig
	depends = bash
	depends = glibc
	depends = greetd
	depends = greetd-agreety
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = pam
	depends = systemd
	depends = vulkan-driver
	depends = vulkan-icd-loader
	depends = xorg-server
	depends = xorg-xinit
	optdepends = accountsservice: avatars, and the session LightDM last used, before the first login here
	optdepends = polkit: gpui-greeter settings asks for the password to apply what root keeps
	optdepends = xdg-desktop-portal: the file dialogs of gpui-greeter settings
	optdepends = noto-fonts-cjk: Chinese text
	optdepends = xorg-server-xvfb: gpui-greeter preview --shot, without a display
	optdepends = vulkan-swrast: drawing previews on the CPU (lavapipe)
	optdepends = xss-lock: gpui-greeter lock on suspend and when idle
	provides = greetd-greeter
	options = !lto
	options = !debug
	backup = etc/gpui-greeter/config.toml
	backup = etc/greetd/gpui-greeter.toml
	backup = etc/pam.d/gpui-greeter-lock
	source = gpui-greeter-1.0.0.tar.gz::https://github.com/crazyboycjr/gpui-greeter/archive/v1.0.0.tar.gz
	sha256sums = 4e0f92a0f2470e44b3cb88bea620479d8779d81eaacb25fd47c71b2597cc4d1b

pkgname = gpui-greeter
