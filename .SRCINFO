pkgbase = libfronius
	pkgver = 1.1.3
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.1.3::git+https://github.com/ahpohl/libfronius.git#tag=v1.1.3
	sha256sums = 5a05c30a3fab305bbaedb4fe45e38095ce67febb24e77c7e9b91a067df000877

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters and meters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
