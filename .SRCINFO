pkgbase = dod-pki-setup
	pkgdesc = One-click setup for DoD/DoW CAC/PKI on Arch Linux: Install drivers, certs, register PKCS#11 in browser. Works out of the box on most modern browsers.
	pkgver = 5.14
	pkgrel = 3
