	depends = gcc-libs
	depends = openssl
	depends = sqlite
	depends = pam
	depends = dbus
	depends = libcap
	depends = tpm2-tss
	depends = systemd-libs
	provides = kanidm-unixd-clients
	provides = kanidm-unixd-clients=1.10.4
	conflicts = kanidm-unixd-clients

pkgname = kanidm-server-bin
