pkgbase = sway-hidecursor-leftbar
	pkgdesc = Tiling Wayland compositor and replacement for the i3 window manager
	pkgver = 1.12
	pkgrel = 1
	url = https://swaywm.org/
	install = sway.install
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = meson
	makedepends = ninja
	makedepends = scdoc
	makedepends = wayland-protocols
