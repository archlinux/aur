pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.36
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.36-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.36-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.36-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.36-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.36-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.36-1-x86_64.pkg.tar.zst
	sha256sums = d831548f867125d50eec88242da5afceb6a87b21a37753ca493f2747cad562ed
	sha256sums = a89ab43d148cb10033643883248060a3967454799451e54a4890a30eab89239c
	sha256sums = 56d0a4d6d6d5eb4a30286004abd5ef02459fcd1e7f11583a2e04ac4252f60cd7

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.36-1-lts-bin
	depends = linux6.12.36-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.36-1-lts-headers-bin
	depends = linux6.12.36-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.36-1-lts-docs-bin
	depends = linux6.12.36-1-lts-docs-bin

pkgname = linux6.12.36-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.36-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.36-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.36-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.36-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.36-1-lts
	conflicts = linux-lts-docs
