pkgbase = mmsimpulse-git
	pkgdesc = A Wayland session of KWin plus the illogical-impulse shell — no desktop environment
	pkgver = r135.0d687e6
	pkgrel = 1
	url = https://github.com/mahirsn/mmsimpulse
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cmake
	makedepends = extra-cmake-modules
	depends = kwin
	depends = kglobalacceld
	depends = quickshell
	depends = xdg-desktop-portal-kde
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = rsync
	depends = git
	depends = jq
	depends = systemd
	depends = imagemagick
	depends = wl-clipboard
	depends = wl-clip-persist
	depends = libnotify
	depends = spectacle
	depends = qt6-websockets
	optdepends = powerdevil: idle timeouts, DPMS, suspend and brightness
	optdepends = upower: battery status
	optdepends = kdeplasma-addons: task switcher layouts, without which Alt+Tab draws nothing
	optdepends = kitty: the terminal the launcher and widgets open by default
	optdepends = cliphist: clipboard history
	optdepends = matugen: colours generated from the wallpaper
	optdepends = mpvpaper: video and gif wallpapers
	optdepends = linux-wallpaperengine: Wallpaper Engine scenes from the Steam workshop
	optdepends = ffmpeg: stills for video wallpapers, which is what their colours come from
	optdepends = brightnessctl: laptop backlight control
	optdepends = ddcutil: external monitor brightness over DDC/CI
	optdepends = playerctl: media keys and player control
	optdepends = tesseract: text recognition on a snipped region
	optdepends = wf-recorder: screen recording
	optdepends = gpu-screen-recorder: instant replay in the overlay, saved with Alt+F10
	optdepends = mangohud: the FPS limiter in the overlay
	optdepends = bc: arithmetic in the theming scripts
	optdepends = breeze: the default cursor theme, which KWin warns about when absent
	optdepends = illogical-impulse-basic: the widget set this shell is built on
	optdepends = illogical-impulse-audio: audio widgets and OSDs
	optdepends = illogical-impulse-backlight: brightness control
	optdepends = illogical-impulse-fonts-themes: Material Symbols and the shell fonts
	optdepends = illogical-impulse-portal: file pickers and screen sharing
	optdepends = illogical-impulse-python: colour generation for the theming scripts
	optdepends = illogical-impulse-screencapture: region screenshot and recording
	optdepends = ydotool: cursor warping, which KWin exposes no D-Bus call for
	optdepends = supergfxctl: the AMD/NVIDIA display switch in the bar, on ASUS laptops with a GPU MUX
	provides = mmsimpulse
	conflicts = mmsimpulse
	source = mmsimpulse-git::git+https://github.com/mahirsn/mmsimpulse.git
	sha256sums = SKIP

pkgname = mmsimpulse-git
