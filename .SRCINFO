pkgbase = jebstudios-workset
	pkgdesc = Multi-DE desktop workset profiles for Arch Linux
	pkgver = 1.2.0
	pkgrel = 1
	url = https://github.com/jebcalix/jebstudios-workset
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	depends = python
	depends = python-pydantic
	depends = python-yaml
	optdepends = python-gobject: GTK GUI (workset-picker)
	optdepends = gtk4: GTK GUI
	optdepends = libadwaita: GTK GUI
	optdepends = libayatana-appindicator: tray icon (workset-tray, preferred)
	optdepends = libappindicator: tray icon (legacy fallback)
	optdepends = gnome-shell-extension-appindicator: tray host on GNOME Shell
	optdepends = snixembed: SNI to XEmbed proxy (XFCE/MATE/Cinnamon/i3 X11)
	optdepends = waybar: tray host on Hyprland/Sway/Omarchy
	optdepends = wmctrl: X11 / XWayland / Plasma / XFCE / Cinnamon / MATE
	optdepends = hyprland: Hyprland backend
	optdepends = sway: Sway backend
	optdepends = i3-wm: i3 backend
	optdepends = plasma-workspace: Plasma (KDE) System Tray SNI
	optdepends = qt6-tools: KDE qdbus6 backend
	optdepends = xfce4-panel: XFCE tray
	optdepends = cinnamon: Cinnamon (x11 backend via wmctrl)
	optdepends = mate-panel: MATE tray
	optdepends = budgie-desktop: Budgie (x11 backend via wmctrl)
	source = jebstudios-workset-1.2.0.tar.gz::https://github.com/jebcalix/jebstudios-workset/archive/refs/tags/v1.2.0.tar.gz
