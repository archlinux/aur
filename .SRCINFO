pkgbase = skwir-bin
	pkgdesc = An augmented file manager, for humans and agents (the release build)
	pkgver = 0.3.0
	pkgrel = 1
	url = https://skwir.org
	arch = x86_64
	license = Apache-2.0
	license = BSD-3-Clause
	license = GPL-3.0-only
	license = AGPL-3.0-or-later
	license = LGPL-2.1-only
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libx11
	depends = libxcb
	depends = wayland
	depends = libglvnd
	depends = libdrm
	depends = mesa
	depends = alsa-lib
	depends = vulkan-driver
	depends = fontconfig
	optdepends = bubblewrap: LibreOffice, ImageMagick and thumbnailers run isolated
	optdepends = libreoffice-fresh: office documents shown as pages
	optdepends = pandoc-cli: text documents read by Pandoc
	optdepends = imagemagick: pictures no thumbnailer draws
	optdepends = ffmpeg: still frames of films
	optdepends = perl-image-exiftool: writing and removing pictures locations
	optdepends = plocate: instant name searches over whole disks
	optdepends = udisks2: unmounting volumes from the sidebar
	optdepends = sshfs: opening sftp:// addresses through your ssh
	optdepends = rclone: opening rclone remotes, s3:// and servers that ask a password
	optdepends = gvfs: opening smb://, dav://, ftp:// and other addresses through GVfs
	optdepends = gvfs-smb: Windows shares through GVfs
	optdepends = gvfs-mtp: phones over MTP
	optdepends = gvfs-gphoto2: cameras
	optdepends = gvfs-afc: iPhones
	optdepends = gvfs-nfs: NFS shares through GVfs
	optdepends = kio-fuse: smb://, dav:// and ftp:// through KIO on KDE Plasma
	optdepends = rsync: copies to and from sftp servers in batches
	optdepends = fuse3: rclone mounts, and phones KDE holds
	optdepends = avahi: servers nearby, a NAS or a Mac
	optdepends = wsdd: Windows PCs nearby
	provides = skwir=0.3.0
	provides = skwir-mermaid=0.3.0
	provides = skwir-mupdf=0.3.0
