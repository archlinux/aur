	makedepends = cargo
	makedepends = protobuf
	makedepends = help2man
	depends = libgcc
	depends = glibc
	source = ankaios-1.0.4.tar.gz::https://github.com/eclipse-ankaios/ankaios/archive/refs/tags/v1.0.4.tar.gz
	source = ank-server.service
	source = ank-agent.service
