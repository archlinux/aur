pkgbase = rosec-git
	pkgdesc = Multi-provider Secret Service daemon with SSH agent, FUSE mount, and PAM unlock (git)
	pkgver = 0.0.21
	pkgrel = 1
	url = https://github.com/jmylchreest/rosec
	install = rosec.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = rust
	makedepends = cargo
	makedepends = pkg-config
	makedepends = dbus
	makedepends = pam
	depends = dbus
	depends = pam
	optdepends = fuse3: SSH key FUSE filesystem at $XDG_RUNTIME_DIR/rosec/ssh
	optdepends = openssh: SSH agent support
	optdepends = libnotify: desktop notifications on lock/unlock
	provides = rosec
	provides = org.freedesktop.secrets
	provides = rosec-provider-bitwarden-pm
	provides = rosec-provider-bitwarden-sm
	provides = rosec-provider-gnome-keyring
	conflicts = rosec
	conflicts = rosec-bin
	conflicts = rosec-provider-bitwarden-pm
	conflicts = rosec-provider-bitwarden-pm-bin
	conflicts = rosec-provider-bitwarden-pm-git
	conflicts = rosec-provider-bitwarden-sm
	conflicts = rosec-provider-bitwarden-sm-bin
	conflicts = rosec-provider-bitwarden-sm-git
	conflicts = rosec-provider-gnome-keyring
	conflicts = rosec-provider-gnome-keyring-bin
	conflicts = rosec-provider-gnome-keyring-git
	options = !lto
	source = rosec-git::git+https://github.com/jmylchreest/rosec.git
	sha256sums = SKIP

pkgname = rosec-git
