pkgbase = libpamac-full
	pkgdesc = Library for Pamac package manager based on libalpm - flatpak and snap support enabled
	pkgver = 11.7.2
	pkgrel = 1
	epoch = 1
	url = https://github.com/manjaro/libpamac
	install = pamac.install
	arch = i686
	arch = pentium4
	arch = x86_64
	arch = arm
	arch = armv6h
	arch = armv7h
	arch = aarch64
	license = GPL3
	makedepends = vala
	makedepends = meson
	makedepends = gobject-introspection
	depends = libalpm.so=15
	depends = flatpak
	depends = snapd
	depends = snapd-glib
	depends = archlinux-appstream-data
	depends = appstream
	depends = polkit
	depends = libsoup3
	depends = git
	depends = json-glib
	depends = dbus-glib
	provides = libpamac
	conflicts = libpamac-aur
	conflicts = libpamac-flatpak
	conflicts = libpamac
	conflicts = libpamac-full-dev
	options = !emptydirs
	source = git+https://github.com/manjaro/libpamac.git#commit=c6df0043fc8c7ee5398125b21d14819d17fbfb17
	sha256sums = 72a20065f1655768fa3acb88db97f1da4b2ef876142c22e6faf659105b1c00d9

pkgname = libpamac-full
	backup = etc/pamac.conf
