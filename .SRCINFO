pkgbase = ionix-system-git
	pkgdesc = Ionix system files
	pkgver = r5.c9e72b7
	pkgrel = 1
	url = https://github.com/LucasionGS/ionix-iso
	arch = any
	license = GPL-3.0-or-later
	makedepends = librsvg
	makedepends = make
	makedepends = git
	source = ionix-iso::git+https://github.com/LucasionGS/ionix-iso.git
	sha256sums = SKIP

pkgname = ionix-base-git
	pkgdesc = Ionix system files shared by the desktop and the server: styler and themes, shell config, GRUB theme (git)
	depends = bash
	depends = util-linux
	optdepends = fish: the shell the Ionix config is written for
	optdepends = oh-my-posh: the themed prompt
	optdepends = btop: themed by the styler
	optdepends = kmscon: the themed console (ionix-console-theme)
	optdepends = grub: the Ionix boot menu theme
	provides = ionix-base
	conflicts = ionix-base

pkgname = ionix-desktop-git
	pkgdesc = Ionix desktop: Hyprland defaults, session scripts, login modes, wallpaper (git)
	depends = ionix-base
	depends = hyprland
	depends = python
	optdepends = ionix-quickshell-git: the Ionix bar, lock screen and greeter
	optdepends = greetd: the graphical login (ionix-login-mode greeter)
	optdepends = fprintd: fingerprint login (ionix-fingerprint)
	optdepends = yay: optional software bundles from the AUR (ionix-extras)
	optdepends = matugen: wallpaper-adaptive themes
	provides = ionix-desktop
	conflicts = ionix-desktop
	conflicts = ionix-server

pkgname = ionix-server-git
	pkgdesc = Ionix server: first-boot firewall and snapshot setup (git)
	depends = ionix-base
	optdepends = ufw: the firewall ionix-server-firstboot sets up
	optdepends = snapper: the "Fresh install" snapshot ionix-server-firstboot takes
	provides = ionix-server
	conflicts = ionix-server
	conflicts = ionix-desktop
