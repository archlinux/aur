pkgbase = toneshifteq
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering
	pkgver = 0.8.0
	pkgrel = 1
	url = https://github.com/brummer10/ToneShiftEQ
	arch = aarch64
	arch = x86_64
	groups = pro-audio
	license = BSD-3-Clause
	checkdepends = lv2lint
	makedepends = cairo
	makedepends = fftw
	makedepends = freetype2
	makedepends = jack
	makedepends = libsndfile
	makedepends = lv2
	makedepends = xxd
	source = https://github.com/brummer10/ToneShiftEQ/releases/download/v0.8.0/ToneShiftEQ-v0.8.0-src.tar.xz
	source = toneshifteq-ttl.patch::https://github.com/brummer10/ToneShiftEQ/pull/6.patch
	source = toneshifteq-ldflags.patch
	sha256sums = b0b678b9c0a063e5d1b18aed64cceb2a532c50b4d41bb82df9d460f12be61dae
	sha256sums = a70653f32685edf22d22273d89430118ba397a5b1daf4f43cd9fea0f8e104d4a
	sha256sums = f096f075c34794858719036ee2dde001db555588a5ea3428baf006f49192cb73

pkgname = toneshifteq
	arch = any
	depends = toneshifteq-clap
	depends = toneshifteq-lv2
	depends = toneshifteq-standalone
	depends = toneshifteq-vst3

pkgname = toneshifteq-clap
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – CLAP
	groups = pro-audio
	groups = clap-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = clap-host: for loading the CLAP plugin

pkgname = toneshifteq-lv2
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – LV2
	groups = pro-audio
	groups = lv2-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libstdc++
	depends = libx11
	optdepends = lv2-host: for loading the LV2 plugin

pkgname = toneshifteq-standalone
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – JACK standalone
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libjack.so
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11

pkgname = toneshifteq-vst3
	pkgdesc = A dynamic 12-band equalizer for mixing and mastering – VST3
	groups = pro-audio
	groups = vst3-plugins
	depends = glibc
	depends = libcairo.so
	depends = libfftw3.so
	depends = libfftw3f.so
	depends = libfreetype.so
	depends = libgcc
	depends = libsndfile.so
	depends = libstdc++
	depends = libx11
	optdepends = vst3-host: for loading the VST3 plugin
