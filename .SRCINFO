pkgbase = fenrir
	pkgdesc = A user space console screen reader written in Go
	pkgver = 2026.10.31
	pkgrel = 3
	epoch = 1
	url = https://git.stormux.org/storm/fenrir
	install = fenrir.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = go>=1.27.2
	makedepends = pkgconf
	depends = glibc
	depends = alsa-lib
	depends = libevdev
	depends = libx11
	depends = libvterm
	optdepends = python: Codex message bridge
	optdepends = speech-dispatcher: Default speech driver
	optdepends = pulseaudio: PulseAudio sound server
	optdepends = pipewire-pulse: PulseAudio-compatible sound server
	optdepends = enchant: Spell checking (also requires a language dictionary)
	optdepends = libusb: DECtalk USB speech synthesizer
	optdepends = socat: Control running Fenrir screen reader
	optdepends = xclip: X clipboard synchronization
