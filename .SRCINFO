	arch = any
	license = GPL-3.0-or-later
	checkdepends = python-gobject
	checkdepends = python-numpy
	checkdepends = python-opencv
	makedepends = git
	source = elanfp::git+https://gitlab.com/juxuanu/elanfp.git
	sha256sums = SKIP

pkgname = elanfp-git
	install = elanfp.install
	depends = fprintd
