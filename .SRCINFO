pkgbase = mpvlock-git
	pkgdesc = A simple, GPU-accelerated screen locking utility for Hyprland with video background support
	pkgver = r1.0
	pkgrel = 1
	url = https://github.com/nomadxxxx/mpvlock
	arch = x86_64
	license = BSD
	makedepends = cmake
	makedepends = ninja
	makedepends = git
	depends = wayland
	depends = wayland-protocols
	depends = mesa
	depends = hyprwayland-scanner
	depends = cairo
	depends = libdrm
	depends = pango
	depends = libxkbcommon
	depends = pam
	depends = hyprlang
	depends = hyprutils
	depends = hyprgraphics
	depends = file
	depends = mpv
	depends = mpvpaper
	optdepends = hypridle: for idle timeout integration
	provides = mpvlock
	provides = hyprlock
	conflicts = mpvlock
	conflicts = hyprlock
	conflicts = hyprlock-git
	backup = etc/xdg/hypr/hypridle.conf
	backup = etc/pam.d/mpvlock
	source = git+https://github.com/nomadxxxx/mpvlock.git
	sha256sums = SKIP

pkgname = mpvlock-git
