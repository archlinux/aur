pkgbase = wlbar
	pkgdesc = A small status bar for the River and niri Wayland compositors
	pkgver = 1.5.1
	pkgrel = 1
	url = https://codeberg.org/vighd/wlbar
	arch = x86_64
	license = MIT
	makedepends = go
	depends = fontconfig
	depends = freetype2
	optdepends = river-classic: River compositor support — rivertags/title modules (zriver_status_manager_v1; NOT the incompatible river 0.4+)
	optdepends = niri: niri compositor support — niriworkspaces/nirititle modules
	optdepends = ttf-nerd-fonts-symbols: Nerd Font icon glyphs for the module icons (clock, battery, ...)
	optdepends = ttf-jetbrains-mono: a monospace text font (or any other TTF/OTF face)
	optdepends = wireplumber: audio module (wpctl)
	optdepends = libpulse: audio module live updates (pactl subscribe)
	optdepends = bluez-utils: bluetooth module (bluetoothctl)
	optdepends = pacman-contrib: pacman module (checkupdates)
	optdepends = iputils: network module connectivity check (ping)
	optdepends = wireless_tools: network module Wi-Fi SSID (iwgetid)
	optdepends = iwd: network module Wi-Fi SSID alternative (iwctl)
	source = wlbar-1.5.1.tar.gz::https://codeberg.org/vighd/wlbar/archive/v1.5.1.tar.gz
	sha256sums = 6f7b4af7908f14139937e1eda26f760ec28902027c646c343ae62910ba12ac2d

pkgname = wlbar
