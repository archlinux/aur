	makedepends = ninja
	makedepends = pkgconf
	makedepends = gtk3
	makedepends = rustup
	makedepends = imagemagick
	makedepends = jsoncpp
	makedepends = patchelf
	makedepends = curl
	makedepends = git
	makedepends = unzip
	makedepends = xz
	makedepends = zip
	makedepends = libglvnd
	depends = gcc-libs
	depends = mpv
	depends = libappindicator-gtk3
	depends = libsecret
	depends = libnotify
	depends = webkit2gtk-4.1
	depends = libsoup3
	depends = libayatana-appindicator
