pkgbase = mewline-qs
	pkgdesc = Quickshell shell for Hyprland, niri and bspwm — bar, widgets and menus (successor of mewline)
	pkgver = 2.5.0
	pkgrel = 1
	url = https://github.com/meowrch/mewline-qs
	install = mewline-qs.install
	arch = any
	license = GPL-3.0-only
	depends = quickshell
	optdepends = python: runtime helper scripts and peripheral battery polling
	optdepends = python-dbus: Bluetooth battery levels via BlueZ Battery1
	optdepends = bspwm: X11 window management (required on bspwm)
	optdepends = sxhkd: X11 hotkey daemon for the widget binds (required on bspwm)
	optdepends = picom: X11 compositor (required on bspwm: corners, blur, animations)
	optdepends = xdotool: X11 window tagging and keyboard handover (required on bspwm)
	optdepends = xorg-xrandr: monitor refresh detection on X11
	optdepends = xorg-xprop: window enumeration for the bspwm autostart module
	optdepends = xorg-xdpyinfo: screen size detection in the bspwm autostart module
	optdepends = feh: X11 wallpaper setting
	optdepends = hyprland: Wayland window management (required on Hyprland)
	optdepends = cava: audio visualizer for the music widget
	optdepends = cliphist: clipboard history
	optdepends = brightnessctl: brightness control
	optdepends = grim: screenshots
	optdepends = slurp: screenshot region selection
	optdepends = maim: X11 screenshots
	optdepends = slop: screen-recording region selection (X11)
	optdepends = satty: screenshot annotation and editing
	optdepends = wf-recorder: Wayland screen recording
	optdepends = ffmpeg: screen recording (x11grab on X11)
	optdepends = pawlette: palette/theme engine the shell follows live
	source = https://github.com/meowrch/mewline-qs/archive/refs/tags/v2.5.0.tar.gz
	sha256sums = 530daa3bd6d33107bc98fe95ce0bddd3c15c6eb361b1200733dc4953390793ed

pkgname = mewline-qs
