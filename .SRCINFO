pkgname = shelly-gnome
	pkgdesc = Shelly for GNOME: Libadwaita port of the Shelly Arch Linux Package Manager.
	depends = pacman
	depends = gtk4
	depends = libadwaita
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = curl
	depends = sqlite
