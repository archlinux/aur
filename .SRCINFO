pkgname = linux6.13.7.hardened1-1-hardened-bin
	pkgdesc = The Security-Hardened Linux kernel and modules, version 6.13.7-hardened1-1-hardened
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = usbctl: deny_new_usb control
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-hardened

pkgname = linux6.13.7.hardened1-1-hardened-headers-bin
	pkgdesc = Headers and scripts for building modules for the Security-Hardened Linux kernel 6.13.7-hardened1-1-hardened
	depends = pahole
	conflicts = linux-hardened-headers

pkgname = linux6.13.7.hardened1-1-hardened-docs-bin
	pkgdesc = Documentation for the Security-Hardened Linux kernel 6.13.7-hardened1-1-hardened
	conflicts = linux-hardened-docs
