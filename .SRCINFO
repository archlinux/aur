pkgbase = utumno
	pkgdesc = Quickshell desktop shell for Wayland compositors (bar, launcher, dashboard, greeter)
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/dani-77/utumno
	arch = any
	license = MIT
	makedepends = rsync
	depends = quickshell
	depends = power-profiles-daemon
	depends = alsa-utils
	depends = alsa-tools
	depends = brightnessctl
	depends = wireless_tools
	depends = iw
	depends = curl
	depends = eww
	depends = dgop
	optdepends = upower: battery widget
	optdepends = networkmanager: network widget
	optdepends = matugen: wallpaper-based color palette
	optdepends = lm_sensors: CPU temperature in the dashboard (falls back to thermal_zone0)
	optdepends = cmus: music controls in the dashboard and the music picker
	optdepends = ffmpeg: album/artist tags in the music picker (ffprobe)
	optdepends = tmux: start cmus headless from the dashboard
	optdepends = screen: start cmus headless from the dashboard (if tmux is missing)
	optdepends = xdg-user-dirs: music picker follows XDG_MUSIC_DIR
	optdepends = greetd: native login greeter (greeter/, set up manually)
	optdepends = dwl: compositor hosting the greeter (greeter/assets/greet-dwl.sh)
	optdepends = xorg-xinit: X11 sessions from the greeter (startx)
	source = utumno-0.5.0.tar.gz::https://github.com/dani-77/utumno/archive/refs/tags/0.5.0.tar.gz
	sha256sums = 6dc986f59cf257e5813d876557916a6989e82ea3ec0585b3538d76655e94f107

pkgname = utumno
