pkgname = linux-cachyos-native
	pkgdesc = The Linux EEVDF + LTO + AutoFDO + Propeller Cachy Sauce Kernel by CachyOS with other patches and improvements. kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE
	provides = linux-cachyos-lto=7.0.1-1
	replaces = linux-cachyos-lto

pkgname = linux-cachyos-native-headers
	pkgdesc = Headers and scripts for building modules for the Linux EEVDF + LTO + AutoFDO + Propeller Cachy Sauce Kernel by CachyOS with other patches and improvements. kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-cachyos-native
	depends = clang
	depends = llvm
	depends = lld
	provides = LINUX-HEADERS
	provides = linux-cachyos-lto-headers=7.0.1-1
	replaces = linux-cachyos-lto-headers

pkgname = linux-cachyos-native-nvidia-open
	pkgdesc = nvidia open modules of 595.58.03 driver for the linux-cachyos-native kernel
	license = MIT AND GPL-2.0-only
	depends = linux-cachyos-native=7.0.1-1
	depends = nvidia-utils=595.58.03
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-cachyos-native-nvidia
