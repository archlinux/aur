pkgbase = easyshot-bin
	pkgdesc = Screenshot, annotation and screen-recording app for Linux/Wayland (prebuilt)
	pkgver = 0.3.0
	pkgrel = 1
	url = https://easyshot.site
	install = easyshot.install
	arch = x86_64
	license = MIT
	depends = glibc
	depends = gcc-libs
	depends = wayland
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxcb
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = freetype2
	depends = dbus
	depends = alsa-lib
	depends = hicolor-icon-theme
	depends = gstreamer
	depends = gst-plugins-base-libs
	depends = gst-plugins-good
	depends = gst-libav
	optdepends = gpu-screen-recorder: fastest screen recording
	optdepends = wf-recorder: screen recording on wlroots compositors
	optdepends = ffmpeg: video export and trimming
	optdepends = gst-plugins-bad-libs: recording a window from its own picture (H.264 parser, NVENC encoder)
	optdepends = gst-plugins-ugly: recording a window from its own picture (x264 encoder)
	optdepends = gst-plugins-base: sound in a window recording (Opus encoder)
	optdepends = tesseract: text capture (OCR) and smart redaction
	optdepends = tesseract-data-eng: English text recognition
	optdepends = xdg-desktop-portal: screen-cast recording and file dialogs
	provides = easyshot
	conflicts = easyshot
	options = !strip
	options = !debug
	source = https://github.com/mah3uz/easyshot/releases/download/v0.3.0/easyshot-0.3.0-x86_64-unknown-linux-gnu.tar.gz
