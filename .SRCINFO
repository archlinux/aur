pkgbase = vtium
	pkgdesc = Terminal for the Linux console, drawn through KMS/DRM
	pkgver = 0.1.0alpha.12
	pkgrel = 1
	url = https://github.com/vtium/vtium
	arch = x86_64
	license = MIT
	license = OFL-1.1
	license = Unicode-3.0
	license = MIT-open-group
	license = BSD-3-Clause
	license = Apache-2.0
	license = CC-BY-4.0
	makedepends = cargo
	makedepends = git
	makedepends = libxkbcommon
	makedepends = seatd
	makedepends = systemd-libs
	makedepends = fontforge
	noextract = terminus-font-4.49.1.tar.gz
	noextract = terminus-ttf-4.49.3.zip
	noextract = FontPatcher.zip
	options = !debug
	source = vtium::git+https://github.com/vtium/vtium.git#tag=v0.1.0-alpha.12?signed
	source = https://downloads.sourceforge.net/project/terminus-font/terminus-font-4.49/terminus-font-4.49.1.tar.gz
	source = https://files.ax86.net/terminus-ttf/files/4.49.3/terminus-ttf-4.49.3.zip
	source = https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
	validpgpkeys = 33F9B54FD2A4B6A4110749B3BA464FC9847A832A
	sha256sums = SKIP
	sha256sums = d961c1b781627bf417f9b340693d64fc219e0113ad3a3af1a3424c7aa373ef79
	sha256sums = 0ead921d98d99a4590ffe6cd66dc037fc0a2ceea1c735d866ba73fe058257577
	sha256sums = a8f11e511ed7c69e96680858c06b50a643ea7752e26d5cd13dd5e5cc53ab1760

pkgname = vtium
	install = vtium.install
	depends = bash
	depends = glibc
	depends = libgcc
	depends = libglvnd
	depends = libxkbcommon
	depends = mesa
	depends = seatd
	depends = systemd-libs
	depends = vtium-terminfo
	optdepends = vtium-fonts: the rest of vtium's catalog of font sets, and the fonts they draw with
	optdepends = kbd: console fonts, which vconsole.conf's FONT= and vtium.conf's font-name can name
	optdepends = kmscon-terminfo: the terminfo entry kmscon, for sessions run with term=kmscon
	conflicts = vtium-git
	conflicts = vtium-minspec
	conflicts = vtium-minspec-git
	conflicts = vtium-minspec-gpu
	conflicts = vtium-minspec-gpu-git
	backup = etc/pam.d/vtium
	backup = etc/vtium/fonts/console/cullet-mono.vtfrit
	backup = etc/vtium/fonts/console/terminus.vtfrit
	backup = etc/vtium/fonts/code/jetbrains-mono.vtfrit
	backup = etc/vtium/fonts/small/unifont-icons.vtfrit
	backup = etc/vtium/fonts/small/unscii-icons.vtfrit
	backup = etc/vtium/fonts/layers/nerd-symbols.vtlayer
	backup = etc/vtium/fonts/layers/nerd-symbols-small.vtlayer
	backup = etc/vtium/fonts/layers/noto-emoji.vtlayer
	backup = etc/vtium/fonts/layers/noto-emoji-small.vtlayer
	backup = etc/vtium/fonts/layers/unifont.vtlayer
