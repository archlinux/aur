pkgbase = computer-use-linux
	pkgdesc = Control a real Linux desktop from any MCP host (AT-SPI, portals, multi-compositor window targeting)
	pkgver = 0.7.22
	pkgrel = 1
	url = https://github.com/agent-sh/computer-use-linux
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = dbus
	makedepends = cargo
	source = computer-use-linux-0.7.22.tar.gz::https://github.com/agent-sh/computer-use-linux/archive/refs/tags/v0.7.22.tar.gz
	sha256sums = f95612c0c854d89e2537cf7f80f68c20fd88f877a32d0d98ef437fc5ecd77bd7

pkgname = computer-use-linux
	depends = at-spi2-core
	depends = gcc-libs
	depends = glibc
	optdepends = gnome-screenshot: screenshot fallback for background sessions
	optdepends = gnome-shell-extension-computer-use-linux: window targeting on GNOME
	optdepends = hyprland: window targeting on Hyprland
	optdepends = i3-wm: window targeting on i3
	optdepends = niri: window targeting on niri
	optdepends = sway: window targeting on Sway
	optdepends = wmctrl: window management on generic X11/EWMH
	optdepends = wtype: text input on wlroots compositors
	optdepends = xdotool: keyboard input on X11 sessions
	optdepends = xorg-xprop: window PID hydration on X11
	optdepends = ydotool: input fallback when the RemoteDesktop portal is unavailable
	conflicts = computer-use-linux-bin

pkgname = gnome-shell-extension-computer-use-linux
	pkgdesc = GNOME Shell extension for computer-use-linux window targeting
	install = gnome-shell-extension-computer-use-linux.install
	arch = any
	depends = computer-use-linux
	depends = gnome-shell
