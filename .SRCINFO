pkgname = linux-hardened-versioned-bin
	pkgdesc = Metapackage depending on linux7.1.9.hardened1-2-hardened-bin
	depends = linux7.1.9.hardened1-2-hardened-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-hardened-versioned-headers-bin
	pkgdesc = Metapackage depending on linux7.1.9.hardened1-2-hardened-headers-bin
	depends = linux7.1.9.hardened1-2-hardened-headers-bin

pkgname = linux-hardened-versioned-docs-bin
	pkgdesc = Metapackage depending on linux7.1.9.hardened1-2-hardened-docs-bin
	depends = linux7.1.9.hardened1-2-hardened-docs-bin

pkgname = linux7.1.9.hardened1-2-hardened-bin
	pkgdesc = The Security-Hardened Linux kernel and modules, version 7.1.9-hardened1-2-hardened
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-hardened-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = usbctl: deny_new_usb control
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-hardened

pkgname = linux7.1.9.hardened1-2-hardened-headers-bin
	pkgdesc = Headers and scripts for building modules for the Security-Hardened Linux kernel 7.1.9-hardened1-2-hardened
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-hardened-headers

pkgname = linux7.1.9.hardened1-2-hardened-docs-bin
	pkgdesc = Documentation for the Security-Hardened Linux kernel 7.1.9-hardened1-2-hardened
	conflicts = linux-hardened-docs
