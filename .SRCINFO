pkgbase = bitter-browser
	pkgdesc = Focused, native web browser for the Linux desktop
	pkgver = 0.6.0
	pkgrel = 1
	url = https://browser.bebitterbebetter.com.br/
	arch = x86_64
	license = MPL-2.0
	makedepends = cargo
	makedepends = meson
	depends = dconf
	depends = glib2
	depends = glibc
	depends = gtk4
	depends = hicolor-icon-theme
	depends = libadwaita
	depends = libgcc
	depends = libsoup3
	depends = pango
	depends = webkitgtk-6.0
	optdepends = gst-plugins-good: VP9, WebM and Opus video, as used by YouTube
	optdepends = gst-plugins-bad: Media Source Extensions demuxers and AV1 decoding
	optdepends = gst-libav: H.264 and AAC video
	optdepends = gst-plugin-va: hardware video decoding on Intel and AMD graphics
	optdepends = xdg-desktop-portal: camera, microphone and screen sharing
	optdepends = xdg-utils: make Bitter Browser the default browser on every desktop
	optdepends = geoclue: location for sites you allow
	optdepends = hunspell-en_us: spell checking dictionary (install the ones for your languages)
	conflicts = bitter-browser-bin
	conflicts = bitter-browser-git
	options = !lto
	source = https://github.com/bernardopg/bitter-browser/releases/download/v0.6.0/bitter-browser-0.6.0.tar.gz
	sha256sums = 45e83f6ef7b05bf3eaa962897e04ae20cfc71fe276313e5079c7602a555539d5

pkgname = bitter-browser
