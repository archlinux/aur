pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.38
	pkgrel = 3
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.38-3-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.38-3-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.38-3-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.38-3-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.38-3-x86_64.pkg.tar.zst
