pkgbase = pi-bolt-bin-release-git
	pkgdesc = Pi coding agent, compiled ahead of time to native code (latest Git binary release)
	pkgver = 0.8.5
	pkgrel = 1
	url = https://github.com/opensec-git/Pi-Bolt
	install = pi-bolt-bin-release-git.install
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = openssl
	depends = libxcb
	optdepends = fd: system-provided backend for the find tool
	optdepends = ripgrep: system-provided backend for the grep tool
	optdepends = tmux: for background bash capabilities
	options = !strip

pkgname = pi-bolt-bin-release-git
	pkgdesc = Pi coding agent, compiled ahead of time to native code (latest Git binary release, x86-64 with AVX2)
	provides = pi-bolt
	provides = pi-bolt-bin
	provides = pi-bolt-git
	provides = pi-bolt-bin-git
	conflicts = pi-bolt
	conflicts = pi-bolt-bin
	conflicts = pi-bolt-git
	conflicts = pi-bolt-bin-git
	conflicts = pi-bolt-bin-release-git-baseline

pkgname = pi-bolt-bin-release-git-baseline
	pkgdesc = Pi coding agent, compiled ahead of time to native code (latest Git binary release, any x86-64 CPU)
	provides = pi-bolt
	conflicts = pi-bolt
	conflicts = pi-bolt-bin
	conflicts = pi-bolt-git
	conflicts = pi-bolt-bin-git
	conflicts = pi-bolt-bin-release-git
