pkgbase = aurcache-server
	pkgdesc = Build server and pacman repository for Arch Linux packages from the AUR
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/Lukas-Heiligenbrunner/AURCache
	arch = x86_64
	arch = aarch64
	arch = armv7h
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	makedepends = libgit2
	makedepends = rust-wasm
	makedepends = wasm-bindgen-cli
	depends = gcc-libs
	depends = libgit2
	depends = xz
	depends = alpm-pkgbuild-bridge
	depends = aurcache-sandbox
	options = !strip
	options = !lto
	options = !debug
	backup = etc/aurcache/server.env
	source = aurcache-server-0.5.0.tar.gz::https://github.com/Lukas-Heiligenbrunner/AURCache/archive/refs/tags/v0.5.0.tar.gz
