pkgbase = objfw
	pkgdesc = Portable, lightweight framework for the Objective-C language
	pkgver = 1.1.7
	pkgrel = 1
	url = https://objfw.nil.im/
	arch = x86_64
	groups = objfw
	license = LGPL3
	makedepends = clang
	source = https://objfw.nil.im/downloads/objfw-1.1.7.tar.gz
	sha256sums = 5107d8a0627e2270d211abf1b4f6c50fd89c8d672d2179b50daa7d3b66d68a70

pkgname = libobjfw
	pkgdesc = ObjFW library
	depends = glibc
	depends = gcc-libs
	depends = libobjfwrt
	depends = bash

pkgname = libobjfwrt
	pkgdesc = ObjFW Objective-C runtime library
	depends = glibc
	depends = gcc-libs

pkgname = libobjfwtls
	pkgdesc = TLS support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = openssl

pkgname = ofarc
	pkgdesc = Utility for handling ZIP, Tar, LHA and Zoo archives
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofdns
	pkgdesc = Utility for performing DNS requests on the command line
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhash
	pkgdesc = Utility to hash files with various cryptographic hash functions
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhttp
	pkgdesc = Command line downloader for HTTP(S)
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls
