pkgbase = rust-dos
	pkgdesc = An x86 DOS emulator written in Rust, with Sound Blaster, AdLib, Gravis Ultrasound, General MIDI, Roland MT-32 and Tandy sound, CGA composite colours and CRT shaders
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/dividebysandwich/rust-dos
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	makedepends = cargo
	depends = alsa-lib
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = munt
	depends = sdl2
	optdepends = soundfont-fluid: General MIDI SoundFont for the MPU-401 (soundfont= in [sound])
	optdepends = fluidsynth: software synthesizer to play the MIDI sent out of a MIDI port (midisynth=host)
	source = rust-dos-0.5.0.tar.gz::https://github.com/dividebysandwich/rust-dos/archive/refs/tags/v0.5.0.tar.gz
