pkgbase = voxtype-bin
	pkgdesc = Push-to-talk voice-to-text for Linux (pre-built binaries)
	pkgver = 0.4.6
	pkgrel = 1
	url = https://voxtype.io
	install = voxtype-bin.install
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = curl
	depends = gcc-libs
	depends = glibc
	optdepends = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends = ydotool: keyboard simulation fallback (X11/TTY support)
	optdepends = wl-clipboard: clipboard support
	optdepends = libnotify: desktop notifications
	optdepends = pipewire: audio capture (recommended)
	optdepends = pulseaudio: audio capture (alternative)
	optdepends = vulkan-icd-loader: GPU acceleration via Vulkan (enable with: voxtype setup gpu --enable)
	provides = voxtype
	conflicts = voxtype
	backup = etc/voxtype/config.toml
	source = voxtype-avx2::https://github.com/peteonrails/voxtype/releases/download/v0.4.6/voxtype-0.4.6-linux-x86_64-avx2
	source = voxtype-avx512::https://github.com/peteonrails/voxtype/releases/download/v0.4.6/voxtype-0.4.6-linux-x86_64-avx512
	source = voxtype-vulkan::https://github.com/peteonrails/voxtype/releases/download/v0.4.6/voxtype-0.4.6-linux-x86_64-vulkan
	source = config.toml::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/config/default.toml
	source = voxtype.service::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/packaging/systemd/voxtype.service
	source = voxtype.bash::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/packaging/completions/voxtype.bash
	source = voxtype.zsh::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/packaging/completions/voxtype.zsh
	source = voxtype.fish::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/packaging/completions/voxtype.fish
	source = LICENSE::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/LICENSE
	source = README.md::https://raw.githubusercontent.com/peteonrails/voxtype/v0.4.6/README.md
