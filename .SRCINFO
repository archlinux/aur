pkgname = onnxruntime-core
	pkgdesc = Cross-platform inference engine for ONNX models: the C and C++ library with the CPU execution provider
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = nccl
	optdepends = onnxruntime-provider-cuda: the CUDA execution provider
	optdepends = onnxruntime-provider-tensorrt: the TensorRT execution provider
	optdepends = onnxruntime-provider-openvino: the OpenVINO execution provider (Intel CPU, GPU and NPU)
	optdepends = onnxruntime-provider-dnnl: the oneDNN execution provider (CPU)
	optdepends = onnxruntime-provider-migraphx: the MIGraphX execution provider (AMD GPUs; AUR pkgbase onnxruntime-split-migraphx, untested on AMD hardware)
	provides = onnxruntime=1.29.0
	provides = libonnxruntime.so
	conflicts = onnxruntime
	conflicts = onnxruntime-cpu
	conflicts = onnxruntime-cuda
	conflicts = onnxruntime-opt-cuda
	conflicts = onnxruntime-rocm
	conflicts = onnxruntime-opt-rocm
	conflicts = onnxruntime-git
	conflicts = onnxruntime-full
	conflicts = onnxruntime-provider-cuda12-legacy<1.29.0-2
	conflicts = onnxruntime-provider-cuda12-legacy-bin<1.29.0-2
	replaces = onnxruntime-full

pkgname = onnxruntime-provider-cuda13-rtx
	pkgdesc = The CUDA execution provider of ONNX Runtime, for onnxruntime-core (NVIDIA GPUs)
