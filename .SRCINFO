pkgbase = framepipe-git
	pkgdesc = Feature rich high performance GPU screen recorder for Linux (wayland)
	pkgver = 0.1.3.r0.g1c2d43d
	pkgrel = 1
	url = https://github.com/martian0x80/framepipe
	install = framepipe.install
	arch = x86_64
	license = GPL-3.0-only
	makedepends = git
	makedepends = rust
	makedepends = clang
	makedepends = pkgconf
	depends = dbus
	depends = libcap
	depends = libdrm
	depends = pipewire
	depends = libva
	depends = wayland
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-base-libs
	depends = gst-plugin-pipewire
	depends = gst-plugins-good
	depends = glib2
	depends = libinput
	depends = libxkbcommon
	depends = libglvnd
	optdepends = mesa: Required to record your screen AMD/Intel GPUs
	optdepends = intel-media-driver: Required to record your screen on Intel Broadwell or later iGPUs or Intel Arc
	optdepends = linux-firmware-intel: Required to record your screen on Intel Skylake or later iGPUs
	optdepends = xdg-desktop-portal: Required to record your screen with pipewire on Wayland
	provides = framepipe
	conflicts = framepipe
	options = !lto
	options = !debug
	source = framepipe::git+https://github.com/martian0x80/framepipe.git
	sha256sums = SKIP

pkgname = framepipe-git
