	url = https://github.com/polarours/hyprfetch
	arch = x86_64
	arch = aarch64
	license = GPL3
	makedepends = cargo
	makedepends = git
	depends = gcc-libs
	depends = glibc
	optdepends = hyprland: runtime Hyprland session data
