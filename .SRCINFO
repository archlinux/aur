	depends = mingw-w64-pcre2
	optdepends = mingw-w64-mesa: use LLVMpipe software rasterizer for Qt Quick
	optdepends = mingw-w64-postgresql: PostgreSQL support
	optdepends = mingw-w64-mariadb-connector-c: MySQL support
	options = !strip
	options = !buildflags
	options = staticlibs
	options = !emptydirs
