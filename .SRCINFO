pkgbase = nog
	pkgdesc = A tier-aware package manager for Arch Linux — pacman with a safety net, written in Rust; one install command for the repositories, the AUR, Flatpak and Snap. Arch Linux and Arch-based distributions; no desktop needed; works on a plain text console (tty)
	pkgver = 1.9.0
	pkgrel = 1
	url = https://github.com/jetomev/nog
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	depends = pacman
	depends = pacman-contrib
	depends = fakeroot
	depends = sudo
	depends = zstd
	optdepends = yay: AUR helper integration (preferred if installed)
	optdepends = paru: AUR helper integration (alternative)
	optdepends = flatpak: Flatpak apps installed, removed and updated through nog (offered when the install chain reaches it; off when absent)
	optdepends = snapd: snaps installed, removed and updated through nog (offered when the install chain reaches it; off when absent)
	options = !debug
	backup = etc/nog/nog.conf
	backup = etc/nog/tier-pins.toml
	source = nog-1.9.0.tar.gz::https://github.com/jetomev/nog/releases/download/v1.9.0/nog-1.9.0.tar.gz
	source = nog-1.9.0.tar.gz.asc::https://github.com/jetomev/nog/releases/download/v1.9.0/nog-1.9.0.tar.gz.asc
	validpgpkeys = 32E1D2AB9380BFD6BFE3BC1EAC2A3407CC070F9E
	sha256sums = ff56889c5ef099eb461bd20f653faabba109d5a65da856df4b6a7c20dab47093
	sha256sums = SKIP

pkgname = nog
