pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.21
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.21-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.21-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.21-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.21-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.21-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.21-1-x86_64.pkg.tar.zst
	sha256sums = 4c29c0a747e1378ec83958a0f61d4c21a5938a4da2a009e36db568ca81e3fd53
	sha256sums = 32361581cd316831d274f229430ff5234bc00f3db3fd88dff73dfe6b2ff2e934
	sha256sums = dc7fe14e039b9c2e9208df31071f5335717548c804b50e158fa52b1ea297f4cf

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.21-1-lts-bin
	depends = linux6.12.21-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.21-1-lts-headers-bin
	depends = linux6.12.21-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.21-1-lts-docs-bin
	depends = linux6.12.21-1-lts-docs-bin

pkgname = linux6.12.21-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.21-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.21-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.21-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.21-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.21-1-lts
	conflicts = linux-lts-docs
