	install = logitech-trueforce-dkms.install
	license = GPL-2.0-only
	depends = dkms
	optdepends = logi-wheel: settings TUI, FFB proxy, simulated TrueForce and shim installer
	optdepends = oversteer: GUI to configure wheel settings
