	optdepends = nautilus: file manager keybind
	optdepends = kdeconnect: kdeconnect-indicator autostart entry
	optdepends = mocu-xcursor: cursor theme used by the example user.lua
	optdepends = kconfig: kwriteconfig6, updates the KDE colour scheme from the bar theme toggle
