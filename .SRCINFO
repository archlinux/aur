	optdepends = feh: wallpaper in startup.sh
	optdepends = conky: system monitor in startup.sh
	optdepends = dunst: notifications in startup.sh
	optdepends = udiskie: automounting in startup.sh
	optdepends = xcompmgr: compositing in startup.sh
	optdepends = xautolock: idle locking in startup.sh
	optdepends = redshift: colour temperature in startup.sh
	optdepends = sxhkd: extra hotkeys in startup.sh
