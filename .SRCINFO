pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.8.4.zen1
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.8.4.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.8.4.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.8.4.zen1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-6.8.4.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-headers-6.8.4.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-docs-6.8.4.zen1-1-x86_64.pkg.tar.zst
	sha256sums = b2c22d7072a04ea63f25f74604035521dd78738c3b740a4c2b2968ff172cd728
