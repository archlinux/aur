pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.10.2.zen1
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.10.2.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.10.2.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.10.2.zen1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-6.10.2.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-headers-6.10.2.zen1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-docs-6.10.2.zen1-1-x86_64.pkg.tar.zst
	sha256sums = 596889a5ecb255ac7389ff4f4989e4fa84fa1e5d793c8674f60de678a9cd544d
	sha256sums = 26fe3af70086e1d532cc6a7c2ab18af02e6aa941231ea70be59aac635b8ddc89
