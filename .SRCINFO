pkgbase = musepack-git
	pkgdesc = Musepack SV8 encoder/decoder with FAST_MATH fixes (git version, universally optimized)
	pkgver = 15feced
	pkgrel = 1
	url = https://github.com/tatsuz/musepack
	arch = x86_64
	license = LGPL
	makedepends = git
	makedepends = cmake
	makedepends = make
	conflicts = libmpcdec
	conflicts = libmpcdec-znver4-git
	conflicts = musepack-tools-git
	source = git+https://github.com/tatsuz/musepack.git
	source = musepack-fixes.patch
	sha256sums = SKIP
	sha256sums = e906fbebb619672c4b945fc70101d41945e4628ba97d85b7c8bf4579b3c41a3f

pkgname = libmpcdec-git
	pkgdesc = Musepack decoding library (git version, universal)
	depends = glibc
	provides = libmpcdec
	conflicts = libmpcdec
	conflicts = libmpcdec-znver4-git

pkgname = musepack-tools-git
	pkgdesc = Musepack SV8 encoder/decoder tools (git version, universal)
	depends = glibc
	depends = libmpcdec-git
	conflicts = musepack-tools-znver4-git
