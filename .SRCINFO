pkgbase = redalert2-recomp-git
	pkgdesc = Static recompilation of Red Alert 2 and Yuri's Revenge to native Linux (needs your own game copy)
	pkgver = 0.1.3.r0.g0000000
	pkgrel = 1
	url = https://github.com/sp00nznet/redalert2-recomp
	arch = x86_64
	license = MIT
	makedepends = git
	depends = gcc
	depends = lib32-gcc-libs
	depends = lib32-glibc
	depends = cmake
	depends = ninja
	depends = pkgconf
	depends = python
	depends = git
	depends = lib32-sdl2-compat
	depends = lib32-sdl2_ttf
	depends = ttf-liberation
	optdepends = lib32-ffmpeg: Bink movies (intro/cutscenes); without it build with CMAKE_ARGS=-DWITH_FFMPEG=OFF
	optdepends = wine: play the Windows builds instead of the native ones (setup --wine)
	optdepends = steam: source of the game files (Proton)
	provides = redalert2-recomp
	conflicts = redalert2-recomp
	source = git+https://github.com/sp00nznet/redalert2-recomp.git
	sha256sums = SKIP

pkgname = redalert2-recomp-git
