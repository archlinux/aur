pkgbase = bpfcompat
	pkgdesc = eBPF compatibility evidence and CI gate: boots real kernels in VMs to validate BPF objects and loaders
	pkgver = 0.3.7
	pkgrel = 3
	url = https://github.com/Kernel-Guard/bpfcompat
	install = bpfcompat.install
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	makedepends = go
	makedepends = pkgconf
	makedepends = gcc
	depends = glibc
	depends = libbpf
	depends = libelf
	optdepends = qemu-system-x86: QEMU backend for x86_64 guest kernels (provides qemu-system-x86_64)
	optdepends = qemu-system-aarch64: QEMU backend for aarch64 guest kernels (provides qemu-system-aarch64)
	optdepends = qemu-img: disk image conversion used by the VM flows (provides qemu-img)
	optdepends = virtme-ng: boot kernels through vng instead of a hand-rolled initramfs (provides vng)
	optdepends = firecracker: Firecracker microVM backend (provides firecracker)
	optdepends = busybox: minimal initramfs for VM boots
	optdepends = cpio: initramfs assembly
	source = bpfcompat-0.3.7.tar.gz::https://github.com/Kernel-Guard/bpfcompat/archive/refs/tags/v0.3.7.tar.gz
