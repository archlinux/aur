pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.6.30
	pkgrel = 2
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.30-2-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.30-2-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.30-2-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-6.6.30-2-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-headers-6.6.30-2-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-lts-docs-6.6.30-2-x86_64.pkg.tar.zst
	sha256sums = 2175990b2ccd2811ab0f7297cd722d88230ae59b405a625d038b683d7c9cf354
	sha256sums = 3571e5b43cd6a074247e05842f69e62f0aa1da2071aa38fff52feefcd6e7895c
