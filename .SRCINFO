pkgname = slipmat-daemon
	pkgdesc = Slipmat's playback daemon and hidden Chromium sidecar
	depends = gtk3
	depends = nss
	depends = alsa-lib
	depends = libcups
	depends = libxkbcommon
	depends = mesa
	depends = libdrm
	depends = libseccomp
	depends = libpulse

pkgname = slipmat
	pkgdesc = A native GNOME client for Apple Music
	depends = slipmat-daemon=0.11.0-1
	depends = gtk4
	depends = libadwaita
	depends = librsvg
	depends = hicolor-icon-theme

pkgname = climat
	pkgdesc = Winamp-style Apple Music in a terminal; needs a graphical session
	depends = slipmat-daemon=0.11.0-1
	depends = libpulse
	depends = hicolor-icon-theme
