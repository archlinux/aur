pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.8.4.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.8.4.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.8.4.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.8.4.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-6.8.4.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.8.4.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.8.4.arch1-1-x86_64.pkg.tar.zst
	sha256sums = e567e3eb5734fc0cea6450bf132a0a7e9768453dd085c517ff1528ecd8268202
	sha256sums = a4c69ae6f014e8daf6afd4b21c92fa1e5ae1b297d8757c7dd88b38b54f0f097b
