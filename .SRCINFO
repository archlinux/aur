	makedepends = python-installer
	depends = python>=3.10
	depends = python-tiktoken
	depends = python-pydantic
	depends = python-click
	depends = python-rich
	depends = python-opentelemetry-api
	depends = python-yaml
	depends = python-tomlkit
	depends = python-truststore
	depends = ast-grep
	depends = litellm
	optdepends = python-fastapi: required by headroom proxy and wrap
	optdepends = uvicorn: required by headroom proxy and wrap
	optdepends = python-httpx: required by headroom proxy and wrap
	optdepends = python-h2: required by headroom proxy and wrap
	optdepends = python-openai: required by headroom proxy and wrap
	optdepends = python-orjson: required by headroom proxy and wrap
	optdepends = python-mcp: required by headroom proxy and wrap
	optdepends = python-magika: required by headroom proxy and wrap
	optdepends = python-zstandard: required by headroom proxy and wrap
	optdepends = python-websockets: required by headroom proxy and wrap
