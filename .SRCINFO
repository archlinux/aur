pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.32
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.32-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.32-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.32-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.32-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.32-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.32-1-x86_64.pkg.tar.zst
	sha256sums = 531abba2bfe8a73a4f8bfe7bb3f26d14b3b1888a7a53213538eb7e1004d9b534
	sha256sums = 205751efd25732a30566829cff1220afd3b2f1f6fb9563b7ee65357373aeb375
	sha256sums = 8e65832b3070065574b00687bf47052ca03cb65715311ec6cefcb8c3e1c9d403

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.32-1-lts-bin
	depends = linux6.18.32-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.32-1-lts-headers-bin
	depends = linux6.18.32-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.32-1-lts-docs-bin
	depends = linux6.18.32-1-lts-docs-bin

pkgname = linux6.18.32-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.32-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.32-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.32-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.32-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.32-1-lts
	conflicts = linux-lts-docs
