pkgbase = openconnect-saml
	pkgdesc = OpenConnect wrapper with Azure AD (SAML) SSO support for Cisco SSL-VPNs
	pkgver = 0.24.3
	pkgrel = 1
	url = https://github.com/mschabhuettl/openconnect-saml
	arch = any
	license = GPL-3.0-or-later
	depends = python>=3.10
	depends = openconnect
	depends = python-attrs
	depends = python-colorama
	depends = python-keyring
	depends = python-lxml
	depends = python-prompt_toolkit
	depends = python-pyotp
	depends = python-pyqt6
	depends = python-pyqt6-webengine
	depends = python-pysocks
	depends = python-pyxdg
	depends = python-requests
	depends = python-structlog
	depends = python-toml
	optdepends = python-rich: rich-formatted output for `openconnect-saml status` and the interactive TUI
	optdepends = python-playwright: required for --browser chrome backend (run `playwright install chromium` after install)
	optdepends = python-fido2: hardware-key (Yubikey/Nitrokey) auth in --browser headless mode
	optdepends = keepassxc: --totp-source keepassxc (provides keepassxc-cli)
	optdepends = bitwarden-cli: --totp-source bitwarden (AUR; provides the `bw` CLI)
	optdepends = 1password-cli: --totp-source 1password (AUR; provides the `op` CLI)
	optdepends = pass: --totp-source pass (provides the `pass` CLI; pair with `pass-otp`)
	optdepends = pass-otp: --totp-source pass (TOTP extension for `pass`)
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-hatchling
	source = openconnect-saml-0.24.3.tar.gz::https://github.com/mschabhuettl/openconnect-saml/archive/v0.24.3.tar.gz
	sha256sums = 1ce4b73b3a865d86f4ec89aabbf67c3934668d88577522fa3e55698610a5a59c

pkgname = openconnect-saml
