	optdepends = xdg-desktop-portal-gnome: portal implementation preferred by the default config
	optdepends = xdg-desktop-portal-gtk: portal implementation preferred by the default config
	optdepends = gnome-keyring: secrets portal backend
	optdepends = xwayland-satellite: Xwayland support for X11 apps
	optdepends = alacritty: terminal bound in the default config
	optdepends = fuzzel: app launcher bound in the default config
	optdepends = swaylock: screen locker bound in the default config
	optdepends = waybar: status bar bound in the default config
	optdepends = swaybg: wallpaper
	optdepends = mako: notification daemon
	optdepends = swayidle: idle management
	optdepends = noto-fonts-cjk: CJK fonts for the shell UI
