pkgbase = flowshot-bin
	pkgdesc = Screenshot and annotation tool for Wayland and X11 with mixed-DPI support (prebuilt binary)
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/FlowOSS/flowshot
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = libgcc
	depends = libpipewire-0.3.so
	depends = wayland
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = ttf-font
	depends = hicolor-icon-theme
	optdepends = xdg-desktop-portal: portal capture, global shortcuts and OpenURI
	optdepends = xdg-desktop-portal-gnome: portal backend for GNOME
	optdepends = xdg-desktop-portal-kde: portal backend for KDE Plasma (KWin ScreenShot2)
	optdepends = xdg-desktop-portal-hyprland: portal backend for Hyprland
	optdepends = xdg-desktop-portal-wlr: portal backend for wlroots compositors (Sway)
	optdepends = vulkan-driver: Vulkan implementation for the GPU-accelerated overlay
	optdepends = gnome-shell-extension-appindicator: system tray icon under GNOME
	provides = flowshot=0.5.0
	conflicts = flowshot
	conflicts = flowshot-git
	options = !strip
	options = !lto
	options = !debug
