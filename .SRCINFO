pkgbase = solana
	pkgver = 4.3.1
	pkgrel = 1
	epoch = 1
	url = https://github.com/anza-xyz/agave
	arch = x86_64
	license = Apache-2.0
	makedepends = clang
	makedepends = cargo
	makedepends = git
	makedepends = protobuf
	makedepends = rust
	noextract = platform-tools-linux-x86_64.tar.bz2
	options = !lto
	source = git+https://github.com/anza-xyz/agave.git#tag=v4.3.1
	source = git+https://github.com/anza-xyz/cargo-build-sbf.git#tag=cargo-build-sbf@v4.4.0
	source = git+https://github.com/solana-program/token-2022.git#tag=cli@v5.6.1
	source = https://github.com/anza-xyz/platform-tools/releases/download/v1.58/platform-tools-linux-x86_64.tar.bz2
	source = solana-sbf_sdk-path.patch
	sha256sums = be422ad5f04114ba9169f3f7adaa658f31726e560ba7ce3ab0944e42cf8f0fa9
	sha256sums = b039350d6d73488e1b4296c78475738c3c2e5c54e8370d031983c6e59a6d7c8d
	sha256sums = 5191648d2bb219c91774966900e6fcf44e2e5b08cfe2b2c483cf955dd36d9cd8
	sha256sums = 7b82eb420b5aebd1e5590db0ae25c523eca06724d4238ae02139690535636c37
	sha256sums = 34b4ca06956669e23b7043a4b025365a43b42a6c3f13b21d5a60a6ac7d8b7c3f

pkgname = solana-cli
	pkgdesc = Solana CLI tools
	depends = bzip2
	depends = glibc
	depends = libgcc
	depends = zstd
	provides = spl-token
	conflicts = spl-token
	conflicts = solana-bin

pkgname = agave-validator
	pkgdesc = Agave validator and node operator tools for Solana
	install = agave-validator.install
	depends = bzip2
	depends = glibc
	depends = libcap
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd

pkgname = solana-dev
	pkgdesc = Solana program developer tools
	install = solana-dev.install
	depends = bzip2
	depends = cargo
	depends = clang
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = lld
	depends = llvm
	depends = rust
	depends = zlib
	depends = zstd
	conflicts = solana-dev-bin
	options = !strip
	options = !debug
	options = !lto

pkgname = solana
	pkgdesc = A fast, secure, and censorship resistant blockchain (meta package)
	depends = solana-cli
	depends = agave-validator
	depends = solana-dev
