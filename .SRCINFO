pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.71
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.71-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.71-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.71-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.71-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.71-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.71-1-x86_64.pkg.tar.zst
	sha256sums = be47432f99091d1b5f7404cce4285e11e6f39d7a54d40802d906361a978011c3
	sha256sums = 702a4a02c2db64aa4e53e7a4e4d1d61053c5511906d1eb18dd85a3489069f13b
	sha256sums = 319e64da902f43690a043bf6b55a1d3df1ff467589cab819ddecef90b80aebb0

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.71-1-lts-bin
	depends = linux6.12.71-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.71-1-lts-headers-bin
	depends = linux6.12.71-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.71-1-lts-docs-bin
	depends = linux6.12.71-1-lts-docs-bin

pkgname = linux6.12.71-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.71-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.71-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.71-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.12.71-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.71-1-lts
	conflicts = linux-lts-docs
