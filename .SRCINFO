pkgbase = pacsea-bin
	pkgdesc = Fast TUI for searching, inspecting, and queueing pacman/AUR packages written in Rust (binary version)
	pkgver = 0.8.2
	pkgrel = 1
	url = https://github.com/Firstp1ck/Pacsea
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = pacman
	depends = curl
	depends = bash
	depends = sudo
	depends = coreutils
	depends = grep
	depends = xdg-utils
	optdepends = paru: AUR package installation
	optdepends = yay: alternative AUR helper
	optdepends = wl-clipboard: clipboard support on Wayland
	optdepends = xclip: clipboard support on X11
	optdepends = reflector: update Arch mirrors
	optdepends = pacman-mirrors: Manjaro mirrorlist
	optdepends = rate-mirrors: Artix mirror rating
	optdepends = alacritty: run external commands in a terminal
	optdepends = kitty: run external commands in a terminal
	optdepends = ghostty: run external commands in a terminal
	optdepends = xterm: run external commands in a terminal
	optdepends = gnome-terminal: run external commands in a terminal
	optdepends = konsole: run external commands in a terminal
	optdepends = xfce4-terminal: run external commands in a terminal
	optdepends = tilix: run external commands in a terminal
	optdepends = mate-terminal: run external commands in a terminal
	optdepends = neovim: external editor
	optdepends = vim: external editor
	optdepends = emacs: external editor
	optdepends = helix: external editor
	optdepends = nano: external editor
	optdepends = klipper: clipboard manager on X11
	optdepends = clamav: malware scanning of files
	optdepends = trivy: vulnerability scanning
	optdepends = semgrep-bin: static analysis checks
	optdepends = shellcheck: lint shell scripts
	optdepends = downgrade: Downgrade of Packages
	optdepends = pacman-contrib: Used as a fallback for update checking
	provides = pacsea=0.8.2
	conflicts = pacsea
	conflicts = pacsea-git
	noextract = pacsea-x86_64
	noextract = pacsea-aarch64
	options = !strip
	source = Pacsea-v0.8.2.tar.gz::https://github.com/Firstp1ck/Pacsea/archive/refs/tags/v0.8.2.tar.gz
	sha256sums = SKIP
	source_x86_64 = pacsea-x86_64::https://github.com/Firstp1ck/Pacsea/releases/download/v0.8.2/pacsea-x86_64
