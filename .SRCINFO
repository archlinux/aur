pkgbase = netinfo-tui
	pkgdesc = Terminal UI for network interfaces: negotiated link speed, addresses, throughput and per-interface reachability
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/joaquinwojcik/netinfo-tui
	arch = any
	license = MIT
	depends = bash
	depends = coreutils
	depends = iproute2
	depends = sed
	depends = gawk
	optdepends = iputils: ICMP probes for the PING column
	optdepends = docker: resolve br-<id> bridges to their docker network name
	optdepends = iw: show the associated SSID as a wifi interface name
	optdepends = systemd: udev hardware model names and per-link DNS in the detail pane
	optdepends = ncurses: terminal size detection via tput
