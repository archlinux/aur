pkgname = ros2-jazzy-diagnostic_updater
	pkgdesc = Tools for easily updating ROS 2 diagnostics
	depends = ros2-jazzy

pkgname = ros2-jazzy-diagnostic_aggregator
	pkgdesc = Aggregates and categorizes ROS 2 diagnostic messages
	depends = ros2-jazzy

pkgname = ros2-jazzy-diagnostic_common_diagnostics
	pkgdesc = Predefined diagnostic nodes for monitoring Linux and ROS 2 systems
	arch = any
	depends = ros2-jazzy
	depends = ros2-jazzy-diagnostic_updater
	depends = lm_sensors
	depends = python-psutil
	depends = python-ntplib

pkgname = ros2-jazzy-diagnostic_remote_logging
	pkgdesc = Remote logging for ROS 2 diagnostics (InfluxDB)
	depends = ros2-jazzy
	depends = curl

pkgname = ros2-jazzy-self_test
	pkgdesc = Self-test tools for ROS 2 diagnostics
	depends = ros2-jazzy
	depends = ros2-jazzy-diagnostic_updater

pkgname = ros2-jazzy-diagnostics
	pkgdesc = Metapackage for the ROS 2 diagnostics suite
	arch = any
	depends = ros2-jazzy-diagnostic_updater
	depends = ros2-jazzy-diagnostic_aggregator
	depends = ros2-jazzy-diagnostic_common_diagnostics
