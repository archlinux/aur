pkgbase = pkgbuild-manager
	pkgdesc = Rust CLI + GTK4 settings panel and multi-file-manager context-menu integration for PKGBUILD management
	pkgver = 2.4.0
	pkgrel = 2
	url = https://github.com/johnpetersa19/PKGBUILD_Manager
	install = pkgbuild-manager.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = meson
	makedepends = ninja
	makedepends = rust
	makedepends = cargo
	makedepends = gettext
	makedepends = blueprint-compiler
	depends = pacman-contrib
	depends = libnotify
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	depends = git
	optdepends = namcap: for auditing package metadata and structure
	optdepends = shellcheck: for linting PKGBUILD bash code
	optdepends = python-nautilus: for Nautilus (GNOME) right-click menu support
	optdepends = nemo-python: for Nemo (Cinnamon) right-click menu support
	optdepends = python-caja: for Caja (MATE) right-click menu support
	optdepends = dolphin: for Dolphin (KDE) right-click menu support
	optdepends = openssh: for accessing Git and AUR remotes over SSH
	provides = pkgbuild-manager
	conflicts = pkgbuild-manager-git
	source = PKGBUILD_Manager-2.4.0.tar.gz::https://github.com/johnpetersa19/PKGBUILD_Manager/archive/refs/tags/v2.4.0.tar.gz
	sha256sums = 07396c0630e542b578d1747e148593ed0a4feef05067b60ec66215eeaafdd87d

pkgname = pkgbuild-manager
