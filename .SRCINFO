pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.30
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.30-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.30-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.30-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.30-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.30-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.30-1-x86_64.pkg.tar.zst
	sha256sums = ec4fe258ce07d64942afa097381e6b9fb5b53dcdb45afb7e1a04608885bbcfe9
	sha256sums = 210ab069b9aff1b3936c0b19e446405298ec4482be9cb503fe7af39ea4030c0a
	sha256sums = 829fa1297dcca2766efd5f4a3f932ddd70849a9fc28771a0386d7c19e57a8d02

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.30-1-lts-bin
	depends = linux6.12.30-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.30-1-lts-headers-bin
	depends = linux6.12.30-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.30-1-lts-docs-bin
	depends = linux6.12.30-1-lts-docs-bin

pkgname = linux6.12.30-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.30-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.30-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.30-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.30-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.30-1-lts
	conflicts = linux-lts-docs
