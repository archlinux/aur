pkgbase = gitcomet-bin
	pkgdesc = Fast, resource-efficient Git GUI written in Rust
	pkgver = 0.3.2
	pkgrel = 1
	url = https://gitcomet.dev/
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	depends = git
	depends = glibc
	depends = libgcc
	depends = fontconfig
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = zlib
	depends = hicolor-icon-theme
	depends = libglvnd
	optdepends = vulkan-icd-loader: preferred Vulkan renderer (otherwise uses EGL)
	optdepends = wayland: native Wayland sessions (otherwise uses X11)
	optdepends = git-lfs: Git LFS support
	optdepends = gnupg: commit signing and verification
	optdepends = openssh: SSH remotes and commit signing
	optdepends = xdg-utils: open files and links in external applications
	optdepends = xdg-desktop-portal: file pickers and desktop settings
	optdepends = noto-fonts-cjk: CJK font coverage
	optdepends = noto-fonts-emoji: emoji font coverage
	provides = gitcomet=0.3.2
	conflicts = gitcomet
	options = !strip
	options = !debug
	source = gitcomet-source-v0.3.2.tar.gz::https://github.com/Auto-Explore/GitComet/archive/refs/tags/v0.3.2.tar.gz
