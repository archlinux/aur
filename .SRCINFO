pkgbase = wallpick-git
	pkgdesc = wallpaper picker carousel for wayland, applies through hyprpaper, awww, swww, swaybg, caelestia or a custom command
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/iamanuclearwarhead/wallpick
	arch = any
	license = AGPL-3.0-or-later
	makedepends = git
	depends = quickshell
	depends = qt6-multimedia
	depends = qt6-declarative
	depends = imagemagick
	depends = ffmpeg
	depends = jq
	depends = curl
	depends = python
	depends = fontconfig
	depends = file
	depends = bash
	depends = util-linux
	optdepends = matugen: picker colours derived from the wallpaper
	optdepends = wl-clipboard: copy from the search box
	optdepends = python-pillow: faster colour indexing
	optdepends = hyprpaper: wallpaper daemon for hyprland
	optdepends = awww: animated wallpaper daemon
	optdepends = swaybg: minimal wallpaper daemon
	provides = wallpick
	conflicts = wallpick
	source = wallpick-git::git+https://github.com/iamanuclearwarhead/wallpick.git
	sha256sums = SKIP

pkgname = wallpick-git
