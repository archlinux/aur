pkgbase = tpm2-kira
	pkgdesc = TPM2-based TOTP authenticator with PCR policies
	pkgver = 0.1.2
	pkgrel = 1
	url = https://github.com/mrwiora/tpm2-kira
	arch = x86_64
	license = BSD-3-Clause
	makedepends = go>=1.19
	makedepends = git
	depends = bash
	depends = tpm2-tools>=5.0
	depends = tpm2-tss>=3.0.0
	optdepends = mkinitcpio: for early boot integration
	optdepends = cryptsetup: for disk encryption integration
	optdepends = systemd: for systemd-based initramfs
	provides = tpm2-kira
	conflicts = tpm2-kira-git
	options = !debug
	source = tpm2-kira::git+https://github.com/mrwiora/tpm2-kira.git
	sha256sums = SKIP

pkgname = tpm2-kira
