pkgbase = vgshell-git
	pkgdesc = Desktop shell for Hyprland, built on Quickshell (development version)
	pkgver = 0.1.0
	pkgrel = 2
	url = https://github.com/vanillagreencom/vgshell
	install = vgshell-git.install
	arch = any
	license = MIT AND OFL-1.1 AND ISC AND Apache-2.0 AND CC-BY-SA-4.0
	makedepends = git
	depends = greetd
	depends = glibc
	depends = vgshell-quickshell>=0.3.1
	depends = hyprland>=0.56
	depends = bash
	depends = coreutils
	depends = util-linux
	depends = nodejs>=18
	depends = python
	depends = libxkbcommon
	depends = xkeyboard-config
	depends = git
	depends = bubblewrap
	depends = curl
	depends = dbus
	depends = fd
	depends = ffmpeg
	depends = file
	depends = fontconfig
	depends = fzf
	depends = gawk
	depends = glib2
	depends = gpu-screen-recorder
	depends = grim
	depends = gum
	depends = hyprpicker
	depends = imagemagick
	depends = iproute2
	depends = less
	depends = libnotify
	depends = libpulse
	depends = libsecret
	depends = mise
	depends = networkmanager
	depends = pacman-contrib
	depends = pipewire
	depends = pipewire-audio
	depends = playerctl
	depends = qrencode
	depends = rclone
	depends = sed
	depends = slurp
	depends = systemd
	depends = tesseract
	depends = tesseract-data-eng
	depends = vsys
	depends = wireplumber
	depends = wl-clipboard
	depends = wtype
	depends = xdg-desktop-portal-gnome
	depends = xdg-desktop-portal-gtk
	depends = xdg-desktop-portal-hyprland
	depends = xdg-terminal-exec
	depends = xdg-utils
	optdepends = chromium: browser features in the bar and Jarvis
	optdepends = uv: Jarvis local voice model setup
	optdepends = agent-browser-bin: Jarvis browser actions
	optdepends = wlrctl: Jarvis desktop input
	optdepends = ttfx: animates the Screensaver text art
	optdepends = power-profiles-daemon: switches the power profile in the Power plugin
	optdepends = hdparm: lets idle hard disks stop spinning in the Power plugin
	optdepends = bandwhich: See all network traffic in the Network Traffic plugin
	optdepends = libcap: check and allow traffic capture in the Network Traffic plugin
	optdepends = btop: all processes and system readings from the System monitor panel
	optdepends = claude-code: sign in to Claude Code and use its account as the Jarvis AI model
	optdepends = openai-codex: sign in to Codex and use its account as the Jarvis AI model
	optdepends = voxtype-bin: Voice dictation engine
	optdepends = tmux: several Jarvis coding tasks at once
	optdepends = kendex-bin: the mail tool Jarvis hands a request for your agent fleet with
	optdepends = ydotool: Jarvis pointer fallback with an already running input service
	optdepends = bluez-utils: bluetoothctl, the Bluetooth pairing agent that answers pairing prompts
	optdepends = bluez: the Bluetooth service the Bluetooth plugin connects your devices through
	optdepends = snapper: a snapshot before the update pipeline changes packages
	optdepends = timeshift: a snapshot before the update pipeline changes packages, without snapper
	optdepends = sudo: package installs and the browser policy writer in floating TUIs
	optdepends = nvidia-utils: verifies a selected Jarvis CUDA local voice tier
	optdepends = ddcutil: brightness of external displays in the Displays plugin
	optdepends = brightnessctl: brightness of a laptop built-in display in the Displays plugin
	optdepends = cronie: crontab, which schedules automations where no systemd user manager answers
	optdepends = uwsm: the Hyprland (uwsm-managed) session the login screen starts first
	optdepends = xorg-xinit: startx, for X11 sessions on the login screen
	optdepends = polkit: pkexec, so applications can ask for administrator access
	optdepends = tailscale: the Tailscale connection in the VPN plugin
	optdepends = cups: lpstat and ipptool, which list your printers and their changes in the Printers plugin
	optdepends = cups-pk-helper: adds, removes and sets the default printer in the Printers plugin
	optdepends = system-config-printer: Print Settings, for drivers, paper size and quality in the Printers plugin
	optdepends = imv: opens a saved screenshot from its Capture notification
	optdepends = satty: edits a saved screenshot from its Capture notification
	optdepends = mpv: plays a saved recording from its Capture notification
	optdepends = google-chrome: opens a calendar day in a Google Chrome profile
	optdepends = brave-bin: opens a calendar day in a Brave profile
	optdepends = vivaldi: opens a calendar day in a Vivaldi profile
	optdepends = microsoft-edge-stable-bin: opens a calendar day in a Microsoft Edge profile

pkgname = vgshell-git
