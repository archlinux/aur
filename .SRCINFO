pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.74
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.74-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.74-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.74-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.74-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.74-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.74-1-x86_64.pkg.tar.zst
	sha256sums = 6f45aaecbc5897406e5aea2ca2193fcb6cf2755c151a42acd6250136b1247676
	sha256sums = 194f820d791eec7b1f3ae4f94eb0de833b4aa14da6c2dcf71b7ceb79cb7aa20d
	sha256sums = 78a712f2a0c51ca6fb3f128dabd3004f221419794ee1cd8982a0341f824a692c

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.74-1-lts-bin
	depends = linux6.12.74-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.74-1-lts-headers-bin
	depends = linux6.12.74-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.74-1-lts-docs-bin
	depends = linux6.12.74-1-lts-docs-bin

pkgname = linux6.12.74-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.74-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.74-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.74-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.12.74-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.74-1-lts
	conflicts = linux-lts-docs
