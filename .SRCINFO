pkgbase = libfronius
	pkgver = 1.2.1
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.2.1::git+https://github.com/ahpohl/libfronius.git#tag=v1.2.1
	sha256sums = 33c90daac7b9ff4fde69c5bc2468c5b2e177943a900fc8df33c12005f89d790c

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters and meters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
