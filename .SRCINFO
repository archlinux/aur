pkgbase = opencode-desktop
	pkgdesc = OpenCode desktop app (built from source, runs on system electron42)
	pkgver = 1.17.6
	pkgrel = 1
	url = https://github.com/anomalyco/opencode
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = bun
	makedepends = git
	makedepends = libxcrypt-compat
	depends = electron42
	depends = hicolor-icon-theme
	optdepends = opencode: standalone terminal CLI (independent of the desktop app, which embeds its own server)
	optdepends = nodejs: needed only when invoking npm CLI helpers shipped inside bundled node_modules (marked, js-yaml, semver, ...) — the desktop app itself runs entirely under electron
	conflicts = opencode-desktop-bin
	conflicts = opencode-desktop-electron
	conflicts = opencode-desktop-electron-bin
	replaces = opencode-desktop-electron
	options = !strip
	options = !debug
	source = opencode-desktop::git+https://github.com/anomalyco/opencode.git#tag=v1.17.6
	source = opencode-desktop.sh
	source = relax-bun-version.patch
	source = set-desktop-name.patch
	sha256sums = SKIP
	sha256sums = 84924177801958340d9d06c4f433e8818f1a7119babcfa56384133c7ce59e65f
	sha256sums = 82b5dcd7c56955af41982d8df7828b11907e58ef0199bb9d2e1edac0a9fbbe21
	sha256sums = 32640e478f139cf1658f6948627b14b3e386acf5c589e116a5745ef7c1f0b986

