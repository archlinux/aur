pkgbase = tabctl
	pkgdesc = Command-line browser tab controller with rofi integration for multiple window managers
	pkgver = 2.2.1
	pkgrel = 1
	url = https://github.com/slastra/tabctl
	install = tabctl.install
	arch = x86_64
	license = MIT
	makedepends = go
	makedepends = git
	depends = dbus
	optdepends = rofi: rofi tab-switcher scripts
	optdepends = wmctrl: X11 window focusing (rofi-tabctl-wmctrl.sh)
	optdepends = hyprland: Wayland window focusing (rofi-tabctl-hyprland.sh)
	optdepends = jq: JSON parsing in the hyprland rofi script
	optdepends = curl: favicon fetching in the hyprland rofi script
	optdepends = imagemagick: favicon processing in the hyprland rofi script
	optdepends = firefox: Firefox browser support
	optdepends = brave-bin: Brave browser support
	optdepends = chromium: Chromium browser support
	optdepends = google-chrome: Chrome browser support
	options = !debug
	source = tabctl-2.2.1.tar.gz::https://github.com/slastra/tabctl/archive/v2.2.1.tar.gz
