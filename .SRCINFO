pkgbase = enclavedns
	pkgdesc = EnclaveDNS client: DNS through EnclaveDNS (DNSSEC validated in an attested enclave), and .eth sites in the browser
	pkgver = 0.1.3
	pkgrel = 1
	url = https://github.com/EnclaveHost/enclavedns-client
	install = enclavedns.install
	arch = x86_64
	arch = aarch64
