pkgbase = owbox
	pkgdesc = Stacking Wayland compositor based on Openbox, compatible with its config and themes (not Openbox itself)
	pkgver = 0.3.2
	pkgrel = 1
	url = https://github.com/SoleSoul/owbox
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	checkdepends = foot
	checkdepends = grim
	checkdepends = python-cairo
	makedepends = meson
	makedepends = wayland-protocols
	depends = wlroots0.20
	depends = libinput
	depends = libxkbcommon
	depends = pixman
	depends = glib2
	depends = libxml2
	depends = pango
	depends = cairo
	depends = librsvg
	depends = libsfdo
	depends = xcb-util-wm
	depends = wayland
	optdepends = xorg-xwayland: X applications
	optdepends = xdg-desktop-portal-wlr: screenshots and screen sharing
	optdepends = wireplumber: screen sharing (connects the streams)
	optdepends = xdg-desktop-portal-gtk: file choosers and other portals
	optdepends = python-gobject: owbox Settings
	optdepends = gtk4: owbox Settings
	optdepends = foot: a terminal emulator for the default menu
	optdepends = grim: screenshots (Print Screen)
	optdepends = slurp: screenshots of an area
	optdepends = wl-clipboard: screenshots copied to the clipboard
	optdepends = libpulse: the volume keys (pactl)
	optdepends = playerctl: the media keys
	optdepends = brightnessctl: the brightness keys
	optdepends = polkit-gnome: password prompts for administrator actions
	optdepends = swaylock: locking the screen
	optdepends = libnotify: the volume, brightness and screenshot notifications
	optdepends = swaybg: a wallpaper
	optdepends = waybar: the panels (see /usr/share/owbox/examples)
	optdepends = fuzzel: the launcher tapping Super shows
	optdepends = openbox: more themes
	backup = etc/xdg/owbox/rc.xml
	backup = etc/xdg/owbox/menu.xml
	backup = etc/xdg/owbox/autostart
	backup = etc/xdg/owbox/environment
