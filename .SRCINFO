	optdepends = mpv: Play generated scripts with mpv (default player)
	optdepends = vlc: Play generated scripts with VLC
	source = media-launcher::git+https://github.com/akoidan/media-launcher.git#branch=main
	sha256sums = SKIP

pkgname = media-launcher
