pkgbase = archive-utils
	pkgdesc = Safe, predictable archive extractor (x) and creator (c) built on bsdtar, GNU tar, 7-Zip and zip
	pkgver = 1.0.0
	pkgrel = 1
	url = https://src.panahifar.ir/ahp/archive-utils
	arch = x86_64
	arch = aarch64
	license = Unlicense
	checkdepends = 7zip
	checkdepends = binutils
	checkdepends = unzip
	checkdepends = zip
	makedepends = go
	depends = glibc
	depends = libarchive
	optdepends = 7zip: x for 7z, RAR and UDF ISO images; c for 7z
	optdepends = zip: c for zip
	optdepends = tar: c for tar archives (GNU tar)
	optdepends = gzip: x for .gz and .Z; c for tar.gz
	optdepends = bzip2: x for .bz2; c for tar.bz2
	optdepends = xz: x for .xz and .lzma; c for tar.xz
	optdepends = zstd: x for .zst; c for tar.zst
