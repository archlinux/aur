	optdepends = xorg-server-xvfb: run the browser when no X display is available
	optdepends = bubblewrap: sandbox agent shell commands when ASIDE_ENABLE_BWRAP_SANDBOX=1
	optdepends = libpulse: PulseAudio/PipeWire audio output (ALSA is used otherwise)
	optdepends = pciutils: GPU detection for hardware acceleration
	optdepends = qt5-base: Qt 5 UI integration
	optdepends = qt6-base: Qt 6 UI integration
	optdepends = python: run the Context Awareness capture helper
	optdepends = python-gobject: observe other apps for Context Awareness (AT-SPI bindings)
	optdepends = tesseract: on-device screen text (OCR) for Context Awareness
	optdepends = tesseract-data-eng: English OCR data for Context Awareness
	optdepends = grim: Wayland screenshots for Context Awareness screen text
