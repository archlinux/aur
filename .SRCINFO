pkgbase = explorenova-bin
	pkgdesc = Terminal file manager: git-annotated tree, previews, fuzzy search, vim keys (prebuilt)
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/Novaturiente/explorenova
	arch = x86_64
	license = GPL-3.0-or-later
	depends = gcc-libs
	depends = glibc
	depends = libgit2.so=1.9-64
	depends = libonig.so=5-64
	depends = tar
	depends = gzip
	depends = bzip2
	depends = xz
	depends = zstd
	depends = unzip
	optdepends = 7zip: extract .7z archives
	optdepends = poppler: PDF preview (pdftoppm)
	optdepends = libavif: AVIF image preview (avifdec)
	optdepends = ffmpegthumbnailer: video thumbnail preview
	optdepends = udiskie: devices modal mount/unmount/list
	optdepends = gvfs-smb: SMB network shares (gio mount)
	optdepends = perl-image-exiftool: EXIF tags in the footer metadata panel
	optdepends = ripgrep: content search (/ then Tab)
	optdepends = unrar: extract .rar archives
	optdepends = wl-clipboard: copy paths under Wayland (wl-copy)
	optdepends = xclip: copy paths under X11
	provides = explorenova
