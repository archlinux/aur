pkgbase = looking-glass-rc
	pkgdesc = An extremely low latency KVMFR (KVM FrameRelay) implementation for guests with VGA PCI Passthrough. (Candidate Version)
	pkgver = B8rc1
	pkgrel = 2
	epoch = 1
	url = https://looking-glass.io/
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = cmake
	makedepends = dkms
	makedepends = fontconfig
	makedepends = fuse3
	makedepends = libdecor
	makedepends = libegl
	makedepends = libelf
	makedepends = libpipewire
	makedepends = libpulse
	makedepends = libsamplerate
	makedepends = libunwind
	makedepends = libxi
	makedepends = libxinerama
	makedepends = libxpresent
	makedepends = libxrandr
	makedepends = libxss
	makedepends = obs-studio
	makedepends = simde
	makedepends = spice-protocol
	makedepends = usbredir
	makedepends = wayland-protocols
	source = looking-glass-B8-rc1.tar.gz::https://looking-glass.io/artifact/B8-rc1/source
	sha256sums = 8820a77c1a68f823be0c19dbcddb1c3a3e6a08a388925da81703665b7e79f971

pkgname = looking-glass-rc
	pkgdesc = A client application for accessing the LookingGlass IVSHMEM device of a VM
	depends = fontconfig
	depends = fuse3
	depends = glibc
	depends = gmp
	depends = hicolor-icon-theme
	depends = libdecor
	depends = libegl
	depends = libelf
	depends = libgcc
	depends = libgl
	depends = libpipewire
	depends = libpulse
	depends = libsamplerate
	depends = libstdc++
	depends = libunwind
	depends = libx11
	depends = libxcursor
	depends = libxfixes
	depends = libxi
	depends = libxinerama
	depends = libxkbcommon
	depends = libxpresent
	depends = libxrandr
	depends = libxss
	depends = nettle
	depends = usbredir
	depends = wayland
	provides = looking-glass
	conflicts = looking-glass
	options = !strip
	options = !debug

pkgname = looking-glass-rc-module-dkms
	pkgdesc = A kernel module that implements a basic interface to the IVSHMEM device for when using LookingGlass in VM->VM mode
	arch = any
	depends = dkms
	provides = looking-glass-module-dkms
	conflicts = looking-glass-module-dkms

pkgname = looking-glass-rc-host
	pkgdesc = Linux host application for pushing frame data to the LookingGlass IVSHMEM device
	depends = glib2
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = libpipewire
	depends = libunwind
	depends = libxcb
	provides = looking-glass-host
	conflicts = looking-glass-host

pkgname = obs-plugin-looking-glass-rc
	pkgdesc = Plugin for OBS Studio to stream directly from Looking Glass without having to record the Looking Glass client
	depends = glibc
	depends = libelf
	depends = libunwind
	depends = obs-studio
	provides = obs-plugin-looking-glass
	conflicts = obs-plugin-looking-glass
