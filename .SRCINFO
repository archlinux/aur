pkgname = sdrmm
	pkgdesc = Modular, client-server software-defined radio receiver (headless server)
	depends = gcc-libs
	depends = glibc
	optdepends = soapysdr: radios through SoapySDR modules
	optdepends = libsdrplay: SDRplay radios (SDRplay API, dlopened)
	optdepends = vulkan-icd-loader: GPU FFT (dlopened)
	conflicts = sdrmm-bin

pkgname = sdrmm-app
	pkgdesc = Modular, client-server software-defined radio receiver (desktop app)
	depends = cairo
	depends = dbus
	depends = gcc-libs
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = libsoup3
	depends = sdrmm
	depends = webkit2gtk-4.1
	optdepends = soapysdr: radios through SoapySDR modules
	optdepends = libsdrplay: SDRplay radios (SDRplay API, dlopened)
	optdepends = vulkan-icd-loader: GPU FFT (dlopened)
	conflicts = sdrmm-app-bin
	conflicts = sdrminusminus
