pkgbase = rubyripperremix-git
	pkgdesc = Secure audiodisc ripper with AccurateRip and CTDB verification (Fork of rubyripper)
	pkgver = 0.8.0rc4_0.2.0.r0.g519cb17
	pkgrel = 1
	url = https://github.com/Masterisk-F/RubyRipperRemix
	arch = any
	license = GPL-3.0-only
	makedepends = git
	depends = libcdio-paranoia
	depends = ruby
	depends = ruby-rexml
	depends = ruby-gtk3
	depends = ruby-gettext
	depends = ruby-parallel
	optdepends = cd-discid: Gnudb support
	optdepends = lame: MP3 encoding support
	optdepends = vorbis-tools: Ogg Vorbis encoding support
	optdepends = flac: FLAC encoding support
	optdepends = wavegain: WAV ReplayGain support
	optdepends = mp3gain: MP3 ReplayGain support
	optdepends = vorbisgain: Ogg Vorbis ReplayGain support
	optdepends = aacgain-cvs: AAC ReplayGain support
	optdepends = normalize: Normalization support
	optdepends = cdrdao: Advanced TOC analysis
	optdepends = sox: Correct pre-emphasis with sox
	optdepends = wavpack: WavPack encoding and ReplayGain support
	optdepends = opus-tools: Opus encoding support
	optdepends = neroaacenc-bin: Nero AAC encoding support
	optdepends = ctdb-cli: CUETools Database verification and sumittion support
	provides = rubyripperremix
	conflicts = rubyripperremix
	source = git+https://github.com/Masterisk-F/RubyRipperRemix.git
