	makedepends = pkgconf
	makedepends = rust
	depends = cairo
	depends = fontconfig
	depends = freetype2
	depends = glib2
	depends = libdisplay-info
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = python
	depends = seatd
	depends = systemd-libs
	depends = vulkan-icd-loader
	depends = wayland
