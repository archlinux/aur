pkgbase = tscsync
	pkgdesc = Pre-boot TSC sync for AMD (UEFI) so Linux keeps the TSC clocksource
	pkgver = 2.2.4
	pkgrel = 1
	url = https://github.com/Zanasin/tscsync
	install = tscsync.install
	arch = x86_64
	license = MIT
	makedepends = curl
	makedepends = binutils
	makedepends = gcc
	makedepends = make
	depends = bash
	depends = util-linux
	depends = systemd
	optdepends = sbsigntools: sign the EFI binary during tscsync-setup (needed if Secure Boot is on)
	optdepends = sbctl: enroll/sign with your Secure Boot keys
	optdepends = mokutil: detect Secure Boot / MOK state during setup
	conflicts = tscsync-git
	options = !strip
	options = !lto
	source = tscsync-2.2.4.tar.gz::https://github.com/Zanasin/tscsync/archive/refs/tags/v2.2.4.tar.gz
	source = 0001-arch-usr-paths.patch
	sha256sums = 503dec0d5db0524b1a0edd87e2589443e1c9191cccd012f4fae5a31385884b27
	sha256sums = 9e0d786982a803d3b46e54e005453b0dba6670d4c7f97ed00cc4f5761fe5c6d9

pkgname = tscsync
