pkgbase = synshell-core-git
	pkgdesc = synshell: synwm compositor, shell, login screen, on-screen keyboard, screenshots and screen sharing, settings, file manager, terminal, software center
	pkgver = 0.2.0.r0
	pkgrel = 1
	url = https://github.com/VitaminDB/synshell
	install = synshell-core.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cargo
	makedepends = rust
	makedepends = git
	makedepends = clang
	makedepends = pkgconf
	makedepends = fuse3
	depends = mesa
	depends = libinput
	depends = seatd
	depends = systemd-libs
	depends = libxkbcommon
	depends = libdrm
	depends = pixman
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = freetype2
	depends = ttf-font
	depends = breeze-icons
	depends = breeze-cursors
	depends = hicolor-icon-theme
	depends = dbus
	depends = pam
	depends = alsa-lib
	depends = ffmpeg
	depends = sqlite
	depends = libarchive
	depends = xdg-desktop-portal
	depends = pipewire
	depends = libpipewire
	depends = polkit
	optdepends = xorg-xwayland: X11 applications
	optdepends = wireplumber: volume control (wpctl)
	optdepends = sound-theme-freedesktop: freedesktop sound theme (event fallback)
	optdepends = brightnessctl: brightness
	optdepends = networkmanager: network applet
	optdepends = iwd: Wi-Fi (or networkmanager)
	optdepends = bluez: Bluetooth
	optdepends = playerctl: media keys
	optdepends = wl-clipboard: screenshots and paths to the clipboard
	optdepends = xdg-desktop-portal-kde: fallback file chooser portal
	optdepends = shared-mime-info: file types in the file manager
	optdepends = ffmpegthumbnailer: video thumbnails in the file manager
	optdepends = libheif: HEIC/HEIF/AVIF in the image viewer and thumbnails
	optdepends = imagemagick: rare image formats (JPEG XL, RAW…) in the image viewer
	optdepends = archlinux-appstream-data: categories, icons and screenshots in the software center
	optdepends = geoclue: location for applications (Maps, compass)
	optdepends = base-devel: building AUR packages in the software center
	optdepends = pacman-contrib: update checks without root (checkupdates)
	optdepends = udisks2: USB drives and disks in the file manager
	optdepends = gvfs-mtp: Android phones in the file manager (MTP)
	optdepends = gvfs-gphoto2: cameras in the file manager (PTP)
	optdepends = gvfs-afc: iPhone in the file manager
	optdepends = gvfs-smb: Windows and Samba shares in the file manager
	optdepends = git: git status in the file manager
	optdepends = fuse3: archives as folders; files of linked devices
	optdepends = intel-media-driver: hardware video on Intel
	optdepends = libva-mesa-driver: hardware video on AMD
	optdepends = nvidia-utils: NVIDIA driver (NVENC, neural networks on the GPU)
	provides = synshell-core
	provides = syndesktop
	conflicts = synshell-core
	conflicts = synshell-core-bin
	conflicts = syndesktop
	replaces = syndesktop
	options = !lto
	source = synshell::git+https://github.com/VitaminDB/synshell.git
	sha256sums = SKIP

pkgname = synshell-core-git
