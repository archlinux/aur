pkgbase = wallpiper-git
	pkgver = r0.0000000
	pkgrel = 1
	url = https://github.com/shdwmtr/wallpiper
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = dbus
	makedepends = vulkan-headers
	makedepends = wayland
	makedepends = wayland-protocols
	makedepends = libxcb
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = mesa
	makedepends = libx11
	makedepends = libxrandr
	makedepends = libdrm
	makedepends = mutter
	makedepends = gobject-introspection
	source = wallpiper-git::git+https://github.com/shdwmtr/wallpiper.git
	sha256sums = SKIP

pkgname = wallpiper-git
	pkgdesc = Native translation layer for Wallpaper Engine on Linux
	depends = dbus
	depends = wayland
	depends = libxcb
	optdepends = fontconfig: local font overrides for Wallpaper Engine content
	optdepends = proton: required to run wallpaper64.exe under Wallpaper Engine
	optdepends = wallpiper-gnome-git: GNOME (Mutter) portal
	optdepends = wallpiper-kde-git: KDE Plasma portal
	provides = wallpiper
	conflicts = wallpiper

pkgname = wallpiper-gnome-git
	pkgdesc = GNOME (Mutter) portal for wallpiper
	install = wallpiper-gnome-git.install
	depends = wallpiper-git
	depends = mutter
	depends = gobject-introspection
	depends = gnome-shell
	depends = mesa
	depends = libdrm
	depends = libxrandr
	depends = libx11
	provides = wallpiper-gnome
	conflicts = wallpiper-gnome

pkgname = wallpiper-kde-git
	pkgdesc = KDE Plasma 6 portal for wallpiper
	install = wallpiper-kde-git.install
	depends = wallpiper-git
	depends = qt6-base
	depends = qt6-declarative
	depends = mesa
	depends = libx11
	depends = libxrandr
	provides = wallpiper-kde
	conflicts = wallpiper-kde
