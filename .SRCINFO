pkgbase = solana
	pkgver = 3.1.14
	pkgrel = 1
	epoch = 1
	url = https://github.com/anza-xyz/agave
	arch = x86_64
	license = Apache-2.0
	makedepends = git
	makedepends = protobuf
	makedepends = clang
	makedepends = curl
	makedepends = cargo
	makedepends = systemd-libs
	options = !lto
	source = git+https://github.com/anza-xyz/agave.git#tag=v3.1.14
	source = git+https://github.com/solana-program/token-2022.git#tag=cli@v5.5.0
	source = solana.sysusers
	source = solana.tmpfiles
	source = solana-sbf_sdk-path.patch
	sha256sums = f2a1d0d54f558bce7b17fa399c246767a41482ccac85a6fe137b155bfb531798
	sha256sums = a9a0f6e495f68a77e61ce44a39bed42608bd3afd6aa5ddf09e124b50e17d41a6
	sha256sums = bf7e015436e3d15e70fc67f323bbd04163f79a4de7d06a254a5409bd031227b0
	sha256sums = a0f9ee2a24ab97da977eed1dd68a92165c2f2e6d5467462fe83c762031f4e02b
	sha256sums = f2251e4057350ec795d6ea5402cffbaa5678883996e68ba8688c3f250cb9a173

pkgname = solana-cli
	pkgdesc = Solana CLI tools
	depends = glibc
	depends = libgcc
	depends = systemd-libs
	provides = spl-token
	conflicts = spl-token

pkgname = agave-validator
	pkgdesc = Agave validator and node operator tools for Solana
	depends = bzip2
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = ocl-icd: OpenCL GPU signature verification via perf-libs (requires compatible GPU; opt-in via SOLANA_PERF_LIBS)
	optdepends = intel-sgx-psw: SGX-backed signing enclave via perf-libs (requires SGX-capable CPU; opt-in via SOLANA_PERF_LIBS)

pkgname = solana-dev
	pkgdesc = Solana program developer tools
	install = solana-dev.install
	depends = bash
	depends = bzip2
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = cargo: required for cargo-build-sbf and cargo-test-sbf
	conflicts = solana-dev-bin

pkgname = solana
	pkgdesc = A fast, secure, and censorship resistant blockchain (meta package)
	arch = any
	depends = solana-cli
	depends = agave-validator
	depends = solana-dev
