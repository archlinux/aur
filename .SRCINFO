pkgbase = alps-pm
	pkgdesc = A unified frontend for Linux package managers (Advanced Linux Package System)
	pkgver = 1.0.4
	pkgrel = 1
	url = https://github.com/adrianpriza-ai/alps
	arch = x86_64
	arch = aarch64
	arch = armv7h
	license = MIT
	makedepends = go
	depends = pacman
	optdepends = git: required for AUR makepkg fallback
	optdepends = base-devel: required for AUR makepkg fallback
	optdepends = yay: preferred AUR helper
	optdepends = coreutils: alps-more entries (mkdir, cp, chmod, gzip, ln)
	optdepends = tar: alps-more entries using .tar.gz/.tar.xz/.tar.bz2 archives
	optdepends = unzip: alps-more entries using .zip archives
	optdepends = bash: running alps-more entry scripts
	optdepends = fakeroot: alps-more entries requiring fakeroot
	optdepends = systemd: alps-more entries managing systemd services
	optdepends = shadow: alps-more entries using useradd/userdel
	conflicts = alps
	source = alps-pm-1.0.4.tar.gz::https://github.com/adrianpriza-ai/alps/archive/v1.0.4.tar.gz
	sha256sums = bb218f9edf89022ae52ed40f5c2b95849431f4b73461cef5ac88a53498bea97a

pkgname = alps-pm
