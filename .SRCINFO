pkgbase = playy-bin
	pkgdesc = Music player for the terminal: your music folder and YouTube Music in one library, offline or online (prebuilt)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/sambuaneesh/playy
	arch = x86_64
	license = MIT
	depends = mpv
	depends = yt-dlp
