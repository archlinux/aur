	depends = glibc
	depends = sqlite
	depends = zlib
	depends = xz
	depends = openssl
	depends = hicolor-icon-theme
	optdepends = wl-clipboard: paste images from clipboard on Wayland
	optdepends = xclip: paste images from clipboard on X11
	optdepends = deepin-screen-recorder: Screenshot without/with Zalo window button
	optdepends = spectacle: Screenshot without/with Zalo window button
	optdepends = flameshot: Screenshot without/with Zalo window button
	optdepends = gnome-screenshot: Screenshot without/with Zalo window button
	optdepends = xfce4-screenshooter: Screenshot without/with Zalo window button
	optdepends = mate-screenshot: Screenshot without/with Zalo window button
	optdepends = scrot: Screenshot without/with Zalo window button
	optdepends = wine: Voice/Video call engine support (or download portable wine in-app)
	optdepends = v4l-utils: control camera formats (fix inverted/green camera)
	optdepends = v4l2loopback-dkms: loopback camera support
	optdepends = xorg-server-xvfb: headless X server for Wayland screen-sharing bridge
	optdepends = python-dbus: required by the Wayland screen-sharing bridge (zcall-bridge/screenbridge.py)
	optdepends = xdotool: window resizing for screen bridge display
	optdepends = gst-plugins-base: 64-bit GStreamer plugins (ximagesink) for screen bridge
	optdepends = gst-plugins-bad: 64-bit GStreamer plugins (pipewiresrc) for screen bridge
	optdepends = python-gobject: required by the Wayland screen-sharing bridge (zcall-bridge/screenbridge.py)
	optdepends = lib32-glibc: 32-bit runtime for the Wayland screen-share shim (zcall-bridge/streamproxy.so, pulled in by wine)
	optdepends = lib32-libx11: 32-bit X11 for the Wayland screen-share shim (pulled in by wine)
	optdepends = lib32-libxcb: 32-bit XCB for the Wayland screen-share shim (pulled in by wine)
	provides = zalo
	conflicts = zalo
	conflicts = zalo-for-linux-bin
