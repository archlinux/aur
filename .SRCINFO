pkgbase = python-pydantic-monty
	pkgver = 1.3.0
	pkgrel = 1
	arch = x86_64
	arch = aarch64
	license = MIT
	checkdepends = python-anyio
	checkdepends = python-dirty-equals
	checkdepends = python-inline-snapshot
	checkdepends = python-opentelemetry-sdk
	checkdepends = python-pytest
	checkdepends = python-pytest-examples
	checkdepends = python-websockets
	makedepends = python-maturin
	makedepends = python-hatchling
	makedepends = python-build
	makedepends = python-installer
	depends = python
	options = !lto
	source = https://github.com/pydantic/monty/archive/refs/tags/v1.3.0.tar.gz
	sha256sums = 5c93326721e2ea8119a666260345e65763ee718e28bc43809333a0e455f4ae63

pkgname = python-pydantic-monty-client
	pkgdesc = Python client for the Monty sandboxed Python interpreter.
	url = https://github.com/pydantic/monty/tree/main/crates/monty-python
	depends = python
	depends = python-typing_extensions
	depends = glibc
	depends = libgcc
	optdepends = python-opentelemetry-api: opentelemetry

pkgname = python-pydantic-monty-runtime
	pkgdesc = The monty CLI binary — spawned as worker subprocesses by pydantic-monty.
	url = https://github.com/pydantic/monty/tree/main/crates/monty-runtime
	depends = glibc
	depends = libgcc

pkgname = python-pydantic-monty
	pkgdesc = The Monty sandboxed Python interpreter: bindings plus the worker binary.
	url = https://github.com/pydantic/monty/tree/main/packages/pydantic-monty
	arch = any
	depends = python
	depends = python-pydantic-monty-client
	depends = python-pydantic-monty-runtime
	optdepends = python-opentelemetry-api: opentelemetry
