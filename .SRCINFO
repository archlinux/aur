pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.56
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.56-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.56-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.56-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.56-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.56-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.56-1-x86_64.pkg.tar.zst
	sha256sums = e5e6b0eba600fa7462f107094bf9ce4ef413228ced9913ef8d2e9884a538c7e9
	sha256sums = f35ab3a57819b8eabe38e9a3b076f5d2ba0360524e861ae7e48485d9b11ece28
	sha256sums = c14ccba6a58209f2ce006d3549589250b5068a3c22b0282c2714626694daba57

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.56-1-lts-bin
	depends = linux6.18.56-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.56-1-lts-headers-bin
	depends = linux6.18.56-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.56-1-lts-docs-bin
	depends = linux6.18.56-1-lts-docs-bin

pkgname = linux6.18.56-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.56-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.56-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.56-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.56-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.56-1-lts
	conflicts = linux-lts-docs
