	depends = hicolor-icon-theme
	optdepends = git: repository management, synchronization and status badges
	optdepends = samba: authenticated folder sharing in Properties
	optdepends = udisks2: mounting disk images (ISO, IMG, SquashFS, ...) from the context menu
	optdepends = qemu-img: mounting qcow2, VMDK, VDI, VHD and VHDX images (qemu-nbd)
	optdepends = python-cryptography: standalone vault recovery tool
	optdepends = qt6-wayland: Wayland desktop sessions
	optdepends = qt6-imageformats: additional image formats
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = poppler: PDF thumbnails
	optdepends = 7zip: additional archive extraction formats
	optdepends = libarchive: creating ZIP, 7z and tar archives
	optdepends = squashfs-tools: AppImage icon previews
	optdepends = mkvtoolnix-cli: Matroska subtitle extraction
	optdepends = python: optional AI subtitle workers
	optdepends = python-pip: installing optional AI worker dependencies in the user cache
	optdepends = python-certifi: optional subtitle worker HTTPS support
	optdepends = python-numpy: optional subtitle worker audio processing
	optdepends = python-pillow: optional media worker artwork processing
	optdepends = breeze-icons: fallback icon theme
	optdepends = kio-extras: additional network and filesystem protocols
	optdepends = kio-admin: authenticated administrator locations
	optdepends = polkit: administrator authentication for file ownership and permissions
