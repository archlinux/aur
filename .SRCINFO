pkgbase = kcd
	pkgdesc = Lightweight, headless implementation of the KDE Connect protocol (v8) written in Go

	pkgver = 1.22.0
	pkgrel = 1
	url = https://github.com/bethropolis/kcd
	arch = aarch64
	arch = x86_64
	license = MIT
	options = !strip !debug
	optdepends = libnotify: for desktop notifications
	optdepends = wl-clipboard: for Wayland clipboard sync
	optdepends = xclip: for X11 clipboard sync
	optdepends = sshfs: for SFTP mounting support
	optdepends = python-nautilus: for Nautilus file manager integration
	optdepends = ydotool: for Wayland mousepad support
	optdepends = xdotool: for X11 mousepad support
	optdepends = wtype: for Wayland keyboard emulation
	depends = glibc
	makedepends = go
	conflicts = kcd-bin
	provides = kcd
	
	source = kcd_1.22.0.tar.gz::https://github.com/bethropolis/kcd/releases/download/v1.22.0/kcd-1.22.0.tar.gz
	sha256sums = f5de8d4b787bb13593edee80a61c4bc5596ca62bb46e8df4d09a9a82ae2e2071
	
pkgname = kcd
