	depends = ensenso-sdk-runtime
	depends = ensenso-sdk-gui
	optdepends = ensenso-sdk-examples: for coding examples
	optdepends = ensenso-sdk-doc: for documentation
	optdepends = ensenso-sdk-halcon: for halcon support

