pkgname = linux-cachyos-bore-native
	pkgdesc = The Linux BORE + Cachy Sauce scheduler Kernel by CachyOS with other patches and improvements kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE

pkgname = linux-cachyos-bore-native-headers
	pkgdesc = Headers and scripts for building modules for the Linux BORE + Cachy Sauce scheduler Kernel by CachyOS with other patches and improvements kernel
	depends = pahole
	depends = linux-cachyos-bore-native

pkgname = linux-cachyos-bore-native-nvidia-open
	pkgdesc = nvidia open modules of 590.48.01 driver for the linux-cachyos-bore-native kernel
	license = MIT AND GPL-2.0-only
	depends = linux-cachyos-bore-native=6.19.0-1
	depends = nvidia-utils=590.48.01
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-cachyos-bore-native-nvidia
