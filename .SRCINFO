pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.22
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.22-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.22-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.22-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.22-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.22-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.22-1-x86_64.pkg.tar.zst
	sha256sums = abc4bd066ad721f97b0d1f101397e022d5c8aa8d8932293444a0b5909917e422
	sha256sums = 0544b1b7df525292e7c83d325ccd593fc9568c5cf2b163c2e01653a6dec35e44
	sha256sums = f197d3a4773fa4d70fd5a9738895d1b95d1afc0e3c328bb2cddc90f5fe6f64a8

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.22-1-lts-bin
	depends = linux6.18.22-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.22-1-lts-headers-bin
	depends = linux6.18.22-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.22-1-lts-docs-bin
	depends = linux6.18.22-1-lts-docs-bin

pkgname = linux6.18.22-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.22-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.22-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.22-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.22-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.22-1-lts
	conflicts = linux-lts-docs
