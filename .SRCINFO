pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.16.1.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.16.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.16.1.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.16.1.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.16.1.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.16.1.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.16.1.arch1-1-x86_64.pkg.tar.zst
	sha256sums = cf2d09ccf78b2c2bd405da270f9a710e65d232b19b9ea56d17d73abe14d7e0bc
	sha256sums = 03ded92e972e46c45a77bff74a7d5d6bbd8646da662a350bcc29791724497dd7
	sha256sums = 2e3aeb6cf64190107f201b0f9e887f4f82a39d90091be57bb5f1e72ed3a1b51b

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.16.1.arch1-1-bin
	depends = linux6.16.1.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.16.1.arch1-1-headers-bin
	depends = linux6.16.1.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.16.1.arch1-1-docs-bin
	depends = linux6.16.1.arch1-1-docs-bin

pkgname = linux6.16.1.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.16.1-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.16.1.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.16.1-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.16.1.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.16.1-arch1-1
	conflicts = linux-docs
