pkgbase = electron32-bin
	pkgdesc = Build cross platform desktop apps with web technologies — prebuilt
	pkgver = 32.0.0.alpha.1
	pkgrel = 1
	url = https://electronjs.org
	arch = aarch64
	arch = armv7h
	arch = x86_64
	license = MIT
	license = LicenseRef-custom
	depends = alsa-lib
