pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.9.arch1-1-bin
	depends = linux6.12.9.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.9.arch1-1-headers-bin
	depends = linux6.12.9.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.9.arch1-1-docs-bin
	depends = linux6.12.9.arch1-1-docs-bin

pkgname = linux6.12.9.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.12.9-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.12.9.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.12.9-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.12.9.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.12.9-arch1-1
	conflicts = linux-docs
