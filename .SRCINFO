pkgbase = matuwall-bin
	pkgdesc = Fast and lightweight wallpaper picker for Wayland
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/naurissteins/Matuwall
	arch = x86_64
	license = GPL-3.0-or-later
