pkgbase = linux-hardened-versioned-bin
	pkgdesc = The Security-Hardened Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 7.1.4.hardened1
	pkgrel = 1
	url = https://github.com/anthraxx/linux-hardened
	arch = x86_64
	license = GPL2
	noextract = linux-hardened-7.1.4.hardened1-1-x86_64.pkg.tar.zst
	noextract = linux-hardened-headers-7.1.4.hardened1-1-x86_64.pkg.tar.zst
	noextract = linux-hardened-docs-7.1.4.hardened1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-hardened-7.1.4.hardened1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-hardened-headers-7.1.4.hardened1-1-x86_64.pkg.tar.zst
