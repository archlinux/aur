pkgbase = azerothcore-wotlk-git
	pkgdesc = AzerothCore - MMORPG Server - continuous build from master branch
	pkgver = placeholder
	pkgrel = 1
	url = http://www.azerothcore.org
	install = azerothcore-wotlk-git.install
	arch = x86_64
	license = AGPL3
	makedepends = git
	makedepends = cmake
	makedepends = clang
	makedepends = boost
	makedepends = openssl
	makedepends = lld
	depends = boost-libs
	depends = readline
	depends = openssl
	provides = azerothcore
	conflicts = azerothcore
	options = !lto
	options = !debug
	options = strip
	backup = etc/azerothcore/authserver.conf
	backup = etc/azerothcore/worldserver.conf
	source = git+https://github.com/azerothcore/azerothcore-wotlk.git#branch=master
	source = acore-auth-server.service
	source = acore-world-server.service
	sha512sums = SKIP
	sha512sums = SKIP
	sha512sums = SKIP

pkgname = azerothcore-wotlk-git
