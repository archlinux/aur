pkgbase = arctis-sound-manager
	pkgdesc = Linux GUI for SteelSeries Arctis headsets — all GG/Sonar features: mixer, EQ, ANC, mic processing, surround
	pkgver = 1.6.3
	pkgrel = 1
	url = https://github.com/loteran/Arctis-Sound-Manager
	install = arctis-sound-manager.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = python-installer
	makedepends = uv
	makedepends = python-ruamel-yaml
	depends = python>=3.10
	depends = pyside6
	depends = qt6-svg
	depends = python-babel
	depends = python-pillow
	depends = python-pyudev
	depends = python-pyusb
	depends = python-ruamel-yaml
	depends = pipewire
	depends = pipewire-pulse
	depends = wireplumber
	depends = libusb
	depends = libpulse
	depends = python-dbus-next
	depends = python-pulsectl
	depends = curl
	depends = swh-plugins
	optdepends = noise-suppression-for-voice: RNNoise mic noise cancellation (ClearCast), from the signed pacman repo
	optdepends = noise-suppression-for-voice-git: RNNoise mic noise cancellation (ClearCast), from the AUR
	optdepends = python-gobject: clip capture (Gst/Gio bindings)
	optdepends = gstreamer: clip capture
	optdepends = gst-plugin-pipewire: clip capture — pipewiresrc, the portal screen stream
	optdepends = gst-plugins-base: clip capture — appsrc, audioconvert/audioresample, opusenc
	optdepends = gst-plugins-good: clip capture — pulsesrc, matroskamux
	optdepends = gst-plugins-bad-libs: clip capture — h264parse, after every encoder
	optdepends = gst-plugins-ugly: clip capture — x264enc, the software encoder fallback
	optdepends = ffmpeg: clip thumbnails, track levels and export
	optdepends = gst-plugin-va: hardware H.264 encoding on Intel/AMD GPUs
	optdepends = gst-plugins-bad: hardware H.264 encoding on NVIDIA GPUs (nvcodec)
	source = arctis-sound-manager-1.6.3.tar.gz::https://github.com/loteran/Arctis-Sound-Manager/releases/download/v1.6.3/arctis-sound-manager-1.6.3.tar.gz
