pkgbase = waymobar
	pkgdesc = Wayland status bar written and configured in Haskell, with rivermonad widgets
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/prietus/waymobar
	arch = x86_64
	arch = aarch64
	license = BSD-3-Clause
	depends = ghc
	depends = ghc-libs
	depends = haskell-network
	depends = cairo
	depends = pango
	depends = glib2
	depends = gdk-pixbuf2
	depends = libpulse
	optdepends = rivermonad: workspaces, layout and window title widgets
	optdepends = curl: weather and calendar widgets
	optdepends = ttf-nerd-fonts-symbols: icons
	optdepends = ttf-material-symbols-variable: icons (the ones of rivermonad-dotfiles)
	optdepends = libnotify: notifications when the configuration fails to compile
	source = waymobar-0.2.0.tar.gz::https://github.com/prietus/waymobar/archive/v0.2.0.tar.gz
	sha256sums = 201d0fe9b91a8523f1d325b7ab6eb0e81680cec166259b4575de785a0e30e301

pkgname = waymobar
