pkgbase = mkinitcpio-mercurio
	pkgdesc = mkinitcpio hook that sends a notification through mercurio on each boot
	pkgver = 1.0.0
	pkgrel = 1
	url = https://gitlab.archlinux.org/alphajack/mkinitcpio-mercurio
	install = mkinitcpio-mercurio.install
	arch = any
	license = GPL-3.0-or-later
	depends = bash
	depends = mkinitcpio
	depends = mercurio
	optdepends = mkinitcpio-systemd-extras: network connectivity (systemd initrd)
	optdepends = mkinitcpio-netconf: network connectivity (busybox initrd)
	backup = etc/mercurio/initcpio.conf
	source = mkinitcpio-mercurio-1.0.0.tar.gz::https://gitlab.archlinux.org/alphajack/mkinitcpio-mercurio/-/archive/v1.0.0/mkinitcpio-mercurio-v1.0.0.tar.gz
