	conflicts = ollama-cuda
	conflicts = ollama-cuda12
	conflicts = ollama-vulkan

pkgname = ollama-mlx-cuda13-bin
	pkgdesc = Create, run and share large language models (LLMs) with MLX CUDA 13 (Image Generation)
