pkgname = linux-rt-lts61
	pkgdesc = The LTS Linux with realtime patches kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = wireguard-lts

pkgname = linux-rt-lts61-headers
	pkgdesc = Headers and scripts for building modules for the LTS Linux with realtime patches kernel
	depends = pahole

pkgname = linux-rt-lts61-docs
	pkgdesc = Documentation for the LTS Linux with realtime patches kernel
