pkgbase = tonepush-git
	pkgdesc = Editor and tone library for Line 6 HX pedals and the StompStation PRO
	pkgver = 0.6.0.r0.3abcf23
	pkgrel = 1
	url = https://tonepush.rocks
	install = tonepush-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = libxkbcommon
	makedepends = wayland
	makedepends = mesa
	optdepends = libgl: for the GUI
	optdepends = libxkbcommon: for the GUI
	optdepends = wayland: for the GUI on Wayland
	optdepends = libx11: for the GUI on X11
	optdepends = p7zip: extract HX Edit model data from inside the app
	provides = tonepush
	conflicts = tonepush
	conflicts = stompchain-git
	conflicts = tonepush-bin
	replaces = stompchain-git
	options = !debug
	options = !lto
	source = tonepush-git::git+https://github.com/crmne/tonepush.git
	sha256sums = SKIP

pkgname = tonepush-git
