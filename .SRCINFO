	optdepends = qt6-webengine: pdf previews
	optdepends = gvfs: network shares and the trash on removable drives
	optdepends = udisks2: the devices sidebar
	optdepends = polkit: retry denied operations as administrator
	optdepends = xdg-desktop-portal: use dfiles as the file chooser
