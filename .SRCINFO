pkgname = openresearch
	pkgdesc = Automated research with coding agents (desktop, built from source)
	depends = bash
	depends = glibc
	depends = gcc-libs
	depends = gtk3
	depends = webkit2gtk-4.1
	depends = sqlite
	depends = ca-certificates
	depends = hicolor-icon-theme
	optdepends = openresearch-cli: standalone headless orx command
	optdepends = git: local project version control
	conflicts = openresearch-bin

pkgname = openresearch-cli
	pkgdesc = Automated research with coding agents (headless CLI, built from source)
	depends = glibc
	depends = gcc-libs
	depends = sqlite
	depends = ca-certificates
	optdepends = git: local project version control
	optdepends = openssh: remote compute over SSH
	conflicts = openresearch-cli-bin

pkgname = openresearch-bin
	pkgdesc = Automated research with coding agents (desktop, upstream binary)
	depends = bash
	depends = glibc
