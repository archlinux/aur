pkgbase = kiri-desktop-bin
	pkgdesc = Tiny, fast container runtime speaking the Docker API (with GUI and bundled docker CLI, Compose, buildx)
	pkgver = 0.2.0
	pkgrel = 1
	url = https://runkiri.com
	install = kiri-desktop-bin.install
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	depends = cairo
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = harfbuzz
	depends = icu
	depends = libepoxy
	depends = libgcc
	depends = libjpeg-turbo
	depends = libpng
	depends = libwebp
	depends = libxml2
	depends = libxslt
	depends = pango
	depends = polkit
	depends = sqlite
	depends = systemd-libs
	depends = webkit2gtk-4.1
	depends = zlib
	optdepends = docker: system docker CLI (preferred over the bundled one when installed)
	optdepends = docker-compose: system Compose plugin (preferred over the bundled one)
	optdepends = docker-buildx: system buildx plugin (preferred over the bundled one)
	conflicts = kiri-git
	conflicts = kiri-bin
	conflicts = kiri-lite-bin
	conflicts = kiri-desktop-lite-bin
