	makedepends = gcc
	makedepends = just
	makedepends = cmake
	makedepends = ninja
	makedepends = extra-cmake-modules
	makedepends = vulkan-headers
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-shadertools
	depends = kcoreaddons
	depends = kdbusaddons
	depends = ki18n
	depends = kirigami
	depends = prison
	depends = qqc2-desktop-style
	depends = kirigami-addons
	depends = rlottie
	depends = sqlite
	depends = glibc
	depends = desktop-file-utils
	depends = shared-mime-info
	depends = xdg-utils
	provides = whatevr
	provides = whatevrd
	provides = whatkevr
	conflicts = whatevr
	conflicts = whatevr-bin
