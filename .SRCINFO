pkgbase = typeladder
	pkgdesc = Adaptive typing test: builds your vocabulary from the commonest word to the rarest, for any keyboard, steno engine or text expander
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/noahlyk/typeladder
	install = typeladder.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = gcc-libs
	optdepends = espanso: a text expander the hooks can pause during a test
	optdepends = keymux: a steno engine (the lyk theory exports its dictionary for typeladder)
	options = !debug
	options = !lto
	source = LICENSE::https://raw.githubusercontent.com/noahlyk/typeladder/v0.1.0/LICENSE
	source = NOTICE::https://raw.githubusercontent.com/noahlyk/typeladder/v0.1.0/NOTICE
