pkgbase = domicile-bin
	pkgdesc = A Wayland compositor whose renderer is a web engine. Installs the `domicile` login session, the engine, the manganese and simple shells, the PAM service the lock uses and the `domicile` group.
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/cprussin/domicile
	install = domicile.install
	arch = x86_64
	license = MIT AND BSD-3-Clause
	depends = glibc>=2.34
	depends = gcc-libs
	depends = glib2
	depends = nss
	depends = nspr
	depends = at-spi2-core
	depends = dbus
	depends = libcups
	depends = expat
	depends = libxkbcommon
	depends = alsa-lib
	depends = mesa
	depends = systemd-libs
	depends = libinput
	depends = cairo
	depends = pango
	depends = pipewire
	depends = libglvnd
	depends = wayland
	depends = pam
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gst-plugin-pipewire
	depends = systemd
	optdepends = upower: the battery readout
	optdepends = rtkit: smooth drawing while the machine is busy, without the domicile group
	optdepends = hwdata: monitor makers' names
	optdepends = libpulse: pactl, for the volume readout
	optdepends = curl: bookmark icons and the captive portal check
	optdepends = xdg-desktop-portal: portals for apps
	optdepends = gsettings-desktop-schemas: the engine's GSettings schemas, without which it logs errors
	optdepends = networkmanager: Miracast casts to TVs over Wi-Fi Direct
	optdepends = avahi: Miracast casts to TVs on the LAN
	optdepends = gst-plugins-bad: Miracast casts, and screen recordings encoded on the GPU
	optdepends = gst-plugins-ugly: Miracast casts without a hardware H.264 encoder
	optdepends = gst-libav: sound in Miracast casts
	provides = domicile
	conflicts = domicile
	noextract = domicile-1.0.0-1-x86_64.pkg.tar.zst
	backup = etc/pam.d/domicile
	backup = etc/security/limits.d/10-domicile.conf
	source = domicile-1.0.0-1-x86_64.pkg.tar.zst::https://packages.domicile-desktop.com/arch/x86_64/domicile-1.0.0-1-x86_64.pkg.tar.zst
	sha256sums = 70534a32f4bcdfb10bdde3e33dbe45152f05fc5bdd4f9dcae81e31b2957b3efc

pkgname = domicile-bin
