pkgbase = uu-remote-linux
	pkgdesc = Unofficial Linux host for NetEase UU Remote (remote desktop)
	pkgver = 0.2.20
	pkgrel = 1
	url = https://github.com/VallierDev/uu-remote-linux
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = pkgconf
	depends = ffmpeg
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = libei
	depends = libpipewire
	depends = libx11
	depends = libxext
	depends = libxfixes
	depends = libxkbcommon
	depends = libxtst
	depends = sdl2
	depends = wayland
	optdepends = hyprland: native Hyprland backend (hyprctl)
	optdepends = libayatana-appindicator: tray icon on GNOME
	optdepends = pciutils: GPU detection when choosing an encoder
	optdepends = wl-clipboard: clipboard integration on Wayland
	optdepends = xclip: clipboard integration on X11
	optdepends = xsel: clipboard integration on X11 (alternative to xclip)
	optdepends = xdg-desktop-portal: screen capture and input on Wayland
	optdepends = xdg-desktop-portal-gnome: GNOME Wayland capture and input backend
	optdepends = xdg-desktop-portal-kde: KDE Wayland capture and input backend
	options = !lto
