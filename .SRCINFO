pkgbase = solara-installer
	pkgdesc = Solara Linux GUI installer (Qt 6 + Rust)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/celestia-foundation/solara
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = pkgconf
	makedepends = ninja
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = qt6-tools
	options = !strip
	options = !debug
	options = !lto
	source = https://github.com/celestia-foundation/solara/archive/refs/heads/main.tar.gz
	b2sums = SKIP

pkgname = solara-installer
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-svg
	depends = arch-install-scripts
	depends = parted
	depends = util-linux
	depends = btrfs-progs
	depends = e2fsprogs
	depends = xfsprogs
	depends = f2fs-tools
	depends = dosfstools
	depends = polkit
	depends = networkmanager
	depends = grub
