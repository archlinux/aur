pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.57
	pkgrel = 2
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.57-2-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.57-2-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.57-2-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.57-2-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.57-2-x86_64.pkg.tar.zst
