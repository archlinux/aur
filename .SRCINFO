pkgbase = image-colorizer
	pkgdesc = Snap an image to a colorscheme extremely quickly
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/TaylorBeeston/image-colorizer
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = vulkan-headers
	depends = gcc-libs
	depends = vulkan-icd-loader
	optdepends = mesa: for OpenGL and Vulkan support on Intel and AMD GPUs
	optdepends = nvidia-utils: for Vulkan support on NVIDIA GPUs
	optdepends = vulkan-intel: for Vulkan support on Intel GPUs
	optdepends = vulkan-radeon: for Vulkan support on AMD GPUs
	optdepends = wgpu-git: WebGPU implementation (AUR)
