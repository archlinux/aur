pkgbase = cordial-git
	pkgdesc = Roblox's official Android build, run natively on Linux -- Cordial ships no Roblox code and fetches a signature-verified one
	pkgver = 0.25.0.r3.g94c4b97
	pkgrel = 1
	url = https://github.com/luohoa97/cordial
	install = cordial-git.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	makedepends = clang
	makedepends = pkgconf
	makedepends = libpipewire
	makedepends = libpulse
	makedepends = alsa-lib
	makedepends = boost
	makedepends = lld
	makedepends = llvm
	makedepends = vulkan-headers
	depends = gtk4
	depends = libadwaita
	depends = webkitgtk-6.0
	depends = zlib
	depends = glib2
	depends = pango
	depends = graphene
	depends = libsoup3
	depends = libgcc
	depends = libstdc++
	depends = glibc
	depends = vulkan-icd-loader
	depends = wayland
	depends = libxkbcommon
	depends = libglvnd
	depends = pipewire
	depends = hicolor-icon-theme
	depends = deno
	optdepends = bubblewrap: kernel sandbox under the plugin runtime
	optdepends = libx11: X11 session fallback
	optdepends = libxinerama: CORDIAL_MONITOR monitor selection under X11
	optdepends = sober: its Roblox build can be imported into Cordial (Cordial downloads its own)
	provides = cordial
	conflicts = cordial
	conflicts = cordial-bin
	options = !lto
	source = cordial::git+https://github.com/luohoa97/cordial.git
	source = mcpelauncher-linker::git+https://github.com/minecraft-linux/mcpelauncher-linker.git
	source = android_bionic::git+https://github.com/minecraft-linux/android_bionic.git
	source = android_core::git+https://github.com/minecraft-linux/android_core.git
	source = libjnivm::git+https://github.com/ChristopherHX/libjnivm.git
	source = dynarmic::git+https://github.com/azahar-emu/dynarmic.git
	source = dynarmic-fmt::git+https://github.com/fmtlib/fmt.git
	source = dynarmic-mcl::git+https://github.com/azahar-emu/mcl.git
	source = dynarmic-robin-map::git+https://github.com/Tessil/robin-map.git
	source = dynarmic-xbyak::git+https://github.com/herumi/xbyak.git
	source = dynarmic-zydis::git+https://github.com/zyantific/zydis.git
	source = dynarmic-zycore::git+https://github.com/zyantific/zycore-c.git
