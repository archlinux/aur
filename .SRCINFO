pkgbase = octa-term
	pkgdesc = 终端无感数学计算：把 shell 输入行变成 Octave 计算器（fish/bash/zsh 集成）
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/cublueer/octa-term
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = octave
	depends = gcc-libs
	depends = glibc
	optdepends = fish: fish shell integration (Enter 劫持、多行矩阵、自动续行)
	optdepends = bash: bash shell integration (单行兜底)
	optdepends = zsh: zsh shell integration (单行兜底)
	options = !lto
	options = !debug
	source = octa-term::git+https://github.com/cublueer/octa-term.git#tag=v0.1.0
	sha256sums = SKIP

pkgname = octa-term
