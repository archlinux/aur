	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.18.8.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.18.8.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.18.8.zen2-1-x86_64.pkg.tar.zst
	options = !strip
