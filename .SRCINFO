pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.45
	pkgrel = 2
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.45-2-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.45-2-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.45-2-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.45-2-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.45-2-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.45-2-x86_64.pkg.tar.zst
	sha256sums = 7bdaac0ddd939258f52f0d01806effa1b7de890e7aef76ea8d97a136d1af8764
