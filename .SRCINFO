	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.15.5.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.15.5.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.15.5.arch1-1-x86_64.pkg.tar.zst
	options = !strip
