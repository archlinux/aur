pkgname = onnxruntime-provider-openvino-bin
	pkgdesc = The OpenVINO execution provider of ONNX Runtime, for onnxruntime-core (Intel CPU, GPU and NPU) (prebuilt)
	depends = onnxruntime-core=1.29.0-6
