pkgbase = linux-recall-bin
	pkgdesc = Windows Recall-style screen memory for KDE Plasma 6 on Wayland
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/junyixu/linux_recall
	arch = any
	license = MIT
	makedepends = python-installer
	depends = python
	depends = python-jeepney
	depends = python-pillow
	depends = python-requests
	depends = spectacle
	optdepends = python-rapidocr: local OCR when the PaddleOCR cloud is unreachable
	optdepends = python-onnxruntime: local OCR when the PaddleOCR cloud is unreachable
	optdepends = python-openvino: run local OCR on OpenVINO instead (same text, under half the CPU time)
	optdepends = plasma-browser-integration: record the URL of the active browser tab
	optdepends = fzf: lrf search picker
	optdepends = jq: lrf and lr-search
	optdepends = imagemagick: highlight matches on screenshots
	optdepends = kitty: image previews in lrf
	optdepends = python-numpy: Click to Do (linux-recall-click)
	optdepends = firefox: Click to Do opens its page in Firefox
	optdepends = kdotool: lrf ctrl-o raises Neovide and Anki Browse windows
	optdepends = libnotify: notify-send messages from lrf
	optdepends = xdg-utils: lrf opens screenshots and links with xdg-open
	provides = linux-recall
	conflicts = linux-recall
	conflicts = linux-recall-git
	source = https://github.com/junyixu/linux_recall/releases/download/v0.2.0/linux_recall-0.2.0-py3-none-any.whl
	source = https://github.com/junyixu/linux_recall/archive/refs/tags/v0.2.0.tar.gz
