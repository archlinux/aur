	source = 0013-Fix-errors-due-to-disabled-exceptions-with-cpp_winrt.patch
	source = 0014-Link-corelib-correctly-against-runtimeobject-when-co.patch
	source = 0015-Workaround-linker-error-about-missing-symbol-__sync_.patch
	source = 0016-Workaround-Unknown-CMake-command-_qt_test_emscripten.patch
	source = 0017-Fix-configuration-when-EMSCRIPTEN_ROOT-is-an-absolut.patch
	source = 0018-Allow-handling-Android-activity-lifecycle-by-user-pr.patch
	source = 0019-Avoid-compile-error-due-to-inconsistent-use-of-noexc.patch
	source = 0020-Allow-keeping-Android-app-in-background-with-QtQuick.patch
	source = 0021-Allow-resuming-native-app-when-Android-activity-is-r.patch
	source = 0022-Enable-minimal-and-offscreen-plugins-when-compiling-.patch
	source = 0023-Allow-configuring-use-of-OpenSSL-in-QPasswordDigesto.patch
	source = 0024-Http2-fix-handling-incoming-frames-on-locally-reset-.patch
	source = 0025-Http2-Explicitly-send-RST_STREAM-on-cancelled-reques.patch
	source = 0026-Http2ProtocolHandler-fix-logic-error-with-potential-.patch
	source = 0027-QMainWindowTabBar-Use-QPointer-for-mainWindow-member.patch
