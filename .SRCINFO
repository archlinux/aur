pkgbase = hledger-bin
	pkgdesc = Easy-to-use command-line/curses/web plaintext accounting tool
	pkgver = 1.34
	pkgrel = 1
	url = http://hledger.org
	arch = x86_64
	license = GPL
	makedepends = coreutils
	depends = gmp
	depends = ncurses5-compat-libs
	source = hledger-1.34.tar.gz::https://github.com/simonmichael/hledger/releases/download/1.34/hledger-linux-x64.tar.gz
	sha256sums = bbeef13b7cea31e5896cfcc5b2563b96187673bddc29f243815814a44f25a139

pkgname = hledger-bin
	pkgdesc = Command-line interface for the hledger accounting system
	depends = gmp
	depends = ncurses5-compat-libs
	depends = glibc
	provides = hledger
	conflicts = hledger

pkgname = hledger-ui-bin
	pkgdesc = Curses-style terminal interface for the hledger accounting system
	depends = gmp
	depends = ncurses5-compat-libs
	depends = zlib
	provides = hledger-ui
	conflicts = hledger-ui

pkgname = hledger-web-bin
	pkgdesc = Web-based user interface for the hledger accounting system
	depends = gmp
	depends = ncurses5-compat-libs
	depends = zlib
	provides = hledger-web
	conflicts = hledger-web
