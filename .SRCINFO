pkgbase = lmm-api-go-bin
	pkgdesc = LMM API Go backend, native CLI, systemd service, and web frontend (prebuilt)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/LIghtJUNction/api.lmm.best
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	makedepends = cosign
	depends = ca-certificates
	depends = systemd
	depends = tzdata
	optdepends = postgresql: production database
	optdepends = valkey: cache, rate limiting, and login sessions
	provides = lmm-api-go=0.1.0
	conflicts = lmm-api
	conflicts = lmm-api-bin
	conflicts = lmm-api-git
	conflicts = lmm-api-go
	conflicts = lmm-api-go-git
	noextract = lmm-api-go-0.1.0-linux-amd64.tar.gz
	noextract = lmm-api-go-0.1.0-linux-arm64.tar.gz
	options = !strip
	backup = etc/lmm-api-go/lmm-api-go.env
	source_x86_64 = lmm-api-go-0.1.0-linux-amd64.tar.gz::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-amd64.tar.gz
	source_x86_64 = lmm-api-go-0.1.0-linux-amd64.tar.gz.sha256::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-amd64.tar.gz.sha256
	source_x86_64 = lmm-api-go-0.1.0-linux-amd64.tar.gz.sigstore.json::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-amd64.tar.gz.sigstore.json
	sha256sums_x86_64 = SKIP
	sha256sums_x86_64 = SKIP
	sha256sums_x86_64 = SKIP
	source_aarch64 = lmm-api-go-0.1.0-linux-arm64.tar.gz::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-arm64.tar.gz
	source_aarch64 = lmm-api-go-0.1.0-linux-arm64.tar.gz.sha256::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-arm64.tar.gz.sha256
	source_aarch64 = lmm-api-go-0.1.0-linux-arm64.tar.gz.sigstore.json::https://github.com/LIghtJUNction/api.lmm.best/releases/download/v0.1.0/lmm-api-go-0.1.0-linux-arm64.tar.gz.sigstore.json
	sha256sums_aarch64 = SKIP
	sha256sums_aarch64 = SKIP
	sha256sums_aarch64 = SKIP

pkgname = lmm-api-go-bin
