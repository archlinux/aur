pkgbase = libfronius
	pkgver = 1.0.18
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.18::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.18
	sha256sums = 11a87b57b3de5c9d73e683755d344417cd904b301f19ec6eca71525c34bf6588

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
