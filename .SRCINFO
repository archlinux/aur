pkgbase = niri-better
	pkgdesc = Scrollable-tiling Wayland compositor with the Better Desktop companion apps
	pkgver = 26.4.0.elite
	pkgrel = 4
	url = https://github.com/fram446742/better-niri
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = clang
	makedepends = git
	makedepends = pkgconf
	makedepends = rust
	source = better-niri::git+https://github.com/fram446742/better-niri.git#commit=07e14ac3396e9cbcebe446787fdb40d6582d13ec
	source = better-settings.desktop
	source = better-desktop.README.md
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = niri-better
	pkgdesc = Scrollable-tiling Wayland compositor with the Better Desktop integration
	depends = cairo
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = libdisplay-info
	depends = libdrm
	depends = libglvnd
	depends = libinput
	depends = libpipewire
	depends = libxkbcommon
	depends = mesa
	depends = pango
	depends = pixman
	depends = seatd
	depends = systemd-libs
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = xdg-desktop-portal: portal broker for niri.portal
	optdepends = xdg-desktop-portal-gtk: file chooser, notifications and other fallback portals
	optdepends = xdg-desktop-portal-gnome: fallback ScreenCast backend
	optdepends = dbus: dbus-update-activation-environment used by niri-session
	optdepends = systemd: systemctl, loginctl and busctl for session and idle integration
	optdepends = pipewire: screencasting server
	optdepends = wireplumber: PipeWire session manager
	optdepends = libnotify: notify-send for user hooks and scripts
	optdepends = alacritty: terminal in the default niri configuration
	optdepends = fuzzel: application launcher in the default niri configuration
	optdepends = mako: notification daemon
	optdepends = waybar: panel used by the default niri configuration
	optdepends = swaylock: screen locker in the default niri configuration
	optdepends = polkit-gnome: authentication agent for privileged applications
	optdepends = xwayland-satellite: run X11 applications in XWayland
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: GL/Vulkan driver for NVIDIA GPUs
	provides = niri=26.4.0.elite
	provides = niri-elite=26.4.0.elite
	provides = wayland-compositor
	provides = xdg-desktop-portal-impl
	conflicts = niri
	conflicts = niri-git
	conflicts = niri-elite
	conflicts = niri-elite-git
	options = !strip

pkgname = better-portal
	pkgdesc = Standalone Screenshot/ScreenCast xdg-desktop-portal backend for Better Niri
	depends = dbus
	depends = gcc-libs
	depends = glibc
	depends = systemd
	optdepends = xdg-desktop-portal: broker that loads better.portal
	optdepends = xdg-desktop-portal-gtk: fallback for interfaces better-portal does not implement

pkgname = better-companion
	pkgdesc = Automation and parking daemon for Better Niri
	depends = gcc-libs
	depends = glibc
	optdepends = systemd: loginctl, busctl and systemctl for idle and lock actions, plus the optional user unit
	optdepends = libpulse: pactl probe for idle detection
	optdepends = libnotify: notify-send in user hooks

pkgname = better-monitor
	pkgdesc = Output profile save, apply and rollback for Better Niri
	depends = gcc-libs
	depends = glibc

pkgname = better-session
	pkgdesc = Named workspace, window and output contexts for Better Niri
	depends = gcc-libs
	depends = glibc

pkgname = better-shot
	pkgdesc = Screenshot capture for Better Niri with annotations and clipboard support
	depends = gcc-libs
	depends = glibc
	optdepends = satty: interactive annotation for better-shot --annotate
	optdepends = wl-clipboard: wl-copy/wl-paste for better-shot --copy

pkgname = better-wallpaper
	pkgdesc = Per-workspace wallpaper scenes for Better Niri
	depends = gcc-libs
	depends = glibc
	depends = wayland
	optdepends = swaybg: default wallpaper command for the command backend
	optdepends = swww: alternative wallpaper daemon for the command backend

pkgname = better-settings
	pkgdesc = GTK4/libadwaita control center and CLI for Better Niri
	depends = gcc-libs
	depends = glibc
	depends = gtk4
	depends = libadwaita

pkgname = better-audio
	pkgdesc = Rule-based PipeWire audio routing for Better Niri
	depends = gcc-libs
	depends = glibc
	depends = libpipewire
	optdepends = pipewire: audio server used by the native backend
	optdepends = wireplumber: PipeWire session manager providing wpctl
	optdepends = libpulse: pactl backend for PipeWire PulseAudio compatibility
	optdepends = pulseaudio: alternative sound server providing pactl

pkgname = better-sidepanels
	pkgdesc = Layer-shell panels with exclusive zones for Better Niri
	depends = cairo
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = wayland
	optdepends = playerctl: media module
	optdepends = libpulse: pactl backend for the volume module
	optdepends = wireplumber: wpctl backend for the volume module
	optdepends = libnotify: notify-send actions

pkgname = better-noctalia-plugins
	pkgdesc = Noctalia bar plugins for the Better Desktop companion apps
	arch = any
	depends = 
	optdepends = noctalia: shell that loads these Luau plugins
	optdepends = better-companion: status and action widgets
	optdepends = better-monitor: output profile widget
	optdepends = better-session: context switcher widget
	optdepends = better-shot: screenshot widget
	optdepends = better-audio: default sink widget
	optdepends = better-wallpaper: scene widget
	optdepends = better-sidepanels: panel reload widget

pkgname = better-desktop
	pkgdesc = Meta package for the Better Niri desktop: compositor, portal and companion apps
	install = better-desktop.install
	depends = niri-better
	depends = better-portal
	depends = better-companion
	depends = better-monitor
	depends = better-session
	depends = better-shot
	depends = better-wallpaper
	depends = better-settings
	depends = better-audio
	depends = better-sidepanels
	depends = better-noctalia-plugins
	optdepends = xdg-desktop-portal: portal broker for niri.portal and better.portal
	optdepends = xdg-desktop-portal-gtk: fallback portal for file chooser and friends
	optdepends = pipewire: audio and screencasting server
	optdepends = wireplumber: PipeWire session manager and wpctl
	optdepends = dbus: dbus-update-activation-environment used by niri-session
	optdepends = systemd: systemctl, loginctl and busctl integration
