	depends = bubblewrap
	depends = coreutils
	depends = gnupg
	depends = pacman
	depends = util-linux
	optdepends = paru: use the paru-makepkg-jail adapter
	optdepends = traur: pre-fetch trust scan hook
	options = !debug
	options = !strip
	backup = etc/apparmor.d/makepkg-jail-build
