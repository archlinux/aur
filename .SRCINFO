pkgname = linux-flowx13
	pkgdesc = The Linux (with patches for the Asus Flow X13) kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-flowx13-headers
	pkgdesc = Headers and scripts for building modules for the Linux (with patches for the Asus Flow X13) kernel
	depends = pahole

pkgname = linux-flowx13-docs
	pkgdesc = Documentation for the Linux (with patches for the Asus Flow X13) kernel
