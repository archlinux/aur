pkgbase = spitfire
	pkgdesc = Tiling Wayland compositor with a live-reloadable Lua config, in the spirit of dwm
	pkgver = 0.5.2
	pkgrel = 1
	url = https://github.com/dani-77/spitfire
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = wayland-protocols
	depends = wayland
	depends = libxkbcommon
	depends = mesa
	depends = seatd
	depends = libinput
	depends = libdisplay-info
	depends = pixman
	depends = dbus
	depends = gcc-libs
	depends = glibc
	optdepends = xorg-xwayland: run X11-only apps (XWayland support)
	optdepends = xdg-desktop-portal: file-open dialogs, notifications and other portal prompts
	optdepends = iw: wifi widget in the bar
	optdepends = alacritty: terminal bound to Mod4+Return in the example config
	optdepends = greetd: use spitfire as a login-screen session
	options = !lto
	backup = etc/xdg-desktop-portal/spitfire-portals.conf
