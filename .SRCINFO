pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.33
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.33-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.33-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.33-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.33-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.33-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.33-1-x86_64.pkg.tar.zst
	sha256sums = 2c630411c38ae2b71bc72ff57643ef32ee6716e05d29d4ed8fd7b61c2db8edc4
	sha256sums = 252a4c26c1eb7d0a98886a172636799b9b4b9c86de87fb991c5d6c408b3dfb49
	sha256sums = 0140edcd4e8ef67f09432fb13de3a374575d854ff16bf89c66c5067816376d3c

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.33-1-lts-bin
	depends = linux6.18.33-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.33-1-lts-headers-bin
	depends = linux6.18.33-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.33-1-lts-docs-bin
	depends = linux6.18.33-1-lts-docs-bin

pkgname = linux6.18.33-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.33-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.33-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.33-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.33-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.33-1-lts
	conflicts = linux-lts-docs
