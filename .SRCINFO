	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.6.69-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.6.69-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.6.69-1-x86_64.pkg.tar.zst
	options = !strip
