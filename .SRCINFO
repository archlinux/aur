pkgbase = ocsinventory-agent3
	pkgdesc = Hardware and software inventory agent for OCS Inventory server 3.x
	pkgver = 3.0.0
	pkgrel = 1
	url = https://github.com/OCSInventory-NG/OCSInventory-Agent-Rework
	install = ocsinventory-agent3.install
	arch = x86_64
	license = GPL-3.0-or-later
	license = GPL-3.0-only
	makedepends = dart
	depends = bash
	depends = ca-certificates
	depends = coreutils
	depends = dmidecode
	depends = glibc
	depends = inetutils
	depends = iproute2
	depends = systemd
	depends = tar
	depends = util-linux
	depends = which
	optdepends = cups: printer inventory
	optdepends = libdisplay-info: monitor inventory
	optdepends = libvirt: libvirt virtual machine inventory
	optdepends = pciutils: controller, sound and video card inventory
	optdepends = python: process, cron and uptime inventory (Extended template)
	optdepends = smartmontools: disk model, firmware and serial numbers
	optdepends = sudo: per-user VM, firewall and TeamViewer inventory
	optdepends = teamviewer: TeamViewer ID inventory (Extended template)
	optdepends = upower: battery inventory
	optdepends = usbutils: USB device inventory
	optdepends = virtualbox: VirtualBox virtual machine inventory
	options = !strip
	options = !debug
	backup = etc/ocsinventory-agent/config.json
	source = ocsinventory-agent3-3.0.0.tar.gz::https://github.com/OCSInventory-NG/OCSInventory-Agent-Rework/archive/refs/tags/3.0.0.tar.gz
	source = fix-agent-version.patch
	source = fix-os-release.patch
	source = fix-ip-address.patch
	source = config.json
	source = linux-arch-template.json
	source = linux-arch-extended-template.json
