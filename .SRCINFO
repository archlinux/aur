pkgbase = solana
	pkgver = 4.4.0
	pkgrel = 1
	epoch = 1
	url = https://github.com/anza-xyz/agave
	arch = x86_64
	license = Apache-2.0
	makedepends = clang
	makedepends = cargo
	makedepends = git
	makedepends = protobuf
	makedepends = rust
	noextract = platform-tools-linux-x86_64.tar.bz2
	options = !lto
	source = git+https://github.com/anza-xyz/agave.git#tag=v4.4.0
	source = git+https://github.com/anza-xyz/cargo-build-sbf.git#tag=cargo-build-sbf@v4.5.0
	source = git+https://github.com/solana-program/token-2022.git#tag=cli@v5.7.1
	source = https://github.com/anza-xyz/platform-tools/releases/download/v1.58/platform-tools-linux-x86_64.tar.bz2
	source = solana-sbf_sdk-path.patch
	sha256sums = d489b6b9a5db7d16f73d644ad960da18fca673e38c983b3dc478fb6d34ff293d
	sha256sums = 1694e997efe94b0eaf0114359511d877f8f5c5ab7b2779fea8633cbb47ea58ec
	sha256sums = 0cc64f633474bcbed02604abb3ab0fbdd9c8bb242e174d117587153371374744
	sha256sums = 7b82eb420b5aebd1e5590db0ae25c523eca06724d4238ae02139690535636c37
	sha256sums = 959e7a27067bc7ca53c19999c2c4295b3a1fe0b012f67088b4d4a09d68e84244

pkgname = solana-cli
	pkgdesc = Solana CLI tools
	depends = bzip2
	depends = glibc
	depends = libgcc
	depends = zstd
	provides = spl-token
	conflicts = spl-token
	conflicts = solana-bin

pkgname = agave-validator
	pkgdesc = Agave validator and node operator tools for Solana
	install = agave-validator.install
	depends = bzip2
	depends = glibc
	depends = libcap
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd

pkgname = solana-dev
	pkgdesc = Solana program developer tools
	install = solana-dev.install
	depends = bzip2
	depends = cargo
	depends = clang
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = lld
	depends = llvm
	depends = rust
	depends = zlib
	depends = zstd
	conflicts = solana-dev-bin
	options = !strip
	options = !debug
	options = !lto

pkgname = solana
	pkgdesc = A fast, secure, and censorship resistant blockchain (meta package)
	depends = solana-cli
	depends = agave-validator
	depends = solana-dev
