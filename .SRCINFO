pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.13
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.13-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.13-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.13-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.13-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.13-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.13-1-x86_64.pkg.tar.zst
	sha256sums = 9ee8de4ac7916c4109006eba2ed67e137b52fffb719a7e65c18e4f40546dd7f9
	sha256sums = 992be4f6877d184b7a770642833621fbbc0174d7beeb684c1069373e64858a6a
	sha256sums = d29602f0fb2f7ff84e770842b969089c85c5f29882c3a62c24953d922f792153

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.13-1-lts-bin
	depends = linux6.12.13-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.13-1-lts-headers-bin
	depends = linux6.12.13-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.13-1-lts-docs-bin
	depends = linux6.12.13-1-lts-docs-bin

pkgname = linux6.12.13-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.13-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.13-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.13-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.13-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.13-1-lts
	conflicts = linux-lts-docs
