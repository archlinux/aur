	optdepends = xdg-utils: open links from --text-info --show-uri and --icons (default OpenCommand)
	optdepends = xterm: terminal for --icons entries with Terminal=true (default Terminal setting)
	optdepends = xorg-xwayland: X11-only modes (--notebook, --paned, --plug) with GDK_BACKEND=x11 on Wayland
	provides = yad
	conflicts = yad
	conflicts = yad-git
	conflicts = yad-gtk2
	replaces = yad
