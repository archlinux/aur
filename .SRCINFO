pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.42
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.42-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.42-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.42-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.42-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.42-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.42-1-x86_64.pkg.tar.zst
	sha256sums = 580f1490dbb06aba20b27a06b02023b7d1d37960fc4bce3fdc41683d00c1b34b
	sha256sums = 1789fdb020ced24ab232c7fde395b9440f8e854b099462fd984da98efb23e8fd
	sha256sums = 3fa47d48edb3d15428a3ffca35d6fc79e99f40e657d479c1089329c6851570ba

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.42-1-lts-bin
	depends = linux6.12.42-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.42-1-lts-headers-bin
	depends = linux6.12.42-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.42-1-lts-docs-bin
	depends = linux6.12.42-1-lts-docs-bin

pkgname = linux6.12.42-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.42-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.42-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.42-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.42-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.42-1-lts
	conflicts = linux-lts-docs
