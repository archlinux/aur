pkgbase = frost-d77
	pkgdesc = Wayland desktop shell and session locker written in Rust
	pkgver = 0.2.4
	pkgrel = 1
	url = https://github.com/dani-77/frost
	arch = x86_64
	license = MIT
	makedepends = rust>=1:1.95
	makedepends = pkgconf
	depends = wayland
	depends = libglvnd
	depends = libxkbcommon
	depends = fontconfig
	depends = freetype2
	depends = pam
	depends = gcc-libs
	depends = glibc
	depends = glib2
	depends = cliphist
	depends = wl-clipboard
	depends = xdg-utils
	depends = eww
	depends = dgop
	optdepends = wireplumber: volume controls
	optdepends = dunst: notification history and do not disturb (alternative to swaync)
	optdepends = swaync: notification control center (alternative to dunst)
	optdepends = iproute2: network interface details in the dashboard
	optdepends = procps-ng: CPU process details in the dashboard
	optdepends = libpulse: react immediately to Pulse sink volume changes with pactl
	optdepends = brightnessctl: brightness controls
	optdepends = networkmanager: Wi-Fi status and nmtui
	optdepends = power-profiles-daemon: power profile controls
	optdepends = cmus: music controls
	optdepends = tmux: start cmus from the dashboard
	optdepends = screen: start cmus from the dashboard
	optdepends = swww: wallpaper backend
	optdepends = awww: wallpaper backend
	optdepends = matugen: wallpaper-based color palette
	optdepends = curl: weather forecast
	backup = etc/pam.d/frost-locker
