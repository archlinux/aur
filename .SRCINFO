pkgbase = vopono-git
	pkgdesc = Run applications through VPN connections in network namespaces
	pkgver = 1.0.1.r0.g1d4d774
	pkgrel = 1
	url = https://github.com/jamesmcm/vopono
	install = vopono.install
	arch = any
	license = GPL3
	makedepends = git
	makedepends = rust
	optdepends = openvpn: for OpenVPN connections
	optdepends = wireguard-tools: for Wireguard connections
	optdepends = shadowsocks-libev: for Shadowsocks support (Mullvad)
	optdepends = openfortivpn: for FortiClient VPN connections
	optdepends = libnatpmp: for ProtonVPN port forwarding support
	optdepends = trojan: for Trojan Wireguard forwarding support
	optdepends = redsocks: for SSH proxy forwarding support
	optdepends = openssh: for SSH proxy forwarding support
	provides = vopono
	conflicts = vopono
	options = !lto
	source = git+https://github.com/jamesmcm/vopono
	sha256sums = SKIP

pkgname = vopono-git
