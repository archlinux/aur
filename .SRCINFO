pkgbase = msvc-wine-git
	pkgdesc = MSVC compiler with CMake toolchains. Compiler work in Wine64
	pkgver = 18.5.1.a99ef92
	pkgrel = 1
	url = https://github.com/mstorsjo/msvc-wine
	arch = x86_64
	license = EULA
	makedepends = git
	makedepends = sed
	makedepends = python
	makedepends = python-simplejson
	makedepends = python-six
	makedepends = msitools
	depends = libunwind
	depends = wine
	depends = cmake
	depends = bash
	optdepends = samba: Need to generate debug symbols (Debug and RelWithDebInfo build types)
	optdepends = lld: Required by MSVC+LLD CMake toolchains/vcpkg triplets (lld-link); workaround for link.exe hangs under Wine
	optdepends = llvm: Required by clang-cl and MSVC+LLD CMake toolchains/vcpkg triplets (llvm-lib, llvm-mt, llvm-rc); supports the link.exe-hang workaround under Wine
	provides = msvc-x86-cmake
	provides = msvc-x64-cmake
	provides = msvc-arm64-cmake
	conflicts = msvc-wine
	options = !strip
	options = libtool
	options = staticlibs
	options = emptydirs
	source = git+https://github.com/mstorsjo/msvc-wine.git
	source = msvc-cmake.sh
	source = toolchain-msvc.cmake
	source = toolchain-msvc-lld.cmake
	source = toolchain-clang-cl.cmake
	source = triplet-msvc.cmake
	source = triplet-msvc-lld.cmake
	source = triplet-clang-cl.cmake
	source = msvc-vcpkg.sh
