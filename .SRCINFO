pkgbase = shelly-cli
	pkgdesc = Native Shelly package-manager CLI beta
	pkgver = 3.0.0+8r3542.g11ff868
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/Shelly-ALPM
	arch = x86_64
	license = GPL-3.0-only
	makedepends = git
	makedepends = pkgconf
	makedepends = zig>=0.16.0
