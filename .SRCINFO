pkgbase = qimgv-gtk-bin
	pkgdesc = Fast and easy to use image viewer, GTK 3 rewrite of qimgv with JPEG XL, AVIF, HEIF, APNG and RAW support (prebuilt)
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/TheElevatedOne/qimgv-gtk
	arch = x86_64
	license = GPL-3.0-or-later
	depends = gcc-libs
	depends = glibc
	depends = glib2
	depends = gtk3
	depends = cairo
	depends = pango
	depends = gdk-pixbuf2
	depends = libjpeg-turbo
	depends = libpng
	depends = libwebp
	depends = giflib
	depends = zlib
	optdepends = libjxl: JPEG XL support
	optdepends = libavif: AVIF support
	optdepends = libheif: HEIF/HEIC support
	optdepends = libraw: camera RAW support
	optdepends = exiv2: EXIF info panel and keeping metadata when saving
	provides = qimgv-gtk=0.1.1
	provides = qimgv
	conflicts = qimgv-gtk
	conflicts = qimgv
	options = !debug
	options = !strip
	source_x86_64 = https://github.com/TheElevatedOne/qimgv-gtk/releases/download/0.1.1/qimgv-gtk-0.1.1-linux-x86_64.tar.gz
