pkgbase = awtwall
	pkgdesc = Fast TUI wallpaper picker for Wayland with libsixel previews
	pkgver = 2.1.2
	pkgrel = 1
	url = https://github.com/dillacorn/awtwall
	arch = any
	license = MIT
	depends = bash
	depends = imagemagick
	optdepends = awww-bin: preferred wallpaper backend (successor to swww)
	optdepends = awww-git: preferred wallpaper backend (git package of successor to swww)
	optdepends = swww: fallback wallpaper backend
	optdepends = hyprpaper: optional still-image wallpaper backend
	optdepends = hyprland: provides hyprctl for hyprpaper backend and better monitor detection
	optdepends = mpvpaper: optional video wallpaper backend
	optdepends = chafa: recommended SIXEL preview encoder
	optdepends = libsixel: img2sixel SIXEL preview encoder
	optdepends = jq: better monitor detection
	optdepends = ffmpeg: better .mp4 thumbnail extraction
	optdepends = xdg-utils: open wallpaper folder from the UI
	optdepends = kitty: optional kitty image previews (slower than sixel)
	optdepends = curl: optional release/version check
	optdepends = wget: optional release/version check
	source = awtwall-2.1.2.tar.gz::https://github.com/dillacorn/awtwall/archive/refs/tags/2.1.2.tar.gz
	sha256sums = 86e0b0dca89e4b9b635809703823770b7bfb6d5c9711e574a75c2d3669cd9bbe

pkgname = awtwall
