pkgbase = quiet-md
	pkgdesc = 本地优先的富文本笔记，GPUI 绘制，兼容飞书 DocxXML，可直接编辑 Markdown 文件
	pkgver = 0.1.10
	pkgrel = 1
	url = https://quiet.md
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = pkgconf
	makedepends = freetype2
	depends = hicolor-icon-theme
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	depends = xdg-utils
	optdepends = noto-fonts: 界面字体（Noto Sans）
	optdepends = noto-fonts-cjk: 中文界面和文档需要的 Noto Sans CJK
	optdepends = xdg-desktop-portal: 打开、保存文件时的选择框
