pkgbase = aurto
	pkgdesc = An AUR tool for managing an auto-updating local 'aurto' package repository using aurutils.
	pkgver = 0.13.0
	pkgrel = 2
	url = https://github.com/alexheretic/aurto
	install = aurto.install
	arch = x86_64
	arch = aarch64
	arch = armv7h
	license = MIT
	makedepends = cargo
	depends = aurutils
	depends = devtools
	depends = systemd
	depends = pacutils
	depends = pacman-contrib
	depends = less
	depends = sudo
	depends = zstd
	depends = ninja
	options = !lto
	backup = usr/lib/systemd/system/check-aurto-git-trigger.timer
	backup = usr/lib/systemd/system/update-aurto.timer
	backup = usr/lib/systemd/system/update-aurto-startup.timer
	backup = etc/aurto/pacman-chroot.conf
	backup = etc/aurto/makepkg-chroot.conf
	source = aurto-0.13.0.tar.gz::https://github.com/alexheretic/aurto/archive/v0.13.0.tar.gz
	sha256sums = 716015275e96f8cc6554eeb864c3107d7c35efaaf7afb86d3b5427ef0579765c

pkgname = aurto
