pkgbase = lightdm-slick-greeter-mint-theme
	pkgdesc = A slick-looking LightDM greeter. With additional options enabled
	pkgver = 2.2.1
	pkgrel = 1
	url = https://github.com/linuxmint/slick-greeter
	install = slick-greeter.install
	arch = x86_64
	license = GPL3
	makedepends = meson
	makedepends = vala
	depends = cairo
	depends = freetype2
	depends = gtk3
	depends = libcanberra
	depends = libxext
	depends = lightdm-guest
	depends = mint-themes
	depends = pixman
	depends = python-gobject
	depends = xapp
	depends = xorg-server
	optdepends = cinnamon-styles-artwork: enable full artwork theme in Cinnamon
	optdepends = lightdm-settings: allow configuration of slick-greeter
	optdepends = mint-l-theme: enable additional Mint themes
	optdepends = numlockx: enable numerical keypad on supported keyboard
	provides = lightdm-slick-greeter
	conflicts = lightdm-slick-greeter
	backup = etc/lightdm/slick-greeter.conf
	source = slick-greeter-2.2.1.tar.gz::https://github.com/linuxmint/slick-greeter/archive/2.2.1.tar.gz
