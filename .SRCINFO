pkgbase = doudou-unstable
	pkgdesc = Stream your music with ease and style (unstable/development version). Source: https://gitlab.com/Openlyst/doudou
	pkgver = 1.0.0
	pkgrel = 1
	url = https://gitlab.com/Openlyst/doudou
	arch = x86_64
	license = GPL3
	makedepends = git
	makedepends = flutter
	makedepends = clang
	makedepends = cmake
	makedepends = ninja
	makedepends = pkgconf
	depends = mpv
	depends = gtk3
	depends = libmpv.so
	options = !strip
	source = doudou-unstable::git+https://gitlab.com/Openlyst/doudou.git#branch=main
	sha256sums = SKIP

pkgname = doudou-unstable
