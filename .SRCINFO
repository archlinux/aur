pkgbase = duckwm-git
	pkgdesc = A graph-based tiling window manager with Lua configuration (X11)
	pkgver = 0.0.0.r75.gcfdb332
	pkgrel = 1
	url = https://github.com/DuckTapeMan35/duckwm
	install = duckwm.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = zig>=0.16.0
	makedepends = git
	depends = libx11
	depends = libxft
	depends = libxcursor
	depends = libxrandr
	depends = fontconfig
	optdepends = xorg-xinit: start it with startx
	optdepends = xterm: a terminal for the fallback config (or kitty, alacritty, wezterm)
	optdepends = lua-language-server: completion and docs while editing the config
	provides = duckwm
	conflicts = duckwm
	backup = etc/duckwm/config.lua
	source = duckwm::git+https://github.com/DuckTapeMan35/duckwm.git
	sha256sums = SKIP

pkgname = duckwm-git
