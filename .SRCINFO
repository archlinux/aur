pkgbase = rufux-git
	pkgdesc = Rufux — bootable USB creator for Linux (Rufus port, latest git)
	pkgver = 1.9.r2.g56f5282
	pkgrel = 1
	url = https://github.com/Hultwl/Rufux
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cmake
	makedepends = gcc
	makedepends = pkgconf
	makedepends = gettext
	makedepends = qt6-tools
	depends = qt6-base
	depends = hicolor-icon-theme
	depends = openssl
	depends = udisks2
	depends = util-linux
	optdepends = dosfstools: FAT32 formatting (mkfs.vfat)
	optdepends = ntfsprogs: NTFS formatting (mkfs.ntfs)
	optdepends = exfatprogs: exFAT formatting (mkfs.exfat)
	optdepends = e2fsprogs: ext4 formatting and persistence
	optdepends = libarchive: ISO extraction (bsdtar)
	optdepends = p7zip: required for UDF/Windows ISOs (7z)
	optdepends = wimlib: Windows 11 checks bypass inside boot.wim (wimlib-imagex)
	optdepends = hivex: offline registry editing for the bypass (hivexsh)
	optdepends = syslinux: BIOS/GPT MBR + syslinux install
	optdepends = grub: GRUB bootloader install
	optdepends = xorriso: ISO building
	optdepends = curl: release update checks
	optdepends = polkit: privilege escalation via pkexec
	provides = rufux
	conflicts = rufux
	source = git+https://github.com/Hultwl/Rufux.git
	sha256sums = SKIP

pkgname = rufux-git
