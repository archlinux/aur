pkgbase = gitcomet-bin
	pkgdesc = Fast, resource-efficient Git GUI written in Rust
	pkgver = 0.3.4
	pkgrel = 1
	url = https://gitcomet.dev/
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-only
	depends = git
	depends = glibc
	depends = libgcc
	depends = fontconfig
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = zlib
	depends = hicolor-icon-theme
	depends = libglvnd
	optdepends = vulkan-icd-loader: preferred Vulkan renderer (otherwise uses EGL)
	optdepends = wayland: native Wayland sessions (otherwise uses X11)
	optdepends = git-lfs: Git LFS support
	optdepends = gnupg: commit signing and verification
	optdepends = openssh: SSH remotes and commit signing
	optdepends = xdg-utils: open files and links in external applications
	optdepends = xdg-desktop-portal: file pickers and desktop settings
	optdepends = noto-fonts-cjk: CJK font coverage
	optdepends = noto-fonts-emoji: emoji font coverage
	provides = gitcomet=0.3.4
	conflicts = gitcomet
	options = !strip
	options = !debug
	source = gitcomet-source-v0.3.4.tar.gz::https://github.com/Auto-Explore/GitComet/archive/refs/tags/v0.3.4.tar.gz
	sha256sums = cb2b1e96d6c346265582e520514b18598fd1ac0d41f0be2358e0beb081317eba
	source_x86_64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.4/gitcomet-v0.3.4-linux-x86_64.tar.gz
	sha256sums_x86_64 = 1836706ce321e8da474e62d8678d6d6d25abcbb882bed90dcd5deb43715cad67
	source_aarch64 = https://github.com/Auto-Explore/GitComet/releases/download/v0.3.4/gitcomet-v0.3.4-linux-arm64.tar.gz
	sha256sums_aarch64 = 817fdb24b07b4ff0c13374447e7293a2c29ce4fb90d2861738115d4e1635094e

pkgname = gitcomet-bin
