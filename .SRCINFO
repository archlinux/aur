	url = https://github.com/anthraxx/linux-hardened
	arch = x86_64
	license = GPL2
	noextract = linux-hardened-7.2.10.hardened1-1-x86_64.pkg.tar.zst
	noextract = linux-hardened-headers-7.2.10.hardened1-1-x86_64.pkg.tar.zst
