pkgname = linux-bnx2x-2.5g
	pkgdesc = The Linux kernel and modules with 2.5G patch for bnx2x module
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-bnx2x-2.5g-headers: headers and scripts for building modules
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-bnx2x-2.5g-headers
	pkgdesc = Headers and scripts for building modules for the Linux kernel with 2.5G patch for bnx2x module
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
