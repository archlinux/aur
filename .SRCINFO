pkgbase = makepkg-jail-local
	pkgdesc = Local bubblewrap makepkg sandbox with AppArmor and a restricted paru adapter
	pkgver = 0.2.4
	pkgrel = 1
	install = makepkg-jail-local.install
	arch = x86_64
	license = GPL-3.0-or-later
