	pkgdesc = Metapackage depending on linux6.15.8.zen1-2-zen-bin
	depends = linux6.15.8.zen1-2-zen-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-zen-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.15.8.zen1-2-zen-headers-bin
	depends = linux6.15.8.zen1-2-zen-headers-bin

