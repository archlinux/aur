pkgbase = objfw
	pkgdesc = Portable, lightweight framework for the Objective-C language
	pkgver = 1.1.2
	pkgrel = 1
	url = https://objfw.nil.im/
	arch = x86_64
	groups = objfw
	license = LGPL3
	makedepends = clang
	source = https://objfw.nil.im/downloads/objfw-1.1.2.tar.gz
	sha256sums = 5d9f9a70d583298e780ae11fc75a7ae2beeef904b301e1bc4f4ffa8d7ee31d9f

pkgname = libobjfw
	pkgdesc = ObjFW library
	depends = glibc
	depends = gcc-libs
	depends = libobjfwrt
	depends = bash

pkgname = libobjfwrt
	pkgdesc = ObjFW Objective-C runtime library
	depends = glibc
	depends = gcc-libs

pkgname = libobjfwtls
	pkgdesc = TLS support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = openssl

pkgname = ofarc
	pkgdesc = Utility for handling ZIP, Tar and LHA archives
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofdns
	pkgdesc = Utility for performing DNS requests on the command line
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhash
	pkgdesc = Utility to hash files with various cryptographic hash functions
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhttp
	pkgdesc = Command line downloader for HTTP(S)
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls
