pkgname = skwir
	license = Apache-2.0
	license = BSD-3-Clause
	license = GPL-3.0-only
	license = LGPL-2.1-only
	depends = libgcc
	depends = glibc
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = sqlite
	depends = fontconfig
	depends = vulkan-icd-loader
	depends = vulkan-driver
	depends = libarchive
	optdepends = gstreamer: audio and video playback
	optdepends = gst-plugins-base-libs: audio and video playback
	optdepends = gst-plugins-base: audio and video playback
	optdepends = gst-plugins-good: more audio and video formats
	optdepends = gst-plugins-bad: more audio and video formats
	optdepends = gst-plugins-ugly: more audio and video formats
	optdepends = gst-libav: more audio and video formats
	optdepends = poppler-glib: PDFs through Poppler, beside the PDFium skwir carries
	optdepends = djvulibre: DjVu through DjVuLibre, beside the djvu-rs reader skwir carries
	optdepends = skwir-mermaid: Mermaid diagrams drawn in Markdown previews
	optdepends = skwir-mupdf: the MuPDF engine, PDFs and books laid out into pages
	optdepends = bubblewrap: LibreOffice, ImageMagick and thumbnailers run isolated
	optdepends = libreoffice-fresh: office documents shown as pages
	optdepends = pandoc-cli: text documents read by Pandoc
	optdepends = imagemagick: pictures no thumbnailer draws
	optdepends = ffmpeg: still frames of films
	optdepends = perl-image-exiftool: writing and removing pictures locations
	optdepends = plocate: instant name searches over whole disks
	optdepends = udisks2: unmounting volumes from the sidebar
	optdepends = sshfs: opening sftp:// addresses through your ssh
	optdepends = rclone: opening rclone remotes, s3:// and servers that ask a password
	optdepends = gvfs: opening smb://, dav://, ftp:// and other addresses through GVfs
	optdepends = gvfs-smb: Windows shares through GVfs
	optdepends = gvfs-mtp: phones over MTP
	optdepends = gvfs-gphoto2: cameras
	optdepends = gvfs-afc: iPhones
	optdepends = gvfs-nfs: NFS shares through GVfs
	optdepends = kio-fuse: smb://, dav:// and ftp:// through KIO on KDE Plasma
	optdepends = rsync: copies to and from sftp servers in batches
	optdepends = fuse3: rclone mounts, and phones KDE holds
	optdepends = avahi: servers nearby, a NAS or a Mac
	optdepends = wsdd: Windows PCs nearby
	optdepends = inter-font: skwir's own interface font, when chosen
	optdepends = ttf-jetbrains-mono: skwir's own code font, when chosen

pkgname = skwir-mermaid
	pkgdesc = Mermaid diagrams drawn in skwir's Markdown previews
	depends = skwir
	depends = libgcc
	depends = glibc

pkgname = skwir-mupdf
	pkgdesc = skwir's MuPDF engine: PDFs, and books laid out into pages
	license = AGPL-3.0-or-later
	depends = skwir
	depends = libgcc
	depends = glibc
