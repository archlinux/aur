pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.6.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.18.6.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.18.6.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.18.6.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.18.6.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.18.6.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.18.6.arch1-1-x86_64.pkg.tar.zst
	sha256sums = 76bea70960f2226a41227e82da8cc27a8d60494551943ff69a4fc932d291c65d
