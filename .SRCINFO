pkgbase = heidisql
	pkgdesc = A lightweight GUI for managing MySQL, PostgreSQL, and Microsoft SQL databases.
	pkgver = 12.13.1.1
	pkgrel = 5
	url = http://www.heidisql.com/
	install = heidisql.install
	arch = x86_64
	license = GPL-2.0
	makedepends = lazarus
	makedepends = qt6pas
	makedepends = make
	makedepends = fpc
	makedepends = gettext
	makedepends = gtk2
	makedepends = binutils
	source = https://github.com/HeidiSQL/HeidiSQL/archive/v12.13.1.1.tar.gz
	source = https://github.com/HeidiSQL/HeidiSQL/releases/download/v12.13.1.1/heidisql_12.13.1.1_amd64.deb
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = heidisql
	pkgdesc = Metapackage for HeidiSQL - wrapper script and shared files (install heidisql-qt6 or heidisql-gtk2)
	arch = any
	depends = heidisql-client
	optdepends = heidisql-qt6: Qt6 variant
	optdepends = heidisql-gtk2: GTK2 variant
	provides = heidisql

pkgname = heidisql-qt6
	pkgdesc = HeidiSQL Qt6 variant - A lightweight GUI for managing MySQL, PostgreSQL, and Microsoft SQL databases (Qt6)
	depends = qt6pas
	depends = mariadb-libs
	depends = postgresql-libs
	depends = libperconaserverclient
	depends = sqlite
	provides = heidisql-client

pkgname = heidisql-gtk2
	pkgdesc = HeidiSQL GTK2 variant - A lightweight GUI for managing MySQL, PostgreSQL, and Microsoft SQL databases (GTK2)
	depends = gtk2
	depends = mariadb-libs
	depends = postgresql-libs
	depends = libperconaserverclient
	depends = sqlite
	provides = heidisql-client
