pkgbase = sogo
	pkgdesc = Groupware server with a web interface for mail, calendars and contacts, CalDAV, CardDAV and ActiveSync
	pkgver = 5.12.13
	pkgrel = 1
	url = https://github.com/Alinto/sogo
	install = sogo.install
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	license = GPL-3.0-or-later
	license = LGPL-2.0-or-later
	license = LGPL-2.1-or-later
	makedepends = gcc-objc
	makedepends = gnustep-make
	depends = sope>=5.12.13
	depends = bash
	depends = curl
	depends = glibc
	depends = gnustep-base
	depends = libgcc
	depends = libmemcached-awesome
	depends = libobjc
	depends = libsodium
	depends = libwbxml
	depends = libxcrypt
	depends = libytnef
	depends = libzip
	depends = oath-toolkit
	depends = openssl
	optdepends = memcached: the cache SOGo needs, when it runs on the same host
	optdepends = postgresql: database server, when it runs on the same host
	optdepends = mariadb: database server, when it runs on the same host
	optdepends = openldap: directory server, when it runs on the same host
	optdepends = dovecot: IMAP and Sieve server, when it runs on the same host
	optdepends = postfix: SMTP server, when it runs on the same host
	optdepends = nginx: reverse proxy for the web interface
	optdepends = apache: reverse proxy for the web interface, configured in /etc/httpd/conf/extra/SOGo.conf
	backup = etc/sogo/sogo.conf
	backup = etc/httpd/conf/extra/SOGo.conf
	backup = etc/logrotate.d/sogo
	source = sogo-5.12.13.tar.gz::https://github.com/Alinto/sogo/archive/refs/tags/SOGo-5.12.13.tar.gz
	source = sogo.service
	source = sogo.sysusers
	source = sogo.tmpfiles
	source = sogo-ealarms-notify.service
	source = sogo-ealarms-notify.timer
	source = sogo-expire-sessions.service
	source = sogo-expire-sessions.timer
	source = sogo-vacation-messages.service
	source = sogo-vacation-messages.timer
