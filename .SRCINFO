	depends = gst-plugin-pipewire
	depends = gst-plugins-good
	depends = gst-plugins-bad
	depends = gst-plugins-bad-libs
	depends = gst-plugins-ugly
	depends = pipewire
	depends = wireplumber
	depends = networkmanager
	depends = wpa_supplicant
	depends = xdg-desktop-portal
	depends = ufw
	depends = iptables
	depends = iproute2
	depends = polkit
	depends = python
	depends = systemd
	depends = dbus
	optdepends = xdg-desktop-portal-hyprland: screen capture on Hyprland
	optdepends = xdg-desktop-portal-wlr: screen capture on Sway, River, Labwc
	optdepends = hyprland: extend-desktop mode via a headless output
	optdepends = gst-plugin-va: hardware H.264 encoding on Intel and AMD (VA-API)
