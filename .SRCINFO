pkgbase = libfronius
	pkgver = 1.0.9
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.9::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.9
	sha256sums = 6f44f82db0ef5bb32d971e7a19a11081c4996a6dbae551f75e56134976f06d3e

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
