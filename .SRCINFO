pkgbase = mailbox-bin
	pkgdesc = Desktop mail client with a ribbon, calendar peek and reading pane (POP3, IMAP, SMTP)
	pkgver = 0.6.7
	pkgrel = 1
	url = https://github.com/codingncaffeine/Mailbox
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = bash
	depends = fontconfig
	depends = libx11
	depends = libxext
	depends = libxi
	depends = libxrandr
	depends = libxcursor
	depends = libice
	depends = libsm
	depends = libglvnd
	depends = wayland
	depends = libxkbcommon
	depends = mesa
	depends = glib2
	depends = nss
	depends = nspr
	depends = at-spi2-core
	depends = libcups
	depends = dbus
	depends = expat
	depends = pango
	depends = cairo
	depends = systemd-libs
	depends = libxcb
	depends = libxcomposite
	depends = libxdamage
	depends = libxfixes
	depends = alsa-lib
	depends = libsecret
	depends = libnotify
	optdepends = libldap: look people up in a company or university LDAP directory
	optdepends = hunspell-en_us: spelling, against the desktop dictionaries
	optdepends = ttf-carlito: renders mail set in Calibri at the same metrics
	optdepends = ttf-caladea: renders mail set in Cambria at the same metrics
	optdepends = gtk3: file dialogs where no desktop portal answers
	optdepends = xdg-desktop-portal: file dialogs through the desktop
	optdepends = xorg-xwayland: the send/receive progress window on Wayland, shown without taking the keyboard
