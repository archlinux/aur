pkgbase = slint
	pkgdesc = Declarative GUI toolkit to build native user interfaces
	pkgver = 1.17.0
	pkgrel = 1
	url = https://github.com/slint-ui/slint/
	arch = x86_64
	license = GPL-3.0-or-later OR LicenseRef-Slint-Royalty-free-2.0 OR LicenseRef-Slint-Software-3.0
	makedepends = cargo
	makedepends = cmake
	makedepends = fontconfig
	makedepends = freetype2
	makedepends = git
	makedepends = gstreamer
	makedepends = libinput
	makedepends = libxkbcommon
	makedepends = mesa
	makedepends = python
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-maturin
	makedepends = python-setuptools
	makedepends = python-wheel
	makedepends = systemd-libs
	source = https://github.com/slint-ui/slint/archive/v1.17.0/slint-1.17.0.tar.gz
	source = 010-slint-remove-jemalloc.patch
	sha256sums = 1cce5cc1e32a140e35366fe819fcf17a7b278338f67073d7bc97d4fa7a2a4d4e
	sha256sums = 2a7ff1dc07291a2917de05ebefc4fc970421be0c37f1cad05ffde7e5693fad42

pkgname = python-slint
	pkgdesc = Declarative GUI toolkit to build native user interfaces for Python apps
	depends = fontconfig
	depends = freetype2
	depends = glibc
	depends = libgcc
	depends = libinput
	depends = libstdc++
	depends = libxkbcommon
	depends = mesa
	depends = python
	depends = systemd-libs
	optdepends = libgl: for Skia OpenGL renderer backend
	optdepends = vulkan-icd-loader: for Skia Vulkan renderer backend

pkgname = slint-cpp
	pkgdesc = Declarative GUI toolkit to build native user interfaces for C++ apps
	depends = fontconfig
	depends = freetype2
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = libgl: for Skia OpenGL renderer backend
	optdepends = vulkan-icd-loader: for Skia Vulkan renderer backend
	provides = slint-compiler

pkgname = slint-tools
	pkgdesc = Tools for the Slint GUI toolkit (lsp, tr-extractor and viewer)
	depends = fontconfig
	depends = freetype2
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = libgl: for Skia OpenGL renderer backend in slint-viewer
	optdepends = vulkan-icd-loader: for Skia Vulkan renderer backend in slint-viewer
	provides = slint-lsp
	provides = slint-tr-extractor
	provides = slint-viewer
