pkgbase = synaptix-git
	pkgdesc = synaptix neural-network service: language models, speech, images and video for all apps — on NVIDIA GPU, Intel NPU or CPU
	pkgver = 0.2.0.r0
	pkgrel = 1
	url = https://github.com/VitaminDB/synshell
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cargo
	makedepends = rust
	makedepends = git
	makedepends = clang
	makedepends = pkgconf
	makedepends = mesa
	makedepends = libinput
	makedepends = seatd
	makedepends = libxkbcommon
	makedepends = libdrm
	makedepends = fontconfig
	makedepends = freetype2
	makedepends = dbus
	makedepends = ffmpeg
	makedepends = sqlite
	makedepends = libarchive
	makedepends = pipewire
	makedepends = alsa-lib
	makedepends = fuse3
	depends = gcc-libs
	optdepends = nvidia-utils: NVIDIA driver (NVENC, neural networks on the GPU)
	optdepends = cuda: NVRTC kernel compiler for NVIDIA GPUs
	optdepends = openvino-intel-npu-plugin: neural networks on Intel NPU (Core Ultra)
	optdepends = intel-npu-driver: Intel NPU driver
	optdepends = intel-npu-compiler: Intel NPU graph compiler
	provides = synaptix
	conflicts = synaptix
	conflicts = synaptix-bin
	options = !lto
	backup = etc/synaptix/synaptixd.toml
	source = synshell::git+https://github.com/VitaminDB/synshell.git
	sha256sums = SKIP

pkgname = synaptix-git
