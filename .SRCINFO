pkgbase = pat-aur-git
	pkgdesc = AUR helper and tool to build Arch Linux packages in clean containers.
	pkgver = r655.30c9a2d
	pkgrel = 2
	url = https://gitlab.com/patlefort/pat-aur
	arch = x86_64
	license = GPL-3.0-only
	license = MIT
	makedepends = git
	makedepends = libxslt
	makedepends = docbook-xsl
	makedepends = cmake
	makedepends = ninja
	makedepends = flatpak
	depends = ftxui
	depends = libutf8proc
	source = git+https://gitlab.com/patlefort/pat-aur.git
	source = git+https://gitlab.com/patlefort/PatFTXUI.git
	source = git+https://github.com/zzamboni/elvish-themes.git
	source = nlohmann_json::git+https://github.com/nlohmann/json.git
	source = git+https://github.com/zzamboni/elvish-modules.git
	source = git+https://github.com/href/elvish-gitstatus.git
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = pat-aur-client-git
	pkgdesc = AUR helper and tool to build Arch Linux packages in clean containers. (client only)
	depends = ftxui
	depends = libutf8proc
	depends = elvish
	depends = pacutils
	depends = expac
	depends = gzip
	depends = curl
	optdepends = pat-aur-client-flatpak-git: check flatpak updates.
	optdepends = pat-aur-client-firmware-git: check firmware updates.
	optdepends = python-pygments: Colorize source PKGBUILD.
	provides = pat-aur-client
	conflicts = pat-aur-client

pkgname = pat-aur-client-firmware-git
	pkgdesc = firmware updates support for pat-aur.
	arch = any
	depends = ftxui
	depends = libutf8proc
	depends = pat-aur-client-git
	depends = fwupd

pkgname = pat-aur-netns-exec-git
	pkgdesc = Execute a process in a specified network namespace.
	install = pat-aur-git-netns-exec.install
	arch = any
	depends = ftxui
	depends = libutf8proc
	depends = pat-aur-client-git

pkgname = pat-aur-host-git
	pkgdesc = AUR helper and tool to build Arch Linux packages in clean containers. (host machine)
	install = pat-aur-git.install
	arch = any
	depends = ftxui
	depends = libutf8proc
	depends = pat-aur-client-git
	depends = tini
	depends = pacutils
	depends = bubblewrap
	depends = ninja
	depends = git
	depends = python
	depends = jq
	optdepends = seccomp-filtered-run: seccomp filters.
	optdepends = sshfs: remote connection.
	optdepends = socat: remote connection.
	optdepends = systemd: cgroups support.
	optdepends = rsync: rsync download agent.
	optdepends = openssh: scp download agent.
	optdepends = pat-aur-netns-exec-git: build in network namespace.
	provides = pat-aur-host
	conflicts = pat-aur-host

pkgname = pat-aur-client-flatpak-git
	pkgdesc = Flatpak updates support for pat-aur.
	arch = any
	depends = ftxui
	depends = libutf8proc
	depends = pat-aur-client-git
	depends = flatpak
