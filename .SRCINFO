pkgbase = linuxvr-viewshot
	pkgdesc = Take photos in VR with a hand-frame gesture on Linux (WiVRn / Monado) - OpenXR API layer + desktop app
	pkgver = 1.0.1
	pkgrel = 1
	url = https://github.com/yakuda-stack/LinuxVR-ViewShot
	install = linuxvr-viewshot.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	depends = glibc
	depends = gcc-libs
	depends = vulkan-icd-loader
	depends = python
	depends = python-pyqt6
	depends = python-setproctitle
	depends = xcb-util-cursor
	depends = xcb-util-wm
	depends = xcb-util-image
	depends = xcb-util-keysyms
	depends = xcb-util-renderutil
	depends = libxkbcommon-x11
	optdepends = python-opencv: QR code detection in photos
	optdepends = python-onnxruntime-cpu: text recognition for the translation (plus "pip install --user rapidocr")
	optdepends = glib2: move deleted photos to the trash via gio (fallback)
	optdepends = wl-clipboard: copy from the VR panel when only the background service runs
	options = !lto
	source = linuxvr-viewshot-1.0.1.tar.gz::https://github.com/yakuda-stack/LinuxVR-ViewShot/archive/refs/tags/v1.0.1.tar.gz
	sha256sums = 24999437aabf78e66119511c59014302d63e0af743eda3750b53f02bba4e5cab

pkgname = linuxvr-viewshot
