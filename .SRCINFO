pkgbase = sjnmusic-gui-git
	pkgdesc = EGUI client for the sjnmusic music library daemon
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/serverjonas/SJNmusic
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = rust
	makedepends = git
	depends = gcc-libs
	depends = glibc
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxrandr
	depends = wayland
	options = !lto
	source = sjnmusic-gui-git::git+https://github.com/serverjonas/SJNmusic.git#branch=main
	sha256sums = SKIP

pkgname = sjnmusic-gui-git
