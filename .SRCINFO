	optdepends = noto-fonts-emoji: colour emoji in messages and reactions
	optdepends = ffmpeg: playing GIFs
	optdepends = xdg-desktop-portal: the file picker for attachments
	conflicts = fastsapp-bin
	conflicts = fastsapp-git
	options = !debug
	options = !lto
