	optdepends = libpulse: alarm sound playback fallback via paplay
	optdepends = libcanberra: alarm sound fallback via canberra-gtk-play
	optdepends = espeak-ng: spoken time-remaining alerts
	optdepends = speech-dispatcher: spoken alerts fallback via spd-say
	source = git+https://codeberg.org/LuminaNAO/limit-computer-time.git#tag=v2
	sha256sums = SKIP

pkgname = limit-computer-time
