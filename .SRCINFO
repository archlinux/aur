pkgbase = animalinux
	pkgdesc = Mascotas animadas para tu escritorio (Hyprland, KDE, GNOME…): reaccionan a tu PC, juegan y hasta te juegan un partido; con editor de píxeles y de animación
	pkgver = 0.8.4.5
	pkgrel = 1
	url = https://github.com/Sergi122/AnimalinuxApp
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-wheel
	makedepends = python-setuptools
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = python-pillow
	depends = python-numpy
	depends = python-xlib
	depends = gtk4-layer-shell
	depends = libayatana-appindicator
	optdepends = mpv: reproducción de audio en el editor de animación
	optdepends = ffmpeg: exportar animaciones como MP4 y stickers de Telegram
	optdepends = python-rembg: recorte de fondo con IA (requiere onnxruntime)
	optdepends = python-onnxruntime: motor IA para rembg
	optdepends = libwnck3: andar por bordes de ventana y pausa en pantalla completa (backend X11: GNOME/KDE/Xfce/MATE/Cinnamon)
	optdepends = ollama: hablar con la mascota usando IA local
	optdepends = ollama-cuda: la IA de la mascota en la tarjeta NVIDIA (mucho más rápida)
	optdepends = python-vosk: hablar con la mascota por voz («ey <nombre>» y micrófono)
	optdepends = python-faster-whisper: entender bien tu voz (si falta, la app lo instala sola con pip)
	optdepends = pipewire: leer el micrófono con pw-record (o pulseaudio/alsa-utils)
	source = animalinux-0.8.4.5.tar.gz::https://github.com/Sergi122/AnimalinuxApp/archive/v0.8.4.5.tar.gz
	sha256sums = 628fd3e3ed0ed1c53b1986d2d19dc8d621f94763905754fa6023643b50e58f66

