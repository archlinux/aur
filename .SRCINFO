	install = logitech-trueforce-dkms.install
	license = GPL-2.0-only
	depends = dkms
	depends = usbutils
	optdepends = oversteer: GUI to configure wheel settings
	optdepends = usb_modeswitch: switch an Xbox edition (G923 c26d, RS50 c275) into PC mode on plug-in
