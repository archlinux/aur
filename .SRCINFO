pkgbase = aura-emerge
	pkgdesc = Portage-like wrapper for Arch Linux using Aura
	pkgver = 1.32.0
	pkgrel = 1
	url = https://github.com/Undercat037/aura-emerge
	install = aura-emerge.install
	arch = x86_64
	license = GPL-3.0
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = aura
	optdepends = devtools: for --abs support (build from ABS source via pkgctl)
	optdepends = gnupg: for PGP verification when building from ABS
	provides = portageq
	conflicts = portage
	conflicts = portage-git
	backup = etc/emerge/world.set
	source = aura-emerge::git+https://github.com/Undercat037/aura-emerge.git#tag=v1.32.0
	sha256sums = aa406b7fd02f094c61d0b120fb7490fbce4503c04fb75bdc0e458eb4d0aa8e94

pkgname = aura-emerge
