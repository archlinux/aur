pkgbase = chatwithwork-desktop-git
	pkgdesc = Chat with Work Desktop: the desktop app, terminal interface and background agent (development version)
	pkgver = 0.7.0
	pkgrel = 1
	url = https://github.com/crmne/chatwithwork-desktop
	install = chatwithwork-desktop-git.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	makedepends = git
	makedepends = cargo
	makedepends = pkgconf
	makedepends = cmake
	makedepends = clang
	depends = alsa-lib
	depends = libpipewire
	depends = glibc
	depends = gcc-libs
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libayatana-appindicator
	depends = dbus
	optdepends = org.freedesktop.secrets: store the device key in your keyring
	optdepends = xdg-desktop-portal: native folder picker
	optdepends = sane: scan with a USB scanner
	optdepends = tesseract: make scans searchable (with tesseract-data-<language>)
	optdepends = systemd: start the agent now and at login with cww daemon install
	provides = cww
	provides = cww-app
	provides = chatwithwork-desktop
	conflicts = cww
	conflicts = chatwithwork-desktop
	conflicts = chatwithwork-desktop-bin
	options = !debug
	options = !lto
	source = chatwithwork-desktop-git::git+https://github.com/crmne/chatwithwork-desktop.git
	sha256sums = SKIP

pkgname = chatwithwork-desktop-git
