pkgbase = synergy1-bin
	pkgdesc = Keyboard and mouse sharing solution. Synergy allows you to share one mouse and keyboard between multiple computers. Work seamlessly across Windows, macOS and Linux.
	pkgver = 1.22.3
	pkgrel = 1
	url = https://symless.com/synergy
	arch = x86_64
	license = custom:Proprietary
	depends = glibc
	depends = hicolor-icon-theme
	depends = libei
	depends = libportal
	depends = libx11
	depends = libxext
	depends = libxi
	depends = libxinerama
	depends = libxkbfile
	depends = libxrandr
	depends = libxtst
	depends = openssl
	depends = qt6-base>=6.12.0
	conflicts = synergy
	conflicts = synergy1-bin
	conflicts = synergy-git
	conflicts = synergy-1.6
	conflicts = synergy2-bin
	conflicts = synergy3-bin
	conflicts = synergy3-beta-bin
	options = !strip
	options = !emptydirs

pkgname = synergy1-bin
