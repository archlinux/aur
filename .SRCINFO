pkgbase = ryuski-bin
	pkgdesc = Local, trainable command assistant with a CLI and QML plugin (prebuilt binary)
	pkgver = 0.0.5
	pkgrel = 1
	url = https://github.com/RyuZinOh/ryuSki
	install = ryuski.install
	arch = x86_64
	license = BSD-2-Clause
	depends = sqlite
	depends = qt6-declarative
	optdepends = kitty: default terminal for "go to <folder>" (override with $TERMINAL)
	optdepends = libpulse: paplay, needed for spoken replies
	optdepends = piper-tts: spoken replies (AUR, needs a Piper voice at ~/.local/share/ryuski/voice/ryuski.onnx)
	provides = ryuski=0.0.5
	conflicts = ryuski
	options = !debug
	source = ryuski-0.0.5-x86_64.tar.gz::https://github.com/RyuZinOh/ryuSki/releases/download/v0.0.5/ryuski-0.0.5-x86_64.tar.gz
	sha256sums = 9caeb7d5acd9018d31a1050f79d308cb61ef95eaf622d9eb281e4db554553f27

pkgname = ryuski-bin
