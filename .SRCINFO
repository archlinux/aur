pkgname = plasma-fusion
	pkgdesc = Plasma Fusion desktop for KDE Plasma 6 (themes, widgets, icons, fonts, setup tools)
	arch = any
	depends = plasma-workspace
	depends = plasma-desktop
	depends = libplasma
	depends = kwin
	depends = aurorae
	depends = plasma5support
	depends = kscreenlocker
	depends = breeze-icons>=6.30
	depends = kconfig
	depends = kdbusaddons
	depends = systemd
	depends = polkit
	depends = util-linux
	depends = bash
	depends = python
	depends = python-pillow
	depends = fontconfig
	depends = glib2
	optdepends = plasma-fusion-decoration: the Plasma Fusion window decoration
	optdepends = plasma-fusion-settings: the Plasma Fusion page in System Settings
	optdepends = plasma-fusion-navigation: tablet navigation gestures (convertibles)
	optdepends = pyside6: draw app icons with QtSvg (else librsvg)
	optdepends = librsvg: draw app icons when pyside6 is missing
	optdepends = plasma-keyboard: on-screen keyboard in tablet posture
	optdepends = xournalpp: notes and whiteboard tiles of the pen menu
	optdepends = kate: the design's Code app
	optdepends = marknote: the design's Notes app
	optdepends = konsole: terminal theme
	optdepends = libnotify: login check notification
	optdepends = plasma-nm: network tile
	optdepends = plasma-pa: volume tile
	optdepends = bluedevil: Bluetooth tile
	optdepends = powerdevil: brightness, battery and power profile tiles
	optdepends = kdeconnect: phone tile

pkgname = plasma-fusion-decoration
	pkgdesc = Plasma Fusion window decoration (KDecoration3 plugin)
