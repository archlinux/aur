pkgbase = cone-simple
	pkgdesc = Curses text-based mail client - inspired by Alpine - handles multiple IMAP, POP3 accounts, and local mail folders. Contains a simple newsreader. This version has no dependencies to courier libraries (other than the mandatory courier-unicode).
	pkgver = 2.5
	pkgrel = 1
	url = http://courier-mta.org/cone/
	arch = i686
	arch = x86_64
	license = GPL-3.0-only
	makedepends = procps-ng
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = libxml2
	depends = libidn2
	depends = libldap
	depends = courier-unicode
	depends = ncurses
	depends = openssl
	provides = cone
	source = https://sourceforge.net/projects/courier/files/cone/2.5/cone-2.5.tar.bz2
