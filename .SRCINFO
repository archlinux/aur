pkgbase = xviewer-minimal
	pkgdesc = GTK3 image viewer with printing, without plugins or Cinnamon integration
	pkgver = 2.6.2
	pkgrel = 2
	url = https://github.com/linuxmint/xviewer
	arch = x86_64
	license = GPL-2.0-or-later
	makedepends = glib2-devel
	makedepends = gnome-common
	makedepends = libxml2
	depends = at-spi2-core
	depends = cairo
	depends = dconf
	depends = gdk-pixbuf2
	depends = glib2
	depends = glibc
	depends = gsettings-desktop-schemas
	depends = gtk3
	depends = hicolor-icon-theme
	depends = zlib
	optdepends = cups: local print server, not required for PDF or a remote CUPS server
	provides = xviewer=2.6.2
	conflicts = xviewer
	options = !debug
