pkgbase = ratarmount
	pkgdesc = Mount tar files via fusepy. Supports Recursive Mounting, Compressed Files, Read-Only Bind Mounting, Union Mounting and Write Overlays. A fast random access alternative to archivemount.
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/mxmlnkn/ratarmount
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	depends = python>=3.9
	depends = python-mfusepy
	depends = python-rapidgzip
	depends = python-indexed-gzip
	depends = python-xz
	depends = python-indexed-zstd
	depends = python-rich
	depends = python-rich-argparse
	depends = fuse2>=2.9
	depends = python-rarfile
	depends = python-libarchive-c
	optdepends = python-py7zr: Support for password-protected 7z archives.
	optdepends = python-ext4: Support for EXT4 images.
	optdepends = python-fsspec: Support for remote files.
	optdepends = python-aiohttp: Support for http:// via fsspec.
	optdepends = python-requests: Support for various web backends such as github:// via fsspec.
	optdepends = python-s3fs: Support for s3:// via fsspec.
	optdepends = python-smbprotocol: Support for smb:// via fsspec.
	optdepends = python-webdav4: Support for webdav:// via fsspec.
