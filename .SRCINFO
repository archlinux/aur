pkgbase = uq
	pkgdesc = Themeable Hyprland desktop: shell, theme and layout daemon, CLI and base config
	pkgver = 0.2.1
	pkgrel = 1
	url = https://github.com/asafelobotomy/uq
	arch = x86_64
	license = MIT
	checkdepends = lua
	checkdepends = qt6-declarative
	makedepends = cargo
	depends = uq-hyprland-pin
	depends = dbus
	depends = glib2
	depends = qt6ct
	depends = gcc-libs
	depends = quickshell>=0.3.1
	depends = quickshell<0.4
	depends = brightnessctl
	depends = upower
	depends = systemd
	depends = noto-fonts-emoji
	optdepends = kitty: default terminal (SUPER+Return)
	optdepends = papirus-icon-theme: icon theme used by every uQ theme
	optdepends = bibata-cursor-theme: cursor theme used by every uQ theme
	optdepends = ttf-jetbrains-mono: monospace font
	optdepends = inter-font: interface font
	optdepends = wireplumber: volume keys
	optdepends = playerctl: media keys
	optdepends = networkmanager: network status in the shell
	optdepends = scdr: CPU priorities for the focused app and builds (enable scdr-session; uQ starts it)
	optdepends = tailscale: exit-node and VPN status in the shell
	optdepends = bluez: Bluetooth status in the shell
	optdepends = power-profiles-daemon: power profile switching
	optdepends = hyprlock: fallback lock for the SUPER+CTRL+L recovery bind
	optdepends = noti-fi: notification backend
	optdepends = fprintd: fingerprint unlock
	optdepends = crum-bs: uninstall apps with their leftovers and clean up storage
	options = !lto
	backup = etc/pam.d/uq-lock
	backup = etc/pam.d/uq-lock-fingerprint
	source = uq-0.2.1.tar.gz::https://github.com/asafelobotomy/uq/releases/download/v0.2.1/uq-0.2.1.tar.gz
	sha256sums = c87c9d3b7770df91e20b568a3383933371c1c63cbd5750ed8ac12d4069f1ef54

pkgname = uq
