pkgbase = shelly-cli
	pkgver = 3.1.0r4339.gb054d8d
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/Shelly-ALPM
	arch = x86_64
	license = GPL-3.0-only
	makedepends = git
	makedepends = pkgconf
	makedepends = zig>=0.16.0
	makedepends = flatpak
	makedepends = ripgrep
	makedepends = go-md2man
	conflicts = shelly
	conflicts = shelly-git
	conflicts = shelly-bin
	source = shelly-cli::git+https://github.com/Seafoam-Labs/Shelly-ALPM.git#branch=development
	sha256sums = SKIP

pkgname = shelly-cli
	pkgdesc = Native Shelly package-manager CLI beta
	depends = diffutils
	depends = git
	depends = glibc
	depends = libarchive
	depends = pacman
	depends = sudo
	optdepends = base-devel: build and install AUR packages
	optdepends = devtools: build AUR packages in a clean chroot
	optdepends = desktop-file-utils: update AppImage desktop entries
	optdepends = fuse2: run AppImages that require FUSE 2
	optdepends = shelly-cli-flatpak-backend: Flatpak package management support
	optdepends = gtk-update-icon-cache: update AppImage icons
	optdepends = opendoas: alternative privilege elevator to sudo
	optdepends = plocate: locate-based pacfile discovery
	optdepends = vim: default visual pacfile diff viewer
	provides = shelly-beta

pkgname = shelly-cli-flatpak-backend
	pkgdesc = Optional native Flatpak backend for the Shelly CLI beta
	depends = shelly-cli=3.1.0r4339.gb054d8d-1
	depends = flatpak
	optdepends = 
	provides = shelly-flatpak-backend=3.1.0r4339.gb054d8d
	conflicts = shelly-flatpak-backend
	conflicts = shelly-flatpak-backend-git
	conflicts = shelly-flatpak-backend-bin
