	depends = playerctl
	depends = networkmanager
	depends = bluez
	depends = python
	depends = git
	optdepends = grim: settings-panel/verification screenshots
	optdepends = lm_sensors: CPU temperature in Control Center
	optdepends = wf-recorder: Control Center RECORD action tile
	optdepends = hyprpicker: Control Center COLOR action tile
	optdepends = kitty: themed by the wallpaper-driven color pipeline
	optdepends = gtk3: themed by the wallpaper-driven color pipeline
	optdepends = gtk4: themed by the wallpaper-driven color pipeline
	optdepends = qt6ct: themed by the wallpaper-driven color pipeline
	optdepends = yazi: themed by the wallpaper-driven color pipeline
	optdepends = btop: themed by the wallpaper-driven color pipeline
	optdepends = starship: themed by the wallpaper-driven color pipeline
	optdepends = vesktop: themed by the wallpaper-driven color pipeline
	optdepends = sddm: crux ships a matching SDDM login theme (not installed by this package — see the crux repos SKILL.md/notes.md for the manual system-wide setup)
	provides = crux-shell
	conflicts = crux-shell
	source = crux-shell-git::git+https://github.com/teezlabs/crux-shell.git
