pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.19
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.19-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.19-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.19-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.19-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.19-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.19-1-x86_64.pkg.tar.zst
	sha256sums = b58fa668e3048350bface72fbf1cc8f1dc93d11fa7f097e2d9f98e48c49669d4
	sha256sums = 275fa2db4c2eb2cd6378c391790a79d8f57fefa3676f39d6c8ee66eef1e86c66
	sha256sums = 73996c1a267c206acac68c177949753c7c3cd059ce90c0a745f2015d380c1cf9

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.19-1-lts-bin
	depends = linux6.12.19-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.19-1-lts-headers-bin
	depends = linux6.12.19-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.19-1-lts-docs-bin
	depends = linux6.12.19-1-lts-docs-bin

pkgname = linux6.12.19-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.19-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.19-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.19-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.19-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.19-1-lts
	conflicts = linux-lts-docs
