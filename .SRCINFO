pkgbase = universe-bin
	pkgdesc = Gamepad-first game launcher: a Rust core, a PySide6 UI, games inside gamescope (prebuilt release)
	pkgver = 0.0.8
	pkgrel = 1
	url = https://github.com/ilyasturki/universe
	arch = x86_64
	license = MIT
	makedepends = python-installer
	options = !debug
	options = !strip
	source = universe-bin-0.0.8.tar.gz::https://github.com/ilyasturki/universe/releases/download/v0.0.8/universe-x86_64-linux.tar.gz
	source = metadata-0.0.8.json::https://github.com/ilyasturki/universe/raw/v0.0.8/extension/metadata.json
	source = extension-0.0.8.js::https://github.com/ilyasturki/universe/raw/v0.0.8/extension/extension.js
	sha256sums = 3292b16b22c1e3b9bcc1533b569f83b31b60f3179189324d5ac6cce75df5c0b9
	sha256sums = 0cb757833aaea7e1944b1e1801c99f7cae37e65ebd93776f3a54996d34de8162
	sha256sums = 4da584841b0ced9e6739bee12916f1b439cf740760a3b366840291fae56b4a3e

pkgname = universe-bin
	depends = libgcc
	depends = glibc
	depends = hicolor-icon-theme
	depends = python
	depends = pyside6>=6.11
	depends = python-pysdl2
	depends = python-qrcode
	depends = python-xkbcommon
	depends = qt6-5compat
	depends = qt6-declarative
	depends = qt6-imageformats
	depends = qt6-multimedia
	depends = qt6-svg
	depends = qt6-wayland
	depends = sdl2
	depends = systemd
	optdepends = gamescope: games run inside it
	optdepends = mangohud: the frame rate limit and the in-game HUD
	optdepends = lib32-mangohud: the HUD in 32-bit games, Proton's included
	optdepends = umu-launcher: Proton launches; fetched on first use when missing
	optdepends = heroic-gogdl: the GOG source; fetched on first use when missing
	optdepends = legendary: the Epic Games source; fetched on first use when missing
	optdepends = butler: the itch.io source; fetched on first use when missing
	optdepends = steam: the Steam source
	optdepends = gpu-screen-recorder: the capture module's recordings
	optdepends = ffmpeg: the capture module's thumbnails and cuts
	optdepends = trash-cli: recordings deleted to the trash
	optdepends = game-devices-udev: /dev/uinput for the controller's key macros
	optdepends = grim: screenshots on sway, hyprland and niri
	optdepends = spectacle: screenshots on KDE Plasma
	optdepends = universe-desktop-bin: the library in a GTK app for mouse and keyboard
	provides = universe=0.0.8
	conflicts = universe

pkgname = universe-desktop-bin
	pkgdesc = The Universe game library for mouse and keyboard: a GTK 4 and libadwaita app (prebuilt release)
	depends = libgcc
	depends = glibc
	depends = gst-plugins-base
	depends = gst-plugins-good
	depends = gtk4>=1:4.22
	depends = hicolor-icon-theme
	depends = libadwaita>=1:1.9
	depends = universe=0.0.8
	optdepends = gst-libav: recordings played in the app (H.264, HEVC)
	optdepends = gst-plugins-bad: recordings played in the app (AV1, VA-API)
	provides = universe-desktop=0.0.8
	conflicts = universe-desktop
