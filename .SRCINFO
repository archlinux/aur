pkgbase = course2md-bin
	pkgdesc = Turn online course videos (YouTube/Bilibili/local) into image+transcript markdown/html notes
	pkgver = 3.0.0
	pkgrel = 1
	url = https://github.com/mizorewww/course2md
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = ffmpeg
	depends = yt-dlp
	depends = aria2
	optdepends = llama-cpp: local GPU/CPU ASR via llama-server
