pkgbase = course2md-bin
	pkgdesc = Turn online course videos (YouTube/Bilibili/local) into image+transcript markdown/html notes
	pkgver = 3.0.1
	pkgrel = 1
	url = https://github.com/mizorewww/course2md
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = ffmpeg
	depends = yt-dlp
	depends = aria2
	optdepends = llama-cpp: local GPU/CPU ASR via llama-server
	optdepends = ggml-vulkan: GPU ASR via Vulkan (also install the Vulkan driver for your GPU)
	optdepends = ggml-cuda: alternative GPU ASR backend for NVIDIA GPUs
	optdepends = intel-npu-driver: Intel Core Ultra NPU acceleration driver
	optdepends = openvino-intel-npu-plugin: Intel Core Ultra NPU OpenVINO plugin
	optdepends = python-openvino: OpenVINO Python runtime for NPU
	provides = course2md
	conflicts = course2md
