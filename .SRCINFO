pkgbase = podman-bcachefs-bin
	pkgdesc = A tool for managing OCI containers and pods, with the bcachefs graphdriver compiled in
	pkgver = 6.1.2
	pkgrel = 1
	url = https://github.com/ticpu/bcachefs-storage-driver
	arch = x86_64
	license = Apache-2.0
