	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.19.12.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.19.12.zen1-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.19.12.zen1-1-x86_64.pkg.tar.zst
	options = !strip
