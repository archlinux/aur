pkgbase = uur
	pkgdesc = Native Linux companion for NetEase UU Remote (X11/Wayland input and capture bridge)
	pkgver = 0.1.1
	pkgrel = 1
	url = https://github.com/panxuc/uur
	install = uur.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = gcc
	makedepends = pkgconf
	makedepends = mingw-w64-gcc
	makedepends = mingw-w64-binutils
	depends = glibc
	depends = gcc-libs
	depends = glib2
	depends = wine
	depends = curl
	depends = pipewire
	depends = xdg-desktop-portal
	optdepends = osslsigncode: Authenticode verification of official updater downloads
	optdepends = xdg-desktop-portal-gnome: GNOME, niri, and compatible Wayland capture/input
	optdepends = xdg-desktop-portal-kde: KDE Plasma Wayland capture/input
	optdepends = xdg-desktop-portal-hyprland: Hyprland screen capture (input uses uinput)
	optdepends = xdg-desktop-portal-wlr: wlroots screen capture (input uses uinput)
	optdepends = xwayland-satellite: X11 application support on niri
	optdepends = ethtool: inspect and configure Wake-on-LAN
	optdepends = networkmanager: persist Wake-on-LAN for NetworkManager connections
	optdepends = pulseaudio: legacy PulseAudio server for Wine audio
	optdepends = pipewire-pulse: PulseAudio-compatible Wine audio on PipeWire
	optdepends = libva-utils: VA-API capability diagnostics
	optdepends = vulkan-tools: Vulkan and Vulkan Video capability diagnostics
	optdepends = nvidia-utils: NVENC and NVDEC capability diagnostics on NVIDIA GPUs
