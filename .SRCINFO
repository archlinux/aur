	provides = onnxruntime-provider-cuda13=1.29.0
	conflicts = onnxruntime-provider-cuda
	conflicts = onnxruntime-provider-cuda13
	conflicts = onnxruntime-core-nccloff

pkgname = onnxruntime-provider-tensorrt-cuda13
	pkgdesc = The TensorRT execution provider of ONNX Runtime, for onnxruntime-core (NVIDIA GPUs)
	depends = onnxruntime-core=1.29.0-7
	depends = onnxruntime-provider-cuda13=1.29.0
	depends = glibc
