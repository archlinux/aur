pkgbase = linux-hardened-versioned-bin
	pkgdesc = The Security-Hardened Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.10.3.hardened1
	pkgrel = 1
	url = https://github.com/anthraxx/linux-hardened
	arch = x86_64
	license = GPL2
	noextract = linux-hardened-6.10.3.hardened1-1-x86_64.pkg.tar.zst
	noextract = linux-hardened-headers-6.10.3.hardened1-1-x86_64.pkg.tar.zst
	noextract = linux-hardened-docs-6.10.3.hardened1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-hardened-6.10.3.hardened1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-hardened-headers-6.10.3.hardened1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-hardened-docs-6.10.3.hardened1-1-x86_64.pkg.tar.zst
