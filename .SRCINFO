pkgbase = mkinitcpio-zerotier
	pkgdesc = mkinitcpio hook that initialises ZeroTier One to assist in the remote unlocking of encrypted partitions
	pkgver = 1.2.2
	pkgrel = 1
	url = https://gitlab.archlinux.org/alphajack/mkinitcpio-zerotier
	install = mkinitcpio-zerotier.install
	arch = any
	license = GPL-3.0-or-later
	depends = bash
	depends = mkinitcpio
	depends = zerotier-one
	optdepends = mkinitcpio-systemd-extras: network connectivity and SSH server (systemd initrd)
	optdepends = mkinitcpio-netconf: network connectivity (busybox initrd)
	optdepends = mkinitcpio-tinyssh: SSH server (busybox initrd)
	optdepends = mkinitcpio-dropbear: SSH server (busybox initrd)
	optdepends = mkinitcpio-utils: encryptssh hook for remote unlocking (busybox initrd)
	optdepends = binutils: inspection of unified kernel images in check-initcpio-zerotier
	backup = var/lib/zerotier-one/initcpio/config.ini
	source = mkinitcpio-zerotier-1.2.2.tar.gz::https://gitlab.archlinux.org/alphajack/mkinitcpio-zerotier/-/archive/v1.2.2/mkinitcpio-zerotier-v1.2.2.tar.gz
