pkgbase = wowtype
	pkgdesc = WeType 风格的拼音输入法：fcitx5 插件 + Rust 引擎（长句、半成品输入、纠错、学习）
	pkgver = 0.7.14
	pkgrel = 1
	url = https://github.com/Gloridust/WowType
	install = wowtype.install
	arch = x86_64
	license = MIT OR Apache-2.0
	license = Apache-2.0
	license = GPL-3.0-only
	license = CC-BY-SA-4.0
	license = Unicode-3.0
	license = LGPL-3.0-only
	license = LicenseRef-CC-BY-2.0-FR
	makedepends = cargo
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = pkgconf
	makedepends = git
	depends = fcitx5
	depends = alsa-lib
	depends = glibc
	depends = gcc-libs
	depends = python
	optdepends = fcitx5-gtk: GTK 应用输入法模块
	optdepends = fcitx5-qt: Qt 应用输入法模块
	optdepends = python-gobject: 设置界面 wowtype-config
	optdepends = python-cairo: 打字统计图表
	optdepends = gtk4: 设置界面
	optdepends = libadwaita: 设置界面
	optdepends = noto-fonts-emoji: 候选里的彩色 emoji
	optdepends = curl: 互译模式、跨设备复制粘贴的自建中转，以及首次使用离线语音时下载模型
	optdepends = unzip: 解压离线语音模型
	noextract = wowtype-data-rime-ice-2026.11.11.8.tar.gz
	options = !lto
	source = wowtype::git+https://github.com/Gloridust/WowType.git#tag=v0.7.14
