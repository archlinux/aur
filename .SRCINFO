pkgbase = speshell-git
	pkgdesc = A desktop shell built with Quickshell: a bar and its panels, a launcher, and animated themes
	pkgver = r23.g10196ac
	pkgrel = 1
	url = https://github.com/vcoscrato/speshell
	arch = any
	license = MIT
	makedepends = git
	makedepends = just
	makedepends = qt6-shadertools
	depends = bash
	depends = bluez
	depends = coreutils
	depends = jq
	depends = libnotify
	depends = networkmanager
	depends = pipewire
	depends = procps-ng
	depends = polkit
	depends = pyalpm
	depends = python
	depends = quickshell>=0.3.0
	depends = sudo
	depends = systemd
	depends = upower
	depends = util-linux
	depends = which
	depends = wireplumber
	optdepends = hyprland: workspaces in the bar and the Displays panel
	optdepends = curl: downloading the dictation model
	optdepends = paru: AUR packages in speshell system (or yay)
	optdepends = brightnessctl: brightness and keyboard backlight controls, and dimming on idle
	optdepends = power-profiles-daemon: the system power profile following the power mode
	optdepends = cliphist: clipboard history
	optdepends = greetd: the login screen
	optdepends = matugen: theming other apps from the Speshell palette
	optdepends = openconnect: OpenConnect VPN logins
	optdepends = libsecret: remembering VPN passwords in the keyring
	optdepends = grim: screenshot, copy text, and scan code tools
	optdepends = hyprpicker: pick color tool
	optdepends = slurp: area selection for the screenshot, copy text, record, and scan code tools
	optdepends = swappy: annotating screenshots
	optdepends = tesseract: copy text tool (with a tesseract-data package per language)
	optdepends = wf-recorder: record tool
	optdepends = pipewire-audio: dictation tool, recording the microphone
	optdepends = whisper-cpp: dictation tool
	optdepends = wl-clipboard: clipboard capture, copy actions, and the tools
	optdepends = wtype: dictation tool, typing the text
	optdepends = zbar: scan code tool
	optdepends = xdg-utils: opening the config when VISUAL and EDITOR are unset or no terminal is found
	provides = speshell
	conflicts = speshell
	source = speshell::git+https://github.com/vcoscrato/speshell.git
	sha256sums = SKIP

pkgname = speshell-git
