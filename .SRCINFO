pkgbase = voxtype-cuda
	pkgdesc = Pure CUDA version of the push-to-talk voice-to-text tool
	pkgver = 1.0.1
	pkgrel = 1
	url = https://voxtype.io
	install = voxtype-cuda.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = clang
	makedepends = cmake
	makedepends = cuda
	makedepends = git
	makedepends = pkgconf
	makedepends = gtk4
	makedepends = gtk4-layer-shell
	makedepends = onnxruntime-cuda
	makedepends = gtk4-layer-shell
	depends = alsa-lib
	depends = cuda
	depends = curl
	depends = gcc-libs
	depends = glibc
	optdepends = dotool: keyboard simulation with layout support (KDE/GNOME compatible)
	optdepends = libnotify: desktop notifications
	optdepends = onnxruntime-cuda: required for ONNX engines
	optdepends = onnxruntime-opt-cuda: required for ONNX engines (with CUDA and AVX2 CPU optimizations)
	optdepends = ollama: local AI summarization for meeting mode
	optdepends = pipewire: audio server (recommended)
	optdepends = pipewire-alsa: ALSA compatibility for PipeWire (required if using PipeWire)
	optdepends = pulseaudio: audio server (alternative to PipeWire)
	optdepends = wl-clipboard: clipboard support
	optdepends = wtype: keyboard simulation for Wayland (recommended, best CJK support)
	optdepends = ydotool: keyboard simulation fallback (X11/TTY support)
	provides = voxtype
	conflicts = voxtype
	backup = etc/voxtype/config.toml
	source = voxtype-1.0.1.tar.gz::https://github.com/peteonrails/voxtype/archive/refs/tags/v1.0.1.tar.gz
	source = voxtype-1.0.1.tar.gz.asc::https://github.com/peteonrails/voxtype/releases/download/v1.0.1/voxtype-1.0.1.tar.gz.asc
	validpgpkeys = 9CCF7915B750CAE8B095ED1AA3FC9F33FD209279
	sha256sums = a4d0a256167f58ce90153077da82620794422f5172c918625d480ff9ffca625e
	sha256sums = SKIP

pkgname = voxtype-cuda
