pkgbase = stoat-server
	pkgdesc = Stoat chat server
	pkgver = 0.16.2
	pkgrel = 1
	url = https://stoat.chat
	arch = x86_64
	license = AGPL-3.0-or-later
	makedepends = git
	makedepends = rust>=1.92.0
	makedepends = pkgconf
	makedepends = cmake
	depends = bash
	depends = coreutils
