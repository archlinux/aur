pkgbase = hornero-config
	pkgdesc = HorneroOS curated desktop defaults (compositor, terminal, GTK, fonts, XDG handlers)
	pkgver = 0.3.17
	pkgrel = 1
	url = https://github.com/HorneroOS/config
	install = hornero-config.install
	arch = any
	license = MIT
	license = CC-BY-2.0
	license = CC-BY-SA-4.0
	makedepends = librsvg
	depends = bash
	depends = git
	depends = python
	depends = python-materialyoucolor
	optdepends = hyprland: compositor defaults under /etc/xdg/hypr
	optdepends = niri: compositor defaults in /etc/niri (fallback) and ~/.config/niri
	optdepends = xdg-desktop-portal-gtk: default fallback portal and file chooser for Niri sessions
	optdepends = xdg-desktop-portal-gnome: screencasting portal for Niri sessions
	optdepends = xwayland-satellite: XWayland bridge for Niri sessions
	optdepends = kitty: terminal defaults under /etc/xdg/kitty
	optdepends = alacritty: optional terminal with factory defaults under /etc/alacritty
	optdepends = ghostty: optional terminal; Hornero defaults are seeded for new users and themes are installed system-wide
	optdepends = exo: Hornero default application launcher and TerminalEmulator helper
	optdepends = gtk3: GTK 3 defaults under /etc/xdg/gtk-3.0
	optdepends = fontconfig: font defaults under /etc/xdg/fontconfig
	optdepends = fastfetch: system info defaults under /etc/xdg/fastfetch
	optdepends = btop: monitor defaults under /etc/xdg/btop
	optdepends = cava: visualizer defaults under /etc/xdg/cava
	optdepends = thunar: file manager defaults under /etc/xdg/Thunar
	optdepends = copyq: clipboard defaults under /etc/xdg/copyq
	optdepends = handlr: default-application handler under /etc/xdg/handlr
	optdepends = qt6ct: Qt6 platform-theme defaults under /etc/xdg/qt6ct
	optdepends = bluez: Bluetooth daemon (factory main.conf template under /usr/share/hornero/bluetooth)
	optdepends = bluez-utils: bluetoothctl for Bluetooth diagnostics
	optdepends = wireplumber: Bluetooth audio policy under /etc/wireplumber/wireplumber.conf.d
	optdepends = papirus-icon-theme: Papirus-Dark factory icons
	optdepends = ttf-material-symbols-variable: Material Symbols shell icon font
	optdepends = ttf-cascadia-code-nerd: CaskaydiaCove NF factory monospace font
	optdepends = noto-fonts-cjk: CJK fallback for the factory fontconfig aliases
	optdepends = noto-fonts-emoji: emoji fallback for the factory fontconfig aliases
	optdepends = zsh-autosuggestions: optional plugin sourced by the factory zshrc when installed
	optdepends = zsh-syntax-highlighting: optional plugin sourced by the factory zshrc when installed
	optdepends = gvfs: Thunar volume and trash integration
	optdepends = tumbler: Thunar thumbnail service
	optdepends = ffmpegthumbnailer: video thumbnails for Thunar via tumbler
	optdepends = thunar-volman: removable-media handling for Thunar
	optdepends = nm-connection-editor: NetworkManager connection editor
	backup = etc/wireplumber/wireplumber.conf.d/51-hornero-bluetooth.conf
	source = config::git+https://github.com/HorneroOS/config.git#commit=42cefcc6974fa5ad0900e0e4de4bd0de5dee3963
	sha256sums = SKIP

pkgname = hornero-config
