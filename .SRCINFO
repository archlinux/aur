pkgname = linux-stub
	pkgdesc = kernel and modules for the Linux kernel, with initramfs dependency made optional and CONFIG_DEV_BLK_NVME=y.
	depends = coreutils
	depends = kmod
	optdepends = linux-stub-headers: headers and scripts for building modules
	optdepends = initramfs: for early-userspace boot support
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = virtualbox-guest-modules-arch
	provides = wiregard-arch

pkgname = linux-stub-headers
	pkgdesc = Headers and scripts for building modules for the Linux kernel, with initramfs dependency made optional and CONFIG_DEV_BLK_NVME=y.
	depends = binutils
	depends = glibc
	depends = libelf
	depends = lbgcc
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
