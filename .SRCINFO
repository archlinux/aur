pkgbase = keymux
	pkgdesc = Keyboard middleware for gaming with low-level input interception
	pkgver = 1.3.0
	pkgrel = 1
	url = https://github.com/fibsussy/keymux
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = udev
	depends = libevdev
	optdepends = systemd: for systemd service files (or use OpenRC/runit scripts)
	optdepends = openrc: for OpenRC init scripts
	optdepends = runit: for runit service directories
	optdepends = niri: automatic game mode detection in Niri compositor
	optdepends = hyprland: automatic game mode detection in Hyprland compositor
	optdepends = sway: automatic game mode detection in Sway compositor
	optdepends = i3-wm: automatic game mode detection in i3 window manager
	optdepends = bspwm: automatic game mode detection in bspwm window manager
	options = !debug
	source = https://github.com/fibsussy/keymux/releases/download/v1.3.0/keymux-1.3.0-x86_64.tar.gz
	source = LICENSE::https://raw.githubusercontent.com/fibsussy/keymux/v1.3.0/LICENSE
