	pkgrel = 1
	url = https://github.com/prankstr/vibepanel
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = rust
	makedepends = pkg-config
	depends = gtk4
	depends = gtk4-layer-shell
	depends = libpulse
	depends = upower
	depends = networkmanager
	depends = bluez
	depends = systemd-libs
