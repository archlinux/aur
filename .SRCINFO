	depends = qt6-5compat
	depends = qt6-base
	depends = qt6-declarative
	depends = pam
	depends = wayland
	depends = bash
	depends = glibc
	depends = libgcc
	depends = libstdc++
	optdepends = curl: remote video pack downloader
	optdepends = python: remote video pack downloader
	optdepends = tar: remote video pack downloader
