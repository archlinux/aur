pkgbase = genoma
	pkgdesc = A Wayland shell toolkit: a Rust core drawing through Vulkan, interfaces written in Luau and reloaded live
	pkgver = 0.1.17
	pkgrel = 1
	url = https://github.com/AkusenArcade/Genoma
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = clang
	depends = gcc-libs
	depends = glibc
	depends = wayland
	depends = libxkbcommon
	depends = vulkan-icd-loader
	depends = vulkan-driver
	depends = libpipewire
	depends = pam
	optdepends = udisks2: removable drives (@genoma/drives)
	optdepends = ddcutil: external monitors in @genoma/brightness
	optdepends = accountsservice: users and their pictures (@genoma/accounts)
	optdepends = xdg-desktop-portal: appearance settings, file chooser (@genoma/portal)
	optdepends = wl-screenrec: screen recording (@genoma/kit/record)
	optdepends = wf-recorder: screen recording without wl-screenrec
	options = !lto
