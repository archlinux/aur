pkgbase = dbar-bin
	pkgdesc = A small, event-driven Wayland status bar for Sway and SwayFX (prebuilt)
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/dborovcanin/dbar
	arch = x86_64
	license = Apache-2.0
	depends = glibc
	depends = libgcc
	depends = libpipewire
