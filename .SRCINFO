pkgbase = bayestraits
	pkgdesc = A computer package for performing analyses of trait evolution among groups of species for which a phylogeny or sample of phylogenies is available
	pkgver = 5.0.3
	pkgrel = 1
	url = http://www.evolution.reading.ac.uk/BayesTraits.html
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = gcc
	makedepends = nlopt
	makedepends = gsl
	makedepends = git
	source = git+https://github.com/AndrewPMeade/BayesTraits-Release.git
	sha256sums = SKIP

pkgname = bayestraits
	depends = nlopt
	depends = gsl
	depends = cblas
	depends = glibc
	depends = gcc-libs

pkgname = bayestraits-mpi
	depends = nlopt
	depends = openmpi
	depends = gsl
	depends = cblas
	depends = glibc
	depends = gcc-libs
