pkgname = linux-bcachefs-git
	pkgdesc = The Linux kernel and modules ~ featuring Kent Overstreet's bcachefs filesystem
	depends = coreutils
	depends = initramfs
	depends = kmod
	depends = bcachefs-tools
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-bcachefs-git-headers
	pkgdesc = Headers and scripts for building modules for the Linux kernel ~ featuring Kent Overstreet's bcachefs filesystem
	depends = pahole
