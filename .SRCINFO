pkgbase = offpunk
	pkgdesc = Command-line and offline-centric browser for the web and various smolnet protocols
	pkgver = 3.2
	pkgrel = 1
	url = https://git.sr.ht/~lioploum/offpunk
	install = offpunk.install
	arch = any
	license = AGPL-3.0-or-later
	makedepends = coreutils
	makedepends = git
	makedepends = python-build
	makedepends = python-hatch-requirements-txt
	makedepends = python-installer
	makedepends = python-wheel
	depends = file
	depends = less
	depends = python
	optdepends = xdg-utils: xdg-open opens a URL in the preferred application (Highly recommended)
	optdepends = python-cryptography: better support of TOFU client certificates
	optdepends = curl: for web browsing - HTTP(s) requests
	optdepends = python-feedparser: for web browsing - atom/RSS feeds
	optdepends = python-beautifulsoup4: for web browsing - HTML parsing
	optdepends = python-readability-lxml: for web browsing - HTML parsing
	optdepends = chafa: chafa and ansiwrap are required to render images in terminal
	optdepends = python-setproctitle: allows offpunk to change its process title
	optdepends = xclip: copies text to/from the X11 clipboard
	optdepends = xsel: copies text to/from the X11 clipboard (alternative)
	optdepends = wl-clipboard: copies text to/from the Wayland clipboard
	optdepends = python-charset-normalizer: detect text encoding in some cases
	optdepends = ftr-site-config: Full-Text-RSS site-specific text extraction rules
	provides = ansicat
	provides = netcache
	provides = offpunk
	provides = openk
	provides = unmerdify
	provides = xkcdpunk
	conflicts = ansicat
	conflicts = netcache
	conflicts = offpunk
	conflicts = openk
	conflicts = unmerdify
	conflicts = xkcdpunk
	noextract = offpunk
	options = !strip
	source = git+https://git.sr.ht/~lioploum/offpunk#tag=v3.2
	sha256sums = SKIP

pkgname = offpunk
