pkgbase = linux-zen-bmq
	pkgver = 6.10.1.zen1
	pkgrel = 1
	url = https://www.kernel.org/
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = cpio
	makedepends = gettext
	makedepends = libelf
	makedepends = pahole
	makedepends = perl
	makedepends = python
	makedepends = tar
	makedepends = xz
	makedepends = kmod
	makedepends = xmlto
	makedepends = graphviz
	makedepends = imagemagick
	makedepends = python-sphinx
	makedepends = python-yaml
	makedepends = texlive-latexextra
	makedepends = bison
	makedepends = flex
	makedepends = zstd
	makedepends = make
	makedepends = patch
	makedepends = gcc
	makedepends = gcc-libs
	makedepends = glibc
	makedepends = binutils
	makedepends = git
	options = !debug
	options = !strip
	source = https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.10.1.tar.xz
	source = https://github.com/zen-kernel/zen-kernel/releases/download/v6.10.1-zen1/linux-v6.10.1-zen1.patch.zst
