pkgbase = mingw-w64-qt5-base
	pkgdesc = A cross-platform application and UI framework, native OpenGL backend (mingw-w64)
	pkgver = 5.15.16+kde+r130
	pkgrel = 1
	url = https://www.qt.io/
	arch = i686
	arch = x86_64
	groups = mingw-w64-qt5
	license = GPL3
	license = LGPL3
	license = FDL
	license = custom
	makedepends = mingw-w64-gcc
