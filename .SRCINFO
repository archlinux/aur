pkgbase = kiri-bin
	pkgdesc = Tiny, fast container runtime speaking the Docker API
	pkgver = 0.1.17
	pkgrel = 1
	url = https://runkiri.com
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	noextract = kiri-0.1.17-x86_64.deb
	noextract = kiri-0.1.17-aarch64.deb
	noextract = kiri-lite-0.1.17-x86_64.deb
	noextract = kiri-lite-0.1.17-aarch64.deb
	options = !strip
	options = !debug
	source = kiri.sysusers
	source = kiri-path.sh
	source = kiri.install
