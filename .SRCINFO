pkgbase = dux-files-bin
	pkgdesc = File manager for Wayland from Dux Labs (prebuilt binary)
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/duxlabs-dev/dux-files
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = quickshell
	depends = qt6-declarative
	optdepends = dms-shell: dynamic theming via Dux Shell colors
	optdepends = bubblewrap: run external thumbnailers in a sandbox
	optdepends = ffmpegthumbnailer: video thumbnails
	optdepends = poppler: pdf thumbnails
	optdepends = gvfs: network shares and the trash on removable drives
	optdepends = udisks2: the devices sidebar
	optdepends = polkit: retry denied operations as administrator
	optdepends = xdg-desktop-portal: use dfiles as the file chooser
	provides = dfiles
	provides = dux-files
	conflicts = dfiles
	conflicts = dux-files
	conflicts = dux-files-git
