pkgbase = linux-zen-versioned-bin
	pkgdesc = The Linux ZEN kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.8.2.zen2
	pkgrel = 1
	url = https://github.com/zen-kernel/zen-kernel
	arch = x86_64
	license = GPL2
	noextract = linux-zen-6.8.2.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-headers-6.8.2.zen2-1-x86_64.pkg.tar.zst
	noextract = linux-zen-docs-6.8.2.zen2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-6.8.2.zen2-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-headers-6.8.2.zen2-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/extra/os/x86_64/linux-zen-docs-6.8.2.zen2-1-x86_64.pkg.tar.zst
	sha256sums = db21a4c522ecda06f1ca5cb9f6ada944a6cb565e56a21d638b429c909f40c0f4
	sha256sums = d6839e1752f4ce22eebc1ca3a4d80fa39ec742fff394290662449bf9bd7548eb
