pkgbase = srs-sysinfo
	pkgdesc = Linux system information viewer inspired by SIV64X (independent, not affiliated with SIV): GTK3 GUI, 558 report items, user guide, CPU and GPU burn-in, benchmarks
	pkgver = 2.4.0
	pkgrel = 1
	url = https://github.com/eugenesflanagin-spec/srs-sysinfo
	arch = x86_64
	license = GPL-2.0-or-later
	depends = bash
	depends = gtk3
	depends = glib2
	depends = glibc
	depends = pango
	depends = cairo
	depends = sqlite
	depends = hicolor-icon-theme
	depends = hwdata
	depends = systemd
	optdepends = libayatana-appindicator: system tray icon (like the SIV Icon Tray)
	optdepends = polkit: srs-root helper for root-only data (one pkexec prompt)
	optdepends = dmidecode: SMBIOS details and serials (via srs-root)
	optdepends = i2c-tools: DIMM SPD decode with decode-dimms, and the opt-in DIMM PMIC voltages (via srs-root)
	optdepends = ryzen_smu-dkms-git: AMD live memory timings, clocks and SoC voltages (Memory Timings; AUR)
	optdepends = acpi_call-dkms: Tools > ACPI method evaluation (for experts)
	optdepends = smartmontools: SMART attributes (via srs-root)
	optdepends = nvme-cli: NVMe SMART log (via srs-root)
	optdepends = pciutils: PCI config space (via srs-root) and srs-sysreport
	optdepends = usbutils: lsusb in srs-sysreport
	optdepends = lm_sensors: sensor labels/compute lines and srs-sysreport
	optdepends = vulkan-tools: Vulkan driver summary
	optdepends = clinfo: OpenCL platforms
	optdepends = mesa-utils: OpenGL/EGL renderer info
	optdepends = iw: Wi-Fi link details
	optdepends = bluez-utils: Bluetooth controllers
	optdepends = wireplumber: PipeWire audio graph
	optdepends = libpulse: pactl audio info
	optdepends = inxi: srs-sysreport section
	optdepends = lshw: srs-sysreport section
	optdepends = hwinfo: srs-sysreport section
	optdepends = zlib: zlib rows of the Everyday Work benchmark (loaded at run time)
	optdepends = zstd: zstd rows of the Everyday Work benchmark (loaded at run time)
	optdepends = lz4: lz4 rows of the Everyday Work benchmark (loaded at run time)
	optdepends = xz: xz rows of the Everyday Work benchmark (loaded at run time)
	optdepends = curl: libcurl for the optional internet speed test of the Network benchmark (loaded at run time); the curl command for Update hardware lists (or wget)
	optdepends = vulkan-icd-loader: the GPU benchmarks (Vulkan loader, loaded at run time; plus your GPU's Vulkan driver)
	optdepends = rocm-hip-runtime: ROCm / HIP back end of GPU Burnin and the GPU Compute comparison (loaded at run time; hipblas for the library rows)
	optdepends = opencl-icd-loader: OpenCL back end of GPU Burnin and the GPU Compute comparison (loaded at run time; plus an OpenCL driver)
	optdepends = clblast: OpenCL matrix library rows of the GPU benchmarks (loaded at run time)
	optdepends = nvidia-utils: CUDA back end of GPU Burnin and the GPU Compute comparison (NVIDIA driver library libcuda, loaded at run time; ZLUDA works instead on AMD)
	optdepends = cuda: NVIDIA runtime compiler (libnvrtc) for SRS CUDA kernels, only a fallback since 2.3 (not needed with ZLUDA; may remove ZLUDA); can be installed later from Options
	source = srs-sysinfo-2.4.0.tar.gz::https://github.com/eugenesflanagin-spec/srs-sysinfo/archive/refs/tags/v2.4.0.tar.gz
	sha256sums = 9218598e5808e2bcd25003a566c70a6d3ed10c26f327b682381bfa14c14c567b

pkgname = srs-sysinfo
