pkgbase = gkey-config
	pkgdesc = Configuration tool for the gaming keys of Logitech G keyboards (hid-lg-g15)
	pkgver = 1.6.0
	pkgrel = 1
	url = https://github.com/Lordbooker/gkey-config
	install = gkey-config.install
	arch = x86_64
	license = GPL-2.0-only
	makedepends = cmake
	makedepends = qt6-tools
