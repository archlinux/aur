pkgbase = nimdow-wl-git
	pkgver = 0.7.41.r544.g66eb016
	pkgrel = 1
	url = https://github.com/Vyrnexis/nimdow-wl
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-only
	makedepends = git
	makedepends = nim
	makedepends = pkgconf
	source = nimdow-wl::git+https://github.com/Vyrnexis/nimdow-wl.git#branch=main
	source = parsetoml-0.7.2.tar.gz::https://github.com/NimParsers/parsetoml/archive/refs/tags/v0.7.2.tar.gz
	sha256sums = SKIP
	sha256sums = 568acfd8193ca9e2bdb5f40ed71c2ccf35d4f50778bb25c8d26ed1e8896f89c8

pkgname = nimdow-wl-git
	pkgdesc = Nim window manager for the River Wayland compositor, with its own status bar and system tray
	depends = river>=0.5
	depends = wayland
	depends = libxkbcommon
	depends = cairo
	depends = pango
	depends = librsvg
	depends = systemd-libs
	depends = glib2
	depends = harfbuzz
	depends = gdk-pixbuf2
	optdepends = nimdow-wl-desktop-git: complete desktop setup
	optdepends = xdg-desktop-portal-gtk: portals (file chooser, screenshots) used by the session
	optdepends = mako: notification daemon
	conflicts = nimdow-wayland-git
	replaces = nimdow-wayland-git

pkgname = nimdow-wl-desktop-git
	pkgdesc = Complete nimdow-wl desktop: notifications, polkit agent, launcher, status bar, portals and default config
	install = nimdow-wl-desktop.install
	arch = any
	depends = nimdow-wl-git
	depends = polkit-gnome
	depends = mako
	depends = swaybg
	depends = xdg-desktop-portal-gtk
	depends = xorg-xwayland
	depends = gnome-keyring
	depends = kitty
	depends = nimlaunch-bin
	depends = nimdow-wl-status
	depends = wl-clipboard
	depends = grim
	depends = slurp
	depends = libnotify
	depends = pipewire
	depends = pipewire-pulse
	depends = wireplumber
	depends = brightnessctl
	depends = networkmanager
	depends = ttf-meslo-nerd
	depends = pacman-contrib
	optdepends = pavucontrol: volume mixer
	optdepends = nautilus: file manager
	optdepends = adw-gtk-theme: GTK theme
	optdepends = network-manager-applet: tray network applet
	optdepends = sddm: graphical login manager
	optdepends = greetd-tuigreet: lightweight login manager
	backup = etc/xdg/nimdow-wl/config.toml
