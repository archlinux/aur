pkgbase = chatterino2-bin
	pkgdesc = A chat client for Twitch.tv.
	pkgver = 2.5.3
	pkgrel = 4
	url = https://github.com/chatterino/${_pkgname}
	arch = x86_64
	license = MIT
	makedepends = flatpak
	depends = glib2
	depends = gdk-pixbuf2
	depends = hicolor-icon-theme
	depends = libnotify
	depends = openssl
	depends = qt6-base
	depends = qt6-5compat
	depends = qt6-imageformats
	depends = qt6-svg
	depends = qtkeychain-qt6
	optdepends = streamlink: For piping streams to video players
	optdepends = qt6-wayland: Wayland support
	provides = chatterino
	conflicts = chatterino

pkgname = chatterino2-bin
