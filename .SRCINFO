pkgbase = wiki2book
	pkgdesc = Wiki2book is a CLI tool to convert one or multiple Wikipedia articles into an eBook.
	pkgver = 0.6.1
	pkgrel = 3
	url = https://github.com/hauke96/wiki2book
	arch = any
	license = GPL-3.0
	makedepends = go>=1.24
	depends = pandoc
	optdepends = imagemagick: Default but optional tool to convert and process images
	optdepends = ttf-dejavu: Font used in the default style
	optdepends = librsvg: Default but optional tool used to convert SVGs into raster images
	provides = wiki2book=0.6.1
	options = !debug
	options = !lto
	source = git+https://github.com/hauke96/wiki2book#tag=v0.6.1
	sha256sums = SKIP

pkgname = wiki2book
