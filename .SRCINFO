pkgbase = chatwithwork-desktop-bin
	pkgdesc = Chat with Work Desktop: the desktop app, terminal interface and background agent
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/crmne/chatwithwork-desktop
	install = chatwithwork-desktop-bin.install
	arch = x86_64
	arch = aarch64
	license = MIT OR Apache-2.0
	depends = alsa-lib
	depends = libpipewire
	depends = glibc
	depends = gcc-libs
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libayatana-appindicator
	depends = dbus
