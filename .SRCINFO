pkgbase = yserver
	pkgdesc = A modern X11 server written from scratch in Rust (DRM/KMS + Vulkan)
	pkgver = 1.4.0
	pkgrel = 1
	url = https://github.com/joske/yserver
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = gcc
	makedepends = just
	makedepends = shaderc
	makedepends = pkgconf
	makedepends = scdoc
	depends = libgcc
	depends = glibc
	depends = libxshmfence
	depends = libxkbcommon
	depends = libinput
	depends = systemd-libs
	depends = fontconfig
