pkgbase = attune
	pkgdesc = Tool for publishing and hosting Linux packages
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/attunehq/attune
	arch = x86_64
	license = Apache-2.0
	checkdepends = coreutils
	checkdepends = procps-ng
	checkdepends = openbsd-netcat
