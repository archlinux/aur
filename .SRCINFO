pkgbase = mini-downloader-git
	pkgdesc = Lightweight native download manager (aria2 + yt-dlp, browser capture) — git build
	pkgver = 3.1.0
	pkgrel = 1
	url = https://github.com/RamazanBerk20/mini-downloader
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	makedepends = git
	makedepends = pkgconf
	depends = aria2
	depends = fontconfig
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxrandr
	depends = wayland
	depends = xdg-utils
	optdepends = yt-dlp: video, HLS, and DASH downloads
	optdepends = ffmpeg: merge media streams, embed subtitles/thumbnails, and convert audio
	provides = mini-downloader
	conflicts = mini-downloader
	conflicts = mini-downloader-bin
	options = !lto
	source = mini-downloader-git::git+https://github.com/RamazanBerk20/mini-downloader.git
	sha256sums = SKIP

pkgname = mini-downloader-git
