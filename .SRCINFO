pkgname = linux-zen-versioned-headers-bin
	pkgdesc = Metapackage depending on linux7.1.8.zen1-3-zen-headers-bin
	depends = linux7.1.8.zen1-3-zen-headers-bin

pkgname = linux-zen-versioned-docs-bin
	pkgdesc = Metapackage depending on linux7.1.8.zen1-3-zen-docs-bin
	depends = linux7.1.8.zen1-3-zen-docs-bin

pkgname = linux7.1.8.zen1-3-zen-bin
	pkgdesc = The Linux ZEN kernel and modules, version 7.1.8-zen1-3-zen
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-zen-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-zen

pkgname = linux7.1.8.zen1-3-zen-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux ZEN kernel 7.1.8-zen1-3-zen
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-zen-headers

pkgname = linux7.1.8.zen1-3-zen-docs-bin
	pkgdesc = Documentation for the Linux ZEN kernel 7.1.8-zen1-3-zen
	conflicts = linux-zen-docs
