pkgbase = gestimag
	pkgdesc = Gestimag ERP CRM: modern software package to manage your company
	pkgver = 0.0.1
	pkgrel = 4
	url = http://adrien.digitaledeluxe.fr/gestimag/
	install = gestimag.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = apache
	depends = mariadb
	depends = php
	depends = php-gd
	optdepends = php-tcpdf: pdf export
	options = !strip
	options = emptydirs
	backup = etc/gestimag/conf.php
	source = git+https://github.com/adrienb39/gestimag#branch=main
	source = gestimag.conf
	source = nginx.conf.example
	source = apache.conf.example
	b2sums = SKIP

pkgname = gestimag
