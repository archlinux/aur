pkgbase = file-browser-tui
	pkgdesc = A Dolphin-like file manager for kitty
	pkgver = 1.1.4
	pkgrel = 1
	url = https://github.com/adelmonte/file-browser-tui
	install = file-browser-tui.install
	arch = x86_64
	license = GPL-3.0-only
	makedepends = cargo
	depends = kitty
	depends = gcc-libs
	depends = glibc
	depends = libarchive
	depends = librsvg
	depends = shared-mime-info
	depends = hicolor-icon-theme
	optdepends = ttf-nerd-fonts-symbols: menu and toolbar glyphs
	optdepends = wl-clipboard: clipboard on Wayland
	optdepends = xclip: clipboard on X11
	optdepends = fd: searching by file name
	optdepends = ripgrep: searching inside files
	optdepends = ffmpeg: video thumbnails and audio cover art
	optdepends = ffmpegthumbnailer: video thumbnails (preferred over ffmpeg when installed)
	optdepends = poppler: PDF thumbnails
	optdepends = xdg-utils: opening files with their default app
	optdepends = zip: Compress to zip
	optdepends = udisks2: mounting, unlocking and safely removing drives
	optdepends = kdeconnect: Send to Device and browsing phones
	optdepends = glib2: file type icons for unusual files
	optdepends = xdg-desktop-portal-tui: use as the Open and Save dialog for other programs
	source = file-browser-tui-1.1.4.tar.gz::https://github.com/adelmonte/file-browser-tui/archive/refs/tags/v1.1.4.tar.gz
