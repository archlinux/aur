	pkgdesc = Fcitx5 module for Mozc with UT dictionary
	depends = fcitx5
	depends = mozc-ut-full-common
	provides = fcitx5-mozc
	conflicts = fcitx-mozc
	conflicts = fcitx5-mozc
	replaces = fcitx5-mozc

pkgname = emacs-mozc-ut-full
