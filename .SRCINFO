pkgbase = friendly
	pkgdesc = Spotlight-style overlay that rewrites a dictated/typed message in a chosen tone via Claude Code (claude -p), then copies it to the clipboard
	pkgver = 0.3.1
	pkgrel = 1
	url = https://github.com/KannarFr/friendly
	arch = any
	license = MIT
	depends = bash
	depends = python
	depends = python-gobject
	depends = gtk3
	depends = gtk-layer-shell
	depends = wl-clipboard
	depends = hicolor-icon-theme
	optdepends = claude-code: LLM backend — friendly calls `claude -p` (REQUIRED at runtime; AUR, or `npm i -g @anthropic-ai/claude-code`)
	optdepends = wofi: Spotlight-style menu/launcher (recommended; falls back to rofi/zenity)
	optdepends = libnotify: desktop notifications (result + progress)
	optdepends = rofi: fallback launcher if wofi is missing
	optdepends = zenity: last-resort fallback dialogs
	optdepends = handy: speech-to-text backend for built-in dictation, --dictate (AUR: handy or handy-bin)
	optdepends = whisper.cpp-git: alternative speech-to-text backend, --stt whisper (AUR; plus a ggml model)
	optdepends = pipewire-audio: mic recording for --dictate (pw-record; falls back to parecord/arecord)
	source = friendly-0.3.1.tar.gz::https://github.com/KannarFr/friendly/archive/refs/tags/v0.3.1.tar.gz
	sha256sums = de3d78f0ea74d315ec319dffdafcd11ea92ac72a156a8ca3bd5672c94357039c

pkgname = friendly
