	arch = x86_64
	license = GPL
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = gettext
	makedepends = kpackage
	makedepends = libplasma
	makedepends = qt6-base
	makedepends = qt6-networkauth
	depends = plasma-workspace
	depends = libplasma
	depends = plasma5support
	depends = kirigami
	depends = kcmutils
	depends = ksvg
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-5compat
	depends = qt6-networkauth
	optdepends = plasma-nm: network connectivity monitoring integration
	optdepends = akonadi-calendar-tools: local Akonadi event create/edit support via konsolekalendar
	optdepends = kdepim-addons: Local Calendars config page
	optdepends = python-icalendar: iCal calendar source support
	optdepends = python-gobject: notification helper script backend
	optdepends = libnotify: desktop notifications for notification helper
	optdepends = libcanberra: notification sound playback
	optdepends = pipewire-audio: sound playback fallback via pw-play
	optdepends = libpulse: sound playback fallback via paplay
	optdepends = qt6-positioning: weather location detection
	optdepends = geoclue: weather location detection
