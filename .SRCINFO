pkgbase = fenriz-desktop-git
	pkgdesc = Desktop shell for Wayland compositors
	pkgver = 0.1.10
	pkgrel = 1
	url = https://github.com/zackb/fenriz
	arch = x86_64
	license = MIT
	makedepends = cmake
	makedepends = ninja
	makedepends = git
	makedepends = wayland-protocols
	depends = gtk4
	depends = gtk4-layer-shell
	depends = glib2
	depends = wayland
	depends = polkit
	depends = wireplumber
	depends = pam
	optdepends = fenriz: the compositor this shell is built for
	optdepends = fprintd: fingerprint unlock, see /usr/share/fenriz-desktop/pam
	optdepends = xdg-desktop-portal: file chooser for the wallpaper picker
	provides = fenriz-desktop
	conflicts = fenriz-desktop
	conflicts = fenriz-desktop-bin
	backup = etc/pam.d/fenriz-desktop
	source = git+https://github.com/zackb/fenriz.git
	sha256sums = SKIP

pkgname = fenriz-desktop-git
