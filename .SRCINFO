pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.20
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.20-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.20-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.20-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.20-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.20-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.20-1-x86_64.pkg.tar.zst
	sha256sums = 36acd428b35e4348864a8657332036cbaf68924b957f2aec93b244cd6230f7c5
	sha256sums = 442e5c5e59dade88c241ae7bdb4447ad6a5649ebb23433a619616ebc7e6cfbc2
	sha256sums = 422bab28c0d9c46c5deb98a4f507385436e8613fdf7a97cc1467797dbedebda1

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.20-1-lts-bin
	depends = linux6.18.20-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.20-1-lts-headers-bin
	depends = linux6.18.20-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.20-1-lts-docs-bin
	depends = linux6.18.20-1-lts-docs-bin

pkgname = linux6.18.20-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.20-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.20-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.20-1-lts
	depends = pahole
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.20-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.20-1-lts
	conflicts = linux-lts-docs
