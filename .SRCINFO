pkgbase = framework-laptop-meta
	pkgdesc = Metapackage to install optimal utilities and tweaks for Framework laptops
	pkgver = 1.0.4
	pkgrel = 5
	url = https://frame.work
	arch = any
	license = MIT
	depends = power-profiles-daemon
	depends = fprintd
	depends = brightnessctl
	depends = bluez
	depends = bluez-utils
	depends = fwupd
	depends = linux-firmware
	depends = i2c-tools
	optdepends = amd-ucode: Microcode updates for AMD Framework models
	optdepends = intel-ucode: Microcode updates for Intel Framework models
	optdepends = via: For configuring Framework 16 QMK layouts
	optdepends = thermald: Intel management daemon to prevent throttling
	optdepends = tlp: Alternative power management (disable power-profiles-daemon first)
	optdepends = iio-sensor-proxy: Enables ambient light sensor for auto brightness
	optdepends = framework-system: CLI and service for controlling EC, charge limit,and expansion cards
	source = LICENSE
	sha256sums = cbf0735220d8d7d758f2ea55cb82b7924a177538ff3331e5a62968f055dab627

