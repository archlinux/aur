pkgbase = shaya
	pkgdesc = Native AI assistant for Linux, built with Rust and GTK4
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/AshBuk/Shaya
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
	makedepends = rust
	depends = cairo
	depends = glib2
	depends = glibc
	depends = gtk4
	depends = gtk4-layer-shell
	depends = hicolor-icon-theme
	depends = libadwaita
	depends = libgcc
	depends = pango
	optdepends = pipewire-audio: audio capture with pw-record
	optdepends = wireplumber: system audio detection with wpctl
	optdepends = libpulse: audio capture with parecord
	optdepends = opus-tools: meeting recording encoder
	optdepends = ffmpeg: alternative meeting recording encoder
	optdepends = grim: screenshots on wlroots compositors
	optdepends = slurp: area selection on wlroots compositors
	optdepends = spectacle: screenshots on KDE Plasma
	optdepends = gnome-screenshot: screenshots on GNOME X11
	optdepends = scrot: screenshots on X11
	optdepends = xdg-utils: open the meetings folder
	options = !lto
	options = !debug
