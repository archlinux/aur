	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.11.4.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.11.4.arch2-1-x86_64.pkg.tar.zst
