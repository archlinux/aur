pkgbase = radiance-inference-git
	pkgdesc = C++20 LLM inference server for AMD GPUs (primarily gfx1201) with OpenAI-compatible HTTP API (git HEAD)
	pkgver = 2.2.0.r1087
	pkgrel = 1
	url = https://codeberg.org/StillDeadcode/radiance
	install = radiance-inference-git.install
	arch = x86_64
	license = Apache-2.0
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	makedepends = openblas
	depends = gcc-libs
	depends = glibc
	depends = ffmpeg
	depends = rocm-gfx120x-bin
	depends = openblas
	optdepends = curl: hfget.sh model-download helper (/usr/libexec/radiance/hfget.sh)
	optdepends = jq: hfget.sh
	optdepends = python3: rad-export tool (/usr/bin/rad-export)
	provides = radiance-inference
	conflicts = radiance-inference
	options = !lto
	options = !debug
	backup = etc/radiance/radiance.yaml
	backup = etc/radiance/radiance.env
	source = radiance-inference::git+https://codeberg.org/StillDeadcode/radiance.git#branch=main
	source = radiance.service
	source = radiance.yaml
	source = radiance.env
