pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.25
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.25-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.25-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.25-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.25-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.25-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.25-1-x86_64.pkg.tar.zst
	sha256sums = 93dc58a6a5a1b35ddd5bf2a6296d439b7e74783b9c16a6fa10841ef915a11d0f
	sha256sums = 4aa5b71b44ed8e74e0a6eb1bd939caacd0ac6edae1e4314c2a28369d93b1a669
	sha256sums = 31d289811a162e6898aedb4fc4df5520d5822037ca66b2bdf3ae4790aeb4bc8c

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.25-1-lts-bin
	depends = linux6.12.25-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.25-1-lts-headers-bin
	depends = linux6.12.25-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.25-1-lts-docs-bin
	depends = linux6.12.25-1-lts-docs-bin

pkgname = linux6.12.25-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.25-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.25-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.25-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.25-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.25-1-lts
	conflicts = linux-lts-docs
