pkgname = xapp-mp3-thumbnailer
	pkgdesc = MP3 thumbnailer
	depends = python-eyed3
	depends = xapp-thumbnailers-common

pkgname = xapp-epub-thumbnailer
	pkgdesc = ePub thumbnailer
	depends = xapp-thumbnailers-common

pkgname = xapp-raw-thumbnailer
