pkgbase = leigod-steamdeck-plugin
	pkgdesc = Leigod accelerator SteamDeck plugin on generic Linux via bwrap SteamDeck emulation
	pkgver = 1.2.2.15
	pkgrel = 3
	url = https://www.leigod.com
	install = leigod-plugin.install
	arch = x86_64
	license = custom:proprietary
	depends = bubblewrap
	depends = curl
	depends = iproute2
	depends = iptables
	depends = ipset
	depends = sslh
	options = !strip
	options = !debug
	backup = etc/leigod/bwrap.conf
	backup = etc/leigod/sslh-guard.cfg
	backup = etc/leigod/device.conf
	source = http://119.3.40.126/acc-gw.router.amd64
	source = http://119.3.40.126/ipdatacloud_country.xdb
	source = http://119.3.40.126/steamdeck_acc_monitor.sh
	source = bwrap.conf
	source = leigod.service
	source = accelerator.ini
	source = acc_version.ini
	source = fake_product_name
	source = fake_os_release
	source = fake_version
	source = ensure-wlan0.sh
	source = run.sh
	source = sslh-guard.cfg
	source = device.conf
	source = mirror.conf.example
