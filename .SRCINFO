pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.9.3.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.9.3.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.9.3.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.9.3.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-6.9.3.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-headers-6.9.3.arch1-1-x86_64.pkg.tar.zst
	source = https://mirror.aarnet.edu.au/pub/archlinux/core/os/x86_64/linux-docs-6.9.3.arch1-1-x86_64.pkg.tar.zst
	sha256sums = 0cc5d731e726070f94464992d4dc372b869e3dd6f3c8b474ce32801d7bd785ad
