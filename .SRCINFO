	optdepends = python-anyconfig-fortios-backend: Fortios load and parse support
	optdepends = python-jinja: Template support
	optdepends = python-jmespath: Query with JMESpath expression support
	optdepends = python-jsonschema: JSON schema support
	optdepends = python-tomli: TOML support (parser)
	optdepends = python-tomli-w: TOML support (writer)
	optdepends = python-typing_extensions: type validation
	optdepends = python-yaml: YAML support
