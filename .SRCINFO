pkgbase = texmacs-qt
	pkgdesc = WYSIWYG free scientific text editor and graphical frontend to various CASes \n (Giac, GTybalt, Macaulay 2, Maxima, Octave, Pari, Qcl, R and Yacas)
	pkgver = 2.1.5
	pkgrel = 1
	url = http://texmacs.org/
	arch = x86_64
	license = GPL3
	makedepends = ghostscript
	makedepends = cmake
	makedepends = cairo
	makedepends = imlib2
	depends = qt5-svg
	depends = freetype2
	depends = libxext
	depends = guile1.8
	depends = libtool
	depends = perl
	depends = python
	optdepends = texlive-core: TeX-fonts
	optdepends = fig2dev: convert images using fig2ps
	optdepends = gawk: conversion of some files
	optdepends = ghostscript: rendering ps files
	optdepends = imagemagick: convert images
	optdepends = aspell: spell checking
	provides = texmacs=2.1.5
	provides = fig2ps
	conflicts = texmacs
