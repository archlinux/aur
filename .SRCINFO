pkgbase = libfronius
	pkgver = 1.0.15
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.15::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.15
	sha256sums = ece6ca43c0c7d1de694eb9a7f7a0746b95d1eeca69243c3d5d49eaae6b4cf474

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
