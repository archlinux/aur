	sha256sums = 8dbcb68d74b2cd7c4cdac2adcbf3b531131f0987bb98b21bda6ab1b65f65d946

pkgname = libethercat
	provides = libethercat
	provides = libethercat.so
	conflicts = libethercat
	conflicts = libethercat.so

pkgname = libethercat-tools
	depends = glibc
	depends = libosal
