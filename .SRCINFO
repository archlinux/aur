pkgbase = linux-pf
	pkgdesc = pf-kernel
	pkgver = 6.19.pf1
	pkgrel = 2
	url = https://pfkernel.natalenko.name
	arch = x86_64
	license = GPL-2.0-only
	makedepends = bc
	makedepends = cpio
	makedepends = gettext
	makedepends = libelf
	makedepends = pahole
	makedepends = perl
	makedepends = python
	makedepends = rust
	makedepends = rust-bindgen
	makedepends = rust-src
	makedepends = tar
	makedepends = xz
	options = !debug
	options = !strip
	source = https://codeberg.org/pf-kernel/linux/archive/54eed6ecd6fb609f6f59c6ba4310c1b48dccd5df.tar.gz
	source = config
	b2sums = SKIP
	b2sums = e1f25b08d7b338f9f3b7bfa6893374c8ca07594e763d08e2455cbca033db52a58b77e490185c7987749ea9bebe580fd05443f391d43ba7e6228249d13372a671

pkgname = linux-pf
	pkgdesc = The pf-kernel and modules
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = ksmbd-tools: userspace tools for the ksmbd kernel SMB server
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = linux-pf
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = OVPN-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux-pf-headers
	pkgdesc = Headers and scripts for building modules for the pf-kernel
	depends = pahole
	provides = LINUX-HEADERS
	provides = linux-pf-headers
