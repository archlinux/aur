pkgbase = tkginstaller-git
	pkgdesc = Manage the popular TKG packages (Kernel, Nvidia, Mesa, Wine, Proton) from the Frogging-Family repositories in a simple, user-friendly way. 🐸
	pkgver = 0.4.3
	pkgrel = 1
	url = https://github.com/damachine/tkginstaller
	arch = x86_64
	license = MIT
	depends = fzf
	depends = git
	depends = gcc
	optdepends = bat: for syntax highlighting
	optdepends = curl: for downloading files
	optdepends = glow: for markdown converting and viewing
	optdepends = llvm: for non-Arch distributions
	optdepends = nano: for editing config files
	optdepends = onefetch: for git info display
	optdepends = vim: for editing config files
	optdepends = wget: for downloading files
	provides = tkginstaller
	conflicts = tkginstaller
	replaces = tkginstaller
	source = tkginstaller.sh::https://raw.githubusercontent.com/damachine/tkginstaller/refs/heads/master/tkginstaller.sh
	sha256sums = SKIP

pkgname = tkginstaller-git
