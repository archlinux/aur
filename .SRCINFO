pkgbase = margo-git
	pkgdesc = Rust/Smithay Wayland tiling compositor with a first-party GTK4 desktop shell (mshell)
	pkgver = r3266.94e7a602
	pkgrel = 1
	url = https://github.com/kenanpelit/margo
	install = margo-git.install
	arch = x86_64
	license = GPL-3.0-or-later
	checkdepends = gst-libav
	makedepends = rust
	makedepends = cargo
	makedepends = clang
	makedepends = pkg-config
	makedepends = git
	makedepends = wayland-protocols
	makedepends = gtk4-layer-shell
	makedepends = libadwaita
	makedepends = mpv
	depends = glibc
	depends = gcc-libs
	depends = libinput
	depends = libxkbcommon
	depends = wayland
	depends = mesa
	depends = seatd
	depends = pixman
	depends = libdrm
	depends = systemd-libs
	depends = libpipewire
	depends = glib2
	depends = pam
	depends = cairo
	depends = pango
	depends = dbus
	depends = uwsm
	depends = cage
	depends = foot
	depends = xdg-desktop-portal
	depends = xdg-desktop-portal-gtk
	depends = libnotify
	depends = grim
	depends = slurp
	depends = wl-clipboard
	depends = mpv
	depends = gtk4
	depends = gtk4-layer-shell
	depends = libadwaita
	depends = gdk-pixbuf2
	depends = graphene
	depends = fontconfig
	depends = freetype2
	depends = gstreamer
	depends = gst-plugins-base
	depends = gst-plugins-base-libs
	depends = gst-plugins-bad-libs
	depends = gst-plugins-good
	depends = alsa-lib
	depends = libpulse
	depends = pipewire
	optdepends = xdg-desktop-portal-wlr: alternative wlroots-native screencast backend (not used by default; margo-portal serves ScreenCast/Screenshot natively)
	optdepends = xdg-utils: xdg-open / xdg-mime for opening links, files and default apps
	optdepends = polkit: pkexec for privileged actions (power menu, firewall widget, update/pacnew/rollback, CPU dashboard)
	optdepends = qt5-wayland: Qt5 native Wayland backend
	optdepends = qt6-wayland: Qt6 native Wayland backend
	optdepends = swappy: post-capture annotation editor for mscreenshot
	optdepends = satty: alternative annotation editor for mscreenshot
	optdepends = wf-recorder: screen recording via wlr-screencopy
	optdepends = gpu-screen-recorder: hardware-encoded screen recording backend
	optdepends = ffmpeg: webcam picture-in-picture in screen recordings
	optdepends = v4l-utils: webcam overlay camera / mode detection (v4l2-ctl)
	optdepends = tesseract: OCR of a screenshot region (mscreenshot / mshell screenshot menu)
	optdepends = tesseract-data-eng: English language data for the screenshot OCR
	optdepends = zbar: QR-code decoding of a screenshot region (zbarimg)
	optdepends = qrencode: QR codes to share text / Wi-Fi with a phone (mshellctl qr, Network menu)
	optdepends = openssh: SSH Sessions menu port forwards
	optdepends = yt-dlp: `mshellctl play play`/`download` of YouTube + other streaming URLs, the launcher `yt` provider
	optdepends = copyq: clipboard manager via wlr-data-control
	optdepends = wl-clip-persist: keep clipboard alive after the producer exits
	optdepends = networkmanager: NetworkManager backend for mshell network + ndns
	optdepends = bluez: Bluez backend for mshell bluetooth widget
	optdepends = bluez-utils: bluetoothctl for the launcher Bluetooth provider
	optdepends = upower: UPower backend for mshell battery widget
	optdepends = power-profiles-daemon: power profile switching for mshell + the mpower auto-profile service
	optdepends = brightnessctl: brightness fallback when DDC/CI is unavailable
	optdepends = iwd: alternative wireless backend for the network widget
	optdepends = iw: Wi-Fi hotspot from the network menu
	optdepends = speedtest-cli: network menu speed test
	optdepends = ufw: needed by the mshell nufw firewall widget
	optdepends = podman: needed by the mshell npodman widget
	optdepends = mullvad-vpn: the VPN daemon driven by the mvpn binary (CLI + GTK panel)
	optdepends = blocky: local DNS resolver controlled by the ndns widget
	optdepends = curl: used by the nip public-IP widget (already pulled by base)
	optdepends = udisks2: removable-drive pill (mount / unmount / eject)
	optdepends = smartmontools: drive health in the CPU dashboard
	optdepends = efibootmgr: session menu Reboot into… (UEFI BootNext)
	optdepends = cava: audio visualizer pill
	optdepends = wireplumber: wpctl for the launcher audio provider
	optdepends = noise-suppression-for-voice: microphone noise suppression (RNNoise LADSPA plugin)
	optdepends = matugen: wallpaper-derived colour themes
	optdepends = github-cli: the GitHub menu (gh)
	optdepends = valent: phone integration pill and menu (AUR)
	optdepends = scrcpy: Android screen mirroring from the Valent menu
	optdepends = android-tools: adb device discovery for scrcpy mirroring
	optdepends = pacman-contrib: checkupdates for the update count (no sudo, no db lock)
	optdepends = arch-audit: security advisories in the system-update menu
	optdepends = topgrade: alternative system-update backend (AUR)
	optdepends = fd: launcher file search
	optdepends = plocate: launcher file search from the locate index
	optdepends = pass: launcher password-store provider
	optdepends = playerctl: launcher media provider + media keys on the lock screen
	optdepends = libqalculate: calculator units, currency and percentages (qalc)
	optdepends = neovim: launcher `nv` provider (reopen Neovim sessions / projects)
	optdepends = wtype: launcher typing (pass type/autotype, case convert Ctrl+Enter)
	optdepends = wlr-randr: mlayout monitor apply / capture
	optdepends = git: mdots repositories, mtm plugins
	optdepends = age: mdots secrets (age-keygen)
	optdepends = sops: mdots encrypted secrets
	optdepends = fprintd: opt-in fingerprint login for mlogind (pam_fprintd)
	optdepends = tmux: required by mtm's session/layout/buffer/kenp commands
	optdepends = fzf: interactive picker for mtm buffer/clip/speed
	optdepends = cliphist: mtm clip's clipboard-history backend
	optdepends = gst-libav: mtune playback of AAC / M4A / ALAC / WMA and other ffmpeg-only codecs
	optdepends = gst-plugins-bad: mtune playback of extra containers / codecs (M4A via faad, etc.) and HLS radio streams
	provides = margo=r3266.94e7a602
	provides = wayland-compositor
	provides = mshell=r3266.94e7a602
	provides = margo-mshell-git=r3266.94e7a602
	conflicts = margo
	conflicts = margo-mshell-git
	conflicts = mshell
	options = !lto
	options = debug
	backup = etc/mlogind/config.toml
	backup = etc/mlogind/variables.toml
	backup = etc/pam.d/mlogind
	backup = etc/pam.d/mlogind-greeter
	backup = etc/pam.d/mlogind-autologin
	backup = etc/pam.d/mlock
	backup = etc/mlogind/xsetup.sh
	source = git+https://github.com/kenanpelit/margo.git#branch=main
	sha256sums = SKIP

pkgname = margo-git
