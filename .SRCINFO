pkgbase = wolf-lang-bin
	pkgdesc = The wolf systems language: the wolfgang compiler, its runtime and the C importer (release archive)
	pkgver = 0.2.7
	pkgrel = 1
	url = https://github.com/wolffe-lang/wolf-lang
	install = wolf-lang-bin.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	depends = sh
	depends = gcc
	depends = gcc-libs
	depends = glibc
	optdepends = lld: faster linking — wolf prefers ld.lld and says so when it is absent
	optdepends = clang: for `import c` beyond the headers gcc ships
	optdepends = lupin-bin: the reference interpreter wolf is differentially tested against
	provides = wolf-lang=0.2.7
	conflicts = wolf-lang
	conflicts = wolf
	options = !strip
	options = !debug
