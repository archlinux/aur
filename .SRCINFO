pkgbase = fastsapp-git
	pkgdesc = ZapFast native WhatsApp client (legacy FastsApp package name)
	pkgver = 0.13.1.r0.271612d
	pkgrel = 1
	url = https://zapfast.rocks
	install = fastsapp-git.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = cmake
	depends = alsa-lib
	depends = libglvnd
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	optdepends = libxkbcommon-x11: keyboard handling in X11 sessions
	optdepends = noto-fonts-emoji: colour emoji in messages and reactions
	optdepends = xdg-desktop-portal: the file picker for attachments
	provides = zapfast
	provides = fastsapp
	conflicts = zapfast
	conflicts = zapfast-bin
	conflicts = zapfast-git
	conflicts = fastsapp
	conflicts = fastsapp-bin
	options = !debug
	options = !lto
	source = zapfast-git::git+https://github.com/crmne/zapfast.git
	sha256sums = SKIP

pkgname = fastsapp-git
