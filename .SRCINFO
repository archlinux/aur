pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.12.49
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.12.49-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.12.49-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.12.49-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.12.49-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.12.49-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.12.49-1-x86_64.pkg.tar.zst
	sha256sums = 7a7a7d313b2a3842f9f58443f8b38ad1f240257ff9f6ccd0bc5610855c999a7d
	sha256sums = 9cd2cbaebc57a619d43c44c0c5b171b8e726e23d9116057e18ad22364f4fbf44
	sha256sums = 01022b2aaa0a7d88f6b68cafa00bcb33a33c4b4ccf8497c3de226cb1fa076091

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.12.49-1-lts-bin
	depends = linux6.12.49-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.12.49-1-lts-headers-bin
	depends = linux6.12.49-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.12.49-1-lts-docs-bin
	depends = linux6.12.49-1-lts-docs-bin

pkgname = linux6.12.49-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.12.49-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.12.49-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.12.49-1-lts
	depends = pahole
	conflicts = linux-lts-headers

pkgname = linux6.12.49-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.12.49-1-lts
	conflicts = linux-lts-docs
