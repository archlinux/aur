pkgbase = flamewm-bin
	pkgdesc = Fast Rust X11 window manager and desktop session, with a preliminary Wayland compositor
	pkgver = 0.1.2b
	pkgrel = 1
	url = https://wm.arkflame.com
	arch = x86_64
	license = LGPL-2.0-only
	license = MIT
	license = LGPL-3.0-or-later
	license = GPL-3.0-only
	depends = bash
	depends = dbus
	depends = fontconfig
	depends = glibc>=2.43
	depends = libdrm
	depends = libgcc
	depends = libglvnd
	depends = libinput
	depends = libpulse
	depends = libx11
	depends = libxcb
	depends = libxcomposite
	depends = libxcursor
	depends = libxdamage
	depends = libxext
	depends = libxft
	depends = libxi
	depends = libxkbcommon
	depends = libxrender
	depends = mesa
	depends = pam
	depends = python
	depends = systemd-libs
	depends = wayland
	depends = xorg-xwayland
	optdepends = ark: archive extraction from Explorer
	optdepends = dex: XDG autostart entries
	optdepends = dunst: notification daemon for the session
	optdepends = ffmpeg: screen recording
	optdepends = imagemagick: desktop Convert wheel
	optdepends = kwallet-pam: unlock KWallet at login
	optdepends = libnotify: Explorer notifications
	optdepends = libxkbcommon-x11: nested compositor session inside X11
	optdepends = polkit-kde-agent: authentication agent for privileged actions
	optdepends = ttf-ibm-plex: default interface font (falls back to Noto Sans or DejaVu Sans)
	optdepends = udisks2: mount removable drives from Explorer
	optdepends = xdg-desktop-portal-gtk: fallback portal backend
	optdepends = xdg-desktop-portal-kde: preferred OpenURI and FileChooser portal backend
	optdepends = xdg-utils: open files and links with their default applications
	optdepends = xorg-xprop: deferred XDG autostart after the window manager is ready
	optdepends = xorg-xrandr: display layout settings and restore at login
	provides = flamewm
	conflicts = flamewm
	conflicts = flamewm-git
	conflicts = mcmojave-cursors
	conflicts = mcmojave-cursors-git
	options = !debug
	backup = etc/pam.d/flamewm-lock
	backup = etc/xdg/menus/flamewm-applications.menu
	source = flamewm-0.1.2b-amd64.deb::https://github.com/ArkFlame/flamewm/releases/download/0.1.2b/flamewm_0.1.2_amd64.deb
	source = flamewm-lock.pam::https://raw.githubusercontent.com/ArkFlame/flamewm/0.1.2b/packaging/arch/flamewm-lock.pam
	sha256sums = c436546d075421f3ac2cf741aaf6367905f4a8c1c53ecf12ff81039b86053bf0
	sha256sums = 2f9b7a7a8a8583ed40969240ee7d0d42ffba4a44b69a7d241bd60634795a8e84

pkgname = flamewm-bin
