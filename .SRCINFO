pkgbase = pila-git
	pkgdesc = A stacking Wayland compositor built on Smithay
	pkgver = 0.5.0.r384.gd18e82b
	pkgrel = 1
	url = https://github.com/igalmarino/pila
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = git
	makedepends = pkgconf
	depends = bash
	depends = glibc
	depends = libgcc
	depends = libglvnd
	depends = libinput
	depends = libxkbcommon
	depends = mesa
	depends = seatd
	depends = systemd-libs
	depends = xorg-xwayland
	optdepends = kitty: the default terminal (or foot, alacritty, ...)
	optdepends = xdg-desktop-portal-wlr: screen sharing
	optdepends = grim: screenshots
	optdepends = slurp: picking the screen to share, and screenshot regions
	optdepends = xdg-desktop-portal-gtk: file chooser and other portals
	optdepends = wl-clipboard: Mod+Shift+S, a region of the screen to the clipboard (wl-copy)
	optdepends = swaylock: locking the session
	optdepends = libnotify: notifications from pila, such as an invalid config (notify-send)
	optdepends = xdg-utils: opening links and files from programs such as kitty (xdg-open)
	optdepends = pciutils: the GPU and its driver in pila-report (lspci)
	provides = pila
	conflicts = pila
	options = !strip
	backup = etc/xdg/xdg-desktop-portal/pila-portals.conf
	backup = etc/xdg/xdg-desktop-portal-wlr/pila
	source = pila::git+https://github.com/igalmarino/pila.git
	sha256sums = SKIP

pkgname = pila-git
