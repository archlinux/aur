pkgbase = uefi-sdk-git
	pkgdesc = UEFI SDK based on EDK II to make UEFI application development easy
	pkgver = 2.0.0.r1.g543c791
	pkgrel = 1
	url = https://github.com/davispuh/UEFI-SDK
	arch = any
	license = Apache-2.0
	license = BSD-2-Clause-Patent
	license = MIT
	license = UNLICENSE
	makedepends = acpica
	makedepends = git
	makedepends = util-linux-libs
	makedepends = nasm
	makedepends = clang
	makedepends = cmake
	options = !buildflags
	source = git+https://github.com/davispuh/UEFI-SDK.git
	source = edk2::git+https://github.com/tianocore/edk2.git
