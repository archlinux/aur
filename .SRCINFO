pkgbase = waycast
	pkgdesc = Miracast source for wlroots compositors, with Hyprland extend-desktop support
	pkgver = 0.6.1
	pkgrel = 1
	url = https://github.com/alchemy/waycast
	install = waycast.install
	arch = x86_64
	arch = aarch64
	license = MIT
