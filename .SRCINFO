pkgbase = objfw
	pkgdesc = Portable, lightweight framework for the Objective-C language
	pkgver = 1.3
	pkgrel = 1
	url = https://objfw.nil.im/
	arch = x86_64
	groups = objfw
	license = LGPL3
	makedepends = clang
	source = https://objfw.nil.im/downloads/objfw-1.3.tar.gz
	sha256sums = de9e8a84437c01dacb9e83d7de0e3f7add3152165707d51a4caec640e4f56ba6

pkgname = libobjfw
	pkgdesc = ObjFW library
	depends = glibc
	depends = gcc-libs
	depends = libobjfwrt
	depends = bash

pkgname = libobjfwrt
	pkgdesc = ObjFW Objective-C runtime library
	depends = glibc
	depends = gcc-libs

pkgname = libobjfwtls
	pkgdesc = TLS support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = openssl

pkgname = libobjfwhid
	pkgdesc = HID support for ObjFW
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofarc
	pkgdesc = Utility for handling ZIP, Tar, LHA and Zoo archives
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofdns
	pkgdesc = Utility for performing DNS requests on the command line
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhash
	pkgdesc = Utility to hash files with various cryptographic hash functions
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt

pkgname = ofhttp
	pkgdesc = Command line downloader for HTTP(S)
	depends = glibc
	depends = gcc-libs
	depends = libobjfw
	depends = libobjfwrt
	depends = libobjfwtls
