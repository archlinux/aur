	source = Shelly-Flatpak-Backend-linux-x64-3.1.0.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/releases/download/v3.1.0/Shelly-Flatpak-Backend-linux-x64.tar.gz
