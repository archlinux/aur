pkgbase = shelly
	pkgver = 3.0.5
	pkgrel = 1
	url = https://github.com/Seafoam-Labs/Shelly-ALPM
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = git
	makedepends = pkgconf
	makedepends = gtk4
	makedepends = zig>=0.16
	makedepends = clang
	makedepends = gettext
	makedepends = flatpak
	makedepends = ripgrep
	makedepends = go-md2man
	source = shelly-3.0.5.tar.gz::https://github.com/Seafoam-Labs/Shelly-ALPM/archive/v3.0.5.tar.gz
	sha256sums = 3f7e231cc7522a1e7644cde1f848218f6a3260c44b45394513473752fa2e7e96

pkgname = shelly
	pkgdesc = Shelly: A Modern Arch Package Manager
	depends = pacman
	depends = gtk4
	depends = glib2
	depends = sudo
	depends = tar
	depends = bash
	depends = git
	depends = hicolor-icon-theme
	depends = dbus
	depends = glibc
	depends = libarchive
	depends = dconf
	depends = gnupg
	depends = zstd
	depends = json-glib
	optdepends = fish: Fish shell completions
	optdepends = zsh: Zsh shell completions
	optdepends = libstarfish: dependency viewer for arch packages
	optdepends = shelly-flatpak-backend: Flatpak package management support
	optdepends = fuse2: run AppImages that require FUSE 2
	provides = shelly
	conflicts = shelly-git
	conflicts = shelly-bin

pkgname = shelly-flatpak-backend
	pkgdesc = Optional native Flatpak backend for Shelly
	depends = shelly=3.0.5
	depends = flatpak
	provides = shelly-flatpak-backend=3.0.5
	conflicts = shelly-flatpak-backend-git
	conflicts = shelly-flatpak-backend-bin
