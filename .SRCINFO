pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.16.10.arch1
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.16.10.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.16.10.arch1-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.16.10.arch1-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.16.10.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.16.10.arch1-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.16.10.arch1-1-x86_64.pkg.tar.zst
	sha256sums = c807fd6952b3765ce093a1bf3456dc54835ebf59d778ad960a908ff45aa82944
	sha256sums = f927e9f46023314da267f75b89887325522698eba5aea137688a5f8e1a2d11cc
	sha256sums = 33c39f14c515ff3ff1ebb61a8b20a3e796b33dbcbbd39665585afc92d58fffd7

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.16.10.arch1-1-bin
	depends = linux6.16.10.arch1-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.16.10.arch1-1-headers-bin
	depends = linux6.16.10.arch1-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.16.10.arch1-1-docs-bin
	depends = linux6.16.10.arch1-1-docs-bin

pkgname = linux6.16.10.arch1-1-bin
	pkgdesc = The Linux kernel and modules, version 6.16.10-arch1-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.16.10.arch1-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.16.10-arch1-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.16.10.arch1-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.16.10-arch1-1
	conflicts = linux-docs
