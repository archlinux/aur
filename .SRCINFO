pkgbase = melody-git
	pkgdesc = Music engine, speakers and command line (built from HEAD)
	pkgver = r421.gadb8d61
	pkgrel = 1
	url = https://github.com/carnager/melody-next
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-only
	makedepends = cmake
	makedepends = git
	makedepends = ninja
	makedepends = nlohmann-json
	makedepends = curl
	makedepends = ffmpeg
	makedepends = libebur128
	makedepends = libopenmpt
	makedepends = libpipewire
	makedepends = libutf8proc
	makedepends = openssl
	makedepends = sqlite
	makedepends = taglib
	source = melody-next::git+https://github.com/carnager/melody-next.git
	sha256sums = SKIP

pkgname = melody-git
	pkgdesc = Melody: the engine, the agent and the command line (metapackage)
	depends = melodyd-git
	depends = melody-agent-git
	depends = melody-cli-git

pkgname = melodyd-git
	pkgdesc = Melody music engine: library, playback and outputs, shared on the network
	install = melody.install
	depends = curl
	depends = ffmpeg
	depends = libopenmpt
	depends = libpipewire
	depends = libutf8proc
	depends = openssl
	depends = sqlite
	depends = taglib
	provides = melodyd
	conflicts = melodyd

pkgname = melody-agent-git
	pkgdesc = Speakers for Melody engines: finds the engines on the network and plays for them
	install = melody-agent.install
	depends = curl
	depends = ffmpeg
	depends = libopenmpt
	depends = libpipewire
	depends = libutf8proc
	depends = openssl
	depends = sqlite
	depends = taglib
	provides = melody-agent
	conflicts = melody-agent
