pkgbase = yakuda-connect
	pkgdesc = WiVRn VR management software with gaming optimization and OpenXR/OpenVR fixes
	pkgver = 1.1.8
	pkgrel = 1
	url = https://github.com/yakuda-stack/yakuda-connect
	arch = any
	license = GPL-3.0-or-later
	depends = python
	depends = pyside6
	depends = python-setproctitle
	optdepends = iproute2: Headset-Verbindungserkennung (ss)
	optdepends = libpulse: Headset-Verbindungserkennung (pactl)
	optdepends = polkit: Wiederherstellen von System-VR-Dateien (pkexec)
	optdepends = git: Herunterladen des WayVR-Overlay-Designs
	optdepends = curl: Alternative zum Design-Download (falls kein git)
	optdepends = playerctl: Media-Tasten in der WayVR-Watch
	optdepends = yay: Installation der Tools ueber den AUR
	optdepends = flatpak: Installation einzelner Tools (ProtonPlus, Unity Hub) ueber Flathub
	optdepends = fuse2: AppImage-Tools mit klassischem Runtime (aeltere AppImages)
	optdepends = fuse3: AppImage-Tools mit neuem type2-Runtime (Standard)
	optdepends = libcap: VR-Prioritaet setzen (setcap/getcap)
	optdepends = wivrn-server: VR-Streaming-Server (Kernfunktion)
	optdepends = wivrn-dashboard: Konfigurationsoberflaeche fuer WiVRn
	optdepends = opencomposite-git: OpenVR-Kompatibilitaet fuer VRChat & Co.
	provides = yakuda-connect
	conflicts = yakuda-connect-git
	source = yakuda-connect-1.1.8.tar.gz::https://github.com/yakuda-stack/yakuda-connect/archive/refs/tags/v1.1.8.tar.gz
