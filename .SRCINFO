pkgbase = libfronius
	pkgver = 1.0.11
	pkgrel = 1
	url = https://github.com/ahpohl/libfronius
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cmake
	makedepends = git
	makedepends = doxygen
	makedepends = pkgconf
	makedepends = libmodbus
	source = libfronius-1.0.11::git+https://github.com/ahpohl/libfronius.git#tag=v1.0.11
	sha256sums = 11d17bae2095d7603da8f8bd5b7138220a287f95d2c93152cbd69e31a33ee52d

pkgname = libfronius
	pkgdesc = Library to access Fronius inverters
	depends = libmodbus
	optdepends = libfronius-docs: HTML documentation
	options = strip
	options = debug
	options = staticlibs

pkgname = libfronius-docs
	pkgdesc = HTML documentation for libfronius
	arch = any
	optdepends = graphviz: diagrams for docs
	options = !strip
	options = !debug
