pkgname = linux-zen-versioned-bin
	pkgdesc = Metapackage depending on linux6.11.7.zen1-1-zen-bin
	depends = linux6.11.7.zen1-1-zen-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-zen-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.11.7.zen1-1-zen-headers-bin
	depends = linux6.11.7.zen1-1-zen-headers-bin

pkgname = linux-zen-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.11.7.zen1-1-zen-docs-bin
	depends = linux6.11.7.zen1-1-zen-docs-bin

pkgname = linux6.11.7.zen1-1-zen-bin
	pkgdesc = The Linux ZEN kernel and modules, version 6.11.7-zen1-1-zen
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = UKSMD-BUILTIN
	provides = VHBA-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-zen

pkgname = linux6.11.7.zen1-1-zen-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux ZEN kernel 6.11.7-zen1-1-zen
	depends = pahole
	conflicts = linux-zen-headers

pkgname = linux6.11.7.zen1-1-zen-docs-bin
	pkgdesc = Documentation for the Linux ZEN kernel 6.11.7-zen1-1-zen
	conflicts = linux-zen-docs
