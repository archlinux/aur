pkgbase = control-ofc-daemon
	pkgdesc = Hardware fan control daemon for Linux (OpenFan, hwmon, GPU)
	pkgver = 2.12.3
	pkgrel = 1
	url = https://github.com/Plan-B-Development/control-ofc-daemon
	install = control-ofc-daemon.install
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = scdoc
	depends = glibc
	depends = systemd-libs
	depends = libgcc
	optdepends = lm_sensors: sensors verification CLI; sensors-detect (last resort) for chips not covered by the built-in module list
	optdepends = nvidia-utils: NVML runtime (libnvidia-ml.so.1) for opt-in [detection] enable_nvidia_telemetry=true (DEC-204); the open nouveau driver does not need it
	optdepends = it87-dkms-git: out-of-tree driver for ITE 8625E/8686E/8688E/8689E/8696E/87952E (most newer Gigabyte boards)
	optdepends = nct6687d-dkms-git: out-of-tree driver for Nuvoton NCT6687-R (most newer MSI boards)
	optdepends = nct6686d-dkms-git: out-of-tree driver for Nuvoton NCT6686D (some newer ASRock boards)
	optdepends = dkms: required by the *-dkms-git driver packages above
	optdepends = linux-headers: required by DKMS to build out-of-tree drivers (must match your running kernel)
	conflicts = control-ofc-gui<2.0.0
	options = !lto
	backup = etc/control-ofc/daemon.toml
	backup = etc/control-ofc/profiles/quiet.json
	backup = etc/modules-load.d/control-ofc.conf
	source = control-ofc-daemon-2.12.3.tar.gz::https://github.com/Plan-B-Development/control-ofc-daemon/archive/v2.12.3.tar.gz
	sha256sums = b33fdf76a9f1fc3de3c6171de59ebde95c80df22b94dfeeddec4c6959cb2233b

pkgname = control-ofc-daemon
