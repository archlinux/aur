pkgbase = zensmu-git
	pkgdesc = Safety-first Rust CLI, live TUI, and unprivileged GUI for AMD Ryzen SMU control and telemetry
	pkgver = 0.1.1.r0.gc458c83
	pkgrel = 1
	url = https://github.com/brauliobo/zensmu
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = git
	depends = polkit
	depends = gcc-libs
	depends = glibc
	optdepends = ryzen_smu-dkms-git: required DKMS kernel module providing /sys/kernel/ryzen_smu_drv (needed on Arch/CachyOS unless built into a custom kernel)
	optdepends = libglvnd: OpenGL support for zensmu-gui
	optdepends = libxkbcommon: keyboard support for zensmu-gui on Wayland/X11
	optdepends = wayland: native Wayland windowing for zensmu-gui
	optdepends = libxcb: X11 windowing for zensmu-gui
	provides = zensmu
	conflicts = zensmu
	conflicts = zensmu-bin
	source = zensmu-git::git+https://github.com/brauliobo/zensmu.git
	sha256sums = SKIP

pkgname = zensmu-git
