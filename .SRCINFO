	depends = vulkan-icd-loader
	depends = xorg-xauth
	depends = xkeyboard-config
	optdepends = vulkan-driver: required Vulkan implementation for your GPU
	optdepends = xorg-fonts-misc: core X11 bitmap fonts for legacy clients
	optdepends = lightdm: graphical login (see the example drop-in in /usr/share/doc)
	options = !lto
