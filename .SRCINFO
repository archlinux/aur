pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.16.arch2
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.16.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.16.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.16.arch2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.16.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.16.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.16.arch2-1-x86_64.pkg.tar.zst
	sha256sums = 721f509261a58bfbeb4d1be1e9c3029b82e6e387f625f88ef7a4b62b7fc62997
	sha256sums = 7c162f76cdbed09baebffec96ed04427170b8b60dc58b61bc7449765180a96c2
	sha256sums = 5272f7cebae1e315669b43ac0ca0761fe0e131b13468e982d80598886de51621

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.16.arch2-1-bin
	depends = linux6.16.arch2-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.16.arch2-1-headers-bin
	depends = linux6.16.arch2-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.16.arch2-1-docs-bin
	depends = linux6.16.arch2-1-docs-bin

pkgname = linux6.16.arch2-1-bin
	pkgdesc = The Linux kernel and modules, version 6.16.0-arch2-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.16.arch2-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.16.0-arch2-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.16.arch2-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.16.0-arch2-1
	conflicts = linux-docs
