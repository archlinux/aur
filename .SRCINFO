pkgbase = lituus-bin
	pkgdesc = Settings app for Hyprland and other desktops without one (prebuilt binary)
	pkgver = 0.4.1
	pkgrel = 1
	url = https://github.com/giosuel/lituus
	arch = x86_64
	arch = aarch64
	license = AGPL-3.0-or-later
	license = OFL-1.1
	depends = fontconfig
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libglvnd
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = libxrandr
	depends = networkmanager
	depends = wayland
	optdepends = networkmanager-openvpn: OpenVPN connections
	optdepends = networkmanager-openconnect: Cisco AnyConnect connections, with web sign-in
	optdepends = bluez: Bluetooth, and files over Bluetooth (its obexd)
	optdepends = pipewire-pulse: the Sound page and Bluetooth audio profiles
	optdepends = hyprland: the Displays, Keyboard, Mouse & touchpad and Shortcuts pages
	optdepends = awww: the Wallpaper page (or hyprpaper)
	optdepends = hyprpaper: the Wallpaper page (or awww)
	optdepends = matugen: colours that follow the wallpaper
	optdepends = xdg-terminal-exec: the default terminal on Default apps
	optdepends = pacman-contrib: current update counts on System (checkupdates)
	optdepends = xdg-desktop-portal: file dialogs (certificates, VPN files, files to send)
	optdepends = gnome-keyring: passwords kept "for me only" (or KWallet)
	provides = lituus=0.4.1
	conflicts = lituus
	options = !debug
	source_x86_64 = https://github.com/giosuel/lituus/releases/download/v0.4.1/Lituus-0.4.1-linux-x64.tar.gz
	sha256sums_x86_64 = a7c8e92ace54a81f5cd9dcb116ce952d6df1aea27f8d86b8f56750574f8adb3c
	source_aarch64 = https://github.com/giosuel/lituus/releases/download/v0.4.1/Lituus-0.4.1-linux-arm64.tar.gz
	sha256sums_aarch64 = 974a6c0f04816ccd0f1f6f6bb3357d3de72fb8b522253da1d53706a7f9e8b1d7

pkgname = lituus-bin
