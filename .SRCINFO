pkgbase = efr-code
	pkgdesc = Terminal-first AI agent harness that lives in zsh, with a daemon that owns the state
	pkgver = 0.0.8
	pkgrel = 1
	url = https://github.com/eggfriedrice24/eggfriedrice.code
	install = efr-code.install
	arch = x86_64
	license = MIT
	checkdepends = cargo-nextest
	checkdepends = git
	makedepends = cargo
	depends = glibc
	depends = libgcc
	depends = zsh
	optdepends = bubblewrap: the kernel sandbox of the auto mode (also needs Linux 7.1 or newer)
	optdepends = fzf: the live search picker of ,resume (0.46 or newer)
	optdepends = git: project roots and the git facts of a turn
	optdepends = xdg-dbus-proxy: read-only system queries in the auto mode (0.1.9 or newer)
