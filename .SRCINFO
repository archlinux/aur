pkgbase = bun
	pkgdesc = Bun is a fast JavaScript all-in-one toolkit. This PKGBUILD builds from source, resulting into a smaller and faster binary depending on your CPU.
	pkgver = 1.2.17
	pkgrel = 1
	url = https://github.com/oven-sh/bun
	arch = x86_64
	license = GPL
	makedepends = ccache
	makedepends = clang19
	makedepends = cmake
	makedepends = git
	makedepends = go
	makedepends = icu
	makedepends = libdeflate
	makedepends = libiconv
	makedepends = libtool
	makedepends = lld19
	makedepends = llvm19
	makedepends = ninja
	makedepends = nodejs
	makedepends = mold
	makedepends = pkgconf
	makedepends = python
	makedepends = ruby
	makedepends = ruby-getoptlong
	makedepends = rust
	makedepends = unzip
	makedepends = yarn
	conflicts = bun-bin
	conflicts = bun-git
	options = ccache
	options = lto
	source = bun::git+https://github.com/oven-sh/bun.git#tag=bun-v1.2.17
	source = brotliFlag.patch
