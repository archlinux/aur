pkgbase = linux-versioned-bin
	pkgdesc = The Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.2.arch2
	pkgrel = 1
	url = https://github.com/archlinux/linux
	arch = x86_64
	license = GPL2
	noextract = linux-6.18.2.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-headers-6.18.2.arch2-1-x86_64.pkg.tar.zst
	noextract = linux-docs-6.18.2.arch2-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-6.18.2.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-headers-6.18.2.arch2-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-docs-6.18.2.arch2-1-x86_64.pkg.tar.zst
	sha256sums = c46a60163c8d2bd156a46822ecdb5e77930b62d3c627de184328189673c95cbe
	sha256sums = f1cc78c1ec08b8dbf5fbb9fa235ec6644fc17b46a84fa4b5dd1d5af6525537c5
	sha256sums = 36cddd5b2746d32fe9cffcfdae10711694a1d2e4ea0c7586ecc9c13826d8f817

pkgname = linux-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.2.arch2-1-bin
	depends = linux6.18.2.arch2-1-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.2.arch2-1-headers-bin
	depends = linux6.18.2.arch2-1-headers-bin

pkgname = linux-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.2.arch2-1-docs-bin
	depends = linux6.18.2.arch2-1-docs-bin

pkgname = linux6.18.2.arch2-1-bin
	pkgdesc = The Linux kernel and modules, version 6.18.2-arch2-1
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux
	replaces = virtualbox-guest-modules-arch
	replaces = wireguard-arch

pkgname = linux6.18.2.arch2-1-headers-bin
	pkgdesc = Headers and scripts for building modules for the Linux kernel 6.18.2-arch2-1
	depends = pahole
	conflicts = linux-headers

pkgname = linux6.18.2.arch2-1-docs-bin
	pkgdesc = Documentation for the Linux kernel 6.18.2-arch2-1
	conflicts = linux-docs
