	optdepends = cryfs: for CryFS backend
	optdepends = ecryptfs-simple: for eCryptfs backend
	optdepends = encfs: for EncFS backend
	optdepends = fscrypt: for fscrypt backend
	optdepends = gocryptfs: for gocryptfs backend
	optdepends = securefs: for securefs backend
	optdepends = sshfs: for SSHFS backend
