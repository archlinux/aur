pkgbase = bioma-shell
	pkgdesc = A desktop shell for niri, built with Quickshell: living surfaces rather than a bar
	pkgver = 1.0.0beta7
	pkgrel = 1
	url = https://github.com/AkusenArcade/Bioma
	install = bioma-shell.install
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = clang
	makedepends = pipewire
	depends = niri
	depends = quickshell
	depends = qt6-5compat
	depends = python
	depends = glib2
	depends = wl-clipboard
	depends = imagemagick
	depends = libpipewire
	depends = gcc-libs
	depends = glibc
	depends = util-linux
	depends = whisper-cpp
	depends = ggml-vulkan
	depends = whisper.cpp-model-large-v3-turbo-q5_0
	depends = python-evdev
	optdepends = matugen: palettes computed from the wallpaper
	optdepends = grim: screenshots
	optdepends = tesseract: text recognition from a region
	optdepends = wl-screenrec: screen recording (VAAPI)
	optdepends = wf-recorder: screen recording, fallback
	optdepends = networkmanager: Wi-Fi, wired, VPN profiles and proxy triggers
	optdepends = bluez-utils: Bluetooth
	optdepends = cups: printers in the connectivity cell
	optdepends = avahi: network printers found and added driverless
	optdepends = ddcutil: the brightness of external monitors
	optdepends = pipewire: audio and the alarm sound
	optdepends = upower: the battery, on a laptop
	optdepends = pciutils: the graphics card in the System cell
	optdepends = libnotify: timer and alarm notifications
	optdepends = hyprlock: the fallback lock screen
	optdepends = swaylock: the fallback lock screen, if hyprlock is not installed
	optdepends = greetd: the Bioma greeter
	optdepends = xdg-desktop-portal: the desktop file picker for the avatar
	optdepends = ttf-spectral: the expressive typeface
	optdepends = ttf-orbitron: the technical typeface
	options = !lto
	source = bioma-shell-1.0.0beta7.tar.gz::https://github.com/AkusenArcade/Bioma/archive/refs/tags/v1.0.0-beta.7.tar.gz
	sha256sums = 4f3ef9d467c2821d230eda0d0a46cecc509c0fdc1ce995e69b3c73a39ab0782a

pkgname = bioma-shell
