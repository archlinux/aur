pkgbase = flashmq-git
	pkgdesc = FlashMQ is a light-weight MQTT broker/server, designed to take good advantage of multi-CPU environments
	pkgver = 1.26.2.r38.gb7059ba
	pkgrel = 1
	url = https://github.com/halfgaar/FlashMQ
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = cmake
	makedepends = ninja
	makedepends = sed
	makedepends = docbook2x
	makedepends = libxslt
	depends = libgcc_s.so
	depends = libstdc++.so
	depends = openssl
	provides = flashmq
	conflicts = flashmq
	options = !strip
	options = !emptydirs
	backup = etc/flashmq/flashmq.conf
	source = flashmq::git+https://github.com/halfgaar/FlashMQ.git
	sha256sums = SKIP

pkgname = flashmq-git
