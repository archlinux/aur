pkgname = skwd-wall-v2-bin
	pkgdesc = Prebuilt GPU-rendered graphical client for the Skwd wallpaper suite v2
	depends = gcc-libs
	depends = libxkbcommon
	depends = skwd-deck-bin
	depends = skwd-paper-bin
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = skwd-lens-bin: semantic wallpaper search
	optdepends = skwd-paper-plasma: KDE Plasma wallpaper integration
	provides = skwd-wall-v2=1.0.0_beta.20
	conflicts = skwd-wall-v2

pkgname = skwd-deck-bin
	pkgdesc = Prebuilt control daemon and tools for the Skwd wallpaper suite
	install = skwd-deck.install
	depends = gcc-libs
	depends = skwd-paper-bin
	optdepends = skwd-deck-steamworks: Steam Client Workshop backend
	optdepends = skwd-lens-bin: semantic wallpaper search
	optdepends = steamcmd: alternative Steam Workshop backend
	provides = skwd-deck=1.0.0_beta.20
	provides = skwd-deck-bin=1.0.0_beta.4
	provides = skwd-deck-bin=1.0.0_beta.5
	provides = skwd-deck-bin=1.0.0_beta.6
	provides = skwd-deck-bin=1.0.0_beta.7
	provides = skwd-deck-bin=1.0.0_beta.8
	conflicts = skwd-deck

pkgname = skwd-paper-bin
	pkgdesc = Prebuilt still, video, and Wallpaper Engine renderers for Skwd
	depends = alsa-lib
	depends = dav1d
	depends = gcc-libs
	depends = libdrm
	depends = libglvnd
	depends = libpulse
	depends = libva
	depends = libxkbcommon
	depends = libyuv
	depends = shaderc
	depends = vulkan-icd-loader
	depends = wayland
	depends = zlib
	provides = skwd-paper=1.0.0_beta.20
	provides = skwd-paper-bin=1.0.0_beta.4
	provides = skwd-paper-bin=1.0.0_beta.5
	provides = skwd-paper-bin=1.0.0_beta.6
	provides = skwd-paper-bin=1.0.0_beta.7
	provides = skwd-paper-bin=1.0.0_beta.8
	conflicts = skwd-paper

pkgname = skwd-lens-bin
	pkgdesc = Prebuilt optional semantic wallpaper search engine for Skwd
	depends = gcc-libs
	depends = skwd-lens-model
	depends = skwd-lens-model
	provides = skwd-lens=1.0.0_beta.20
	conflicts = skwd-lens
