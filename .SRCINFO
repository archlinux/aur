pkgbase = ankaios
	pkgver = 1.0.2
	pkgrel = 1
	url = https://eclipse-ankaios.github.io/ankaios
	arch = x86_64
	arch = aarch64
	groups = ankaios
	license = Apache-2.0
	makedepends = cargo
	makedepends = protobuf
	makedepends = help2man
	depends = libgcc
	depends = glibc
	source = ankaios-1.0.2.tar.gz::https://github.com/eclipse-ankaios/ankaios/archive/refs/tags/v1.0.2.tar.gz
	source = ank-server.service
	source = ank-agent.service
