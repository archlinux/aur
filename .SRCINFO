pkgbase = magi
	pkgdesc = Keyboard-driven Git TUI inspired by Magit
	pkgver = 0.5.0
	pkgrel = 1
	url = https://github.com/anddani/magi
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = pkg-config
	depends = zlib
	depends = openssl
	depends = libgit2
	depends = libssh2
	options = !debug
	source = git+https://github.com/anddani/magi
	sha512sums = SKIP

pkgname = magi
