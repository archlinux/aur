	depends = libsoup3
	depends = openssl
	depends = glib2
	depends = glibc
	depends = cairo
	depends = gdk-pixbuf2
	depends = libgcc
	depends = hicolor-icon-theme
	provides = creamlinux
	conflicts = creamlinux
