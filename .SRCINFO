pkgname = solana-cli
	pkgdesc = Solana CLI tools
	depends = bzip2
	depends = glibc
	depends = libgcc
	depends = systemd-libs
	depends = zstd
	provides = spl-token
	conflicts = spl-token
	conflicts = solana-bin

pkgname = agave-validator
	pkgdesc = Agave validator and node operator tools for Solana
	install = agave-validator.install
	depends = bzip2
	depends = glibc
	depends = libcap
	depends = libgcc
	depends = libstdc++
	depends = zlib
	depends = zstd

pkgname = solana-dev
	pkgdesc = Solana program developer tools
	install = solana-dev.install
	depends = bzip2
	depends = cargo
	depends = clang
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = lld
	depends = llvm
	depends = rust
	depends = zlib
	depends = zstd
	conflicts = solana-dev-bin
	options = !strip
	options = !debug
	options = !lto

pkgname = solana
	pkgdesc = A fast, secure, and censorship resistant blockchain (meta package)
	arch = any
	depends = solana-cli
	depends = agave-validator
	depends = solana-dev
