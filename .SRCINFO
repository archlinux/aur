pkgbase = omniphony-studio-egui-bin
	pkgdesc = Omniphony Studio native (egui) control and 3D visualization UI for the orender spatial audio engine (binary release)
	pkgver = 0.7.0
	pkgrel = 1
	url = https://github.com/mgth/Omniphony
	arch = x86_64
	license = GPL-3.0-only
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = pipewire
	depends = libglvnd
	depends = libx11
	depends = libxcb
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = harletty-bridge: decode compressed/object-audio formats via the orender bridge plugin
	optdepends = noto-fonts-cjk: Japanese and Chinese labels
	optdepends = vulkan-driver: GPU rendering through Vulkan (otherwise wgpu falls back to OpenGL/EGL)
	optdepends = xdg-desktop-portal: native file dialogs (layout import and export)
