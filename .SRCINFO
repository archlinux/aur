pkgbase = dbar-bin
	pkgdesc = A small, event-driven Wayland status bar for Sway, SwayFX, niri and Hyprland (prebuilt)
	pkgver = 0.9.3
	pkgrel = 2
	url = https://github.com/dborovcanin/dbar
	arch = x86_64
	license = Apache-2.0
	depends = glibc
	depends = libgcc
	depends = libpipewire
	optdepends = noto-fonts: the default font family and the Latin fallback
	optdepends = noto-fonts-emoji: colour emoji in window titles and track names
	optdepends = noto-fonts-cjk: Chinese, Japanese and Korean window titles
	optdepends = ttf-nerd-fonts-symbols: Nerd Font glyphs in workspace names
	optdepends = sway: one of the compositors dbar reads workspaces and window titles from
	optdepends = niri: one of the compositors dbar reads workspaces and window titles from
	optdepends = hyprland: one of the compositors dbar reads workspaces and window titles from
	provides = dbar=0.9.3
	conflicts = dbar
	conflicts = dbar-git
	options = !strip
	options = !debug
	source = dbar-0.9.3-linux-x86_64::https://github.com/dborovcanin/dbar/releases/download/v0.9.3/dbar-linux-x86_64
	source = dbar-0.9.3.tar.gz::https://github.com/dborovcanin/dbar/archive/refs/tags/v0.9.3.tar.gz
	sha256sums = 537ec5f18b20e27a10df61e254c85a7dee21e9bc3352967da0a1f9733ac633b9
