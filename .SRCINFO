	optdepends = python-fastapi: HTTP layer for the `laya-serve` server
	optdepends = uvicorn: ASGI server that `laya-serve` starts
	optdepends = python-mcp>=2.2.0: MCP stdio server behind `laya-mcp-server`
	optdepends = python-pydantic: typed-model helpers in `laya.structured`
	optdepends = python-langchain-core: LangChain runnables in `laya.integrations`
	optdepends = python-langgraph: LangGraph runnables in `laya.integrations`
	optdepends = python-llama-index-core: LlamaIndex router and selector integrations in `laya.integrations`
	optdepends = python-crewai: CrewAI delegation router in `laya.integrations`
	optdepends = python-onnx: ONNX export for the ONNX Runtime engine
	optdepends = python-onnxruntime-cpu: ONNX Runtime engine in `laya.onnx_agent` (the -cuda/-rocm variants work too)
	optdepends = python-onnxscript: scripting backend that `torch.onnx.export` needs for the ONNX engine
	optdepends = python-tilelang: TileLang GPU fast path in `laya.fast`
