	optdepends = imagemagick: for image conversion
	optdepends = libheif: for HEIC/HEIF image conversion
	optdepends = mariadb: for MySQL database driver
	optdepends = perl-image-exiftool: for extracting metadata
	optdepends = rawtherapee: for RAW to JPEG conversion
	backup = etc/photoprism/defaults.yml
