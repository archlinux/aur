pkgbase = arch-smart-update
	pkgdesc = Intelligent update advisor and wrapper for Arch Linux and derivatives
	pkgver = 3.28.5
	pkgrel = 1
	url = https://github.com/motorrin/arch-smart-update
	arch = any
	license = MIT
	depends = bash
	depends = python
	depends = pacman
	depends = pacman-contrib
	depends = tar
	depends = gawk
	depends = coreutils
	depends = curl
	depends = zstd
	depends = grep
	depends = sed
	optdepends = rate-mirrors: for fast Arch Linux mirror ranking (primary)
	optdepends = reflector: for Arch Linux mirror ranking (fallback)
	optdepends = rebuild-detector: for detecting foreign AUR packages requiring rebuild (checkrebuild)
	optdepends = cachyos-rate-mirrors: for CachyOS mirror updates
	optdepends = eos-rankmirrors: for EndeavourOS mirror updates
	optdepends = eos-update: for EndeavourOS core updates
	optdepends = cachy-update: for CachyOS core updates
	optdepends = arch-update: for general Arch core updates
	optdepends = yay: AUR helper support
	optdepends = paru: AUR helper support
	optdepends = pikaur: AUR helper support
	optdepends = aura: AUR helper support
	optdepends = rua: AUR helper support
	optdepends = trizen: AUR helper support
	optdepends = pacaur: AUR helper support
	optdepends = pakku: AUR helper support
	optdepends = topgrade: for comprehensive system updates
	optdepends = fakeroot: for running the background update checker without sudo
	optdepends = libnotify: for desktop notifications in daemon mode
	optdepends = util-linux: for terminal log capture (script), state locking (flock) and detached execution (setsid)
	optdepends = xdg-utils: for opening Arch News links in default browser (xdg-open)
	optdepends = xdg-terminal-exec: for spawning default desktop terminal from notifications
	optdepends = flatpak: for cleaning unused runtimes during post-update cleanup
	optdepends = gamemode: to postpone background checks when gaming
	optdepends = snap-pac: for automatic Btrfs snapshots on update (if using snapper)
	optdepends = psmisc: for alternative pacman lock detection using fuser
	source = arch-smart-update-3.28.5.tar.gz::https://github.com/motorrin/arch-smart-update/archive/refs/tags/v3.28.5.tar.gz
