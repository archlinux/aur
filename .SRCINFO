pkgbase = qbzd
	pkgdesc = QBZ headless Qobuz daemon for servers and appliances
	pkgver = 2.1.0
	pkgrel = 1
	url = https://github.com/vicrodh/qbz
	install = qbzd.install
	arch = x86_64
