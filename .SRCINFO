pkgbase = owlry
	pkgdesc = Lightweight Wayland application launcher with plugin support
	pkgver = 1.0.2
	pkgrel = 1
	url = https://somegit.dev/Owlibou/owlry
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	depends = owlry-core
	depends = gcc-libs
	depends = gtk4
