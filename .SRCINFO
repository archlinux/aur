pkgbase = atmosphera-git
	pkgdesc = Atmosphera - a customizable desktop shell for Niri and Hyprland, built with Quickshell (git version)
	pkgver = 0.6.0.r0.g0000000
	pkgrel = 8
	url = https://github.com/alexindigo/atmosphera
	install = atmosphera-git.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = quickshell
	depends = qt6-dbusqml>=0.8.0
	depends = qt6-pipewirespectrum
	depends = qt6-xdgiconqml-git
	depends = imagemagick
	depends = brightnessctl
	depends = ffmpeg
	depends = qt6-multimedia
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = wlr-randr
	optdepends = cliphist: For clipboard history support
	optdepends = wlsunset: For supporting NightLight
	optdepends = power-profiles-daemon: For power profile management
	optdepends = ddcutil: For external display brightness control
	optdepends = qt6-niriqml: niri IPC integration (workspaces, windows, session config)
	optdepends = qt6-mangowcqml: mangowc IPC integration (workspaces, windows, session config)
	optdepends = keyd: hardware-level keyboard remapping (bindings environments)
	optdepends = xremap-niri-bin: session-level app-scoped keymaps (macos bindings)
	optdepends = qt6-5compat: required by some registry plugins (e.g. cookie-clock)
	optdepends = qt6-websockets: required by some registry plugins (e.g. hassio)
	optdepends = xdg-desktop-portal-gnome: screencast / screen-sharing support (niri cannot use -wlr)
	provides = atmosphera
	provides = xdg-desktop-portal-impl
	conflicts = atmosphera
	source = git+https://github.com/alexindigo/atmosphera.git#branch=main
	sha256sums = SKIP

pkgname = atmosphera-git
