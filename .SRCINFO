pkgbase = proton-ge-git
	pkgdesc = Custom distribution of Valves Proton with various patches (built from git)
	pkgver = GE.Proton11.11.r1.g98efe1c
	pkgrel = 1
	url = https://github.com/GloriousEggroll/proton-ge-custom
	install = proton-ge-git.install
	arch = x86_64
	license = BSD-3-Clause
	license = LGPL-2.1-or-later
	license = Zlib
	license = MIT
	license = MPL-2.0
	license = LicenseRef-custom
	makedepends = git
	makedepends = perl
	makedepends = podman
	makedepends = wget
	depends = python
	optdepends = kdialog: KDE splash dialog support
	optdepends = zenity: GNOME splash dialog support
	optdepends = python-kivy: splash dialog support (big picture mode)
	optdepends = steam: use proton with steam like intended
	optdepends = lib32-vulkan-radeon: Radeon Vulkan support (32-bit)
	optdepends = lib32-vulkan-intel: Intel Vulkan support (32-bit)
	optdepends = lib32-nvidia-utils: NVIDIA support (32-bit)
	optdepends = vulkan-radeon: Radeon Vulkan support
	optdepends = vulkan-intel: Intel Vulkan support
	optdepends = nvidia-utils: NVIDIA support
	optdepends = lib32-vkd3d: vkd3d (32-bit)
	optdepends = winetricks: protonfixes backend - highly recommended
	optdepends = xboxdrv: gamepad driver service
	options = !strip
	options = emptydirs
	options = !lto
	backup = usr/share/steam/compatibilitytools.d/proton-ge-git/user_settings.py
	source = proton-ge-git::git+https://github.com/GloriousEggroll/proton-ge-custom.git
	source = user_settings.py
	source = launcher.sh
	source = proton-ge-custom-bin.conf
	source = pam_limits.conf
