pkgbase = linux-lts-versioned-bin
	pkgdesc = The LTS Linux kernel and modules | repackaged with a unique package name for each version
	pkgver = 6.18.44
	pkgrel = 1
	url = https://www.kernel.org
	arch = x86_64
	license = GPL2
	noextract = linux-lts-6.18.44-1-x86_64.pkg.tar.zst
	noextract = linux-lts-headers-6.18.44-1-x86_64.pkg.tar.zst
	noextract = linux-lts-docs-6.18.44-1-x86_64.pkg.tar.zst
	options = !strip
	source = https://archive.archlinux.org/packages/.all/linux-lts-6.18.44-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-headers-6.18.44-1-x86_64.pkg.tar.zst
	source = https://archive.archlinux.org/packages/.all/linux-lts-docs-6.18.44-1-x86_64.pkg.tar.zst
	sha256sums = 3d5c7119df06efbe6b75f81e0547a11fb279c3857c30df310836dbfe02601e1c
	sha256sums = 917ee1398027df4d8cbc20c9ae4b43210d2f814de4afdcf5279d321c38089bf9
	sha256sums = c79ad96b83fdb6bf3dddc2b33b50d04dc9023b02998ee8139789ddadb64f3d39

pkgname = linux-lts-versioned-bin
	pkgdesc = Metapackage depending on linux6.18.44-1-lts-bin
	depends = linux6.18.44-1-lts-bin
	optdepends = grub-hook: to run grub-mkconfig when kernels are added/removed

pkgname = linux-lts-versioned-headers-bin
	pkgdesc = Metapackage depending on linux6.18.44-1-lts-headers-bin
	depends = linux6.18.44-1-lts-headers-bin

pkgname = linux-lts-versioned-docs-bin
	pkgdesc = Metapackage depending on linux6.18.44-1-lts-docs-bin
	depends = linux6.18.44-1-lts-docs-bin

pkgname = linux6.18.44-1-lts-bin
	pkgdesc = The LTS Linux kernel and modules, version 6.18.44-1-lts
	depends = coreutils
	depends = initramfs
	depends = kmod
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = linux-lts-headers: headers and scripts for building modules
	optdepends = scx-scheds: to use sched-ext schedulers
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	provides = KSMBD-MODULE
	provides = NTSYNC-MODULE
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	conflicts = linux-lts
	replaces = wireguard-lts

pkgname = linux6.18.44-1-lts-headers-bin
	pkgdesc = Headers and scripts for building modules for the LTS Linux kernel 6.18.44-1-lts
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	provides = LINUX-HEADERS
	conflicts = linux-lts-headers

pkgname = linux6.18.44-1-lts-docs-bin
	pkgdesc = Documentation for the LTS Linux kernel 6.18.44-1-lts
	conflicts = linux-lts-docs
