pkgbase = novabrowser
	pkgdesc = AVX2-optimized keyboard-driven web browser on Chromium (CEF), configured in TypeScript
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/Novaturiente/nova-browser
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = cmake
	makedepends = ninja
	depends = sqlite
	depends = gtk3
	depends = nss
	depends = alsa-lib
	depends = libxss
	depends = libxkbcommon
	depends = libdrm
	depends = mesa
	depends = libcups
	depends = at-spi2-core
	optdepends = wl-clipboard: primary selection and paste on Wayland
	optdepends = xclip: primary selection and paste on X11
	optdepends = xdg-utils: download-open and default-browser setup
	optdepends = aria2: faster downloads (8 connections), resume after restart, magnet links and torrents
	optdepends = rbw: Bitwarden passwords
	optdepends = pass: password-store passwords
	conflicts = novabrowser-bin
	conflicts = novabrowser-git
	options = strip
	options = !lto
	options = !debug
