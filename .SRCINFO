pkgbase = mmsimpulse-git
	pkgdesc = A bare KWin Wayland session for any shell, with Hyprland-style workspaces, config and IPC
	pkgver = r193.6e19f7d
	pkgrel = 1
	url = https://github.com/mahirsn/mmsimpulse
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cmake
	makedepends = extra-cmake-modules
	makedepends = wayland-protocols
	makedepends = wlr-protocols
	depends = kwin
	depends = kglobalacceld
	depends = xdg-desktop-portal-kde
	depends = python
	depends = python-dbus
	depends = python-gobject
	depends = systemd
	depends = wl-clipboard
	depends = wl-clip-persist
	depends = lua
	optdepends = quickshell: Quickshell-based shells such as Dux
	optdepends = libnotify: a notification when mmsimpulse.lua has a mistake
	optdepends = powerdevil: idle timeouts, DPMS, suspend and brightness
	optdepends = upower: battery status
	optdepends = libkscreen: monitors in mmsimpulse.lua, and the modes niri and Hyprland IPC report (kscreen-doctor)
	optdepends = wireplumber: the volume keys (wpctl)
	optdepends = kdeplasma-addons: task switcher layouts, without which Alt+Tab draws nothing
	optdepends = kitty: the terminal on Meta+Return
	optdepends = cliphist: clipboard history
	optdepends = breeze: the default cursor theme, which KWin warns about when absent
	provides = mmsimpulse
	conflicts = mmsimpulse
	source = mmsimpulse-git::git+https://github.com/mahirsn/mmsimpulse.git
	sha256sums = SKIP

pkgname = mmsimpulse-git
