+#define MT76_CASE_NAN_DATA
+#define MT76_VIF_IS_NAN_DATA(vif)	(false)
+#ifndef CFG80211_NAN_MAX_PEER_MAPS
+#define CFG80211_NAN_MAX_PEER_MAPS	1
+#endif
