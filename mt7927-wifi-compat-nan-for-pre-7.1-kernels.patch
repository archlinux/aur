 #include "mt76_connac.h"
 
+/* NL80211_IFTYPE_NAN_DATA and the NAN peer schedule API arrived in Linux 7.1.
+ * Kbuild defines MT76_NO_NAN when the host headers do not provide them, and
+ * the NAN code then builds as stubs.
+ */
