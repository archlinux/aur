+#define CFG80211_NAN_SCHED_NUM_TIME_SLOTS	32
+#endif
+#else
+#define MT76_CASE_NAN_DATA		case NL80211_IFTYPE_NAN_DATA:
+#define MT76_VIF_IS_NAN_DATA(vif)	((vif)->type == NL80211_IFTYPE_NAN_DATA)
+#endif
