post_install() {
  echo "Codex++ installed without changing openai-codex-desktop."
  echo "Run 'sudo codex-plus-plus enable' only when you want Codex++ to take over the launcher."
}

post_upgrade() {
  echo "Restoring openai-codex-desktop launcher after Codex++ upgrade..."
  /usr/bin/codex-plus-plus disable >/dev/null 2>&1 || true
  echo "Run 'sudo codex-plus-plus enable' only when you want Codex++ to take over the launcher."
}

pre_remove() {
  /usr/bin/codex-plus-plus disable >/dev/null 2>&1 || true
}
