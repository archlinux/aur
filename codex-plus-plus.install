post_install() {
  echo "Applying Codex++ injection for openai-codex-desktop..."
  /usr/bin/codex-plus-plus apply
}

post_upgrade() {
  echo "Applying Codex++ injection for openai-codex-desktop..."
  /usr/bin/codex-plus-plus apply
}

pre_remove() {
  /usr/bin/codex-plus-plus disable >/dev/null 2>&1 || true
}
