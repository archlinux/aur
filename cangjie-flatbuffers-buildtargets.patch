+    BUILD_COMMAND ${CMAKE_COMMAND} --build . --target flatc flatbuffers
+)
 externalproject_get_property(flatbuffers SOURCE_DIR)
 set(FLATBUFFERS_SRC ${SOURCE_DIR})
