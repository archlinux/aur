post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;36m  shorin-pac 安装完成！ / shorin-pac installed!\e[0m"
    echo ""
    echo -e "  安装软件：\e[1;33mpac\e[0m    卸载软件：\e[1;33mpacr\e[0m    配置 AI：\e[1;33mpac config\e[0m"
    echo -e "  install: \e[1;33mpac\e[0m    remove: \e[1;33mpacr\e[0m    AI settings: \e[1;33mpac config\e[0m"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    post_install
    echo ""
    echo -e "  如果之前运行过 shorin link 或 shorin-pac link，请删除 ~/.local/bin 里旧的 pac / pacr / pacrrr 链接，"
    echo -e "  否则它们会遮住 /usr/bin/pac："
    echo -e "  If you ran 'shorin link' before, remove the stale ~/.local/bin/pac, pacr, pacrrr symlinks:"
    echo -e "\e[1;33m    rm -f ~/.local/bin/pac ~/.local/bin/pacr ~/.local/bin/pacrrr\e[0m"
}
