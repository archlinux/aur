#!/usr/bin/env bash
set -euo pipefail

VERSION="1.0.0"
if [[ "${1-}" == "--version" || "${1-}" == "-v" ]]; then
    echo "aurroamer $VERSION"
    exit 0
fi

refresh_cache=false
if [[ "${1-}" == "--refresh" || "${1-}" == "-r" ]]; then
    refresh_cache=true
fi

if [[ "${1-}" == "--help" || "${1-}" == "-h" ]]; then
    echo "aurroamer - browse AUR and official packages with fzf"
    echo
    echo "  usage:"
    echo "  aurroamer                    launch interactive mode"
    echo "  aurroamer --version / -v     show version"
    echo "  aurroamer --help / -h        show this message"
    echo "  aurroamer --clear / -c       clears stored package list cache"
    echo "  aurroamer --refresh / -r     skips the cache prompt and refreshes"
    exit 0
fi

cachedaur="$HOME/.cache/aurroamer-cache.txt"

if [[ "${1-}" == "--clear" || "${1-}" == "-c" ]]; then
    echo "deleting cached package list"
    if ! rm "$cachedaur"; then
        echo "no cache to delete, or other error"
        exit 1
    fi
    exit 0
fi

if ! [ -t 1 ]; then
    echo "error: aurroamer requires an interactive terminal"
    exit 1
fi

aurpackages=$(mktemp)
repopackages=$(mktemp)
total=$(mktemp)
trap 'rm -f "$aurpackages" "$repopackages" "$total"' EXIT

aur_helper=""
for helper in yay paru trizen pikaur; do
    if command -v "$helper" > /dev/null; then
        aur_helper="$helper"
        break
    fi
done

if ! command -v fzf > /dev/null; then
    echo "error: fzf is required but not installed"
    exit 1
fi

if [[ -z "$aur_helper" ]]; then
    echo "warning: no supported aur helper found — aur packages cannot be interacted with"
    sleep 2
else
    echo "using aur helper: $aur_helper"
    sleep 1
fi

if [[ -f "$cachedaur" ]]; then
echo "checking for cached aur package list"
if [[ "$refresh_cache" == true ]]; then
    echo "refreshing package list"
    if ! curl -Lsk https://aur.archlinux.org/packages.gz | gunzip > "$aurpackages"; then
        echo "failed to fetch aur packages"
        exit 1
    fi
    mkdir -p "$(dirname "$cachedaur")"
    cp "$aurpackages" "$cachedaur"
elif [[ -f "$cachedaur" ]]; then
    echo "cached aur package list found"
    echo "use cached list instead of downloading? it may be outdated [Y/n]"
    read -rp ">> " usecache
    if [[ ! "$usecache" =~ ^[Nn]$ ]]; then
        cp "$cachedaur" "$aurpackages"
    else
        echo "downloading list of all known aur packages"
        if ! curl -Lsk https://aur.archlinux.org/packages.gz | gunzip > "$aurpackages"; then
            echo "failed to fetch aur packages"
            exit 1
        fi
        cp "$aurpackages" "$cachedaur"
    fi
fi  
else
    echo "downloading list of all known aur packages"
    if ! curl -Lsk https://aur.archlinux.org/packages.gz | gunzip > "$aurpackages"; then
        echo "failed to fetch aur packages"
        exit 1
    fi
    mkdir -p "$(dirname "$cachedaur")"
    cp "$aurpackages" "$cachedaur"
fi

echo "making a list of known official packages"
if ! pacman -Slq > "$repopackages"; then
    echo "failed to fetch official packages"
    exit 1
fi

aur_count=$(wc -l < "$aurpackages")
repo_count=$(wc -l < "$repopackages")
total_count=$((aur_count + repo_count))
echo
echo "official package count: $repo_count"
echo "aur package count: $aur_count"
echo "total package count: $total_count"

sleep 1
echo
echo "browse which packages?"
echo "1) official only"
echo "2) aur only"
echo "3) all"
read -rp "> " mode
case "$mode" in
    1)
        fzf_input=$(awk '{printf "[official] %s\n", $0}' "$repopackages")
        ;;
    2)
        fzf_input=$(awk '{printf "[aur]      %s\n", $0}' "$aurpackages")
        ;;
    3)
        fzf_input=$( (awk '{printf "[aur]      %s\n", $0}' "$aurpackages"; awk '{printf "[official] %s\n", $0}' "$repopackages") )
        ;;
    *)
        exit 0
        ;;
esac

echo
sleep 1

while true; do
    selection=$(echo "$fzf_input" | fzf  --prompt="Search >> ")
    [[ -z "$selection" ]] && break

    pkgtype=$(awk '{print $1}' <<< "$selection")
    pkgname=$(awk '{print $2}' <<< "$selection")

    clear
    echo "you selected: $pkgname $pkgtype"
    echo
    sleep 1

    while true; do
        echo "choose an option:"
        echo "1) preview package info"
        echo "2) install package"
        echo "3) back to package list"
        read -rp ">> " choice

        case "$choice" in
            1)
                clear
                echo "[previewing $pkgname]"
                if [[ "$pkgtype" == "[official]" ]]; then
                    pacman -Si --color=always "$pkgname"
                elif [[ "$pkgtype" == "[aur]" ]]; then
                    if [[ -n "$aur_helper" ]]; then
                        "$aur_helper" -Si "$pkgname"
                    else
                        echo "no aur helper available"
                    fi
                fi
                echo
                read -n 1 -s -r -p "press any key to return"
                clear
                ;;
            2)
                clear
                echo "[installing $pkgname]"
                sleep 1
                if [[ "$pkgtype" == "[official]" ]]; then
                    sudo pacman -S "$pkgname"
                elif [[ "$pkgtype" == "[aur]" ]]; then
                    if [[ -n "$aur_helper" ]]; then
                        "$aur_helper" -S "$pkgname"
                    else
                        echo "no aur helper available"
                    fi
                fi
                echo
                read -n 1 -s -r -p "press any key to return"
                clear
                ;;
            3)
                clear
                break
                ;;
            *)
                echo "invalid option"
                read -n 1 -s -r -p "press any key to return"
                ;;
        esac
    done
done
