post_install() {
  if [ "$(cat /proc/sys/kernel/unprivileged_userns_clone 2>/dev/null)" -eq "0" ]; then
    echo "==> WARNING: Unprivileged user namespace cloning is disabled."
    echo "==> This tool will not work unless you enable it:"
    echo "    sysctl -w kernel.unprivileged_userns_clone=1"
  fi
}

