pre_remove() {
    echo "Removing all Swift installations..."
    runuser -l $SUDO_USER -c 'swiftly uninstall all -y'
}

post_remove() {
    USER_HOME=$(getent passwd $SUDO_USER | cut -d: -f6)
    if [ -d $USER_HOME/.local/share/swiftly ]; then
        rm -rf $USER_HOME/.local/share/swiftly
    fi
}
