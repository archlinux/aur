post_install() {
    echo -e "\e[1;33m=================================================================\e[0m"
    echo -e "\e[1;32m ArkSigner kurulumu tamamlandı!\e[0m"
    echo -e " Akıllı kart ve e-imza işlemlerini yapabilmek için arka plan"
    echo -e " servisini başlatmanız ve etkinleştirmeniz gerekmektedir."
    echo -e ""
    echo -e " \e[1;37msudo systemctl enable --now arksigner\e[0m"
    echo -e ""
    echo -e " Ayrıca sisteminizde 'pcscd' servisinin de çalıştığından"
    echo -e " emin olun (sudo systemctl enable --now pcscd)."
    echo -e "\e[1;33m=================================================================\e[0m"
}

post_upgrade() {
    post_install
}
