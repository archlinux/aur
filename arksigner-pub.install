post_install() {
    # 1. hosts girişi (eski web uygulamalarıyla geriye dönük uyumluluk için)
    if ! grep -q "local.pwsigner.ark-teknoloji.com" /etc/hosts; then
        echo "127.0.0.1  local.pwsigner.ark-teknoloji.com" >> /etc/hosts
    fi

    # 2. Eski sürümden kalan root sahipli ~/.local/share/ArkSigner dizin izinlerini düzelt
    for home in /home/*; do
        if [ -d "$home/.local/share/ArkSigner" ]; then
            owner=$(stat -c '%U:%G' "$home")
            chown -R "$owner" "$home/.local/share/ArkSigner"
        fi
    done

    # 3. Firefox otomatik uzantı politikasını kaydet
    if [ -x /usr/lib/arksigner/firefox-policy.py ]; then
        /usr/bin/python3 /usr/lib/arksigner/firefox-policy.py install || true
    fi

    # 4. Akıllı kart soketini başlat
    systemctl daemon-reload
    systemctl enable --now pcscd.socket || true

    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║           ArkSigner 3.0.12 Kurulumu Tamamlandı!          ║"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║ Yeni sürümde servis kullanıcı oturumuyla başlamaktadır.  ║"
    echo "║ Oturumu kapatıp açabilir veya menüden 'ArkSigner Yönetim'║"
    echo "║ uygulamasını başlatabilirsiniz.                          ║"
    echo "╚══════════════════════════════════════════════════════════╝"
}

post_upgrade() {
    # 2.3.x sürümlerinden kalan sistem servisini durdur ve devre dışı bırak
    for svc in arksigner.service arksignerd.service; do
        if systemctl is-enabled "$svc" >/dev/null 2>&1 || systemctl is-active "$svc" >/dev/null 2>&1; then
            systemctl disable --now "$svc" 2>/dev/null || true
        fi
    done

    # 2.3.x sürümünden kalan eski root sertifikasını temizle (3.0.12 kendi yönetiyor)
    if [ -f /etc/ca-certificates/trust-source/anchors/arksigner.crt ]; then
        rm -f /etc/ca-certificates/trust-source/anchors/arksigner.crt
        trust extract-compat || true
    fi

    post_install
}

pre_remove() {
    # Çalışan ArkSigner kullanıcı süreçlerini durdur
    if [ -x /usr/lib/arksigner/stop-runtime.py ]; then
        /usr/bin/python3 /usr/lib/arksigner/stop-runtime.py || true
    fi

    # Firefox uzantı politikasını kaldır
    if [ -x /usr/lib/arksigner/firefox-policy.py ]; then
        /usr/bin/python3 /usr/lib/arksigner/firefox-policy.py remove || true
    fi

    # hosts temizle
    sed -i '/local.pwsigner.ark-teknoloji.com/d' /etc/hosts 2>/dev/null || true
}
