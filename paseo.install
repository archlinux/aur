post_install() {
    cat <<'EOF'
==> Optional: run the Paseo daemon persistently (desktop app and CLI
    will connect to it instead of spawning their own):
        systemctl --user enable --now paseo.service
    To keep it running while logged out:
        sudo loginctl enable-linger $USER
==> Note: this source build skips the prebuilt sherpa-onnx/onnxruntime
    speech binaries (same as upstream's nix package); local voice
    features degrade gracefully when unavailable.
EOF
}
