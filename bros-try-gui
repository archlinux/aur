    def check_qemu(self):
        try:
            result = subprocess.run(
                ['qemu-system-x86_64', '--version'],
                capture_output=True,
                text=True,
                timeout=5
            )
            if result.returncode == 0:
                return True, result.stdout.strip().split('\n')[0]
        except (subprocess.TimeoutExpired, FileNotFoundError):
            pass
        return False, None
        
    def get_iso_path(self, version):
        return self.iso_dir / f"bros-{version}.iso"
        
    def check_iso_exists(self, version):
        iso_path = self.get_iso_path(version)
        return iso_path.exists()
        
    def download_iso_thread(self, version):
        iso_path = self.get_iso_path(version)
        url = f"https://bros.berkeai.com/iso/bros-{version}.iso"
        
        def reporthook(block_num, block_size, total_size):
            if total_size > 0:
                percent = min(100, int((block_num * block_size * 100) / total_size))
                self.root.after(0, lambda: self.update_status(
                    f"İndiriliyor: %{percent}", COLORS['warning']
                ))
        
        try:
            urllib.request.urlretrieve(url, iso_path, reporthook)
            self.root.after(0, lambda: self.update_status(
                f"İndirme tamamlandı: {iso_path.name}", COLORS['success']
            ))
            self.root.after(0, lambda: self.start_btn.configure(state=tk.NORMAL))
        except Exception as e:
            self.root.after(0, lambda: self.update_status(
                f"Hata: {str(e)}", COLORS['error']
            ))
            self.root.after(0, lambda: self.start_btn.configure(state=tk.NORMAL))
        
        self.root.after(0, lambda: self.progress_bar.stop())
        
    def download_iso(self):
        version = self.selected_version.get()
        
        if self.check_iso_exists(version):
            messagebox.showinfo(
                "Mevcut",
                f"v{version} ISO zaten mevcut!"
            )
            return
            
        qemu_ok, qemu_ver = self.check_qemu()
        if not qemu_ok:
            messagebox.showerror(
                "QEMU Bulunamadı",
                "QEMU kurulu değil. Lütfen önce QEMU'yu kurun:\n\n"
                "Arch Linux: sudo pacman -S qemu\n"
                "Ubuntu: sudo apt install qemu-system-x86\n"
                "macOS: brew install qemu\n"
                "Windows: choco install qemu"
            )
            return
            
        self.start_btn.configure(state=tk.DISABLED)
        self.progress_bar.pack(side=tk.RIGHT, padx=(10, 0))
        self.progress_bar.start(10)
        self.update_status(f"İndiriliyor: v{version}...", COLORS['warning'])
        
        thread = threading.Thread(target=self.download_iso_thread, args=(version,))
        thread.daemon = True
        thread.start()
        
    def start_vm(self):
        version = self.selected_version.get()
        iso_path = self.get_iso_path(version)
        
        qemu_ok, qemu_ver = self.check_qemu()
        if not qemu_ok:
            messagebox.showerror(
                "QEMU Bulunamadı",
                "QEMU kurulu değil. Lütfen önce QEMU'yu kurun."
            )
            return
            
        if not self.check_iso_exists(version):
            response = messagebox.askyesno(
                "ISO Yok",
                f"v{version} ISO'su bulunmuyor. İndirmek ister misiniz?"
            )
            if response:
                self.download_iso()
            return
            
        self.update_status(f"Başlatılıyor: v{version}...", COLORS['pink'])
        
        ram = self.ram_var.get()
        cpu = self.cpu_var.get()
        display = self.display_var.get().lower()
        
        cmd = [
            'qemu-system-x86_64',
            '-m', ram,
            '-smp', str(cpu),
            '-cdrom', str(iso_path),
            '-boot', 'd',
            '-display', display,
            '-machine', 'pc,accel=kvm'
        ]
        
        if self.network_var.get():
            cmd.extend(['-net', 'nic,model=rtl8139'])
            cmd.extend(['-net', 'user,hostfwd=tcp::2222-:22'])
        else:
            cmd.extend(['-net', 'none'])
        
        try:
            subprocess.Popen(cmd)
            self.update_status(f"Çalışıyor: v{version}", COLORS['success'])
            messagebox.showinfo(
                "Bros OS Başlatıldı",
                f"Bros v{version} sanal makinesi başlatıldı!\n\n"
                f"KVM hızlandırma: Aktif\n"
                f"RAM: {ram}, CPU: {cpu}\n\n"
                "Not: QEMU penceresini kapatarak VM'i durdurabilirsiniz."
            )
        except Exception as e:
            messagebox.showerror("Hata", f"VM başlatılamadı: {str(e)}")
            self.update_status("Hata oluştu", COLORS['error'])

