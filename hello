#!/usr/bin/env python3
import sys
import time

def slow_print(text, delay=0.05):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    print()  # new line at the end

if __name__ == "__main__":
    message = "Hello, world"
    slow_print(message, delay=0.07)

