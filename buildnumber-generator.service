[Unit]

Description=Buildnumber Generator Server
Wants=network-online.target
After=network.target network-online.target

[Service]

ExecStart=/usr/bin/buildnumber-generator-server /etc/buildnumber-generator.toml
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
Type=simple
user=buildnumber-generator-server

[Install]

WantedBy=default.target
