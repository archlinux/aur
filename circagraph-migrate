#!/bin/sh
# Copyright (c) 2026 Athan Clark. SPDX-License-Identifier: GPL-3.0-only
# Brings the Circagraph database up to this package's schema, then (re)starts the server,
# and the mail worker and the log importers (syslog, GitHub, journald), each if it is enabled
# (an upgrade stopped them all, #371, #374). Safe to run more than once.
# Usage: sudo circagraph-migrate [--no-restart]   (--no-restart restarts nothing)
set -eu
APP=/usr/lib/circagraph
CONFIG=/etc/circagraph/circagraph.env
if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root: sudo circagraph-migrate" >&2
  exit 1
fi
if [ ! -r "$CONFIG" ]; then
  echo "$CONFIG is missing; reinstall circagraph-server or restore it from a backup." >&2
  exit 1
fi
# As the server's user, the configuration's group: circagraph, or openchronology for an
# installation from before the rename. Node reads the same KEY=value file the services use, as systemd does (OCH_CONFIG: a # inside
# a value is part of it, where node --env-file would cut the value there).
runuser -u "$(stat -c %G "$CONFIG")" -- env OCH_CONFIG="$CONFIG" "$APP/node/bin/node" "$APP/server/migrate.mjs"
if [ "${1:-}" != "--no-restart" ] && [ -d /run/systemd/system ]; then
  systemctl enable --quiet circagraph.service
  systemctl restart circagraph.service
  echo "Circagraph restarted."
  # Disabled until configured (README); an enabled one runs the new version too.
  for worker in "mail:mail worker" "syslog:syslog receiver" "github:GitHub receiver" \
    "journald:journald follower"; do
    if systemctl is-enabled --quiet "circagraph-${worker%%:*}.service" 2>/dev/null; then
      systemctl restart "circagraph-${worker%%:*}.service"
      echo "Circagraph ${worker#*:} restarted."
    fi
  done
fi
