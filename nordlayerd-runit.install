#!/bin/sh

post_install() {
  echo "To activate the service so that is starts automatically on boot, symlink it with:"
  echo "  ln -s /etc/runit/sv/nordlayerd /run/runit/service"
  echo "Or to start it manually once now:"
  echo "  sudo sv start nordlayerd"
}

post_remove() {
  rm -f /run/runit/service/nordlayerd
  rm -fr /etc/runit/sv/nordlayerd
}

