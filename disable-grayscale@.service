[Unit]
Description=Disable KWin Grayscale Effect
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/sh -c 'if command -v qdbus >/dev/null 2>&1; then \
  qdbus org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect kwin6_effect_grayscale; \
else \
  qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect kwin6_effect_grayscale; \
fi'