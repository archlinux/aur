# Pacman runs these as root. It must not touch a user's systemd session or
# home directory: per-user state belongs to the user, so the scriptlets only
# print what to run.
post_install() {
  cat <<'EOF'
WeType installed. Enable the per-user service and restart Fcitx5:

  systemctl --user daemon-reload
  systemctl --user enable --now wetype-daemon
  fcitx5 -r -d   # then add 微信输入法 to its input methods
EOF
}

post_upgrade() {
  cat <<'EOF'
WeType updated. The running daemon and Fcitx5 still use the old build;
restart both to load the new one:

  systemctl --user restart wetype-daemon
  fcitx5 -r -d
EOF
}

post_remove() {
  cat <<'EOF'
WeType removed. Per-user state is kept on purpose:

  systemctl --user disable --now wetype-daemon   # if you enabled the service
  systemctl --user daemon-reload
  rm -rf ~/.local/state/wetype
  rm -f ~/.config/fcitx5/conf/wetype.conf
  fcitx5 -r -d
EOF
}
