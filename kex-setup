#! /bin/bash

echo ":: The emulator is being configured, please wait..."
mkdir -p ~/.kex/root/RD/1/
cd ~/.kex
curl -L -o char.mt "https://git.kolibrios.org/KolibriOS/kolibrios/raw/branch/main/kernel/trunk/gui/char.mt"
curl -L -o charUni.mt "https://git.kolibrios.org/KolibriOS/kolibrios/raw/branch/main/kernel/trunk/gui/charUni.mt"
cd ~/.kex/root/RD/1/
curl -O http://builds.kolibrios.org/en_US/latest-img.7z
7z e -y latest-img.7z  >> /dev/null 2>&1
7z x -y kolibri.img  >> /dev/null 2>&1
rm -f latest-img.7z kolibri.img >> /dev/null 2>&1
echo ":: Done!"

