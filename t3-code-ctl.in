#!/usr/bin/env bash
# @PKGNAME@-ctl — helper CLI for T3 Code Docker instance @PKGNAME@
#
# All docker calls go through `sg docker -c ...` so the tool works even
# when the invoking shell/systemd manager doesn't have `docker` in its
# supplementary groups (e.g. right after `usermod -aG docker` without
# a re-login). sg reads /etc/group at exec time.
set -euo pipefail

readonly PKGNAME='@PKGNAME@'
readonly T3_PORT='@T3_PORT@'
readonly IMAGE_TAG='@IMAGE_TAG@'
readonly CONTAINER="${PKGNAME}"

_docker() {
  local cmdline
  cmdline=$(printf ' %q' docker "$@")
  sg docker -c "${cmdline# }"
}

# LAN IP for mobile pairing. Uses the source addr of the default-route
# lookup; empty string on failure.
_lan_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | \
    awk '{for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}'
}

usage() {
  cat <<USAGE
Usage: ${PKGNAME}-ctl <command>

Commands:
  pair              Issue a fresh one-time pairing token and print BOTH
                    the desktop URL (127.0.0.1) and the LAN URL (for
                    mobile devices on the same network).
  logs [-f]         Show container logs (add -f to follow).
  status            Show container state + HTTP reachability.
  exec <cmd> ...    Run an arbitrary command inside the container.
  restart           Restart the systemd --user service.

Examples:
  ${PKGNAME}-ctl pair              # get pairing URLs for desktop + mobile
  ${PKGNAME}-ctl logs -f           # tail the T3 server logs
  ${PKGNAME}-ctl exec t3 auth session list
USAGE
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker not installed" >&2
    exit 1
  fi
}

require_running() {
  if ! _docker inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null | grep -q true; then
    echo "error: container '${CONTAINER}' is not running." >&2
    echo "hint:  systemctl --user start ${PKGNAME}.service" >&2
    exit 1
  fi
}

cmd_pair() {
  require_docker
  require_running
  local out token expires lan
  out=$(_docker exec "${CONTAINER}" t3 auth pairing create 2>&1)
  token=$(printf '%s\n' "${out}" | awk '/^Token:/ {print $2; exit}')
  expires=$(printf '%s\n' "${out}" | awk -F': ' '/^Expires at:/ {print $2; exit}')
  if [[ -z "${token}" ]]; then
    echo "error: failed to parse token from t3 output:" >&2
    printf '%s\n' "${out}" >&2
    exit 1
  fi
  lan=$(_lan_ip)

  printf '\n'
  printf '  Token:    %s\n' "${token}"
  printf '  Expires:  %s\n' "${expires:-unknown}"
  printf '\n'
  printf '  Desktop:  http://127.0.0.1:%s/pair#token=%s\n' "${T3_PORT}" "${token}"
  if [[ -n "${lan}" ]]; then
    printf '  Mobile:   http://%s:%s/pair#token=%s\n' "${lan}" "${T3_PORT}" "${token}"
  else
    printf '  Mobile:   (LAN IP could not be detected)\n'
  fi
  printf '\n'
  printf '  Open ONE of the URLs above to complete pairing (one-time).\n'
  printf '  The mobile URL requires this device and your phone to be on\n'
  printf '  the same LAN, and the LAN firewall to allow port %s.\n' "${T3_PORT}"
  printf '\n'
}

cmd_logs() {
  require_docker
  require_running
  _docker logs "$@" "${CONTAINER}"
}

cmd_status() {
  require_docker
  local state lan
  state=$(_docker inspect -f '{{.State.Status}}' "${CONTAINER}" 2>/dev/null || echo 'not-created')
  lan=$(_lan_ip)
  printf 'Container: %s\n' "${CONTAINER}"
  printf 'State:     %s\n' "${state}"
  printf 'Port:      %s\n' "${T3_PORT}"
  printf 'Image:     %s\n' "${IMAGE_TAG}"
  if [[ "${state}" == 'running' ]]; then
    local code
    code=$(curl -sS -o /dev/null -w '%{http_code}' "http://127.0.0.1:${T3_PORT}/" 2>/dev/null || echo 'unreachable')
    printf 'Desktop:   HTTP %s at http://127.0.0.1:%s/\n' "${code}" "${T3_PORT}"
    if [[ -n "${lan}" ]]; then
      printf 'Mobile:    http://%s:%s/ (LAN reachable if firewall allows)\n' "${lan}" "${T3_PORT}"
    fi
  fi
}

cmd_exec() {
  require_docker
  require_running
  _docker exec -it "${CONTAINER}" "$@"
}

cmd_restart() {
  systemctl --user restart "${PKGNAME}.service"
  echo "restarted ${PKGNAME}.service"
}

main() {
  if [[ $# -eq 0 ]]; then
    usage
    exit 1
  fi
  local cmd="$1"; shift
  case "${cmd}" in
    pair)    cmd_pair    "$@" ;;
    logs)    cmd_logs    "$@" ;;
    status)  cmd_status  "$@" ;;
    exec)    cmd_exec    "$@" ;;
    restart) cmd_restart "$@" ;;
    -h|--help|help) usage ;;
    *) echo "error: unknown command '${cmd}'" >&2; usage; exit 1 ;;
  esac
}

main "$@"
