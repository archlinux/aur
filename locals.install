post_install() {
  cat <<MSG
==> locals is an unpacked extension. Chromium writes into an unpacked extension's folder,
    so it cannot be loaded from the read-only /usr/share/locals. Make a user copy first:
      1. run:  locals-install        (prints the folder, ~/.local/share/locals)
      2. open chrome://extensions (or brave://extensions) and turn on "Developer mode"
      3. "Load unpacked" and pick that folder
    After a package upgrade run  locals-install  again and press reload on the extension card.
MSG
}

post_upgrade() {
  echo "==> locals updated: run  locals-install  and reload the extension on chrome://extensions."
}
