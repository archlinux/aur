post_install() {
  echo -n "Generating server key for aivpn..."
  if [ ! -f /etc/aivpn/server.key ]; then
    openssl rand -hex 32 > /etc/aivpn/server.key && chmod 640 /etc/aivpn/server.key && chown aivpn:aivpn /etc/aivpn/server.key && echo "Done" || echo "Error!"
  else
    echo "File already exists!"
  fi
  echo "
Before starting aivpn.service, review /etc/aivpn/server.json, then add a client:
# aivpn-server --add-client <name>
"
}
