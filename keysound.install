post_install() {
    echo -e "\n\e[1;32m===================================================================\e[0m"
    echo -e "\e[1;37mKeysound successfully installed!\e[0m"
    echo -e "\e[1;33mIMPORTANT POST-INSTALLATION STEPS:\e[0m"
    echo -e "\n1. Grant your user permission to read the keyboard:"
    echo -e "   \e[1;36msudo usermod -aG input \$USER\e[0m"
    echo -e "\n2. Enable the background daemon (starts automatically on login):"
    echo -e "   \e[1;36msystemctl --user enable keysound.service\e[0m"
    echo -e "\n\e[1;31m3. LOG OUT AND LOG BACK IN (or reboot)\e[0m for permissions to apply."
    echo -e "\nOnce logged back in, run \e[1;36mkeysound-ctl\e[0m to pick your soundpack!"
    echo -e "\e[1;32m===================================================================\e[0m\n"
}

post_upgrade() {
    post_install
}
