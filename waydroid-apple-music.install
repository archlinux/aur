# Waydroid generates waydroid_base.prop during `waydroid init`, which runs after
# this package is installed, so pacman can neither own that file nor patch it at
# build time. Appending here is the only place it can happen.

_props() {
    local prop=/var/lib/waydroid/waydroid_base.prop
    if [ ! -f "$prop" ]; then
        # Local and quick - init only downloads images if none are staged.
        echo ":: waydroid is not initialised; running waydroid init"
        # Bounded: init can download images, and nothing in an install hook
        # may hang a pacman transaction.
        timeout 300 waydroid init >/dev/null 2>&1
    fi
    if [ ! -f "$prop" ]; then
        echo ":: waydroid init did not complete. Run 'sudo waydroid init',"
        echo "   then reinstall this package to apply the properties."
        return 0
    fi

    # Idempotent: drop any previous copies before appending.
    sed -i '/^ro\.adb\.secure=/d;/^ro\.debuggable=/d;/^ro\.build\.selinux=/d
            /^ro\.build\.tags=/d;/^ro\.product\.build\.tags=/d
            /^ro\.vendor\.build\.tags=/d;/^ro\.odm\.build\.tags=/d
            /^persist\.waydroid\.fake_wifi=/d' "$prop"

    # The first seven make Apple Music stop refusing to run on what it reads as
    # a rooted device. fake_wifi is a stock Waydroid property: the container's
    # bridged network presents as Ethernet, and Apple only serves Lossless over
    # Wi-Fi.
    cat >> "$prop" <<'PROPS'
ro.adb.secure=1
ro.debuggable=0
ro.build.selinux=1
ro.build.tags=release-keys
ro.product.build.tags=release-keys
ro.vendor.build.tags=release-keys
ro.odm.build.tags=release-keys
persist.waydroid.fake_wifi=com.apple.android.music
PROPS
    echo ":: applied 8 container properties"
}

# The overlay files and the properties are only read when the container starts,
# so a restart is needed for any of this to take effect.
#
# Everything here is bounded. Waydroid's CLI blocks while a session is coming
# up, and nothing in an install hook may hang a pacman transaction.
_restart() {
    systemctl is-active --quiet waydroid-container.service || return 0

    local u uid
    u="${SUDO_USER:-$(logname 2>/dev/null)}"
    if [ -n "$u" ] && [ "$u" != "root" ]; then
        uid=$(id -u "$u" 2>/dev/null)
        # The session belongs to the desktop user, not root.
        timeout 20 sudo -u "$u" XDG_RUNTIME_DIR="/run/user/$uid" \
            waydroid session stop >/dev/null 2>&1
    fi

    echo ":: restarting the container"
    # try-restart, not restart: if the container was not running, leave it that way.
    timeout 60 systemctl try-restart waydroid-container.service >/dev/null 2>&1 \
        || echo ":: could not restart it - run 'sudo systemctl restart waydroid-container'"
}

# PipeWire reads /etc/pipewire/pipewire.conf.d/ only at startup, so the rate
# config this package installs does nothing until it is reloaded. Without this
# the HAL emits hi-res and PipeWire still resamples it to a single rate.
_reload_pipewire() {
    local u uid
    u="${SUDO_USER:-$(logname 2>/dev/null)}"
    [ -n "$u" ] && [ "$u" != "root" ] || return 0
    uid=$(id -u "$u" 2>/dev/null) || return 0
    [ -d "/run/user/$uid" ] || return 0

    echo ":: reloading pipewire"
    timeout 30 sudo -u "$u" XDG_RUNTIME_DIR="/run/user/$uid" \
        systemctl --user restart pipewire pipewire-pulse wireplumber >/dev/null 2>&1 \
        || echo ":: could not reload it - run 'systemctl --user restart pipewire pipewire-pulse wireplumber'"
}

post_install() {
    _props
    _restart
    _reload_pipewire
    cat <<'EOM'

==> Installed. The container properties are applied, and the container and
    pipewire have been reloaded, so the patched HAL and the rate config are
    live. If the container was not running, start it when you want it:

      sudo systemctl start waydroid-container

    Then install Apple Music, sign in, and set:

      Settings > Audio Quality > Lossless           on
      Settings > Audio Quality > Hi-Res Lossless    on
      Settings > Audio Quality > Sound Check        off
      Settings > Motion        > Animated Art       off

    Sound Check applies gain to level tracks, so it modifies samples and
    defeats bit-perfect output no matter what the rest of the chain does.

    Animated artwork has been reported to crash Waydroid's audio on AMD
    GPUs.

    Note: adb will report the device as "offline" - ro.adb.secure=1 is
    required to stop Apple Music's root detection. Use `waydroid shell`
    instead.

EOM
}

post_upgrade() {
    _props
    _restart
    _reload_pipewire
}

post_remove() {
    echo ":: The container properties were left in /var/lib/waydroid/waydroid_base.prop."
    echo "   Remove the ro.*.build.tags / ro.adb.secure / fake_wifi lines to revert."
}
