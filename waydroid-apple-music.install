# The only thing here that cannot be a packaged file is the property block.
# waydroid_base.prop is generated by `waydroid init`, which runs after this
# package is installed, so pacman can neither own it nor patch it at build time.
# Everything else (images, the app itself, the helper) ships in package().

_setup() {
    # Local, no network - the images are already on disk. Without -f this
    # declines when Waydroid is already set up, so judge by the result rather
    # than guarding the call.
    waydroid init >/dev/null 2>&1

    if [ ! -f /var/lib/waydroid/waydroid_base.prop ]; then
        echo ":: waydroid is not initialised yet."
        echo "   Run: sudo waydroid init && sudo waydroid-am setup"
        return 0
    fi

    echo ":: applying Apple Music properties"
    waydroid-am setup >/dev/null 2>&1 \
        || echo ":: could not apply properties - run 'sudo waydroid-am setup'"
}

post_install() {
    _setup
    cat <<'EOM'

==> waydroid-apple-music is ready.

    Apple Music is already inside the container image. Start Waydroid and
    Android installs it on first boot:

        sudo systemctl start waydroid-container

    It then appears in your application menu like any other app.
    Sign in, then turn on Settings > Audio Quality > Lossless.

        waydroid-am status    show current state
        waydroid-am stop      shut the container down

    Scope: Lossless (16/44.1 - 24/48) works. Hi-Res Lossless
    (24/88.2 - 24/192) also needs a patched audio HAL, since upstream
    Waydroid hardcodes S16_LE/48000 and rejects PCM_FLOAT.

EOM
}

# Deliberately does NOT re-run _setup. The properties are applied once, at
# first install; re-applying them on every version bump would stomp on any
# local edits. If waydroid init -f is ever run, the properties go with it -
# put them back with `sudo waydroid-am setup`.
post_upgrade() {
    echo ":: restart the container to pick up the new version"
    echo "   (if you have since run 'waydroid init -f', re-run 'sudo waydroid-am setup')"
}

pre_remove() {
    waydroid session stop >/dev/null 2>&1 || true
    systemctl stop waydroid-container.service >/dev/null 2>&1 || true
}

post_remove() {
    echo ":: Properties were left in /var/lib/waydroid/waydroid_base.prop."
    echo "   To clear all container state: sudo rm -rf /var/lib/waydroid ~/.local/share/waydroid"
}
