# Movim Configuration
# -------------------
#
# The external URL users will use to connect to your
# movim instance
MOVIM_URL=https://movim.domain.tld/

# The port in which the daemon should listen on
MOVIM_PORT=8080

# The interface in which the daemon should listen on
# By default, it is set to localhost (127.0.0.1)
# To allow connections on all interfaces set it to 0.0.0.0
MOVIM_INTERFACE=127.0.0.1
