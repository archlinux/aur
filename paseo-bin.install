post_install() {
    cat <<'EOF'
==> The Paseo desktop app manages its own daemon (with your full shell env
    and DISPLAY), so no setup is needed — just launch Paseo.
    To run the daemon on graphical login without the app, add an XDG
    autostart entry (~/.config/autostart) that runs:
        /opt/Paseo/resources/bin/paseo daemon start --foreground
EOF
}

post_upgrade() {
    if [ -e "${HOME:-/root}/.config/systemd/user/default.target.wants/paseo.service" ]; then
        cat <<'EOF'
==> This version no longer ships a systemd user service. If you previously ran
    `systemctl --user enable paseo.service`, clean up the stale symlink:
        systemctl --user disable paseo.service
EOF
    fi
}
