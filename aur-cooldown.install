post_install() {
	cat <<'MSG'
==> aur-cooldown is installed. To enable it for your user, run:

      aur-cooldown setup

    This adds the 7-day cooldown hook to ~/.config/yay/init.lua and a ledger
    reminder to your shell rc. Preview first with:  aur-cooldown setup --print

    Then:  aur-cooldown observe   (repeat every few days; a shell reminder helps)
           aur-cooldown upgrade   (installs versions that have aged past 7 days)
MSG
}

post_upgrade() {
	post_install
}
