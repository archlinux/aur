+			{Role: "system", Content: goAstSystemPrompt()},
+			{Role: "user", Content: "Inspect the Go file at " + serverFile},
+		},
+		Tools:       goAstTools(),
+		Temperature: 0.1,
+		MaxTokens:   256,
+	})
+
+	tc := requireToolCall(t, resp)
+	if tc.Function.Name != "go_inspect" {
