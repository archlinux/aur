+			foundServer = true
+		}
+	}
+	if !foundServer {
+		t.Error("Server type not found in inspect result")
+	}
+	t.Logf("Inspect OK: package=%s, %d types, %d functions", r.Package, len(r.Types), len(r.Functions))
+}
