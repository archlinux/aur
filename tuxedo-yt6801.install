post_install() {
    # We use a wildcard here or the injected version to find the directory
    # Adjust path if you use versioned directories: /usr/src/tuxedo-yt6801-${1}
    local src_dir="/usr/src/tuxedo-yt6801"
    local board_name=""
    local target="Kbuild_default"

    if [ -f "/sys/class/dmi/id/board_name" ]; then
        board_name="$(cat /sys/class/dmi/id/board_name)"
    fi

    # Logic from base_package.yml
    if [ "GXxHRXx" = "$board_name" ] || [ "GM5IXxA" = "$board_name" ]; then
        target="Kbuild_no_aspm"
        echo ":: Board '$board_name' detected. Disabling ASPM."
    else
        echo ":: Using default configuration (ASPM enabled)."
    fi

    # Create the symlink that DKMS will actually use
    ln -sf "${src_dir}/${target}" "${src_dir}/Kbuild"
}

post_upgrade() {
    post_install "$1"
}

pre_remove() {
    local src_dir="/usr/src/tuxedo-yt6801"
    rm -f "${src_dir}/Kbuild"
}
