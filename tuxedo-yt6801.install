post_install() {
    local board_name="Unknown"
    if [ -f "/sys/class/dmi/id/board_name" ]; then
        board_name="$(cat /sys/class/dmi/id/board_name)"
    fi

    echo ""
    if [ "GXxHRXx" = "$board_name" ] || [ "GM5IXxA" = "$board_name" ]; then
        echo ":: Motorcomm YT6801: Known problematic board '$board_name' detected."
        echo ":: DKMS will build the module with ASPM disabled for stability."
    else
        echo ":: Motorcomm YT6801: Board '$board_name' detected."
        echo ":: DKMS will build the module with default settings (ASPM enabled)."
    fi
    echo ""
}

post_upgrade() {
    post_install
}
