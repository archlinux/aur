From e4829021b7eaf34b503b7d2d4973f7b6efcc5da4 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Sun, 12 Jul 2026 10:03:52 +0800
Subject: [PATCH 3/7] cmake: Use system nlohmann-json

---
 CMakeLists.txt           |  1 +
 deps.json                | 10 ----------
 src/Core/CMakeLists.txt  |  2 +-
 src/Scene/CMakeLists.txt |  6 +++---
 src/Web/CMakeLists.txt   |  4 ++--
 5 files changed, 7 insertions(+), 16 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 123cbc3..9613b1a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -36,6 +36,7 @@ endif()
 find_package(PkgConfig REQUIRED)
 find_package(Threads REQUIRED)
 find_package(Eigen3 3.4.0 REQUIRED)
+find_package(nlohmann_json 3.12.0 REQUIRED)
 
 if(CMAKE_USE_PTHREADS_INIT)
     # Clang records pthread support in C++ module BMIs; keep all module targets compatible.
diff --git a/deps.json b/deps.json
index 4254dc4..bb7230a 100644
--- a/deps.json
+++ b/deps.json
@@ -1,14 +1,4 @@
 [
-  {
-    "dest": "build/_flatpak_deps/nlohmann_json-src",
-    "type": "archive",
-    "url": "https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz",
-    "sha256": "4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187",
-    "x-cmake": {
-      "name": "nlohmann_json",
-      "exclude_from_all": true
-    }
-  },
   {
     "dest": "build/_flatpak_deps/spirv_reflect-src",
     "type": "archive",
diff --git a/src/Core/CMakeLists.txt b/src/Core/CMakeLists.txt
index c617f88..9afc2dc 100644
--- a/src/Core/CMakeLists.txt
+++ b/src/Core/CMakeLists.txt
@@ -15,7 +15,7 @@ target_sources(owe-core
          nlohmann_json.cppm
          Json.cppm)
 target_link_libraries(owe-core
-  PUBLIC rstd::rstd rstd.cppstd rstd.log Eigen3::Eigen nlohmann_json)
+  PUBLIC rstd::rstd rstd.cppstd rstd.log Eigen3::Eigen nlohmann_json::nlohmann_json)
 target_compile_features(owe-core PUBLIC cxx_std_20)
 target_compile_options(owe-core PRIVATE -Wno-missing-field-initializers)
 set_property(TARGET owe-core PROPERTY POSITION_INDEPENDENT_CODE ON)
diff --git a/src/Scene/CMakeLists.txt b/src/Scene/CMakeLists.txt
index a1fd7f8..a678514 100644
--- a/src/Scene/CMakeLists.txt
+++ b/src/Scene/CMakeLists.txt
@@ -52,7 +52,7 @@ target_sources(owe-base
          Lighting/Lighting.cppm
          Scene/Scene.cppm)
 target_link_libraries(owe-base
-  PUBLIC rstd::rstd rstd.cppstd Eigen3::Eigen wavsen::audio owe-types nlohmann_json
+  PUBLIC rstd::rstd rstd.cppstd Eigen3::Eigen wavsen::audio owe-types nlohmann_json::nlohmann_json
   PRIVATE ${LZ4_LIBRARIES}
           ${CMAKE_THREAD_LIBS_INIT} ${CMAKE_DL_LIBS})
 target_include_directories(owe-base
@@ -71,7 +71,7 @@ target_sources(owe-script
   PUBLIC FILE_SET cxx_modules TYPE CXX_MODULES FILES Script/Script.cppm)
 target_link_libraries(owe-script
   PUBLIC  owe-base
-  PRIVATE qjs nlohmann_json)
+  PRIVATE qjs nlohmann_json::nlohmann_json)
 target_include_directories(owe-script
   PUBLIC  .. . Utils/include
   PRIVATE Utils Utils/include/Utils Script)
@@ -130,7 +130,7 @@ target_sources(owe-parse
          Text/Text.cppm)
 target_link_libraries(owe-parse
   PUBLIC owe-base owe-shader-compile owe-script
-  PRIVATE nlohmann_json ${LZ4_LIBRARIES} Freetype::Freetype PkgConfig::FONTCONFIG)
+  PRIVATE nlohmann_json::nlohmann_json ${LZ4_LIBRARIES} Freetype::Freetype PkgConfig::FONTCONFIG)
 target_include_directories(owe-parse
   PUBLIC  .. . Utils/include
   PRIVATE Utils Utils/include/Utils Scene Particle)
diff --git a/src/Web/CMakeLists.txt b/src/Web/CMakeLists.txt
index 9a84370..80f9290 100644
--- a/src/Web/CMakeLists.txt
+++ b/src/Web/CMakeLists.txt
@@ -9,7 +9,7 @@ target_sources(owe-web-api
         Manifest.cppm
         BrowserHost.cppm)
 target_include_directories(owe-web-api PUBLIC .)
-target_link_libraries(owe-web-api PUBLIC nlohmann_json rstd.cppstd)
+target_link_libraries(owe-web-api PUBLIC nlohmann_json::nlohmann_json rstd.cppstd)
 target_compile_features(owe-web-api PUBLIC cxx_std_20)
 set_target_properties(owe-web-api PROPERTIES
     POSITION_INDEPENDENT_CODE ON
@@ -34,7 +34,7 @@ target_link_libraries(owe-web-host
     PUBLIC
         owe-web-api
         ${CEF_LIBRARIES}
-        nlohmann_json)
+        nlohmann_json::nlohmann_json)
 target_compile_features(owe-web-host PUBLIC cxx_std_20)
 SET_LIBRARY_TARGET_PROPERTIES(owe-web-host)
 set_target_properties(owe-web-host PROPERTIES
-- 
2.55.0

