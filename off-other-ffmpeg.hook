[Trigger]
Operation=Install
Operation=Upgrade
Type=Package
Target=chromium-ffmpeg-codecs
Target=opera
Target=opera-beta
Target=opera-developer
Target=nwjs
Target=slimjet

[Action]
When=PostTransaction
Exec=/usr/bin/bash -c 'chmod a-r /{usr/lib/{opera{,-beta,-developer},slimjet},opt/nwjs/lib}/libffmpeg.so 2>/dev/null||:'
