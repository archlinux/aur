[Trigger]
Operation=Install
Operation=Upgrade
Type=Package
Target=chromium-ffmpeg-codecs
Target=opera
Target=opera-beta
Target=opera-developer
Target=nwjs
Target=slimjet
Target=electron36
Target=electron35
Target=electron34
Target=electron33
Target=electron32
Target=electron31

[Action]
When=PostTransaction
Exec=/usr/bin/bash -c 'chmod a-r /{usr/lib/{opera{,-beta,-developer},slimjet,electron{36..31}},opt/nwjs/lib}/libffmpeg.so 2>/dev/null||:'
