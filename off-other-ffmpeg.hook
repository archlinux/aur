[Trigger]
Operation=Install
Operation=Upgrade
Type=Package
Target=chromium-ffmpeg-codecs
Target=opera
Target=opera-beta
Target=opera-developer
Target=electron36
Target=electron35
Target=electron34
Target=electron33
Target=electron32
Target=electron31
Target=electron30
Target=electron29
Target=electron28
Target=nwjs
Target=vivaldi

[Action]
When=PostTransaction
Exec=/usr/bin/bash -c 'chmod a-r /{usr/lib/{opera{,-beta,-developer},electron{28..36}},opt/{vivaldi,nwjs}/lib}/libffmpeg.so 2>/dev/null||:'
