[Unit]
Description=Miasma headless server

[Service]
RuntimeDirectory=miasma
ExecStart=/usr/bin/miasma --unix-socket /run/miasma/miasma.sock --link-prefix bots
# Uncomment and change the credentials if you want to have metrics available
# ExecStart=/usr/bin/miasma --unix-socket /run/miasma/miasma.sock --link-prefix bots --metrics-db-path /var/lib/miasma/logs.db --metrics-credentials changeme:changeme
ExecStop=/usr/bin/kill -INT $MAINPID
User=miasma

[Install]
WantedBy=multi-user.target
