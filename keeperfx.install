post_install() {
  cat <<MSG
==> KeeperFX (native Linux) installed.
    You must own the original Dungeon Keeper (GOG/CD). To finish setup, run:
        keeperfx-install
    It copies the 16 required DK files from your copy and creates your playable
    install at ~/.local/share/keeperfx. Then launch with:
        keeperfx          (or from your application menu)
    Docs incl. resolution/borderless options:
        /usr/share/doc/keeperfx/README
MSG
}

post_upgrade() {
  post_install
}
