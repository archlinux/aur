[Unit]
Description=Restarting mpvpaper-stop (%i)
After=graphical-session.target

[Service]
Type=simple

ExecStartPre=/usr/bin/bash -c '\
while [ ! -S "/tmp/mpvsocket%i" ]; do \
    sleep 0.5; \
done'

ExecStart=/usr/bin/mpvpaper-stop -p /tmp/mpvsocket%i

Restart=always
RestartSec=3

[Install]
WantedBy=default.target