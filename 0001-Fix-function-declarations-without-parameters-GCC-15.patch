Date: Sat, 1 Feb 2025 10:16:45 +0000
Subject: [PATCH] Fix function declarations without parameters (GCC 15)

See: https://gcc.gnu.org/gcc-15/porting_to.html#c23-fn-decls-without-parameters
---
 Simulator/input/lex.l           |  2 +-
 Simulator/sched/SCH_fifo.c      |  2 +-
 Simulator/sched/SCH_fifo.h      |  2 +-
 Simulator/sched/SCH_prio_fifo.c |  2 +-
 Simulator/sched/SCH_prio_fifo.h |  2 +-
 Simulator/sched/SCH_rr.c        |  2 +-
 Simulator/sched/SCH_rr.h        |  2 +-
 Simulator/sched/SCH_ss_mpi_cp.c |  2 +-
 Simulator/sched/SCH_ss_mpi_cp.h |  2 +-
 Simulator/sched/sched_vars.c    |  4 ++--
 Simulator/sched/schedule.c      |  2 +-
 include/types.h                 | 20 ++++++++++----------
 12 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/Simulator/input/lex.l b/Simulator/input/lex.l
index 885864c..9c03a28 100644
--- a/Simulator/input/lex.l
+++ b/Simulator/input/lex.l
@@ -53,7 +53,7 @@ extern int line_no;
 extern struct Str *first_str;
 extern YYSTYPE yylval;
 extern YYSTYPE insert_string();
-extern YYSTYPE deci();
+extern YYSTYPE deci(char *);
 extern YYSTYPE rela();
 extern YYSTYPE NUMtype();
 
diff --git a/Simulator/sched/SCH_fifo.c b/Simulator/sched/SCH_fifo.c
index abce23e..63d73ea 100644
--- a/Simulator/sched/SCH_fifo.c
+++ b/Simulator/sched/SCH_fifo.c
@@ -99,7 +99,7 @@ FIFO_clear_parameters (struct t_thread *thread)
 }
 
 int
-FIFO_info (int info)
+FIFO_info (int info, struct t_thread *, struct t_thread *)
 {
   return (0);
 }
diff --git a/Simulator/sched/SCH_fifo.h b/Simulator/sched/SCH_fifo.h
index d8d0107..9d40a39 100644
--- a/Simulator/sched/SCH_fifo.h
+++ b/Simulator/sched/SCH_fifo.h
@@ -43,7 +43,7 @@ extern t_nano FIFO_get_execution_time(struct t_thread *thread);
 extern struct t_thread *FIFO_next_thread_to_run(struct t_node *node);
 extern void FIFO_init_scheduler_parameters(struct t_thread *thread);
 extern void FIFO_clear_parameters(struct t_thread *thread);
-extern int FIFO_info(int info);
+extern int FIFO_info(int info, struct t_thread *, struct t_thread *);
 extern void FIFO_init(char *filename, struct t_machine *machine);
 extern void FIFO_copy_parameters(struct t_thread *th_o, struct t_thread *th_d);
 extern void FIFO_free_parameters (struct t_thread *thread);
diff --git a/Simulator/sched/SCH_prio_fifo.c b/Simulator/sched/SCH_prio_fifo.c
index ddb679c..beb59d3 100644
--- a/Simulator/sched/SCH_prio_fifo.c
+++ b/Simulator/sched/SCH_prio_fifo.c
@@ -168,7 +168,7 @@ PRIO_FIFO_clear_parameters(struct t_thread *thread)
 }
 
 int
-PRIO_FIFO_info(int info)
+PRIO_FIFO_info(int info, struct t_thread *, struct t_thread *)
 {
   return (0);
 }
diff --git a/Simulator/sched/SCH_prio_fifo.h b/Simulator/sched/SCH_prio_fifo.h
index 71eed3f..b066c74 100644
--- a/Simulator/sched/SCH_prio_fifo.h
+++ b/Simulator/sched/SCH_prio_fifo.h
@@ -52,7 +52,7 @@ extern t_nano PRIO_FIFO_get_execution_time(struct t_thread *thread);
 extern struct t_thread *PRIO_FIFO_next_thread_to_run(struct t_node *node);
 extern void PRIO_FIFO_init_scheduler_parameters(struct t_thread *thread);
 extern void PRIO_FIFO_clear_parameters(struct t_thread *thread);
-extern int PRIO_FIFO_info(int info);
+extern int PRIO_FIFO_info(int info, struct t_thread *, struct t_thread *);
 extern void PRIO_FIFO_init(char *filename, struct t_machine *machine);
 extern void PRIO_FIFO_copy_parameters(struct t_thread *th_o,
 				      struct t_thread *th_d);
diff --git a/Simulator/sched/SCH_rr.c b/Simulator/sched/SCH_rr.c
index 231d723..de0ddbe 100644
--- a/Simulator/sched/SCH_rr.c
+++ b/Simulator/sched/SCH_rr.c
@@ -139,7 +139,7 @@ RR_clear_parameters (struct t_thread *thread)
 }
 
 int
-RR_info (int info)
+RR_info (int info, struct t_thread *, struct t_thread *)
 {
   return (0);
 }
diff --git a/Simulator/sched/SCH_rr.h b/Simulator/sched/SCH_rr.h
index 8b214c7..2991ac0 100644
--- a/Simulator/sched/SCH_rr.h
+++ b/Simulator/sched/SCH_rr.h
@@ -48,7 +48,7 @@ extern t_nano RR_get_execution_time(struct t_thread *thread);
 extern struct t_thread *RR_next_thread_to_run(struct t_node *node);
 extern void RR_init_scheduler_parameters(struct t_thread *thread);
 extern void RR_clear_parameters(struct t_thread *thread);
-extern int RR_info(int info);
+extern int RR_info(int info, struct t_thread *, struct t_thread *);
 extern void RR_init(char *filename, struct t_machine *machine);
 extern void RR_copy_parameters(struct t_thread *th_o, struct t_thread *th_d);
