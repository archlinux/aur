post_install() {
    printf '%s\n' \
        '' \
        'Boomaga printer setup (only if the queue is missing):' \
        '    Open Boomaga: Help -> Add Boomaga as virtual printer.' \
        '    Requires running CUPS, sudo access and a supported terminal.' \
        '    Manual setup: /usr/share/doc/boomaga-git/README.install' \
        ''
}

post_upgrade() {
    # Show the setup instructions once when upgrading from older packaging.
    if [ "$(vercmp "$2" '3.9.3.r0.g251dcad-2')" -lt 0 ]; then
        post_install
    fi
}
