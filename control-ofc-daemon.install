post_install() {
    cat <<'EOF'
:: control-ofc-daemon installed.

   Start now:        sudo systemctl enable --now control-ofc-daemon
   Load modules:     sudo systemctl start systemd-modules-load   (or reboot)
   Setup guide:      man control-ofc-daemon
   Hardware check:   open the GUI -> Hardware page

   Fan-control prerequisites — if a motherboard header or GPU fan is
   discovered but never responds, one of these is usually missing:
     * Super I/O driver: motherboard headers need the matching chip driver
                         (e.g. it87-dkms-git / nct6687d-dkms-git — see the
                         package optdepends and 'man control-ofc-daemon').
     * Gigabyte / ASUS:  may need 'acpi_enforce_resources=lax' on the kernel
                         command line for the Super I/O chip to bind.
     * AMD RDNA3+ GPU:   PMFW fan curves need 'amdgpu.ppfeaturemask=0xffffffff'
                         on the kernel command line.
   The GUI's Hardware page (readiness + Super-I/O detection) detects each of
   these and shows the exact driver + fix for your machine.

   Advanced (optional): an OPT-IN active Super-I/O port probe can identify an
   unbound chip whose driver you don't yet know. It is OFF by default and needs
   CAP_SYS_RAWIO (~root-equivalent) — do not enable it unless you need it. See
   /usr/share/doc/control-ofc-daemon/superio-port-probe.conf.example.

   Advanced (optional): read-only NVIDIA telemetry via NVML is OFF by default
   and EXPERIMENTAL (unverified on hardware). To try it, set
   [detection] enable_nvidia_telemetry = true and copy the opt-in drop-in from
   /usr/share/doc/control-ofc-daemon/nvidia-telemetry.conf.example to
   /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf (that
   file lists the exact command). The open nouveau driver needs neither — its
   GPU is read via hwmon automatically.
EOF
}

post_upgrade() {
    echo ":: Restart to apply changes:"
    echo "   sudo systemctl restart control-ofc-daemon"
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf ]]; then
        echo ":: Opt-in Super-I/O port-probe drop-in detected — review it against the"
        echo "   updated example in case the required directives changed:"
        echo "   /usr/share/doc/control-ofc-daemon/superio-port-probe.conf.example"
    fi
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf ]]; then
        echo ":: Opt-in NVIDIA telemetry drop-in detected — review it against the"
        echo "   updated example in case the required directives changed:"
        echo "   /usr/share/doc/control-ofc-daemon/nvidia-telemetry.conf.example"
    fi
}

pre_remove() {
    if systemctl is-active --quiet control-ofc-daemon.service; then
        systemctl stop control-ofc-daemon.service
    fi
    if systemctl is-enabled --quiet control-ofc-daemon.service; then
        systemctl disable control-ofc-daemon.service
    fi
}

post_remove() {
    echo ":: Configuration preserved in /etc/control-ofc/"
    echo "   Remove manually if no longer needed."
    echo ":: State data preserved in /var/lib/control-ofc/"
    echo "   Remove manually if no longer needed."
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf ]]; then
        echo ":: Opt-in Super-I/O port-probe drop-in left in place:"
        echo "   /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf"
        echo "   Remove it manually (it was installed by hand, not by the package)."
    fi
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf ]]; then
        echo ":: Opt-in NVIDIA telemetry drop-in left in place:"
        echo "   /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf"
        echo "   Remove it manually (it was installed by hand, not by the package)."
    fi
}
