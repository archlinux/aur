+
+// appWindowScore returns the best score any of the app's windows gets for the
+// query, computed the same way as the windows provider does.
+func appWindowScore(f *DesktopFile, runes []rune, slab *common.FuzzySlab, exact bool) int32 {
+	var best int32
+
+	for _, v := range wlr.Windows() {
+		if !isAppWindow(f, v) {
+			continue
+		}
+
+		// Same as the windows provider: take the field with the highest raw
+		// score, then subtract its start. Subtracting per field first gives
+		// a different (sometimes higher) result.
+		var raw, start int32
+
+		for _, s := range []string{v.Title, v.AppID} {
+			score, _, st := common.FuzzyScore(runes, s, exact, slab)
+
+			if score > raw {
+				raw, start = score, st
+			}
+		}
+
+		if raw > 0 {
+			best = max(best, max(raw-start, 10))
+		}
+	}
+
+	return best
+}
