#!/bin/bash

winepfxSaved=$WINEPREFIX
pwdSaved=$PWD
progName="vatsim-crc"
savedFiles=$HOME/.$progName

CURRVER=$(LC_ALL=C pacman -Qi vatsim-crc | grep Version | awk '{print $3}')
LATESTVER=$(curl -s https://crc.virtualnas.net/LatestVersion.json | jq -r '.version')

if [[ $CURRVER != "$LATESTVER"* ]]; then
  notify-send --app-name=$progName --icon=$progName "A new version of CRC is available." "A new version of CRC is available, please re-build the PKGBUILD."
  exit 1
fi

mkdir -p $savedFiles

export WINEPREFIX="$HOME/.local/share/wineprefixes/$progName"

if [[ $1 == "clean" ]] ; then
  rm -rf $WINEPREFIX
  shift
fi

mkdir -p $WINEPREFIX

## probe if umu-launcher
hash umu-run
UMU_AVAIL=$?

if [ $UMU_AVAIL -eq 0 ] ; then
  # Proton version
  export GAMEID=vatsim-crc
  if [ ! -f "$WINEPREFIX/.installed.$CURRVER" ] ; then
    rm "$WINEPREFIX/.installed*"

    if [[ ! -v PROTONPATH ]]; then
      if [ -d "/usr/share/steam/compatibilitytools.d/proton-ge-custom" ] ; then
        export PROTONPATH="/usr/share/steam/compatibilitytools.d/proton-ge-custom"
      fi
    fi

    if [[ -v PROTONPATH ]]; then
      declare -p PROTONPATH > "$WINEPREFIX/.installed.$CURRVER"
    fi

    notify-send --app-name=$progName --icon=$progName "Installing Dependencies" "It may take some time."
    echo "PROTONPATH=$PROTONPATH"
    echo "UMU_NO_RUNTIME=$UMU_NO_RUNTIME"
    UMU_NO_RUNTIME=1 umu-run winetricks arial tahoma
    if [[ $1 == "msfonts" ]] ; then
      UMU_NO_RUNTIME=1 umu-run winetricks courier
    else
      UMU_NO_RUNTIME=1 umu-run winetricks /usr/share/vatsim-crc/nicfonts.verb
    fi
    UMU_NO_RUNTIME=1 umu-run winetricks /usr/share/vatsim-crc/segmdl2.verb 
    UMU_NO_RUNTIME=1 umu-run winetricks webview2
    UMU_NO_RUNTIME=1 umu-run reg add "HKCU\\SOFTWARE\\Microsoft\\Avalon.Graphics" /v DisableHWAcceleration /t REG_DWORD /d 1 /f
    ln -svf $savedFiles $WINEPREFIX/drive_c/$progName
    for i in $(ls /usr/share/$progName); do
      ln -svf /usr/share/$progName/$i $WINEPREFIX/drive_c/$progName/
    done
    if [ -f "/opt/rpc-bridge/bridge.exe" ] ; then
      UMU_NO_RUNTIME=1 umu-run "/opt/rpc-bridge/bridge.exe" --install
    fi
    touch "$WINEPREFIX/.installed.$CURRVER"
    UMU_NO_RUNTIME=1 umu-run wineboot -e
  fi

  source "$WINEPREFIX/.installed.$CURRVER" # Load PROTONPATH
  cd $savedFiles && UMU_NO_RUNTIME=1 umu-run "$WINEPREFIX/drive_c/$progName/Application/CRC.exe" "$@"
else
  # Wine version
  if [ ! -f "$WINEPREFIX/.installed.$CURRVER" ] ; then
    rm "$WINEPREFIX/.installed*"
    wine wineboot -ru
    notify-send --app-name=$progName --icon=$progName "Installing Dependencies" "It may take some time."
    winetricks -q arial tahoma
    if [[ $1 == "msfonts" ]] ; then
      winetricks -q courier
    else
      winetricks -q /usr/share/vatsim-crc/nicfonts.verb
    fi
    winetricks -q /usr/share/vatsim-crc/segmdl2.verb /usr/share/vatsim-crc/webview2.verb
    winetricks -q fontsmooth=rgb
    wine reg add "HKCU\\SOFTWARE\\Microsoft\\Avalon.Graphics" /v DisableHWAcceleration /t REG_DWORD /d 1 /f
    ln -svf $savedFiles $WINEPREFIX/drive_c/$progName
    for i in $(ls /usr/share/$progName); do
      ln -svf /usr/share/$progName/$i $WINEPREFIX/drive_c/$progName/
    done
    if [ -f "/opt/rpc-bridge/bridge.exe" ] ; then
      wine "/opt/rpc-bridge/bridge.exe" --install
    fi
    touch "$WINEPREFIX/.installed.$CURRVER"
    wine wineboot -e
  fi

  cd $savedFiles && WINEDEBUG=-all wine "$WINEPREFIX/drive_c/$progName/Application/CRC.exe" "$@"
fi

cd $pwdSaved
