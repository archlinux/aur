@@ -0,0 +1,85 @@
+#pragma once
+
+#include <memory>
+
+#include <private/qwaylandwindow_p.h>
+#include <qcoreevent.h>
+#include <qobject.h>
+#include <qpointer.h>
+#include <qqmlintegration.h>
+#include <qquickwindow.h>
+#include <qtmetamacros.h>
+
+#include "../../window/proxywindow.hpp"
+
+namespace qs::wayland::presentation {
+
+namespace impl {
+struct FeedbackState;
+}
+
+///! Compositor presentation feedback for a window's frames.
+/// Reports whether the compositor showed each frame of a @@Quickshell.QsWindow or
+/// subclass, as an attached object, using the [presentation-time] Wayland protocol.
+///
+/// `frameSwapped` only says a frame was queued. While `enabled` is true, each rendered
+/// frame gets a serial: `submitted(serial)` names the frame before its commit, then at
+/// most one of `presented(serial)` or `discarded(serial)` follows. A frame pending when
+/// the window hides or loses its surface is never reported.
+///
+/// [presentation-time]: https://wayland.app/protocols/presentation-time
+class PresentationFeedback: public QObject {
+	Q_OBJECT;
+	// clang-format off
+	/// Request feedback for every rendered frame while true. Defaults to false.
+	Q_PROPERTY(bool enabled READ enabled WRITE setEnabled NOTIFY enabledChanged);
+	/// True while the compositor offers presentation-time and the window is visible
+	/// with a live surface. A frame rendered while false is never reported.
+	Q_PROPERTY(bool available READ available NOTIFY availableChanged);
+	// clang-format on
+	QML_ELEMENT;
+	QML_UNCREATABLE("PresentationFeedback can only be used as an attached object.");
+	QML_ATTACHED(PresentationFeedback);
+
+public:
+	explicit PresentationFeedback(ProxyWindowBase* window, QObject* parent);
+	~PresentationFeedback() override;
+	Q_DISABLE_COPY_MOVE(PresentationFeedback);
+
+	[[nodiscard]] bool enabled() const;
+	void setEnabled(bool enabled);
+	[[nodiscard]] bool available() const;
+
+	static PresentationFeedback* qmlAttachedProperties(QObject* object);
+
+	bool eventFilter(QObject* object, QEvent* event) override;
+
+signals:
+	void enabledChanged();
+	void availableChanged();
+	/// Frame `serial` asked for feedback; its commit follows. Serials increase for the
+	/// life of the window, across every surface it replaces.
+	void submitted(int serial);
+	/// The compositor showed frame `serial` on an output.
+	void presented(int serial);
+	/// The compositor never showed frame `serial`.
+	void discarded(int serial);
+
+private:
+	void onWindowConnected();
+	void onWindowDestroyed();
+	void onProxyWindowDestroyed();
+	void update();
+	void attachWaylandWindow(QtWaylandClient::QWaylandWindow* window);
+	void detachWindow();
+
+	ProxyWindowBase* proxyWindow;
+	QPointer<QQuickWindow> mWindow;
+	QPointer<QtWaylandClient::QWaylandWindow> mWaylandWindow;
+	QMetaObject::Connection renderConnection;
+	bool mEnabled = false;
+	bool mAvailable = false;
+	std::shared_ptr<impl::FeedbackState> state;
+};
+
+} // namespace qs::wayland::presentation
