+#pragma once
+
+#include <qtmetamacros.h>
+#include <qwayland-presentation-time.h>
+#include <qwaylandclientextension.h>
+
+namespace qs::wayland::presentation::impl {
+
+class PresentationManager
+    : public QWaylandClientExtensionTemplate<PresentationManager>
+    , public QtWayland::wp_presentation {
+	Q_OBJECT;
+
+public:
+	explicit PresentationManager();
+
+	// Null when the compositor does not offer wp_presentation.
+	static PresentationManager* instance();
+};
+
+} // namespace qs::wayland::presentation::impl
diff --git a/src/wayland/presentation/qml.cpp b/src/wayland/presentation/qml.cpp
