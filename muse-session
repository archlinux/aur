def curses_readline(stdscr, y, x, prompt, max_len=60):
    curses.echo()
    curses.curs_set(1)
    stdscr.addstr(y, x, prompt, curses.color_pair(3) | curses.A_BOLD)
    stdscr.clrtoeol()
    stdscr.refresh()
    try:
        val = stdscr.getstr(y, x + len(prompt), max_len).decode("utf-8", errors="ignore").strip()
    except Exception:
        val = ""
    curses.noecho()
    curses.curs_set(0)
    return val

def show_info_modal(stdscr, session):
    h, w = stdscr.getmaxyx()
    box_h = min(16, h - 4)
    box_w = min(82, w - 6)
    start_y = (h - box_h) // 2
    start_x = (w - box_w) // 2

    win = curses.newwin(box_h, box_w, start_y, start_x)
    win.box()
    win.addstr(0, 2, " Session Information ", curses.A_BOLD | curses.color_pair(2))

    info_lines = [
        f"UUID:        {session['uuid']}",
        f"Title:       {session['custom_title'] or '(none)'}",
        f"Workspace:   {session['workspace']}",
        f"Created:     {session['created_at'].strftime('%Y-%m-%d %H:%M:%S')}",
        f"Model ID:    {session['model_id']}",
        f"Total Size:  {format_size(session['size_bytes'])}",
        f"Lock Status: {'ACTIVE (PID ' + str(session['lock_pid']) + ')' if session['is_locked'] else 'Inactive'}",
        f"Events:      {session['events_count']}",
        f"Prompt:      {session['prompt'][:box_w - 18]}",
        f"Disk Path:   {session['path']}"
    ]

    for idx, line in enumerate(info_lines):
        if idx + 2 < box_h - 2:
            win.addstr(idx + 2, 2, line[:box_w - 4])

    win.addstr(box_h - 2, 2, "Press any key to return...", curses.A_DIM)
    win.refresh()
    win.getch()

def show_help_modal(stdscr):
    help_sections = [
        ("=== MUSE-SESSION MANAGER — HELP MANUAL ===", ""),
        ("NAVIGATION", ""),
        ("  ↑ / k           ", "Move selection up one session"),
        ("  ↓ / j           ", "Move selection down one session"),
        ("  PgUp / PgDn     ", "Jump 10 sessions up / down"),
        ("  Home / End      ", "Jump directly to the first / last session"),
        ("", ""),
        ("HOTKEY ACTIONS", ""),
        ("  Enter           ", "Resume highlighted session immediately (muse resume <UUID>)"),
        ("  F2 / r          ", "Rename session (stores custom label in .session.title)"),
        ("  F4 / d / Del    ", "Delete session permanently (prompts for confirmation [y/N])"),
        ("  i               ", "Inspect full metadata, prompt, model, and disk path"),
        ("  w               ", "Toggle workspace filter (All Workspaces vs Current Working Directory)"),
        ("  ? / h / F1      ", "Show this comprehensive help manual"),
        ("  q / Esc         ", "Exit interactive session picker and return to shell"),
        ("", ""),
        ("STORAGE ARCHITECTURE", ""),
        ("  Directory       ", "~/.local/share/muse/sessions/<YYYY>/<MM>/<DD>/<UUID>/"),
        ("  session.jsonl   ", "JSON Lines log of all prompts, reasoning, tool calls, and outputs"),
        ("  .session.title  ", "Local title override file created when renaming"),
        ("  .session.lock   ", "Active lock file containing the PID of running agent processes"),
        ("  .msp-view-v1/   ", "Cache directory used by Muse TUI for fast index loading"),
        ("", ""),
        ("DELETION & SAFETY BEHAVIOR", ""),
        ("  • Interactive   ", "Requires explicit 'y' confirmation before removing files"),
        ("  • Active Lock   ", "Warns if a session is currently running; requires force (-f) to delete"),
        ("  • Clean Purge   ", "Deletes session directory, .msp-view-v1 cache, and empty parent date dirs")
    ]

    scroll_y = 0

    while True:
        h, w = stdscr.getmaxyx()
        box_h = min(len(help_sections) + 4, h - 2)
        box_w = min(96, w - 4)
        start_y = max(0, (h - box_h) // 2)
        start_x = max(0, (w - box_w) // 2)

        win = curses.newwin(box_h, box_w, start_y, start_x)
        win.box()
        win.addstr(0, 2, " Help & Keyboard Reference ", curses.A_BOLD | curses.color_pair(2))

        visible_height = box_h - 3
        max_scroll = max(0, len(help_sections) - visible_height)
        scroll_y = max(0, min(scroll_y, max_scroll))

        for i in range(visible_height):
            idx = scroll_y + i
            if idx >= len(help_sections):
                break
            key_part, desc_part = help_sections[idx]
            y_pos = 1 + i

            if key_part.startswith("==="):
                win.addstr(y_pos, 2, key_part[:box_w - 4], curses.A_BOLD | curses.color_pair(1))
            elif key_part and not desc_part:
                win.addstr(y_pos, 2, key_part[:box_w - 4], curses.A_BOLD | curses.color_pair(3))
            elif key_part:
                win.addstr(y_pos, 2, key_part[:box_w - 4], curses.A_BOLD | curses.color_pair(2))
                win.addstr(y_pos, 20, desc_part[:box_w - 22])

        scroll_indicator = f" [{scroll_y + 1}-{min(len(help_sections), scroll_y + visible_height)}/{len(help_sections)}] " if max_scroll > 0 else " "
        footer_text = f"{scroll_indicator}Press ↑/↓ to scroll • q/Esc/Enter to close"
        win.addstr(box_h - 1, max(2, box_w - len(footer_text) - 2), footer_text[:box_w - 4], curses.A_DIM)

        win.refresh()
        ch = win.getch()

        if ch in (ord('q'), ord('Q'), 27, ord('\n'), ord('\r'), ord(' ')):
            break
        elif ch in (curses.KEY_UP, ord('k')):
            if scroll_y > 0:
                scroll_y -= 1
        elif ch in (curses.KEY_DOWN, ord('j')):
            if scroll_y < max_scroll:
                scroll_y += 1
        elif ch in (curses.KEY_PPAGE,):
            scroll_y = max(0, scroll_y - 8)
        elif ch in (curses.KEY_NPAGE,):
            scroll_y = min(max_scroll, scroll_y + 8)

def run_curses_tui(stdscr):
    # Setup curses environment
    curses.curs_set(0)
    curses.use_default_colors()
    if curses.has_colors():
        curses.init_pair(1, curses.COLOR_WHITE, curses.COLOR_BLUE)   # Selection / Headers
        curses.init_pair(2, curses.COLOR_CYAN, -1)                   # UUIDs / Info
        curses.init_pair(3, curses.COLOR_YELLOW, -1)                 # Alerts / Titles / Sections
        curses.init_pair(4, curses.COLOR_GREEN, -1)                  # Size / Success
        curses.init_pair(5, curses.COLOR_RED, -1)                    # Warning / Errors

    cwd_filter = False
    status_msg = ""
    status_color = 0

    all_sessions = find_all_sessions()
    all_sessions.sort(key=lambda s: s["created_at"], reverse=True)

    selected_idx = 0
    top_idx = 0
    resume_uuid = None

    cwd_path = os.path.abspath(os.getcwd())

    while True:
        # Filter list
        if cwd_filter:
            sessions = [s for s in all_sessions if os.path.abspath(s["workspace"]) == cwd_path]
        else:
            sessions = all_sessions

        h, w = stdscr.getmaxyx()
        stdscr.erase()

        # Header
        filter_text = f"[Filter: Current Workspace ({cwd_path})]" if cwd_filter else "[Filter: All Workspaces]"
        header = f" Muse Code Session Manager — {len(sessions)} session(s) {filter_text}"
        stdscr.addstr(0, 0, header[:w-1].ljust(w-1), curses.A_BOLD | curses.color_pair(1))

        # Footer
        footer = " [Enter] Resume  [F2/r] Rename  [F4/d] Delete  [i] Info  [w] Filter  [?] Help  [q] Quit "
        stdscr.addstr(h - 1, 0, footer[:w-1].ljust(w-1), curses.A_REVERSE)

        # Status Message if any
        if status_msg:
            stdscr.addstr(h - 2, 0, f" ▶ {status_msg}"[:w-1], status_color | curses.A_BOLD)

        list_height = h - 3
        if list_height <= 0 or not sessions:
            if not sessions:
                stdscr.addstr(2, 2, "No sessions found.", curses.A_DIM)
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord('q'), ord('Q'), 27):
                break
            elif key in (ord('w'), ord('W')):
                cwd_filter = not cwd_filter
            elif key in (ord('?'), ord('h'), ord('H'), curses.KEY_F1):
                show_help_modal(stdscr)
            continue

        # Adjust selection bounds
        if selected_idx >= len(sessions):
            selected_idx = max(0, len(sessions) - 1)
        if selected_idx < top_idx:
            top_idx = selected_idx
        elif selected_idx >= top_idx + list_height:
            top_idx = selected_idx - list_height + 1

        # Draw session rows
        for i in range(list_height):
            idx = top_idx + i
            if idx >= len(sessions):
                break
            s = sessions[idx]
            y = 1 + i

            dt_str = s["created_at"].strftime("%Y-%m-%d %H:%M")
            sz_str = format_size(s["size_bytes"])
            title_text = s["custom_title"] if s["custom_title"] else s["prompt"]
            title_clean = title_text.replace("\n", " ").strip()

            line_str = f" {dt_str} | {s['uuid'][:8]} | {sz_str:>8} | {s['workspace']} : {title_clean}"
            if s["custom_title"]:
                line_str = f" {dt_str} | {s['uuid'][:8]} | {sz_str:>8} | 🏷️ {s['custom_title']} ({title_clean})"

            line_padded = line_str[:w-1].ljust(w-1)

            if idx == selected_idx:
                stdscr.addstr(y, 0, line_padded, curses.color_pair(1) | curses.A_BOLD)
            else:
                stdscr.addstr(y, 0, line_padded)

        stdscr.refresh()
        key = stdscr.getch()

        status_msg = ""  # clear status after next key

        # Navigation
        if key in (curses.KEY_UP, ord('k')):
            if selected_idx > 0:
                selected_idx -= 1
        elif key in (curses.KEY_DOWN, ord('j')):
            if selected_idx < len(sessions) - 1:
                selected_idx += 1
        elif key == curses.KEY_PPAGE:
            selected_idx = max(0, selected_idx - 10)
        elif key == curses.KEY_NPAGE:
            selected_idx = min(len(sessions) - 1, selected_idx + 10)
        elif key == curses.KEY_HOME:
            selected_idx = 0
        elif key == curses.KEY_END:
            selected_idx = len(sessions) - 1

        # Quit
        elif key in (ord('q'), ord('Q'), 27):
            break

        # Help Modal (? or h or F1)
        elif key in (ord('?'), ord('h'), ord('H'), curses.KEY_F1):
            show_help_modal(stdscr)

        # Filter Workspace toggle
        elif key in (ord('w'), ord('W')):
            cwd_filter = not cwd_filter
            selected_idx = 0
            top_idx = 0

        # Info
        elif key in (ord('i'), ord('I')):
            if sessions:
                show_info_modal(stdscr, sessions[selected_idx])

        # Resume Session (Enter)
        elif key in (ord('\n'), ord('\r'), curses.KEY_ENTER):
            if sessions:
                resume_uuid = sessions[selected_idx]["uuid"]
                break

        # Rename Session (F2 or r)
        elif key in (curses.KEY_F2, ord('r'), ord('R')):
            if sessions:
                s = sessions[selected_idx]
                prompt_label = f"Rename session {s['uuid'][:8]} (empty to clear): "
                new_val = curses_readline(stdscr, h - 2, 0, prompt_label)
                title_path = os.path.join(s["path"], ".session.title")
                if new_val:
                    with open(title_path, "w", encoding="utf-8") as f:
                        f.write(new_val + "\n")
                    s["custom_title"] = new_val
                    status_msg = f"Renamed session to: {new_val}"
                    status_color = curses.color_pair(4)
                else:
                    if os.path.exists(title_path):
                        os.remove(title_path)
                    s["custom_title"] = None
                    status_msg = "Custom title cleared."
                    status_color = curses.color_pair(3)

        # Delete Session (F4, Delete, d)
        elif key in (curses.KEY_F4, curses.KEY_DC, ord('d'), ord('D')):
            if sessions:
                s = sessions[selected_idx]
                confirm_prompt = f"Delete session {s['uuid'][:8]} ({format_size(s['size_bytes'])})? [y/N]: "
                answer = curses_readline(stdscr, h - 2, 0, confirm_prompt, max_len=10).lower()
                if answer in ('y', 'yes'):
                    try:
                        delete_session_on_disk(s)
                        all_sessions = [item for item in all_sessions if item["uuid"] != s["uuid"]]
                        status_msg = f"Deleted session {s['uuid'][:8]}."
                        status_color = curses.color_pair(4)
                    except Exception as err:
                        status_msg = f"Error deleting: {err}"
                        status_color = curses.color_pair(5)
                else:
                    status_msg = "Deletion cancelled."
                    status_color = curses.color_pair(3)

    return resume_uuid

def interactive_ui():
    if not sys.stdin.isatty():
        print("Error: Interactive picker requires an active terminal.", file=sys.stderr)
        sys.exit(1)
    resume_target = curses.wrapper(run_curses_tui)
    if resume_target:
        print(f"Resuming session {cyan(resume_target)}...")
        os.execvp("muse", ["muse", "resume", resume_target])

