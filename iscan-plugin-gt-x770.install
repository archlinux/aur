post_install() {
  echo "Registering iscan plugins and firmwares"
  iscan-registry --add interpreter usb 0x04b8 0x0119 \
    /usr/lib/iscan/libesint7C \
    /usr/share/iscan/esfw7C.bin
}

pre_remove() {
  echo "Unregistering iscan plugins and firmwares"
  iscan-registry --remove interpreter usb 0x04b8 0x0119 \
    /usr/lib/iscan/libesint7C \
    /usr/share/iscan/esfw7C.bin
}
