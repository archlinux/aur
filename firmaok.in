set -e

# CONSTANTS AND VARIABLES

# constants filled by PKGBUILD
_FOK_PKGNAME_='@PACKAGE_NAME@'
_FOK_APPNAME_='@APP_NAME@'
_FOK_VERSION_='@PACKAGE_VERSION@'
_FOK_TITLE_='@PACKAGE_TITLE@'
_FOK_RELEASE_='@PACKAGE_RELEASE@'
_FOK_SERIES_="@PACKAGE_SUFFIX@"

# other constants
_FOK_HOME_DIR_=~/".local/opt/${_FOK_APPNAME_}"
_FOK_AUR_="https://aur.archlinux.org/cgit/aur.git/snapshot/${_FOK_PKGNAME_}.tar.gz"

# variables
_FOK_REFRESH_=0


# FUNCTIONS

# syntax: _notify_ "${TITLE}" "${MESSAGE}"
_notify_() {

	if which zenity 2>/dev/null; then
		zenity --info --ellipsize --title "${1}" --text "${2}"
	elif which kdialog 2>/dev/null; then
		kdialog --title "${1}" --passivepopup "${2}"
	elif which notify-send 2>/dev/null; then
		notify-send --app-name="${_FOK_APPNAME_}" \
			--icon="${_FOK_APPNAME_}" "${1}" "${2}"
	else
		echo -e "${0}: [${1}] ${2}" >&2
	fi

}


# syntax: _compare_ver_ "${INSTALLED_VERSION}" "${LATEST_VERSION}"
_compare_ver_() {

	[[ "${1}" != "${2}" ]] || return 1

	[[ "${1}" == "`echo -e "${1}\n${2}" | sort -V | head -n1`" ]]

}


_refresh_local_() {

	local CACHE_DIR=~/".cache"

	echo "${0}: Extracting files to ${_FOK_APP_DIR_}." >> "${_FOK_LOG_FILE_}"
	rm -rf "${_FOK_APP_DIR_}"/*

	tar -xf "/opt/${_FOK_APPNAME_}/${_FOK_PKGNAME_}-${_FOK_VERSION_}.tar.gz" \
		--strip-components=1 -C "${_FOK_APP_DIR_}" >> \
		"${_FOK_LOG_FILE_}" 2>&1 && _notify_ "${_FOK_TITLE_}" \
		"A new version of ${_FOK_TITLE_} has been installed" || \
		_notify_ 'Error' \
		"The ${_FOK_TITLE_} archive could not be extracted to your home directory. \
		\nCheck the permissions of ${_FOK_APP_DIR_}. \
		\nThe error log can be found in ${_FOK_LOG_FILE_}."

	[[ ! -f "${_FOK_APP_DIR_}/launcher_linux.bat" ]] || \
		echo "${_FOK_VERSION_}-${_FOK_RELEASE_}" > "${_FOK_VER_FILE_}"

	install -dm755 "${_FOK_APP_DIR_}/Commons/stamps"
	install -Dm644 "/opt/${_FOK_APPNAME_}/pen.svg" "${_FOK_APP_DIR_}/Commons/stamps/symbolic.svg"

}


_aur_update_() {

	if [[ "$(id -u)" == '0' ]]; then
		echo 'It is not a good idea to do this as root. Abort.' 1>&2
		exit 1
	fi

	local DO_UPDATE=0
	local TMP_PKGBUILD="$(mktemp -d)"

	cd "${TMP_PKGBUILD}"

	if ! { curl --silent --fail "${_FOK_AUR_}" | tar xz ;} 2>/dev/null; then
		echo 'Unable to retrieve the PKGBUILD. Abort.' 1>&2
		rm -rf "${TMP_PKGBUILD}"
		exit 1
	fi

	cd "${TMP_PKGBUILD}/${_FOK_PKGNAME_}"

	local AUR_VERSION="$(grep 'pkgver' '.SRCINFO' | cut -d = -f2 | sed -e 's/^[[:space:]]*//')"
	local AUR_RELEASE="$(grep 'pkgrel' '.SRCINFO' | cut -d = -f2 | sed -e 's/^[[:space:]]*//')"

	if _compare_ver_ "${_FOK_VERSION_}" "${AUR_VERSION}"; then
		echo "Found new version (${_FOK_VERSION_} -> ${AUR_VERSION})..."
		DO_UPDATE=1
	elif [[ "${_FOK_VERSION_}" == "${AUR_VERSION}" ]] && \
		[[ "${_FOK_RELEASE_}" != "${AUR_RELEASE}" ]] && \
		[[ "${_FOK_RELEASE_}" == "`echo -e "${_FOK_RELEASE_}\n${AUR_RELEASE}" | sort | head -n1`" ]]; then
		echo 'Found new PKGBUILD...'
		DO_UPDATE=1
	else
		echo "Everything is up to date (current version: ${_FOK_VERSION_})."
	fi

	[[ ${DO_UPDATE} -eq 0 ]] || makepkg -si

	rm -rf "${TMP_PKGBUILD}"

}


_usage_() {

	cat <<EOF
Usage: ${0##*/} [option]

Options:
  -h|--help         Show this help message and exit
  -u|--update       Search in AUR for a new release and install it
  -r|--refresh      Refresh the copy in your home directory and launch firmaOK
  -e|--erase        Erase the copy in your home directory
  --dir=<directory> The firmaOK directory to use

  All unrecognized arguments will be passed to the browser.
EOF

}


# SCRIPT BODY

args=()
for arg; do
	case "${arg}" in
		-h|--help) _usage_; exit 0 ;;
		-u|--update) _aur_update_; exit 0 ;;
		-f|--refresh) _FOK_REFRESH_=1 ;;
		-e|--erase) rm -rf "${_FOK_HOME_DIR_}"; exit 0 ;;
		--dir=*) _FOK_HOME_DIR_="${arg#*=}" ;;
		*) args+=("$arg") ;;
	esac
done

_FOK_VER_FILE_="${_FOK_HOME_DIR_}/VERSION"
_FOK_LOG_FILE_="${_FOK_HOME_DIR_}/LOG"
_FOK_APP_DIR_="${_FOK_HOME_DIR_}/app"

# create directory, if it is missing (e.g. first run)
[[ -d "${_FOK_APP_DIR_}" ]] || mkdir -p "${_FOK_APP_DIR_}"

# create version file if missing
[[ -f "${_FOK_VER_FILE_}" ]] || echo 0 > "${_FOK_VER_FILE_}"

cd "${_FOK_HOME_DIR_}"

# get the installed version
while read _FOK_VER_LINE_; do
	_FOK_INSTALLED_VERSION_="${_FOK_VER_LINE_}"
done < "${_FOK_VER_FILE_}"

# start update if old or no firmaOK is installed
if [[ "${_FOK_INSTALLED_VERSION_}" == "${_FOK_VERSION_}" ]] && [[ ${_FOK_REFRESH_} -eq 0 ]]; then
	# clear log
	> "${_FOK_LOG_FILE_}"
else
	echo "${0}: Your version in ${_FOK_HOME_DIR_} is outdated or you do not have installed ${_FOK_APPNAME_} yet." > "${_FOK_LOG_FILE_}"
	_refresh_local_
fi

# start firmaOK
"${_FOK_APP_DIR_}/launcher_linux.bat" "${args[@]}"

