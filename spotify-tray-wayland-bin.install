post_install() {
    if [[ -n "$SUDO_USER" && "$SUDO_USER" != root ]]; then
        sudo -H -u "$SUDO_USER" /usr/bin/spotify-tray-setup --install-desktop
    else
        echo "Run 'spotify-tray-setup --install-desktop' as your desktop user to enable the Spotify launcher."
    fi
    echo "Run 'spotify-tray-setup' to configure optional keyboard controls."
}

post_upgrade() {
    if [[ -n "$SUDO_USER" && "$SUDO_USER" != root ]]; then
        sudo -H -u "$SUDO_USER" /usr/bin/spotify-tray-setup --upgrade
    else
        echo "Run 'spotify-tray-setup --upgrade' as your desktop user to apply the keyboard migration."
    fi
    echo "Run 'spotify-tray-setup' to choose a Spotify workspace shortcut."
}

pre_remove() {
    # Clean up user config files
    if [[ -n "$SUDO_USER" ]]; then
        USER_HOME=$(eval echo ~$SUDO_USER)
        USER_ID=$(id -u "$SUDO_USER")

        rm -f "$USER_HOME/.config/hypr/conf.d/spotify.conf" "$USER_HOME/.config/hypr/conf.d/spotify.lua"
        # Lua config: drop loader line, or hyprland.lua would dofile() a missing file
        sed -i '/conf\.d\/spotify\.lua/d' "$USER_HOME/.config/hypr/hyprland.lua" 2>/dev/null
        rm -f "$USER_HOME/.config/hypr/UserScripts/smart-close.sh"
        rm -f "$USER_HOME/.local/share/applications/spotify.desktop"

        # Remove source line from hyprland.conf
        sed -i '/source.*spotify\.conf/d' "$USER_HOME/.config/hypr/hyprland.conf" 2>/dev/null

        # Reload Hyprland if running
        HYPRLAND_INSTANCE_SIGNATURE=$(ls /run/user/$USER_ID/hypr/ 2>/dev/null | head -1)
        if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
            sudo -u "$SUDO_USER" HYPRLAND_INSTANCE_SIGNATURE="$HYPRLAND_INSTANCE_SIGNATURE" hyprctl reload 2>/dev/null || true
        fi
    fi
}
