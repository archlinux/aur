post_install() {
    echo "=========================================" >&2
    echo "Lighthouse Manager post-install hook running..." >&2
    echo "=========================================" >&2
    
    if [ ! -f "/usr/bin/${pkgname}-install" ]; then
        echo "ERROR: Install script not found at /usr/bin/${pkgname}-install" >&2
        echo "=========================================" >&2
        return 0
    fi
    
    FOUND_STEAMVR=0
    TMPFILE=$(mktemp 2>/dev/null || echo /tmp/passwd.$$)
    if ! getent passwd > "$TMPFILE" 2>/dev/null; then
        echo "WARNING: Could not get user list" >&2
        rm -f "$TMPFILE"
        return 0
    fi
    
    while IFS=: read -r user _ _ _ _ user_home _; do
        [ -z "$user" ] && continue
        [ "$user" = "root" ] && continue
        [ -z "$user_home" ] && continue
        
        if [ -d "$user_home/.local/share/Steam/steamapps/common/SteamVR" ] || \
           [ -d "$user_home/.steam/steam/steamapps/common/SteamVR" ] || \
           [ -d "$user_home/.steam/root/steamapps/common/SteamVR" ]; then
            FOUND_STEAMVR=1
            echo "Found SteamVR for user: $user (home: $user_home)" >&2
            echo "Installing Lighthouse Manager..." >&2
            /usr/bin/${pkgname}-install "$user_home" 2>&1 || {
                echo "WARNING: Installation failed for user $user, continuing..." >&2
            }
        fi
    done < "$TMPFILE"
    
    rm -f "$TMPFILE"
    
    if [ "$FOUND_STEAMVR" -eq 0 ]; then
        echo "No SteamVR installations found. You may need to run '${pkgname}-install' manually after starting SteamVR." >&2
    else
        echo "Installation complete!" >&2
    fi
    echo "=========================================" >&2
}

post_upgrade() {
    post_install
}

post_remove() {
    echo "=========================================" >&2
    echo "Lighthouse Manager post-remove hook running..." >&2
    echo "=========================================" >&2
    
    FOUND_INSTALLATION=0
    TMPFILE=$(mktemp 2>/dev/null || echo /tmp/passwd.$$)
    if ! getent passwd > "$TMPFILE" 2>/dev/null; then
        echo "WARNING: Could not get user list" >&2
        rm -f "$TMPFILE"
        return 0
    fi
    
    while IFS=: read -r user _ _ _ _ user_home _; do
        [ -z "$user" ] && continue
        [ "$user" = "root" ] && continue
        [ -z "$user_home" ] && continue
        
        INSTALL_DIR="$user_home/.local/share/SteamVR/drivers/lighthouse-manager"
        
        if [ ! -d "$INSTALL_DIR" ]; then
            continue
        fi
        
        FOUND_INSTALLATION=1
        echo "Found Lighthouse Manager installation for user: $user (home: $user_home)" >&2
        
        # Find vrpathreg
        VRPATHREG=""
        for path in \
            "$user_home/.local/share/Steam/steamapps/common/SteamVR/bin/linux64/vrpathreg" \
            "$user_home/.steam/steam/steamapps/common/SteamVR/bin/linux64/vrpathreg" \
            "$user_home/.steam/root/steamapps/common/SteamVR/bin/linux64/vrpathreg" \
            "/usr/local/bin/vrpathreg" \
            "/usr/bin/vrpathreg"; do
            if [ -f "$path" ]; then
                VRPATHREG="$path"
                break
            fi
        done
        
        # Note: Lighthouse Manager is an overlay application, not a driver
        # Overlays are registered via OpenVR API, not vrpathreg
        # Removing the overlay config file will prevent it from auto-launching
        
        # Remove files
        echo "Removing installation files..." >&2
        rm -rf "$INSTALL_DIR" 2>/dev/null || {
            echo "WARNING: Could not remove all files from $INSTALL_DIR" >&2
        }
        
        # Remove overlay config if it exists
        OVERLAY_CONFIG="$user_home/.local/share/Steam/config/vrappconfig/lighthouse-manager-linux.vrappconfig"
        if [ -f "$OVERLAY_CONFIG" ]; then
            rm -f "$OVERLAY_CONFIG" 2>/dev/null || true
        fi
        
    done < "$TMPFILE"
    
    rm -f "$TMPFILE"
    
    if [ "$FOUND_INSTALLATION" -eq 0 ]; then
        echo "No Lighthouse Manager installations found to remove." >&2
    else
        echo "Uninstallation complete!" >&2
        echo "Restart SteamVR to complete the removal." >&2
    fi
    echo "=========================================" >&2
}

