post_install() {
	echo "Run 'hyprspaces-install' to wire the plugin into your Hyprland config."
	echo "Rebuild dependencies are installed with this package."
	echo "Restart/logout after install to activate the plugin."
}

post_upgrade() {
	echo "The plugin auto-rebuilds on Hyprland updates."
	echo "Restart/logout after update or rebuild to activate the rebuilt plugin."
}
