From 027333d7f4da2deaaaaecb3782c076e5eb1888b5 Mon Sep 17 00:00:00 2001
From: Martchus <martchus@gmx.net>
Date: Thu, 5 Nov 2020 21:13:19 +0100
Subject: [PATCH 03/22] Fix using static PCRE2 and DBus-1

When making a static build of Qt we're using the static version of these
libraries and must define the corresponding macros.

Change-Id: I2387b79462b6d183b71f9433dd937f63fc7ef26e
---
 src/corelib/text/qregularexpression.cpp | 5 +++++
 src/dbus/qdbus_symbols_p.h              | 4 ++++
 2 files changed, 9 insertions(+)

diff --git a/src/corelib/text/qregularexpression.cpp b/src/corelib/text/qregularexpression.cpp
index e7123b47355..75dd2b7d4d3 100644
--- a/src/corelib/text/qregularexpression.cpp
+++ b/src/corelib/text/qregularexpression.cpp
@@ -21,6 +21,11 @@
 #endif
 
 #define PCRE2_CODE_UNIT_WIDTH 16
+#ifdef QT_STATIC
+#define PCRE_STATIC
+#define PCRE2_STATIC
+#endif
+#define PCRE2_EXP_DECL Q_CORE_EXPORT
 
 #include <pcre2.h>
 
diff --git a/src/dbus/qdbus_symbols_p.h b/src/dbus/qdbus_symbols_p.h
index a3e3b202c12..6a4856e8428 100644
--- a/src/dbus/qdbus_symbols_p.h
+++ b/src/dbus/qdbus_symbols_p.h
@@ -22,6 +22,10 @@
 
 #ifndef QT_NO_DBUS
 
+#ifdef QT_STATIC
+#  define DBUS_STATIC_BUILD
+#endif
+
 #ifdef QT_LINKED_LIBDBUS
 #  include <dbus/dbus.h>
 #else
-- 
