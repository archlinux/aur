Subject: [PATCH] build: allow taking the Electron distribution from
 ELECTRON_ZIP_DIR

---
 app/build/build.js | 1 +
 1 file changed, 1 insertion(+)

diff --git a/app/build/build.js b/app/build/build.js
index cbb5fc5..6fdb835 100644
--- a/app/build/build.js
+++ b/app/build/build.js
@@ -203,6 +203,7 @@ function buildPackagerOptions() {
     dir: appDir,
     appCategoryType: 'public.app-category.business',
     tmpdir,
+    electronZipDir: process.env.ELECTRON_ZIP_DIR,
     arch: {
       win32: 'x64',
       darwin: process.env.OVERRIDE_TO_INTEL ? 'x64' : process.arch,
