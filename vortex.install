post_install() {
  chmod 4755 '/opt/Vortex/chrome-sandbox' 2>/dev/null || true
  chmod -R 755 '/opt/Vortex/resources/app.asar.unpacked/assets' 2>/dev/null || true
  update-desktop-database -q  # registra x-scheme-handler/nxm
  update-mime-database /usr/share/mime  # innecesario para URL schemes pero inofensivo

  echo ""
  echo "  ┌─────────────────────────────────────────────────────────┐"
  echo "  │              vortex-linux-fix instalado                 │"
  echo "  │                                                         │"
  echo "  │  Proyecto original: Nexus-Mods/Vortex                  │"
  echo "  │  github.com/Nexus-Mods/Vortex                          │"
  echo "  │                                                         │"
  echo "  │  Muchas gracias al equipo de Nexus Mods por            │"
  echo "  │  desarrollar y publicar Vortex como software libre.    │"
  echo "  │                                                         │"
  echo "  │  Este paquete aplica parches de compatibilidad Linux   │"
  echo "  │  no incluidos en el proyecto oficial.                  │"
  echo "  │                                                         │"
  echo "  │  Mantenido por k8rit0 (AUR)                            │"
  echo "  └─────────────────────────────────────────────────────────┘"
  echo ""
  echo ":: Para gestionar enlaces NXM (botón 'Mod Manager Download'):"
  echo "   xdg-mime default vortex.desktop x-scheme-handler/nxm"
  echo ""
  echo ":: Log de parches runtime en cada arranque:"
  echo "   ~/.config/Vortex/vortex-linux-fix.log"
  echo ""
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q  # registra x-scheme-handler/nxm
  update-mime-database /usr/share/mime  # innecesario para URL schemes pero inofensivo
}
