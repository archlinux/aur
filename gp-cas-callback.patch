+int gpst_handle_external_browser(struct openconnect_info *vpninfo)
+{
+	int ret = -EINVAL;
+	char *data_file = NULL, *uri = NULL, *oc_cache_dir = NULL;
+#ifndef _WIN32
+	int fd = -1;
+#endif
+
+	oc_cache_dir = get_user_cache_dir();
+	if (!oc_cache_dir)
+		return -ENOMEM;
+
+	if (asprintf(&data_file, "%s/%s", oc_cache_dir, GP_DATA_FILE) < 0) {
+		ret = -ENOMEM;
+		goto finish;
+	}
+
+	if (vpninfo->sso_login && strncmp(vpninfo->sso_login, "data:text/html;base64,", 22) == 0) {
+		int len, tmp_file_len;
+		void *out = openconnect_base64_decode(&len, vpninfo->sso_login + 22);
+		char *tmp_file;
+		FILE *file;
+
+		if (!out)
+			goto finish;
+
+		tmp_file_len = strlen(oc_cache_dir) + strlen("/saml.html") + 1;
+		tmp_file = malloc(tmp_file_len);
+		if (!tmp_file) {
+			free(out);
+			ret = -ENOMEM;
+			goto finish;
+		}
+		strcpy(tmp_file, oc_cache_dir);
+		strcat(tmp_file, "/saml.html");
+		file = fopen(tmp_file, "w");
+		if (!file) {
+			free(out);
+			free(tmp_file);
+			goto finish;
+		}
+		fwrite(out, 1, len, file);
+		fclose(file);
+		free(out);
+
+		if (asprintf(&uri, "file:///%s", tmp_file) < 0)
+			ret = -ENOMEM;
+		free(tmp_file);
+		if (!uri)
+			goto finish;
+	} else if (vpninfo->sso_login) {
+		uri = strdup(vpninfo->sso_login);
+		if (!uri) {
+			ret = -ENOMEM;
+			goto finish;
+		}
+	} else
+		goto finish;
+
+#ifndef _WIN32
+	int wd;
+
+	fd = inotify_init();
+	if (fd < 0)
+		goto finish;
+	if (fcntl(fd, F_SETFL, O_NONBLOCK) < 0)
+		goto finish;
+
+	wd = inotify_add_watch(fd, oc_cache_dir, IN_CLOSE_WRITE);
+	if (wd == -1)
+		vpn_progress(vpninfo, PRG_DEBUG, "Could not watch : %s\n", oc_cache_dir);
+	else
+		vpn_progress(vpninfo, PRG_DEBUG, "Watching : %s\n", oc_cache_dir);
+
+	if (vpninfo->open_ext_browser)
+		ret = vpninfo->open_ext_browser(vpninfo, uri, vpninfo->cbdata);
+#ifdef HAVE_POSIX_SPAWN
+	else if (vpninfo->external_browser) {
+		pid_t pid;
+		char *browser_argv[] = { (char *)vpninfo->external_browser, uri, NULL };
+		int err;
+
+		err = posix_spawn(&pid, vpninfo->external_browser, NULL, NULL,
+				  browser_argv, environ);
+		if (err) {
+			errno = err;
+			vpn_perror(vpninfo, _("Spawn browser"));
+			ret = -err;
+		} else
+			ret = 0;
+	}
+#endif
+	else {
+		char *spawn;
+		if (asprintf(&spawn, "xdg-open \"%s\"&", uri) < 0) {
+			ret = -ENOMEM;
+			goto finish;
+		}
+		ret = system(spawn);
+		free(spawn);
+	}
+
+	if (ret) {
+		vpn_progress(vpninfo, PRG_ERR,
+			     _("Failed to spawn external browser for %s\n"),
+			     vpninfo->sso_login);
+		goto finish;
+	}
+
+	while (1) {
+		int i = 0, length;
+		char buffer[BUF_LEN];
+
+		length = read(fd, buffer, BUF_LEN);
+		if (length < 0) {
+			if (errno == EAGAIN || errno == EWOULDBLOCK) {
+				usleep(100000);
+				continue;
+			}
+			goto finish;
+		}
+
+		while (i < length) {
+			struct inotify_event *event = (struct inotify_event *)&buffer[i];
+
+			if (event->len && (event->mask & IN_CLOSE_WRITE) &&
+			    !(event->mask & IN_ISDIR) && !strcmp(event->name, GP_DATA_FILE)) {
+				vpn_progress(vpninfo, PRG_INFO, "The file %s was written.\n", event->name);
+				ret = parse_callback_file(vpninfo, data_file);
+				goto finish;
+			}
+			i += EVENT_SIZE + event->len;
+		}
+	}
+#else
+	vpn_progress(vpninfo, PRG_INFO, "Proper callback data handling missing on Windows\n");
+	ret = -EINVAL;
+#endif
+
+finish:
+#ifndef _WIN32
+	if (fd >= 0)
+		close(fd);
+#endif
+	free(uri);
+	free(oc_cache_dir);
+	free(data_file);
+	return ret;
+}
