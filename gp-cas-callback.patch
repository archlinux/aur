+static char *get_user_cache_dir(void)
+{
+	char *cache_dir, *home;
+	int cache_dir_len;
+
+#ifndef _WIN32
+	struct passwd *pw = getpwuid(getuid());
+	if (!pw || !pw->pw_dir)
+		return NULL;
+	home = strdup(pw->pw_dir);
+#else
+	home = strdup("");
+#endif
+	if (!home)
+		return NULL;
+
+	cache_dir_len = strlen(home) + strlen("/.cache/openconnect/") + 1;
+	cache_dir = malloc(cache_dir_len);
+	if (!cache_dir) {
+		free(home);
+		return NULL;
+	}
+	snprintf(cache_dir, cache_dir_len, "%s/.cache/openconnect/", home);
+	free(home);
+
+#ifndef _WIN32
+	mkdir(cache_dir, 0700);
+#else
+	CreateDirectory(cache_dir, NULL);
+#endif
+	return cache_dir;
+}
+
+static char *gp_callback_value(char *data, const char *name)
+{
+	char *start, *end, *value;
+	size_t name_len = strlen(name);
+
+	start = strstr(data, name);
+	if (!start || start[name_len] != '=')
+		return NULL;
+	start += name_len + 1;
+	end = strchr(start, '&');
+	value = end ? strndup(start, end - start) : strdup(start);
+	if (value)
+		urldecode_inplace(value);
+	return value;
+}
+
+static int parse_callback_file(struct openconnect_info *vpninfo, const char *data_file)
+{
+	FILE *fptr;
+	char *data, *username = NULL, *token = NULL;
+	long size;
+	int ret = -EINVAL;
+
+	fptr = fopen(data_file, "r");
+	if (!fptr) {
+		vpn_progress(vpninfo, PRG_INFO, "Failed to open file %s\n", data_file);
+		return -EINVAL;
+	}
+
+	fseek(fptr, 0L, SEEK_END);
+	size = ftell(fptr);
+	fseek(fptr, 0L, SEEK_SET);
+	if (size < 0) {
+		fclose(fptr);
+		return -EINVAL;
+	}
+
+	data = calloc(1, size + 1);
+	if (!data) {
+		fclose(fptr);
+		return -ENOMEM;
+	}
+	fread(data, size, 1, fptr);
+	fclose(fptr);
+
+	if (strstr(data, "cas-as=")) {
+		username = gp_callback_value(data, "un");
+		token = gp_callback_value(data, "token");
+		if (!username || !token)
+			goto out;
+
+		vpn_progress(vpninfo, PRG_INFO, "CAS method for user %s\n", username);
+		free(vpninfo->sso_username);
+		free(vpninfo->sso_cookie_value);
+		vpninfo->sso_username = username;
+		vpninfo->sso_cookie_value = token;
+		username = token = NULL;
+		ret = 0;
+	}
+
+out:
+	free(username);
+	free(token);
+	free(data);
+	return ret;
+}
