post_install() {
  systemctl daemon-reload
  udevadm control --reload
  printf '%s\n' \
    'Install headers matching your kernel so DKMS can build fte3600, then reboot.' \
    'After reboot, run: sudo fte3600-device-allow --install' \
    'Install chip firmware if required, then restart fprintd.service.' \
    'Identify the chip with: sudo fte3600-tool probe /dev/spidevB.C' \
    'Verify setup & manage fingerprints with: fte3600-toolkit doctor / fte3600-toolkit-gui' \
    'See packaging/README.md in the source repository for instructions.'
}
post_upgrade() { post_install; }
post_remove() {
  systemctl daemon-reload
  udevadm control --reload
  printf '%s\n' 'Remove /etc/systemd/system/fprintd.service.d/10-fte3600-acpi-spidev.conf if no longer needed, then run systemctl daemon-reload.'
}
