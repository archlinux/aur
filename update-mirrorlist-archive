#!/bin/python
import sys
import tomllib
from pathlib import Path
import os
import datetime
import subprocess
import re

archive_config = Path("/etc/pacman-archive.toml")
archive_d_dir = Path("/var/lib/pacman-archive")
#archive_config = Path("./pacman-archive.toml")
#archive_d_dir = Path("./pacman-archive.d")

def get_repo_list():
    def _get_repo_list():
        return subprocess.run(["pacman-conf", "--repo-list"], capture_output=True, text=True)
    pattern = re.compile(r".*(/var/lib/pacman-archive/[a-zA-Z0-9_.-]+\.mirrorlist).*")
    result = _get_repo_list()
    try_number = 100
    while result.returncode != 0 and ((try_number := try_number - 1) > 0):
        if match := pattern.search(result.stderr):
            if missing_mirrorlist := match.group(1):
                Path(missing_mirrorlist).parent.mkdir(parents=True, exist_ok=True)
                Path(missing_mirrorlist).touch(exist_ok=True)
                result = _get_repo_list()
                continue
            else:
                try_number=0
        else:
            try_number=0
    if not try_number > 0:
        print(result.stderr)
        sys.exit(1)
    return result.stdout.splitlines()

def get_repo_last_modified(repo: str):
    pacman_lib_sync_path = Path("/var/lib/pacman/sync")

    db_path = pacman_lib_sync_path / Path(repo + ".db")
    try:
        mtime = os.stat(db_path).st_mtime
    except FileNotFoundError:
        return
    return datetime.datetime.fromtimestamp(mtime)

def replace_server_list_vars(url: str, mtime: datetime.datetime):
    new_url = url
    new_url = new_url.replace("$year",  mtime.strftime("%Y"))
    new_url = new_url.replace("$month", mtime.strftime("%m"))
    new_url = new_url.replace("$day",   mtime.strftime("%d"))
    return new_url

def print_archive_info(config_o, db_date: dict[str, datetime.datetime]):
    info = "pacman archive has been updated:\n"
    length=0
    for repo in config_o.keys():
        length=max(length, len(repo))
    for repo in config_o.keys():
        info +="    {:>{}}: {}\n".format(repo, 11, str(db_date[repo].date()))
        for line in config_o[repo]:
            info += "    {:>{}}  {}".format("", length, line)
    print(info, end="")

def main():
    # repo in repos:
    # 1. repo in pacman config
    repos = get_repo_list()
    #print(repos)

    # repo in repos:
    # 1. repo in pacman config
    # 2. repo has been synchronized, ie db exist
    db_date: dict[str, datetime.datetime] = {}
    for repo in repos.copy():
        mtime = get_repo_last_modified(repo)
        if mtime is None:
            repos.remove(repo)
            continue
        db_date[repo] = mtime
    #print(repos)

    # repo in repos:
    # 1. repo in pacman config
    # 2. repo has been synchronized, ie db exist
    # 3. repo in pacman-archive config
    with open(archive_config, "rb") as f:
        config_i = tomllib.load(f)
    config_o = {}
    for repo in repos.copy():
        # if there is no archive config for the repo
        if repo not in config_i.keys():
            repos.remove(repo)
            continue

        servers_a = config_i.get(repo, {}).get("Server", [])
        existing_archive_config=[]
        for url in servers_a:
            server = replace_server_list_vars(url, db_date[repo])
            existing_archive_config.append("Server = {}\n".format(server))
        config_o[repo] = existing_archive_config

    if len(repos) == 0:
        return 0
    #print(repos)

    # compare with existing config
    for repo in repos:
        try:
            with open(archive_d_dir / (repo + ".mirrorlist"), "r+") as f:
                existing_archive_config = f.readlines()
        except FileNotFoundError:
            existing_archive_config = []
        if config_o[repo] == existing_archive_config:
            config_o.pop(repo)

    if len(config_o) == 0:
        return 0

    for repo in config_o.keys():
        lines = config_o.get(repo, [])
        with open(archive_d_dir / (repo + ".mirrorlist"), "w+") as f:
            f.writelines(lines)

    print_archive_info(config_o, db_date)

    return 0

if __name__ == '__main__':
    sys.exit(main())

