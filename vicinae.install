# The input server monitors input devices and needs to read /dev/input/eventXX.
post_install() {
  setcap 'cap_dac_override+ep' /usr/libexec/vicinae/vicinae-input-server

  # The modules-load configuration only takes effect automatically after reboot.
  modprobe uinput || echo 'Failed to modprobe uinput: snippets and paste may not work until reboot.'
}

post_upgrade() {
  post_install
}
