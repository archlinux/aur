#!/bin/bash

flags_file="${XDG_CONFIG_HOME:-${HOME}/.config}/hermes-desktop-flags.conf"
declare -a flags=()

if [[ -r "${flags_file}" ]]; then
  while IFS= read -r flag || [[ -n "${flag}" ]]; do
    flag="${flag#"${flag%%[![:space:]]*}"}"
    flag="${flag%"${flag##*[![:space:]]}"}"
    [[ -z "${flag}" || "${flag}" == \#* ]] && continue
    flags+=("${flag}")
  done < "${flags_file}"
fi

export HERMES_DESKTOP_IS_PACKAGED=1
export HERMES_DESKTOP_RESOURCES_PATH=/usr/lib/hermes-agent-desktop
export HERMES_DESKTOP_PACKAGE_MANAGED_RUNTIME=1

# Reuse the hermes-agent runtime package (hermes-agent or hermes-agent-bin) as the
# only local agent runtime.
# Do not set HERMES_DESKTOP_HERMES_ROOT to /opt — that path is read-only and
# must not be treated as a writable checkout. The CLI wrapper owns the venv.
if [[ -z "${HERMES_DESKTOP_HERMES:-}" ]]; then
  export HERMES_DESKTOP_HERMES=/usr/bin/hermes
fi
if [[ ! -x "${HERMES_DESKTOP_HERMES}" ]]; then
  printf '%s\n' "hermes-desktop: ${HERMES_DESKTOP_HERMES} is missing or not executable. Install hermes-agent (or hermes-agent-bin); this app will not bootstrap a private agent tree." >&2
fi

# No browser export: browser_exec reads only browser.executable_path (then
# pm's Chromium). The config migration to v52 would write an exported
# AGENT_BROWSER_EXECUTABLE_PATH into the user's config.yaml.

exec /usr/bin/electron44 "${flags[@]}" \
  /usr/lib/hermes-agent-desktop/app.asar "$@"
