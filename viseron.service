[Unit]
Description=Viseron NVR
After=network.target postgresql.service viseron-go2rtc.service
Wants=viseron-go2rtc.service

[Service]
Type=simple
User=viseron
Group=viseron
WorkingDirectory=/usr/lib/viseron
ExecStart=/usr/lib/viseron/bin/python -u -m viseron
Environment="VISERON_CONFIG_DIR=/etc/viseron"
Environment="PATH=/var/lib/viseron/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="VISERON_FFMPEG_PATH=/usr/bin/ffmpeg"
Environment="VISERON_GSTREAMER_PATH=/usr/bin/gstreamer"

# Hardware acceleration (Uncomment if your hardware supports it)
#Environment="VISERON_CUDA_SUPPORTED=true"
#Environment="VISERON_VAAPI_SUPPORTED=true"
#Environment="VISERON_OPENCL_SUPPORTED=true"
#Environment="VISERON_RASPBERRYPI4=true"
#Environment="VISERON_RASPBERRYPI3=true"
#Environment="VISERON_RASPBERRYPI5=true"
#Environment="VISERON_JETSON_NANO=true"

# Logging & Profiling
#Environment="VISERON_LOG_MAX_BYTES=10485760"
#Environment="VISERON_LOG_BACKUP_COUNT=5"
#Environment="VISERON_PROFILE_MEMORY=true"
#Environment="VISERON_LOG_FD=true"
Restart=always

[Install]
WantedBy=multi-user.target
