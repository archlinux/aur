_dkms_name=hid-shure-mv6

_dkms_ver() {
    find /usr/src -maxdepth 1 -name "${_dkms_name}-*" -type d \
        | sort -V | tail -1 | sed "s|.*/${_dkms_name}-||"
}

post_install() {
    local _ver
    _ver=$(_dkms_ver)
    dkms install --no-depmod "${_dkms_name}/${_ver}"
    depmod -A
    modprobe hid_shure_mv6 && echo ">>> hid_shure_mv6 loaded." \
        || echo ">>> Warning: modprobe failed; reboot or run: modprobe hid_shure_mv6"
    echo ">>> Enable and start the user service:"
    echo ">>>   systemctl --user enable --now shure-mv6-sync"
}

post_upgrade() {
    local _ver
    _ver=$(_dkms_ver)
    # Remove any stale older versions first
    dkms status "${_dkms_name}" | awk -F'[,/]' '{print $2}' \
        | grep -v "^[[:space:]]*${_ver}$" \
        | xargs -rI{} dkms remove "${_dkms_name}/{}" --all 2>/dev/null || true
    dkms install --no-depmod "${_dkms_name}/${_ver}"
    depmod -A
    modprobe hid_shure_mv6 2>/dev/null || true
    echo ">>> Enable and start the user service:"
    echo ">>>   systemctl --user enable --now shure-mv6-sync"
}

post_remove() {
    dkms remove "${_dkms_name}" --all 2>/dev/null || true
    depmod -A
}
