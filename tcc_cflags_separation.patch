diff --git a/devkitsnes/snes_rules b/devkitsnes/snes_rules
index f60298c..db61067 100644
--- a/devkitsnes/snes_rules
+++ b/devkitsnes/snes_rules
@@ -110,7 +110,7 @@ export OPT		:=	$(PVSNESLIB_HOME)/devkitsnes/tools/816-opt
 #---------------------------------------------------------------------------------
 # Add default flag for compiling
 #---------------------------------------------------------------------------------
-CFLAGS += -I$(PVSNESLIB_HOME)/pvsneslib/include -I$(PVSNESLIB_HOME)/devkitsnes/include -I$(CURDIR)
+TCC_CFLAGS += -I$(PVSNESLIB_HOME)/pvsneslib/include -I$(PVSNESLIB_HOME)/devkitsnes/include -I$(CURDIR)
 
 # -d switch disable WLA's ability to calculate A-B where A and B are labels.
 # if you remove it, you will have some updates to do at least in crt0_snes.asm
@@ -164,15 +164,15 @@ BUILD_LOG := $(ROMNAME).log
 	@echo Compiling to .ps ... $(notdir $<)
 ifeq ($(HIROM),1)
 ifeq ($(FASTROM),1)
-	$(CC) $(CFLAGS) -Wall -c $< -H -F -o $@
+	$(CC) $(TCC_CFLAGS) -Wall -c $< -H -F -o $@
 else
-	$(CC) $(CFLAGS) -Wall -c $< -H -o $@
+	$(CC) $(TCC_CFLAGS) -Wall -c $< -H -o $@
 endif
 else
 ifeq ($(FASTROM),1)
-	$(CC) $(CFLAGS) -Wall -c $< -F -o $@
+	$(CC) $(TCC_CFLAGS) -Wall -c $< -F -o $@
 else
-	$(CC) $(CFLAGS) -Wall -c $< -o $@
+	$(CC) $(TCC_CFLAGS) -Wall -c $< -o $@
 endif
 endif
 
