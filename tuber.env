# Environment for tuber.service. See `tuber server --help` for every option.

# Listen address. Upstream defaults to 0.0.0.0; the packaged service binds
# loopback only, because tuber has no authentication. Widen it deliberately,
# and put a firewall or private network in front when you do.
TUBER_LISTEN=127.0.0.1
TUBER_PORT=11300

# Write-ahead log directory. Comment out to run purely in memory (jobs are
# lost on restart). systemd provisions this via StateDirectory=tuber.
TUBER_BINLOG_DIR=/var/lib/tuber

# Minimum interval between fsyncs of the WAL and body store. 0 fsyncs every
# write (strongest durability, slowest); a positive value bounds how much
# committed state a crash can lose.
#TUBER_SYNC_INTERVAL=100ms

# Combined WAL + TOAST disk budget. Puts return OUT_OF_STORAGE past it.
#TUBER_MAX_STORAGE_BYTES=10g

# Caps on a single job body and on total in-memory job size.
#TUBER_MAX_JOB_SIZE=1m
#TUBER_MAX_JOBS_SIZE=1g

# Connection ceiling, and idle-connection pruning in seconds (0 disables).
#TUBER_MAX_CONNECTIONS=1024
#TUBER_CONN_IDLE_TIMEOUT=0

# Prometheus metrics endpoint.
#TUBER_METRICS_PORT=11301

# Server name reported in stats, and log verbosity (1=debug, 2=trace).
#TUBER_NAME=tuber
#TUBER_VERBOSE=1
