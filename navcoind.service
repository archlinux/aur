[Unit]
Description=Nav Coin Daemon
After=network.target

[Service]
User=navcoin
Group=navcoin
WorkingDirectory=/var/lib/navcoin
RuntimeDirectory=navcoin

Type=forking
PIDFile=/run/navcoin/navcoind.pid

ExecStart=/usr/bin/navcoind -daemon -pid=/run/navcoin/navcoind.pid
Restart=always

[Install]
WantedBy=multi-user.target
