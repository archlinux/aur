post_install() {
    cat <<'EOF'
OpenWrite installed to /opt/openwrite.

Interactive use:
  openwrite-launcher   bootstraps an isolated Python runtime in
                       ~/.openwrite-runtime/ on first run, then opens Studio.
  openwrite            direct CLI (requires the runtime deps; use the
                       launcher first if they are missing).

Run Studio as a systemd user service (recommended):
  systemctl --user enable --now openwrite.service
  -> Studio listens on http://127.0.0.1:4567

To start the service automatically at boot without logging in:
  sudo loginctl enable-linger $USER

Port can be changed with an override:
  systemctl --user edit openwrite.service   # set Environment=OPENWRITE_PORT=...
EOF
}

post_upgrade() {
    post_install
}
