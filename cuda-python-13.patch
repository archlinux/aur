@@ -32,7 +32,17 @@ import importlib
+import importlib.util
 from typing import Any
 
 def lazy_import(mod_name: str) -> Any:
+    # cuda-python 13 moved the driver and runtime APIs from cuda.cuda and
+    # cuda.cudart to cuda.bindings. Keep compatibility with both layouts.
+    if importlib.util.find_spec("cuda.bindings.driver") is not None:
+        mod_name = {
+            "cuda": "cuda.bindings",
+            "cuda.cuda": "cuda.bindings.driver",
+            "cuda.cudart": "cuda.bindings.runtime",
+        }.get(mod_name, mod_name)
+
     class Lazy:
         def __getattr__(self, name:str) -> Any:
             module = importlib.import_module(mod_name)
