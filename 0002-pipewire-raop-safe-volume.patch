+static void test_device_id(void)
+{
+	char device[13];
+
+	spa_assert_se(raop_parse_device_id(
+			"02000000A001@SoundTouch 30", device) == 0);
+	spa_assert_se(spa_streq(device, "02000000A001"));
+	spa_assert_se(raop_parse_device_id(
+			"02000000a002@SoundTouch 10", device) == 0);
+	spa_assert_se(spa_streq(device, "02000000A002"));
+	spa_assert_se(raop_parse_device_id("02000000A00@short", device) ==
+			-EINVAL);
+	spa_assert_se(raop_parse_device_id("02000000A0010@long", device) ==
+			-EINVAL);
+	spa_assert_se(raop_parse_device_id("02000000A00Z@invalid", device) ==
+			-EINVAL);
+	spa_assert_se(raop_parse_device_id("02000000A001", device) == -EINVAL);
+}
+
+static void count_destroy(void *data)
+{
+	unsigned int *count = data;
+
+	(*count)++;
+}
+
+static void test_rtsp_reply_lifetime(void)
+{
+	struct pw_main_loop *main_loop;
+	struct pw_rtsp_client *client;
+	unsigned int destroy_count = 0;
+
+	main_loop = pw_main_loop_new(NULL);
+	spa_assert_se(main_loop != NULL);
+	client = pw_rtsp_client_new(pw_main_loop_get_loop(main_loop),
+			pw_properties_new(NULL, NULL), 0);
+	spa_assert_se(client != NULL);
+	spa_assert_se(pw_rtsp_client_url_send_full(client,
+			"rtsp://127.0.0.1/test", "SET_PARAMETER", NULL,
+			NULL, NULL, 0, NULL, &destroy_count, count_destroy) == 0);
+	pw_rtsp_client_destroy(client);
+	spa_assert_se(destroy_count == 1);
+	pw_main_loop_destroy(main_loop);
+}
+
+int main(int argc, char *argv[])
+{
+	pw_init(&argc, &argv);
+	test_control();
+	test_soft_policy();
+	test_parser();
+	test_mapping();
+	test_stream_contract();
+	test_state();
+	test_request_coalescing();
+	test_device_id();
+	test_rtsp_reply_lifetime();
+	pw_deinit();
+	return 0;
+}
diff --git a/src/modules/module-raop/volume.c b/src/modules/module-raop/volume.c
new file mode 100644
index 0000000000000000000000000000000000000000..fd52c75b3e41085f128cd980cd3a14cbe8924fb7
--- /dev/null
+++ b/src/modules/module-raop/volume.c
@@ -0,0 +1,474 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <math.h>
+#include <string.h>
+
+#include <spa/utils/defs.h>
+#include <spa/utils/string.h>
+
+#include <pipewire/properties.h>
+
+#include "volume.h"
+
+#define VOLUME_MAX	0.0f
+#define VOLUME_MIN	-30.0f
+#define VOLUME_MUTE	-144.0f
+
+int raop_volume_control_parse(const char *str, enum raop_volume_control *control)
+{
+	if (str == NULL || spa_streq(str, "remote-optional"))
+		*control = RAOP_VOLUME_REMOTE_OPTIONAL;
+	else if (spa_streq(str, "remote-required"))
+		*control = RAOP_VOLUME_REMOTE_REQUIRED;
+	else if (spa_streq(str, "local"))
+		*control = RAOP_VOLUME_LOCAL;
+	else if (spa_streq(str, "software"))
+		*control = RAOP_VOLUME_SOFTWARE;
+	else if (spa_streq(str, "external"))
+		*control = RAOP_VOLUME_EXTERNAL;
+	else
+		return -EINVAL;
+	return 0;
+}
+
+const char *raop_volume_control_name(enum raop_volume_control control)
+{
+	switch (control) {
+	case RAOP_VOLUME_REMOTE_OPTIONAL:
+		return "remote-optional";
+	case RAOP_VOLUME_REMOTE_REQUIRED:
+		return "remote-required";
+	case RAOP_VOLUME_LOCAL:
+		return "local";
+	case RAOP_VOLUME_SOFTWARE:
+		return "software";
+	case RAOP_VOLUME_EXTERNAL:
+		return "external";
+	default:
+		return NULL;
+	}
+}
+
+enum raop_volume_failure_action raop_volume_failure_action(
+		enum raop_volume_control control)
+{
+	switch (control) {
+	case RAOP_VOLUME_REMOTE_OPTIONAL:
+		return RAOP_VOLUME_FAILURE_SOFTWARE;
+	case RAOP_VOLUME_REMOTE_REQUIRED:
+		return RAOP_VOLUME_FAILURE_ERROR;
+	case RAOP_VOLUME_LOCAL:
+	case RAOP_VOLUME_SOFTWARE:
+	case RAOP_VOLUME_EXTERNAL:
+	default:
+		return RAOP_VOLUME_FAILURE_IGNORE;
+	}
+}
+
+bool raop_volume_uses_soft_volumes(enum raop_volume_control control,
+		bool session_software)
+{
+	return control != RAOP_VOLUME_EXTERNAL &&
+		(control == RAOP_VOLUME_SOFTWARE || session_software);
+}
+
+bool raop_volume_needs_soft_mute_update(enum raop_volume_control control,
+		bool have_volume, bool have_mute)
+{
+	return have_mute ||
+		(control == RAOP_VOLUME_EXTERNAL && have_volume);
+}
+
+bool raop_volume_soft_mute(enum raop_volume_control control,
+		bool software, bool mute)
+{
+	return mute && (software || control == RAOP_VOLUME_EXTERNAL);
+}
+
+int raop_volume_parse_reply(const void *data, size_t size, float *volume, bool *mute)
+{
+	char buffer[256], *p, *end;
+	float value;
+
+	if (data == NULL || volume == NULL || mute == NULL ||
+			size == 0 || size >= sizeof(buffer) ||
+			memchr(data, '\0', size) != NULL)
+		return -EPROTO;
+
+	memcpy(buffer, data, size);
+	buffer[size] = '\0';
+	p = buffer;
+
+	while (isspace((unsigned char)*p))
+		p++;
+	if (!spa_strstartswith(p, "volume"))
+		return -EPROTO;
+	p += strlen("volume");
+	while (*p == ' ' || *p == '\t')
+		p++;
+	if (*p++ != ':')
+		return -EPROTO;
+	while (*p == ' ' || *p == '\t')
+		p++;
+
+	errno = 0;
+	value = spa_strtof(p, &end);
+	if (errno != 0 || end == p || !isfinite(value))
+		return -EPROTO;
+	while (isspace((unsigned char)*end))
+		end++;
+	if (*end != '\0')
+		return -EPROTO;
+
+	if (value == VOLUME_MUTE) {
+		*mute = true;
+		*volume = value;
+	} else if (value >= VOLUME_MIN && value <= VOLUME_MAX) {
+		*mute = false;
+		*volume = value;
+	} else {
+		return -ERANGE;
+	}
+	return 0;
+}
+
+int raop_volume_validate_channels(const float *volumes, uint32_t n_volumes,
+		float *average)
+{
+	double value = 0.0;
+	uint32_t i;
+
+	if (volumes == NULL || n_volumes == 0)
+		return -EINVAL;
+	for (i = 0; i < n_volumes; i++) {
+		if (!isfinite(volumes[i]) ||
+				volumes[i] < 0.0f || volumes[i] > 1.0f)
+			return -ERANGE;
+		value += (double)volumes[i];
+	}
+	if (average != NULL) {
+		float result = (float)(value / n_volumes);
+
+		/* Do not let rounding make a mixed near-full-scale channel set
+		 * indistinguishable from exact full scale. */
+		if (result == 1.0f && value < (double)n_volumes)
+			result = nextafterf(1.0f, 0.0f);
+		*average = result;
+	}
+	return 0;
+}
+
+float raop_volume_from_channel(float volume)
+{
+	if (!isfinite(volume) || volume < 0.0f || volume > 1.0f)
+		return NAN;
+	if (volume == 1.0f)
+		return VOLUME_MAX;
+	return (float)(cbrt((double)volume) * 30.0 - 30.0);
+}
+
+float raop_volume_to_channel(float volume)
+{
+	float normalized;
+
+	normalized = SPA_CLAMPF((volume - VOLUME_MIN) /
+			(VOLUME_MAX - VOLUME_MIN), 0.0f, 1.0f);
+	return normalized * normalized * normalized;
+}
+
+int raop_volume_override_stream_props(struct pw_properties *stream_props,
+		const struct pw_properties *module_props)
+{
+	static const char *const keys[] = {
+		"raop.volume.contract",
+		"raop.volume.control",
+		"raop.device",
+		"raop.ip",
+		"raop.port",
+	};
+	uint32_t i;
+
+	if (stream_props == NULL || module_props == NULL)
+		return -EINVAL;
+
+	for (i = 0; i < SPA_N_ELEMENTS(keys); i++) {
+		int res = pw_properties_set(stream_props, keys[i],
+				pw_properties_get(module_props, keys[i]));
+		if (res < 0)
+			return res;
+	}
+	return 0;
+}
+
+void raop_volume_state_sync(struct raop_volume_state *state,
+		float volume, bool mute, bool baseline)
+{
+	/*
+	 * Generic RAOP streams can expose a default volume before the receiver
+	 * query completes. Permanently guard an initial value that is louder
+	 * than the receiver baseline: module self-writes have no callback that
+	 * could otherwise provide a trustworthy retirement barrier.
+	 */
+	if (baseline && state->initial_volume_valid &&
+			state->initial_volume - volume >= 0.000001f) {
+		state->unsafe_initial_volume = state->initial_volume;
+		state->unsafe_initial_volume_valid = true;
+	}
+	state->sync_volume_pending = true;
+	state->sync_mute_pending = true;
+	state->sync_volume = volume;
+	state->sync_mute = mute;
+	if (baseline)
+		state->baseline_applied = true;
+}
+
+bool raop_volume_state_mark_initial_props_installed(
+		struct raop_volume_state *state, float volume, bool mute)
+{
+	if (state == NULL || !state->baseline_applied ||
+			!state->sync_volume_pending || !state->sync_mute_pending ||
+			volume != state->sync_volume || mute != state->sync_mute)
+		return false;
+
+	state->volume_props_seen = true;
+	state->mute_props_seen = true;
+	return true;
+}
+
+enum raop_volume_props_result raop_volume_state_on_props(
+		struct raop_volume_state *state,
+		bool have_volume, float volume, bool have_mute, bool mute,
+		float current_volume, bool current_mute,
+		bool volume_changed, bool mute_changed)
+{
+	bool initial, initial_volume, initial_mute, echo, stale, stale_duplicate;
+	bool full_sync_echo;
+	bool sync_volume, sync_mute, stale_volume, stale_mute;
+	bool stale_volume_match, stale_mute_match;
+	bool current_volume_match, current_mute_match;
+	bool stale_volume_conflict, stale_mute_conflict;
+	bool unsafe_initial_volume_conflict;
+
+	sync_volume = have_volume && state->sync_volume_pending &&
+		fabsf(volume - state->sync_volume) < 0.000001f;
+	sync_mute = have_mute && state->sync_mute_pending &&
+		mute == state->sync_mute;
+	stale_volume_match = have_volume &&
+			fabsf(volume - state->stale_volume) < 0.000001f;
+	stale_mute_match = have_mute && mute == state->stale_mute;
+	stale_volume = state->stale_volume_pending && stale_volume_match;
+	stale_mute = state->stale_mute_pending && stale_mute_match;
+	current_volume_match = have_volume &&
+		fabsf(volume - current_volume) < 0.000001f;
+	current_mute_match = have_mute && mute == current_mute;
+	unsafe_initial_volume_conflict =
+		state->unsafe_initial_volume_valid && have_volume &&
+		fabsf(volume - state->unsafe_initial_volume) < 0.000001f &&
+		!current_volume_match;
+	stale_volume_conflict = state->stale_valid && stale_volume_match &&
+		!current_volume_match;
+	stale_mute_conflict = state->stale_valid && stale_mute_match &&
+		!current_mute_match;
+	echo = (have_volume || have_mute) &&
+		(!have_volume || sync_volume) &&
+		(!have_mute || sync_mute);
+	full_sync_echo = have_volume && have_mute && sync_volume && sync_mute;
+	stale_duplicate = state->stale_valid && (have_volume || have_mute) &&
+		(!have_volume || stale_volume_match) &&
+		(!have_mute || stale_mute_match);
+	stale = stale_duplicate || ((stale_volume || stale_mute) &&
+		(!have_volume || stale_volume_match || sync_volume ||
+		 current_volume_match) &&
+		(!have_mute || stale_mute_match || sync_mute ||
+		 current_mute_match));
+	initial_volume = have_volume && !state->volume_props_seen;
+	initial_mute = have_mute && !state->mute_props_seen;
+	initial = initial_volume || initial_mute;
+	if (initial_volume && !state->baseline_applied) {
+		state->initial_volume = volume;
+		state->initial_volume_valid = true;
+	}
+	if (have_volume)
+		state->volume_props_seen = true;
+	if (have_mute)
+		state->mute_props_seen = true;
+
+	if (initial && state->baseline_applied && !echo &&
+			((have_volume &&
+			  fabsf(volume - current_volume) >= 0.000001f) ||
+			 (have_mute && mute != current_mute))) {
+		/*
+		 * Quarantine the rejected tuple until the safe baseline has been
+		 * echoed. A default Props object can be delivered more than once.
+		 */
+		if (have_volume &&
+				volume - current_volume >= 0.000001f) {
+			state->unsafe_initial_volume = volume;
+			state->unsafe_initial_volume_valid = true;
+		}
+		state->stale_volume = have_volume ? volume : current_volume;
+		state->stale_mute = have_mute ? mute : current_mute;
+		state->stale_volume_pending = have_volume;
+		state->stale_mute_pending = have_mute;
+		state->stale_valid = true;
+		return RAOP_VOLUME_PROPS_REASSERT;
+	}
+
+	if (echo) {
+		/*
+		 * While an older tuple is quarantined, partial echoes cannot prove
+		 * ordering: an unchanged field from the stale tuple can alias the
+		 * newer tuple. Require both newer fields in one event.
+		 */
+		if (state->stale_valid && !full_sync_echo)
+			return RAOP_VOLUME_PROPS_ECHO;
+		if (have_volume) {
+			state->sync_volume_pending = false;
+			if (stale_volume)
+				state->stale_volume_pending = false;
+		}
+		if (have_mute) {
+			state->sync_mute_pending = false;
+			if (stale_mute)
+				state->stale_mute_pending = false;
+		}
+		/*
+		 * A complete echo is the bounded retirement signal for this rolling
+		 * transaction quarantine. The louder initial-volume guard has
+		 * stream lifetime because generic module self-writes do not echo.
+		 */
+		if (state->stale_valid && full_sync_echo) {
+			state->stale_valid = false;
+			state->stale_volume_pending = false;
+			state->stale_mute_pending = false;
+		}
+		return RAOP_VOLUME_PROPS_ECHO;
+	}
+	if (stale) {
+		if (stale_volume)
+			state->stale_volume_pending = false;
+		if (stale_mute)
+			state->stale_mute_pending = false;
+		return RAOP_VOLUME_PROPS_STALE;
+	}
+	volume_changed = volume_changed && !initial_volume;
+	mute_changed = mute_changed && !initial_mute;
+	if ((volume_changed || mute_changed) &&
+			unsafe_initial_volume_conflict)
+		return RAOP_VOLUME_PROPS_REASSERT;
+	/*
+	 * A single stale slot and one current sync can coexist after a partial
+	 * stale event is reasserted. Do not overwrite either authored tuple with
+	 * another user candidate; restore the current tuple and let the client
+	 * retry after the stale fragment has drained.
+	 */
+	if ((volume_changed || mute_changed) &&
+	    state->stale_valid &&
+	    (state->sync_volume_pending || state->sync_mute_pending))
+		return RAOP_VOLUME_PROPS_REASSERT;
+	/*
+	 * A client can merge a newly changed field with another field from its
+	 * stale cache. Reject the whole tuple when that would restore any stale
+	 * component over the current value.
+	 */
+	if ((volume_changed || mute_changed) &&
+	    (stale_volume_conflict || stale_mute_conflict))
+		return RAOP_VOLUME_PROPS_REASSERT;
+	if (volume_changed || mute_changed) {
+		/*
+		 * An authored volume/mute update is one tuple even when PipeWire
+		 * reports its fields separately. If user intent overtakes any
+		 * remaining field, preserve the complete authored tuple as stale
+		 * context before a later sync can replace it.
+		 */
+		if (state->sync_volume_pending || state->sync_mute_pending) {
+			state->stale_volume = state->sync_volume;
+			state->stale_mute = state->sync_mute;
+			state->stale_volume_pending =
+				state->sync_volume_pending;
+			state->stale_mute_pending = state->sync_mute_pending;
+			state->stale_valid = true;
+			state->sync_volume_pending = false;
+			state->sync_mute_pending = false;
+		}
+		state->generation++;
+		if (volume_changed)
+			state->volume_generation++;
+		if (mute_changed)
+			state->mute_generation++;
+		return RAOP_VOLUME_PROPS_USER;
+	}
+	if (initial)
+		return RAOP_VOLUME_PROPS_INITIAL;
+	return RAOP_VOLUME_PROPS_UNCHANGED;
+}
+
+bool raop_volume_request_begin(struct raop_volume_request_state *state,
+		uint32_t generation, uint32_t *epoch)
+{
+	if (state->pending)
+		return false;
+	if (++state->epoch == 0)
+		state->epoch++;
+	state->pending = true;
+	state->generation = generation;
+	if (epoch != NULL)
+		*epoch = state->epoch;
+	return true;
+}
+
+enum raop_volume_request_result raop_volume_request_reply(
+		struct raop_volume_request_state *state,
+		uint32_t epoch, uint32_t generation, int status)
+{
+	if (!state->pending || state->epoch != epoch)
+		return RAOP_VOLUME_REQUEST_STALE;
+	state->pending = false;
+	if (status < 200 || status >= 300)
+		return RAOP_VOLUME_REQUEST_FAILED;
+	if (state->generation != generation)
+		return RAOP_VOLUME_REQUEST_NEWER;
+	return RAOP_VOLUME_REQUEST_SUCCESS;
+}
+
+enum raop_volume_request_result raop_volume_request_timeout(
+		struct raop_volume_request_state *state, uint32_t epoch)
+{
+	if (!state->pending || state->epoch != epoch)
+		return RAOP_VOLUME_REQUEST_STALE;
+	state->pending = false;
+	return RAOP_VOLUME_REQUEST_TIMEOUT;
+}
+
+bool raop_volume_request_cancel(struct raop_volume_request_state *state,
+		uint32_t epoch)
+{
+	if (!state->pending || state->epoch != epoch)
+		return false;
+	state->pending = false;
+	return true;
+}
+
+int raop_parse_device_id(const char *name, char device[13])
+{
+	const char *at;
+	size_t i;
+
+	if (name == NULL || (at = strchr(name, '@')) == NULL ||
+			(size_t)(at - name) != 12)
+		return -EINVAL;
+
+	for (i = 0; i < 12; i++) {
+		if (!isxdigit((unsigned char)name[i]))
+			return -EINVAL;
+		device[i] = toupper((unsigned char)name[i]);
+	}
+	device[12] = '\0';
+	return 0;
+}
diff --git a/src/modules/module-raop/volume.h b/src/modules/module-raop/volume.h
new file mode 100644
index 0000000000000000000000000000000000000000..2d40b035d13d99984d362bd6a6e6093af34cbfa4
--- /dev/null
+++ b/src/modules/module-raop/volume.h
@@ -0,0 +1,118 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PIPEWIRE_MODULE_RAOP_VOLUME_H
+#define PIPEWIRE_MODULE_RAOP_VOLUME_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct pw_properties;
+
+#define RAOP_VOLUME_CONTRACT	"2"
+
+enum raop_volume_control {
+	RAOP_VOLUME_REMOTE_OPTIONAL,
+	RAOP_VOLUME_REMOTE_REQUIRED,
+	RAOP_VOLUME_LOCAL,
+	RAOP_VOLUME_SOFTWARE,
+	RAOP_VOLUME_EXTERNAL,
+};
+
+enum raop_volume_props_result {
+	RAOP_VOLUME_PROPS_UNCHANGED,
+	RAOP_VOLUME_PROPS_INITIAL,
+	RAOP_VOLUME_PROPS_ECHO,
+	RAOP_VOLUME_PROPS_USER,
+	RAOP_VOLUME_PROPS_REASSERT,
+	RAOP_VOLUME_PROPS_STALE,
+};
+
+enum raop_volume_request_result {
+	RAOP_VOLUME_REQUEST_STALE,
+	RAOP_VOLUME_REQUEST_SUCCESS,
+	RAOP_VOLUME_REQUEST_NEWER,
+	RAOP_VOLUME_REQUEST_FAILED,
+	RAOP_VOLUME_REQUEST_TIMEOUT,
+};
+
+enum raop_volume_failure_action {
+	RAOP_VOLUME_FAILURE_IGNORE,
+	RAOP_VOLUME_FAILURE_SOFTWARE,
+	RAOP_VOLUME_FAILURE_ERROR,
+};
+
+struct raop_volume_state {
+	uint32_t generation;
+	uint32_t volume_generation;
+	uint32_t mute_generation;
+	bool volume_props_seen;
+	bool mute_props_seen;
+	bool baseline_applied;
+	bool initial_volume_valid;
+	bool unsafe_initial_volume_valid;
+	bool sync_volume_pending;
+	bool sync_mute_pending;
+	bool stale_volume_pending;
+	bool stale_mute_pending;
+	bool stale_valid;
+	bool sync_mute;
+	bool stale_mute;
+	float initial_volume;
+	float unsafe_initial_volume;
+	float sync_volume;
+	float stale_volume;
+};
+
+struct raop_volume_request_state {
+	uint32_t generation;
+	uint32_t epoch;
+	bool pending;
+};
+
+int raop_volume_control_parse(const char *str, enum raop_volume_control *control);
+const char *raop_volume_control_name(enum raop_volume_control control);
+enum raop_volume_failure_action raop_volume_failure_action(
+		enum raop_volume_control control);
+bool raop_volume_uses_soft_volumes(enum raop_volume_control control,
+		bool session_software);
+bool raop_volume_needs_soft_mute_update(enum raop_volume_control control,
+		bool have_volume, bool have_mute);
+bool raop_volume_soft_mute(enum raop_volume_control control,
+		bool software, bool mute);
+
