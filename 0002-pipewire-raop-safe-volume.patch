+static void test_request_coalescing(void)
+{
+	struct raop_volume_request_state state = { 0 };
+	struct raop_volume_request_state query = { 0 };
+	struct raop_volume_request_state record = { 0 };
+	struct {
+		uint32_t epoch;
+	} old_context, new_context;
+	uint32_t epoch1, epoch2, epoch3, epoch4, old_query, new_query;
+
+	/* A successful reply for the latest generation releases the request. */
+	spa_assert_se(raop_volume_request_begin(&state, 4, &epoch1));
+	spa_assert_se(!raop_volume_request_begin(&state, 5, NULL));
+	spa_assert_se(raop_volume_request_reply(&state,
+			epoch1, 4, 200) == RAOP_VOLUME_REQUEST_SUCCESS);
+	spa_assert_se(!state.pending);
+
+	/* A newer coalesced generation requires one more SET before startup can
+	 * release audio. */
+	spa_assert_se(raop_volume_request_begin(&state, 5, &epoch2));
+	spa_assert_se(raop_volume_request_reply(&state,
+			epoch2, 6, 204) == RAOP_VOLUME_REQUEST_NEWER);
+
+	/* A non-2xx result is an explicit failure. */
+	spa_assert_se(raop_volume_request_begin(&state, 6, &epoch3));
+	spa_assert_se(raop_volume_request_reply(&state,
+			epoch3, 6, 500) == RAOP_VOLUME_REQUEST_FAILED);
+
+	/* Timeout invalidates the epoch. A late reply is ignored and cannot
+	 * consume a newer request. */
+	spa_assert_se(raop_volume_request_begin(&state, 6, &epoch3));
+	spa_assert_se(raop_volume_request_timeout(&state,
+			epoch3) == RAOP_VOLUME_REQUEST_TIMEOUT);
+	spa_assert_se(raop_volume_request_reply(&state,
+			epoch3, 6, 200) == RAOP_VOLUME_REQUEST_STALE);
+	old_context.epoch = epoch3;
+	spa_assert_se(raop_volume_request_begin(&state, 7, &epoch4));
+	new_context.epoch = epoch4;
+	spa_assert_se(raop_volume_request_reply(&state,
+			old_context.epoch, 7, 200) == RAOP_VOLUME_REQUEST_STALE);
+	spa_assert_se(state.pending);
+	spa_assert_se(raop_volume_request_reply(&state,
+			new_context.epoch, 7, 200) == RAOP_VOLUME_REQUEST_SUCCESS);
+
+	/* Local mode uses the same managed SET state. A lost reply clears the
+	 * pending epoch so the latest coalesced generation can be resent. */
+	memset(&state, 0, sizeof(state));
+	spa_assert_se(raop_volume_request_begin(&state, 10, &epoch1));
+	spa_assert_se(raop_volume_request_timeout(&state,
+			epoch1) == RAOP_VOLUME_REQUEST_TIMEOUT);
+	spa_assert_se(!state.pending);
+	spa_assert_se(raop_volume_request_begin(&state, 11, &epoch2));
+	spa_assert_se(state.generation == 11);
+
+	/* GET_PARAMETER owns a distinct epoch. A reply retained by an old RTSP
+	 * session cannot satisfy the next session's query. */
+	spa_assert_se(raop_volume_request_begin(&query, 0, &old_query));
+	spa_assert_se(raop_volume_request_cancel(&query, old_query));
+	spa_assert_se(raop_volume_request_begin(&query, 0, &new_query));
+	spa_assert_se(raop_volume_request_reply(&query,
+			old_query, 0, 200) == RAOP_VOLUME_REQUEST_STALE);
+	spa_assert_se(query.pending);
+	spa_assert_se(raop_volume_request_reply(&query,
+			new_query, 0, 200) == RAOP_VOLUME_REQUEST_SUCCESS);
+
+	/* RECORD snapshots the physical generation. A Props change while its
+	 * reply is queued requires another SET, not immediate packet release. */
+	spa_assert_se(raop_volume_request_begin(&record, 20, &epoch1));
+	spa_assert_se(raop_volume_request_reply(&record,
+			epoch1, 21, 200) == RAOP_VOLUME_REQUEST_NEWER);
+}
