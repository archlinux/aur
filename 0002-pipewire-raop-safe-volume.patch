+static void test_mapping(void)
+{
+	static const float channels[] = { 0.0f, 0.001f, 0.125f, 0.5f, 1.0f };
+	static const float stereo[] = { 0.125f, 0.216f };
+	float invalid[2], near_full[2], average, below_full, mapped, serialized;
+	char text[64];
+	uint32_t i;
+
+	spa_assert_se(fabsf(raop_volume_from_channel(0.0f) - -30.0f) <
+			0.000001f);
+	spa_assert_se(fabsf(raop_volume_from_channel(0.125f) - -15.0f) <
+			0.000001f);
+	spa_assert_se(fabsf(raop_volume_from_channel(1.0f)) < 0.000001f);
+	spa_assert_se(fabsf(raop_volume_to_channel(-15.0f) - 0.125f) <
+			0.000001f);
+	spa_assert_se(fabsf(raop_volume_to_channel(
+			0.15f * 30.0f - 30.0f) - 0.003375f) < 0.000001f);
+
+	below_full = nextafterf(1.0f, 0.0f);
+	mapped = raop_volume_from_channel(below_full);
+	spa_assert_se(mapped < 0.0f);
+	spa_assert_se(spa_atof(spa_dtoa(text, sizeof(text), mapped),
+			&serialized));
+	spa_assert_se(serialized < 0.0f);
+	spa_assert_se(spa_streq(spa_dtoa(text, sizeof(text),
+			raop_volume_from_channel(1.0f)), "0.000000"));
+
+	near_full[0] = 1.0f;
+	near_full[1] = below_full;
+	spa_assert_se(raop_volume_validate_channels(near_full,
+			SPA_N_ELEMENTS(near_full), &average) == 0);
+	spa_assert_se(average < 1.0f);
+	mapped = raop_volume_from_channel(average);
+	spa_assert_se(mapped < 0.0f);
+	spa_assert_se(spa_atof(spa_dtoa(text, sizeof(text), mapped),
+			&serialized));
+	spa_assert_se(serialized < 0.0f);
+
+	for (i = 0; i < SPA_N_ELEMENTS(channels); i++)
+		spa_assert_se(fabsf(raop_volume_to_channel(
+				raop_volume_from_channel(channels[i])) -
+				channels[i]) < 0.000001f);
+
+	spa_assert_se(raop_volume_validate_channels(stereo,
+			SPA_N_ELEMENTS(stereo), &average) == 0);
+	spa_assert_se(fabsf(average - 0.1705f) < 0.000001f);
+	spa_assert_se(raop_volume_validate_channels(NULL, 1, NULL) == -EINVAL);
+	spa_assert_se(raop_volume_validate_channels(stereo, 0, NULL) == -EINVAL);
+
+	memcpy(invalid, stereo, sizeof(invalid));
+	invalid[1] = NAN;
+	spa_assert_se(raop_volume_validate_channels(invalid, 2, NULL) == -ERANGE);
+	invalid[1] = INFINITY;
+	spa_assert_se(raop_volume_validate_channels(invalid, 2, NULL) == -ERANGE);
+	invalid[1] = -0.0001f;
+	spa_assert_se(raop_volume_validate_channels(invalid, 2, NULL) == -ERANGE);
+	invalid[1] = 1.0001f;
+	spa_assert_se(raop_volume_validate_channels(invalid, 2, NULL) == -ERANGE);
+	spa_assert_se(isnan(raop_volume_from_channel(NAN)));
+	spa_assert_se(isnan(raop_volume_from_channel(INFINITY)));
+	spa_assert_se(isnan(raop_volume_from_channel(-0.0001f)));
+	spa_assert_se(isnan(raop_volume_from_channel(1.0001f)));
+}
