+static void test_stream_contract(void)
+{
+	struct pw_properties *module_props, *stream_props;
+
+	spa_assert_se(spa_streq(RAOP_VOLUME_CONTRACT, "2"));
+	module_props = pw_properties_new(
+			"raop.volume.contract", RAOP_VOLUME_CONTRACT,
+			"raop.volume.control", "external",
+			"raop.device", "02000000A001",
+			"raop.ip", "192.0.2.10",
+			"raop.port", "7000",
+			NULL);
+	stream_props = pw_properties_new(
+			"raop.volume.contract", "forged",
+			"raop.volume.control", "remote-required",
+			"raop.device", "000000000000",
+			"raop.ip", "203.0.113.1",
+			"raop.port", "1",
+			"raop.name", "nested name remains",
+			NULL);
+	spa_assert_se(module_props != NULL);
+	spa_assert_se(stream_props != NULL);
+	spa_assert_se(raop_volume_override_stream_props(stream_props,
+			module_props) == 0);
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.volume.contract"), RAOP_VOLUME_CONTRACT));
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.volume.control"), "external"));
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.device"), "02000000A001"));
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.ip"), "192.0.2.10"));
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.port"), "7000"));
+	spa_assert_se(spa_streq(pw_properties_get(stream_props,
+			"raop.name"), "nested name remains"));
+
+	/* A missing module identity value removes, rather than trusts, a value
+	 * injected through nested stream.props. */
+	pw_properties_set(module_props, "raop.device", NULL);
+	spa_assert_se(raop_volume_override_stream_props(stream_props,
+			module_props) == 0);
+	spa_assert_se(pw_properties_get(stream_props, "raop.device") == NULL);
+
+	pw_properties_free(stream_props);
+	pw_properties_free(module_props);
+}
