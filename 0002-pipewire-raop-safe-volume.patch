+static void test_state(void)
+{
+	struct raop_volume_state state = { 0 };
+	enum raop_volume_props_result result;
+	const float remote = raop_volume_to_channel(-15.0f);
+	uint32_t query_volume_generation, query_mute_generation;
+	float merged_volume;
+
+	/* Normal ordering: initial node props, RECORD/query, receiver echo,
+	 * then a real user request. */
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, 0.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	spa_assert_se(state.generation == 0);
+	raop_volume_state_sync(&state, remote, false, true);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 1.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(state.generation == 0);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.volume_generation == 1);
+	spa_assert_se(state.mute_generation == 0);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.unsafe_initial_volume_valid);
+
+	/* A volume-only startup default is guarded in the same way. */
+	memset(&state, 0, sizeof(state));
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, false, false, 0.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	raop_volume_state_sync(&state, remote, false, true);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, remote, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, false, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 0);
+
+	/* An initial value equal to the receiver baseline is not guarded. */
+	memset(&state, 0, sizeof(state));
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	raop_volume_state_sync(&state, remote, false, true);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, remote, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.unsafe_initial_volume_valid);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 2);
+
+	/* A user request can overtake the echo of a module-authored baseline.
+	 * The delayed old echo must not overwrite or resend the user request. */
+	memset(&state, 0, sizeof(state));
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, 0.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	raop_volume_state_sync(&state, remote, false, true);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+
+	/* A volume-only baseline echo can be followed by volume-only user intent
+	 * while the authored mute is still pending. The delayed full baseline must
+	 * match the saved tuple context instead of becoming a second user request. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, true, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	result = raop_volume_state_on_props(&state,
+			true, remote, false, false, remote, true, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, false, false, remote, true, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	raop_volume_state_sync(&state, 0.343f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, true, 0.343f, false, true, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			true, 0.343f, true, false, 0.343f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+
+	/* Mirror the transaction: a mute-only baseline echo, then mute-only user
+	 * intent, must retain the authored volume as the stale-event trigger. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, false, remote, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(!state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, true, remote, false, false, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, remote, true, false, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+
+	/* A partial stale event is reasserted as a new sync. Defer a third user
+	 * tuple instead of overwriting either authored history slot; after the
+	 * remaining stale fragment drains, the same user tuple can be accepted. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, true, remote, false, true, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	result = raop_volume_state_on_props(&state,
+			true, remote, false, false, 0.216f, true, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(!state.stale_volume_pending);
+	spa_assert_se(state.stale_mute_pending);
+	raop_volume_state_sync(&state, 0.216f, true, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.343f, false, false, 0.216f, true, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.stale_mute_pending);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, false, 0.216f, true, false, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(!state.stale_mute_pending);
+	raop_volume_state_sync(&state, 0.216f, true, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, true, 0.216f, true, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.stale_valid);
+	result = raop_volume_state_on_props(&state,
+			true, 0.343f, false, false, 0.216f, true, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 2);
+
+	/* More than one delayed copy of an authored tuple can be observed. The
+	 * unchanged mute aliases both tuples and must not consume the newer sync.
+	 * Keep suppressing duplicates until the complete newer tuple retires this
+	 * rolling quarantine; a later return can then be treated as user intent. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.stale_valid);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.stale_valid);
+	spa_assert_se(!state.stale_volume_pending);
+	spa_assert_se(!state.stale_mute_pending);
+	raop_volume_state_sync(&state, 0.216f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.stale_valid);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	raop_volume_state_sync(&state, 0.216f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, 0.216f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.stale_valid);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 2);
+
+	/* Partial echoes cannot form the ordering barrier: an unchanged mute
+	 * aliases old and new tuples. Keep the quarantine until V1/M0 arrive
+	 * together, so a later V0 fragment remains stale. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	raop_volume_state_sync(&state, 0.216f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, false, false, 0.216f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, false, 0.216f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(state.stale_valid);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			true, remote, false, false, 0.216f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+	raop_volume_state_sync(&state, 0.216f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, 0.216f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.stale_valid);
+
+	/* A new mute value can arrive alongside a volume copied from stale
+	 * client state. Defer the mixed tuple instead of restoring that volume. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, true, 0.216f, false, true, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 1);
+	raop_volume_state_sync(&state, 0.216f, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, 0.216f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, true, 0.216f, false, false, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 2);
+
+	/* Reordered delivery: a receiver baseline is installed before the node's
+	 * delayed default Props. The default must be rejected, not treated as a
+	 * request for maximum receiver volume. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, false, true);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 0);
+	spa_assert_se(state.stale_valid);
+	raop_volume_state_sync(&state, remote, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 0);
+	spa_assert_se(state.stale_valid);
+	raop_volume_state_sync(&state, remote, false, false);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, false, remote, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(state.generation == 0);
+	spa_assert_se(!state.stale_valid);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, true, false, remote, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_REASSERT);
+	spa_assert_se(state.generation == 0);
+	spa_assert_se(state.unsafe_initial_volume_valid);
+
+	/* External mode installs its initial Props directly at stream creation.
+	 * Account for those exact Props without consuming the pending baseline:
+	 * a first differing tuple is a user request and a delayed baseline copy
+	 * remains stale. */
+	memset(&state, 0, sizeof(state));
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	raop_volume_state_sync(&state, remote, true, false);
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, true, true);
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, nextafterf(remote, 1.0f), true));
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, remote, false));
+	state.sync_mute_pending = false;
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	state.sync_mute_pending = true;
+	state.sync_volume_pending = false;
+	spa_assert_se(!raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	state.sync_volume_pending = true;
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	spa_assert_se(state.volume_props_seen);
+	spa_assert_se(state.mute_props_seen);
+	spa_assert_se(state.sync_volume_pending);
+	spa_assert_se(state.sync_mute_pending);
+	result = raop_volume_state_on_props(&state,
+			true, 0.216f, true, false, remote, true, true, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.generation == 1);
+	spa_assert_se(state.volume_generation == 1);
+	spa_assert_se(state.mute_generation == 1);
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, true, 0.216f, false, true, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_STALE);
+	spa_assert_se(state.generation == 1);
+
+	/* If the matching baseline is delivered first, it remains an echo. */
+	memset(&state, 0, sizeof(state));
+	raop_volume_state_sync(&state, remote, true, true);
+	spa_assert_se(raop_volume_state_mark_initial_props_installed(
+			&state, remote, true));
+	result = raop_volume_state_on_props(&state,
+			true, remote, true, true, remote, true, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_ECHO);
+	spa_assert_se(!state.sync_volume_pending);
+	spa_assert_se(!state.sync_mute_pending);
+
+	/* Mute and volume can arrive in separate initial events. */
+	memset(&state, 0, sizeof(state));
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, false, 0.0f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	result = raop_volume_state_on_props(&state,
+			true, 1.0f, false, false, 0.0f, false, true, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	spa_assert_se(state.generation == 0);
+
+	/* A mute-only request while GET_PARAMETER is pending must not create a
+	 * volume intent. The reply's receiver volume remains authoritative even
+	 * if no channelVolumes event has arrived. */
+	memset(&state, 0, sizeof(state));
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, false, 0.0f, false, false, false);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_INITIAL);
+	query_volume_generation = state.volume_generation;
+	query_mute_generation = state.mute_generation;
+	result = raop_volume_state_on_props(&state,
+			false, 0.0f, true, true, 0.0f, false, false, true);
+	spa_assert_se(result == RAOP_VOLUME_PROPS_USER);
+	spa_assert_se(state.volume_generation == 0);
+	spa_assert_se(state.mute_generation == 1);
+	merged_volume = state.volume_generation != query_volume_generation ?
+		1.0f : remote;
+	spa_assert_se(fabsf(merged_volume - remote) < 0.000001f);
+	spa_assert_se(state.mute_generation != query_mute_generation);
+}
