+static void test_control(void)
+{
+	enum raop_volume_control control;
+
+	spa_assert_se(raop_volume_control_parse(NULL, &control) == 0);
+	spa_assert_se(control == RAOP_VOLUME_REMOTE_OPTIONAL);
+	spa_assert_se(raop_volume_control_parse("remote-required", &control) == 0);
+	spa_assert_se(control == RAOP_VOLUME_REMOTE_REQUIRED);
+	spa_assert_se(raop_volume_control_parse("local", &control) == 0);
+	spa_assert_se(control == RAOP_VOLUME_LOCAL);
+	spa_assert_se(raop_volume_control_parse("software", &control) == 0);
+	spa_assert_se(control == RAOP_VOLUME_SOFTWARE);
+	spa_assert_se(raop_volume_control_parse("external", &control) == 0);
+	spa_assert_se(control == RAOP_VOLUME_EXTERNAL);
+	spa_assert_se(raop_volume_control_parse("invalid", &control) == -EINVAL);
+	spa_assert_se(spa_streq(raop_volume_control_name(
+			RAOP_VOLUME_REMOTE_OPTIONAL), "remote-optional"));
+	spa_assert_se(raop_volume_control_name(100) == NULL);
+	spa_assert_se(raop_volume_failure_action(
+			RAOP_VOLUME_REMOTE_OPTIONAL) ==
+			RAOP_VOLUME_FAILURE_SOFTWARE);
+	spa_assert_se(raop_volume_failure_action(
+			RAOP_VOLUME_REMOTE_REQUIRED) ==
+			RAOP_VOLUME_FAILURE_ERROR);
+	spa_assert_se(raop_volume_failure_action(RAOP_VOLUME_LOCAL) ==
+			RAOP_VOLUME_FAILURE_IGNORE);
+}
+
+static void test_soft_policy(void)
+{
+	/* Only explicit software mode or a per-session fallback scales audio. */
+	spa_assert_se(!raop_volume_uses_soft_volumes(
+			RAOP_VOLUME_REMOTE_OPTIONAL, false));
+	spa_assert_se(raop_volume_uses_soft_volumes(
+			RAOP_VOLUME_REMOTE_OPTIONAL, true));
+	spa_assert_se(raop_volume_uses_soft_volumes(
+			RAOP_VOLUME_SOFTWARE, false));
+	spa_assert_se(!raop_volume_uses_soft_volumes(
+			RAOP_VOLUME_EXTERNAL, false));
+	spa_assert_se(!raop_volume_uses_soft_volumes(
+			RAOP_VOLUME_EXTERNAL, true));
+
+	/* A volume-only external update must reassert the canonical mute. */
+	spa_assert_se(raop_volume_needs_soft_mute_update(
+			RAOP_VOLUME_EXTERNAL, true, false));
+	spa_assert_se(!raop_volume_needs_soft_mute_update(
+			RAOP_VOLUME_REMOTE_OPTIONAL, true, false));
+	spa_assert_se(raop_volume_needs_soft_mute_update(
+			RAOP_VOLUME_REMOTE_OPTIONAL, false, true));
+	spa_assert_se(!raop_volume_needs_soft_mute_update(
+			RAOP_VOLUME_EXTERNAL, false, false));
+
+	/* External mute is a local safety gate despite unity soft volumes. */
+	spa_assert_se(!raop_volume_soft_mute(
+			RAOP_VOLUME_REMOTE_OPTIONAL, false, true));
+	spa_assert_se(raop_volume_soft_mute(
+			RAOP_VOLUME_REMOTE_OPTIONAL, true, true));
+	spa_assert_se(raop_volume_soft_mute(
+			RAOP_VOLUME_SOFTWARE, true, true));
+	spa_assert_se(raop_volume_soft_mute(
+			RAOP_VOLUME_EXTERNAL, false, true));
+	spa_assert_se(!raop_volume_soft_mute(
+			RAOP_VOLUME_EXTERNAL, false, false));
+}
+
+static void check_reply(const char *reply, float expected, bool expected_mute)
+{
+	float volume = 0.0f;
+	bool mute = false;
+
+	spa_assert_se(raop_volume_parse_reply(reply, strlen(reply),
+			&volume, &mute) == 0);
+	spa_assert_se(fabsf(volume - expected) < 0.000001f);
+	spa_assert_se(mute == expected_mute);
+}
+
+static void test_parser(void)
+{
+	static const char embedded_nul[] = "volume: -15\0junk";
+	float volume;
+	bool mute;
+
+	check_reply("volume: -30\r\n", -30.0f, false);
+	check_reply(" volume:\t-15.000000 \r\n", -15.0f, false);
+	check_reply("volume: 0", 0.0f, false);
+	check_reply("volume: -144.000000\r\n", -144.0f, true);
+
+	spa_assert_se(raop_volume_parse_reply(NULL, 0, &volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("volume: -15", 11,
+			NULL, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("volume: -15", 11,
+			&volume, NULL) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("", 0, &volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("vol: -15", 8,
+			&volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("volume: nan", 11,
+			&volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("volume: inf", 11,
+			&volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply("volume: -30.1", 13,
+			&volume, &mute) == -ERANGE);
+	spa_assert_se(raop_volume_parse_reply("volume: 0.1", 11,
+			&volume, &mute) == -ERANGE);
+	spa_assert_se(raop_volume_parse_reply("volume: -143", 12,
+			&volume, &mute) == -ERANGE);
+	spa_assert_se(raop_volume_parse_reply("volume: -15 extra", 17,
+			&volume, &mute) == -EPROTO);
+	spa_assert_se(raop_volume_parse_reply(embedded_nul,
+			sizeof(embedded_nul) - 1, &volume, &mute) == -EPROTO);
+}
