post_install() {
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
  echo "ufm-companion installed to /opt/ufm-companion/ufm-companion.AppImage"
  echo "Launch with: ufm-companion  (or from your app menu: Ultimate File Manager Pro Companion)"
}

post_upgrade() {
  post_install
}

post_remove() {
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -q -t -f usr/share/icons/hicolor 2>/dev/null || true
}
