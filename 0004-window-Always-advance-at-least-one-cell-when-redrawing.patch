From 6da59983f24b836200cabe7046ed0ad2302bd5f6 Mon Sep 17 00:00:00 2001
From: Hocking Lee <hockinglee@gmail.com>
Date: Sun, 4 Oct 2026 22:56:36 +0800
Subject: [PATCH] window: Always advance at least one cell when redrawing

mc_wclose() and mc_wredraw() walk the saved screen map using the width
returned by _write().  For a zero-width character stored in the map
(e.g. a control character such as XON 0x11 received from the serial
line as the last character of a line) _write() returns 0, so x and the
map pointer never advance and minicom spins forever writing that
character to the terminal.  The UI freezes, keyboard input (including
Ctrl-A Q) is never read and SIGTERM does not help.

Reproducer: receive "x\x11\r\n", then press Ctrl-A S, select xmodem
and leave the file selection window with ESC.
---
 src/window.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/window.c b/src/window.c
index af2184f..fb0e92b 100644
--- a/src/window.c
+++ b/src/window.c
@@ -625,12 +625,16 @@ void mc_wclose(WIN *win, int replace)
       g = gmap + (y * stdwin->xs);
       for (x = 0 ; x < win->x1;) {
         cwidth = _write(g->value, 1, x, y, g->attr, g->color);
+        if (cwidth < 1) /* zero-width char: still one cell */
+          cwidth = 1;
         x += cwidth;
         g += cwidth;
       }
       /* to here */
       for (x = win->x1; x <= win->x2;) {
         cwidth = _write(e->value, 1, x, y, e->attr, e->color);
+        if (cwidth < 1) /* zero-width char: still one cell */
+          cwidth = 1;
         x += cwidth;
         e += cwidth;
       }
@@ -739,6 +743,8 @@ void mc_wredraw(WIN *w, int newdirect)
   for (y = miny; y <= maxy; y++) {
     for(x = minx; x <= maxx; ) {
       cwidth = _write(e->value, -1, x, y, e->attr, e->color);
+      if (cwidth < 1) /* zero-width char: still one cell */
+        cwidth = 1;
       x += cwidth;
       e += cwidth;
     }
