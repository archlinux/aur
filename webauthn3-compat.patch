+++ b/app/webauthn_utils.py
@@ -0,0 +1,100 @@
+"""Translate the existing browser payload and stored base64url keys to WebAuthn 3."""
+
+import json
+
+from webauthn import (
+    generate_authentication_options,
+    generate_registration_options,
+    verify_authentication_response,
+    verify_registration_response,
+)
+from webauthn.helpers import base64url_to_bytes, bytes_to_base64url, options_to_json
+from webauthn.helpers.structs import (
+    AuthenticatorSelectionCriteria,
+    PublicKeyCredentialDescriptor,
+    UserVerificationRequirement,
+)
+
+
+def descriptors(fidos):
+    return [
+        PublicKeyCredentialDescriptor(id=base64url_to_bytes(f.credential_id))
+        for f in fidos
+    ]
+
+
+def authentication_options(fidos, challenge, rp_id, user_verification="discouraged"):
+    return json.loads(
+        options_to_json(
+            generate_authentication_options(
+                rp_id=rp_id,
+                challenge=base64url_to_bytes(challenge),
+                allow_credentials=descriptors(fidos),
+                user_verification=UserVerificationRequirement(user_verification),
+            )
+        )
+    )
+
+
+def registration_options(user, user_id, fidos, challenge, rp_id):
+    return json.loads(
+        options_to_json(
+            generate_registration_options(
+                rp_id=rp_id,
+                rp_name="SimpleLogin",
+                user_id=user_id.encode(),
+                user_name=user.email,
+                user_display_name=user.name or user.email,
+                challenge=base64url_to_bytes(challenge),
+                exclude_credentials=descriptors(fidos),
+                authenticator_selection=AuthenticatorSelectionCriteria(
+                    user_verification=UserVerificationRequirement.DISCOURAGED,
+                ),
+            )
+        )
+    )
+
+
+def verify_registration(payload, challenge, rp_id, origin):
+    credential = {
+        "id": payload["id"],
+        "rawId": payload["rawId"],
+        "type": payload["type"],
+        "response": {
+            "clientDataJSON": payload["clientData"],
+            "attestationObject": payload["attObj"],
+        },
+    }
+    return verify_registration_response(
+        credential=credential,
+        expected_challenge=base64url_to_bytes(challenge),
+        expected_rp_id=rp_id,
+        expected_origin=origin,
+        require_user_verification=False,
+    )
+
+
+def verify_authentication(payload, key, challenge, rp_id, origin):
+    if key is None:
+        raise ValueError("Unknown credential")
+    credential = {
+        "id": payload["id"],
+        "rawId": payload["rawId"],
+        "type": payload["type"],
+        "response": {
+            "clientDataJSON": payload["clientData"],
+            "authenticatorData": payload["authData"],
+            # The existing browser helper sends a hexadecimal signature.
+            "signature": bytes_to_base64url(bytes.fromhex(payload["signature"])),
+        },
+    }
+    verification = verify_authentication_response(
+        credential=credential,
+        expected_challenge=base64url_to_bytes(challenge),
+        expected_rp_id=rp_id,
+        expected_origin=origin,
+        credential_public_key=base64url_to_bytes(key.public_key),
+        credential_current_sign_count=key.sign_count,
+        require_user_verification=False,
+    )
+    return verification.new_sign_count
