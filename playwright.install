post_install() {
  printf '%s\n' \
    '==> Playwright is installed without browser payloads.' \
    '==> Install matching browsers explicitly when needed:' \
    '==>     playwright install chromium firefox' \
    '==>' \
    '==> Browser payloads are version-matched and may need reinstalling after upgrades.' \
    '==> Playwright stores them in the user cache by default.' \
    '==> Arch is not an officially supported Playwright Linux distribution.' \
    '==>' \
    '==> Optional WebKit setup (not guaranteed on Arch):' \
    '==>   1. Install voices (AUR): paru -S flite-voices-extra' \
    '==>   2. Install the ICU 74 ABI (AUR): paru -S icu74' \
    '==>        (system ICU 78 is not sufficient)' \
    '==>   3. Provide libxml2.so.2 (no Arch package ships it):' \
    '==>        sudo ln -s libxml2.so.16 /usr/lib/libxml2.so.2' \
    '==>        (may need re-pointing after upgrades)' \
    '==>   4. Install the matching browser:  playwright install webkit'
}

post_upgrade() {
  post_install
}
