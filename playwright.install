post_install() {
  printf '%s\n' \
    '==> Playwright ships without browsers. Install when needed:' \
    '==>     playwright install chromium firefox' \
    '==>' \
    '==> Reinstall browsers after upgrades (builds are version-matched).' \
    '==>' \
    '==> Optional WebKit setup (unsupported on Arch):' \
    '==>   1. paru -S flite-voices-extra' \
    '==>   2. paru -S icu74' \
    '==>   3. sudo pacman -S libxml2-legacy' \
    '==>   4. playwright install webkit' \
    '==>' \
    '==> Do not symlink libxml2.so.16 to libxml2.so.2.' \
    '==> If that symlink already exists, remove it before installing libxml2-legacy:' \
    '==>     sudo rm /usr/lib/libxml2.so.2'
}

post_upgrade() {
  post_install
}
