DATA_DIR="/opt/gui-for-singbox/data"

post_install() {
    install -dm777 "${DATA_DIR}" "${DATA_DIR}/sing-box"

    ln -sf /usr/bin/sing-box "${DATA_DIR}/sing-box/sing-box"
    /usr/bin/setcap cap_net_admin,cap_net_raw,cap_net_bind_service=ep /usr/bin/sing-box
}

post_upgrade() {
    post_install
}

post_remove() {
    # 卸载本包后不再需要为核心保留网络 capability
    if [ -f /usr/bin/sing-box ]; then
        /usr/bin/setcap -r /usr/bin/sing-box
    fi
}
