post_install() {
  # Define colors for nice output
  local BLUE='\033[0;34m'
  local GREEN='\033[0;32m'
  local YELLOW='\033[1;33m'
  local RED='\033[0;31m'
  local BOLD='\033[1m'
  local NC='\033[0m' # No Color

  echo -e ""
  echo -e "${RED}╔════════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${RED}║              ${BOLD}DISCONTINUED - MAINTENANCE STOPPED${NC}${RED}                            ║${NC}"
  echo -e "${RED}╚════════════════════════════════════════════════════════════════════════════╝${NC}"
  echo -e ""
  echo -e "${YELLOW}NOTE: This package is no longer maintained.${NC}"
  echo -e "The maintainer has withdrawn support due to community preference for unhardened methods."
  echo -e "Please migrate to 'kiro-bin' or use the wiki instructions as requested."
  echo -e ""
  echo -e "${BLUE}╔════════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BLUE}║              ${BOLD}KIRO-BIN-HARDENED - Installation Complete${NC}${BLUE}                     ║${NC}"
  echo -e "${BLUE}╚════════════════════════════════════════════════════════════════════════════╝${NC}"
  echo -e ""

  # Check if AppArmor is installed and auto-configure
  if command -v apparmor_parser >/dev/null 2>&1; then
    echo -e "${GREEN}🛡️  AppArmor detected. Configuring security profile...${NC}"
    
    # Install the profile
    if cp /usr/share/apparmor/kiro.apparmor /etc/apparmor.d/kiro 2>/dev/null; then
      
      # Load the profile
      if apparmor_parser -r /etc/apparmor.d/kiro 2>/dev/null; then
        
        # Enforce the profile
        if aa-enforce /etc/apparmor.d/kiro 2>/dev/null; then
          echo -e "${GREEN}   ✓ Profile installed, loaded, and ENFORCED.${NC}"
          echo -e "${GREEN}   ✓ Kiro is now running under Mandatory Access Control.${NC}"
        else
          echo -e "${YELLOW}   ⚠️  Profile loaded but could not be enforced (aa-enforce failed).${NC}"
        fi
      else
        echo -e "${YELLOW}   ⚠️  Profile installed but could not be loaded (apparmor_parser failed).${NC}"
      fi
    else
      echo -e "${RED}   ❌ Could not install AppArmor profile to /etc/apparmor.d/${NC}"
    fi
  else
    echo -e "${YELLOW}⚠️  AppArmor NOT detected.${NC}"
    echo -e "   For maximum security, we strongly recommend installing AppArmor:"
    echo -e "   ${BOLD}sudo pacman -S apparmor${NC}"
    echo -e "   Then reinstall this package to auto-configure the profile."
  fi

  echo -e ""
  echo -e "${BOLD}🔒 SECURITY VERIFICATION:${NC}"
  echo -e "   You can verify the integrity of this installation by reading:"
  echo -e "   ${BLUE}/usr/share/doc/kiro-bin-hardened/SECURITY.md${NC}"
  echo -e ""
  echo -e "${BOLD}🚀 NEXT STEPS:${NC}"
  echo -e "   1. Launch Kiro from your application menu or terminal."
  echo -e "   2. If you experience permission issues, check system logs:"
  echo -e "      ${BOLD}journalctl -xe | grep kiro${NC}"
  echo -e ""
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e ""
}

post_upgrade() {
  post_install
  
  echo -e "\033[1;33m⚠️  CRITICAL UPGRADE NOTICE:\033[0m"
  echo -e "   To ensure stability with this new version, we STRONGLY recommend clearing the cache."
  echo -e "   Please run the following command as your user:"
  echo -e "   ${BOLD}rm -rf ~/.config/Kiro/Cache ~/.config/Kiro/CachedData ~/.config/Kiro/Code\ Cache${NC}"
  echo -e ""
}

post_remove() {
  echo -e ""
  echo -e "\033[1;34m🧹 CLEANUP RECOMMENDATIONS:\033[0m"
  echo -e ""
  echo -e "   1. Remove AppArmor profile (if installed):"
  echo -e "      ${BOLD}sudo rm /etc/apparmor.d/kiro${NC}"
  echo -e "      ${BOLD}sudo systemctl reload apparmor${NC}"
  echo -e ""
  echo -e "   2. Remove user data (Optional):"
  echo -e "      ${BOLD}rm -rf ~/.config/Kiro ~/.kiro${NC}"
  echo -e ""
}
