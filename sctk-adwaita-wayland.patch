-                        if state == wl_pointer::ButtonState::Pressed {
-                            let request = match button {
-                                // Left mouse button.
-                                0x110 => request_for_location_on_lmb(
-                                    &data,
-                                    inner.maximized,
-                                    inner.resizable,
-                                ),
-                                // Right mouse button.
-                                0x111 => request_for_location_on_rmb(&data),
-                                _ => None,
-                            };
