-fn color_to_paint(c: RgbaColor) -> Paint<'static> {
-    let mut paint = Paint::default();
-    let (red, green, blue, alpha) = c.as_rgba_u8();
-    paint.set_color_rgba8(blue, green, red, alpha);
-    paint.anti_alias = true;
-    paint
-}
