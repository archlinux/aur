CONF_FILE="/etc/smfc/smfc.conf"

_smfc_detect_hd_names() {
    if [ -d /dev/disk/by-id ] && grep -q '^hd_names=$' "$CONF_FILE"; then
        hd_disks=$(ls /dev/disk/by-id/ | grep -v -E '\-part|^wwn-|\-eui|nvme|^dm-|^lvm-|^md-|^zd-|_1+$' || true)
        if [ -n "$hd_disks" ]; then
            replacement=""; first=1
            for disk in $hd_disks; do
                if [ "$first" = 1 ]; then replacement="/dev/disk/by-id/${disk}"; first=0
                else replacement="${replacement}\n\t/dev/disk/by-id/${disk}"; fi
            done
            sed -i "s|^hd_names=$|hd_names=${replacement}|" "$CONF_FILE"
        fi
    fi
}

_smfc_detect_nvme_names() {
    if [ -d /dev/disk/by-id ] && grep -q '^nvme_names=$' "$CONF_FILE"; then
        nvme_disks=$(ls /dev/disk/by-id/ | grep -E '^nvme-' | grep -v -E '\-part|\-eui|\-nvme|_1+$' || true)
        if [ -n "$nvme_disks" ]; then
            replacement=""; first=1
            for disk in $nvme_disks; do
                if [ "$first" = 1 ]; then replacement="/dev/disk/by-id/${disk}"; first=0
                else replacement="${replacement}\n\t/dev/disk/by-id/${disk}"; fi
            done
            sed -i "s|^nvme_names=$|nvme_names=${replacement}|" "$CONF_FILE"
        fi
    fi
}

post_install() {
echo "Thank you very much to petersulyok for the tremendous help in getting this updated and possible to maintain it in the AUR. Check out his github."
echo
echo "Fresh installs only: Read lines 60 to 134 in /etc/smfc/smfc.conf for a basic setup."
echo
echo "Review the configuration in /etc/smfc/smfc.conf and /etc/default/smfc, then enable the service:  systemctl enable --now smfc.service"
echo
echo "hwmon sensor drivers (coretemp/k10temp/drivetemp) are preloaded via /usr/lib/modules-load.d/smfc.conf; load now with: modprobe coretemp drivetemp."
}

post_upgrade() {
    :
}
