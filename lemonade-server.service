[Unit]
Description=Lemonade Server
After=network-online.target

[Service]
Type=simple
User=lemonade
Group=lemonade
WorkingDirectory=/var/lib/lemonade
EnvironmentFile=/etc/lemonade/lemonade.conf
ExecStart=/usr/bin/lemonade-server serve
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target