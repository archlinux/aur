post_install() {
  systemd-sysusers >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true

  cat << 'EOF'

=== WG Tunnel Installed ===

    sudo systemctl enable --now wgtunnel-daemon.service

EOF
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  if systemctl is-active --quiet wgtunnel-daemon.service 2>/dev/null; then
    echo "Restart the daemon to pick up the new binary: sudo systemctl restart wgtunnel-daemon.service"
  fi
}

pre_remove() {
  systemctl disable --now wgtunnel-daemon.service 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
