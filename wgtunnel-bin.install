post_install() {
  systemd-sysusers >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true

  cat << 'EOF'

=== WG Tunnel Installed ===

    sudo systemctl enable --now wgtunnel-daemon.service

EOF
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  # Already running, so keep it in sync with a restart. This isn't auto-enabling a service
  # that wasn't active before, so it doesn't violate the Arch conventions
  systemctl restart wgtunnel-daemon.service >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now wgtunnel-daemon.service 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
