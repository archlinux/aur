print_hyprmoncfg_post_install() {
  cat <<'EOF'
Optional hyprmoncfg setup:

  Launch the TUI:
    hyprmoncfg

  Enable the user daemon:
    systemctl --user daemon-reload
    systemctl --user enable --now hyprmoncfgd

Profiles live in:
  ~/.config/hyprmoncfg/profiles/

This package builds from source. The ready-made build is hyprmoncfg-bin.
EOF
}

post_install() {
  print_hyprmoncfg_post_install
}

post_upgrade() {
  print_hyprmoncfg_post_install
}
