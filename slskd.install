post_install() {
    systemd-sysusers /usr/lib/sysusers.d/slskd.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/slskd.conf >/dev/null 2>&1 || true
    install -d -m 0755 /var/lib/slskdN-vpn >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    cat <<'EOF'
slskdN: configuration lives at /etc/slskd/slskd.yml.
slskdN: if pacman created /etc/slskd/slskd.yml.pacnew, merge any wanted new
slskdN: defaults manually; pacman preserved your existing configuration.
EOF
}

post_upgrade() {
    post_install
    systemctl try-restart slskd.service >/dev/null 2>&1 || true
}

post_remove() {
    systemctl daemon-reload >/dev/null 2>&1 || true
}
