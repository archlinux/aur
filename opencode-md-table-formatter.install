post_install() {
  echo "=========================================================================="
  echo "  Opencode md Table Formatter Installed"
  echo "=========================================================================="
  echo ""
  echo "To enable this plugin, add it to your opencode configuration file"
  echo "(e.g., ~/.config/opencode/opencode.json):"
  echo ""
  echo "  {"
  echo "    \"plugin\": [\"file:///usr/lib/opencode/plugins/opencode-md-table-formatter\"]"
  echo "  }"
  echo ""
  echo "=========================================================================="
}

post_upgrade() {
  post_install
}
