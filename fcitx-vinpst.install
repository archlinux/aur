# shellcheck shell=bash

post_install() {
  printf '%s\n' \
    ':: fcitx-vinpst installed.' \
    ':: Reload Fcitx5 in active desktop sessions: fcitx5 -r'
}

post_upgrade() {
  printf '%s\n' \
    ':: fcitx-vinpst upgraded.' \
    ':: Reload Fcitx5 in active desktop sessions: fcitx5 -r'
}

post_remove() {
  printf '%s\n' \
    ':: fcitx-vinpst removed.' \
    ':: User config, models, and cache were preserved.' \
    ':: Reload Fcitx5 in active desktop sessions: fcitx5 -r'
}
