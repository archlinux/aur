# superscience-blue-gtk-theme.install (SuperScience Blue, packaging)
# Created: 2026-09-28 04:55 | Last change: 2026-09-29 19:36 — messages name both
# themes (SuperScience Blue and SuperScience Blue-Dark); upgrades from before 1.1.0
# announce the dark theme. Previous entry: libadwaita styling automatic at login.

post_install()
{
    echo "SuperScience Blue installs two themes: SuperScience Blue and SuperScience Blue-Dark."
    echo "Choose one in your desktop's appearance settings (Xfce: Settings > Appearance;"
    echo "window borders: Settings > Window Manager), then log out and back in."
    echo "libadwaita apps (e.g. Pamac) will match."
    echo "More: https://github.com/muncrief/superscience-blue"
}

post_upgrade()
{
    if [ "$(vercmp "$2" 1.1.0)" -lt 0 ]
    then
        echo "New in SuperScience Blue 1.1: a dark theme, SuperScience Blue-Dark."
        echo "Choose it in your desktop's appearance settings (Xfce: Settings > Appearance)."
    fi
}

post_remove()
{
    echo "SuperScience Blue removed. Each user's ~/.config/gtk-4.0/gtk.css link"
    echo "(if any) now points at nothing and can be deleted; it does no harm."
}
