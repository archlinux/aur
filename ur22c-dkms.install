post_install() {
    cat <<'EOF'
==> ur22c-dkms notes:
    1. Building for a new kernel version fetches sound/usb/ sources from
       github.com / git.kernel.org during the DKMS hook (network required;
       if offline during upgrade, run `sudo dkms autoinstall` once online).
    2. If the UR22C is currently in use, reload snd_usb_audio (or reboot)
       so the running kernel switches to the patched module.
    3. Once your running kernel includes both upstream patches, DKMS will
       skip patching automatically and you can remove this package.
EOF
}

post_upgrade() {
    post_install
}

post_remove() {
    rm -rf /var/cache/ur22c-snd-usb-audio
}
