_stop_service() {
    systemctl stop tuxedo-power-profiles-adapter.service >/dev/null 2>&1 || true
}

_restart_service() {
    systemctl try-restart tuxedo-power-profiles-adapter.service >/dev/null 2>&1 || true
}

post_install() {
    _restart_service
}

post_upgrade() {
    _restart_service
}

pre_remove() {
    _stop_service
}