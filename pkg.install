post_install() {
    systemctl start tuxedo-power-profiles-adapter.service >/dev/null 2>&1 || true
}

post_upgrade() {
    stemctl try-restart tuxedo-power-profiles-adapter.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl stop tuxedo-power-profiles-adapter.service >/dev/null 2>&1 || true
}