# Minimal Tegola configuration example.
#
# This example starts Tegola with no provider configured.
# Add providers and maps according to the Tegola documentation:
#
#   https://tegola.io/documentation/

[webserver]
port = ":8080"

# Example PostGIS provider skeleton:
