# type = "mvt_postgis"
# uri = "postgres://user:password@localhost:5432/database?sslmode=disable"
#
#   [[providers.layers]]
#   name = "example"
#   geometry_fieldname = "geom"
#   geometry_type = "Polygon"
#   id_fieldname = "id"
#   srid = 3857
#   sql = """
#     SELECT
#       id,
#       ST_AsMVTGeom(geom, !BBOX!) AS geom
#     FROM public.example
#     WHERE geom && !BBOX!
#   """
#
# [[maps]]
# name = "example"
#
#   [[maps.layers]]
#   provider_layer = "postgis.example"
#   min_zoom = 0
#   max_zoom = 14
