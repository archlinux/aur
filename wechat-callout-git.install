#!/bin/bash

_print() {
    echo "---------------------------------------------------"
    echo "安装完毕！请按以下步骤设置快捷键："
    echo ""
    echo "1. 打开系统设置"
    echo "2. 进入 '键盘' 设置"
    echo "3. 选择 '快捷键' 选项卡"
    echo "4. 点击 '新增' 按钮"
    echo "5. 选择 '应用程序' 选项"
    echo "6. 在菜单树中选择 '工具' -> '微信唤出'. 确定"
    echo "7. 点击右边添加快捷键为 'Ctrl + Alt + W'"
    echo "8. 点击 '应用' 保存"
    echo ""
    echo "---------------------------------------------------"
    echo "完成后，您就可以通过 'Ctrl + Alt + W' 快捷键唤出微信了！"
    echo "感谢您的安装！"
}


post_upgrade() {
    _print
}


post_install() {
    _print
}
