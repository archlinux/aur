From 0c2ea201e72c3454a3c367227b5fb557d783c469 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Mon, 10 Aug 2026 21:14:07 +0800
Subject: [PATCH 4/6] cmake: Use system glslang

---
 CMakeLists.txt             | 1 +
 src/Vulkan/CMakeLists.txt  | 2 +-
 third_party/CMakeLists.txt | 1 -
 3 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8e47818..46fc618 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,7 @@ find_package(Threads REQUIRED)
 find_package(CEF 149.0.7827.156 REQUIRED)
 find_package(Eigen3 5.0.1 REQUIRED)
 find_package(qjs REQUIRED) # >= 0.14.0 in deps.json, but version is not supported in extra/quickjs-ng
+find_package(glslang 16.3.0 REQUIRED)
 
 set(OWE_CXX_COMPILE_OPTIONS
     -Wall
diff --git a/src/Vulkan/CMakeLists.txt b/src/Vulkan/CMakeLists.txt
index 9eab05e..1c6745d 100644
--- a/src/Vulkan/CMakeLists.txt
+++ b/src/Vulkan/CMakeLists.txt
@@ -7,7 +7,7 @@ target_sources(owe-shader-compile
   PUBLIC FILE_SET cxx_modules TYPE CXX_MODULES FILES ShaderCompile.cppm)
 target_link_libraries(owe-shader-compile
   PUBLIC rstd::rstd rstd.cppstd owe-types vvk::ffi::vulkan
-  PRIVATE glslang SPIRV glslang-default-resource-limits spirv-reflect-static)
+  PRIVATE glslang::glslang glslang::SPIRV glslang::glslang-default-resource-limits spirv-reflect-static)
 target_include_directories(owe-shader-compile
   PUBLIC  .. ../Scene/Utils/include
   PRIVATE ../Scene/Utils ../Scene/Utils/include/Utils .)
diff --git a/third_party/CMakeLists.txt b/third_party/CMakeLists.txt
index b995fa2..dbd7e0f 100644
--- a/third_party/CMakeLists.txt
+++ b/third_party/CMakeLists.txt
@@ -51,7 +51,6 @@ set(BUILD_TESTING           OFF CACHE INTERNAL "")
 
 fetchdeps(${CMAKE_SOURCE_DIR}/deps.json NAMES
     spirv_reflect
-    glslang
     vma
     rstd
     vvk
-- 
2.55.0

