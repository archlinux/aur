From 83bfa7d218b6f311975658f822d9d14d998f90fe Mon Sep 17 00:00:00 2001
From: Xiretza <xiretza@xiretza.xyz>
Date: Thu, 5 Nov 2026 08:17:17 -0800
Subject: [PATCH] Link against system openssl, libsodium

---
 Cargo.lock | 12 +-----------
 Cargo.toml |  2 +-
 2 files changed, 2 insertions(+), 12 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 47581e6..f13a186 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -191,7 +191,7 @@ name = "etebase-python"
 version = "0.32.0"
 dependencies = [
  "etebase",
- "openssl",
+ "libsodium-sys",
  "pyo3",
 ]
 
@@ -620,15 +620,6 @@ version = "0.1.5"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "ff011a302c396a5197692431fc1948019154afc178baf7d8e37367442a4601cf"
 
-[[package]]
-name = "openssl-src"
-version = "300.2.1+3.2.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "3fe476c29791a5ca0d1273c697e96085bbabbbea2ef7afd5617e78a4b40332d3"
-dependencies = [
- "cc",
-]
-
 [[package]]
 name = "openssl-sys"
 version = "0.9.108"
@@ -637,7 +628,6 @@ checksum = "e145e1651e858e820e4860f7b9c5e169bc1d8ce1c86043be79fa7b7634821847"
 dependencies = [
  "cc",
  "libc",
- "openssl-src",
  "pkg-config",
  "vcpkg",
 ]
diff --git a/Cargo.toml b/Cargo.toml
index fe85ea9..546100b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -15,5 +15,5 @@ crate-type = ["cdylib"]
 
 [dependencies]
 pyo3 = { version = "0.30", features = ["extension-module", "abi3-py39"] }
-openssl = { version = "0.10.55", features = ["vendored"] }
+libsodium-sys = { version = "0.2.7", features = ["use-pkg-config"] }
 etebase = { version = "^0.6.1" }
-- 
2.56.0

