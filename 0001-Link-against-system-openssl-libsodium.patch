From f749ae1c4cd9d3342129efe648b1c40125d065ff Mon Sep 17 00:00:00 2001
From: Xiretza <xiretza@xiretza.xyz>
Date: Sun, 12 May 2024 10:58:16 +0000
Subject: [PATCH 1/2] Link against system openssl, libsodium

---
 Cargo.lock | 14 ++------------
 Cargo.toml |  2 +-
 2 files changed, 3 insertions(+), 13 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 8f1ae69..b9c73ec 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1,6 +1,6 @@
 # This file is automatically @generated by Cargo.
 # It is not intended for manual editing.
-version = 3
+version = 4
 
 [[package]]
 name = "addr2line"
@@ -245,8 +245,8 @@ dependencies = [
  "env_logger",
  "etebase",
  "flapigen",
+ "libsodium-sys",
  "log",
- "openssl",
 ]
 
 [[package]]
@@ -728,15 +728,6 @@ version = "0.1.5"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "ff011a302c396a5197692431fc1948019154afc178baf7d8e37367442a4601cf"
 
-[[package]]
-name = "openssl-src"
-version = "300.2.1+3.2.0"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "3fe476c29791a5ca0d1273c697e96085bbabbbea2ef7afd5617e78a4b40332d3"
-dependencies = [
- "cc",
-]
-
 [[package]]
 name = "openssl-sys"
 version = "0.9.98"
@@ -745,7 +736,6 @@ checksum = "c1665caf8ab2dc9aef43d1c0023bd904633a6a05cb30b0ad59bec2ae986e57a7"
 dependencies = [
  "cc",
  "libc",
- "openssl-src",
  "pkg-config",
  "vcpkg",
 ]
diff --git a/Cargo.toml b/Cargo.toml
index 18f8a67..a3c6824 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -19,5 +19,5 @@ log = "^0.4.6"
 
 [dependencies]
 cpython = { version = "0.7", features = ["extension-module"] }
-openssl = { version = "0.10.55", features = ["vendored"] }
+libsodium-sys = { version = "0.2.7", features = ["use-pkg-config"] }
 etebase = { version = "^0.6.0" }
-- 
