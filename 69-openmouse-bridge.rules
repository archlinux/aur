# OpenMouse Bridge: let the signed-in user reach mice over hidraw.
# Generated by scripts/gen-udev-rules.sh from upstream install-linux.sh.
# The hidraw rule matches every hidraw node of a USB device with a mouse
# interface (a mouse or its receiver), including the vendor interface its
# settings go through. The uinput rule lets the button listener press keys
# and side buttons through a virtual keyboard and mouse.
SUBSYSTEM=="hidraw", SUBSYSTEMS=="usb", PROGRAM="/bin/sh /usr/lib/udev/openmouse-bridge-is-mouse %S%p", TAG+="uaccess"
KERNEL=="uinput", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
