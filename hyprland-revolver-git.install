post_install() {
    cat <<'EOF'

==> hyprland-revolver is staged, but NOT set up yet.
==>
==> pacman/makepkg can only ever drop files under /usr - it runs as root
==> and never touches your $HOME, so it can't patch your own Quickshell
==> config for you directly. Instead, a systemd --user unit is now
==> enabled that will do it automatically the next time you log in.
==>
==> Don't want to wait for that? Run it yourself right now, as yourself:
==>
==>     hyprland-revolver-install
==>
==> Then reload quickshell (pkill -f "qs -c ii" && qs -c ii) and it'll be
==> in Settings (Super+I) under Background -> "Widget: Revolver Barrel".

EOF
}

post_upgrade() {
    cat <<'EOF'

==> hyprland-revolver was upgraded. The systemd --user unit will pick up
==> anything new (new settings fields, etc.) automatically next login -
==> or run it now if you don't want to wait:
==>
==>     hyprland-revolver-install
==>

EOF
}
