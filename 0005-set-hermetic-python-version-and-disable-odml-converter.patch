diff --git a/.bazelrc b/.bazelrc
index 5965f963f..1dbad3b09 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -125,6 +125,10 @@ build:darwin_arm64 --cpu=darwin_arm64
