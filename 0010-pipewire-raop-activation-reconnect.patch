new file mode 100644
index 0000000..f3706dc
--- /dev/null
+++ b/src/modules/module-raop/reconnect.c
@@ -0,0 +1,89 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include "reconnect.h"
+
+int raop_reconnect_mode_parse(const char *value,
+		enum raop_reconnect_mode *mode)
+{
+	if (mode == NULL)
+		return -EINVAL;
+	if (value == NULL || strcmp(value, "automatic") == 0)
+		*mode = RAOP_RECONNECT_AUTOMATIC;
+	else if (strcmp(value, "activation") == 0)
+		*mode = RAOP_RECONNECT_ACTIVATION;
+	else
+		return -EINVAL;
+	return 0;
+}
+
+const char *raop_reconnect_mode_name(enum raop_reconnect_mode mode)
+{
+	return mode == RAOP_RECONNECT_ACTIVATION ?
+		"activation" : "automatic";
+}
+
+void raop_reconnect_state_init(struct raop_reconnect_state *state,
+		enum raop_reconnect_mode mode)
+{
+	if (state == NULL)
+		return;
+	state->mode = mode;
+	state->playback_active = false;
+	state->failure_latched = false;
+}
+
+bool raop_reconnect_latch_failure(struct raop_reconnect_state *state,
+		bool activation_authorized, bool expected_cleanup)
+{
+	if (state == NULL || state->mode != RAOP_RECONNECT_ACTIVATION ||
+			!activation_authorized || expected_cleanup)
+		return false;
+	state->failure_latched = true;
+	return true;
+}
+
+bool raop_reconnect_open(struct raop_reconnect_state *state)
+{
+	if (state == NULL || state->mode != RAOP_RECONNECT_ACTIVATION ||
+			state->playback_active)
+		return false;
+	state->playback_active = true;
+	state->failure_latched = false;
+	return true;
+}
+
+bool raop_reconnect_close(struct raop_reconnect_state *state)
+{
+	if (state == NULL || state->mode != RAOP_RECONNECT_ACTIVATION ||
+			!state->playback_active)
+		return false;
+	state->playback_active = false;
+	return true;
+}
+
+bool raop_reconnect_want_stream(const struct raop_reconnect_state *state,
+		bool format_present)
+{
+	if (!format_present)
+		return false;
+	return state == NULL || state->mode == RAOP_RECONNECT_AUTOMATIC ||
+		(state->playback_active && !state->failure_latched);
+}
+
+bool raop_reconnect_blocked(const struct raop_reconnect_state *state)
+{
+	return state != NULL && state->mode == RAOP_RECONNECT_ACTIVATION &&
+		state->failure_latched;
+}
+
+bool raop_reconnect_allow_timer(const struct raop_reconnect_state *state)
+{
+	return state == NULL || state->mode == RAOP_RECONNECT_AUTOMATIC;
+}
