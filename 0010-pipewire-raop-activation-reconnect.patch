+static bool activation_transport_failure(struct impl *impl,
+		const char *reason, bool already_disconnected)
+{
+	bool already_latched;
+
+	if (raop_reconnect_allow_timer(&impl->reconnect))
+		return false;
+
+	already_latched = raop_reconnect_blocked(&impl->reconnect);
+	/* A callback cancelled after its activation lost want_stream has no
+	 * recovery authority. Clean it up without consuming the next
+	 * playback-open edge by latching the retired generation. */
+	if (!already_latched &&
+			!raop_reconnect_latch_failure(&impl->reconnect,
+				impl->want_stream,
+				impl->tearing_down || impl->disconnect_expected)) {
+		pw_timer_queue_cancel(&impl->reconnect_timer);
+		impl->reconnect_attempts = 0;
+		if (!already_disconnected) {
+			impl->disconnect_expected = true;
+			pw_rtsp_client_disconnect(impl->rtsp);
+			if (!impl->disconnect_expected)
+				return true;
+			impl->disconnect_expected = false;
+		}
+		impl->connected = false;
+		impl->connecting = false;
+		connection_cleanup(impl);
+		return true;
+	}
+
+	if (!already_latched) {
+		pw_log_warn("%s; waiting for a new playback-open edge", reason);
+	}
+	/* Revoke authority before disconnect: pw_rtsp_client_disconnect() may
+	 * emit the disconnected callback synchronously. Activation mode is valid
+	 * only for contract 2, so no gate/marker contract is weakened here. */
+	impl->want_stream = false;
+	pw_timer_queue_cancel(&impl->reconnect_timer);
+	impl->reconnect_attempts = 0;
+	if (!already_disconnected) {
+		impl->disconnect_expected = true;
+		pw_rtsp_client_disconnect(impl->rtsp);
+		if (!impl->disconnect_expected)
+			return true;
+		impl->disconnect_expected = false;
+	}
+	impl->connected = false;
+	impl->connecting = false;
+	connection_cleanup(impl);
+	return true;
+}
