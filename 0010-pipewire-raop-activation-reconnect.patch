diff --git a/src/modules/module-raop/test-reconnect.c b/src/modules/module-raop/test-reconnect.c
new file mode 100644
index 0000000..9aa03f5
--- /dev/null
+++ b/src/modules/module-raop/test-reconnect.c
@@ -0,0 +1,121 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 Lukáš Lipinský */
+/* SPDX-License-Identifier: MIT */
+
+#include "config.h"
+
+#include <errno.h>
+#include <string.h>
+
+#include <spa/utils/defs.h>
+
+#include "reconnect.h"
+
+static void test_parser(void)
+{
+	enum raop_reconnect_mode mode;
+
+	spa_assert_se(raop_reconnect_mode_parse(NULL, &mode) == 0);
+	spa_assert_se(mode == RAOP_RECONNECT_AUTOMATIC);
+	spa_assert_se(raop_reconnect_mode_parse("automatic", &mode) == 0);
+	spa_assert_se(mode == RAOP_RECONNECT_AUTOMATIC);
+	spa_assert_se(raop_reconnect_mode_parse("activation", &mode) == 0);
+	spa_assert_se(mode == RAOP_RECONNECT_ACTIVATION);
+	spa_assert_se(raop_reconnect_mode_parse("", &mode) == -EINVAL);
+	spa_assert_se(raop_reconnect_mode_parse("retry", &mode) == -EINVAL);
+	spa_assert_se(raop_reconnect_mode_parse("automatic", NULL) == -EINVAL);
+	spa_assert_se(strcmp(raop_reconnect_mode_name(
+			RAOP_RECONNECT_AUTOMATIC), "automatic") == 0);
+	spa_assert_se(strcmp(raop_reconnect_mode_name(
+			RAOP_RECONNECT_ACTIVATION), "activation") == 0);
+}
+
+static void test_automatic_mode(void)
+{
+	struct raop_reconnect_state state;
+
+	raop_reconnect_state_init(&state, RAOP_RECONNECT_AUTOMATIC);
+	spa_assert_se(!raop_reconnect_blocked(&state));
+	spa_assert_se(raop_reconnect_allow_timer(&state));
+	spa_assert_se(!raop_reconnect_want_stream(&state, false));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+	spa_assert_se(!raop_reconnect_latch_failure(&state, true, false));
+	spa_assert_se(!raop_reconnect_open(&state));
+	spa_assert_se(!raop_reconnect_close(&state));
+	spa_assert_se(!raop_reconnect_blocked(&state));
+	spa_assert_se(raop_reconnect_allow_timer(&state));
+}
+
+static void test_activation_edge_rearms_once(void)
+{
+	struct raop_reconnect_state state;
+
+	raop_reconnect_state_init(&state, RAOP_RECONNECT_ACTIVATION);
+	spa_assert_se(!raop_reconnect_blocked(&state));
+	spa_assert_se(!raop_reconnect_allow_timer(&state));
+	spa_assert_se(!raop_reconnect_want_stream(&state, true));
+
+	/* Format-before-open starts exactly once on the open edge. */
+	spa_assert_se(raop_reconnect_open(&state));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+	spa_assert_se(!raop_reconnect_open(&state));
+	spa_assert_se(raop_reconnect_latch_failure(&state, true, false));
+	spa_assert_se(raop_reconnect_blocked(&state));
+	spa_assert_se(!raop_reconnect_want_stream(&state, true));
+	/* Format changes do not rearm a failed playback generation. */
+	spa_assert_se(!raop_reconnect_want_stream(&state, false));
+	spa_assert_se(!raop_reconnect_want_stream(&state, true));
+
+	spa_assert_se(raop_reconnect_close(&state));
+	spa_assert_se(raop_reconnect_blocked(&state));
+	spa_assert_se(!raop_reconnect_want_stream(&state, true));
+	spa_assert_se(!raop_reconnect_close(&state));
+	spa_assert_se(raop_reconnect_open(&state));
+	spa_assert_se(!raop_reconnect_blocked(&state));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+	spa_assert_se(!raop_reconnect_open(&state));
+}
+
+static void test_open_before_format_and_rapid_restart(void)
+{
+	struct raop_reconnect_state state;
+
+	raop_reconnect_state_init(&state, RAOP_RECONNECT_ACTIVATION);
+	spa_assert_se(raop_reconnect_open(&state));
+	spa_assert_se(!raop_reconnect_want_stream(&state, false));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+
+	/* A STOPPING close/open pair is one close and one successor open. */
+	spa_assert_se(raop_reconnect_close(&state));
+	spa_assert_se(raop_reconnect_open(&state));
+	spa_assert_se(!raop_reconnect_open(&state));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+}
+
+static void test_stale_and_expected_failures_do_not_consume_edge(void)
+{
+	struct raop_reconnect_state state;
+
+	raop_reconnect_state_init(&state, RAOP_RECONNECT_ACTIVATION);
+	spa_assert_se(!raop_reconnect_latch_failure(&state, false, false));
+	spa_assert_se(!raop_reconnect_blocked(&state));
+
+	spa_assert_se(raop_reconnect_open(&state));
+	/* An expected asynchronous TEARDOWN timeout must clean up, not latch the
+	 * already-open successor playback generation. */
+	spa_assert_se(!raop_reconnect_latch_failure(&state, true, true));
+	spa_assert_se(!raop_reconnect_blocked(&state));
+	spa_assert_se(raop_reconnect_want_stream(&state, true));
+}
+
+int main(int argc, char *argv[])
+{
+	(void)argc;
+	(void)argv;
+	test_parser();
+	test_automatic_mode();
+	test_activation_edge_rearms_once();
+	test_open_before_format_and_rapid_restart();
+	test_stale_and_expected_failures_do_not_consume_edge();
+	return 0;
+}
