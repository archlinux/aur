#compdef notes
# Generated by notes completions zsh. Do not edit by hand.

local -a notes_commands
notes_commands=(
  'root:Print the notes vault root'
  'context:Print project-note context for integration plugins'
  'list:List repository notes'
  'read:Print a note file'
  'write:Write stdin to a note file, then commit and push it'
  'delete:Delete a note file, then commit and push it'
  'handoffs:Browse handoff-tagged notes'
  'mcp:Run the notes MCP server over stdio'
  'completions:Generate shell completions'
  'help:Show notes help'
)

if (( CURRENT == 2 )); then
  _describe -t commands 'notes command' notes_commands
  return
fi

local command=${words[2]}
case $command in
  root)
    _arguments -S \
      '--projects[Print the projects directory]' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  context)
    _arguments -S \
      '--command[Integration command name requesting context]:name:' \
      '--json[Emit structured context JSON]' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  list)
    _arguments -S \
      '--all[Show notes from every projects directory]' \
      '--tag[Only include notes with this tag]:tag:' \
      '--format[Output format]:labels|json:' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  read)
    _arguments -S \
      '--path[Absolute path to a note file inside the notes vault]:path:' \
      '--json[Emit content and revision hash as JSON]' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  write)
    _arguments -S \
      '--path[Absolute path to a note file inside the notes vault]:path:' \
      '--stdin[Read note content from stdin]' \
      '--expected-hash[Fail if the existing note no longer has this SHA-256 hash]:sha256:' \
      '--json[Emit the complete mutation result as JSON]' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  delete)
    _arguments -S \
      '--path[Absolute path to a note file inside the notes vault]:path:' \
      '--json[Emit the complete mutation result as JSON]' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  handoffs)
    _arguments -S \
      '--all[Show notes from every projects directory]' \
      '--list[List handoffs to stdout instead of opening the TUI]' \
      '--format[Output format]:labels|json:' \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  mcp)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '*::arg:->args'
    ;;
  completions)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '1:shell:' \
      '*::arg:->args'
    ;;
  help)
    _arguments -S \
      '{-h,--help}[Show this help message]' \
      '1:Optional command to show help for:' \
      '*::arg:->args'
    ;;
esac
