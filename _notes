#compdef notes
###-begin-notes-completions-###
#
# Static completion script for Zsh
#
# Installation:
#   notes --completions zsh > ~/.zsh/completions/_notes
#   then add ~/.zsh/completions to your fpath
#

_notes() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'root:Print the notes vault root'
    'context:Resolve project-note context for integration plugins.'
    'list:List repository notes'
    'search:Search repository note metadata'
    'read:Print a note file'
    'write:Write stdin to a note file, then commit and push it'
    'delete:Delete a note file, then commit and push it'
    'move:Move a note to another known repository scope'
    'create:Create a note from stdin, then commit and push it'
    'targets:List known repository targets'
    'agents:List installed agent targets'
    'priority:Set a note priority, then commit and push it'
    'open-agent:Open a note in an installed agent through Herdr'
    'handoffs:Browse handoff-tagged notes'
    'mcp:Run the notes MCP server over stdio'
    'capture:Process a captured note through local OpenCode'
    'daemon:Process captured notes through local OpenCode'
  )

  local -a specs
  specs=(
    '(--all --no-all)--all[Browse notes from every projects directory]'
    '(--all --no-all)--no-all[Disable all]'
    '1:command:->command'
    '*::arg:->args'
  )

  _arguments -C "${specs[@]}"

  case "$state" in
    command)
      _describe -t commands 'commands' commands
      ;;
    args)
      case "$words[1]" in
        root)
          _notes_root
          ;;
        context)
          _notes_context
          ;;
        list)
          _notes_list
          ;;
        search)
          _notes_search
          ;;
        read)
          _notes_read
          ;;
        write)
          _notes_write
          ;;
        delete)
          _notes_delete
          ;;
        move)
          _notes_move
          ;;
        create)
          _notes_create
          ;;
        targets)
          _notes_targets
          ;;
        agents)
          _notes_agents
          ;;
        priority)
          _notes_priority
          ;;
        open-agent)
          _notes_open_agent
          ;;
        handoffs)
          _notes_handoffs
          ;;
        mcp)
          _notes_mcp
          ;;
        capture)
          _notes_capture
          ;;
        daemon)
          _notes_daemon
          ;;
      esac
      ;;
  esac
}

_notes_root() {
  local -a specs
  specs=(
    '(--projects --no-projects)--projects[Print the projects directory]'
    '(--projects --no-projects)--no-projects[Disable projects]'
  )
  _arguments "${specs[@]}"
}

_notes_context() {
  local -a specs
  specs=(
    '(--command)--command[Integration command name requesting context]:value:'
    '(--json --no-json)--json[Emit structured context JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_list() {
  local -a specs
  specs=(
    '(--all --no-all)--all[Show notes from every projects directory]'
    '(--all --no-all)--no-all[Disable all]'
    '(--tag)--tag[Only include notes with this tag]:value:'
    '(--format)--format[Output format]:value:(labels json)'
  )
  _arguments "${specs[@]}"
}

_notes_search() {
  local -a specs
  specs=(
    '(--query)--query[Fuzzy search text]:value:'
    '(--all --no-all)--all[Show notes from every projects directory]'
    '(--all --no-all)--no-all[Disable all]'
    '(--tag)--tag[Only include notes with this tag]:value:'
    '(--format)--format[Output format]:value:(labels json)'
  )
  _arguments "${specs[@]}"
}

_notes_read() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--json --no-json)--json[Emit content and revision hash as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_write() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--stdin --no-stdin)--stdin[Read note content from stdin]'
    '(--stdin --no-stdin)--no-stdin[Disable stdin]'
    '(--expected-hash)--expected-hash[Fail if the existing note no longer has this SHA-256 hash]:value:'
    '(--json --no-json)--json[Emit the complete mutation result as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_delete() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--json --no-json)--json[Emit the complete mutation result as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_move() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--to)--to[Existing or remembered repository scope]:value:'
    '(--json --no-json)--json[Emit the complete mutation result as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_create() {
  local -a specs
  specs=(
    '(--repository)--repository[Repository scope for the new note]:value:'
    '(--kind)--kind[Note template kind]:value:(note handoff)'
    '(--name)--name[Note name]:value:'
    '(--description)--description[Note description]:value:'
    '(--stdin --no-stdin)--stdin[Read the note body from stdin]'
    '(--stdin --no-stdin)--no-stdin[Disable stdin]'
    '(--json --no-json)--json[Emit the complete create result as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_targets() {
  local -a specs
  specs=(
    '(--format)--format[Output format]:value:(labels json)'
  )
  _arguments "${specs[@]}"
}

_notes_agents() {
  local -a specs
  specs=(
    '(--format)--format[Output format]:value:(labels json)'
  )
  _arguments "${specs[@]}"
}

_notes_priority() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--value)--value[New priority]:value:(low medium high critical)'
    '(--json --no-json)--json[Emit the mutation result as JSON]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_open_agent() {
  local -a specs
  specs=(
    '(--path)--path[Absolute path to a note file inside the notes vault]:file:_files'
    '(--agent)--agent[Command from notes agents]:value:'
    '(--mode)--mode[Agent opening mode]:value:(default plan)'
    '(--json --no-json)--json[Emit the opened workspace and tab IDs]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_handoffs() {
  local -a specs
  specs=(
    '(--all --no-all)--all[Show notes from every projects directory]'
    '(--all --no-all)--no-all[Disable all]'
    '(--list --no-list)--list[List handoffs to stdout instead of opening the TUI]'
    '(--list --no-list)--no-list[Disable list]'
    '(--format)--format[Output format]:value:(labels json)'
  )
  _arguments "${specs[@]}"
}

_notes_mcp() {
}

_notes_capture() {
  local -a specs
  specs=(
    '(--config)--config[Daemon YAML configuration path]:file:_files'
    '(--status --no-status)--status[Check local processor availability]'
    '(--status --no-status)--no-status[Disable status]'
    '(--stdin --no-stdin)--stdin[Read captured note text from stdin]'
    '(--stdin --no-stdin)--no-stdin[Disable stdin]'
    '(--repository)--repository[Target repository (omit for Automatic)]:value:'
    '(--json --no-json)--json[Emit a machine-readable result]'
    '(--json --no-json)--no-json[Disable json]'
  )
  _arguments "${specs[@]}"
}

_notes_daemon() {
  local -a specs
  specs=(
    '(--config)--config[Daemon YAML configuration path]:file:_files'
    '(--once --no-once)--once[Process one queue snapshot and exit]'
    '(--once --no-once)--no-once[Disable once]'
  )
  _arguments "${specs[@]}"
}

# Handle both direct invocation and autoload
if [[ "${zsh_eval_context[-1]}" == "loadautofunc" ]]; then
  _notes "$@"
else
  compdef _notes notes
fi
###-end-notes-completions-###
