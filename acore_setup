#!/bin/bash
# Ensure the script is run with administrative root privileges
if [ "$EUID" -ne 0 ]; then
    echo "======================================================================="
    echo " ❌ ERROR: ADMINISTRATIVE PRIVILEGES REQUIRED"
    echo "======================================================================="
    echo " Please run this setup script using sudo: sudo acore_setup"
    echo "======================================================================="
    exit 1
fi

# Structural typography markers for clean terminal accessibility
BOLD='\033[1m'
NC='\033[0m' # Reset formatting

echo "======================================================================="
echo -e " ⚔️  ${BOLD}AZEROTHCORE ADMINISTRATIVE SERVICE PROVISIONER${NC}"
echo "======================================================================="
echo " This utility will securely initialize your server environment layers."
echo ""

# 1. Prompt the administrator for their MySQL root credentials interactively
read -s -p "Enter your MySQL root password (leave blank if none): " DB_PASS
echo ""

# =======================================================================
# THE WARNING SUPPRESSION FIX: Create a temporary native options file
# =======================================================================
ACORE_CNF="/tmp/.acore_mysql_$$.cnf"
touch "$ACORE_CNF"
chmod 600 "$ACORE_CNF" # Strictly lock file permissions so only root can read it

cat << EOF > "$ACORE_CNF"
[client]
user=root
password="${DB_PASS}"
EOF

# Define the clean client execution command utilizing the options file wrapper
export MYSQL_CMD="mysql --defaults-file=$ACORE_CNF"

# Setup an automatic cleanup trap so the password file is deleted even if the script crashes midway
trap 'rm -f "$ACORE_CNF"' EXIT

# Test the provided database credentials cleanly
if ! $MYSQL_CMD -e "EXIT" >/dev/null 2>&1; then
    echo "❌ Error: Could not connect to MySQL with those credentials."
    exit 1
fi

echo " -> Database credentials verified successfully (Warnings suppressed)!"

# =======================================================================
# THE SQL INITIALIZATION: Run the baseline shell setup
# =======================================================================
if [ -f /usr/share/azerothcore/data/sql/create/create_mysql.sql ]; then
    echo " -> Initializing core database templates and permissions..."
    if ! $MYSQL_CMD < /usr/share/azerothcore/data/sql/create/create_mysql.sql >/dev/null 2>&1; then
        echo "❌ Error: Failed to execute core database initialization scripts."
        exit 1
    fi
else
    echo "❌ Error: Mandatory file /usr/share/azerothcore/data/sql/create/create_mysql.sql not found."
    exit 1
fi

# =======================================================================
# 2. Securely apply configuration variables & enable automatic updaters
# =======================================================================
echo " -> Tuning configuration paths inside /etc/azerothcore/..."

# Ensure the Authserver configuration explicitly allows automatic database compilation
if [ -f /etc/azerothcore/authserver.conf ]; then
    sed -i 's/^Updates.Enable\s*=\s*.*/Updates.Enable = 1/' /etc/azerothcore/authserver.conf
fi

if [ -f /etc/azerothcore/worldserver.conf ]; then
    sed -i 's/^Updates.Enable\s*=\s*.*/Updates.Enable = 1/' /etc/azerothcore/worldserver.conf
    sed -i 's/^Ra.Enable\s*=\s*.*/Ra.Enable = 1/'           /etc/azerothcore/worldserver.conf
    sed -i 's/^Ra.IP\s*=\s*.*/Ra.IP = "127.0.0.1"/'         /etc/azerothcore/worldserver.conf
    sed -i 's/^Ra.Port\s*=\s*.*/Ra.Port = 3443/'             /etc/azerothcore/worldserver.conf
    sed -i 's/^Ra.MinLevel\s*=\s*.*/Ra.MinLevel = 3/'       /etc/azerothcore/worldserver.conf
    sed -i 's/^Console.Enable\s*=\s*.*/Console.Enable = 0/' /etc/azerothcore/worldserver.conf
    sed -i 's/^Log.Async.Enable\s*=\s*.*/Log.Async.Enable = 0/' /etc/azerothcore/worldserver.conf
fi

# =======================================================================
# 3. INITIALIZE TABLES VIA AUTHSERVER WITH PORT POLLING
# =======================================================================
echo " -> Cleaning up previous table fragments to prevent migration crashes..."
$MYSQL_CMD -e "DROP DATABASE IF EXISTS acore_auth; CREATE DATABASE acore_auth;"
if [ -f /usr/share/azerothcore/data/sql/create/create_mysql.sql ]; then
    $MYSQL_CMD < /usr/share/azerothcore/data/sql/create/create_mysql.sql >/dev/null 2>&1
fi

echo " -> Launching authserver initialization engine..."

# Verify execution path exists before starting the background process thread
if [ ! -f /usr/bin/authserver ]; then
    echo "❌ Error: Mandated authserver executable not found in default search paths."
    exit 1
fi

# Select binary execution target based on your custom cmake binary directories layout
if [ -f /usr/bin/authserver ]; then
    AUTH_BIN="/usr/bin/authserver"
fi

$AUTH_BIN > /dev/null 2>&1 &
AUTH_PID=$!

echo " -> Processing core updates. Monitoring migration structures..."

# Active Network Port Polling Loop - Completely independent of SQL filenames or buffer boundaries
MIGRATION_FINISHED=0
TIMEOUT=300 
ELAPSED=0

while [ $ELAPSED -lt $TIMEOUT ]; do
    # Check if authserver has opened port 3724 (default auth port) to listen for connections
    if ss -tlnp 2>/dev/null | grep -q ":3724 "; then
        MIGRATION_FINISHED=1
        break
    fi

    # Check if the process died silently on its own
    if ! kill -0 $AUTH_PID >/dev/null 2>&1; then
        echo "❌ Error: The authserver process terminated prematurely. Check your configuration."
        exit 1
    fi

    sleep 1
    ELAPSED=$((ELAPSED + 1))
    printf " -> Synchronizing schemas... (%ds/%ds)\r" "${ELAPSED}" "${TIMEOUT}"
done

echo "" # Clear the carriage return line output stream

# Gracefully terminate the authserver now that initialization is verified complete
kill $AUTH_PID >/dev/null 2>&1
wait $AUTH_PID >/dev/null 2>&1

if [ $MIGRATION_FINISHED -eq 0 ]; then
    echo "❌ Error: Schema migration timed out before the auth network port became active."
    exit 1
fi

echo " -> Database schemas populated successfully!"

# =======================================================================
# 4. DYNAMIC FOREGROUND LOG STREAMING & ACCOUNT PROVISIONING
# =======================================================================
echo ""
echo "======================================================================="
echo -e " ⏳ ${BOLD}AZEROTHCORE FOREGROUND ACCOUNT CONFIGURATION${NC}"
echo "======================================================================="
echo " Define the master keys you want to build for your administrator account."
echo ""
read -p "Enter desired Master Admin Username: " SETUP_USER
read -s -p "Enter desired Master Admin Password: " SETUP_PASS
echo ""

# Convert username cleanly to uppercase to align with MySQL storage mechanics
SETUP_USER_UPPER=$(echo "$SETUP_USER" | tr '[:lower:]' '[:upper:]')

# Verify the worldserver binary destination paths before proceeding to foreground execution
if [ ! -f /usr/bin/worldserver ]; then
    echo "❌ Error: Mandated worldserver execution targets not found inside path parameters."
    exit 1
fi

if [ -f /usr/bin/worldserver ]; then
    WORLD_BIN="/usr/bin/worldserver"
fi

# Force turn ON the interactive console in the config file so it attaches to this terminal
if [ -f /etc/azerothcore/worldserver.conf ]; then
    sed -i 's/^Console.Enable\s*=\s*.*/Console.Enable = 1/' /etc/azerothcore/worldserver.conf
fi

echo ""
echo "======================================================================="
echo -e " 🚀 ${BOLD}BOOTING WORLDSERVER INITIALIZATION LAYER${NC}"
echo "======================================================================="
echo " The server log files will now stream live in this window."
echo " This step takes roughly 20 minutes to extract and load map vectors."
echo ""
echo " ONCE LOGS ARE COMPLETE AND YOU SEE THE 'AC>' PROMPT, RUN EXCLUSIVELY:"
echo -e "   1. ${BOLD}account create ${SETUP_USER_UPPER} ${SETUP_PASS}${NC}"
echo -e "   2. ${BOLD}server shutdown 0h0m1s${NC}"
echo -e "   3. ${BOLD}If the server does not shutdown, press Ctrl+C to terminate the process manually.${NC}"
echo ""
echo " Press [ENTER] to stream logs and initialize the application core..."
echo "======================================================================="
read -r 

# Launch the worldserver in the foreground.
# This attaches the binary straight to stdout/stdin, displaying full real-time logs!
$WORLD_BIN

echo ""
echo " -> Server shutdown caught cleanly! Processing backend account components..."

# Automatically elevate the newly created account to Master GM Status behind the scenes
# This removes the risk of the user mistyping the complex syntax values
SQL_AUTO_ELEVATE="
USE acore_auth;
INSERT INTO account_access (id, gmlevel, RealmID, comment) 
VALUES ((SELECT id FROM account WHERE username='${SETUP_USER_UPPER}'), 3, -1, 'Master GM Account');
"

if ! $MYSQL_CMD -e "$SQL_AUTO_ELEVATE" >/dev/null 2>&1; then
    echo "❌ WARNING: Database privilege elevation block returned an execution error."
    echo "            Please elevate your account level manually via the database terminal."
else
    echo " -> Account ${SETUP_USER_UPPER} elevated to Master GM status successfully!"
fi

# Secure the application configuration for systemd background use moving forward
if [ -f /etc/azerothcore/worldserver.conf ]; then
    sed -i 's/^Console.Enable\s*=\s*.*/Console.Enable = 0/' /etc/azerothcore/worldserver.conf
fi

echo " -> Configuration profiles locked down and secured."
echo ""
echo "======================================================================="
echo -e " 🎉 ${BOLD}AZEROTHCORE PROVISIONING COMPLETE!${NC}"
echo "======================================================================="
echo " Your master user has been generated and elevated safely by the core."
echo ""
echo " 1. Enable and start your server engines background daemons natively:"
echo "    sudo systemctl enable --now acore-auth-server acore-world-server"
echo ""
echo " 2. Connect directly to your live scrolling interactive server console once the server is running:"
echo "    attach-world" and use ctl+c to exit the console without stopping the server.
echo "======================================================================="