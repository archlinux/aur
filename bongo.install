post_install() {
    cat <<'EOF'
:: Bongo installed.
   GNOME (IBus): add "Bangla (Bongo)" under Settings -> Keyboard -> Input Sources.
   KDE / Hyprland / Omarchy (fcitx5): run `bongo-fcitx5-setup`, then switch with Ctrl+Space.
   Settings: launch `bongo-settings` or open Bongo from the application menu.
EOF
}

post_upgrade() {
    post_install
}
