diff --git a/kwin-snow-0.3.2/CMakeLists.txt b/kwin-snow-0.3.2/CMakeLists.txt
index 299121a..5a49420 100644
--- a/kwin-snow-0.3.2/CMakeLists.txt
+++ b/kwin-snow-0.3.2/CMakeLists.txt
@@ -82,6 +82,14 @@ set(SNOW_CONFIG_INSTALL_DIR "${SNOW_QT_PLUGIN_DIR}/kwin/effects/configs")
 
 add_subdirectory(src)
 
+# KWin 6.8 changed the paint* virtuals (and the EffectHandler pass-throughs)
+# from void to bool, where false means the paint failed (e.g. a GPU reset) and
+# the effect must stop rendering. Tell the effect which API generation it is
+# building against so its signatures match the base class.
+if(KWin_VERSION VERSION_GREATER_EQUAL 6.8.0)
+    target_compile_definitions(snow PRIVATE SNOW_KWIN_PAINT_RETURNS_BOOL)
+endif()
+
 # CTest defines BUILD_TESTING, defaulting to ON. Qt6::Test is only looked for
 # when it is actually going to be used, so building the effect never needs it.
 include(CTest)
