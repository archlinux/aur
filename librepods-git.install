post_install() {
    echo "    Set the PHONE_MAC_ADDRESS environment variable to your AirPods'"
    echo "    Bluetooth MAC address using 'export' (bash) or 'set -gx' (fish)."
    echo ""
    echo "    Make sure that your device is already paired before running"
    echo "    Librepods, as it causes issues with pairing during runtime."

    if ["ls '$HOME/.config/wireplumber' | grep -o wireplumber.conf.d" != "wireplumber.conf.d"]; then
        mkdir "$HOME/.config/wireplumber/wireplumber.conf.d/"
    fi

    cd "$HOME/.config/wireplumber/wireplumber.conf.d/"
    if ["ls | grep '51-bluez'" != "51-bluez"]; then
        touch "51-bluez-avrcp.conf"
        echo "monitor.bluez.properties = {" >>"51-bluez-avrcp.conf"
        echo "  # Enable dummy AVRCP player for proper media control support" >>"51-bluez-avrcp.conf"
        echo "  # This is required for AirPods and other devices to send play/pause/skip commands" >>"51-bluez-avrcp.conf"
        echo "  # This is required for AirPods and other devices to send play/pause/skip commands" >>"51-bluez-avrcp.conf"
        echo "}" >>"51-bluez-avrcp.conf"
        systemctl --user restart wireplumber
    fi

}
