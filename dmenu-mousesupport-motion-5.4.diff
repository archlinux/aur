 static void
+motionevent(XButtonEvent *ev)
+{
+	struct item *it;
+	int x = 0, y = 0, h = bh, w;
+
+	if (ev->window != win || matches == 0)
+		return;
+
+	if (prompt && *prompt)
+		x += promptw;
+
+	if (lines > 0) {
+		/* vertical list: hover on item */
+		w = mw - x;
+		for (it = curr; it != next; it = it->right) {
+			y += h;
+			if (ev->y >= y && ev->y <= (y + h)) {
+				sel = it;
+				drawmenu();
+				return;
+			}
+		}
+	} else if (matches) {
+		/* horizontal list: hover on item */
+		x += inputw;
+		w = TEXTW("<");
+		if (prev && curr->left) {
+			x += w;
+		}
+		for (it = curr; it != next; it = it->right) {
+			x += w;
+			w = MIN(TEXTW(it->text), mw - x - TEXTW(">"));
+			if (ev->x >= x && ev->x <= x + w) {
+				sel = it;
+				drawmenu();
+				return;
+			}
+		}
+	}
+}
