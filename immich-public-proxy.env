# Local (not public) URL of your Immich server
IMMICH_URL=http://localhost:2283
# Public URL of Immich Public Proxy
PUBLIC_BASE_URL=https://photos.example.com
# Listening port (default 3000); only reachable via loopback (see service unit)
IPP_PORT=3000

# Settings belong in /etc/immich-public-proxy/config.json.
# Do NOT set CONFIG here: if it is set, no config file is read at all.
# IPP_CONFIG is set by the service unit; overriding it here bypasses LoadCredential.

