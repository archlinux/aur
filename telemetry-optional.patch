--- a/PowerShell.Common.props
+++ b/PowerShell.Common.props
@@ -166,6 +166,12 @@
     <IsWindows Condition="'$(IsWindows)' == 'true' or ('$(IsWindows)' == '' and '$(OS)' == 'Windows_NT')">true</IsWindows>
   </PropertyGroup>
 
+  <!-- Telemetry (Microsoft.ApplicationInsights, see utils/Telemetry.cs in System.Management.Automation).
+       Building with -p:UseTelemetry=false leaves it out, so the build never sends telemetry. -->
+  <PropertyGroup Condition=" '$(UseTelemetry)' != 'false' ">
+    <DefineConstants>$(DefineConstants);TELEMETRY</DefineConstants>
+  </PropertyGroup>
