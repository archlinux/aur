diff --git a/test/powershell/engine/Basic/Telemetry.Tests.ps1 b/test/powershell/engine/Basic/Telemetry.Tests.ps1
index 0da08316a5..79d3c0eefe 100644
--- a/test/powershell/engine/Basic/Telemetry.Tests.ps1
+++ b/test/powershell/engine/Basic/Telemetry.Tests.ps1
@@ -36,11 +36,16 @@ function Get-OSTelemetryLevel {
     return 1
 }
 
+# Builds with -p:UseTelemetry=false (see PowerShell.Common.props) don't include telemetry
+function Test-TelemetryBuiltIn {
+    [psobject].Assembly.GetReferencedAssemblies().Name -contains 'Microsoft.ApplicationInsights'
+}
+
 Describe "Telemetry for shell startup" -Tag CI {
     BeforeAll {
-        $skipTelemetryTests = $false
+        $skipTelemetryTests = -not (Test-TelemetryBuiltIn)
 
-        if ($IsWindows) {
+        if ($IsWindows -and -not $skipTelemetryTests) {
             ## Skip telemetry tests if the OS telemetry level is less than 2 (Enhanced) -- PS telemetry is disabled in this case.
             $osTelemetryLevel = Get-OSTelemetryLevel
             $skipTelemetryTests = $osTelemetryLevel -lt 2
@@ -190,3 +195,38 @@ Describe "Telemetry for shell startup" -Tag CI {
         }
     }
 }
+
+Describe "Builds without telemetry" -Tag CI {
+    BeforeAll {
+        $skipTests = Test-TelemetryBuiltIn
+        if ($skipTests) {
+            $originalDefaultParameterValues = $PSDefaultParameterValues.Clone()
+            $PSDefaultParameterValues["it:skip"] = $true
+            return
+        }
+
+        $PWSH = (Get-Process -Id $PID).MainModule.FileName
+        $telemetrySet = Test-Path -Path env:POWERSHELL_TELEMETRY_OPTOUT
+        $SendingTelemetry = $env:POWERSHELL_TELEMETRY_OPTOUT
+    }
+
+    AfterAll {
+        if ($skipTests) {
+            $global:PSDefaultParameterValues = $originalDefaultParameterValues
+            return
+        }
+
+        if ( $telemetrySet ) {
+            $env:POWERSHELL_TELEMETRY_OPTOUT = $SendingTelemetry
+        }
+        else {
+            Remove-Item env:POWERSHELL_TELEMETRY_OPTOUT -ErrorAction SilentlyContinue
+        }
+    }
+
+    It "Should not send telemetry even when opted in" {
+        $env:POWERSHELL_TELEMETRY_OPTOUT = "no"
+        $result = & $PWSH -NoProfile -Command '[Microsoft.PowerShell.Telemetry.ApplicationInsightsTelemetry]::CanSendTelemetry'
+        $result | Should -Be "False"
+    }
+}
