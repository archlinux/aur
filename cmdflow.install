post_install() {
  echo -e "\n\e[1;33m==> Подсказка от cmdflow:\e[0m"
  echo -e "    По умолчанию некоторые шеллы (Fish, Bash) не записывают дубликаты команд подряд."
  echo -e "    Чтобы графики были точными, рекомендуется один раз запустить:"
  echo -e "    \e[1;32mcmdflow --fix-history\e[0m"
  echo -e "    Это автоматически настроит ваши конфиги для сохранения 100% истории.\n"
}

post_upgrade() {
  post_install
}
