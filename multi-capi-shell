#!/usr/bin/env bash

set -eu
set -o pipefail

if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
  cat <<EOF
Usage: multi-capi-shell [command...]
       multi-capi-shell --direct <kubeconfig-name> <namespace> <name> [command...]

Interactively selects a CAPI cluster from all configured management
kubeconfigs using fzf, then opens a capi-shell for the selected cluster.

With --direct, skips fzf and opens a capi-shell directly for <namespace>/<name>
using the named management kubeconfig from the config file's kubeconfigs map,
without needing fzf installed.

Arguments:
  command      Command to pass through to capi-shell (default: \$SHELL or bash)

Environment variables (override/extend config file):
  MANAGEMENT_KUBECONFIGS                    Semicolon-separated list of management kubeconfig paths
  KUBECONFIG                                Semicolon-separated management cluster kubeconfig paths (additional)
  MULTI_CAPI_SHELL_CUSTOM_COLUMN_<name>     yq expression for an extra fzf preview column (overrides config)
  MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION   yq expression for a custom cluster display name

Config file: \${XDG_CONFIG_HOME:-\$HOME/.config}/capi-shell/config.yaml
  kubeconfigs.<name>.{path,contexts}   kubeconfig sources (merged with env vars above);
                                       <name> is required to address a kubeconfig via --direct;
                                       contexts is an optional list restricting which contexts of
                                       the kubeconfig are scanned (default: all); --direct uses the
                                       first configured context, if any
  custom_fields.<name>                 jq expressions for fzf preview columns (used if no env columns set)
EOF
  exit 0
fi

_capi_config="${XDG_CONFIG_HOME:-$HOME/.config}/capi-shell/config.yaml"
declare -a _kubeconfig_paths=()
declare -a _kubeconfig_contexts=()
declare -a _kubeconfig_names=()

main() {
while IFS= read -r _kc; do
  [[ -n "$_kc" ]] && _kubeconfig_paths+=("$_kc") && _kubeconfig_contexts+=("") && _kubeconfig_names+=("")
done < <(
  [[ -v MANAGEMENT_KUBECONFIGS ]] && echo -e "${MANAGEMENT_KUBECONFIGS//;/\\n}"
  [[ -v KUBECONFIG ]] && echo -e "${KUBECONFIG//;/\\n}"
)

if [[ -f "$_capi_config" ]]; then
  while IFS= read -r _name && IFS= read -r _kc && IFS= read -r _ctx; do
    _expanded="$(envsubst <<< "$_kc")"
    if [[ -n "$_expanded" ]]; then
      _kubeconfig_paths+=("$_expanded")
      _kubeconfig_contexts+=("$_ctx")
      _kubeconfig_names+=("$_name")
    fi
  done < <(yq -r '(.kubeconfigs // {}) | to_entries[] | . as $e | (($e.value.contexts // [""]) | .[] as $ctx | ($e.key, $e.value.path, $ctx))' "$_capi_config")
fi

if [[ "${1:-}" == "--direct" ]]; then
  shift
  kubeconfig_name="${1?kubeconfig name required}"
  namespace="${2?namespace required}"
  name="${3?name required}"
  shift 3
  for _i in "${!_kubeconfig_names[@]}"; do
    if [[ -n "${_kubeconfig_names[$_i]}" ]] && [[ "${_kubeconfig_names[$_i]}" == "$kubeconfig_name" ]]; then
      if [[ -n "${_kubeconfig_contexts[$_i]}" ]]; then
        exec env KUBECONFIG="${_kubeconfig_paths[$_i]}" KUBECONFIG_CONTEXT="${_kubeconfig_contexts[$_i]}" capi-shell "$namespace" "$name" "${@}"
      else
        exec env KUBECONFIG="${_kubeconfig_paths[$_i]}" capi-shell "$namespace" "$name" "${@}"
      fi
    fi
  done
  echo "Unknown kubeconfig: $kubeconfig_name" >&2
  exit 1
fi

if ! command -v fzf &>/dev/null; then
  echo "fzf is required but not installed. Please install fzf to use this script." >&2
  exit 1
fi

_field_sep=$'\x1f'

declare -a custom_columns=()
for custom_column_var in ${!MULTI_CAPI_SHELL_CUSTOM_COLUMN_*}; do
  custom_columns+=("${!custom_column_var}")
done
if [[ "${#custom_columns[@]}" -eq 0 ]] && [[ -f "$_capi_config" ]]; then
  while IFS= read -r _expr; do
    [[ -n "$_expr" ]] && custom_columns+=("$_expr")
  done < <(yq -r '(.custom_fields // {}) | to_entries[] | select(.key != "friendly_name") | .value' "$_capi_config")
fi
if [[ "${#custom_columns[@]}" -gt 0 ]]; then
  printf -v custom_columns_string '\\(%s) | ' "${custom_columns[@]}"
else
  custom_columns_string=""
fi

if [[ ! -v MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION ]] && [[ -f "$_capi_config" ]]; then
  _friendly_expr="$(yq -r '.custom_fields.friendly_name // empty' "$_capi_config")"
  [[ -n "$_friendly_expr" ]] && MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION="$_friendly_expr"
fi
MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION="${MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION:-\"\"}"

if [[ "${#_kubeconfig_paths[@]}" -gt 0 ]]; then
  shopt -s lastpipe
  for _i in "${!_kubeconfig_paths[@]}"; do
    export KUBECONFIG="${_kubeconfig_paths[$_i]}"
    if [[ -n "${_kubeconfig_contexts[$_i]}" ]]; then
      _contexts=("${_kubeconfig_contexts[$_i]}")
    else
      mapfile -t _contexts < <(kubectl config get-contexts -o name)
    fi
    for context in "${_contexts[@]}"; do
      (kubectl --context "$context" get cluster -A -o yaml || true) | yq -r --arg kubeconfig "$KUBECONFIG" --arg context "$context" '.items | map("\($kubeconfig)'"$_field_sep"'\($context)'"$_field_sep"'\(.metadata.namespace)'"$_field_sep"'\(.metadata.name)'"$_field_sep"''"$custom_columns_string"'\(('"${MULTI_CAPI_SHELL_CUSTOM_NAME_EXPRESSION}"') as $custom_name | if $custom_name == "" then .metadata.name else "\($custom_name) (\(.metadata.name))" end)")[]'
    done
  done | fzf --sync --preview="echo {} | awk -F'${_field_sep}' '{print \$2\"@\"\$1}'" -d "$_field_sep" --with-nth=5 | IFS="$_field_sep" read -r kubeconfig_path kubeconfig_context namespace name _
  exec env KUBECONFIG="$kubeconfig_path" KUBECONFIG_CONTEXT="$kubeconfig_context" capi-shell "$namespace" "$name" "${@}"
fi
}

if ! (return 0 2>/dev/null); then
  main "$@"
fi
