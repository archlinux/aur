[Desktop Entry]
Name=MNELAB
Comment=GUI for EEG/MEG analysis with MNE-Python
Exec=mnelab %F
Icon=mnelab
Terminal=false
Type=Application
Categories=Science;Education;
StartupNotify=true
MimeType=application/x-edf;application/x-bdf;application/x-gdf;application/x-fif;application/x-set;application/x-xdf;application/x-mat;
