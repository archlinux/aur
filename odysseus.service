[Unit]
Description=Odysseus — Self-hosted AI workspace
Documentation=https://github.com/pewdiepie-archdaemon/odysseus
After=network.target
Wants=network.target

[Service]
Type=simple
User=odysseus
Group=odysseus
WorkingDirectory=/opt/odysseus
EnvironmentFile=/etc/odysseus/odysseus.env
ExecStartPre=/bin/bash -c 'if [ ! -f /var/lib/odysseus/.setup_done ]; then \
    python /opt/odysseus/setup.py && \
    touch /var/lib/odysseus/.setup_done; fi'
ExecStart=/usr/bin/python -m uvicorn app:app \
    --host ${APP_BIND} \
    --port ${APP_PORT}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/odysseus /opt/odysseus/data /var/log/odysseus
ProtectHome=true

[Install]
WantedBy=multi-user.target
