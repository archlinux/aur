post_install() {
    echo ""
    echo "==> Omazed installed successfully!"
    echo ""
    echo "🚀 To complete setup, run:"
    echo "   omazed setup"
    echo ""
    echo "   This will:"
    echo "   • Copy themes to ~/.config/zed/themes/"
    echo "   • Set up omarchy hook integration (or systemd fallback)"
    echo "   • Test the installation"
    echo ""
    echo "Then change your Omarchy theme and watch Zed follow along!"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> Omazed updated to $(pacman -Q omazed | cut -d' ' -f2)"
    echo ""
    echo "🔄 Migration to omarchy hooks:"
    echo ""
    echo "   This version uses the new omarchy hook system instead of systemd."
    echo "   To migrate, run:"
    echo ""
    echo "   omazed setup"
    echo ""
    echo "   This will:"
    echo "   • Detect your existing systemd setup"
    echo "   • Migrate to omarchy hooks automatically"
    echo "   • Stop and disable the old systemd service"
    echo ""
    echo "   If you want to keep using systemd (if omarchy hooks aren't available),"
    echo "   you can instead run:"
    echo ""
    echo "   omazed reload"
    echo ""
    echo "   Your themes and settings will be preserved during migration."
    echo ""
}

post_remove() {
    echo ""
    echo "==> Omazed removed."
    echo ""
    echo "Preserved files:"
    echo "   • Theme files in ~/.config/zed/themes/ (preserved)"
    echo "   • User configuration files (preserved)"
    echo ""
    echo "Manual cleanup (if needed):"
    echo ""
    echo "   # If using systemd (old method):"
    echo "   systemctl --user stop omazed.service"
    echo "   systemctl --user disable omazed.service"
    echo "   rm ~/.config/systemd/user/omazed.service"
    echo ""
    echo "To remove themes:"
    echo "   rm ~/.config/zed/themes/{catppuccin,everforest,gruvbox,kanagawa,matte-black,nord,osaka-jade,ristretto,rose-pine,tokyo-night}*.json"
    echo ""
    echo "Thank you for using Omazed!"
    echo ""
}
