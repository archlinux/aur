# OpenChronology GitHub receiver: /etc/openchronology/github.env
# See /usr/share/doc/openchronology-server/github.md. Then:
#   sudo systemctl enable --now openchronology-github
# It runs as the openchronology-logs user: the routes file must be readable by it, for example
# owned by root:openchronology-logs with mode 0640. och-import-github reads this file too.

# The platform on this machine (its HOST and PORT in openchronology.env).
OCH_API_URL=http://127.0.0.1:5173
# A read/write API key (Account -> API keys) of an account that can write the routed timelines.
OCH_API_KEY=
# The webhook's secret: the same value as in the webhook's settings on GitHub.
GITHUB_WEBHOOK_SECRET=
# For Forgejo or Gitea webhooks, their secret, and for GitLab's, their secret token (any of
# these may be left empty).
FORGEJO_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
# Routing rules: which repositories go to which timeline.
GITHUB_ROUTES=/etc/openchronology/github-routes.json
# Address and port for GitHub's deliveries, behind a reverse proxy that provides HTTPS.
GITHUB_HOST=127.0.0.1
GITHUB_PORT=5580
# Where it remembers each item's column on a project board, across restarts.
GITHUB_STATE=/var/lib/openchronology-github/github-state.json
# A token that can read the repositories: it names the items of project board moves, and lets
# och-import-github read private repositories, with GitHub's higher rate limit.
GITHUB_TOKEN=
# GitHub Enterprise's API, such as https://github.example.com/api/v3.
#GITHUB_API_URL=
# A Forgejo or Gitea token, for och-import-github to read private repositories there.
#FORGEJO_TOKEN=
# A GitLab token (read_api), for och-import-github to read a project's events, notes and
# milestones, which GitLab keeps from readers without one.
#GITLAB_TOKEN=
