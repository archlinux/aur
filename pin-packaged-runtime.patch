index afc3e74..b8f3aee 100644
--- a/apps/desktop/electron/active-runtime-state.test.ts
+++ b/apps/desktop/electron/active-runtime-state.test.ts
@@ -58,3 +58,33 @@ test('a repair that deleted the marker does not strand a healthy install', () =>
   // usability, not marker presence, must decide the next boot.
   assert.equal(classifyActiveRuntime(null, 1, true).shouldUseActiveRuntime, true)
 })
+
+test('a package-managed runtime is rejected when its checkout commit differs from the desktop pin', () => {
+  const expectedCommit = 'a'.repeat(40)
+  const activeCommit = 'b'.repeat(40)
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, { activeCommit, expectedCommit })
+
+  assert.deepEqual(state, {
+    hasValidMarker: true,
+    shouldUseActiveRuntime: false,
+    usabilityReason: 'commit-mismatch'
+  })
+})
+
+test('a fallback install stamp does not reject a healthy package-managed runtime', () => {
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, {
+    activeCommit: 'a'.repeat(40),
+    expectedCommit: '0'.repeat(40)
+  })
+
+  assert.equal(state.shouldUseActiveRuntime, true)
+})
+
+test('an invalid install stamp does not reject a healthy package-managed runtime', () => {
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, {
+    activeCommit: 'a'.repeat(40),
+    expectedCommit: 'not-a-commit'
+  })
+
+  assert.equal(state.shouldUseActiveRuntime, true)
+})
