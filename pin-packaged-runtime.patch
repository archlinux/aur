index afc3e74b..40dd193f 100644
--- a/apps/desktop/electron/active-runtime-state.test.ts
+++ b/apps/desktop/electron/active-runtime-state.test.ts
@@ -58,3 +58,57 @@ test('a repair that deleted the marker does not strand a healthy install', () =>
   // usability, not marker presence, must decide the next boot.
   assert.equal(classifyActiveRuntime(null, 1, true).shouldUseActiveRuntime, true)
 })
+
+test('a package-managed runtime is rejected when its checkout commit differs from the desktop pin', () => {
+  const expectedCommit = 'a'.repeat(40)
+  const activeCommit = 'b'.repeat(40)
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, { activeCommit, expectedCommit })
+
+  assert.deepEqual(state, {
+    hasValidMarker: true,
+    shouldUseActiveRuntime: false,
+    usabilityReason: 'commit-mismatch'
+  })
+})
+
+test('a fallback install stamp does not reject a healthy package-managed runtime', () => {
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, {
+    activeCommit: 'a'.repeat(40),
+    expectedCommit: '0'.repeat(40)
+  })
+
+  assert.equal(state.shouldUseActiveRuntime, true)
+})
+
+test('an invalid install stamp does not reject a healthy package-managed runtime', () => {
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, {
+    activeCommit: 'a'.repeat(40),
+    expectedCommit: 'not-a-commit'
+  })
+
+  assert.equal(state.shouldUseActiveRuntime, true)
+})
+
+test('a matching checkout without the package policy still needs bootstrap', () => {
+  const state = classifyActiveRuntime(VALID_MARKER, 1, true, {
+    expectedCommit: 'a'.repeat(40), activeCommit: 'a'.repeat(40), packagePatchReady: false
+  })
+  assert.equal(state.shouldUseActiveRuntime, false)
+  assert.equal(state.usabilityReason, 'package-patch-missing')
+})
+
+test('only a healthy, fully bootstrapped runtime at the package pin qualifies for policy-only refresh', () => {
+  const commit = VALID_MARKER.pinnedCommit
+  const policy = { expectedCommit: commit, activeCommit: commit, packagePatchReady: false }
+  assert.equal(classifyActiveRuntime(VALID_MARKER, 1, true, policy).policyOnly, true)
+  for (const [marker, usable, overrides] of [
+    [null, true, {}],
+    [{ ...VALID_MARKER, schemaVersion: 0 }, true, {}],
+    [{ ...VALID_MARKER, pinnedCommit: 'b'.repeat(40) }, true, {}],
+    [VALID_MARKER, false, {}],
+    [VALID_MARKER, true, { activeCommit: 'b'.repeat(40) }],
+    [VALID_MARKER, true, { expectedCommit: '0'.repeat(40), activeCommit: '0'.repeat(40) }]
+  ] as const) {
+    assert.equal(classifyActiveRuntime(marker, 1, usable, { ...policy, ...overrides }).policyOnly, false)
+  }
+})
