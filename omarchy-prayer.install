post_install() {
  cat <<'EOF'
:: omarchy-prayer installed. Run this once as your user:

    omarchy-prayer

It will:
  - geolocate via IP and seed ~/.config/omarchy-prayer/config.toml
  - download the default Makkah (+ Madinah for Fajr) adhan audio
  - inject the custom/prayer widget into ~/.config/waybar/config.jsonc
    (your original is backed up to config.jsonc.bak.omarchy-prayer-<ts>)
  - enable the --user schedule timer + resume hook

Re-run setup at any time:
    omarchy-prayer setup

Optional Hyprland keybind (append to ~/.config/hypr/bindings.conf):
    bind = SUPER CTRL, M, exec, omarchy-prayer-stop
EOF
}

post_upgrade() {
  cat <<'EOF'
:: omarchy-prayer upgraded.

  - Run `omarchy-prayer setup` once to apply any new defaults (waybar widget,
    default adhans, systemd units) if you haven't already.
  - If the waybar module's JSON shape changed, reload waybar:
      pkill -SIGUSR2 waybar
EOF
}

post_remove() {
  cat <<'EOF'
:: omarchy-prayer removed. Your config and cached times are preserved at:
    ~/.config/omarchy-prayer/
    ~/.local/state/omarchy-prayer/
    ~/.local/share/omarchy-prayer/adhans/
Delete them manually if you want a clean uninstall. Also remember to:
    systemctl --user disable --now omarchy-prayer-schedule.timer
    systemctl --user disable omarchy-prayer-resume.service
EOF
}
