post_install() {
    echo ""
    echo "╔══════════════════════════════════════════════════════╗"
    echo "║               securecopy installed!                  ║"
    echo "╠══════════════════════════════════════════════════════╣"
    echo "║  Binaries: crccp  crcmv  crcsum                      ║"
    echo "║                                                      ║"
    echo "║  To use as drop-in replacements, add to your shell:  ║"
    echo "║                                                      ║"
    echo "║    alias cp='crccp'                                  ║"
    echo "║    alias mv='crcmv'                                  ║"
    echo "║                                                      ║"
    echo "║  Key flags:                                          ║"
    echo "║    -c   verify CRC after copy/move                   ║"
    echo "║    -cx  verify + store CRC in xattr                  ║"
    echo "║    -v   verbose (shows CRC values)                   ║"
    echo "║                                                      ║"
    echo "║  Docs: /usr/share/doc/securecopy/                    ║"
    echo "╚══════════════════════════════════════════════════════╝"
    echo ""
}

post_upgrade() {
    post_install
}
