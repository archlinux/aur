[Desktop Entry]
Version=1.0
Name=Note Liber
Comment=Note Liber is a simple sticky notes app for Linux.
Exec=/usr/bin/note-liber
Icon=/usr/share/icons/hicolor/256x256/apps/note-liber.png
Terminal=false
Type=Application
Categories=Utility;
StartupNotify=true
StartupWMClass=note-liber
X-KDE-SubstituteUID=false