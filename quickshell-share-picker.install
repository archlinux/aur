# shellcheck shell=bash

post_install() {
  if [ ! -x /usr/bin/quickshell-share-picker-setup ]; then
    return
  fi
  cat <<'EOF'
:: XDPH configuration is user-scoped and was not changed automatically.
:: As your Hyprland desktop user (without sudo), run:
::   quickshell-share-picker-setup install
EOF
}

post_upgrade() {
  if [ "$(vercmp "$2" '0.2.0-1')" -lt 0 ]; then
    post_install
  fi
}
