+static int vpu_register_map_size(struct mt_chip *chip,
+				 struct mtgpu_device *mtdev, u32 *map_size)
+{
+	struct pci_dev *pci = chip->pdev;
+	u64 display_offset = ~0ULL;
+	u32 i;
+
+	*map_size = chip->conf.regs_chip_size;
+	if (!pci || pci->vendor != 0x1ed5 || pci->device != 0x0102 ||
+	    chip->driver_mode == MTGPU_DRIVER_MODE_GUEST)
+		return 0;
+
+	/* Validate against the actual child resources, not the current BAR
+	 * address (which may move on the next boot).
+	 */
+	for (i = 0; i < mtdev->disp_cnt; i++) {
+		struct resource *res;
+		u64 offset;
+
+		if (!mtdev->disp_dev[i])
+			continue;
+		res = platform_get_resource_byname(mtdev->disp_dev[i],
+						  IORESOURCE_MEM, "dispc-regs");
+		if (!res)
+			continue;
+		if (res->start < pci_resource_start(pci, 0))
+			return -ERANGE;
+		offset = res->start - pci_resource_start(pci, 0);
+		if (offset < display_offset)
+			display_offset = offset;
+	}
+	return mtgpu_s30_vpu_map_size(&chip->conf, pci_resource_len(pci, 0),
+				     display_offset, map_size);
+}
 
