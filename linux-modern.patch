+	__ATTR(mem_info_vram_used, 0444, dev_vram_used_show, NULL);
+
+int mtgpu_hwmon_init(struct pci_dev *pdev)
+{
+	struct mtgpu_device *mtdev = pci_get_drvdata(pdev);
+	struct device *hwmon_dev;
+	int ret;
+
+	if (!mtdev)
+		return -EINVAL;
+
+	/* 1. Register with hwmon subsystem */
+	hwmon_dev = devm_hwmon_device_register_with_groups(&pdev->dev, "mtgpu",
+							   mtdev, mtgpu_hwmon_groups);
+	if (IS_ERR(hwmon_dev)) {
+		dev_warn(&pdev->dev, "Failed to register mtgpu hwmon device: %ld\n",
+			 PTR_ERR(hwmon_dev));
+		/* non-fatal */
+	} else {
+		dev_info(&pdev->dev, "Registered mtgpu hwmon sensors\n");
+	}
+
+	/* 2. Create device-level VRAM attributes for DRM tooling */
+	ret = device_create_file(&pdev->dev, &dev_attr_mem_info_vram_total);
+	if (ret)
+		dev_dbg(&pdev->dev, "Failed to create dev mem_info_vram_total sysfs\n");
+
+	ret = device_create_file(&pdev->dev, &dev_attr_mem_info_vram_used);
+	if (ret)
+		dev_dbg(&pdev->dev, "Failed to create dev mem_info_vram_used sysfs\n");
+
+	ret = device_create_file(&pdev->dev, &dev_attr_gpu_busy_percent);
+	if (ret)
+		dev_dbg(&pdev->dev, "Failed to create dev gpu_busy_percent sysfs\n");
+	ret = device_create_file(&pdev->dev, &dev_attr_pp_dpm_sclk);
+	if (ret)
+		dev_dbg(&pdev->dev, "Failed to create dev pp_dpm_sclk sysfs\n");
+
+	ret = device_create_file(&pdev->dev, &dev_attr_pp_dpm_mclk);
+	if (ret)
+		dev_dbg(&pdev->dev, "Failed to create dev pp_dpm_mclk sysfs\n");
+
+	return 0;
+}
+
+void mtgpu_hwmon_fini(struct pci_dev *pdev)
+{
+	device_remove_file(&pdev->dev, &dev_attr_mem_info_vram_used);
+	device_remove_file(&pdev->dev, &dev_attr_mem_info_vram_total);
+	device_remove_file(&pdev->dev, &dev_attr_gpu_busy_percent);
+	device_remove_file(&pdev->dev, &dev_attr_pp_dpm_mclk);
+	device_remove_file(&pdev->dev, &dev_attr_pp_dpm_sclk);
+}
