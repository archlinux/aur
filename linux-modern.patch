diff -Nurp a/src/mtgpu/mtgpu_hwmon.c b/src/mtgpu/mtgpu_hwmon.c
--- a/src/mtgpu/mtgpu_hwmon.c	1970-01-01 08:00:00.000000000 +0800
+++ b/src/mtgpu/mtgpu_hwmon.c	2026-11-11 11:20:00.000000000 +0800
@@ -0,0 +1,495 @@
+/*
+ * MTT S30 Hardware Monitoring (hwmon) support
+ * Integrates Moore Threads S30 telemetry with Linux standard hwmon subsystem.
+ * Supports KDE System Monitor, btop, lm-sensors, MangoHud, etc.
+ */
+
+#include <linux/device.h>
+#include <linux/hwmon.h>
+#include <linux/hwmon-sysfs.h>
+#include <linux/pci.h>
+#include <linux/types.h>
+
+#include "mtgpu.h"
+#include "mtgpu_drv.h"
+#include "mtgpu_smc.h"
+#include "mtgpu_board_cfg.h"
+#include "uapi_common.h"
+#include "pvrsrv.h"
+#include "mtgpu_hwmon.h"
+
+extern void mtgpu_get_global_mem_stats(struct mtgpu_device *mtdev, DEVICE_DRIVER_STATS_INFO *stats);
+
+/* --- Temperature Sensors --- */
+
+static ssize_t temp1_input_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	u32 temp = 0;
+	u32 pvt = 0;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	if (mtdev->board_configs)
+		pvt = (u32)mtdev->board_configs->board_cap.board_sys.pvt_type;
+
+	ret = mtgpu_smc_get_temp(mtdev->dev, pvt, &temp);
+	if (ret && pvt != 0)
+		ret = mtgpu_smc_get_temp(mtdev->dev, 0, &temp);
+	if (ret)
+		ret = mtgpu_smc_get_ddr_temp(mtdev->dev, &temp);
+	if (ret)
+		return ret;
+
+	/* hwmon temperature is reported in millidegrees Celsius */
+	return scnprintf(buf, PAGE_SIZE, "%u\n", temp * 1000);
+}
+
+static ssize_t temp1_label_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "GPU Core\n");
+}
+
+static ssize_t temp1_max_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	struct ipc_msg_thermal_limit_info tinfo;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	memset(&tinfo, 0, sizeof(tinfo));
+	ret = mtgpu_smc_get_temp_limit(mtdev->dev, &tinfo);
+	if (!ret && tinfo.cur_slowdown)
+		return scnprintf(buf, PAGE_SIZE, "%u\n", tinfo.cur_slowdown * 1000);
+	if (!ret && tinfo.def_slowdown)
+		return scnprintf(buf, PAGE_SIZE, "%u\n", tinfo.def_slowdown * 1000);
+
+	return scnprintf(buf, PAGE_SIZE, "95000\n");
+}
+
+static ssize_t temp1_crit_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	struct ipc_msg_thermal_limit_info tinfo;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	memset(&tinfo, 0, sizeof(tinfo));
+	ret = mtgpu_smc_get_temp_limit(mtdev->dev, &tinfo);
+	if (!ret && tinfo.cur_shutdown)
+		return scnprintf(buf, PAGE_SIZE, "%u\n", tinfo.cur_shutdown * 1000);
+	if (!ret && tinfo.def_shutdown)
+		return scnprintf(buf, PAGE_SIZE, "%u\n", tinfo.def_shutdown * 1000);
+
+	return scnprintf(buf, PAGE_SIZE, "105000\n");
+}
+
+static ssize_t temp2_input_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	u32 temp = 0;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	ret = mtgpu_smc_get_ddr_temp(mtdev->dev, &temp);
+	if (ret)
+		return ret;
+
+	return scnprintf(buf, PAGE_SIZE, "%u\n", temp * 1000);
+}
+
+static ssize_t temp2_label_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "GPU Memory\n");
+}
+
+/* --- Fan Control & PWM --- */
+
+static ssize_t pwm1_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	u32 duty = 0;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	ret = mtgpu_smc_get_fan_speed(mtdev->dev, 1, 0, &duty);
+	if (ret)
+		return ret;
+
+	if (duty > 100)
+		duty = 100;
+
+	/* Scale duty percentage (0-100) to standard hwmon PWM (0-255) */
+	return scnprintf(buf, PAGE_SIZE, "%u\n", (duty * 255) / 100);
+}
+
+static ssize_t pwm1_enable_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "2\n"); /* 2 = automatic */
+}
+
+/* --- Clock Frequencies --- */
+
+static ssize_t freq1_input_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	s64 freq = 0;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	freq = mtgpu_smc_get_frequence(mtdev->dev, CLK_DOMAIN_GPU, 0);
+	if (freq <= 0) {
+		u32 core_clk = mtgpu_smc_get_gpu_core_clk(mtdev);
+		if (core_clk > 0)
+			freq = (s64)core_clk * 1000000ULL;
+	}
+
+	if (freq <= 0)
+		return -EIO;
+
+	return scnprintf(buf, PAGE_SIZE, "%lld\n", freq);
+}
+
+static ssize_t freq1_label_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "GPU Core Clock\n");
+}
+
+static ssize_t freq2_input_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	s64 freq = 0;
+	u32 ddr_clk = 0, max_ddr_clk = 0;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	freq = mtgpu_smc_get_frequence(mtdev->dev, CLK_DOMAIN_DDR, 0);
+	if (freq <= 0) {
+		ret = mtgpu_smc_get_mem_clk(mtdev->dev, &ddr_clk, &max_ddr_clk);
+		if (!ret && ddr_clk > 0)
+			freq = (s64)ddr_clk * 1000000ULL;
+	}
+
+	if (freq <= 0)
+		return -EIO;
+
+	return scnprintf(buf, PAGE_SIZE, "%lld\n", freq);
+}
+
+static ssize_t freq2_label_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "VRAM Clock\n");
+}
+
+/* --- Power and Voltage --- */
+
+static ssize_t power1_average_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct mtgpu_device *mtdev = dev_get_drvdata(dev);
+	u32 power = 0;
+	int ret;
+
+	if (!mtdev || !mtdev->dev)
+		return -ENODEV;
+
+	ret = mtgpu_smc_get_power(mtdev->dev, 0, &power);
+	if (ret)
+		return ret;
+
+	/* Power reported in microwatts */
+	return scnprintf(buf, PAGE_SIZE, "%llu\n", (u64)power * 1000);
+}
+
