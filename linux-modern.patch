diff -Nurp a/inc/s30_runtime_compat.h b/inc/s30_runtime_compat.h
--- a/inc/s30_runtime_compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/inc/s30_runtime_compat.h	2026-11-10 16:56:53.772500561 +0800
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MTGPU_S30_RUNTIME_COMPAT_H
+#define MTGPU_S30_RUNTIME_COMPAT_H
+
+#include <linux/io.h>
+#include <linux/iopoll.h>
+
+#define MT_S30_DISPC_CONTROL 0x00
+#define MT_S30_DISPC_STATUS  0x18
+#define MT_S30_DISPC_MASK    0x1c
+#define MT_S30_DISPC_ENABLE  BIT(0)
+#define MT_S30_DISPC_STOPPED BIT(8)
+
+/* Only for the reviewed SUDI/DB9000 firmware handover, before registering
+ * the ISR. The vendor stop() waits for an ISR which is not enabled yet.
+ * Observe the raw hardware completion instead; never synthesize disable_done.
+ */
+static int mtgpu_s30_stop_firmware(void __iomem *regs)
+{
+	u32 control, status;
+	int ret;
+
+	if (!regs)
+		return -EINVAL;
+	control = readl(regs + MT_S30_DISPC_CONTROL);
+	if (control == ~0U)
+		return -ENODEV;
+	/* Firmware interrupts must stay masked until DRM initialization. */
+	writel(0, regs + MT_S30_DISPC_MASK);
+	readl(regs + MT_S30_DISPC_MASK);
+	if (!(control & MT_S30_DISPC_ENABLE))
+		return 0;
+
+	/* W1C only a stale stop event, preserving unrelated status bits. */
+	writel(MT_S30_DISPC_STOPPED, regs + MT_S30_DISPC_STATUS);
+	readl(regs + MT_S30_DISPC_STATUS);
+	writel(control & ~MT_S30_DISPC_ENABLE, regs + MT_S30_DISPC_CONTROL);
+	readl(regs + MT_S30_DISPC_CONTROL);
+	ret = readl_poll_timeout(regs + MT_S30_DISPC_STATUS, status,
+				 status & MT_S30_DISPC_STOPPED, 1000, 500000);
+	if (ret)
+		return ret;
+	if (status == ~0U)
+		return -ENODEV;
+	writel(MT_S30_DISPC_STOPPED, regs + MT_S30_DISPC_STATUS);
+	readl(regs + MT_S30_DISPC_STATUS);
+	return 0;
+}
+
+#endif
diff -Nurp a/inc/s30_vpu_compat.h b/inc/s30_vpu_compat.h
--- a/inc/s30_vpu_compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/inc/s30_vpu_compat.h	2026-11-10 16:56:53.772573350 +0800
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MTGPU_S30_VPU_COMPAT_H
+#define MTGPU_S30_VPU_COMPAT_H
+
+/* Called only for PCI 1ed5:0102, native/host, using the pinned 3.1.0 blob.
+ * Three core windows end at 0xc000; the TOP page is 0xd000..0xdfff.
+ * The vendor's extra page at 0xe000 belongs to DISPC, not the VPU.
+ * Keep the vendor configuration/ABI intact; limit only the Linux mapping.
+ */
+static int mtgpu_s30_vpu_map_size(const struct mt_conf *conf,
+				u64 bar_size, u64 display_offset, u32 *size)
+{
+	unsigned int i;
+	const u32 end = 0xe000;
+
+	if (conf->type != TYPE_SUDI || conf->regs_base != 0x108000 ||
+	    conf->regs_chip_size != 0xf000 || conf->core_size != 3 ||
+	    conf->regs_top_offset != 0xd000 || conf->regs_ata_offset != 0 ||
+	    conf->product[0] != CODA980_CODE ||
+	    conf->product[1] != WAVE517_CODE ||
+	    conf->product[2] != WAVE627_CODE)
+		return -EINVAL;
+	for (i = 0; i < conf->core_size; i++)
+		if (conf->regs_core_size[i] != 0x4000)
+			return -EINVAL;
+	if (bar_size < conf->regs_base || end > bar_size - conf->regs_base ||
+	    display_offset != 0x116000 ||
+	    (u64)conf->regs_base + end > display_offset)
+		return -ERANGE;
+	*size = end;
+	return 0;
+}
+
+#endif
diff -Nurp a/inc/workqueue_compat.h b/inc/workqueue_compat.h
--- a/inc/workqueue_compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/inc/workqueue_compat.h	2026-11-10 16:56:53.772635800 +0800
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef MT_WORKQUEUE_COMPAT_H
+#define MT_WORKQUEUE_COMPAT_H
+
+#include <linux/workqueue.h>
+
+static inline unsigned int mt_legacy_workqueue_flags(unsigned int flags)
+{
+#if defined(OS_ENUM_WQ_PERCPU_EXIST)
+	/* The vendor ABI predates explicit WQ_PERCPU. Preserve its bound
+	 * default, without changing callers that already select a queue type.
+	 * WQ_PERCPU is an enum, so detect it by compiling, not with #ifdef.
+	 */
+	if (!(flags & (WQ_PERCPU | WQ_UNBOUND)))
+		flags |= WQ_PERCPU;
+#endif
+	return flags;
+}
+
+#endif
