+/* Helper to retrieve PowerVR / MUSA device node for utilization stats */
+static PVRSRV_DEVICE_NODE *mtgpu_get_pvr_node(void)
+{
+	PVRSRV_DEVICE_NODE *node = PVRSRVGetDeviceInstanceByOSId(128);
+	int i;
+
+	if (node)
+		return node;
+
+	node = PVRSRVGetDeviceInstanceByOSId(0);
+	if (node)
+		return node;
+
+	for (i = 129; i < 136; i++) {
+		node = PVRSRVGetDeviceInstanceByOSId(i);
+		if (node)
+			return node;
+	}
+
+	for (i = 1; i < 8; i++) {
+		node = PVRSRVGetDeviceInstanceByOSId(i);
+		if (node)
+			return node;
+	}
+
+	return NULL;
+}
+
+static ssize_t dev_gpu_busy_percent_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	PVRSRV_DEVICE_NODE *psDeviceNode = mtgpu_get_pvr_node();
+	DEVICE_STATUS_INFO status_info;
+	PVRSRV_ERROR eError;
+	u32 busy_percent = 0;
+
+	if (psDeviceNode) {
+		memset(&status_info, 0, sizeof(status_info));
+		eError = GpuStatusExport(psDeviceNode, &status_info);
+		if (eError == PVRSRV_OK) {
+			busy_percent = status_info.aui32GpuUtil[GPU_UTIL_ITEM_IDX_OVERALL_UTIL];
+			if (busy_percent > 100)
+				busy_percent = 100;
+		}
+	}
+
+	return scnprintf(buf, PAGE_SIZE, "%u\n", busy_percent);
+}
