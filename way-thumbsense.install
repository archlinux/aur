post_install() {
    cat <<'EOF'

==> way-thumbsense requires read access to /dev/input/event* and write
    access to /dev/uinput. The recommended setup:

    1. Add yourself to the 'input' group:
         sudo usermod -aG input "$USER"

    2. Allow the 'input' group to access /dev/uinput via udev rule:
         echo 'KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"' | \
             sudo tee /etc/udev/rules.d/99-uinput.rules
         sudo udevadm control --reload-rules
         sudo udevadm trigger

    3. Log out and back in for group membership to take effect.

    See https://github.com/nagamine-git/way-thumbsense for usage.

EOF
}

post_upgrade() {
    :
}

post_remove() {
    :
}
