#!/usr/bin/env python3
import os
import platform

# Color definitions (Standard ANSI Escape Codes)
BLUE = "\033[38;5;111m"
CYAN = "\033[38;5;117m"
WHITE = "\033[38;5;255m"
RESET = "\033[0m"

# 1. Gather real system metrics
try:
    user = os.getlogin()
except Exception:
    user = os.environ.get("USER", "user")

host = platform.node()
os_name = "Arch Linux x86_64"
kernel = platform.release()
shell = os.environ.get("SHELL", "").split("/")[-1]

# Calculate real RAM usage via /proc/meminfo
try:
    with open('/proc/meminfo', 'r') as f:
        lines = f.readlines()
    mem_total_kb = int([x for x in lines if "MemTotal" in x].split()[1])
    mem_avail_kb = int([x for x in lines if "MemAvailable" in x].split()[1])
    ram_used = round((mem_total_kb - mem_avail_kb) / 1024 / 1024, 2)
    ram_total = round(mem_total_kb / 1024 / 1024, 2)
except Exception:
    ram_used, ram_total = 0.0, 0.0

# 2. Arch Linux ASCII Logo
logo = [
    r"       /\       ",
    r"      /  \      ",
    r"     /\   \     ",
    r"    /      \    ",
    r"   /   _    \   ",
    r"  /   _     _\  ",
    r" /_  /  _  /  \_",
    r"/_ _/  /_ _/  /_"
]

# 3. System info definitions using English variables
info = [
    f"{BLUE}{user}{WHITE}@{CYAN}{host}{RESET}",
    f"{WHITE}-------------------------{RESET}",
    f"{BLUE}OS: {RESET}{os_name}",
    f"{BLUE}Kernel: {RESET}{kernel}",
    f"{BLUE}Shell: {RESET}{shell}",
    f"{BLUE}Memory: {RESET}{ram_used} GiB / {ram_total} GiB",
    f"{BLUE}Terminal: {RESET}Kitty"
]

# 4. Print layout side-by-side
for i in range(max(len(logo), len(info))):
    l = logo[i] if i < len(logo) else " " * 16
    r = info[i] if i < len(info) else ""
    print(f"{BLUE}{l}{RESET}  {r}")
