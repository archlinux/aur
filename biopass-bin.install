_biopass_run_config_migration() {
  helper="/usr/bin/biopass-helper"
  if [ ! -x "${helper}" ]; then
    return 0
  fi

  while IFS=: read -r username _ _ _ _ home _; do
    [ -n "${username}" ] || continue
    [ -n "${home}" ] || continue

    config_path="${home}/.config/com.ticklab.biopass/config.yaml"
    if [ -f "${config_path}" ]; then
      echo ">>> Biopass: migrating config schema for user '${username}'"
      "${helper}" migrate --username "${username}" || true
    fi
  done < /etc/passwd
}

_biopass_run_post_install() {
  script="/usr/share/com.ticklab.biopass/download_models.sh"

  if command -v ldconfig >/dev/null 2>&1; then
    ldconfig
  fi

  _biopass_run_config_migration

  if [ ! -f "${script}" ]; then
    echo ">>> Biopass: model downloader not found at ${script}"
    return
  fi

  echo ">>> Biopass: running model downloader"
  bash "${script}" || \
    echo ">>> Biopass: automatic model download failed; run ${script} as your normal user."
}

post_install() {
  _biopass_run_post_install
  echo ""
  echo ">>> Biopass PAM module has been installed to /usr/lib/security/libbiopass_pam.so"
  echo ">>> To enable Biopass authentication, you need to MANUALLY edit /etc/pam.d/system-auth"
  echo ">>> (or other relevant files like /etc/pam.d/sudo)."
  echo ">>> "
  echo ">>> WARNING: Keep a root terminal (sudo -s or tty) open while testing to avoid being locked out!"
  echo ">>> "
  echo ">>> Suggested configuration (insert before pam_unix.so):"
  echo ">>>   auth [success=2 default=ignore] libbiopass_pam.so"
  echo ">>>   auth [success=1 default=ignore] pam_unix.so nullok"
  echo ">>>   auth requisite pam_deny.so"
  echo ">>> "
  echo ">>> For more details, see: https://github.com/TickLabVN/biopass/blob/main/docs/PAM.md"
  echo ""
}

post_upgrade() {
  _biopass_run_post_install
}

post_remove() {
  if command -v ldconfig >/dev/null 2>&1; then
    ldconfig
  fi
}
