def cmd_list(args):
    servers = muse_servers()
    warn_legacy()
    if args.json:
        print(json.dumps(servers, indent=2))
        return 0
    if not servers:
        print("No MCP servers configured in muse.")
        print(f"({MUSE_SETTINGS})")
        return 0
    print(f"Muse MCP servers ({len(servers)}):")
    for name in sorted(servers):
        e = servers[name]
        transport = e.get("transport", "?")
        enabled = e.get("enabled", True)
        state = green("enabled") if enabled else dim("disabled")
        if transport == "stdio":
            detail = " ".join(shlex.quote(p) for p in [e.get("command", "?")] + list(e.get("args", [])))
        else:
            detail = e.get("url", "?")
        extra = dim(f" [{len(e.get('env', {}))} env]") if e.get("env") else ""
        print(f"  {bold(name)}  {dim(transport)}  {state}\n    {dim(detail)}{extra}")
    return 0

def cmd_status(args):
    print(f"muse: {MUSE_SETTINGS}")
    existing = muse_servers()
    print(f"  {len(existing)} server(s): "
          + (", ".join(sorted(existing)) if existing else dim("none")))
    warn_legacy()
    print()
    for name, spec in SOURCES.items():
        found = [p for p in spec["paths"] if os.path.exists(p)]
        if not found:
            print(f"  {dim('○')} {bold(name)}: not found")
            continue
        total = 0
        for p in found:
            result, _ = spec["read"](p)
            total += len(result) if result else 0
        print(f"  {green('●')} {bold(name)}: {total} server(s) in "
              + ", ".join(found))
    return 0
def cmd_import(args):
    wanted = args.sources or ["auto"]
    if wanted == ["auto"]:
        wanted = [n for n, s in SOURCES.items()
                  if any(os.path.exists(p) for p in s["paths"])]
        if not wanted:
            die("no known agent configs found (looked for opencode, codex, claude, agy)")
    for w in wanted:
        if w not in SOURCES:
            die(f"unknown source '{w}' (choose from: {', '.join(SOURCES)})", code=2)

    gathered = {}
    for name in wanted:
        servers, used, errors = collect_source(name, args.from_path)
        for e in errors:
            warn(e)
        if args.from_path and not used:
            die(f"no servers read from {args.from_path}")
        for s in servers:
            if args.names and s["name"] not in args.names:
                continue
            if s["name"] in gathered:
                warn(f"'{s['name']}' also in {gathered[s['name']]['source']}; "
                     f"{name} wins")
            gathered[s["name"]] = s
    if not gathered:
        print("Nothing to import.")
        return 0

    if args.enable:
        for s in gathered.values():
            s["enabled"] = True
    elif args.disable:
        for s in gathered.values():
            s["enabled"] = False

    settings = load_settings()
    # Migrate first so the skip-check below sees every configured name:
    # re-running an import then skips instead of duplicating, and the file
    # never ends up with both keys (which disables all MCP natively).
    moved, conflicts = migrate_legacy_key(settings)
    servers = settings.setdefault(CANONICAL_KEY, {})

    remote_warn = False
    added, skipped, overwritten = [], [], []
    for s in gathered.values():
        if s["transport"] == "remote":
            remote_warn = True
        if s["name"] in servers and not args.force:
            skipped.append(s["name"])
            continue
        action = overwritten if s["name"] in servers else added
        action.append(s["name"])
        if not args.dry_run:
            servers[s["name"]] = to_muse_entry(s)

    if remote_warn:
        warn("remote (http) servers are imported as transport "
             "'streamable_http' (best effort) — verify in muse")

    changed = bool(added or overwritten or moved or conflicts)
    if args.dry_run:
        print(dim("(dry run — settings.json unchanged)"))
    elif changed:
        save_settings(settings)
        print(dim(f"backup: {MUSE_SETTINGS}.bak"))

    mig_label = "would migrate" if args.dry_run else "migrated"
    for n in moved:
        print(f"  {green(mig_label)} {n} ({LEGACY_KEY} -> {CANONICAL_KEY})")
    for n in added:
        print(f"  {green('added')} {n}")
    for n in overwritten:
        print(f"  {yellow('overwrote')} {n}")
    for n in skipped:
        print(f"  {dim('skipped (exists, use --force)')} {n}")
    return 0


def cmd_add(args):
    settings = load_settings()
    migrate_legacy_key(settings)
    servers = settings.setdefault(CANONICAL_KEY, {})
    if args.name in servers and not args.force:
        die(f"server '{args.name}' exists (use --force to replace)")
    env = {}
    for item in args.env or []:
        if "=" not in item:
            die(f"bad --env '{item}' (want KEY=value)", code=2)
        k, v = item.split("=", 1)
        env[k] = v
    headers = {}
    for item in args.header or []:
        if ":" not in item:
            die(f"bad --header '{item}' (want 'KEY: VALUE')", code=2)
        k, v = item.split(":", 1)
        headers[k.strip()] = v.strip()
    if args.url:
        srv = _norm_remote(args.name, args.url, headers, not args.disabled)
    else:
        if not args.command:
            die("give a URL (--url) or a command to run", code=2)
        srv = _norm_stdio(args.name, args.command[0], args.command[1:], env,
                          not args.disabled)
    servers[args.name] = to_muse_entry(srv)
    save_settings(settings)
    print(f"{green('added')} {args.name}")
    return 0


def _mutate(name, fn, label):
    settings = load_settings()
    migrate_legacy_key(settings)
    servers = muse_servers(settings)
    if name not in servers:
        die(f"no muse server named '{name}'")
    fn(servers[name])
    settings[CANONICAL_KEY] = servers
    save_settings(settings)
    print(f"{green(label)} {name}")
    return 0


def cmd_enable(args):
    return _mutate(args.name, lambda e: e.__setitem__("enabled", True), "enabled")


def cmd_disable(args):
    return _mutate(args.name, lambda e: e.__setitem__("enabled", False), "disabled")


def cmd_remove(args):
    settings = load_settings()
    migrate_legacy_key(settings)
    servers = muse_servers(settings)
    if args.name not in servers:
        die(f"no muse server named '{args.name}'")
    del servers[args.name]
    settings[CANONICAL_KEY] = servers
    save_settings(settings)
    print(f"{green('removed')} {args.name}")
    return 0

INIT_REQ = {
    "jsonrpc": "2.0",
    "id": "muse-mcp-check",
    "method": "initialize",
    "params": {
        "protocolVersion": "2024-11-05",
        "capabilities": {},
        "clientInfo": {"name": "muse-mcp-check", "version": "1"},
    },
}

def _readline_timeout(stream, timeout):
    """Read one line or return None on timeout/error."""
    out = []
    def _t():
        try:
            out.append(stream.readline())
        except Exception as e:  # noqa: BLE001 - report as failure
            out.append(e)
    th = threading.Thread(target=_t, daemon=True)
    th.start()
    th.join(timeout)
    if not out:
        return None
    return out[0] if not isinstance(out[0], Exception) else out[0]

def check_stdio(entry, timeout):
    """Spawn the server, send MCP initialize, expect a JSON-RPC reply."""
    cmd = [entry.get("command")] + list(entry.get("args", []))
    if not cmd[0]:
        return False, "no command configured", 0
    env = dict(os.environ)
    env.update(entry.get("env", {}) or {})
    start = time.monotonic()
    try:
        proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, env=env, text=True,
        )
    except (OSError, FileNotFoundError) as e:
        return False, f"spawn failed: {e}", 0
    try:
        try:
            proc.stdin.write(json.dumps(INIT_REQ) + "\n")
            proc.stdin.flush()
        except (BrokenPipeError, OSError) as e:
            return False, f"stdin write failed: {e}", 0
        raw = _readline_timeout(proc.stdout, timeout)
        elapsed_ms = int((time.monotonic() - start) * 1000)
        if raw is None:
            return False, f"no reply within {timeout}s", elapsed_ms
        try:
            resp = json.loads(raw) if isinstance(raw, str) else {}
        except json.JSONDecodeError:
            return False, "non-JSON reply", elapsed_ms
        if isinstance(resp, dict) and ("result" in resp or "error" in resp):
            return True, "ok", elapsed_ms
        return False, "unexpected reply shape", elapsed_ms
    finally:
        try:
            proc.kill()
        except OSError:
            pass
        proc.wait()

def check_remote(entry, timeout):
    """POST MCP initialize to the streamable-HTTP endpoint."""
    url = entry.get("url")
    if not url:
        return False, "no url configured", 0
    body = json.dumps(INIT_REQ).encode("utf-8")
    headers = {"Content-Type": "application/json",
               "Accept": "application/json, text/event-stream"}
    for k, v in (entry.get("headers", {}) or {}).items():
        headers[k] = v
    start = time.monotonic()
    try:
        req = urllib.request.Request(url, data=body, headers=headers, method="POST")
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            status = resp.status
            payload = resp.read(65536).decode("utf-8", errors="replace")
    except Exception as e:  # noqa: BLE001 - any failure is a failed check
        return False, f"{type(e).__name__}: {e}", int((time.monotonic() - start) * 1000)
    elapsed_ms = int((time.monotonic() - start) * 1000)
    if '"result"' in payload or '"error"' in payload or "jsonrpc" in payload:
        return True, "ok", elapsed_ms
    return False, f"HTTP {status} without JSON-RPC body", elapsed_ms

def cmd_check(args):
    """Handshake every configured server; exit non-zero on any failure."""
    settings = load_settings()
    servers = muse_servers(settings)
    if args.names:
        unknown = [n for n in args.names if n not in servers]
        if unknown:
            die(f"unknown server(s): {', '.join(unknown)}")
        names = [n for n in args.names if n in servers]
    else:
        names = sorted(servers)
    if not names:
        print("No MCP servers configured in muse.")
        return 0
    results = {}
    for name in names:
        e = servers[name]
        enabled = e.get("enabled", True)
        if not enabled and not args.all:
            results[name] = {"ok": None, "detail": "skipped (disabled)",
                             "latency_ms": 0, "transport": e.get("transport", "?")}
            continue
        if e.get("transport", "stdio") == "stdio":
            ok, detail, ms = check_stdio(e, args.timeout)
        else:
            ok, detail, ms = check_remote(e, args.timeout)
        results[name] = {"ok": ok, "detail": detail, "latency_ms": ms,
                         "transport": e.get("transport", "?")}
    if args.json:
        print(json.dumps(results, indent=2))
    else:
        print(f"MCP server health ({len(results)}):")
        for name in names:
            r = results[name]
            if r["ok"] is None:
                print(f"  {dim('SKIP')} {name}  {dim(r['detail'])}")
            elif r["ok"]:
                print(f"  {green('OK')} {name}  {dim(r['transport'] + f' · {r['latency_ms']}ms')}")
            else:
                print(f"  {red('FAIL')} {name}  {r['detail']}")
    failed = [n for n, r in results.items() if r["ok"] is False]
    if failed:
        print(f"{red('failed:')} {', '.join(failed)}", file=sys.stderr)
        return 1
    return 0


def cmd_export(args):
    """Dump muse servers as portable Claude-style {"mcpServers": {...}} JSON."""
    servers = muse_servers()
    out = {"mcpServers": {}}
    for name in sorted(servers):
        e = servers[name]
        if e.get("transport", "stdio") == "stdio":
            entry = {"command": e.get("command"), "args": e.get("args", [])}
            if e.get("env"):
                entry["env"] = e["env"]
            if not e.get("enabled", True):
                entry["disabled"] = True
        else:
            entry = {"type": "http", "url": e.get("url")}
            if e.get("headers"):
                entry["headers"] = e["headers"]
            if not e.get("enabled", True):
                entry["disabled"] = True
        out["mcpServers"][name] = entry
    print(json.dumps(out, indent=2))
    return 0


MANUAL = """\
muse-mcp manual
===============

Import MCP servers from other coding agents into Muse Code, and manage the
muse `mcp_servers` block in ~/.config/muse/settings.json.

SOURCES (auto-detected)
  opencode  ~/.config/opencode/opencode.json[c], ./opencode.json[c]
  codex     ~/.codex/config.toml  ([mcp_servers.*])
  claude    ~/.claude.json (user scope), ./.mcp.json (project scope)
  agy       ~/.gemini/config/mcp_config.json (Antigravity CLI)

WORKFLOW
  1. `muse mcp status`            see which agent configs exist here
  2. `muse mcp import agy --dry-run`   preview what would be added
  3. `muse mcp import agy`        merge into muse settings.json
  4. `muse mcp list`              verify
  5. `muse mcp check`             handshake every server (import shows
                                  what's configured; check shows what works)

NOTES
  * Existing muse servers are never overwritten unless --force is given.
    Re-running an import only adds new names, never duplicates.
  * Servers live under the canonical `mcp_servers` key (official docs).
    A camelCase `mcpServers` alias is merged into it on the next write
    (same name in both keeps the `mcp_servers` entry); carrying both keys
    makes the native loader drop every MCP server, so this tool never
    leaves both behind.
  * Every write ensures `"schema_version": 1`, which the native loader
    requires; other settings.json keys are left untouched.
  * A backup (settings.json.bak) is written before every change.
  * Remote (http/sse) servers import as transport 'streamable_http';
    verify them in muse afterwards — that mapping is best effort.
  * Env values (possibly secrets) are copied verbatim; only the count of
    env vars is shown in listings, never the values.
  * `check` spawns stdio servers with an MCP initialize handshake and
    POSTs initialize to remote endpoints; disabled servers are skipped
    unless --all is given. Exits non-zero if any server fails.
  * MUSE_SETTINGS env var overrides the settings.json path (for testing).
"""


def cmd_help(args):
    print(MANUAL)
    return 0


# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="muse mcp",
        description="Configure Muse MCP servers; import from opencode, codex, claude, agy.",
    )
    sub = p.add_subparsers(dest="cmd")

    s = sub.add_parser("list", help="list muse MCP servers")
    s.add_argument("--json", action="store_true", help="raw JSON output")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("status", help="show detected agent configs + muse servers")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("import", help="import servers from other agents into muse")
    s.add_argument("items", nargs="*", metavar="SOURCE",
                   help="sources to import (opencode, codex, claude, agy; "
                        "default: all found)")
    s.add_argument("--name", action="append", metavar="NAME", dest="names",
                   help="only import this server (repeatable)")
    s.add_argument("--from", dest="from_path", metavar="PATH",
                   help="read a single config file instead of auto-detected paths")
    s.add_argument("--dry-run", action="store_true",
                   help="preview without writing settings.json")
    s.add_argument("--force", action="store_true",
                   help="overwrite existing muse servers")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--enable", action="store_true",
                   help="enable all imported servers")
    g.add_argument("--disable", action="store_true",
                   help="import servers disabled")
    s.set_defaults(func=cmd_import)

    s = sub.add_parser("add", help="manually add a muse MCP server")
    s.add_argument("name", help="server name")
    s.add_argument("--url", help="remote server URL (else stdio)")
    s.add_argument("--header", action="append", metavar="KEY: VALUE",
                   help="http header for remote servers, e.g. 'Authorization: Bearer T' (repeatable)")
    s.add_argument("--env", action="append", metavar="KEY=value",
                   help="env var for stdio servers (repeatable)")
    s.add_argument("--disabled", action="store_true")
    s.add_argument("--force", action="store_true")
    s.add_argument("command", nargs="*", help="command + args for stdio servers")
    s.set_defaults(func=cmd_add)

    s = sub.add_parser("enable", help="enable a muse MCP server")
    s.add_argument("name")
    s.set_defaults(func=cmd_enable)

    s = sub.add_parser("disable", help="disable a muse MCP server")
    s.add_argument("name")
    s.set_defaults(func=cmd_disable)

    s = sub.add_parser("remove", help="remove a muse MCP server")
    s.add_argument("name")
    s.set_defaults(func=cmd_remove)

    s = sub.add_parser("check", help="handshake every server, report health")
    s.add_argument("names", nargs="*", metavar="NAME", help="only check these servers")
    s.add_argument("--all", action="store_true", help="include disabled servers")
    s.add_argument("--timeout", metavar="SEC", type=float, default=15, help="per-server timeout (default: 15)")
    s.add_argument("--json", action="store_true", help="machine-readable output")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("export", help="dump muse servers as portable Claude-style JSON")
    s.set_defaults(func=cmd_export)

    s = sub.add_parser("help", help="show the full manual")
    s.add_argument("topic", nargs="?")
    s.set_defaults(func=cmd_help)
    p.set_defaults(func=lambda a: cmd_status(a))
    return p

def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if getattr(args, "cmd", None) == "import":
        for tok in args.items:
            if tok not in SOURCES:
                parser.error(f"unknown source '{tok}' "
                             f"(choose from: {', '.join(SOURCES)})")
        args.sources = args.items
        if args.names is None:
            args.names = []
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
