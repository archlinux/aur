#!/usr/bin/env python3
"""
muse-mcp: configure Muse Code MCP servers and import them from other agents.

Reads MCP server definitions from opencode, Codex CLI, Claude Code and
Antigravity (agy) configs and merges them into ~/.config/muse/settings.json
under the canonical `mcp_servers` key (per the official Muse Code docs).
Other settings.json keys are left untouched. A camelCase `mcpServers` alias
is honored on read and merged into `mcp_servers` on the next write:
carrying both keys makes the native loader drop every MCP server, so this
tool never leaves both behind and never stores the same name twice. Every
write also ensures `"schema_version": 1`, which the native loader requires.

Integrated with the muse wrapper: `muse mcp ...` dispatches here.
"""

import argparse
import copy
import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

try:
    import tomllib
except ImportError:  # Python < 3.11, TOML sources unavailable
    tomllib = None


MUSE_SETTINGS = os.environ.get(
    "MUSE_SETTINGS", os.path.expanduser("~/.config/muse/settings.json")
)

# ANSI color helpers for tty output
USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def color(text, code):
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


def bold(text): return color(text, "1")
def green(text): return color(text, "32")
def red(text): return color(text, "31")
def yellow(text): return color(text, "33")
def dim(text): return color(text, "90")


def die(msg, code=1):
    print(f"{red('error:')} {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"{yellow('warning:')} {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# muse settings.json handling
# ---------------------------------------------------------------------------

def load_settings():
    if not os.path.exists(MUSE_SETTINGS):
        return {}
    try:
        with open(MUSE_SETTINGS, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        die(f"cannot read {MUSE_SETTINGS}: {e}")
    if not isinstance(data, dict):
        die(f"{MUSE_SETTINGS} does not contain a JSON object")
    return data


def save_settings(data):
    # The native loader rejects settings.json without "schema_version": 1,
    # so every write path goes through here and fills it in when missing.
    # An explicitly set (non-1) value is left alone to fail loudly natively
    # rather than being silently rewritten.
    data.setdefault("schema_version", 1)
    d = os.path.dirname(MUSE_SETTINGS)
    if d:
        os.makedirs(d, exist_ok=True)
    if os.path.exists(MUSE_SETTINGS):
        shutil.copy2(MUSE_SETTINGS, MUSE_SETTINGS + ".bak")
    fd, tmp = tempfile.mkstemp(
        dir=d or ".", prefix=".settings.", suffix=".tmp"
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp, MUSE_SETTINGS)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# The official docs declare the snake_case key. The camelCase alias is what
# older Muse Code releases wrote, and the native loader still honors each
# key on its own — but both keys at once makes it drop the whole MCP
# member, so every write path migrates alias entries into the canonical key
# first and re-imports stay idempotent.
CANONICAL_KEY = "mcp_servers"
LEGACY_KEY = "mcpServers"


def server_maps(data):
    """Split settings into (canonical, legacy) server dicts (read-only)."""
    canon = data.get(CANONICAL_KEY, {})
    legacy = data.get(LEGACY_KEY, {})
    if not isinstance(canon, dict):
        die(f"{CANONICAL_KEY} in settings.json is not an object")
    if not isinstance(legacy, dict):
        die(f"{LEGACY_KEY} in settings.json is not an object")
    return canon, legacy


def muse_servers(data=None):
    """Merged read-only view of configured servers (canonical wins)."""
    data = load_settings() if data is None else data
    canon, legacy = server_maps(data)
    merged = dict(legacy)
    merged.update(canon)
    return merged


def legacy_names(data=None):
    data = load_settings() if data is None else data
    _, legacy = server_maps(data)
    return sorted(legacy)


def warn_legacy(data=None):
    names = legacy_names(data)
    if names:
        warn(f"{len(names)} server(s) still under legacy '{LEGACY_KEY}' key "
             f"({', '.join(names)}); they merge into '{CANONICAL_KEY}' on "
             "the next add/enable/disable/remove/import")
    return names


def migrate_legacy_key(settings):
    """Move legacy entries into the canonical key (in memory).

    Returns (moved, conflicts). Conflicting names keep the canonical entry;
    the legacy key is always removed so the file never carries both keys.
    Callers persist with save_settings()."""
    canon, legacy = server_maps(settings)
    if not legacy:
        return [], []
    moved, conflicts = [], []
    for name, entry in legacy.items():
        if name in canon:
            conflicts.append(name)
            warn(f"'{name}' is configured under both '{LEGACY_KEY}' and "
                 f"'{CANONICAL_KEY}'; keeping the '{CANONICAL_KEY}' entry")
        else:
            canon[name] = entry
            moved.append(name)
    settings[CANONICAL_KEY] = canon
    del settings[LEGACY_KEY]
    return moved, conflicts


def to_muse_entry(srv):
    """Convert a normalized server dict to a muse mcp_servers entry."""
    entry = {
        "transport": "stdio" if srv["transport"] == "stdio" else "streamable_http",
        "enabled": srv["enabled"],
        "mode": "optional",
    }
    if srv["transport"] == "stdio":
        entry["command"] = srv["command"]
        entry["args"] = srv["args"]
        if srv["env"]:
            entry["env"] = srv["env"]
    else:
        entry["url"] = srv["url"]
        if srv["headers"]:
            entry["headers"] = srv["headers"]
    # Keep stable key order: transport, command/args/env or url/headers, enabled, mode
    ordered = {"transport": entry.pop("transport")}
    ordered.update(entry)
    return ordered


# ---------------------------------------------------------------------------
# Source readers: each returns a list of normalized server dicts:
# {name, transport, command, args, env, url, headers, enabled}
# ---------------------------------------------------------------------------

def _norm_stdio(name, command, args=None, env=None, enabled=True):
    if isinstance(command, (list, tuple)):
        parts = list(command)
        command, rest = parts[0], parts[1:]
        args = list(rest) + list(args or [])
    return {
        "name": name,
        "transport": "stdio",
        "command": command,
        "args": list(args or []),
        "env": dict(env or {}),
        "url": None,
        "headers": {},
        "enabled": bool(enabled),
    }


def _norm_remote(name, url, headers=None, enabled=True):
    return {
        "name": name,
        "transport": "remote",
        "command": None,
        "args": [],
        "env": {},
        "url": url,
        "headers": dict(headers or {}),
        "enabled": bool(enabled),
    }


def strip_jsonc(text):
    """Remove // and /* */ comments outside of strings."""
    out = []
    i, n = 0, len(text)
    in_str = False
    esc = False
    while i < n:
        c = text[i]
        nxt = text[i + 1] if i + 1 < n else ""
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
            i += 1
        elif c == '"':
            in_str = True
            out.append(c)
            i += 1
        elif c == "/" and nxt == "/":
            while i < n and text[i] != "\n":
                i += 1
        elif c == "/" and nxt == "*":
            i += 2
            while i < n and not (text[i] == "*" and i + 1 < n and text[i + 1] == "/"):
                i += 1
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def _load_json_file(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        return None, f"cannot read: {e}"
    try:
        return json.loads(text), None
    except json.JSONDecodeError:
        pass
    try:
        return json.loads(strip_jsonc(text)), None
    except json.JSONDecodeError as e:
        return None, f"invalid JSON: {e}"


def read_opencode(path):
    """opencode.json[c]: {mcp: {name: {type, command[], environment, url, headers, enabled}}}"""
    data, err = _load_json_file(path)
    if err:
        return None, err
    if not isinstance(data, dict) or not isinstance(data.get("mcp"), dict):
        return [], None
    servers = []
    for name, cfg in data["mcp"].items():
        if not isinstance(cfg, dict):
            continue
        enabled = cfg.get("enabled", True)
        if cfg.get("type") == "remote" or (not cfg.get("command") and cfg.get("url")):
            if not cfg.get("url"):
                continue
            servers.append(_norm_remote(name, cfg["url"], cfg.get("headers"), enabled))
        else:
            if not cfg.get("command"):
                continue
            servers.append(_norm_stdio(
                name, cfg["command"], cfg.get("args", []),
                cfg.get("environment", {}), enabled,
            ))
    return servers, None


def read_codex(path):
    """config.toml: [mcp_servers.name] with command/args/env or url."""
    if tomllib is None:
        return None, "tomllib unavailable (need Python 3.11+)"
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        return None, f"cannot parse: {e}"
    raw = data.get("mcp_servers", {})
    if not isinstance(raw, dict):
        return [], None
    servers = []
    for name, cfg in raw.items():
        if not isinstance(cfg, dict):
            continue
        enabled = cfg.get("enabled", True)
        if cfg.get("url"):
            servers.append(_norm_remote(
                name, cfg["url"], cfg.get("http_headers", {}), enabled
            ))
        elif cfg.get("command"):
            servers.append(_norm_stdio(
                name, cfg["command"], cfg.get("args", []),
                cfg.get("env", {}), enabled,
            ))
    return servers, None


def read_claude_style(path, key="mcpServers"):
    """Claude Code / agy JSON: {mcpServers: {name: {command, args, env, disabled}}}
    Remote entries carry type=url fields."""
    data, err = _load_json_file(path)
    if err:
        return None, err
    raw = data.get(key, {}) if isinstance(data, dict) else {}
    if not isinstance(raw, dict):
        return [], None
    servers = []
    for name, cfg in raw.items():
        if not isinstance(cfg, dict):
            continue
        enabled = not cfg.get("disabled", False)
        url = cfg.get("url")
        ctype = str(cfg.get("type", "")).lower()
        if url or ctype in ("http", "sse", "streamable-http"):
            if not url:
                continue
            servers.append(_norm_remote(name, url, cfg.get("headers", {}), enabled))
        elif cfg.get("command"):
            servers.append(_norm_stdio(
                name, cfg["command"], cfg.get("args", []),
                cfg.get("env", {}), enabled,
            ))
    return servers, None


HOME = os.path.expanduser("~")

SOURCES = {
    "opencode": {
        "desc": "opencode (opencode.json[c] user + project config)",
        "paths": [
            os.path.join(HOME, ".config/opencode/opencode.json"),
            os.path.join(HOME, ".config/opencode/opencode.jsonc"),
            os.path.join(os.getcwd(), "opencode.json"),
            os.path.join(os.getcwd(), "opencode.jsonc"),
        ],
        "read": read_opencode,
    },
    "codex": {
        "desc": "Codex CLI (~/.codex/config.toml)",
        "paths": [os.path.join(HOME, ".codex/config.toml")],
        "read": read_codex,
    },
    "claude": {
        "desc": "Claude Code (~/.claude.json user scope, ./.mcp.json project)",
        "paths": [
            os.path.join(HOME, ".claude.json"),
            os.path.join(os.getcwd(), ".mcp.json"),
        ],
        "read": read_claude_style,
    },
    "agy": {
        "desc": "Antigravity agy CLI (~/.gemini/config/mcp_config.json)",
        "paths": [os.path.join(HOME, ".gemini/config/mcp_config.json")],
        "read": read_claude_style,
    },
}


def collect_source(name, custom_path=None):
    """Read all candidate files for a source. Returns (servers, used_paths, errors)."""
    spec = SOURCES[name]
    paths = [custom_path] if custom_path else spec["paths"]
    servers, used, errors = [], [], []
    for p in paths:
        if not os.path.exists(p):
            continue
        result, err = spec["read"](p)
        if err:
            errors.append(f"{p}: {err}")
            continue
        used.append(p)
        for s in result:
            s = copy.deepcopy(s)
            s["source"] = name
            s["origin"] = p
            servers.append(s)
    # Later files (project scope) override earlier ones on name clash.
    merged = {}
    for s in servers:
        merged[s["name"]] = s
    return list(merged.values()), used, errors


