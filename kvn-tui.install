configure_sing_box_capabilities() {
    setcap cap_net_admin,cap_net_raw+ep /usr/bin/sing-box || \
        echo "WARNING: setcap failed — run manually: sudo setcap cap_net_admin,cap_net_raw+ep /usr/bin/sing-box"
}

seed_migration_baseline() {
    local installed_from="${1:-}"
    local state_dir=/var/lib/kvn
    local baseline="$state_dir/migration-baseline"
    local migrations=/usr/lib/kvn/migrations
    local tmp
    local introduced
    local fresh_install=0

    [[ ! -e "$baseline" ]] || return 0
    [[ -n "$installed_from" || -d "$state_dir" ]] || fresh_install=1
    install -dm755 "$state_dir"
    tmp=$(mktemp "$state_dir/.migration-baseline.XXXXXX") || return 1
    for migration in "$migrations"/*.sh; do
        [[ -f "$migration" ]] || continue
        # Only a fresh installation starts with every shipped migration in its
        # baseline. Upgrades from pre-framework versions still need all later
        # migrations; launching kvn applies them and restarts an outdated daemon.
        if (( fresh_install )); then
            basename "$migration"
            continue
        fi
        [[ -n "$installed_from" ]] || continue
        introduced=$(sed -n 's/^# kvn:introduced=//p' "$migration" | head -n1)
        if [[ -n "$introduced" ]] && (( $(vercmp "$introduced" "$installed_from") <= 0 )); then
            basename "$migration"
        fi
    done | sort >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$baseline"
}

print_migration_notice() {
    local installed_from="$1"
    local migration
    local introduced

    [[ -d /usr/lib/kvn/migrations ]] || return 0
    for migration in /usr/lib/kvn/migrations/*.sh; do
        [[ -f "$migration" ]] || continue
        introduced=$(sed -n 's/^# kvn:introduced=//p' "$migration" | head -n1)
        if [[ -z "$introduced" ]] || (( $(vercmp "$introduced" "$installed_from") > 0 )); then
            echo
            echo "kvn has new migrations. They will run the next time you launch kvn."
            echo "To run them now: kvn migrate"
            echo
            return 0
        fi
    done
}

refresh_system_integrations() {
    /usr/bin/kvn refresh --killswitch --polkit --if-outdated || \
        echo "WARNING: could not update the kvn polkit or kill-switch files — run 'kvn doctor'"
}

print_service_enable_notice() {
    echo
    echo "======================================================================"
    echo "  ACTION REQUIRED: enable kvn daemon autostart"
    echo "======================================================================"
    echo "Run as your regular user (without sudo):"
    echo
    echo "  systemctl --user enable --now kvn-tui.service"
    echo
    echo "======================================================================"
    echo
}

print_aur_package_rename_notice() {
    [[ -e /usr/share/licenses/kvn-tui-bin/LICENSE ]] || return 0
    echo
    echo "======================================================================"
    echo "  kvn-tui-bin is renamed to kvn-bin"
    echo "======================================================================"
    echo "kvn-tui-bin will stop receiving updates. Switch to the new package:"
    echo
    echo "  yay -S kvn-bin"
    echo
    echo "Confirm the removal of kvn-tui-bin when asked. Your profiles, settings"
    echo "and daemon autostart are kept."
    echo "======================================================================"
    echo
}

post_install() {
    local first_install=1
    [[ ! -d /var/lib/kvn ]] || first_install=0
    seed_migration_baseline
    configure_sing_box_capabilities
    if (( first_install )); then
        print_service_enable_notice
    else
        refresh_system_integrations
    fi
}

post_upgrade() {
    seed_migration_baseline "$2"
    configure_sing_box_capabilities
    refresh_system_integrations
    print_migration_notice "$2"
    print_aur_package_rename_notice
}

post_remove() {
    rm -f /var/lib/kvn/migration-baseline
}
