configure_sing_box_capabilities() {
    setcap cap_net_admin,cap_net_raw+ep /usr/bin/sing-box || \
        echo "WARNING: setcap failed — run manually: sudo setcap cap_net_admin,cap_net_raw+ep /usr/bin/sing-box"
}

# TODO: drop once upgrades from kvn 0.35.x and older are no longer supported;
# only those releases wrote the migration baseline.
remove_migration_baseline() {
    rm -f /var/lib/kvn/migration-baseline
}

refresh_system_integrations() {
    /usr/bin/kvn refresh --killswitch --polkit --if-outdated || \
        echo "WARNING: could not update the kvn polkit or kill-switch files — run 'kvn doctor'"
}

print_service_enable_notice() {
    echo
    echo "======================================================================"
    echo "  ACTION REQUIRED: enable kvn daemon autostart"
    echo "======================================================================"
    echo "Run as your regular user (without sudo):"
    echo
    echo "  systemctl --user enable --now kvn-tui.service"
    echo
    echo "======================================================================"
    echo
}

print_aur_package_rename_notice() {
    [[ -e /usr/share/licenses/kvn-tui-bin/LICENSE ]] || return 0
    echo
    echo "======================================================================"
    echo "  kvn-tui-bin is renamed to kvn-bin"
    echo "======================================================================"
    echo "kvn-tui-bin will stop receiving updates. Switch to the new package:"
    echo
    echo "  yay -S kvn-bin"
    echo
    echo "Confirm the removal of kvn-tui-bin when asked. Your profiles, settings"
    echo "and daemon autostart are kept."
    echo "======================================================================"
    echo
}

print_daemon_restart_notice() {
    pgrep -f '^/usr/bin/kvn(-tui)? --daemon$' >/dev/null || return 0
    echo
    echo "The running kvn daemon still uses the previous version. Open kvn, which"
    echo "restarts it and reconnects, or run as your regular user (without sudo):"
    echo
    echo "  systemctl --user restart kvn-tui.service"
    echo
}

post_install() {
    local first_install=1
    [[ ! -d /var/lib/kvn ]] || first_install=0
    install -dm755 /var/lib/kvn
    remove_migration_baseline
    configure_sing_box_capabilities
    if (( first_install )); then
        print_service_enable_notice
    else
        refresh_system_integrations
        print_daemon_restart_notice
    fi
}

post_upgrade() {
    remove_migration_baseline
    configure_sing_box_capabilities
    refresh_system_integrations
    print_daemon_restart_notice
    print_aur_package_rename_notice
}
