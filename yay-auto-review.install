post_install() {
  printf '%s\n' \
    'yay-auto-review: Installed. Run as your regular user:' \
    '  codex login             # If not already signed in' \
    '  /usr/bin/yay-auto-review enable  # Enable review in your yay configuration' \
    'System installation does not modify per-user yay configuration.'
}
