post_install() {
	if command -v systemctl >/dev/null 2>&1; then
    	sudo systemctl daemon-reload >/dev/null 2>&1 || true
    fi

	if [[ ! -f /etc/azerothcore/authserver.conf ]]; then
		sudo cp /etc/azerothcore/authserver.conf.dist /etc/azerothcore/authserver.conf
	fi

	if [[ ! -f /etc/azerothcore/worldserver.conf ]]; then
		sudo cp /etc/azerothcore/worldserver.conf.dist /etc/azerothcore/worldserver.conf
	fi

	# I'm not distributing acore.sh for now
	#if [[ ! -f /usr/share/azerothcore/conf/config.conf ]]; then
	#	sudo cp /usr/share/azerothcore/conf/dist/config.conf /usr/share/azerothcore/conf/config.conf
	#fi

	# If source dir is empty, point it to our install location
	sudo sed -i 's#^SourceDirectory\s*=\s*""#SourceDirectory = "/usr/share/azerothcore"#' /etc/azerothcore/authserver.conf

	# Restart authserver
  	sudo systemctl restart acore-auth-server.service

	# Start worldserver
  	sudo systemctl start acore-world-server.service

	# Enable needed services
	sudo systemctl enable acore-auth-server.service
	sudo systemctl enable acore-world-server.service
	sudo systemctl enable mysqld.service

	# Create azerothcore user
	if ! getent passwd azerothcore >/dev/null; then
		useradd -r -s /usr/bin/nologin -d /usr/share/azerothcore azerothcore
	fi

	# Ensure the administrative access group exists
	if ! getent group acore-admin >/dev/null; then
		groupadd -r acore-admin
	fi

	Add daemon user to that group
	usermod -aG acore-admin azerothcore

	echo "======================================================================="
	echo " 🔐 MULTI-USER TMUX CONSOLE ACCESS CONFIGURATION"
	echo "======================================================================="
	echo " To allow a regular Linux user to attach to the live server console,"
	echo " add them to the 'acore-admin' group using this command:"
	echo ""
	echo "   sudo usermod -aG acore-admin your_username"
	echo ""
	echo " (Note: The user must log out and log back in for changes to apply)."
	echo "======================================================================="

	# Display some instructions
	echo ''
	echo ''
	echo '#####################  IMPORTANT  #####################'
	echo ''
	echo 'The installation has finished!'
	echo ''
	echo 'Configuration files:'
	echo '  - /etc/azerothcore/authserver.conf'
	echo '  - /etc/azerothcore/worldserver.conf'
	echo ''
	echo 'Executables and runtime files:'
	echo '  - /usr/share/azerothcore/'
	echo ''
	echo 'MySQL note:'
	echo '  - Make sure MySQL is configured and running before using the services.'
	echo ''
	echo 'Enable and start services automatically:'
	echo '  - sudo systemctl enable --now acore-auth-server.service'
	echo '  - sudo systemctl enable --now acore-world-server.service'
	echo ''
	echo 'Check service status:'
	echo '  - sudo systemctl status acore-auth-server.service'
	echo '  - sudo systemctl status acore-world-server.service'
	echo ''
	echo 'Check service logs:'
	echo '  - sudo journalctl -u acore-auth-server.service -f'
	echo '  - sudo journalctl -u acore-world-server.service -f'
	echo ''
	echo 'The servers are started with tmux. To connect to one of them and issue commands:'
	echo '  - tmux attach -t acore-auth'
	echo '  - tmux attach -t acore-world'
	echo ''
	echo 'To disconnect, press Ctrl+b, then d.'
	echo ''
	echo 'Map data:'
	echo '  - Either extract the map data manually using the guide at:'
	echo '    https://www.azerothcore.org/wiki/linux-server-setup'
	echo '  - Or install the AUR package:'
	echo '    yay -S azerothcore-clientdata'
}

post_upgrade() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
}

pre_remove() {
	sudo systemctl stop acore-auth-server.service
	sudo systemctl stop acore-world-server.service

	sudo systemctl disable acore-auth-server.service
	sudo systemctl disable acore-world-server.service

	sudo rm -f /etc/systemd/system/acore-auth-server.service
	sudo rm -f /etc/systemd/system/acore-world-server.service
	sudo systemctl daemon-reload
}
