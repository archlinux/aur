post_install() {
	# 1. Dynamically provision the unprivileged system user account first!
	if ! getent passwd azerothcore >/dev/null; then
		useradd -r -s /usr/bin/nologin -d /usr/share/azerothcore azerothcore
	fi

	# 2. Ensure the administrative access group exists
	if ! getent group acore-admin >/dev/null; then
		groupadd -r acore-admin
	fi

	# 3. Add daemon user to that group (Fixed the missing '#' hashtag error!)
	usermod -aG acore-admin azerothcore

	# 4. Copy default configuration templates safely if they do not exist
	if [[ ! -f /etc/azerothcore/authserver.conf ]]; then
		cp /etc/azerothcore/authserver.conf.dist /etc/azerothcore/authserver.conf
	fi

	if [[ ! -f /etc/azerothcore/worldserver.conf ]]; then
		cp /etc/azerothcore/worldserver.conf.dist /etc/azerothcore/worldserver.conf
	fi

	# Allow "remote access" so we can talk to our service once it starts
	if [ -f /etc/azerothcore/worldserver.conf ]; then
		sed -i 's/^Ra.Enable\s*=\s*.*/Ra.Enable = 1/'     /etc/azerothcore/worldserver.conf
		sed -i 's/^Ra.IP\s*=\s*.*/Ra.IP = "127.0.0.1"/'     /etc/azerothcore/worldserver.conf
		sed -i 's/^Ra.Port\s*=\s*.*/Ra.Port = 3443/'       /etc/azerothcore/worldserver.conf
		sed -i 's/^Ra.MinLevel\s*=\s*.*/Ra.MinLevel = 3/' /etc/azerothcore/worldserver.conf
	fi

	# 5. Point the source tracking option directly to your execution root folder
	sed -i 's#^SourceDirectory\s*=\s*""#SourceDirectory = "/usr/share/azerothcore"#' /etc/azerothcore/authserver.conf

	echo "======================================================================="
	echo " 🔐 MULTI-USER TMUX CONSOLE ACCESS CONFIGURATION"
	echo "======================================================================="
	echo " To allow a regular Linux user to attach to the live server console,"
	echo " add them to the 'acore-admin' group using this command:"
	echo ""
	echo "   sudo usermod -aG acore-admin your_username"
	echo ""
	echo " (Note: The user must log out and log back in for changes to apply)."
	echo "======================================================================="

	# Display clear user instructions
	echo ''
	echo ''
	echo '#####################  IMPORTANT  #####################'
	echo ''
	echo 'The installation has finished!'
	echo ''
	echo 'Configuration files:'
	echo '  - /etc/azerothcore/authserver.conf'
	echo '  - /etc/azerothcore/worldserver.conf'
	echo ''
	echo 'Executables and runtime files:'
	echo '  - /usr/share/azerothcore/'
	echo ''
	echo 'MySQL note:'
	echo '  - Make sure MySQL is configured and running before using the services.'
	echo ''
	echo 'Enable and start services automatically:'
	echo '  - sudo systemctl enable --now acore-auth-server.service'
	echo '  - sudo systemctl enable --now acore-world-server.service'
	echo ''
	echo 'Check service status:'
	echo '  - sudo systemctl status acore-auth-server.service'
	echo '  - sudo systemctl status acore-world-server.service'
	echo ''
	echo 'Check service logs:'
	echo '  - sudo journalctl -u acore-auth-server.service -f'
	echo '  - sudo journalctl -u acore-world-server.service -f'
	echo ''
	echo 'The servers are started with tmux. To connect to one of them and issue commands:'
	echo '  - attach-auth   (Connects straight to the live authentication console)'
	echo '  - attach-world  (Connects straight to the live world server console)'
	echo ''
	echo 'To disconnect safely without killing the server, press Ctrl+b, then d.'
	echo ''
	echo 'Map data:'
	echo '  - Either extract the map data manually using the guide at:'
	echo '    https://www.azerothcore.org/wiki/linux-server-setup'
	echo '  - Or install the AUR package:'
	echo '    yay -S azerothcore-clientdata-git'
}

post_upgrade() {
    # Systemd hooks in Arch handle daemon-reloads natively.
    true
}

pre_remove() {
	# Safely disable background services before removing files
	systemctl stop acore-auth-server.service 2>/dev/null || true
	systemctl stop acore-world-server.service 2>/dev/null || true

	systemctl disable acore-auth-server.service 2>/dev/null || true
	systemctl disable acore-world-server.service 2>/dev/null || true
}
