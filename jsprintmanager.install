post_install() {
	gtk-update-icon-cache -q -t -f usr/share/icons/hicolor

	echo "Finalizing JSPrintManager 9.0.0.0 installation..."

	chown -R $SUDO_USER $(eval echo ~$SUDO_USER"/.neodynamic")

	update-desktop-database -q
}

post_upgrade() {
	post_install
}

pre_remove() {
	echo "Stopping JSPrintManager"

	pkill -fx jspm9 > /dev/null 2>&1 || true
	pkill -f /usr/bin/jspm9 > /dev/null 2>&1 || true
}

post_remove() {
	gtk-update-icon-cache -q -t -f usr/share/icons/hicolor
	update-desktop-database -q
}
