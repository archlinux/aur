diff --git a/obs-browser-page/gbm-no-linear.c b/obs-browser-page/gbm-no-linear.c
new file mode 100644
index 0000000..7a8aec4
--- /dev/null
+++ b/obs-browser-page/gbm-no-linear.c
@@ -0,0 +1,186 @@
+/******************************************************************************
+ NVIDIA driver: let Chromium's GPU process allocate buffers it can render to.
+
+ For shared texture rendering CEF asks Chromium for CPU-mappable shared images
+ (every CEF release up to 154, and newer ones where that default was restored).
+ On Linux Chromium turns that request into linear GBM buffers. The NVIDIA driver
+ cannot render into linear buffers, so every texture handed to
+ OnAcceleratedPaint stays empty.
+
+ Nothing maps these buffers on the CPU: the page is drawn into them by the GPU
+ process and OBS imports them as DMA-BUF textures. Asking the driver for a
+ renderable buffer in its own layout is therefore enough to make it work, and
+ the DRM format modifier Chromium reports then describes that real layout.
+
+ The functions below have the same names as the libgbm entry points. They live
+ in the executable, which comes first in the dynamic linker's lookup order, so
+ libcef calls them instead of libgbm's and they forward to the real ones. They
+ only change a request when the browser process started this helper with
+ --obs-gbm-no-linear, which obs-browser does for the NVIDIA driver only.
+
+ This program is free software: you can redistribute it and/or modify
+ it under the terms of the GNU General Public License as published by
+ the Free Software Foundation, either version 2 of the License, or
+ (at your option) any later version.
+ ******************************************************************************/
+
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <gbm.h>
+
+#ifndef DRM_FORMAT_MOD_LINEAR
+#define DRM_FORMAT_MOD_LINEAR 0ULL
+#endif
+
+#define SHIM_EXPORT __attribute__((visibility("default"), used))
+
+static const char switch_name[] = "--obs-gbm-no-linear";
+
+static int no_linear(void)
+{
+	static int enabled = -1;
+
+	if (enabled < 0) {
+		char buf[16384];
+		size_t len = 0;
+		FILE *f = fopen("/proc/self/cmdline", "rb");
+
+		enabled = 0;
+		if (f) {
+			len = fread(buf, 1, sizeof(buf) - 1, f);
+			fclose(f);
+		}
+		buf[len] = 0;
+
+		/* Chromium rewrites its argument area as one space separated string, so accept both separators. */
+		for (size_t i = 0; i < len; i++) {
+			if (buf[i] == 0) {
+				buf[i] = ' ';
+			}
+		}
+
+		for (const char *hit = strstr(buf, switch_name); hit; hit = strstr(hit + 1, switch_name)) {
+			const char end = hit[sizeof(switch_name) - 1];
+			if ((hit == buf || hit[-1] == ' ') && (end == 0 || end == ' ')) {
+				enabled = 1;
+				break;
+			}
+		}
+	}
+
+	return enabled;
+}
+
+static void report_once(void)
+{
+	static int reported = 0;
+
+	if (!reported) {
+		reported = 1;
+		fprintf(stderr,
+			"[obs-browser-page] NVIDIA: requesting renderable GBM buffers instead of linear ones\n");
+	}
+}
+
+static uint32_t renderable(uint32_t flags)
+{
+	return (flags & ~(uint32_t)GBM_BO_USE_LINEAR) | GBM_BO_USE_RENDERING;
+}
+
+SHIM_EXPORT struct gbm_bo *gbm_bo_create(struct gbm_device *gbm, uint32_t width, uint32_t height, uint32_t format,
+					 uint32_t flags)
+{
+	static struct gbm_bo *(*real)(struct gbm_device *, uint32_t, uint32_t, uint32_t, uint32_t) = NULL;
+
+	if (!real) {
+		real = dlsym(RTLD_NEXT, "gbm_bo_create");
+	}
+	if (!real) {
+		return NULL;
+	}
+
+	if ((flags & GBM_BO_USE_LINEAR) && no_linear()) {
+		struct gbm_bo *bo = real(gbm, width, height, format, renderable(flags));
+		if (bo) {
+			report_once();
+			return bo;
+		}
+	}
+
+	return real(gbm, width, height, format, flags);
+}
+
+SHIM_EXPORT struct gbm_bo *gbm_bo_create_with_modifiers(struct gbm_device *gbm, uint32_t width, uint32_t height,
+							uint32_t format, const uint64_t *modifiers,
+							const unsigned int count)
+{
+	static struct gbm_bo *(*real)(struct gbm_device *, uint32_t, uint32_t, uint32_t, const uint64_t *,
+				      const unsigned int) = NULL;
+
+	if (!real) {
+		real = dlsym(RTLD_NEXT, "gbm_bo_create_with_modifiers");
+	}
+	if (!real) {
+		return NULL;
+	}
+
+	/* Chromium narrows the list to the linear modifier when it wants a CPU-mappable buffer. */
+	if (count == 1 && modifiers && modifiers[0] == DRM_FORMAT_MOD_LINEAR && no_linear()) {
+		struct gbm_bo *bo = gbm_bo_create(gbm, width, height, format,
+						  GBM_BO_USE_LINEAR | GBM_BO_USE_SCANOUT);
+		if (bo) {
+			return bo;
+		}
+	}
+
+	return real(gbm, width, height, format, modifiers, count);
+}
+
+SHIM_EXPORT struct gbm_bo *gbm_bo_create_with_modifiers2(struct gbm_device *gbm, uint32_t width, uint32_t height,
+							 uint32_t format, const uint64_t *modifiers,
+							 const unsigned int count, uint32_t flags)
+{
+	static struct gbm_bo *(*real)(struct gbm_device *, uint32_t, uint32_t, uint32_t, const uint64_t *,
+				      const unsigned int, uint32_t) = NULL;
+
+	if (!real) {
+		real = dlsym(RTLD_NEXT, "gbm_bo_create_with_modifiers2");
+	}
+	if (!real) {
+		return NULL;
+	}
+
+	if (count == 1 && modifiers && modifiers[0] == DRM_FORMAT_MOD_LINEAR && no_linear()) {
+		struct gbm_bo *bo = gbm_bo_create(gbm, width, height, format, flags | GBM_BO_USE_LINEAR);
+		if (bo) {
+			return bo;
+		}
+	}
+
+	return real(gbm, width, height, format, modifiers, count, flags);
+}
+
+SHIM_EXPORT struct gbm_bo *gbm_bo_import(struct gbm_device *gbm, uint32_t type, void *buffer, uint32_t flags)
+{
+	static struct gbm_bo *(*real)(struct gbm_device *, uint32_t, void *, uint32_t) = NULL;
+
+	if (!real) {
+		real = dlsym(RTLD_NEXT, "gbm_bo_import");
+	}
+	if (!real) {
+		return NULL;
+	}
+
+	if ((flags & GBM_BO_USE_LINEAR) && no_linear()) {
+		struct gbm_bo *bo = real(gbm, type, buffer, renderable(flags));
+		if (bo) {
+			return bo;
+		}
+	}
+
+	return real(gbm, type, buffer, flags);
+}
