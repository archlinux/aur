From 0149edbcb121d629fe478971eecd76d44ef05a91 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Wed, 5 Aug 2026 11:41:08 +0800
Subject: [PATCH 1/2] cmake: Install kde wallpaper to correct path

---
 CMakeLists.txt | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 917e713..8168a3d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -389,10 +389,6 @@ if(WAYWALLEN_DISPLAY_PLUGIN_QML)
             COMMENT "Compiling ${_ww_kde_domain} ${_lang} translation"
             VERBATIM)
         list(APPEND _ww_kde_mo_files "${_mo}")
-        install(FILES "${_mo}"
-            DESTINATION "org.waywallen.kde/contents/locale/${_lang}/LC_MESSAGES"
-            COMPONENT kde_extension
-            EXCLUDE_FROM_ALL)
         install(FILES "${_mo}"
             DESTINATION "${CMAKE_INSTALL_LOCALEDIR}/${_lang}/LC_MESSAGES")
     endforeach()
@@ -402,7 +398,7 @@ if(WAYWALLEN_DISPLAY_PLUGIN_QML)
     # `org.waywallen.kde/{metadata.json,contents/...}` so it can be installed
     # via `kpackagetool6 -i`.
     install(DIRECTORY extensions/kde/package/
-        DESTINATION org.waywallen.kde
+        DESTINATION ${CMAKE_INSTALL_DATADIR}/plasma/wallpapers/org.waywallen.kde
         COMPONENT kde_extension
         EXCLUDE_FROM_ALL
         PATTERN "Wrapper" EXCLUDE)
@@ -415,7 +411,7 @@ if(WAYWALLEN_DISPLAY_PLUGIN_QML)
     foreach(_ww_kde_wrapper IN ITEMS PluginDisplay PluginInfo)
         install(FILES
             "${CMAKE_CURRENT_SOURCE_DIR}/extensions/kde/package/contents/ui/Wrapper/${_ww_kde_wrapper}${_ww_kde_wrapper_suffix}.qml"
-            DESTINATION org.waywallen.kde/contents/ui/Plugin
+            DESTINATION ${CMAKE_INSTALL_DATADIR}/plasma/wallpapers/org.waywallen.kde/contents/ui/Plugin
             RENAME "${_ww_kde_wrapper}.qml"
             COMPONENT kde_extension
             EXCLUDE_FROM_ALL)
-- 
