diff --git a/widget/gtk/WaylandSoftwareVsyncSource.cpp b/widget/gtk/WaylandSoftwareVsyncSource.cpp
new file mode 100644
index 0000000..81aefad
--- /dev/null
+++ b/widget/gtk/WaylandSoftwareVsyncSource.cpp
@@ -0,0 +1,144 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "WaylandSoftwareVsyncSource.h"
+
+#include <dlfcn.h>
+#include <gtk/gtk.h>
+
+#include <algorithm>
+
+#include "SoftwareVsyncSource.h"
+#include "gfxPlatform.h"
+#include "mozilla/StaticPrefs_widget.h"
+#include "nsThreadUtils.h"
+
+using GdkMonitor = struct _GdkMonitor;
+
+namespace mozilla::widget {
+
+bool UseWaylandSoftwareVsync() {
+  return StaticPrefs::widget_wayland_vsync_software_enabled_AtStartup() &&
+         !gtk_check_version(3, 22, 0);
+}
+
+namespace {
+
+// Use Mozilla's existing demand-driven timer and dispatcher lifecycle. This
+// clock schedules browser work; it does not request Wayland frame callbacks
+// or commit surfaces. The compositor can therefore pace scanout from actual
+// buffer submissions. Like the Xrandr software source, this shared source
+// uses the fastest connected output so high-refresh animations remain possible.
+class WaylandSoftwareVsyncSource final : public gfx::SoftwareVsyncSource {
+ public:
+  WaylandSoftwareVsyncSource()
+      : SoftwareVsyncSource(TimeDuration::FromMilliseconds(
+            1000.0 / gfxPlatform::GetSoftwareVsyncRate())) {
+    MOZ_ASSERT(NS_IsMainThread());
+    MOZ_ASSERT(UseWaylandSoftwareVsync());
+    mDisplay = gdk_display_get_default();
+    g_object_ref(mDisplay);
+
+    // Resolve GTK 3.22 symbols at runtime, as ScreenHelperGTK does, preserving
+    // the stock backend on GTK versions older than 3.22.
+    static auto getCount = reinterpret_cast<int (*)(GdkDisplay*)>(
+        dlsym(RTLD_DEFAULT, "gdk_display_get_n_monitors"));
+    static auto getMonitor =
+        reinterpret_cast<GdkMonitor* (*)(GdkDisplay*, int)>(
+            dlsym(RTLD_DEFAULT, "gdk_display_get_monitor"));
+    MOZ_RELEASE_ASSERT(getCount && getMonitor);
+
+    g_signal_connect(mDisplay, "monitor-added", G_CALLBACK(MonitorAdded), this);
+    g_signal_connect(mDisplay, "monitor-removed", G_CALLBACK(MonitorRemoved),
+                     this);
+    for (int i = 0; i < getCount(mDisplay); ++i) {
+      WatchMonitor(getMonitor(mDisplay, i));
+    }
+    UpdateRate();
+  }
+
+  ~WaylandSoftwareVsyncSource() override { DisconnectMonitors(); }
+
+  void Shutdown() override {
+    MOZ_ASSERT(NS_IsMainThread());
+    DisconnectMonitors();
+    SoftwareVsyncSource::Shutdown();
+  }
+
+ private:
+  void WatchMonitor(GdkMonitor* aMonitor) {
+    if (!aMonitor || mMonitors.Contains(aMonitor)) {
+      return;
+    }
+    g_object_ref(aMonitor);
+    mMonitors.AppendElement(aMonitor);
+    g_signal_connect(aMonitor, "notify::refresh-rate", G_CALLBACK(RateChanged),
+                     this);
+  }
+
+  void UnwatchMonitor(GdkMonitor* aMonitor) {
+    if (mMonitors.RemoveElement(aMonitor)) {
+      g_signal_handlers_disconnect_by_data(aMonitor, this);
+      g_object_unref(aMonitor);
+    }
+  }
+
+  void DisconnectMonitors() {
+    MOZ_ASSERT(NS_IsMainThread());
+    while (!mMonitors.IsEmpty()) {
+      UnwatchMonitor(mMonitors.LastElement());
+    }
+    if (mDisplay) {
+      g_signal_handlers_disconnect_by_data(mDisplay, this);
+      g_object_unref(mDisplay);
+      mDisplay = nullptr;
+    }
+  }
+
+  void UpdateRate() {
+    MOZ_ASSERT(NS_IsMainThread());
+    static auto getRate = reinterpret_cast<int (*)(GdkMonitor*)>(
+        dlsym(RTLD_DEFAULT, "gdk_monitor_get_refresh_rate"));
+    MOZ_RELEASE_ASSERT(getRate);
+    int fastestMilliHz = 0;
+    for (auto* monitor : mMonitors) {
+      fastestMilliHz = std::max(fastestMilliHz, getRate(monitor));
+    }
+    // Preserve fractional rates (e.g. 59.94 Hz). Use the upstream fallback
+    // only until GTK has announced a valid output mode.
+    double rateMs = fastestMilliHz > 0
+                        ? 1000000.0 / fastestMilliHz
+                        : 1000.0 / gfxPlatform::GetSoftwareVsyncRate();
+    SetVsyncRate(TimeDuration::FromMilliseconds(rateMs));
+  }
+
+  static void MonitorAdded(GdkDisplay*, GdkMonitor* aMonitor, gpointer aData) {
+    auto* self = static_cast<WaylandSoftwareVsyncSource*>(aData);
+    self->WatchMonitor(aMonitor);
+    self->UpdateRate();
+  }
+
+  static void MonitorRemoved(GdkDisplay*, GdkMonitor* aMonitor,
+                             gpointer aData) {
+    auto* self = static_cast<WaylandSoftwareVsyncSource*>(aData);
+    self->UnwatchMonitor(aMonitor);
+    self->UpdateRate();
+  }
+
+  static void RateChanged(GObject*, GParamSpec*, gpointer aData) {
+    static_cast<WaylandSoftwareVsyncSource*>(aData)->UpdateRate();
+  }
+
+  GdkDisplay* mDisplay = nullptr;
+  AutoTArray<GdkMonitor*, 4> mMonitors;
+};
+
+}  // namespace
+
+already_AddRefed<gfx::VsyncSource> CreateWaylandSoftwareVsyncSource() {
+  RefPtr<gfx::VsyncSource> source = new WaylandSoftwareVsyncSource();
+  return source.forget();
+}
+
+}  // namespace mozilla::widget
