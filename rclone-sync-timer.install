post_install() {
    echo "One config file per remote in ~/.config/rclone-sync/<remote>.conf:"
    echo "  mkdir -p ~/.config/rclone-sync"
    echo "  cp /usr/share/doc/rclone-sync-timer/example.conf ~/.config/rclone-sync/<remote>.conf"
    echo "  systemctl --user enable --now rclone-sync@<remote>.timer"
    echo "The units run as your user with your own rclone config, no root needed."
    echo "To sync while logged out run: loginctl enable-linger <your-user>"
    echo "See /usr/share/doc/rclone-sync-timer/README.md."
}

post_upgrade() {
    post_install
}
