<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The modules only compile against reference packages, which are built from source as well:
       PowerShell Standard (dotnet-powershellstandard-library) and the reference packages of .NET's
       source build (dotnet-source-build-reference-packages). Nothing comes from nuget.org. -->
  <packageSources>
    <clear />
    <add key="dotnet-packages" value="/usr/share/dotnet/nuget-packages" />
    <add key="dotnet-source-build-reference-packages" value="/usr/share/dotnet/source-build-reference-packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="dotnet-packages">
      <package pattern="PowerShellStandard.Library" />
    </packageSource>
    <packageSource key="dotnet-source-build-reference-packages">
      <package pattern="NETStandard.Library" />
      <package pattern="Microsoft.NETCore.Platforms" />
      <package pattern="Microsoft.CSharp" />
    </packageSource>
  </packageSourceMapping>
</configuration>
