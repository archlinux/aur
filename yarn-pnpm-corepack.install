#!/bin/bash
all_off="$(tput sgr0)"
bold="${all_off}$(tput bold)"
blue="${bold}$(tput setaf 4)"
# yellow="${bold}$(tput setaf 3)"

post_install() {
    echo "  ${blue}-> NOTE: ${all_off}"
    echo "      This package (yarn-pnpm-corepack) is replaced by 'npm-yarn-pnpm-corepack' which provides the same functionality,"
    echo "      but split into individual packages. This package is now a virtual package with no content."
    echo "      You can safely remove this package after installing 'yarn-corepack' and 'pnpm-corepack'."
}
