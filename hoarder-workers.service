[Unit]
Description = Hoarder Workers
Wants = network-online.target hoarder-browser.service ollama.service
After = network-online.target hoarder-browser.service ollama.service

[Service]
User = hoarder
Restart = on-failure
EnvironmentFile = -/etc/hoarder/hoarder.env
Environment = DATA_DIR=/var/lib/hoarder
WorkingDirectory = /usr/lib/hoarder/apps/workers
ExecStart = /usr/bin/pnpm run start:prod
TimeoutStopSec = 5
SyslogIdentifier = hoarder-workers
ProtectSystem = yes
PrivateTmp = yes
NoNewPrivileges = yes

[Install]
WantedBy = multi-user.target
