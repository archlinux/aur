#!/bin/sh
# Launcher for the Bloodborne bbport package.
#
# Same environment the previous desktop shortcut used. The game dump stays where
# it is; override BB_GAME_DIR if yours lives elsewhere.
export APPIMAGE_EXTRACT_AND_RUN=1
export TMPDIR="${TMPDIR:-${XDG_CACHE_HOME:-$HOME/.cache}}"
export NO_CLEANUP=1
export BB_GAME_DIR="${BB_GAME_DIR:-$HOME/Games/BloodBorne/game/CUSA03173}"
export BB_DLSS="${BB_DLSS:-0}"

exec /opt/ports/bloodborne-pc/Bloodborne-bbport.AppImage "$@"
