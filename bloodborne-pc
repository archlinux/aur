#!/bin/sh
# Launcher for the Bloodborne Lantern Engine package.
# The game dump, saves, mods and logs stay outside the package.
set -eu

data_dir="${BB_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bbport}"
out_dir="${BB_OUT_DIR:-$data_dir/out}"

mkdir -p "$data_dir" "$out_dir" "$data_dir/user" "$data_dir/mods" "$data_dir/logs" "$data_dir/patches"
export BB_DATA_DIR="$data_dir"
export BB_OUT_DIR="$out_dir"
export BB_CONFIG="${BB_CONFIG:-$data_dir/lantern.ini}"

if [ ! -f "$BB_CONFIG" ]; then
  cp /opt/ports/bloodborne-pc/engine/lantern.default.ini "$BB_CONFIG"
fi

cd /opt/ports/bloodborne-pc
exec './Lantern Engine' "$@"
