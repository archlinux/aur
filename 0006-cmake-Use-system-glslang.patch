From 5142c901532d250b260de72a67cb9d6b8bc08b19 Mon Sep 17 00:00:00 2001
From: Zhang Hua <zhanghua.00@qq.com>
Date: Sun, 12 Jul 2026 10:11:33 +0800
Subject: [PATCH 6/7] cmake: Use system glslang

---
 deps.json                 | 12 ------------
 src/CMakeLists.txt        |  1 +
 src/Vulkan/CMakeLists.txt |  2 +-
 src/Vulkan/Shader.cpp     |  2 +-
 4 files changed, 3 insertions(+), 14 deletions(-)

diff --git a/deps.json b/deps.json
index 2ba15bb..bda7aab 100644
--- a/deps.json
+++ b/deps.json
@@ -9,18 +9,6 @@
       "exclude_from_all": true
     }
   },
-  {
-    "dest": "build/_flatpak_deps/glslang-src",
-    "disable-shallow-clone": false,
-    "tag": "16.3.0",
-    "commit": "275822a6261ee689aadb1da5f09a0ec2f058685c",
-    "type": "git",
-    "url": "https://github.com/KhronosGroup/glslang.git",
-    "x-cmake": {
-      "name": "glslang",
-      "exclude_from_all": true
-    }
-  },
   {
     "dest": "build/_flatpak_deps/rstd-src",
     "disable-shallow-clone": true,
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 0c922de..04ad44c 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -6,6 +6,7 @@ find_package(OpenGL REQUIRED)
 find_package(Threads REQUIRED)
 find_package(Vulkan REQUIRED)
 find_package(Freetype REQUIRED)
+find_package(glslang 16.3.0 REQUIRED)
 pkg_check_modules(LZ4 REQUIRED liblz4)
 pkg_check_modules(FONTCONFIG REQUIRED IMPORTED_TARGET fontconfig)
 
diff --git a/src/Vulkan/CMakeLists.txt b/src/Vulkan/CMakeLists.txt
index 2d3ef4e..aa21c6c 100644
--- a/src/Vulkan/CMakeLists.txt
+++ b/src/Vulkan/CMakeLists.txt
@@ -7,7 +7,7 @@ target_sources(owe-shader-compile
   PUBLIC FILE_SET cxx_modules TYPE CXX_MODULES FILES ShaderCompile.cppm)
 target_link_libraries(owe-shader-compile
   PUBLIC rstd::rstd rstd.cppstd owe-types wavsen::ffi::vulkan
-  PRIVATE glslang SPIRV glslang-default-resource-limits spirv-reflect-static)
+  PRIVATE glslang::glslang SPIRV glslang::glslang-default-resource-limits spirv-reflect-static)
 target_include_directories(owe-shader-compile
   PUBLIC  .. ../Scene/Utils/include
   PRIVATE ../Scene/Utils ../Scene/Utils/include/Utils .)
diff --git a/src/Vulkan/Shader.cpp b/src/Vulkan/Shader.cpp
index 17a7069..ab1f9e6 100644
--- a/src/Vulkan/Shader.cpp
+++ b/src/Vulkan/Shader.cpp
@@ -5,7 +5,7 @@ module;
 
 #include <glslang/Public/ShaderLang.h>
 #include <glslang/Public/ResourceLimits.h>
-#include <SPIRV/GlslangToSpv.h>
+#include <glslang/SPIRV/GlslangToSpv.h>
 
 #include "Utils/Sha.hpp"
 module wescene.shader_compile;
-- 
2.55.0

