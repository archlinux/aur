post_install() {
    echo -e "\e[1;34m=======================================================================\e[0m"
    echo -e "\e[1;32m ScholarFlow (Yerel Akademik Sistem) başarıyla kuruldu! \e[0m"
    echo -e "\e[1;34m=======================================================================\e[0m"
    echo " Uygulamayı menüden veya terminalden 'scholarflow-gui' yazarak başlatabilirsiniz."
    echo ""
    echo " KDE Kullanıcıları İçin İpucu:"
    echo " ----------------------------"
    echo " Uygulama Meta+W (Win+W) kısayolu ile açılacak şekilde yapılandırıldı."
    echo " Eğer kısayol otomatik aktif olmazsa, Sistem Ayarları -> Kısayollar ->"
    echo " Özel Kısayollar kısmından ScholarFlow için bir kısayol atayabilirsiniz."
    echo ""
    echo " Tüm verileriniz yerel olarak ~/.config veya tarayıcı belleğinde saklanır."
    echo -e "\e[1;34m=======================================================================\e[0m"
}

post_upgrade() {
    post_install
}
