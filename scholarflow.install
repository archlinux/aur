post_install() {
    echo -e "\e[1;34m=======================================================================\e[0m"
    echo -e "\e[1;32m ScholarFlow (Elite Academic Suite) başarıyla kuruldu! \e[0m"
    echo -e "\e[1;34m=======================================================================\e[0m"
    echo " Dosyalarınız şu dizine yerleştirildi: /usr/share/webapps/scholarflow"
    echo ""
    echo " Bu bir sunucu (web) uygulamasıdır. Yayına almak için iki seçeneğiniz var:"
    echo ""
    echo " 1. Nginx veya Caddy gibi bir web sunucusunu üstteki dizine yönlendirin."
    echo " 2. Veya PM2 (Process Manager) kullanarak doğrudan başlatın:"
    echo "    $ cd /usr/share/webapps/scholarflow"
    echo "    $ pm2 start ecosystem.config.cjs"
    echo ""
    echo " Detaylı Bilgi için read me dosyasını okuyun!"
    echo -e "\e[1;34m=======================================================================\e[0m"
}

post_upgrade() {
    post_install
}
