[Unit]
Description=Check for Antigravity updates via Debian repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/markus/zWork/_Git/AUR/PKGSRC/antigravity-bin-hardened
ExecStart=/home/markus/zWork/_Git/AUR/PKGSRC/antigravity-bin-hardened/fetch-antigravity-version.sh
StandardOutput=journal
StandardError=journal

# Send notification on completion
ExecStartPost=/bin/bash -c 'notify-send "Antigravity Update Check" "Check complete. View with: journalctl --user -u antigravity-update-check.service -n 50"'

[Install]
WantedBy=default.target
