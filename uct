#!/bin/bash

# Check if a file argument is provided
if [ $# -ne 1 ]; then
    echo "Usage: $0 <filename>"
    exit 1
fi

# Get the file extension
filename="$1"
extension="${filename##*.}"

# Get the base name without the extension
base_name=$(basename "$filename")

case "$extension" in
    c)
        clang "$filename" -o "${base_name%.c}" && ./"${base_name%.c}"
        ;;
    cpp)
        clang++ "$filename" -o "${base_name%.cpp}" && ./"${base_name%.cpp}"
        ;;
    java)
        javac "$filename" && java "${base_name%.java}"
        ;;
    py)
        python "$filename"
        ;;
    *)
        echo "Unsupported file type: $extension"
        exit 1
        ;;
esac

