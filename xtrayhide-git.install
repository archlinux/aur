post_install() {
  cat << 'EOF'

==> xtrayhide has been installed.
==> To enable and start the systemd‑user service (optional):
==>   systemctl --user enable --now xtrayhide
==>
==> ⚠️ Choose only one startup method!
==> Do NOT enable both the systemd‑user service and spawn it inside your niri config.
==> The tray proxy must be started BEFORE launching any Wine / Proton applications.
==> If you prefer starting it from niri, add this line to your config:
==>   spawn "xtrayhide"
EOF
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl --user disable --now xtrayhide 2>/dev/null || true
}
