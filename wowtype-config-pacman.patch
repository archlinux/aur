+def pacman_version(package):
+    """已装 pacman 包的版本；没装（或不是 Arch 系）返回 None。"""
+    try:
+        out = subprocess.run(["pacman", "-Q", package],
+                             capture_output=True, text=True, timeout=10)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    parts = out.stdout.split()
+    return parts[1] if out.returncode == 0 and len(parts) >= 2 else None
+
+
+def installed_version():
+    """不管用 deb 还是 pacman 装的，返回已装版本；都没有返回 None。"""
+    return pacman_version(ENGINE_PKG) or dpkg_version(ENGINE_PKG)
+
