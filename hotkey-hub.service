[Unit]
Description=Hotkey hub
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hotkey-hub \
  --cert-dir=%h/.local/share/hotkey-hub/certs \
  --variables-file=%h/.local/share/hotkey-hub/configs/variables.jsonc \
  --config-file=%h/.local/share/hotkey-hub/configs/config.jsonc \
  --api-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
