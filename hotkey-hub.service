[Unit]
Description=Hotkey Hub
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hotkey-hub \
  --cert-dir=%h/.config/hotkey-hub/certs \
  --variables-file=%h/.config/hotkey-hub/variables.jsonc \
  --config-file=%h/.config/hotkey-hub/config.jsonc \
  --api-server
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
