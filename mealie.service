[Unit]
Description=Mealie Server
After=network.target

[Service]
User=mealie
Group=mealie
ExecStart=/usr/bin/python /usr/lib/_PYTHONDIR/site-packages/mealie/main.py
Environment=STATIC_FILES=/usr/lib/mealie/dist
Environment=PRODUCTION=true
Environment=DATA_DIR=/var/lib/mealie
EnvironmentFile=/etc/mealie.conf

[Install]
WantedBy=multi-user.target
