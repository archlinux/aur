+static void
+gb_blur_effect_init (GbBlurEffect *self)
+{
+  self->mode = GB_BLUR_MODE_ACTOR;
+  self->radius = 0;
+  self->brightness = 1.f;
+  self->corner_radius = 0.f;
+
+  /* Pipelines need a CoglContext, which is only reachable through the actor
+   * at paint time; created lazily in ensure_pipelines().
+   */
+  self->actor_fb.pipeline = NULL;
+  self->background_fb.pipeline = NULL;
+  self->brightness_fb.pipeline = NULL;
+  self->mask_fb.pipeline = NULL;
+  self->brightness_uniform = -1;
+  self->corner_radius_uniform = -1;
+  self->mask_size_uniform = -1;
+}
