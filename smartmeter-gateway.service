[Unit]
Description=Protocol gateway for domestic meter telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/smartmeter-gateway --config /etc/smartmeter-gateway/config.yaml
User=meter
Group=meter

# Grant permission to bind privileged ports (if using TCP port < 1024)
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sandboxing
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Restart policy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
