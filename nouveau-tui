#!/usr/bin/env python3
"""
nouveau-tui - Interactive GPU Performance & Reclocking Manager for Nouveau Fermi (GF100-GF119)
Designed with a clean, focused 3-tab layout matching pulsemixer / qpowerconfig:
 - Tab 1: P-States & Governor (Manual clock locking + Dynamic Governor auto-reclock toggle + Thermal Cap adjustment)
 - Tab 2: 3D Clients (Live active DRM GPU clients & PIDs)
 - Tab 3: Telemetry (Real-time clocks, temperature, voltage, fan speed, PCIe link & hardware sensors)
"""

import curses
import glob
import os
import re
import signal
import subprocess
import sys
import time

PSTATE_PATH = "/sys/kernel/debug/dri/0/pstate"
CLIENTS_PATH = "/sys/kernel/debug/dri/0/clients"
CONFIG_PATH = "/etc/nouveau-dynclockd.conf"
SNAPSHOT_DIR = "/run/nouveau"
PSTATE_SNAPSHOT = os.path.join(SNAPSHOT_DIR, "pstate")
CLIENTS_SNAPSHOT = os.path.join(SNAPSHOT_DIR, "clients")
STATUS_SNAPSHOT = os.path.join(SNAPSHOT_DIR, "status")
MODE_PATH = os.path.join(SNAPSHOT_DIR, "mode")

PSTATE_DESCRIPTIONS = {
    "03": "P12 Low-Power Standby / Idle",
    "07": "P8  Standard 2D Desktop",
    "08": "P8  Standard 2D Desktop",
    "0f": "P0  Full 3D Performance",
    "10": "OC  Boost / Overclock",
}

def run_cmd(cmd, timeout=3):
    try:
        return subprocess.check_output(cmd, shell=True, timeout=timeout).decode("utf-8", errors="replace").strip()
    except Exception:
        return ""

def read_debugfs_file(path):
    # Check world-readable runtime snapshot first (zero privilege, instant < 0.1ms read)
    if "pstate" in path and os.path.exists(PSTATE_SNAPSHOT):
        try:
            if os.path.exists(MODE_PATH):
                mode_mt = os.path.getmtime(MODE_PATH)
                for _ in range(15):
                    if os.path.getmtime(PSTATE_SNAPSHOT) >= mode_mt:
                        break
                    time.sleep(0.01)
            with open(PSTATE_SNAPSHOT, "r") as f:
                c = f.read()
                if c:
                    return c
        except Exception:
            pass
    elif "clients" in path and os.path.exists(CLIENTS_SNAPSHOT):
        try:
            with open(CLIENTS_SNAPSHOT, "r") as f:
                c = f.read()
                if c:
                    return c
        except Exception:
            pass

    try:
        with open(path, "r") as f:
            return f.read()
    except Exception:
        pass
    return run_cmd(f"sudo /bin/cat {path} 2>/dev/null", timeout=1)

def save_throttle_temp(temp):
    conf_path = CONFIG_PATH
    lines = []
    found = False
    if os.path.exists(conf_path):
        try:
            with open(conf_path, "r") as f:
                for line in f:
                    if line.strip().startswith("THROTTLE_TEMP="):
                        lines.append(f"THROTTLE_TEMP={temp}\n")
                        found = True
                    else:
                        lines.append(line)
        except Exception:
            pass
    if not found:
        lines.append(f"THROTTLE_TEMP={temp}\n")

    content = "".join(lines)
    try:
        with open(conf_path, "w") as f:
            f.write(content)
    except PermissionError:
        run_cmd(f"echo '{content}' | sudo tee {conf_path} >/dev/null")

    run_cmd("sudo systemctl kill -s HUP nouveau-dynclockd.service 2>/dev/null")

def get_pstates():
    pstates = []
    active_code = None
    content = read_debugfs_file(PSTATE_PATH)

    for line in content.splitlines():
        line = line.strip()
        if not line or line.startswith("AC:") or line.startswith("DC:"):
            continue
        if line.startswith("VRAM:"):
            continue
        parts = line.split(":")
        if len(parts) >= 2:
            code = parts[0].strip()
            rest = parts[1].strip()
            is_active = ("*" in rest)
            
            core_m = re.search(r'core\s+(\d+)', rest)
            shader_m = re.search(r'shader\s+(\d+)', rest)
            mem_m = re.search(r'memory\s+(\d+)', rest)

            core_clk = int(core_m.group(1)) if core_m else 0
            shader_clk = int(shader_m.group(1)) if shader_m else 0
            mem_clk = int(mem_m.group(1)) if mem_m else 0

            desc = PSTATE_DESCRIPTIONS.get(code, "Custom Performance State")
            if is_active:
                active_code = code

            pstates.append({
                "code": code,
                "core": core_clk,
                "shader": shader_clk,
                "mem": mem_clk,
                "active": is_active,
                "desc": desc,
            })
    return pstates, active_code

def get_telemetry():
    temp_str = "N/A"
    temp_val = None
    volt_str = "N/A"
    fan_str = "N/A"
    pcie_str = "N/A"
    throttle_temp = 80

    for hwmon in glob.glob("/sys/class/drm/card0/device/hwmon/hwmon*/"):
        try:
            t_val = int(open(os.path.join(hwmon, "temp1_input")).read().strip())
            temp_val = t_val / 1000.0
            temp_str = f"{temp_val:.1f} °C"
        except Exception:
            pass
        try:
            v_val = int(open(os.path.join(hwmon, "in0_input")).read().strip())
            volt_str = f"{v_val / 1000.0:.3f} V"
        except Exception:
            pass
        try:
            f_val = open(os.path.join(hwmon, "fan1_input")).read().strip()
            if f_val.isdigit():
                fan_str = f"{f_val} RPM (GPU Fan)"
        except Exception:
            pass

    # Platform/System Fan (e.g. dell_smm)
    if fan_str == "N/A":
        for hw_path in glob.glob("/sys/class/hwmon/hwmon*/"):
            for f in glob.glob(os.path.join(hw_path, "fan*_input")):
                try:
                    f_val = open(f).read().strip()
                    if f_val.isdigit():
                        lbl_file = f.replace("_input", "_label")
                        lbl = open(lbl_file).read().strip() if os.path.exists(lbl_file) else "Processor Fan"
                        fan_str = f"{f_val} RPM ({lbl})"
                        break
                except Exception:
                    pass
            if fan_str != "N/A":
                break

    # PCIe Link
    dev_path = "/sys/bus/pci/devices/0000:01:00.0/"
    try:
        cur_spd = open(dev_path + "current_link_speed").read().strip()
        cur_wid = open(dev_path + "current_link_width").read().strip()
        max_spd = open(dev_path + "max_link_speed").read().strip()
        max_wid = open(dev_path + "max_link_width").read().strip()
        gen_cur = " (Gen1)" if "2.5" in cur_spd else (" (Gen2)" if "5.0" in cur_spd else "")
        gen_max = " (Gen1)" if "2.5" in max_spd else (" (Gen2)" if "5.0" in max_spd else "")
        pcie_str = f"{cur_spd.replace(' PCIe', '')}{gen_cur} x{cur_wid}  [Max: {max_spd.replace(' PCIe', '')}{gen_max} x{max_wid}]"
    except Exception:
        pass

    # Read configured throttle limit
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("THROTTLE_TEMP="):
                        throttle_temp = int(line.split("=", 1)[1].strip())
        except Exception:
            pass

    daemon_active = "active" in run_cmd("systemctl is-active nouveau-dynclockd 2>/dev/null", timeout=1)
    lock_target = None
    mode_str = "auto"
    disp_clk_khz = None
    disp_ref_hz = None
    idle_floor = "07"
    irqs_per_sec = None

    if os.path.exists(MODE_PATH):
        try:
            with open(MODE_PATH, "r") as f:
                val = f.read().strip()
                if val.startswith("locked:"):
                    lock_target = val.split(":", 1)[1].strip()
                    mode_str = f"locked:{lock_target}"
                elif val == "auto":
                    mode_str = "auto"
        except Exception:
            pass

    if os.path.exists(STATUS_SNAPSHOT):
        try:
            with open(STATUS_SNAPSHOT, "r") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        if k == "display_clock_khz" and v.isdigit():
                            disp_clk_khz = int(v)
                        elif k == "display_refresh_hz" and v.isdigit():
                            disp_ref_hz = int(v)
                        elif k == "idle_floor":
                            idle_floor = v
                        elif k == "interrupts_per_sec":
                            try:
                                irqs_per_sec = float(v)
                            except ValueError:
                                pass
        except Exception:
            pass

    power = get_power_source()
    vram = get_vram_data()
    if vram["total_mib"] and vram["used_mib"] is not None:
        vram_str = f"{vram['used_mib']:.0f} / {vram['total_mib']:.0f} MiB ({100.0 * vram['used_mib'] / vram['total_mib']:.0f}%)"
    elif vram["total_mib"]:
        vram_str = f"? / {vram['total_mib']:.0f} MiB"
    else:
        vram_str = "N/A"
    power_str = {"AC": "AC (unlimited)", "BAT": "Battery DC (cap 07)"}.get(power, "Unknown")

    return {
        "temp": temp_str,
        "temp_val": temp_val,
        "volt": volt_str,
        "fan": fan_str,
        "pcie": pcie_str,
        "throttle_temp": throttle_temp,
        "daemon": daemon_active,
        "power": power_str,
        "vram": vram_str,
        "mode": mode_str,
        "lock_target": lock_target,
        "disp_clk_khz": disp_clk_khz,
        "disp_ref_hz": disp_ref_hz,
        "idle_floor": idle_floor,
        "irqs_per_sec": irqs_per_sec,
    }

def get_clients():
    clients = []
    content = read_debugfs_file(CLIENTS_PATH)
    lines = content.splitlines()
    if len(lines) > 1:
        for line in lines[1:]:
            parts = line.split()
            if len(parts) >= 2:
                cmd_name = parts[0]
                pid = parts[1]
                if cmd_name not in ("systemd-logind", "<unset>"):
                    clients.append({"cmd": cmd_name, "pid": pid})
    return clients

def get_power_source():
    try:
        base = "/sys/class/power_supply"
        if not os.path.isdir(base):
            return "UNKNOWN"
        ac_online = None
        bat_status = None
        for name in os.listdir(base):
            node = os.path.join(base, name)
            try:
                with open(os.path.join(node, "type"), "r") as f:
                    ptype = f.read().strip()
            except Exception:
                ptype = ""
            upper = name.upper()
            if upper.startswith(("ADP", "AC")) or ptype == "Mains":
                try:
                    with open(os.path.join(node, "online"), "r") as f:
                        ac_online = (f.read().strip() == "1")
                except Exception:
                    pass
            if upper.startswith("BAT") or ptype == "Battery":
                try:
                    with open(os.path.join(node, "status"), "r") as f:
                        bat_status = f.read().strip()
                except Exception:
                    pass
        if ac_online is True:
            return "AC"
        if ac_online is False:
            return "BAT"
        if bat_status == "Discharging":
            return "BAT"
        if bat_status in ("Charging", "Full", "Not charging"):
            return "AC"
        return "AC" if bat_status is None else "UNKNOWN"
    except Exception:
        return "UNKNOWN"

def get_vram_data():
    total_mib = None
    try:
        for cmd in ("journalctl -k -b 0 2>/dev/null", "dmesg 2>/dev/null"):
            out = run_cmd(cmd, timeout=5)
            m = re.search(r"drm:\s*VRAM:\s*(\d+)\s*MiB", out or "")
            if m:
                total_mib = int(m.group(1))
                break
    except Exception:
        pass
    used_mib = None
    source = None
    try:
        snap = "/run/nouveau/vram"
        if os.path.exists(snap) and (time.time() - os.path.getmtime(snap)) < 15:
            vals = {}
            with open(snap, "r") as f:
                for line in f:
                    if "=" in line:
                        k, v = line.strip().split("=", 1)
                        vals[k.strip()] = v.strip()
            if "used_mib" in vals:
                used_mib = float(vals["used_mib"])
                source = "daemon"
            if "total_mib" in vals:
                try:
                    total_mib = int(float(vals["total_mib"]))
                except ValueError:
                    pass
    except Exception:
        pass
    try:
        raw = read_debugfs_file(PSTATE_PATH)
        if raw:
            m = re.search(r"VRAM:\s*(\d+)\s*MiB\s*/\s*(\d+)\s*MiB", raw)
            if m:
                used_mib = float(m.group(1))
                total_mib = int(m.group(2))
                source = "pstate"
    except Exception:
        pass
    try:
        for node in ("/sys/kernel/debug/dri/0/gpuva",
                      "/sys/kernel/debug/dri/0000:01:00.0/gpuva"):
            raw = read_debugfs_file(node)
            if not raw:
                continue
            total_bytes = 0
            for line in raw.splitlines():
                if "|" not in line or "start" in line.lower():
                    continue
                parts = [p.strip() for p in line.split("|")]
                hexes = [p for p in parts if re.fullmatch(r"0x[0-9a-fA-F]+", p)]
                if len(hexes) >= 2:
                    try:
                        total_bytes += int(hexes[1], 16)
                    except ValueError:
                        continue
            if total_bytes > 0:
                used_mib = total_bytes / (1024.0 * 1024.0)
                source = "gpuva"
                break
    except Exception:
        pass
    return {"total_mib": total_mib, "used_mib": used_mib, "source": source}

class Style:
    bar_top_left       = '┌'
    bar_left_mono      = '╶'
    bar_top_right      = '┐'
    bar_right_mono     = '╴'
    bar_bottom_left    = '└'
    bar_bottom_right   = '┘'
    bar_on             = '▮'
    bar_off            = '-'
    arrow              = ' '
    arrow_focused      = '▶'

class NouveauTUI:
    MODE_NAMES = ["1 P-States & Governor", "2 3D Clients", "3 Telemetry"]

    def __init__(self, stdscr):
        self.screen = stdscr
        self.active_mode = 0
        self.focus_idx = 0
        self.top_idx = 0
        self.status_msg = ""
        self.status_color = 1

        self.pstates = []
        self.active_pstate = "07"
        self.telemetry = {}
        self.clients = []

        self.init_curses()
        self.init_colors()
        self.refresh_data()

    def init_curses(self):
        curses.curs_set(0)
        curses.halfdelay(10)
        self.screen.keypad(True)
        self.screen.border(0)
        self.screen.clear()
        self.screen.refresh()

    def init_colors(self):
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_GREEN, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            curses.init_pair(3, curses.COLOR_RED, -1)
            curses.init_pair(4, curses.COLOR_CYAN, -1)
            curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(6, curses.COLOR_MAGENTA, -1)
            curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_GREEN)
            curses.init_pair(8, curses.COLOR_WHITE, curses.COLOR_BLUE)
            curses.init_pair(9, curses.COLOR_BLACK, curses.COLOR_WHITE)
            self.green = curses.color_pair(1)
            self.yellow = curses.color_pair(2)
            self.red = curses.color_pair(3)
            self.cyan = curses.color_pair(4)
            self.inv = curses.color_pair(5)
            self.magenta = curses.color_pair(6)
            self.badge = curses.color_pair(7)
            self.tab_active = curses.color_pair(8)
            self.key_badge = curses.color_pair(9)
        else:
            self.green = self.yellow = self.red = self.cyan = self.inv = self.magenta = self.badge = self.tab_active = self.key_badge = curses.A_NORMAL

    def refresh_data(self):
        self.pstates, self.active_pstate = get_pstates()
        self.telemetry = get_telemetry()
        self.clients = get_clients()

    def safe_addstr(self, y, x, text, attr=0):
        h, w = self.screen.getmaxyx()
        if 0 <= y < h - 1 and 0 <= x < w:
            max_len = max(0, w - x - 1)
            if max_len > 0:
                try:
                    self.screen.addstr(y, x, str(text)[:max_len], attr)
                except curses.error:
                    pass

    def draw_top_bar(self, lines, cols):
        x = 2
        for i, title in enumerate(self.MODE_NAMES):
            is_active = (i == self.active_mode)
            if is_active:
                attr = self.inv | curses.A_BOLD
            else:
                attr = self.cyan
            self.safe_addstr(0, x, f" {title} ", attr)
            x += len(title) + 4

    def draw_keybind_ribbon(self, start_y, cols):
        if self.active_mode == 0:
            row1 = [
                ("Space/Enter", "Lock / Toggle"),
                ("a", "Auto Mode"),
                ("R", "Reload Daemon"),
                ("t / - / +", "Throttle Temp"),
                ("r", "Refresh"),
            ]
            row2 = [
                ("1..3", "Direct Tab"),
                ("← / →", "Switch Tabs"),
                ("F1", "Help"),
                ("Esc", "Quit"),
            ]
        elif self.active_mode == 1:
            row1 = [
                ("r", "Refresh Process Table"),
                ("k / j", "Scroll Client List"),
            ]
            row2 = [
                ("1..3", "Direct Tab"),
                ("← / →", "Switch Tabs"),
                ("F1", "Help"),
                ("Esc", "Quit"),
            ]
        else:
            row1 = [
                ("r", "Poll Hardware Sensors"),
                ("t / - / +", "Adjust Throttle Limit"),
            ]
            row2 = [
                ("1..3", "Direct Tab"),
                ("← / →", "Switch Tabs"),
                ("F1", "Help"),
                ("Esc", "Quit"),
            ]

        y = start_y
        for row in (row1, row2):
            x = 2
            for key, desc in row:
                if x >= cols - 15:
                    break
                self.safe_addstr(y, x, f"[{key}]", self.cyan | curses.A_BOLD)
                x += len(key) + 3
                self.safe_addstr(y, x, f"{desc}  ", curses.A_DIM)
                x += len(desc) + 2
            y += 1

    def render_bar(self, width, current, max_val):
        if width <= 0 or max_val <= 0:
            return ""
        filled = int((current / max_val) * width)
        filled = max(0, min(filled, width))
        return (Style.bar_on * filled) + (Style.bar_off * (width - filled))

    def prompt_throttle_temp(self):
        curses.echo()
        curses.curs_set(1)
        h, w = self.screen.getmaxyx()
        prompt = "Enter thermal throttle temperature in °C (50-95): "
        self.safe_addstr(h - 1, 0, " " * (w - 1), curses.A_NORMAL)
        self.safe_addstr(h - 1, 2, prompt, self.cyan | curses.A_BOLD)
        self.screen.refresh()
        try:
            inp = self.screen.getstr(h - 1, len(prompt) + 2, 4).decode("utf-8").strip()
            if inp.isdigit():
                val = int(inp)
                if 50 <= val <= 95:
                    save_throttle_temp(val)
                    self.telemetry["throttle_temp"] = val
                    self.status_msg = f"Thermal throttle limit set to {val} °C."
                    self.status_color = 1
                else:
                    self.status_msg = "Invalid temperature: must be between 50 and 95 °C."
                    self.status_color = 3
            else:
                self.status_msg = "Cancelled: invalid input."
                self.status_color = 2
        except Exception:
            self.status_msg = "Input cancelled."
            self.status_color = 2
        curses.noecho()
        curses.curs_set(0)
        curses.halfdelay(10)
        self.refresh_data()

    def display(self):
        lines, cols = self.screen.getmaxyx()
        self.screen.erase()
        self.screen.border(0)

        self.draw_top_bar(lines, cols)

        footer_y = lines - 3
        self.draw_keybind_ribbon(footer_y, cols)

        if self.status_msg:
            attr = self.green if self.status_color == 1 else (self.yellow if self.status_color == 2 else self.red)
            self.safe_addstr(lines - 1, 2, f" {self.status_msg} ", attr | curses.A_BOLD)

        y = 2
        max_drawable_y = footer_y - 1
        bar_avail_width = max(10, min(50, cols - 35))

        # TAB 1: P-States & Governor
        if self.active_mode == 0:
            daemon_active = self.telemetry.get("daemon", False)
            total_items = 1 + len(self.pstates)
            self.focus_idx = max(0, min(self.focus_idx, total_items - 1))

            # Entry 0: Governor Daemon
            is_gov_focus = (self.focus_idx == 0)
            arrow = Style.arrow_focused if is_gov_focus else Style.arrow
            self.safe_addstr(y, 2, f" {arrow} ", self.cyan | curses.A_BOLD if is_gov_focus else curses.A_NORMAL)

            gov_title = "Dynamic Frequency Governor (nouveau-dynclockd)"
            lock_target = self.telemetry.get("lock_target")
            if daemon_active:
                if lock_target:
                    gov_badge = f"[●] LOCKED: {lock_target} (ACTIVE)"
                    gov_badge_col = self.cyan | curses.A_BOLD
                else:
                    gov_badge = "[●] AUTO (DYNAMIC GOVERNOR)"
                    gov_badge_col = self.badge | curses.A_BOLD
            else:
                gov_badge = "[○] INACTIVE (DAEMON STOPPED)"
                gov_badge_col = self.yellow

            self.safe_addstr(y, 6, gov_title[:cols - 35], self.green | curses.A_BOLD if daemon_active else (curses.A_BOLD if is_gov_focus else curses.A_NORMAL))
            badge_x = max(20, cols - len(gov_badge) - 3)
            self.safe_addstr(y, badge_x, gov_badge, gov_badge_col)

            gov_hint = "Manages 03 ↔ 0f load-aware clocking  •  [Space/Enter] Toggle  •  [a] Enable Auto  •  [R] Reload"
            self.safe_addstr(y + 1, 6, gov_hint[:cols - 8], self.cyan if is_gov_focus else curses.A_DIM)

            # Live Temperature & Thermal throttle line
            th_temp = self.telemetry.get("throttle_temp", 80)
            temp_v = self.telemetry.get("temp_val")
            temp_s = self.telemetry.get("temp", "N/A")
            if temp_v is not None:
                if temp_v > 75.0:
                    t_col = self.red | curses.A_BOLD
                elif temp_v >= 65.0:
                    t_col = self.yellow | curses.A_BOLD
                else:
                    t_col = self.green | curses.A_BOLD
            else:
                t_col = curses.A_NORMAL

            self.safe_addstr(y + 2, 6, "GPU Temp: ", curses.A_BOLD)
            self.safe_addstr(y + 2, 16, f"{temp_s} ", t_col)
            th_str = f" •  Thermal Limit: [ {th_temp} °C ] (Cap: 07)  •  [t] Set  •  [- / +] Adjust"
            self.safe_addstr(y + 2, 16 + len(temp_s) + 1, th_str[:cols - (17 + len(temp_s))], self.yellow if is_gov_focus else curses.A_DIM)

            # Live Display & Floor line
            disp_clk = self.telemetry.get("disp_clk_khz")
            disp_ref = self.telemetry.get("disp_ref_hz")
            idle_floor = self.telemetry.get("idle_floor", "07")
            if disp_clk and disp_ref:
                d_str = f"Display: {disp_clk/1000:.1f} MHz ({disp_ref} Hz)  •  Idle Floor: [{idle_floor}] (Anti-Flicker Guard)"
            else:
                d_str = f"Idle Floor: [{idle_floor}] (Anti-Flicker Guard)"
            self.safe_addstr(y + 3, 6, d_str[:cols - 8], self.cyan | curses.A_BOLD if is_gov_focus else curses.A_DIM)
            y += 5

            # Divider between Governor and P-States
            self.safe_addstr(y, 4, "Performance States (Selecting coordinates lock while preserving thermal safety):", curses.A_DIM)
            y += 2

            # P-State Entries
            for i, p in enumerate(self.pstates):
                if y + 2 >= max_drawable_y:
                    break

                item_idx = i + 1
                is_focused = (item_idx == self.focus_idx)
                if lock_target:
                    is_active = (p["code"] == lock_target)
                    radio = "[●] LOCKED" if is_active else "[○] Available"
                    radio_col = self.cyan | curses.A_BOLD if is_active else self.yellow
                elif daemon_active:
                    is_active = p["active"]
                    radio = "[●] ACTIVE" if is_active else "[○] Auto"
                    radio_col = self.badge | curses.A_BOLD if is_active else self.yellow
                else:
                    is_active = p["active"]
                    radio = "[●] LOCKED" if is_active else "[○] Available"
                    radio_col = self.badge | curses.A_BOLD if is_active else self.yellow

                arrow = Style.arrow_focused if is_focused else Style.arrow
                self.safe_addstr(y, 2, f" {arrow} ", self.cyan | curses.A_BOLD if is_focused else curses.A_NORMAL)

                title_str = f"P-State [{p['code']}]: {p['desc']}"
                self.safe_addstr(y, 6, title_str[:cols - 35], self.green | curses.A_BOLD if is_active else (curses.A_BOLD if is_focused else curses.A_NORMAL))

                badge_x = max(20, cols - len(radio) - 3)
                self.safe_addstr(y, badge_x, radio, radio_col)

                y += 1
                bar_content = self.render_bar(bar_avail_width, p["core"], 590)
                self.safe_addstr(y, 6, f"{Style.bar_left_mono}{bar_content}{Style.bar_right_mono}", self.green if is_active else curses.A_NORMAL)

                y += 1
                specs = f"Core: {p['core']} MHz  |  Shader: {p['shader']} MHz  |  Memory: {p['mem']} MHz"
                self.safe_addstr(y, 6, specs[:cols - 8], self.cyan if is_focused else curses.A_DIM)

                y += 2

        # TAB 2: Active DRM / 3D Clients
        elif self.active_mode == 1:
            entries = self.clients
            if not entries:
                self.safe_addstr(lines // 2, max(2, (cols - 40) // 2), "No active DRM / 3D clients detected (Desktop Idle).", curses.A_DIM)
                self.screen.refresh()
                return

            self.focus_idx = max(0, min(self.focus_idx, len(entries) - 1))

            self.safe_addstr(y, 4, "Active GPU Processes & Display Clients:", self.cyan | curses.A_BOLD)
            y += 2

            for i, c in enumerate(entries):
                if y + 1 >= max_drawable_y:
                    break

                is_focused = (i == self.focus_idx)
                arrow = Style.arrow_focused if is_focused else Style.arrow

                self.safe_addstr(y, 2, f" {arrow} ", self.cyan | curses.A_BOLD if is_focused else curses.A_NORMAL)
                line_str = f"PID {c['pid']:<7}  •  {c['cmd']}"

                self.safe_addstr(y, 6, line_str[:cols - 10], curses.A_BOLD if is_focused else curses.A_NORMAL)
                y += 2

        # TAB 3: Telemetry & Sensors
        else:
            self.safe_addstr(y, 4, "Hardware Monitoring & GPU Sensors:", self.cyan | curses.A_BOLD)
            y += 2

            th_temp = self.telemetry.get("throttle_temp", 80)
            temp_v = self.telemetry.get("temp_val")
            th_status = "THROTTLED (Cap: 07)" if (temp_v and temp_v >= th_temp) else "Normal (Cap: 07)"

            stats_rows = [
                ("GPU Chipset", "NVIDIA GF106M (GeForce GT 555M / Fermi)"),
                ("Driver Backend", "nouveau (Mesa / Linux DRM)"),
                ("Active P-State", f"{self.active_pstate} ({PSTATE_DESCRIPTIONS.get(self.active_pstate, 'Unknown')})"),
                ("Core Temperature", self.telemetry.get("temp", "N/A")),
                ("Thermal Throttle Limit", f"{th_temp} °C ({th_status})"),
                ("Core Voltage", self.telemetry.get("volt", "N/A")),
                ("Fan Speed", self.telemetry.get("fan", "N/A")),
                ("PCIe Link Status", self.telemetry.get("pcie", "N/A")),
                ("VRAM Usage", self.telemetry.get("vram", "N/A")),
                ("Power Source", self.telemetry.get("power", "N/A")),
                ("Dynamic Daemon", "Active / Running (Auto)" if self.telemetry.get("daemon") else "Inactive / Locked (Manual)"),
                ("Kernel Interface", PSTATE_PATH),
            ]

            for label, val in stats_rows:
                if y + 1 >= max_drawable_y:
                    break
                self.safe_addstr(y, 6, f"{label:<24}: ", curses.A_BOLD)
                if label == "Core Temperature":
                    temp_v = self.telemetry.get("temp_val")
                    if temp_v is not None:
                        if temp_v > 75.0:
                            val_col = self.red | curses.A_BOLD
                        elif temp_v >= 65.0:
                            val_col = self.yellow | curses.A_BOLD
                        else:
                            val_col = self.green | curses.A_BOLD
                    else:
                        val_col = curses.A_NORMAL
                elif label == "Thermal Throttle Limit":
                    val_col = (self.red | curses.A_BOLD) if "THROTTLED" in val else self.green
                else:
                    val_col = self.green if ("Active" in val or "555M" in val or "RPM" in val or "Normal" in val) else (self.red if "THROTTLED" in val else self.yellow)
                self.safe_addstr(y, 32, val[:cols - 34], val_col)
                y += 2

        self.screen.refresh()

    def display_helpwin(self):
        doc = [
            ("j k   ↑ ↓",            "Navigate P-States or Governor"),
            ("Space / Enter",        "Lock P-State / Toggle Governor"),
            ("a",                    "Enable auto dynamic governor"),
            ("t / - / +",            "Adjust thermal throttle limit (50-95 °C)"),
            ("r",                    "Refresh telemetry & hardware status"),
            ("1  2  3",              "Jump directly to mode tab"),
            ("← / →  Tab / S-Tab",   "Switch mode tabs"),
            ("Esc / q",              "Quit"),
        ]

        h, w = self.screen.getmaxyx()
        win_h = len(doc) + 4
        win_w = 76
        start_y = max(1, (h - win_h) // 2)
        start_x = max(2, (w - win_w) // 2)

        helpwin = curses.newwin(win_h, win_w, start_y, start_x)
        helpwin.erase()
        helpwin.border(0)
        helpwin.attron(curses.A_BOLD)
        helpwin.addstr(0, 3, " Nouveau-TUI Help ")
        helpwin.attroff(curses.A_BOLD)

        for i, (keys, desc) in enumerate(doc):
            helpwin.addstr(i + 2, 3, keys.ljust(22), self.cyan | curses.A_BOLD)
            helpwin.addstr(i + 2, 26, desc)

        helpwin.refresh()

        while True:
            ch = self.screen.getch()
            if ch in (ord('q'), 27, curses.KEY_F1, ord('?'), 10, 13, ord(' '), curses.KEY_BACKSPACE, 127, 8):
                break

    def run(self):
        signal.signal(signal.SIGWINCH, lambda s, f: None)

        while True:
            self.display()
            ch = self.screen.getch()

            if ch == -1:
                self.refresh_data()
                continue

            elif ch in (ord('q'), 27):
                break

            elif ch in (curses.KEY_F1, ord('?')):
                self.display_helpwin()
                continue

            # Switch tabs: Tab, Shift+Tab, Left/Right arrows, h/l
            elif ch in (ord('\t'), curses.KEY_RIGHT, ord('l')):
                self.active_mode = (self.active_mode + 1) % len(self.MODE_NAMES)
                self.focus_idx = 0
                self.refresh_data()

            elif ch in (curses.KEY_BTAB, 353, curses.KEY_LEFT, ord('h')):
                self.active_mode = (self.active_mode - 1) % len(self.MODE_NAMES)
                self.focus_idx = 0
                self.refresh_data()

            elif ord('1') <= ch <= ord('3'):
                self.active_mode = ch - ord('1')
                self.focus_idx = 0
                self.refresh_data()

            elif ch in (curses.KEY_UP, ord('k')):
                if self.active_mode == 0:
                    total = 1 + len(self.pstates)
                    self.focus_idx = (self.focus_idx - 1) % total
                elif self.active_mode == 1:
                    if self.clients:
                        self.focus_idx = (self.focus_idx - 1) % len(self.clients)

            elif ch in (curses.KEY_DOWN, ord('j')):
                if self.active_mode == 0:
                    total = 1 + len(self.pstates)
                    self.focus_idx = (self.focus_idx + 1) % total
                elif self.active_mode == 1:
                    if self.clients:
                        self.focus_idx = (self.focus_idx + 1) % len(self.clients)

            elif ch in (ord(' '), 10, 13, curses.KEY_ENTER):
                self.execute_selection()

            elif ch == ord('a'):
                os.makedirs(SNAPSHOT_DIR, exist_ok=True)
                try:
                    with open(MODE_PATH, "w") as f:
                        f.write("auto\n")
                except PermissionError:
                    run_cmd(f"echo 'auto' | sudo tee {MODE_PATH} >/dev/null")
                daemon_active = "active" in run_cmd("systemctl is-active nouveau-dynclockd 2>/dev/null", timeout=1)
                if not daemon_active:
                    run_cmd("sudo systemctl restart nouveau-dynclockd.service")
                self.status_msg = "GPU set to dynamic governor (Auto reclocking)."
                self.status_color = 1
                self.refresh_data()

            elif ch in (ord('R'), 18):  # 'R' or Ctrl+R
                run_cmd("sudo systemctl kill -s HUP nouveau-dynclockd.service 2>/dev/null")
                self.refresh_data()
                self.status_msg = "Reloaded nouveau-dynclockd configuration (SIGHUP)."
                self.status_color = 1

            elif ch in (ord('-'), ord('[')):
                cur_th = self.telemetry.get("throttle_temp", 80)
                new_th = max(50, cur_th - 1)
                save_throttle_temp(new_th)
                self.telemetry["throttle_temp"] = new_th
                self.status_msg = f"Decreased thermal throttle limit to {new_th} °C."
                self.status_color = 1
                self.refresh_data()

            elif ch in (ord('+'), ord('='), ord(']')):
                cur_th = self.telemetry.get("throttle_temp", 80)
                new_th = min(95, cur_th + 1)
                save_throttle_temp(new_th)
                self.telemetry["throttle_temp"] = new_th
                self.status_msg = f"Increased thermal throttle limit to {new_th} °C."
                self.status_color = 1
                self.refresh_data()

            elif ch == ord('t'):
                self.prompt_throttle_temp()

            elif ch == ord('r'):
                self.refresh_data()
                self.status_msg = "Refreshed telemetry & hardware sensors."
                self.status_color = 1

    def execute_selection(self):
        if self.active_mode == 0:
            os.makedirs(SNAPSHOT_DIR, exist_ok=True)
            if self.focus_idx == 0:
                lock_target = self.telemetry.get("lock_target")
                if lock_target:
                    # Switch to Auto
                    try:
                        with open(MODE_PATH, "w") as f:
                            f.write("auto\n")
                    except PermissionError:
                        run_cmd(f"echo 'auto' | sudo tee {MODE_PATH} >/dev/null")
                    self.status_msg = "Switched governor to AUTO mode."
                else:
                    # Toggle to Lock 07
                    try:
                        with open(MODE_PATH, "w") as f:
                            f.write("locked:07\n")
                    except PermissionError:
                        run_cmd(f"echo 'locked:07' | sudo tee {MODE_PATH} >/dev/null")
                    self.status_msg = "Locked GPU to P-State [07] (Thermal protection active)."

                daemon_active = "active" in run_cmd("systemctl is-active nouveau-dynclockd 2>/dev/null", timeout=1)
                if not daemon_active:
                    run_cmd("sudo systemctl restart nouveau-dynclockd.service")
            else:
                p_idx = self.focus_idx - 1
                if 0 <= p_idx < len(self.pstates):
                    target = self.pstates[p_idx]["code"]
                    try:
                        with open(MODE_PATH, "w") as f:
                            f.write(f"locked:{target}\n")
                    except PermissionError:
                        run_cmd(f"echo 'locked:{target}' | sudo tee {MODE_PATH} >/dev/null")

                    daemon_active = "active" in run_cmd("systemctl is-active nouveau-dynclockd 2>/dev/null", timeout=1)
                    if not daemon_active:
                        run_cmd("sudo systemctl restart nouveau-dynclockd.service")

                    # Also directly write target to debugfs if accessible
                    try:
                        with open(PSTATE_PATH, "w") as f:
                            f.write(f"{target}\n")
                    except Exception:
                        pass

                    self.status_msg = f"Locked GPU to P-State [{target}] ({self.pstates[p_idx]['core']} MHz) with thermal protection."
            self.status_color = 1
            self.refresh_data()

def main():
    curses.wrapper(lambda stdscr: NouveauTUI(stdscr).run())

if __name__ == "__main__":
    main()
