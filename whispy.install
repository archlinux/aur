post_install() {
  cat <<'EOF'
==> whispy installed. Finish setup (this is required before first use):

      whispy-daemon setup

   It builds whisper.cpp (Vulkan or CPU, auto-detected), downloads the ggml
   model, grants ydotool uinput access, seeds ~/.config/whispy, and enables the
   systemd user services (plus the pill overlay when Quickshell is present).
   Then add the keybinds it prints at the end — Omarchy 4 binds go in
   ~/.config/hypr/bindings.lua. Reprint them with `whispy-daemon setup keybinds`.
EOF
}

post_upgrade() {
  # $1 = new version, $2 = old version.
  if [ "$(vercmp "$2" 0.5.0)" -lt 0 ]; then
    cat <<'EOF'
==> whispy 0.5.0: new speech engine, Parakeet

   This package now ships whispy-stt, which runs NVIDIA Parakeet (parakeet-ultra):
   ~6x faster than whisper, better punctuation, and nothing typed on silence.
   Your config keeps the whisper engine until you switch:

      1. whispy-daemon settings   -> Engine -> Parakeet -> s
         (or set  engine = "parakeet"  under [stt] in ~/.config/whispy/config.toml)
      2. whispy-daemon setup model    # downloads parakeet-ultra (~740 MB)
      3. systemctl --user restart whispy-daemon

   Parakeet covers 25 European languages; stay on whisper if you need others.
EOF
  fi
  if [ "$(vercmp "$2" 0.4.0)" -lt 0 ]; then
    cat <<'EOF'
==> whispy 0.4.0

   - Fixes garbled transcripts on PipeWire 1.6 (audio was read byte-swapped).
     Restart the daemon to pick it up:

          systemctl --user restart whispy-daemon

   - New settings screen: `whispy-daemon settings` (microphone with a level
     meter and a test dictation, language, typing, auto-stop, history).
   - Omarchy: update the bar widget (a click now opens the settings) with

          whispy-daemon setup omarchy

     and, to put it where Omarchy's dictation icon was:

          omarchy bar move whispy.dictation --after omarchy.indicators
EOF
  fi
  if [ "$(vercmp "$2" 0.3.0)" -lt 0 ]; then
    cat <<'EOF'
==> whispy 0.3.0: two things to do after this upgrade

   1. The recommended keybinds changed: SUPER+SPACE and its ALT/SHIFT/CTRL
      variants clash with Omarchy 4's menus. The defaults are now F9 (hold to
      talk), SUPER+CTRL+X (toggle) and SUPER+CTRL+SHIFT+X (cancel), printed in
      your config's syntax (Omarchy 4 bindings.lua, Hyprland Lua or hyprland.conf):

          whispy-daemon setup keybinds

   2. Re-run setup once to pick up the rest of this release (Omarchy bar
      widget, log rotation); it is idempotent and keeps your config:

          whispy-daemon setup

   Then restart the daemon: systemctl --user restart whispy-daemon
EOF
  fi
}
