FUNCAO_CORE(){

    _core_sep() { echo -e "${NEON_BLUE}\n------------------------------------------------------------${NC}"; }

    # Linha decorativa: _core_ln [largura=86] [caractere=-] [cor=NEON_BLUE].
    _core_ln() {
        local s=""
        printf -v s '%*s' "${1:-86}" ''
        echo -e "${3:-$NEON_BLUE}${s// /${2:--}}${NC}"
    }

    # Cabeçalho de etapa: $1=n | $2=pausa antes | $3/$4/$5=PT/EN/ES.
    _core_step() {
        sleep "$2"
        echo ""
        _core_sep
        echo ""
        _core_ln
        msg "${CYAN_NEON}[$1/15]: $3${NC}" "${CYAN_NEON}[$1/15]: $4${NC}" "${CYAN_NEON}[$1/15]: $5${NC}"
        _core_ln
        sleep 0.7
        echo ""
    }

    _core_skip() {
        msg "-> Pulando esta etapa." "-> Skipping this step." "-> Saltando este paso."
    }

    # Pergunta s/n: 0 = sim | 1 = não ou entrada encerrada (EOF). Inválido repete.
    _core_ask_yn() {
        local answer
        while true; do
            msg "$1" "$2" "$3"
            if ! read -r -p "> " answer; then
                echo
                return 1
            fi
            answer="${answer//[[:space:]]/}"
            answer="${answer,,}"
            if [[ "$answer" =~ ^(s|sim|y|yes|si|sí)$ ]]; then
                return 0
            elif [[ "$answer" =~ ^(n|nao|não|no)$ ]]; then
                return 1
            else
                msg "${RED_NEON}[ERRO]: Opção inválida.${NC}" "${RED_NEON}[ERROR]: Invalid option.${NC}" "${RED_NEON}[ERROR]: Opción no válida.${NC}"
            fi
        done
    }

    # 0 = ALGUM dos pacotes está instalado (1 chamada ao pacman).
    _core_any() {
        local o=""
        o=$(pacman -Qq "$@" 2>/dev/null)
        [[ -n "$o" ]]
    }

    _core_systemd() {
        [[ -d /run/systemd/system ]] && command -v systemctl &>/dev/null
    }

    _core_has_bluetooth() {
        local o=""
        compgen -G "/sys/class/bluetooth/hci*" >/dev/null && return 0
        command -v rfkill &>/dev/null || return 1
        o=$(rfkill list bluetooth 2>/dev/null)
        [[ "${o,,}" == *bluetooth* ]]
    }

    _core_is_artix() {
        local c=""
        [[ -f /etc/artix-release ]] && return 0
        [[ -r /etc/os-release ]] || return 1
        c=$'\n'$(< /etc/os-release)
        [[ "${c,,}" == *$'\n'id=artix* ]]
    }

    _core_cfg() {
        local c=""
        if [[ -r /etc/pacman.conf ]]; then c=$(< /etc/pacman.conf); fi
        c=$'\n'$c$'\n'
        [[ "$c" =~ $'\n'$1 ]]
    }

    _core_add() {
        local p=""
        for p in "$@"; do [[ " ${core_pend[*]} " == *" $p "* ]] || core_pend+=("$p"); done
    }

    # ------------------------------------------------------------------------
    # Instalação
    # ------------------------------------------------------------------------
    _core_install() {
        local pkg out=""
        local -a pkgs_ok=() pkgs_ignorados=() pkgs_falha=() pkgs_instalados=()

        if out=$(LC_ALL=C pacman -Si -- "$@" 2>&1 >/dev/null); then
            pkgs_ok=("$@")
        else
            for pkg in "$@"; do
                if [[ "$out" == *"package '$pkg' was not found"* ]]; then
                    pkgs_ignorados+=("$pkg")
                else
                    pkgs_ok+=("$pkg")
                fi
            done
            if (( ${#pkgs_ignorados[@]} == 0 )); then
                pkgs_ok=()
                for pkg in "$@"; do
                    if pacman -Si -- "$pkg" &>/dev/null; then pkgs_ok+=("$pkg"); else pkgs_ignorados+=("$pkg"); fi
                done
            fi
        fi

        if (( ${#pkgs_ignorados[@]} > 0 )); then
            _core_add "${pkgs_ignorados[@]}"
            _core_ln
            msg "${YELLOW_NEON}[AVISO]: Pacotes não encontrados nos repositórios (ignorados): ${pkgs_ignorados[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Packages not found in the repositories (skipped): ${pkgs_ignorados[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: Paquetes no encontrados en los repositorios (omitidos): ${pkgs_ignorados[*]}${NC}"
            _core_ln
        fi

        if (( ${#pkgs_ok[@]} > 0 )) && sudo pacman -S --needed --noconfirm "${pkgs_ok[@]}"; then
            pkgs_instalados=("${pkgs_ok[@]}")
        elif (( ${#pkgs_ok[@]} > 0 )); then
            _core_ln
            msg "${YELLOW_NEON}[AVISO]: A instalação em bloco falhou. Tentando um pacote por vez...${NC}" \
                "${YELLOW_NEON}[WARNING]: Bulk installation failed. Trying one package at a time...${NC}" \
                "${YELLOW_NEON}[AVISO]: La instalación en bloque falló. Intentando un paquete a la vez...${NC}"
            _core_ln
            for pkg in "${pkgs_ok[@]}"; do
                if sudo pacman -S --needed --noconfirm "$pkg"; then
                    pkgs_instalados+=("$pkg")
                else
                    pkgs_falha+=("$pkg")
                fi
            done
        fi

        if (( ${#pkgs_instalados[@]} == 0 )); then
            _core_add "$@"
            msg "${RED_NEON}[ERRO]: Falha ao instalar: $* ${NC}" "${RED_NEON}[ERROR]: Failed to install: $* ${NC}" "${RED_NEON}[ERROR]: Error al instalar: $* ${NC}"
            return 1
        fi

        if (( ${#pkgs_falha[@]} > 0 )); then
            _core_add "${pkgs_falha[@]}"
            _core_ln
            msg "${YELLOW_NEON}[AVISO]: Não foi possível instalar: ${pkgs_falha[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Could not install: ${pkgs_falha[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: No se pudo instalar: ${pkgs_falha[*]}${NC}"
            _core_ln
        fi
        msg "-> Pacotes instalados: ${pkgs_instalados[*]}" "-> Packages installed: ${pkgs_instalados[*]}" "-> Paquetes instalados: ${pkgs_instalados[*]}"
        return 0
    }

    # No OpenRC o serviço vem em um pacote <nome>-openrc (quando existe).
    _core_init_pkg() {
        _core_systemd && return 0
        command -v rc-service &>/dev/null || return 0
        pacman -Si "$1-openrc" &>/dev/null && _core_install "$1-openrc"
        return 0
    }

    _core_sudo_keepalive_start() {
        local parent_pid=$$
        if [[ -n "${CORE_SUDO_PID:-}" ]] && kill -0 "$CORE_SUDO_PID" 2>/dev/null; then return 0; fi
        (
            while kill -0 "$parent_pid" 2>/dev/null; do
                sudo -n true 2>/dev/null
                sleep 45
            done
        ) >/dev/null 2>&1 &
        CORE_SUDO_PID=$!
        disown "$CORE_SUDO_PID" 2>/dev/null
    }

    _core_sudo_keepalive_stop() {
        if [[ -n "${CORE_SUDO_PID:-}" ]]; then
            kill "$CORE_SUDO_PID" 2>/dev/null || true
            CORE_SUDO_PID=""
        fi
    }

    _core_flathub() {
        if sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo; then
            msg "-> Flathub ativado." "-> Flathub enabled." "-> Flathub activado."
        else
            msg "${RED_NEON}[ERRO]: Falha ao ativar Flathub.${NC}" "${RED_NEON}[ERROR]: Failed to enable Flathub.${NC}" "${RED_NEON}[ERROR]: Error al activar Flathub.${NC}"
        fi
    }

    _core_draw_bar() {
        local atual=$1 total=$2 largura=20 eq=0 cheio="" vazio="" pct=""
        (( total > 0 )) || total=1
        (( atual > total )) && atual=$total
        eq=$(( atual * largura / total ))
        printf -v cheio '%*s' "$eq" ''
        printf -v vazio '%*s' "$(( largura - eq ))" ''
        printf -v pct '%3d' "$(( atual * 100 / total ))"
        cheio="\e[32m${cheio// /=}${NC}"
        pct="\e[1;33m${pct}%${NC}"
        msg "\r\e[K   Executando testes… [${cheio}${vazio}] ${pct} concluídos\c" \
            "\r\e[K   Running tests… [${cheio}${vazio}] ${pct} completed\c" \
            "\r\e[K   Ejecutando pruebas… [${cheio}${vazio}] ${pct} completados\c"
    }

    #==========================
    local resp_audio mirror_target ucode_pkg root_fs vendor k v
    local efi_dir conf limine_conf user_uid linha ref_status
    local mirror_run_bak="" reflector_ok=1 atual=0 cur_off=0 ref_ativo=0
    local sinal_core="" old_int="" old_term="" traps_set=0
    local -a kernels=() core_pend=()    # core_pend = pacotes não encontrados / não instalados
    local base_pkgs=(git base-devel dkms curl wget exfatprogs htop unrar unzip tar gzip bzip2 xz lrzip 7zip ntfs-3g dosfstools lm_sensors fastfetch noto-fonts noto-fonts-emoji noto-fonts-cjk ttf-liberation ttf-dejavu dmidecode btop)
    local target_user="${SUDO_USER:-${USER:-$(id -un)}}"

    _core_fim() {
        local sinal="$sinal_core"
        if [[ -n "$sinal" ]]; then
            echo ""
            msg "${YELLOW_NEON}[AVISO] CORE interrompido. Restaurando o terminal e limpando temporários...${NC}" \
                "${YELLOW_NEON}[WARNING] CORE interrupted. Restoring the terminal and cleaning up temporary files...${NC}" \
                "${YELLOW_NEON}[AVISO] CORE interrumpido. Restaurando el terminal y limpiando archivos temporales...${NC}"
            if (( ref_ativo )) && [[ -s "$mirror_run_bak" ]]; then sudo cp -f "$mirror_run_bak" "$mirror_target" 2>/dev/null; fi
        fi
        if (( cur_off )); then tput cnorm 2>/dev/null || true; cur_off=0; fi
        if [[ -n "$mirror_run_bak" ]]; then rm -f "$mirror_run_bak"; mirror_run_bak=""; fi
        _core_sudo_keepalive_stop
        if (( traps_set )); then
            if [[ -n "$old_int" ]]; then eval "$old_int"; else trap - INT; fi
            if [[ -n "$old_term" ]]; then eval "$old_term"; else trap - TERM; fi
            traps_set=0
        fi
        unset -f _core_sep _core_ln _core_step _core_skip _core_ask_yn _core_any _core_systemd \
            _core_has_bluetooth _core_is_artix _core_cfg _core_add _core_install _core_init_pkg \
            _core_sudo_keepalive_start _core_sudo_keepalive_stop _core_flathub _core_draw_bar _core_fim
        [[ -n "$sinal" ]] || return 0
        kill -s "$sinal" $$
        [[ "$sinal" == "INT" ]] && exit 130
        exit 143
    }
    old_int=$(trap -p INT)
    old_term=$(trap -p TERM)
    trap 'sinal_core=INT; _core_fim' INT
    trap 'sinal_core=TERM; _core_fim' TERM
    traps_set=1

    echo -e "${CYAN_NEON}\n=============================================================================${NC}"
    msg "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Iniciando configurações essenciais do Project Odin...${NC}" \
        "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Starting essential configurations for Project Odin...${NC}" \
        "${CYAN_NEON}[CORE]:${NC} ${NEON_BLUE}Iniciando configuraciones esenciales del Project Odin...${NC}"
