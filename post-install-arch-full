        _dv_ln 124 =
        msg " - Já existentes             : ${dv_ja[*]:-Nenhum}" \
            " - Already present           : ${dv_ja[*]:-None}" \
            " - Ya existentes             : ${dv_ja[*]:-Ninguno}"
