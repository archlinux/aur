                "${CYAN_NEON}NVIDIA components successfully installed.${NC}" \
                "${CYAN_NEON}Componentes NVIDIA instalados con éxito.${NC}"
        fi
        _ot_ln
        echo ""
        return "$rc"
    }

    # 1. Investigação do hardware
    _ot_ln 63 =
    msg "${CYAN_NEON}Investigando o hardware do sistema...${NC}" \
        "${CYAN_NEON}Investigating system hardware...${NC}" \
        "${CYAN_NEON}Investigando el hardware del sistema...${NC}"
    _ot_ln 63 =
    sleep 1
    echo ""

    if ! command -v lspci &>/dev/null; then
        _ot_ln
        msg "Instalando pciutils para auditoria de hardware..." \
            "Installing pciutils for hardware auditing..." \
            "Instalando pciutils para auditoría de hardware..."
        _ot_ln
        sleep 0.7
        if ! sudo pacman -S --needed --noconfirm pciutils; then
            _ot_ln
            msg "${RED_NEON}Falha ao instalar pciutils. A detecção de GPU pode ser comprometida.${NC}" \
                "${RED_NEON}Failed to install pciutils. GPU detection may be compromised.${NC}" \
                "${RED_NEON}Error al instalar pciutils. La detección de GPU puede verse comprometida.${NC}"
            _ot_ln
            ot_erro=1
        fi
    fi

    # CPU
    if [[ -r /proc/cpuinfo ]]; then ot_info=$(< /proc/cpuinfo); fi
    if [[ $ot_info == *AuthenticAMD* ]]; then
        DETECTED_CPU="AMD"
    elif [[ $ot_info == *GenuineIntel* ]]; then
        DETECTED_CPU="INTEL"
    else
        DETECTED_CPU="UNKNOWN"
    fi

    # GPUs pelos Vendor IDs oficiais do PCI: [8086: = Intel, [1002: = AMD/ATI, [10de: = NVIDIA
    HAS_INTEL_GPU=0 HAS_AMD_GPU=0 HAS_NVIDIA_GPU=0
    if command -v lspci &>/dev/null; then ot_pci=$(lspci -nn 2>/dev/null || :); fi
    while IFS= read -r ot_lin; do
        [[ $ot_lin == *VGA* || $ot_lin == *3D* || $ot_lin == *Display* ]] || continue
        ot_lin=${ot_lin,,}
        [[ $ot_lin == *"[8086:"* ]] && HAS_INTEL_GPU=1
        [[ $ot_lin == *"[1002:"* ]] && HAS_AMD_GPU=1
        [[ $ot_lin == *"[10de:"* ]] && HAS_NVIDIA_GPU=1
    done <<< "$ot_pci"
    ot_info="" ot_pci=""    # libera os textos grandes (cpuinfo / lspci)

    _ot_ln
    msg "[OK] Detecção de Hardware Concluída:" \
        "[OK] Hardware Detection Completed:" \
        "[OK] Detección de Hardware Completada:"
    _ot_ln
    echo ""
    msg " -> CPU: $DETECTED_CPU" " -> CPU: $DETECTED_CPU" " -> CPU: $DETECTED_CPU"
    ((HAS_INTEL_GPU)) && msg " -> GPU Intel identificada." " -> Intel GPU identified." " -> GPU Intel identificada."
    ((HAS_AMD_GPU)) && msg " -> GPU AMD identificada." " -> AMD GPU identified." " -> GPU AMD identificada."
    ((HAS_NVIDIA_GPU)) && msg " -> GPU NVIDIA identificada." " -> NVIDIA GPU identified." " -> GPU NVIDIA identificada."
    if ((HAS_INTEL_GPU + HAS_AMD_GPU + HAS_NVIDIA_GPU == 0)); then
        _ot_ln
        msg "${YELLOW_NEON}Aviso: Nenhuma GPU reconhecida foi detectada automaticamente.${NC}" \
            "${YELLOW_NEON}Warning: No recognized GPU was automatically detected.${NC}" \
            "${YELLOW_NEON}Advertencia: No se detectó automáticamente ninguna GPU reconocida.${NC}"
        _ot_ln
    fi
    echo ""

    # 2. GPUs integradas / pilha aberta   3. GPU dedicada NVIDIA
    if ((HAS_AMD_GPU)); then _ot_mesa AMD || ot_erro=1; fi
    if ((HAS_INTEL_GPU)); then _ot_mesa INTEL || ot_erro=1; fi
    if ((HAS_NVIDIA_GPU)); then _ot_nv || ot_erro=1; fi

    # Lista final: pacotes não encontrados nos repositórios ou que não puderam ser instalados
    if [[ ${#ot_pend[@]} -gt 0 ]]; then
        echo ""
        _ot_ln 86 - "$CYAN_NEON"
        msg "${CYAN_NEON}Pacotes não encontrados ou que não puderam ser instalados:${NC}" \
            "${CYAN_NEON}Packages not found or that could not be installed:${NC}" \
            "${CYAN_NEON}Paquetes no encontrados o que no pudieron instalarse:${NC}"
        for ot_p in "${ot_pend[@]}"; do
            ot_lin="${CYAN_NEON} -> $ot_p${NC}"
            msg "$ot_lin" "$ot_lin" "$ot_lin"
        done
        _ot_ln 86 - "$CYAN_NEON"
        sleep 1.5
    fi

    # 4. Auditoria
    sleep 0.5
    _ot_ln
    msg "${YELLOW_NEON}[AUDITORIA]:${NC} Validando otimizações de hardware aplicadas..." \
        "${YELLOW_NEON}[AUDITORIA]:${NC} Validating applied hardware optimizations..." \
        "${YELLOW_NEON}[AUDITORIA]:${NC} Validando optimizaciones de hardware aplicadas..."
    _ot_ln
    if ((ot_erro == 0)); then
        msg "Otimização de hardware do Project Odin concluída com sucesso!" \
            "Project Odin hardware optimization successfully completed!" \
            "¡Optimización de hardware de Project Odin completada con éxito!"
    else
        msg "A otimização foi concluída, mas ocorreram avisos ou falhas em etapas anteriores." \
            "Optimization completed, but warnings or errors occurred in previous steps." \
            "La optimización se completó, pero ocurrieron advertencias o fallas en pasos anteriores."
    fi
    echo ""

    unset -f _ot_ln _ot_ml _ot_add _ot_ins _ot_mesa _ot_nv
    return "$ot_erro"
}

