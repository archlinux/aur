    _hk_descobrir_grupos() {
        local out="" rc=0 a=""
        local -A vistos=()
        grupos_disp=()
        out=$(LC_ALL=C pacman -Sg 2>&1)
        rc=$?
        if (( rc != 0 )); then
            _hk_e "A consulta de grupos falhou (pacman -Sg, código $rc). Isto é diferente de 'não há grupos'." \
                  "The group query failed (pacman -Sg, code $rc). This is different from 'there are no groups'." \
                  "La consulta de grupos falló (pacman -Sg, código $rc). Esto es distinto de 'no hay grupos'."
            _hk_add CONSULTA_FALHOU "grupos"
            return 2
        fi
        while read -r a _; do
            if [[ "$a" =~ ^blackarch-[a-z0-9-]+$ && "$a" != "blackarch-officials" && -z "${vistos[$a]:-}" ]]; then
                vistos[$a]=1
                grupos_disp+=("$a")
            fi
        done <<< "$out"
        if (( ${#grupos_disp[@]} > 1 )); then
            mapfile -t grupos_disp < <(printf '%s\n' "${grupos_disp[@]}" | LC_ALL=C sort)
        fi
        if (( ${#grupos_disp[@]} == 0 )); then
            _hk_w "Nenhum grupo blackarch-* encontrado nos bancos sincronizados (repositório ausente ou bancos desatualizados)." \
                  "No blackarch-* group was found in the synchronized databases (repository missing or databases outdated)." \
                  "No se encontró ningún grupo blackarch-* en las bases sincronizadas (repositorio ausente o bases desactualizadas)."
            return 1
        fi
        return 0
    }

    
    _hk_mostrar_grupo() {
        local grp="$1" rc=0 i=0 lim=20
        _hk_membros "$grp"
        rc=$?
        if (( rc == 0 )); then
                msg "${CYAN_NEON}Grupo ${grp}: ${#membros[@]} pacote(s) únicos${NC}" \
                    "${CYAN_NEON}Group ${grp}: ${#membros[@]} unique package(s)${NC}" \
                    "${CYAN_NEON}Grupo ${grp}: ${#membros[@]} paquete(s) únicos${NC}"
                for (( i = 0; i < ${#membros[@]} && i < lim; i++ )); do
                    echo "   - ${membros[i]}"
                done
                if (( ${#membros[@]} > lim )); then
                    msg "   ... e mais $(( ${#membros[@]} - lim ))" "   ... and $(( ${#membros[@]} - lim )) more" "   ... y $(( ${#membros[@]} - lim )) más"
                fi
        elif (( rc == 1 )); then
                _hk_e "O grupo '$grp' não existe nos bancos sincronizados." \
                      "The group '$grp' does not exist in the synchronized databases." \
                      "El grupo '$grp' no existe en las bases sincronizadas."
        else
                _hk_w "Não foi possível consultar a composição do grupo '$grp' (falha de consulta)." \
                      "Could not query the composition of group '$grp' (query failure)." \
                      "No se pudo consultar la composición del grupo '$grp' (fallo de consulta)."
                _hk_add CONSULTA_FALHOU "$grp"
        fi
        return "$rc"
    }

    
    _hk_verificar_grupo() {
        local m=""
        FALTAM=0
        (( ${#membros[@]} > 0 )) || _hk_membros "$1" || return 2
        _hk_carregar_inst || return 2
        for m in "${membros[@]}"; do
            [[ -n "${INST[$m]:-}" ]] || FALTAM=$((FALTAM + 1))
        done
        return 0
    }

    _hk_instalar_grupo() {
        local grp="$1" nec=0 rc=0
        _hk_mostrar_grupo "$grp"
        rc=$?
        if (( rc == 1 )); then
            _hk_add INDISPONIVEIS "$grp"
            return 1
        fi
        if (( rc == 0 )); then
            if _hk_estimar_mb "${membros[@]}"; then
                nec=$(( EST_MB * 14 / 10 + 1024 ))
                _hk_msg_est "$EST_MB"
            else
                nec=10240
                _hk_n "Estimativa de tamanho indisponível; reserva conservadora de ${nec} MiB." \
                      "Size estimate unavailable; conservative reserve of ${nec} MiB." \
                      "Estimación de tamaño no disponible; reserva conservadora de ${nec} MiB."
            fi
        else
            nec=10240
            if ! _hk_sn "Sem a composição do grupo não há como prever o impacto. Continuar mesmo assim?" \
                        "Without the group composition the impact cannot be predicted. Continue anyway?" \
                        "Sin la composición del grupo no se puede prever el impacto. ¿Continuar de todos modos?"; then
                return 1
            fi
        fi
        _hk_checar_espaco "$nec" || { _hk_reg "grupo $grp" "sem espaço"; return 1; }

        if [[ "$avancados" == *" $grp "* ]]; then
            _hk_w "O grupo '$grp' contém ferramentas de ALTO RISCO OPERACIONAL (uso avançado, somente em ambiente autorizado)." \
                  "Group '$grp' contains HIGH OPERATIONAL RISK tools (advanced use, authorized environments only)." \
                  "El grupo '$grp' contiene herramientas de ALTO RIESGO OPERATIVO (uso avanzado, solo en entornos autorizados)."
            if ! _hk_sn "Confirma que deseja instalar esta categoria avançada?" \
                        "Do you confirm installing this advanced category?" \
                        "¿Confirma que desea instalar esta categoría avanzada?"; then
                _hk_reg "grupo $grp" "avançado recusado"
                return 1
            fi
        fi
        if ! _hk_sn "Instalar a categoria COMPLETA '$grp'? (o pacman mostrará as dependências e pedirá confirmação)" \
                    "Install the COMPLETE category '$grp'? (pacman will show dependencies and ask for confirmation)" \
                    "¿Instalar la categoría COMPLETA '$grp'? (pacman mostrará las dependencias y pedirá confirmación)"; then
            _hk_recusada
            _hk_reg "grupo $grp" "recusado"
            return 1
        fi
        "${SUDO[@]}" pacman -S --needed -- "$grp"
        rc=$?
        if (( rc == 0 )); then
            if _hk_verificar_grupo "$grp"; then
                if (( FALTAM == 0 )); then
                    _hk_ok "Categoria '$grp' instalada e verificada." \
                           "Category '$grp' installed and verified." \
                           "Categoría '$grp' instalada y verificada."
                    _hk_add INSTALADOS "$grp"
                    _hk_reg "grupo $grp" "OK"
                    return 0
                fi
               
                _hk_w "Categoria '$grp' instalada PARCIALMENTE: $FALTAM pacote(s) do grupo não estão instalados (esperado se você escolheu só alguns no menu do pacman)." \
                      "Category '$grp' installed PARTIALLY: $FALTAM group package(s) are not installed (expected if you picked only some in the pacman menu)." \
                      "Categoría '$grp' instalada PARCIALMENTE: $FALTAM paquete(s) del grupo no están instalados (esperado si eligió solo algunos en el menú de pacman)."
                _hk_add INSTALADOS "$grp(parcial)"
                _hk_reg "grupo $grp" "parcial ($FALTAM pendentes)"
                return 0
            fi
            _hk_w "O pacman terminou sem erro, mas não foi possível verificar a composição de '$grp'." \
                  "pacman finished without error, but the composition of '$grp' could not be verified." \
                  "pacman terminó sin error, pero no se pudo verificar la composición de '$grp'."
            _hk_add VALIDACAO_FALHOU "$grp"
            _hk_reg "grupo $grp" "não verificado"
            return 0
        fi
        _hk_e "A categoria '$grp' NÃO foi concluída (código $rc)." \
              "Category '$grp' was NOT completed (code $rc)." \
              "La categoría '$grp' NO se completó (código $rc)."
        _hk_add FALHARAM "$grp"
        _hk_reg "grupo $grp" "FALHOU rc=$rc"
        return 1
    }

   
    _hk_categorias() {
        local i=0 grp="" tok="" marca="" hk_sel="" pag=0 ini=0 fim=0 tam=20
        local -a toks=() validos=()
        _hk_pre || return 1
        _hk_exige_repo || return 1
        _hk_descobrir_grupos || return 1
        while true; do
            ini=$((pag * tam))
            fim=$((ini + tam))
            (( fim > ${#grupos_disp[@]} )) && fim=${#grupos_disp[@]}
            _hk_i "== Categorias oficiais do BlackArch (descobertas agora) — ${#grupos_disp[@]} grupos ==" \
                  "== Official BlackArch categories (discovered now) — ${#grupos_disp[@]} groups ==" \
                  "== Categorías oficiales de BlackArch (descubiertas ahora) — ${#grupos_disp[@]} grupos =="
            for (( i = ini; i < fim; i++ )); do
                grp="${grupos_disp[i]}"
                marca=""
                [[ "$avancados" == *" $grp "* ]] && marca=" ${RED_NEON}[AVANÇADA]${NC}"
                msg "${GREEN_NEON}[$((i + 1))]${NC} - $grp$marca" \
                    "${GREEN_NEON}[$((i + 1))]${NC} - $grp${marca/AVANÇADA/ADVANCED}" \
                    "${GREEN_NEON}[$((i + 1))]${NC} - $grp${marca/AVANÇADA/AVANZADA}"
            done
            (( fim < ${#grupos_disp[@]} )) && msg "${YELLOW_NEON}[n]${NC} - Próxima página" "${YELLOW_NEON}[n]${NC} - Next page" "${YELLOW_NEON}[n]${NC} - Página siguiente"
            (( ini > 0 )) && msg "${YELLOW_NEON}[p]${NC} - Página anterior" "${YELLOW_NEON}[p]${NC} - Previous page" "${YELLOW_NEON}[p]${NC} - Página anterior"
            msg "${RED_NEON}[0]${NC} - Voltar" "${RED_NEON}[0]${NC} - Back" "${RED_NEON}[0]${NC} - Volver"
            msg "${CYAN_NEON}Digite um ou mais números separados por espaço (repetições são ignoradas):${NC}" \
                "${CYAN_NEON}Type one or more numbers separated by spaces (duplicates are ignored):${NC}" \
                "${CYAN_NEON}Escriba uno o más números separados por espacios (se ignoran duplicados):${NC}"
            _hk_ler hk_sel || return 1
            _hk_trim "${hk_sel,,}"
            hk_sel="$TRIM"
            if [[ "$hk_sel" =~ ^(0|voltar|back|volver)$ ]]; then
                return 0
            elif [[ "$hk_sel" =~ ^(n|next|proxima|próxima|siguiente)$ ]]; then
                if (( fim < ${#grupos_disp[@]} )); then pag=$((pag + 1)); else
                    _hk_w "Não há próxima página." "There is no next page." "No hay página siguiente."
                fi
                continue
            elif [[ "$hk_sel" =~ ^(p|prev|anterior)$ ]]; then
                if (( pag > 0 )); then pag=$((pag - 1)); else
                    _hk_w "Você já está na primeira página." "You are already on the first page." "Ya está en la primera página."
                fi
                continue
            fi
            read -r -a toks <<< "$hk_sel"
            validos=()
            for tok in "${toks[@]}"; do
                if [[ "$tok" =~ ^[0-9]+$ ]] && (( tok >= 1 && tok <= ${#grupos_disp[@]} )); then
                    [[ " ${validos[*]} " == *" ${grupos_disp[tok-1]} "* ]] || validos+=("${grupos_disp[tok-1]}")
                else
                    _hk_safe "$tok"
                    _hk_w "Entrada ignorada: '$SAFE'" \
                          "Ignored entry: '$SAFE'" \
                          "Entrada ignorada: '$SAFE'"
                fi
            done
            if (( ${#validos[@]} == 0 )); then
                _hk_e "Nenhuma opção válida. Tente novamente." \
                      "No valid option. Try again." \
                      "Ninguna opción válida. Inténtelo de nuevo."
                sleep 1
                continue
            fi
            break
        done
       
        for grp in "${validos[@]}"; do
            echo ""
            _hk_instalar_grupo "$grp"
            (( abortar )) && return 1
        done
        return 0
    }

    
