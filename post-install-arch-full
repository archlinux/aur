GAME_MODE() {
    local gm_opc=0 gm_crit=0 gm_tmp="" gm_sig="" gm_oi="" gm_ot="" gm_ts=0 gm_rc=0
    local -a gm_inst=() gm_fail=()

    # Linha decorativa: _gm_ln [largura=86] [caractere=-]
    _gm_ln() { local s=""; printf -v s '%*s' "${1:-86}" ''; echo -e "${NEON_BLUE}${s// /${2:--}}${NC}"; }

    # Mensagem entre duas linhas: _gm_box <larg_topo> <larg_base> <pt> <en> <es>
    _gm_box() { _gm_ln "$1"; msg "$3" "$4" "$5"; _gm_ln "$2"; }

    # Lê a opção em <variável> (sem espaços, minúscula)
    _gm_ask() {
        local -n _r="$1"
        read -rp "$2" _r || return 1
        _r="${_r//[[:space:]]/}"; _r="${_r,,}"
        return 0
    }

    # O repositório [multilib] está ativo em /etc/pacman.conf?
    _gm_ml() { [[ $'\n'$(< /etc/pacman.conf) == *$'\n[multilib]'* ]]; }

    _gm_pac() {
        local p="" o="" q="" miss=$'\n' inst=$'\n'
        local -a ign=() pend=() ja=() cand=()
        gm_fail=()
        if ! o=$(LC_ALL=C pacman -Si -- "$@" 2>&1 >/dev/null); then
            for p in "$@"; do
                if [[ $o == *"package '$p' was not found"* ]]; then miss+="$p"$'\n'; fi
            done
            if [[ $miss == $'\n' ]]; then
                for p in "$@"; do pacman -Si -- "$p" &>/dev/null || miss+="$p"$'\n'; done
            fi
        fi
        for p in "$@"; do
            [[ $miss == *$'\n'"$p"$'\n'* ]] || cand+=("$p")
        done
        if ((${#cand[@]})); then
            q=$(pacman -Qq -- "${cand[@]}" 2>/dev/null) || :
            inst+="$q"$'\n'
        fi
        for p in "$@"; do
            if [[ $miss == *$'\n'"$p"$'\n'* ]]; then ign+=("$p")
            elif [[ $inst == *$'\n'"$p"$'\n'* ]]; then ja+=("$p")
            else pend+=("$p"); fi
        done

        if ((${#ign[@]})); then
            ((gm_opc += ${#ign[@]}))
            msg "${YELLOW_NEON}[AVISO] Pacotes não encontrados nos repositórios (ignorados): ${ign[*]}${NC}" \
                "${YELLOW_NEON}[WARNING] Packages not found in the repositories (skipped): ${ign[*]}${NC}" \
                "${YELLOW_NEON}[AVISO] Paquetes no encontrados en los repositorios (omitidos): ${ign[*]}${NC}"
            gm_fail+=("${ign[@]}")
        fi
        if ((${#ja[@]})); then gm_inst+=("${ja[@]}"); fi

        ((${#pend[@]})) || return 0
        sudo pacman -S --needed --noconfirm "${pend[@]}" && return 0

        _gm_box 86 86 "${YELLOW_NEON}[AVISO] A instalação em bloco falhou. Tentando os pacotes um a um...${NC}" \
            "${YELLOW_NEON}[WARNING] Bulk installation failed. Trying the packages one by one...${NC}" \
            "${YELLOW_NEON}[AVISO] La instalación en bloque falló. Probando los paquetes uno a uno...${NC}"
        for p in "${pend[@]}"; do
            if ! sudo pacman -S --needed --noconfirm "$p"; then
                gm_fail+=("$p")
                ((++gm_opc))
            fi
        done
        ((${#gm_fail[@]} == 0))
    }

    # Fim da função (normal ou por Ctrl+C/TERM): limpa o temporário, restaura os traps e remove os ajudantes
    _gm_fim() {
        local s="$gm_sig"
        if [[ -n $s ]]; then
            echo ""
            msg "${YELLOW_NEON}[AVISO] Modo Game interrompido. Limpando arquivos temporários...${NC}" \
                "${YELLOW_NEON}[WARNING] Game Mode interrupted. Cleaning up temporary files...${NC}" \
                "${YELLOW_NEON}[AVISO] Modo juego interrumpido. Limpiando archivos temporales...${NC}"
        fi
        if [[ -n $gm_tmp ]]; then rm -rf -- "$gm_tmp"; gm_tmp=""; fi
        if ((gm_ts)); then
            eval "${gm_oi:-trap - INT}"; eval "${gm_ot:-trap - TERM}"
            gm_ts=0
        fi
        unset -f _gm_ln _gm_box _gm_ask _gm_ml _gm_pac _gm_main _gm_fim
        [[ -n $s ]] || return 0
        kill -s "$s" $$
        [[ $s == INT ]] && exit 130
        exit 143
    }

    _gm_main() {
        local gm_wine="wine-staging" gm_helper="" gm_op="" gm_pk="" gm_app="" gm_vp="" gm_pci="" gm_l="" gm_q="" gm_fr=""
        local gm_hp=0 gm_fp=0 gm_y=0 gm_p=0 gm_v64=0 gm_v32=0 gm_de=""
        local gm_amd="${HAS_AMD_GPU:-0}" gm_intel="${HAS_INTEL_GPU:-0}" gm_nv="${HAS_NVIDIA_GPU:-0}"
        local -a gm_virt=() gm_pkgs=() gm_aur=() gm_aurok=() gm_flat=()

        _gm_ln 124 =
        _gm_box 86 86 "${CYAN_NEON}[MODO GAME]${NC} Iniciando protocolo de preparação para jogos..." \
            "${CYAN_NEON}[GAME MODE]${NC} Starting gaming preparation protocol..." \
            "${CYAN_NEON}[MODO JUEGO]${NC} Iniciando protocolo de preparación para juegos..."
        _gm_ln 124 =
        sleep 1
        echo ""

        # ── 1. Validação do multilib ───────────────────────────────────────────────────────
        _gm_box 86 86 "${CYAN_NEON}Verificando repositório multilib...${NC}" \
            "${CYAN_NEON}Checking multilib repository...${NC}" \
            "${CYAN_NEON}Verificando repositorio multilib...${NC}"
        sleep 1
        echo ""

        [[ -f /etc/pacman.conf.bak-game ]] || sudo cp /etc/pacman.conf /etc/pacman.conf.bak-game

        if _gm_ml 2>/dev/null; then
            msg "${CYAN_NEON}[OK] Repositório multilib já está ativo.${NC}" \
                "${CYAN_NEON}[OK] Multilib repository is already enabled.${NC}" \
                "${CYAN_NEON}[OK] Repositorio multilib ya está activo.${NC}"
        else
            sudo sed -i '/^#\[multilib\]/{N;s/#//g}' /etc/pacman.conf
            sudo sed -i '/^\[multilib\]/{n;s/^#//}' /etc/pacman.conf 2>/dev/null || true
            if _gm_ml 2>/dev/null; then
                msg "${CYAN_NEON}Repositório multilib ativado com sucesso.${NC}" \
                    "${CYAN_NEON}Multilib repository enabled successfully.${NC}" \
                    "${CYAN_NEON}Repositorio multilib activado con éxito.${NC}"
            else
                # Sem multilib não existe Steam nem lib32-*: não há como seguir
                msg "${RED_NEON}[ERRO] Não foi possível ativar o multilib em /etc/pacman.conf. O modo Game precisa dele (Steam e bibliotecas 32 bits).${NC}" \
