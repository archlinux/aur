                msg_title="⚠️ Espaço insuficiente para continuar a atualização."
                msg_desc1="O seu sistema tem apenas ${FREE_SPACE}GB de espaço livre."
                msg_desc2="O programa de atualização exige no mínimo 15 GB livres para funcionar com segurança."
                msg_desc3="Não foi possível concluir a atualização por falta de espaço."
                msg_desc4="Por favor, libere espaço para continuar com a atualização (15 GB é a margem de segurança)."
                msg_abort="ABORTANDO O PROTOCOLO DE ATUALIZAÇÃO."
                ;;
            "ES_ES")
                msg_title="⚠️ Espacio insuficiente para continuar la actualización."
                msg_desc1="Su sistema tiene sólo ${FREE_SPACE}GB de espacio libre."
                msg_desc2="El programa de actualización requiere un mínimo de 15 GB libres para funcionar de forma segura."
                msg_desc3="No se pudo completar la actualización por falta de espacio."
                msg_desc4="Por favor, libere espacio para continuar con la actualización (15 GB es el margen de seguridad)."
                msg_abort="ABORTANDO EL PROTOCOLO DE ACTUALIZACIÓN."
                ;;
            *)
                msg_title="⚠️ Insufficient space to continue the update."
                msg_desc1="Your system has only ${FREE_SPACE}GB of free space."
                msg_desc2="The update program requires a minimum of 15 GB free to work safely."
                msg_desc3="Could not complete the update due to lack of space."
                msg_desc4="Please free up space to continue with the update (15 GB is the safety margin)."
                msg_abort="ABORTING THE UPDATE PROTOCOL."
                ;;
        esac

        BOX_ERROR "$msg_title" "$msg_desc1" "$msg_desc2"
        
        echo ""
        msg "${YELLOW_NEON}${msg_desc3}\n${msg_desc4}${NC}" \
            "${YELLOW_NEON}${msg_desc3}\n${msg_desc4}${NC}" \
            "${YELLOW_NEON}${msg_desc3}\n${msg_desc4}${NC}"
        echo ""
        msg "${RED_NEON}${msg_abort}${NC}" \
            "${RED_NEON}${msg_abort}${NC}" \
            "${RED_NEON}${msg_abort}${NC}"
        echo ""

        if [[ -n "${LOG_ATUAL:-}" ]]; then
            echo "[LOG] Aborting due to insufficient space (${FREE_SPACE}GB) on $(date)" >> "$LOG_ATUAL"    
        fi
        
        echo -e "${YELLOW_NEON}--------------------------------------------------------------------------------------${NC}"
        exit 1
    else
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${GREEN_NEON}[OK] Reserva de disco confirmada: ${FREE_SPACE}GB disponíveis na raiz.${NC}" \
            "${GREEN_NEON}[OK] Disk reserve confirmed: ${FREE_SPACE}GB available on root.${NC}" \
