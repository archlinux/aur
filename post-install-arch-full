FUNCAO_OTIMIZACAO() {
    msg "=== PROJECT ODIN · OTIMIZAÇÃO DE HARDWARE E DRIVERS ===" \
        "=== PROJECT ODIN · HARDWARE & DRIVER OPTIMIZATION ===" \
        "=== PROJECT ODIN · OPTIMIZACIÓN DE HARDWARE Y CONTROLADORES ==="
    echo ""

    local ot_erro=0 ot_info="" ot_pci="" ot_lin="" ot_p=""
    local -a ot_pend=()    # pacotes não encontrados / não instalados (lista final)

    # Linha decorativa: _ot_ln [largura=86] [caractere=-] [cor=NEON_BLUE]
    _ot_ln() { local s=""; printf -v s '%*s' "${1:-86}" ''; echo -e "${3:-$NEON_BLUE}${s// /${2:--}}${NC}"; }

    # Retorna 0 se o repositório [multilib] está habilitado no pacman.conf
    _ot_ml() { local c=""; if [[ -r /etc/pacman.conf ]]; then c=$(< /etc/pacman.conf); fi; [[ $'\n'$c == *$'\n[multilib]'* ]]; }

    # Registra pacotes na lista final (sem repetir)
    _ot_add() { local p=""; for p in "$@"; do [[ " ${ot_pend[*]} " == *" $p "* ]] || ot_pend+=("$p"); done; }

    # Instala pacotes: _ot_ins <qtd_essenciais> <pacotes...> (os essenciais vêm primeiro)
    _ot_ins() {
        local n="$1" p="" i=0
        local -a ot_ok=() ot_ign=() ot_falta=() ot_opc=()
        shift

        # Caminho rápido: um único pacman -Si; só confere um a um se algum não existir
        if pacman -Si "$@" &>/dev/null; then
            ot_ok=("$@")
        else
            for p in "$@"; do
                i=$((i + 1))
                if pacman -Si "$p" &>/dev/null; then
                    ot_ok+=("$p")
                else
                    ot_ign+=("$p")
                    if [[ $i -le $n ]]; then ot_falta+=("$p"); fi
                fi
            done
        fi

        if [[ ${#ot_ign[@]} -gt 0 ]]; then
            _ot_add "${ot_ign[@]}"
            _ot_ln
            msg "${YELLOW_NEON}[AVISO]: Pacotes não encontrados nos repositórios (ignorados): ${ot_ign[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Packages not found in the repositories (skipped): ${ot_ign[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: Paquetes no encontrados en los repositorios (omitidos): ${ot_ign[*]}${NC}"
            _ot_ln
        fi

        # Essencial ausente: cancela tudo para não deixar uma configuração pela metade
        if [[ ${#ot_falta[@]} -gt 0 || ${#ot_ok[@]} -eq 0 ]]; then
            _ot_add "$@"
            _ot_ln 142
            msg "${RED_NEON}[ERRO]: Pacote essencial não encontrado: ${ot_falta[*]:-$*}. Instalação cancelada para evitar uma configuração incompleta.${NC}" \
                "${RED_NEON}[ERROR]: Essential package not found: ${ot_falta[*]:-$*}. Installation cancelled to avoid an incomplete setup.${NC}" \
                "${RED_NEON}[ERROR]: Paquete esencial no encontrado: ${ot_falta[*]:-$*}. Instalación cancelada para evitar una configuración incompleta.${NC}"
            _ot_ln 142
            return 1
        fi

        sudo pacman -S --needed --noconfirm "${ot_ok[@]}" && return 0

        # Falhou em bloco (conflito, download...): essenciais juntos (atômico) e depois cada opcional sozinho
        _ot_ln 113
        msg "${YELLOW_NEON}[AVISO]: A instalação em bloco falhou. Instalando os essenciais e depois os opcionais um a um...${NC}" \
            "${YELLOW_NEON}[WARNING]: Bulk installation failed. Installing the essentials first, then the optional ones one by one...${NC}" \
            "${YELLOW_NEON}[AVISO]: La instalación en bloque falló. Instalando los esenciales y luego los opcionales uno a uno...${NC}"
        _ot_ln 114
        if ! sudo pacman -S --needed --noconfirm "${ot_ok[@]:0:n}"; then _ot_add "${ot_ok[@]}"; return 1; fi
        for p in "${ot_ok[@]:n}"; do
            sudo pacman -S --needed --noconfirm "$p" || ot_opc+=("$p")
        done
        if [[ ${#ot_opc[@]} -gt 0 ]]; then
            _ot_add "${ot_opc[@]}"
            _ot_ln
            msg "${YELLOW_NEON}[AVISO]: Não foi possível instalar (opcionais): ${ot_opc[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Could not install (optional): ${ot_opc[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: No se pudo instalar (opcionales): ${ot_opc[*]}${NC}"
            _ot_ln
        fi
        return 0
    }

    # GPUs AMD / Intel (Mesa / Vulkan): _ot_mesa <AMD|INTEL>
    _ot_mesa() {
        sleep 0.5
        local v="$1"
        local -a ot_pk=(mesa) ot_l32=(lib32-mesa)
        echo ""
        _ot_ln
        msg "${CYAN_NEON}[GPU - $v] Configurando pilha gráfica aberta (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $v] Configuring open graphics stack (Mesa/Vulkan)...${NC}" \
            "${CYAN_NEON}[GPU - $v] Configurando pila gráfica abierta (Mesa/Vulkan)...${NC}"
        _ot_ln
        # libva-mesa-driver não é mais pacote próprio: o 'mesa' já o fornece (provides)
        if [[ $v == AMD ]]; then
            ot_pk+=(vulkan-radeon); ot_l32+=(lib32-vulkan-radeon)
        elif [[ $v == INTEL ]]; then
            ot_pk+=(vulkan-intel intel-media-driver); ot_l32+=(lib32-vulkan-intel)
        fi
        if _ot_ml; then ot_pk+=("${ot_l32[@]}"); fi
        echo ""
        _ot_ln
        msg "${CYAN_NEON}Instalando/Verificando pacotes gráficos para $v: ${ot_pk[*]}${NC}" \
            "${CYAN_NEON}Installing/Checking graphics packages for $v: ${ot_pk[*]}${NC}" \
