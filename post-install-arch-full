            echo ""
            if ((cust)); then
                msg "2) Driver Kernel Aberto com DKMS (nvidia-open-dkms)" \
                    "2) Open Kernel Modules Driver with DKMS (nvidia-open-dkms)" \
                    "2) Controlador de Módulos de Kernel Abierto con DKMS (nvidia-open-dkms)"
            else
                msg "2) Driver Kernel Aberto / Open-source (nvidia-open)" \
                    "2) Open Kernel Modules Driver (nvidia-open)" \
                    "2) Controlador de Módulos de Kernel Abierto (nvidia-open)"
            fi
            echo ""
            msg "0) Pular otimização NVIDIA" \
                "0) Skip NVIDIA optimization" \
                "0) Omitir optimización NVIDIA"
            read -rp "Escolha / Choice / Opción: 1-2-0 " op || return 1
            _ot_ln
            if [[ $op == 0 ]]; then
                msg "${CYAN_NEON}Otimização NVIDIA ignorada.${NC}" \
                    "${CYAN_NEON}NVIDIA optimization skipped.${NC}" \
                    "${CYAN_NEON}Optimización NVIDIA omitida.${NC}"
                echo ""
                return 0
            elif [[ $op == 1 || $op == 2 ]]; then
                break
            else
                msg "${YELLOW_NEON}Comando inválido! Tente novamente.${NC}" \
                    "${YELLOW_NEON}Invalid command! Try again.${NC}" \
                    "${YELLOW_NEON}¡Comando inválido! Inténtelo de nuevo.${NC}"
                echo ""
            fi
        done

        # 1 = nvidia | 2 = nvidia-open (ambos com sufixo -dkms em kernel zen/lts)
        if [[ $op == 1 ]]; then b=nvidia; else b=nvidia-open; fi
        if ((cust)); then b+=-dkms; fi
        ot_pk=("$b" nvidia-utils)
        if _ot_ml; then ot_pk+=(lib32-nvidia-utils); fi
        if ((cust)); then
            for k in linux linux-lts linux-zen linux-hardened; do
                if [[ $inst == *" $k "* ]]; then ot_pk+=("$k-headers"); fi
            done
        fi

        if ((${HAS_INTEL_GPU:-0} == 1 || ${HAS_AMD_GPU:-0} == 1)); then
            ot_pk+=(nvidia-prime)
            _ot_ln 126
            msg "${CYAN_NEON}Gráfica híbrida detectada (iGPU + NVIDIA). Adicionando nvidia-prime: use 'prime-run <programa>' para rodar na NVIDIA.${NC}" \
                "${CYAN_NEON}Hybrid graphics detected (iGPU + NVIDIA). Adding nvidia-prime: use 'prime-run <program>' to run on NVIDIA.${NC}" \
                "${CYAN_NEON}Gráficos híbridos detectados (iGPU + NVIDIA). Añadiendo nvidia-prime: use 'prime-run <programa>' para ejecutar en NVIDIA.${NC}"
            _ot_ln 126
            echo ""
        fi
        _ot_ln
        msg "Instalando componentes NVIDIA: ${ot_pk[*]}..." \
            "Installing NVIDIA components: ${ot_pk[*]}..." \
