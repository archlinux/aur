#!/bin/bash

SHELL=${SHELL:-/bin/bash}

COLUMNS=$(tput cols)
LARGURA_BOX=64
#===============================================================
# DEFINIÇÃO DE CORES ANSI PARA O TERMINAL
#===============================================================
NC="\033[0m"
CYAN_NEON="\033[1;36m"
GREEN_NEON="\033[1;32m"
YELLOW_NEON="\033[1;33m"
NEON_BLUE="\033[1;34m"
WHITE_NEON='\033[1;97m'
PINK_NEON="\e[38;2;255;105;180m"
RED_NEON="\e[38;2;255;50;50m"

#===============================================================
#inicial log // start log
#===============================================================
DOC_DIR="$(xdg-user-dir DOCUMENTS 2>/dev/null)"

if [[ -z "$DOC_DIR" || ! -d "$DOC_DIR" ]]; then
    # "Documentos" atende tanto PT-BR quanto ES-ES (Espanha / América Latina)
    if [[ -d "$HOME/Documentos" ]]; then
        DOC_DIR="$HOME/Documentos"
    else
        DOC_DIR="$HOME/Documents"
    fi
fi

LOG_DIR="$DOC_DIR/Odin_Logs"
mkdir -p "$LOG_DIR"

TIMESTAMP="$(date +'%Y-%m-%d_%H-%M-%S')"
LOG_TXT="$LOG_DIR/odin_execucao_$TIMESTAMP.txt"
LOG_PDF="$LOG_DIR/odin_execucao_$TIMESTAMP.pdf"

# Redirecionamento em tempo real para tela e para o arquivo TXT
exec > >(tee -a "$LOG_TXT") 2>&1

gerar_log_pdf() {
    # Desativa o redirecionamento para exibir mensagens finais diretamente no TTY
    exec > /dev/tty 2>&1

    echo ""
    msg "${YELLOW_NEON}[ODIN LOG] Finalizando gravação do log em formato PDF...${NC}"\
        "${YELLOW_NEON}[ODIN LOG] Finalizing log recording in PDF format...${NC}" \
        "${YELLOW_NEON}[ODIN LOG] Finalizando la grabación del registro en formato PDF...${NC}"

    # Garante as dependências necessárias no Arch Linux
    if ! command -v enscript &>/dev/null || ! command -v ps2pdf &>/dev/null || ! command -v iconv &>/dev/null; then
        msg "${GREEN_NEON}[ODIN LOG] Instalando dependências ('enscript', 'ghostscript', 'glibc')...${NC}"\
            "${GREEN_NEON}[ODIN LOG] Installing dependencies ('enscript', 'ghostscript', 'glibc')...${NC}" \
            "${GREEN_NEON}[ODIN LOG] Instalando dependencias ('enscript', 'ghostscript', 'glibc')...${NC}"
        sudo pacman -S --noconfirm --needed enscript ghostscript glibc >/dev/null 2>&1
    fi

    if command -v enscript &>/dev/null && command -v ps2pdf &>/dev/null; then
        # O sed limpa todas as sequências de escape ANSI (\x1b\[[0-9;]*[a-zA-Z])
        sed -r "s/\x1B\[[0-9;]*[a-zA-Z]//g" "$LOG_TXT" | \
        iconv -f UTF-8 -t ISO-8859-1//TRANSLIT 2>/dev/null | \
        enscript -B --line-numbers --font=Courier8 --encoding=latin1 -p - 2>/dev/null | \
        ps2pdf - "$LOG_PDF" 2>/dev/null
    fi

    if [[ -f "$LOG_PDF" ]]; then
        msg "${YELLOW_NEON}[ODIN LOG] Logs gravados com sucesso em:${NC}"\
            "${YELLOW_NEON}[ODIN LOG] Logs successfully saved at:${NC}" \
            "${YELLOW_NEON}[ODIN LOG] Registros guardados con éxito en:${NC}"
        echo "  - TXT: $LOG_TXT"
        echo "  - PDF: $LOG_PDF"
    else
        msg "${RED_NEON}[ODIN LOG] Falha ao gerar PDF. O log TXT está disponível em${NC}: $LOG_TXT"\
            "${RED_NEON}[ODIN LOG] Failed to generate PDF. The TXT log is available at${NC}: $LOG_TXT" \
            "${RED_NEON}[ODIN LOG] Error al generar PDF. El registro TXT está disponible en${NC}: $LOG_TXT"
    fi
}

trap gerar_log_pdf EXIT

#==================================================================
#verificar idiomas 
#==================================================================
VERIFICAR_IDIOMA() {
    
    local sys_locale="${LC_ALL:-${LANG:-$LC_MESSAGES}}"
    
   
    local sys_lang="${sys_locale%%.*}"

    
    IDIOMA_SISTEMA=""

    echo -e "${CYAN_NEON}[LANG CHECK] Detectando idioma do sistema operacional...${NC}"

    case "$sys_lang" in
        pt*|PT*)
            IDIOMA_SISTEMA="PT_BR"
            if [[ "$sys_lang" == "pt_BR" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: PT-BR (Português Brasil)${NC}"
            else
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: PT-BR (Português Brasil)${NC}"
            fi
            ;;

        es*|ES*)
            IDIOMA_SISTEMA="ES_ES"
            if [[ "$sys_lang" == "es_ES" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: ES-ES (Español España)${NC}"
            else
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: ES-ES (Español España)${NC}"
            fi
            ;;

        en*|EN*)
            IDIOMA_SISTEMA="EN_US"
            if [[ "$sys_lang" == "en_US" ]]; then
                echo -e "${GREEN_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Padrão definido: EN-US (English United States)${NC}"
            else
                # Mapeia qualquer variação de inglês (en_CA, en_GB, en_AU, etc.) para EN-US
                echo -e "${YELLOW_NEON}[LANG] Idioma detectado: '$sys_lang' ===> Mapeado para: EN-US (English United States)${NC}"
            fi
            ;;

        *)
            IDIOMA_SISTEMA="EN_US"
            if [[ -n "$sys_lang" ]]; then
                # Idioma não suportado diretamente (ex: ja_JP, fr_FR) caindo no Fallback EN-US
                echo -e "${YELLOW_NEON}[LANG] Idioma não suportado: '$sys_lang' ===> Aplicando Fallback: EN-US (English United States)${NC}"
            else
                echo -e "${NEON_BLUE}[LANG] Nenhum locale definido no ambiente ===> Aplicando Padrão Global: EN-US${NC}"
            fi
            ;;
    esac
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""

}

#=========================================================================================================

msg() {
    local pt_msg="$1"  # 1º argumento: Português (PT-BR)
    local en_msg="$2"  # 2º argumento: Inglês (EN-US)
    local es_msg="$3"  # 3º argumento: Espanhol (ES-ES)

    case "$IDIOMA_SISTEMA" in
        "PT_BR") echo -e "$pt_msg" ;;
        "EN_US") echo -e "$en_msg" ;;
        "ES_ES") echo -e "$es_msg" ;;
        *)       echo -e "$en_msg" ;; # Fallback padrão para Inglês
    esac
}
export -f msg

#===========================================================================================
# MÓDULO: GERENCIADOR DE SERVIÇOS (SYSTEMD / OPENRC)
#===========================================================================================
manage_service() {
    local action="$1"   # enable, start, stop, restart, status, is-enabled
    local service="$2"  # nome do serviço

    if command -v systemctl &>/dev/null && pidof systemd &>/dev/null; then
        case "$action" in
            enable)     sudo systemctl enable "$service" ;;
            start)      sudo systemctl start "$service" ;;
            restart)    sudo systemctl restart "$service" ;;
            stop)       sudo systemctl stop "$service" ;;
            status)     sudo systemctl status "$service" ;;
            is-enabled) systemctl is-enabled --quiet "$service" ;;
        esac
    elif command -v rc-service &>/dev/null; then
        case "$action" in
            enable)     sudo rc-update add "$service" default ;;
            start)      sudo rc-service "$service" start ;;
            restart)    sudo rc-service "$service" restart ;;
            stop)       sudo rc-service "$service" stop ;;
            status)     sudo rc-service "$service" status ;;
            is-enabled) rc-update show default 2>/dev/null | awk '{print $1}' | grep -qx "$service" ;;
        esac
    else
        if [ "$action" = "enable" ]; then
            msg "${YELLOW_NEON:-}[AVISO] Gerenciador de init não suportado para: $service${NC:-}" \
                "${YELLOW_NEON:-}[WARNING] Unsupported init manager for: $service${NC:-}" \
                "${YELLOW_NEON:-}[AVISO] Gestor de init no soportado para: $service${NC:-}"
        fi
        return 1
    fi
}
export -f manage_service

