        fi
        if ((${#dv_crit[@]})); then
            _dv_ln
            msg "${RED_NEON}[MODO DEV CONCLUÍDO COM ERROS CRÍTICOS]${NC}" \
                "${RED_NEON}[DEV MODE COMPLETED WITH CRITICAL ERRORS]${NC}" \
                "${RED_NEON}[MODO DEV COMPLETADO CON ERRORES CRÍTICOS]${NC}"
            _dv_ln 124 =
            return 1
        elif ((${#dv_fail[@]} + ${#dv_indis[@]} + ${#dv_valfail[@]} + ${#dv_avisos[@]})); then
            _dv_ln
            msg "${YELLOW_NEON}[CONCLUÍDO COM AVISOS] O ambiente foi preparado parcialmente.${NC}" \
                "${YELLOW_NEON}[COMPLETED WITH WARNINGS] The environment was partially prepared.${NC}" \
                "${YELLOW_NEON}[COMPLETADO CON AVISOS] El entorno se preparó parcialmente.${NC}"
            _dv_ln 124 =
        else
            _dv_ln
            msg "${GREEN_NEON}[SUCESSO] Ambiente de Desenvolvimento configurado e validado com sucesso!${NC}" \
                "${GREEN_NEON}[SUCCESS] Development environment configured and validated successfully!${NC}" \
                "${GREEN_NEON}[ÉXITO] ¡Entorno de Desarrollo configurado y validado con éxito!${NC}"
            _dv_ln 124 =
        fi
        echo ""
        sleep 1
        return 0
    }

    # Ctrl+C / TERM: limpa e repassa o sinal depois de restaurar os traps do Odin
    dv_oi=$(trap -p INT)
    dv_ot=$(trap -p TERM)
    trap 'dv_sig=INT; _dv_fim' INT
    trap 'dv_sig=TERM; _dv_fim' TERM
    dv_ts=1

    _dv_main || dv_rc=$?
    _dv_fim
    return "$dv_rc"
}

