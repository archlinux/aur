    for cd_p in "${cd_base[@]}" "${cd_desk[@]}"; do
        [[ " ${cd_fin[*]} " == *" $cd_p "* ]] || cd_fin+=("$cd_p")
    done

    if cd_out=$(LC_ALL=C pacman -Si -- "${cd_fin[@]}" 2>&1 >/dev/null); then
        cd_disp=("${cd_fin[@]}")
