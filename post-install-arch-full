PERGUNTAR_REINICIAR() {
    echo ""
    msg "${CYAN_NEON} [?] Recomendo reiniciar o sistema para aplicar todas as alterações.${NC}" \
        "${CYAN_NEON} [?] Recommended to reboot the system to apply all changes.${NC}" \
        "${CYAN_NEON} [?] Se recomienda reiniciar el sistema para aplicar todos los cambios.${NC}"
    echo "" 
    msg "${CYAN_NEON} [?] Gostaria de reiniciar agora? (s/N):${NC} " \
        "${CYAN_NEON} [?] Would you like to reboot now? (y/N):${NC} " \
        "${CYAN_NEON} [?] ¿Te gustaría reiniciar ahora? (s/N):${NC} "
    
    echo ""

    read -rp " > " RESPOSTA

    case "$RESPOSTA" in
        [Ss]|[Yy])
            echo ""
            msg "${RED_NEON} [!] Reiniciando o sistema...${NC}" \
                "${RED_NEON} [!] Rebooting system...${NC}" \
                "${RED_NEON} [!] Reiniciando el sistema...${NC}"

            for i in {5..1}; do
                echo -ne " ${CYAN_NEON}Reboot $i...${NC}\r"
                sleep 1
            done
            echo ""
            sudo reboot
            ;;

        [Nn])
            echo ""
            msg "${CYAN_NEON} [i] Reinicialização ignorada. Voltando ao menu...${NC}" \
                "${CYAN_NEON} [i] Reboot skipped. Returning to menu...${NC}" \
                "${CYAN_NEON} [i] Reinicio omitido. Volviendo al menú...${NC}"
            sleep 1.5
            ;;

        *)
            echo ""
            msg "${RED_NEON} [!] Opção inválida. Retornando ao menu por segurança...${NC}" \
                "${RED_NEON} [!] Invalid option. Returning to menu for safety...${NC}" \
                "${RED_NEON} [!] Opción inválida. Volviendo al menú por seguridad...${NC}"
            sleep 1.5
            ;;
    esac
}

