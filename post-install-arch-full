                if "$gm_helper" -S --needed --noconfirm heroic-games-launcher-bin && pacman -Q heroic-games-launcher-bin &>/dev/null; then
                    msg "${CYAN_NEON}[OK] Heroic Games Launcher instalado com sucesso.${NC}" \
                        "${CYAN_NEON}[OK] Heroic Games Launcher successfully installed.${NC}" \
                        "${CYAN_NEON}[OK] Heroic Games Launcher instalado con éxito.${NC}"
                else
