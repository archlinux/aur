    echo ""
    return $rc
    }
    
    otimizar_instalar_pkgs() {
        sleep 0.5
        local n_ess="$1"; shift
        local pkg i=0
        local -a essenciais=() ess_faltando=() ok=() ignorados=() opc_falha=()

        # Separa o que existe nos repositórios do que não existe (renomeado, removido, repo desativado)
        for pkg in "$@"; do
            i=$((i + 1))
            if [ "$i" -le "$n_ess" ]; then
                essenciais+=("$pkg")
            fi
            if pacman -Si "$pkg" &>/dev/null; then
                ok+=("$pkg")
            else
                ignorados+=("$pkg")
                if [ "$i" -le "$n_ess" ]; then
                    ess_faltando+=("$pkg")
                fi
            fi
        done

        if [ "${#ignorados[@]}" -gt 0 ]; then
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${YELLOW_NEON}[AVISO]: Pacotes não encontrados nos repositórios (ignorados): ${ignorados[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Packages not found in the repositories (skipped): ${ignorados[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: Paquetes no encontrados en los repositorios (omitidos): ${ignorados[*]}${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        fi

        # Essencial ausente: cancela tudo para não deixar uma configuração pela metade
        if [ "${#ess_faltando[@]}" -gt 0 ] || [ "${#ok[@]}" -eq 0 ]; then
            echo -e "${NEON_BLUE}----------------------------------------------------------------------------------------------------------------------------------------------${NC}"
            msg "${RED_NEON}[ERRO]: Pacote essencial não encontrado: ${ess_faltando[*]:-$*}. Instalação cancelada para evitar uma configuração incompleta.${NC}" \
                "${RED_NEON}[ERROR]: Essential package not found: ${ess_faltando[*]:-$*}. Installation cancelled to avoid an incomplete setup.${NC}" \
                "${RED_NEON}[ERROR]: Paquete esencial no encontrado: ${ess_faltando[*]:-$*}. Instalación cancelada para evitar una configuración incompleta.${NC}"
            echo -e "${NEON_BLUE}----------------------------------------------------------------------------------------------------------------------------------------------${NC}"
            return 1
        fi

        if sudo pacman -S --needed --noconfirm "${ok[@]}"; then
            return 0
        fi

        # Falhou em bloco (conflito, download...): essenciais juntos (atômico) e depois cada opcional sozinho
        echo -e "${NEON_BLUE}-----------------------------------------------------------------------------------------------------------------${NC}"
        msg "${YELLOW_NEON}[AVISO]: A instalação em bloco falhou. Instalando os essenciais e depois os opcionais um a um...${NC}" \
            "${YELLOW_NEON}[WARNING]: Bulk installation failed. Installing the essentials first, then the optional ones one by one...${NC}" \
            "${YELLOW_NEON}[AVISO]: La instalación en bloque falló. Instalando los esenciales y luego los opcionales uno a uno...${NC}"
        echo -e "${NEON_BLUE}------------------------------------------------------------------------------------------------------------------${NC}"    
        if ! sudo pacman -S --needed --noconfirm "${essenciais[@]}"; then
            return 1
        fi
        for pkg in "${ok[@]:$n_ess}"; do
            if ! sudo pacman -S --needed --noconfirm "$pkg"; then
                opc_falha+=("$pkg")
            fi
        done
        if [ "${#opc_falha[@]}" -gt 0 ]; then
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${YELLOW_NEON}[AVISO]: Não foi possível instalar (opcionais): ${opc_falha[*]}${NC}" \
                "${YELLOW_NEON}[WARNING]: Could not install (optional): ${opc_falha[*]}${NC}" \
                "${YELLOW_NEON}[AVISO]: No se pudo instalar (opcionales): ${opc_falha[*]}${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        fi
        return 0
    }
    
