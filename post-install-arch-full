                        "${CYAN_NEON}[OK] AUR gaming packages installed.${NC}" \
                        "${CYAN_NEON}[OK] Paquetes AUR de juegos instalados.${NC}"
                else
                    ((++gm_opc))
                    msg "${YELLOW_NEON}[AVISO] Falha ao instalar pacotes AUR de jogos. Continuando.${NC}" \
                        "${YELLOW_NEON}[WARNING] Failed to install AUR gaming packages. Continuing.${NC}" \
                        "${YELLOW_NEON}[AVISO] Falló la instalación de paquetes AUR de juegos. Continuando.${NC}"
                fi
