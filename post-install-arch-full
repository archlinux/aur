                     "Configurando repositorios y optimizaciones en pacman.conf..."
    [[ -f /etc/pacman.conf.bak-core ]] || sudo cp /etc/pacman.conf /etc/pacman.conf.bak-core

    if _core_cfg '\[multilib\]'; then
        _core_ln
        msg "-> Repositório Multilib já está ativo." \
            "-> Multilib repository is already enabled." \
            "-> Repositorio Multilib ya está activado."
        _core_ln
    else
        sudo sed -i '/^#\[multilib\]/{N;s/#//g}' /etc/pacman.conf
