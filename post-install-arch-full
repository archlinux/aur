    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╝${NC}"
    
    echo ""
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    msg "Analisando partições e espaço de segurança..." \
        "Analyzing partitions and safety space..." \
