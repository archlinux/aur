    _hk_instalar_lista() {
        local -a pacotes=("$@")
        local p="" consec=0 ok_lote=0
        (( ${#pacotes[@]} > 0 )) || return 0
        if "${SUDO[@]}" pacman -S --needed -- "${pacotes[@]}"; then ok_lote=1; fi
        _hk_carregar_inst
        if (( ok_lote )); then
            for p in "${pacotes[@]}"; do
                if [[ -n "${INST[$p]:-}" ]]; then
                    _hk_add INSTALADOS "$p"
                else
                    _hk_add VALIDACAO_FALHOU "$p"
                fi
            done
            return 0
        fi
        _hk_w "A transação em lote falhou (veja a saída do pacman acima)." \
              "The batch transaction failed (see the pacman output above)." \
              "La transacción en lote falló (vea la salida de pacman arriba)."
        if ! _hk_sn "Tentar instalar os pacotes um por um (os que derem conflito serão pulados)?" \
                    "Try installing the packages one by one (conflicting ones will be skipped)?" \
                    "¿Intentar instalar los paquetes uno por uno (los que den conflicto se omitirán)?"; then
            for p in "${pacotes[@]}"; do
                if [[ -n "${INST[$p]:-}" ]]; then _hk_add INSTALADOS "$p"; else _hk_add FALHARAM "$p"; fi
            done
            return 1
        fi
        for p in "${pacotes[@]}"; do
            if (( consec >= 3 )); then
                _hk_add FALHARAM "$p"
                continue
            fi
            if "${SUDO[@]}" pacman -S --needed -- "$p" && pacman -Q -- "$p" &>/dev/null; then
                _hk_add INSTALADOS "$p"
                consec=0
            else
                _hk_add FALHARAM "$p"
                consec=$((consec + 1))
                if (( consec == 3 )); then
                    _hk_e "3 falhas seguidas: provável problema de rede/mirror/repositório. Interrompendo o restante deste lote." \
                          "3 failures in a row: likely a network/mirror/repository problem. Stopping the rest of this batch." \
                          "3 fallos seguidos: probable problema de red/mirror/repositorio. Se detiene el resto de este lote."
                fi
            fi
        done
        return 1
    }

    
    _hk_instalar_tema() {
        local k="" p="" nec=0
        local -a ja_visto=() cands=() alts=() todos_pkgs=() l_disp=() l_indisp=() l_erro=()
        _hk_pre || return 1

        for k in "$@"; do
            _hk_titulo "$k"
            _hk_nota_tema "$k"
            if [[ -n "${T_GRP[$k]:-}" ]]; then
                msg "${CYAN_NEON}Grupos BlackArch relacionados (opção 16): ${T_GRP[$k]}${NC}" \
                    "${CYAN_NEON}Related BlackArch groups (option 16): ${T_GRP[$k]}${NC}" \
                    "${CYAN_NEON}Grupos BlackArch relacionados (opción 16): ${T_GRP[$k]}${NC}"
            fi
            for p in ${T_PKGS[$k]}; do
                [[ " ${ja_visto[*]} " == *" $p "* ]] && continue
                ja_visto+=("$p")
                todos_pkgs+=("$p")
            done
        done
        echo ""
        for p in "${todos_pkgs[@]}"; do
            IFS='|' read -r -a alts <<< "$p"
            cands+=("${alts[@]}")
        done
        _hk_classificar_lote "${cands[@]}"
        for p in "${todos_pkgs[@]}"; do
            _hk_resolver "$p"
            p="$ALT"
            _hk_linha_pkg "$p" "$CLS" "$CLS_REPO"
            case "$CLS" in
                instalado)    _hk_add JA_INSTALADOS "$p" ;;
                disponivel)   _hk_add l_disp "$p" ;;
                indisponivel) _hk_add l_indisp "$p"; _hk_add INDISPONIVEIS "$p" ;;
                *)            _hk_add l_erro "$p"; _hk_add CONSULTA_FALHOU "$p" ;;
            esac
        done
        echo ""
        if (( ${#l_indisp[@]} > 0 )); then
