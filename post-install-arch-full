    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╝${NC}"

    local -a ORPHANS_LIST
    mapfile -t ORPHANS_LIST < <(pacman -Qdtq 2>/dev/null)

    local -a ORPHANS_CLEAN=()
    for pkg in "${ORPHANS_LIST[@]}"; do
        [[ -n "$pkg" ]] && ORPHANS_CLEAN+=("$pkg")
    done
    ORPHANS_LIST=("${ORPHANS_CLEAN[@]}")
    unset ORPHANS_CLEAN

    if [ ${#ORPHANS_LIST[@]} -gt 0 ]; then
        echo "" 
        msg "${YELLOW_NEON}Pacotes órfãos detectados. Eliminando resíduos...${NC}" \
            "${YELLOW_NEON}Orphan packages detected. Wiping them out...${NC}" \
            "${YELLOW_NEON}Paquetes huérfanos detectados. Eliminando residuos...${NC}"

        if sudo pacman -Rns "${ORPHANS_LIST[@]}" --noconfirm; then
            msg "${GREEN_NEON}Fragmentos residuais eliminados com sucesso.${NC}" \
                "${GREEN_NEON}Residual data erased.${NC}" \
                "${GREEN_NEON}Fragmentos residuales eliminados con éxito.${NC}"
        else
            msg "${RED_NEON}[ERRO] Falha ao remover os pacotes órfãos.${NC}" \
                "${RED_NEON}[ERROR] Failed to remove orphan packages.${NC}" \
                "${RED_NEON}[ERROR] Error al eliminar los paquetes huérfanos.${NC}"
            rc=1
        fi
        echo ""
    else
        echo ""
        msg "${YELLOW_NEON}Nenhum fragmento encontrado nos setores.${NC}" \
            "${YELLOW_NEON}No fragments found in sectors.${NC}" \
            "${YELLOW_NEON}Ningún fragmento encontrado en los sectores.${NC}"
        echo "" 
    fi

    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    return "$rc"
}

