            "${CYAN_NEON}Verificando driver Vulkan (64/32 bits), fuentes y portal de escritorio requeridos por Steam...${NC}"
        echo ""

        # Se a otimização de hardware não rodou, detecta a GPU aqui
        if ((gm_amd == 0 && gm_intel == 0 && gm_nv == 0)) && command -v lspci &>/dev/null; then
            gm_pci=$(lspci -nn 2>/dev/null) || :
            while IFS= read -r gm_l; do
                [[ $gm_l == *VGA* || $gm_l == *3D* || $gm_l == *Display* ]] || continue
                gm_l="${gm_l,,}"
                [[ $gm_l == *"[1002:"* ]] && gm_amd=1
                [[ $gm_l == *"[8086:"* ]] && gm_intel=1
                [[ $gm_l == *"[10de:"* ]] && gm_nv=1
            done <<< "$gm_pci"
        fi

