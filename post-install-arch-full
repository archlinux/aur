    local TAM_TEXTO=${#TEXTO_DISK}
    local ESPACOS=$((LARGURA - TAM_TEXTO - 2))
    if [ "$ESPACOS" -lt 0 ]; then ESPACOS=0; fi
    local FREE_SPACE
    FREE_SPACE=$(df --output=avail -BG / | tail -n 1 | tr -d 'G ')

    msg "${NEON_BLUE}Verificando espaço em disco disponível...${NC}" \
        "${NEON_BLUE}Checking available disk space...${NC}" \
