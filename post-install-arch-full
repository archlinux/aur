                "${CYAN_NEON}-> Entorno MATE detectado: Seleccionando thumbnailers GTK/Caja${NC} (Tumbler/FFmpegthumbnailer)."
            pacotes_desktop=(tumbler ffmpegthumbnailer poppler-glib libgsf)
            ;;
        *XFCE*)
            msg "${CYAN_NEON}-> Ambiente XFCE detectado: Selecionando Tumbler e complementos${NC}." \
                "${CYAN_NEON}-> XFCE environment detected: Selecting Tumbler and add-ons${NC}." \
                "${CYAN_NEON}-> Entorno XFCE detectado: Seleccionando Tumbler y complementos${NC}."
            pacotes_desktop=(tumbler poppler-glib libgsf)
            ;;
        *LXQT*)
            msg "${CYAN_NEON}-> Ambiente LXQt detectado: Selecionando thumbnailers leves${NC} (Tumbler/FFmpegthumbs)." \
                "${CYAN_NEON}-> LXQt environment detected: Selecting lightweight thumbnailers${NC} (Tumbler/FFmpegthumbs)." \
                "${CYAN_NEON}-> Entorno LXQt detectado: Seleccionando thumbnailers ligeros${NC} (Tumbler/FFmpegthumbs)."
            pacotes_desktop=(tumbler ffmpegthumbs poppler-glib libgsf)
            ;;
        *)
            # Fallback: informa qual interface está em uso e segue com a base padrão
            if [[ -n "$de_detectado" ]]; then
                msg "${CYAN_NEON}-> Interface detectada: ${CYAN_NEON}${de_detectado}${NC} (sem perfil específico). Seguindo com a base padrão (Tumbler)." \
                    "${CYAN_NEON}-> Interface detected: ${CYAN_NEON}${de_detectado}${NC} (no specific profile). Proceeding with the standard base (Tumbler)." \
                    "${CYAN_NEON}-> Interfaz detectada: ${CYAN_NEON}${de_detectado}${NC} (sin perfil específico). Continuando con la base estándar (Tumbler)."
            else
                msg "${CYAN_NEON}-> Nenhuma interface gráfica detectada (TTY ou sessão sem DE). Seguindo com a base padrão (Tumbler).${NC}" \
                    "${CYAN_NEON}-> No graphical interface detected (TTY or session without a DE). Proceeding with the standard base (Tumbler).${NC}" \
                    "${CYAN_NEON}-> No se detectó ninguna interfaz gráfica (TTY o sesión sin DE). Continuando con la base estándar (Tumbler).${NC}"
            fi
            pacotes_desktop=(tumbler gst-thumbnailers)
            ;;
    esac

    # Junta os pacotes base com os pacotes específicos do DE em uma única linha de execução
    local pacotes_finais=("${pacotes_multimidia[@]}" "${pacotes_desktop[@]}")

    echo ""
    # Instalação unificada
    if sudo pacman -S --needed --noconfirm "${pacotes_finais[@]}"; then
        echo ""
        msg "-> ${CYAN_NEON}Codecs e pacotes de mídia instalados com sucesso!${NC}" \
            "-> ${CYAN_NEON}Codecs and media packages installed successfully!${NC}" \
            "-> ${CYAN_NEON}¡Códecs y paquetes de medios instalados con éxito!${NC}"
    else
        echo ""
        msg "${RED_NEON}[ERRO]: Falha ao instalar os codecs de multimídia.${NC}" \
            "${RED_NEON}[ERROR]: Failed to install multimedia codecs.${NC}" \
            "${RED_NEON}[ERROR]: Error al instalar los códecs de multimedia.${NC}"
        return 1
    fi
}

