    _hk_soma_sz() {
        local p="" v=0
        EST_MB=0
        for p in "$@"; do
            v="${SZ_MAP[$p]:--1}"
            (( v >= 0 )) || return 1
            EST_MB=$((EST_MB + v))
        done
