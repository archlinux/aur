        for cd_p in "${cd_fin[@]}"; do
            if [[ $cd_out == *"package '$cd_p' was not found"* ]]; then cd_ign+=("$cd_p"); else cd_disp+=("$cd_p"); fi
        done
        if ((${#cd_ign[@]} == 0)); then
            cd_disp=()
            for cd_p in "${cd_fin[@]}"; do
                if pacman -Si -- "$cd_p" &>/dev/null; then cd_disp+=("$cd_p"); else cd_ign+=("$cd_p"); fi
            done
        fi
    fi

    if ((${#cd_ign[@]})); then
        echo ""
        _cd_box 105 106 "${YELLOW_NEON}[AVISO]: Pacotes não encontrados nos repositórios (serão ignorados): ${cd_ign[*]}${NC}" \
            "${YELLOW_NEON}[WARNING]: Packages not found in the repositories (they will be skipped): ${cd_ign[*]}${NC}" \
            "${YELLOW_NEON}[AVISO]: Paquetes no encontrados en los repositorios (se omitirán): ${cd_ign[*]}${NC}"
    fi

    if ((${#cd_disp[@]} == 0)); then
        # Nada para instalar: provavelmente a base de dados do pacman não está sincronizada
        echo ""
        _cd_box 126 127 "${RED_NEON}[ERRO]: Nenhum pacote de mídia foi encontrado nos repositórios. Sincronize o pacman (pacman -Syu) e tente novamente.${NC}" \
            "${RED_NEON}[ERROR]: No media package was found in the repositories. Sync pacman (pacman -Syu) and try again.${NC}" \
            "${RED_NEON}[ERROR]: No se encontró ningún paquete de medios en los repositorios. Sincroniza pacman (pacman -Syu) e inténtalo de nuevo.${NC}"
        cd_rc=1
    else
        echo ""
        # Instalação unificada apenas com o que existe
        if ! sudo pacman -S --needed --noconfirm "${cd_disp[@]}"; then
            echo ""
            _cd_box 86 86 "${YELLOW_NEON}[AVISO]: A instalação em bloco falhou. Tentando instalar um pacote por vez...${NC}" \
                "${YELLOW_NEON}[WARNING]: Bulk installation failed. Trying to install one package at a time...${NC}" \
                "${YELLOW_NEON}[AVISO]: La instalación en bloque falló. Intentando instalar un paquete a la vez...${NC}"
            echo ""
            for cd_p in "${cd_disp[@]}"; do
                sudo pacman -S --needed --noconfirm "$cd_p" || cd_falha+=("$cd_p")
            done

            if ((${#cd_falha[@]} == ${#cd_disp[@]})); then
                # Nenhum pacote foi instalado: falha real
                echo ""
                _cd_box 86 86 "${RED_NEON}[ERRO]: Falha ao instalar os codecs de multimídia.${NC}" \
                    "${RED_NEON}[ERROR]: Failed to install multimedia codecs.${NC}" \
                    "${RED_NEON}[ERROR]: Error al instalar los códecs de multimedia.${NC}"
                cd_rc=1
            elif ((${#cd_falha[@]})); then
                echo ""
                _cd_box 86 86 "${YELLOW_NEON}[AVISO]: Não foi possível instalar: ${cd_falha[*]}${NC}" \
                    "${YELLOW_NEON}[WARNING]: Could not install: ${cd_falha[*]}${NC}" \
                    "${YELLOW_NEON}[AVISO]: No se pudo instalar: ${cd_falha[*]}${NC}"
            fi
        fi
    fi

    _cd_lista "${cd_ign[@]}" "${cd_falha[@]}"

    if ((cd_rc == 0)); then
        echo ""
        msg "-> ${CYAN_NEON}Codecs e pacotes de mídia instalados com sucesso!${NC}" \
            "-> ${CYAN_NEON}Codecs and media packages installed successfully!${NC}" \
            "-> ${CYAN_NEON}¡Códecs y paquetes de medios instalados con éxito!${NC}"
    fi

    unset -f _cd_ln _cd_box _cd_lista
    return "$cd_rc"
}

