    echo ""
    sleep 0.7

    # Captura espaço livre na raiz (/) em GB // Captures free space on root (/) in GB
    if [ "${FREE_SPACE:-0}" -lt 15 ]; then
        
        local msg_title msg_desc1 msg_desc2 msg_desc3 msg_desc4 msg_abort
        case "$IDIOMA_SISTEMA" in
