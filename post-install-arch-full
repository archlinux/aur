                    helper=""
                    if ((ah_yay && ah_paru)); then
                        while true; do
                            echo ""
                            _ah_ln 97
                            msg "${CYAN_NEON}Ambos os helpers (yay e paru) estão disponíveis. Qual deseja usar para instalar o $pk?${NC}" \
                                "${CYAN_NEON}Both helpers (yay and paru) are available. Which one do you want to use to install $pk?${NC}" \
                                "${CYAN_NEON}Ambos los helpers (yay y paru) están disponibles. ¿Cuál desea usar para instalar $pk?${NC}"
                            echo ""
                            sleep 0.5
                            msg "1) yay" \
                                "1) yay" \
                                "1) yay"
                            echo ""
                            msg "2) paru" \
                                "2) paru" \
                                "2) paru"
                            echo ""
                            msg "0) Não / Pular" \
                                "0) No / Skip" \
                                "0) No / Omitir"
                            echo ""
                            _ah_ask hc "Escolha / Choice / Opción: 1-2-0 " 97 || return 1
                            if [[ $hc == @(1|yay) ]]; then
                                helper="yay"; break
                            elif [[ $hc == @(2|paru) ]]; then
                                helper="paru"; break
                            elif [[ $hc == @(0|não|no|skip|omitir|pular) ]]; then
                                break 2
                            else
                                msg "Comando inválido! Tente novamente." \
                                    "Invalid command! Try again." \
                                    "¡Comando inválido! Inténtelo de nuevo."
                                echo ""
                            fi
                        done
                    elif ((ah_yay)); then
                        helper="yay"
                    else
                        helper="paru"
                    fi

                    # Se for o pamac-all, instala o snapd DIRETAMENTE DO AUR usando o helper escolhido e ativa o socket
                    if ((snap)); then
                        _ah_box 86 86 "${CYAN_NEON}Instalando e configurando o snapd via AUR ($helper) para o pamac-all...${NC}" \
                            "${CYAN_NEON}Installing and configuring snapd via AUR ($helper) for pamac-all...${NC}" \
                            "${CYAN_NEON}Instalando y configurando snapd vía AUR ($helper) para pamac-all...${NC}"
                        echo ""
                        sleep 0.5
                        if "$helper" -S --needed --noconfirm snapd && manage_service enable snapd.socket && manage_service start snapd.socket; then
                            echo ""
                            msg "snapd instalado e habilitado com sucesso." \
                                "snapd successfully installed and enabled." \
                                "snapd instalado y habilitado con éxito."
                        else
                            echo ""
                            msg "Falha ao instalar ou habilitar o snapd." \
                                "Failed to install or enable snapd." \
                                "Error al instalar o habilitar snapd."
                        fi
                    fi
                    echo ""
                    _ah_box 86 86 "Instalando $pk utilizando o $helper..." \
                        "Installing $pk using $helper..." \
                        "Instalando $pk usando $helper..."
                    sleep 0.5
                    if "$helper" -S --needed --noconfirm "$pk"; then
                        msg "$pk instalado com sucesso." \
                            "$pk successfully installed." \
                            "$pk instalado con éxito."
                        break 2
                    else
                        _ah_box 86 86 "Falha na instalação de $pk. Prosseguindo com o script..." \
                            "Failed to install $pk. Proceeding with the script..." \
                            "Error al instalar $pk. Prosiguiendo con el script..."
                        return 0
                    fi
                done
                break
            elif [[ $op == @(0|voltar|pular|back|skip|volver|omitir) ]]; then
                msg "Pamac ignorado, seguindo o script..." \
                    "Pamac skipped, proceeding with the script..." \
                    "Pamac omitido, prosiguiendo con el script..."
                break
            else
                msg "Comando inválido! Tente novamente." \
                    "Invalid command! Try again." \
                    "¡Comando inválido! Inténtelo de nuevo."
                echo ""
            fi
        done

        return 0
    }

    # Ctrl+C / TERM: limpa o temporário e repassa o sinal depois de restaurar os traps
    ah_oi=$(trap -p INT)
    ah_ot=$(trap -p TERM)
    trap 'ah_sig=INT; _ah_fim' INT
    trap 'ah_sig=TERM; _ah_fim' TERM
    ah_ts=1

    _ah_main || ah_rc=$?
    _ah_fim
    return "$ah_rc"
}

#=========================================
#ENCERRAMENTO FUNÇÃO HELPER
#=========================================
FUNCAO_INSTALAR_NAVEGADORES() {
    local nv_yay=0 nv_paru=0 nv_tmp="" nv_sig="" nv_oi="" nv_ot="" nv_ts=0 nv_rc=0
    # Tabela única de navegadores (índice 1 a 5): nome, pacote e se é AUR (1) ou repositório oficial (0)
    local -a nv_nomes=("" "Firefox" "Vivaldi" "Google Chrome" "Brave Browser" "Zen Browser")
    local -a nv_pkgs=("" "firefox" "vivaldi" "google-chrome" "brave-bin" "zen-browser-bin")
    local -a nv_aur=(0 0 0 1 1 1)

    # Linha decorativa: _nv_ln [largura=86]
    _nv_ln() { local s=""; printf -v s '%*s' "${1:-86}" ''; echo -e "${NEON_BLUE}${s// /-}${NC}"; }

    # Mensagem entre duas linhas: _nv_box <larg_topo> <larg_base> <pt> <en> <es>
    _nv_box() { _nv_ln "$1"; msg "$3" "$4" "$5"; _nv_ln "$2"; }

    # Opção de menu seguida de linha em branco: _nv_opt <pt> <en> <es>
    _nv_opt() { msg "$1" "$2" "$3"; echo ""; }

    # Lê a opção em <variável> (sem espaços, minúscula); se houver 3º argumento, fecha com linha dessa largura
    _nv_ask() {
        local -n _r="$1"
        read -rp "$2" _r || return 1
        [[ -n ${3:-} ]] && _nv_ln "$3"
        _r="${_r//[[:space:]]/}"; _r="${_r,,}"
        return 0
    }

    # Junta itens com ", ": _nv_join <variável> <itens...>
    _nv_join() { local -n _j="$1"; shift; printf -v _j '%s, ' "$@"; _j="${_j%, }"; }

    # Nomes dos navegadores a partir dos índices: _nv_nomes <variável> <índices...>
    _nv_nomes() { local -n _n="$1"; shift; local i=""; _n=""; for i in "$@"; do _n+="${nv_nomes[i]}, "; done; _n="${_n%, }"; }

    # Linha do resumo (só se a lista tiver itens): _nv_res <cor> <pt> <en> <es> <array>
    _nv_res() {
        local -n _a="$5"; local l=""
        ((${#_a[@]})) || return 0
        _nv_join l "${_a[@]}"
        msg "${1}${2}: ${l}${NC}" "${1}${3}: ${l}${NC}" "${1}${4}: ${l}${NC}"
    }

    # Fim da função (normal ou por Ctrl+C/TERM): limpa o temporário, restaura os traps e remove os ajudantes
    _nv_fim() {
        local s="$nv_sig"
        if [[ -n $s ]]; then
            echo ""
            msg "${YELLOW_NEON}[AVISO] Instalação de navegadores interrompida. Limpando arquivos temporários...${NC}" \
                "${YELLOW_NEON}[WARNING] Browser installation interrupted. Cleaning up temporary files...${NC}" \
                "${YELLOW_NEON}[AVISO] Instalación de navegadores interrumpida. Limpiando archivos temporales...${NC}"
        fi
        if [[ -n $nv_tmp ]]; then rm -rf "$nv_tmp"; nv_tmp=""; fi
        if ((nv_ts)); then
            if [[ -n $nv_oi ]]; then eval "$nv_oi"; else trap - INT; fi
            if [[ -n $nv_ot ]]; then eval "$nv_ot"; else trap - TERM; fi
            nv_ts=0
        fi
        unset -f _nv_ln _nv_box _nv_opt _nv_ask _nv_join _nv_nomes _nv_res _nv_main _nv_fim
        [[ -n $s ]] || return 0
        kill -s "$s" $$
        [[ $s == INT ]] && exit 130
        exit 143
    }

    _nv_main() {
        local op="" mu="" hi="" hc="" idx="" i=0 ch="" pk="" nome="" lista=""
        local helper="" hn="" hdep="" hok=0 pode=1 canc=0 built=0 vis="" rej=""
        local -a sel=() fila=() ok=() falha=() pulado=() ign=()

        # Verifica os helpers já instalados no sistema
        command -v yay &>/dev/null && nv_yay=1
        command -v paru &>/dev/null && nv_paru=1

        while true; do
            sel=()
            _nv_box 86 86 "${CYAN_NEON}Selecione o navegador que deseja instalar:${NC}" \
                "${CYAN_NEON}Select the browser you want to install:${NC}" \
                "${CYAN_NEON}Seleccione el navegador que desea instalar:${NC}"
            sleep 0.7
            echo ""
            _nv_opt "1) Firefox (Repositório Oficial / Extra)" \
                "1) Firefox (Official Repository / Extra)" \
                "1) Firefox (Repositorio Oficial / Extra)"
            _nv_opt "2) Vivaldi (Repositório Oficial / Extra)" \
                "2) Vivaldi (Official Repository / Extra)" \
                "2) Vivaldi (Repositorio Oficial / Extra)"
            _nv_opt "3) Google-Chrome (AUR - Requer Helper)" \
                "3) Google-Chrome (AUR - Requires Helper)" \
                "3) Google-Chrome (AUR - Requiere Helper)"
            _nv_opt "4) Brave Browser (AUR - Requer Helper)" \
                "4) Brave Browser (AUR - Requires Helper)" \
                "4) Brave Browser (AUR - Requiere Helper)"
            _nv_opt "5) Zen browser (AUR - Requer Helper)" \
                "5) Zen browser (AUR - Requires Helper)" \
                "5) Zen browser (AUR - Requiere Helper)"
            _nv_opt "6) Instalar multiplos navegadores" \
                "6) Install multiple browsers" \
                "6) Instalar múltiples navegadores"
            _nv_opt "0) Concluir / Seguir com o script" \
                "0) Finish / Proceed with script" \
                "0) Finalizar / Continuar con el script"
            _nv_ask op "Escolha / Choice / Opción: 1-2-3-4-5-6-0: =>  " || return 1

            case "$op" in
                1|firefox) sel=(1) ;;
                2|vivaldi) sel=(2) ;;
                3|google-chrome|googlechrome|chrome) sel=(3) ;;
                4|brave|brave-browser|brave-bin) sel=(4) ;;
                5|zen|zen-browser|zenbrowser|zen-browser-bin) sel=(5) ;;
                6|multi|multiplo|multiplos|multiple|multiples|múltiples|instalar-multiplo|install-multiple|instalar-múltiples)
                 
                    canc=0
                    echo ""
                    while true; do
                        sel=(); ign=(); vis=""; rej=""
                        _nv_ln
                        _nv_opt "${CYAN_NEON}Digite os números dos navegadores que quer instalar (de 1 a 5):${NC}" \
                            "${CYAN_NEON}Enter the numbers of the browsers you want to install (from 1 to 5):${NC}" \
                            "${CYAN_NEON}Introduce los números de los navegadores que quieres instalar (del 1 al 5):${NC}"
                        echo ""    
                        _nv_opt "Exemplos: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (qualquer ordem, repetidos são ignorados)" \
                            "Examples: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (any order, repeated ones are ignored)" \
                            "Ejemplos: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (cualquier orden, los repetidos se ignoran)"    
                        _nv_opt "0) Voltar ao menu" \
                            "0) Back to menu" \
                            "0) Volver al menú"
                        read -rp "Escolha / Choice / Opción: =>  " mu || return 1
                        _nv_ln
                        mu="${mu,,}"

                        # Entrada só com "0" (ou palavra de cancelamento): volta ao menu principal
                        if [[ ${mu//[[:space:]]/} == @(0|cancelar|cancel|voltar|back|volver|n|no|nao|não) ]]; then
                            canc=1
                            break
                        fi

                        for ((i = 0; i < ${#mu}; i++)); do
                            ch="${mu:i:1}"
                            if [[ $ch == [1-5] ]]; then
                                [[ $vis == *"$ch"* ]] || { vis+="$ch"; sel+=("$ch"); }
                            elif [[ $ch != @([[:space:]]|[,\;.:/+_\\\|-]|[eyand]) ]]; then
                                [[ $rej == *"$ch"* ]] || { rej+="$ch"; ign+=("$ch"); }
                            fi
                        done

                        if ((${#sel[@]} == 0)); then
                            _nv_box 86 86 "${YELLOW_NEON}Nenhum navegador válido na entrada. Use números de 1 a 5.${NC}" \
                                "${YELLOW_NEON}No valid browser in the input. Use numbers from 1 to 5.${NC}" \
                                "${YELLOW_NEON}Ningún navegador válido en la entrada. Use números del 1 al 5.${NC}"
                            echo ""
                            continue
                        fi

                        if ((${#ign[@]})); then
                            echo ""
                            msg "${YELLOW_NEON}[AVISO]: Entradas ignoradas (fora de 1-5): ${ign[*]}${NC}" \
                                "${YELLOW_NEON}[WARNING]: Ignored entries (outside 1-5): ${ign[*]}${NC}" \
                                "${YELLOW_NEON}[AVISO]: Entradas ignoradas (fuera de 1-5): ${ign[*]}${NC}"
                        fi
                        break
                    done

                    if ((canc)); then
                        echo ""
                        continue
                    fi
                    ;;
                0|concluir|finish|finalizar)
                    _nv_box 86 86 "${CYAN_NEON}Instalação de navegadores finalizada. Prosseguindo com o script...${NC}" \
                        "${CYAN_NEON}Browser installation completed. Proceeding with the script...${NC}" \
                        "${CYAN_NEON}Instalación de navegadores finalizada. Prosiguiendo con el script...${NC}"
                    return 0
                    ;;
                *)
                    msg "Comando inválido! Tente novamente." \
                        "Invalid command! Try again." \
                        "¡Comando inválido! Inténtelo de nuevo."
                    echo ""
                    continue
                    ;;
            esac

            # Fila de instalação: repositório oficial primeiro, AUR depois (o helper é resolvido uma única vez)
            fila=(); ok=(); falha=(); pulado=()
            echo ""
            if ((${#sel[@]} > 1)); then
                _nv_nomes lista "${sel[@]}"
                _nv_box 86 86 "${CYAN_NEON}Navegadores selecionados: ${lista}${NC}" \
                    "${CYAN_NEON}Selected browsers: ${lista}${NC}" \
                    "${CYAN_NEON}Navegadores seleccionados: ${lista}${NC}"
                echo ""
                sleep 0.5
            fi

            # ---------------------------------------------------------------
            # Etapa 1: pacotes do repositório oficial (Extra)
            # ---------------------------------------------------------------
            for idx in "${sel[@]}"; do
                nome="${nv_nomes[idx]}"; pk="${nv_pkgs[idx]}"
                if ((nv_aur[idx])); then fila+=("$idx"); continue; fi
                _nv_box 86 86 "Instalando $nome ($pk) via Pacman..." \
                    "Installing $nome ($pk) via Pacman..." \
                    "Instalando $nome ($pk) vía Pacman..."
                echo ""
                sleep 0.5

                # Pacote inexistente derrubaria a transação inteira: verifica antes
                if ! pacman -Si "$pk" &>/dev/null; then
                    _nv_box 86 86 "${RED_NEON}Pacote $pk não encontrado nos repositórios. Sincronize o pacman (pacman -Syu) e tente novamente.${NC}" \
                        "${RED_NEON}Package $pk not found in the repositories. Sync pacman (pacman -Syu) and try again.${NC}" \
                        "${RED_NEON}Paquete $pk no encontrado en los repositorios. Sincroniza pacman (pacman -Syu) e inténtalo de nuevo.${NC}"
                    echo ""
                    falha+=("$nome")
                elif sudo pacman -S --needed --noconfirm "$pk"; then
                    echo ""
                    _nv_box 66 66 "${CYAN_NEON}$nome instalado com sucesso!${NC}" \
                        "${CYAN_NEON}$nome successfully installed!${NC}" \
                        "${CYAN_NEON}¡$nome instalado con éxito!${NC}"
                    sleep 0.5
                    echo ""
                    ok+=("$nome")
                else
                    echo ""
                    _nv_box 86 86 "${RED_NEON}Falha ao instalar $nome.${NC}" \
                        "${RED_NEON}Failed to install $nome.${NC}" \
                        "${RED_NEON}Error al instalar $nome.${NC}"
                    echo ""
                    falha+=("$nome")
                fi
            done

            # ---------------------------------------------------------------
            # Etapa 2: pacotes do AUR (helper resolvido uma vez para todos)
            # ---------------------------------------------------------------
            if ((${#fila[@]})); then
                pode=1; helper=""

                # makepkg/yay/paru se recusam a rodar como root
                if ((EUID == 0)); then
                    _nv_box 86 86 "${RED_NEON}Os pacotes do AUR não podem ser instalados como root. Execute o script com um usuário comum (com sudo).${NC}" \
                        "${RED_NEON}AUR packages cannot be installed as root. Run the script as a regular user (with sudo).${NC}" \
                        "${RED_NEON}Los paquetes del AUR no pueden instalarse como root. Ejecute el script con un usuario normal (con sudo).${NC}"
                    echo ""
                    pode=0
                fi

                # Se não houver nenhum helper instalado, oferece a instalação sob demanda
                if ((pode && !nv_yay && !nv_paru)); then
                    _nv_nomes lista "${fila[@]}"
                    _nv_box 86 86 "${YELLOW_NEON}Atenção: os pacotes do AUR (${lista}) requerem um AUR helper (yay ou paru).${NC}" \
                        "${YELLOW_NEON}Attention: the AUR packages (${lista}) require an AUR helper (yay or paru).${NC}" \
                        "${YELLOW_NEON}Atención: los paquetes del AUR (${lista}) requieren un AUR helper (yay o paru).${NC}"
                    echo ""
                    sleep 0.5
                    hok=0
                    while true; do
                        _nv_ln
                        _nv_opt "${CYAN_NEON}Deseja instalar um AUR helper agora para prosseguir?${NC}" \
                            "${CYAN_NEON}Do you want to install an AUR helper now to proceed?${NC}" \
                            "${CYAN_NEON}¿Desea instalar un AUR helper ahora para continuar?${NC}"
                        echo ""    
                        _nv_opt "1) Instalar 'yay'" \
                            "1) Install 'yay'" \
                            "1) Instalar 'yay'"
                        _nv_opt "2) Instalar 'paru'" \
                            "2) Install 'paru'" \
                            "2) Instalar 'paru'"
                        _nv_opt "0) Cancelar instalação dos pacotes do AUR" \
                            "0) Cancel the AUR packages installation" \
                            "0) Cancelar la instalación de los paquetes del AUR"
                        _nv_ask hi "Escolha / Choice / Opción: 1-2-0 " 86 || return 1

                        if [[ $hi == @(1|yay) ]]; then
                            hn=yay; hdep=go
                        elif [[ $hi == @(2|paru) ]]; then
                            hn=paru; hdep=rust
                        elif [[ $hi == @(0|cancelar|cancel) ]]; then
                            msg "Instalação do AUR helper cancelada." \
                                "AUR helper installation canceled." \
                                "Instalación del AUR helper cancelada."
                            echo ""
                            break
                        else
                            msg "Comando inválido! Tente novamente." \
                                "Invalid command! Try again." \
                                "¡Comando inválido! Inténtelo de nuevo."
                            echo ""
                            continue
                        fi

                        msg "Instalando ${hn}-bin..." \
                            "Installing ${hn}-bin..." \
                            "Instalando ${hn}-bin..."
                        echo ""

                        if ! nv_tmp=$(mktemp -d); then
                            msg "${RED_NEON}Não foi possível criar o diretório temporário.${NC}" \
                                "${RED_NEON}Could not create the temporary directory.${NC}" \
                                "${RED_NEON}No se pudo crear el directorio temporal.${NC}"
                            echo ""
                            break
                        fi

                        built=0
                        if sudo pacman -S --needed --noconfirm git base-devel "$hdep" && \
                           git clone "https://aur.archlinux.org/${hn}-bin.git" "$nv_tmp/${hn}-bin" && \
                           (cd "$nv_tmp/${hn}-bin" && makepkg -si --noconfirm); then
                            built=1
                        fi
                        rm -rf "$nv_tmp"; nv_tmp=""

                        if ((built)) && command -v "$hn" &>/dev/null; then
                            if [[ $hn == yay ]]; then nv_yay=1; else nv_paru=1; fi
                            hok=1
                            echo ""
                            msg "${CYAN_NEON}${hn}-bin instalado com sucesso!${NC}" \
                                "${CYAN_NEON}${hn}-bin successfully installed!${NC}" \
                                "${CYAN_NEON}¡${hn}-bin instalado con éxito!${NC}"
                            echo ""
                            break
                        fi

                        msg "${RED_NEON}Falha na instalação do ${hn}-bin.${NC}" \
                            "${RED_NEON}Failed to install ${hn}-bin.${NC}" \
                            "${RED_NEON}Error al instalar ${hn}-bin.${NC}"
                        echo ""
                    done

                    # Cancelou ou falhou: os navegadores do AUR são pulados e o menu volta
                    if ((!hok)); then
                        _nv_box 86 86 "${YELLOW_NEON}Nenhum helper disponível. Navegadores do AUR cancelados: ${lista}.${NC}" \
                            "${YELLOW_NEON}No helper available. AUR browsers canceled: ${lista}.${NC}" \
                            "${YELLOW_NEON}Ningún helper disponible. Navegadores del AUR cancelados: ${lista}.${NC}"
                        echo ""
                        pode=0
                    fi
                fi

                # Seleciona qual helper utilizar (uma única vez) caso ambos estejam instalados
                if ((pode)); then
                    if ((nv_yay && nv_paru)); then
                        while true; do
                            _nv_ln 107
                            msg "${CYAN_NEON}Ambos os helpers (yay e paru) estão instalados. Qual deseja usar para instalar os pacotes do AUR?${NC}" \
                                "${CYAN_NEON}Both helpers (yay and paru) are installed. Which one do you want to use to install the AUR packages?${NC}" \
                                "${CYAN_NEON}Ambos los helpers (yay y paru) están instalados. ¿Cuál desea usar para instalar los paquetes del AUR?${NC}"
                            echo ""
                            sleep 0.5
                            _nv_opt "1) yay" "1) yay" "1) yay"
                            _nv_opt "2) paru" "2) paru" "2) paru"
                            _nv_opt "0) Cancelar instalação dos pacotes do AUR" \
                                "0) Cancel the AUR packages installation" \
                                "0) Cancelar la instalación de los paquetes del AUR"
                            _nv_ask hc "Escolha / Choice / Opción: 1-2-0 : => " 107 || return 1
                            if [[ $hc == @(1|yay) ]]; then
                                helper=yay; break
                            elif [[ $hc == @(2|paru) ]]; then
                                helper=paru; break
                            elif [[ $hc == @(0|cancelar|cancel) ]]; then
                                msg "${YELLOW_NEON}Instalação dos pacotes do AUR cancelada.${NC}" \
                                    "${YELLOW_NEON}AUR packages installation canceled.${NC}" \
                                    "${YELLOW_NEON}Instalación de los paquetes del AUR cancelada.${NC}"
                                echo ""
                                pode=0
                                break
                            else
                                msg "Comando inválido! Tente novamente." \
                                    "Invalid command! Try again." \
                                    "¡Comando inválido! Inténtelo de nuevo."
                                echo ""
                            fi
                        done
                    elif ((nv_yay)); then
                        helper=yay
                    elif ((nv_paru)); then
                        helper=paru
                    fi
                fi

                # Instalação de cada navegador do AUR com o helper escolhido
                if ((pode)) && [[ -n $helper ]]; then
                    for idx in "${fila[@]}"; do
                        nome="${nv_nomes[idx]}"; pk="${nv_pkgs[idx]}"
                        sleep 0.5
                        msg "Instalando $nome ($pk) utilizando $helper..." \
                            "Installing $nome ($pk) using $helper..." \
                            "Instalando $nome ($pk) usando $helper..."
                        echo ""
                        if "$helper" -S --needed --noconfirm "$pk"; then
                            echo ""
                            msg "${CYAN_NEON}$nome instalado com sucesso via $helper!${NC}" \
                                "${CYAN_NEON}$nome successfully installed via $helper!${NC}" \
                                "${CYAN_NEON}¡$nome instalado con éxito vía $helper!${NC}"
                            ok+=("$nome")
                        else
                            echo ""
                            msg "${RED_NEON}Falha na instalação de $nome via $helper.${NC}" \
                                "${RED_NEON}Failed to install $nome via $helper.${NC}" \
                                "${RED_NEON}Error al instalar $nome vía $helper.${NC}"
                            falha+=("$nome")
                        fi
                        echo ""
                    done
                else
                    for idx in "${fila[@]}"; do pulado+=("${nv_nomes[idx]}"); done
                fi
            fi

            # ---------------------------------------------------------------
            # Resumo (apenas quando houve mais de um navegador na seleção)
            # ---------------------------------------------------------------
            if ((${#sel[@]} > 1)); then
                msg "${CYAN_NEON}Resumo da instalação:${NC}" \
                    "${CYAN_NEON}Installation summary:${NC}" \
                    "${CYAN_NEON}Resumen de la instalación:${NC}"
                echo ""
                _nv_res "$CYAN_NEON" "Instalados" "Installed" "Instalados" ok
                _nv_res "$RED_NEON" "Falharam" "Failed" "Fallaron" falha
                _nv_res "$YELLOW_NEON" "Pulados (AUR)" "Skipped (AUR)" "Omitidos (AUR)" pulado
                echo ""
                sleep 0.5
            fi
        done
    }

    # Ctrl+C / TERM: limpa o temporário e repassa o sinal depois de restaurar os traps
    nv_oi=$(trap -p INT)
    nv_ot=$(trap -p TERM)
    trap 'nv_sig=INT; _nv_fim' INT
    trap 'nv_sig=TERM; _nv_fim' TERM
    nv_ts=1

    _nv_main || nv_rc=$?
    _nv_fim
    return "$nv_rc"
}

