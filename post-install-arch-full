        ((gm_amd == 1)) && gm_virt+=(vulkan-radeon lib32-vulkan-radeon)
        ((gm_intel == 1)) && gm_virt+=(vulkan-intel lib32-vulkan-intel)
        if ((gm_nv == 1)); then
            gm_q=$(pacman -Qq nvidia-utils vulkan-nouveau 2>/dev/null) || :
            if [[ $'\n'$gm_q$'\n' == *$'\nnvidia-utils\n'* ]]; then
                gm_virt+=(lib32-nvidia-utils)
            elif [[ $'\n'$gm_q$'\n' == *$'\nvulkan-nouveau\n'* ]]; then
                # NVK (driver aberto): respeita o que já está instalado e completa só a parte 32 bits
                gm_virt+=(lib32-vulkan-nouveau)
            else
                ((++gm_opc))
                msg "${YELLOW_NEON}[AVISO] GPU NVIDIA sem driver proprietário instalado. Rode a otimização de hardware (NVIDIA) para jogar com desempenho total.${NC}" \
                    "${YELLOW_NEON}[WARNING] NVIDIA GPU without the proprietary driver installed. Run the hardware optimization (NVIDIA) to play at full performance.${NC}" \
                    "${YELLOW_NEON}[AVISO] GPU NVIDIA sin el driver propietario instalado. Ejecute la optimización de hardware (NVIDIA) para jugar con el máximo rendimiento.${NC}"
            fi
        fi

        if ((gm_amd == 0 && gm_intel == 0 && gm_nv == 0)); then
            # Sem GPU reconhecida (ex.: máquina virtual): o renderizador por software entra só para o lado (64 ou 32 bits) que ainda não tem driver Vulkan
            pacman -T vulkan-driver &>/dev/null && gm_v64=1
            pacman -T lib32-vulkan-driver &>/dev/null && gm_v32=1
            if ((gm_v64 && gm_v32)); then
                msg "${CYAN_NEON}[OK] Driver Vulkan de 64 e 32 bits já instalado.${NC}" \
                    "${CYAN_NEON}[OK] 64-bit and 32-bit Vulkan driver already installed.${NC}" \
                    "${CYAN_NEON}[OK] Driver Vulkan de 64 y 32 bits ya instalado.${NC}"
            else
                ((gm_v64)) || gm_virt+=(vulkan-swrast)
                ((gm_v32)) || gm_virt+=(lib32-vulkan-swrast)
            fi
        fi

        pacman -T ttf-font &>/dev/null || gm_virt+=(ttf-liberation)

        if ! pacman -T xdg-desktop-portal-impl &>/dev/null; then
            gm_de="${XDG_CURRENT_DESKTOP:-}"
            case "${gm_de^^}" in
                *KDE*|*PLASMA*)         gm_virt+=(xdg-desktop-portal-kde) ;;
                *GNOME*)                gm_virt+=(xdg-desktop-portal-gnome) ;;
                *HYPRLAND*)             gm_virt+=(xdg-desktop-portal-hyprland xdg-desktop-portal-gtk) ;;
                *SWAY*|*RIVER*|*LABWC*) gm_virt+=(xdg-desktop-portal-wlr xdg-desktop-portal-gtk) ;;
                *LXQT*)                 gm_virt+=(xdg-desktop-portal-lxqt) ;;
                *)                      gm_virt+=(xdg-desktop-portal-gtk) ;;
            esac
        fi

        if ((${#gm_virt[@]})); then
            msg "${CYAN_NEON}Instalando dependências base: ${gm_virt[*]}${NC}" \
                "${CYAN_NEON}Installing base dependencies: ${gm_virt[*]}${NC}" \
                "${CYAN_NEON}Instalando dependencias base: ${gm_virt[*]}${NC}"
            echo ""
            sudo -v 2>/dev/null || true
            for gm_vp in "${gm_virt[@]}"; do
                _gm_pac "$gm_vp" || true
            done
        fi
        echo ""

        # ── 4. Filtragem e instalação dos pacotes principais (Oficiais + AUR) ──────────────
        msg "${CYAN_NEON}Verificando pacotes de jogos, Steam, Lutris e dependências (Wine/Vulkan)...${NC}" \
            "${CYAN_NEON}Checking gaming packages, Steam, Lutris, and dependencies (Wine/Vulkan)...${NC}" \
            "${CYAN_NEON}Verificando paquetes de juegos, Steam, Lutris y dependencias (Wine/Vulkan)...${NC}"
        echo ""

        # wine e wine-staging conflitam (wine-staging fornece 'wine'): nunca os dois. Se já existe 'wine', ele é mantido.
        if pacman -Q wine &>/dev/null; then
            gm_wine="wine"
            msg "${YELLOW_NEON}[AVISO] O pacote 'wine' já está instalado e será mantido (conflita com o 'wine-staging').${NC}" \
                "${YELLOW_NEON}[WARNING] The 'wine' package is already installed and will be kept (it conflicts with 'wine-staging').${NC}" \
                "${YELLOW_NEON}[AVISO] El paquete 'wine' ya está instalado y se mantendrá (entra en conflicto con 'wine-staging').${NC}"
            echo ""
        fi

        gm_pkgs=(
            steam lutris gamescope gamemode lib32-gamemode
            vulkan-icd-loader lib32-vulkan-icd-loader vulkan-tools
            "$gm_wine" winetricks wine-mono wine-gecko protontricks umu-launcher
            vkd3d lib32-vkd3d
            lib32-alsa-lib lib32-alsa-plugins lib32-libpulse lib32-openal
            lib32-giflib lib32-libjpeg-turbo lib32-libpng lib32-libva lib32-mpg123
            lib32-gtk3 lib32-sqlite lib32-libxcomposite lib32-libxinerama
            lib32-gst-plugins-base-libs lib32-ocl-icd
            giflib libjpeg-turbo libpng libva mpg123 gst-plugins-base-libs
            lib32-fontconfig lib32-gcc-libs lib32-glibc lib32-libxss lib32-libxrandr
            lib32-dbus lib32-libldap lib32-gnutls gnutls
        )

        # dxvk não existe nos repositórios oficiais (só AUR)
        gm_aur=(dxvk-bin)

        sudo -v 2>/dev/null || true
        if ! _gm_pac "${gm_pkgs[@]}"; then
            msg "${YELLOW_NEON}[AVISO] Não instalados (opcionais, o modo Game continua): ${gm_fail[*]}${NC}" \
                "${YELLOW_NEON}[WARNING] Not installed (optional, Game Mode continues): ${gm_fail[*]}${NC}" \
                "${YELLOW_NEON}[AVISO] No instalados (opcionales, el modo juego continúa): ${gm_fail[*]}${NC}"
        fi

        # Steam é o único item essencial do modo Game
        if ! pacman -Q steam &>/dev/null; then
            ((++gm_crit))
            msg "${RED_NEON}[ERRO] Falha ao instalar o Steam (pacote essencial do modo Game).${NC}" \
                "${RED_NEON}[ERROR] Failed to install Steam (essential package of Game Mode).${NC}" \
                "${RED_NEON}[ERROR] Falló la instalación de Steam (paquete esencial del modo juego).${NC}"
        else
            msg "${CYAN_NEON}[OK] Pacotes oficiais de jogos processados.${NC}" \
                "${CYAN_NEON}[OK] Official gaming packages processed.${NC}" \
                "${CYAN_NEON}[OK] Paquetes oficiales de juegos procesados.${NC}"
        fi
        if ((${#gm_inst[@]})); then
