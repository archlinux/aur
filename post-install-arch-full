VERIFICAR_CONECTIVIDADE() {
    local TEXTO_NET="ESTABLISHING UPLINK: CHECKING SECTOR NETWORK"
    : "${LARGURA_BOX:=60}" # Fallback de segurança caso a largura não esteja definida
    local TAM_TEXTO=${#TEXTO_NET}
    local ESPACOS=$((LARGURA_BOX - TAM_TEXTO - 2))
    local MIRROR_ALVO
    local TARGET_1
    local TARGET_2="archlinux.org"
    local PING_RES
    local LATENCY

    msg "${CYAN_NEON}Verificando conectividade de rede...${NC}" \
        "${CYAN_NEON}Checking network connectivity...${NC}" \
        "${CYAN_NEON}Verificando la conectividad de red...${NC}"
    echo ""
   
    echo -e "${NEON_BLUE}╔$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╗${NC}"
    printf "${NEON_BLUE}║${NC}${YELLOW_NEON}%s%*s${NC}${NEON_BLUE}║${NC}\n" "$TEXTO_NET" "$ESPACOS" ""
    echo -e "${NEON_BLUE}╚$(printf '═%.0s' $(seq 1 $((LARGURA_BOX-2))))╝${NC}"
    
    echo ""
    msg "Isso pode levar alguns segundos dependendo da sua conexão. Por favor, aguarde..." \
        "This may take a few seconds depending on your connection. Please wait..." \
        "Esto puede tardar unos segundos dependiendo de su conexión. Por favor, espere..."
    echo ""

    # Extrai o primeiro mirror ativo da lista do usuário // Extracts the first active mirror from the user's list
    MIRROR_ALVO=$(sed -nE '/^[[:space:]]*Server[[:space:]]*=/ { s|.*https?://([^/:]*).*|\1|p; q }' /etc/pacman.d/mirrorlist)
    TARGET_1=${MIRROR_ALVO:-"archlinux.org"} # Se a lista estiver vazia por algum bug, assume o oficial // If the list is empty due to some bug, defaults to the official site

    # TENTATIVA 1: Testa a rota do Mirror local // ATTEMPT 1: Tests the route of the local Mirror
    if PING_RES=$(ping -c 3 -W 13 "$TARGET_1" 2>/dev/null); then
        LATENCY=$(echo "$PING_RES" | awk -F'/' '/^rtt/ {print $5}')
        LATENCY=${LATENCY:-0.00}
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${GREEN_NEON}[SUCESSO] CONEXÃO OK (Mirror) | LATÊNCIA: ${LATENCY}ms${NC}" \
            "${GREEN_NEON}[SUCCESS] CONNECTION OK (Mirror) | LATENCY: ${LATENCY}ms${NC}" \
            "${GREEN_NEON}[ÉXITO] CONEXIÓN OK (Mirror) | LATENCIA: ${LATENCY}ms${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"

    # TENTATIVA 2: Se o Mirror falhar, tenta o site oficial do Arch // ATTEMPT 2: If the Mirror fails, tries the official Arch site
    elif PING_RES=$(ping -c 3 -W 13 "$TARGET_2" 2>/dev/null); then
        LATENCY=$(echo "$PING_RES" | awk -F'/' '/^rtt/ {print $5}')
        LATENCY=${LATENCY:-0.00}
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${GREEN_NEON}[SUCESSO] CONEXÃO OK (Arch.org) | LATÊNCIA: ${LATENCY}ms${NC}" \
            "${GREEN_NEON}[SUCCESS] CONNECTION OK (Arch.org) | LATENCY: ${LATENCY}ms${NC}" \
            "${GREEN_NEON}[ÉXITO] CONEXIÓN OK (Arch.org) | LATENCIA: ${LATENCY}ms${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"

    # FALHA TOTAL: Sem internet ou rotas caídas // TOTAL FAILURE: No internet or down routes
    else
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${RED_NEON}[ERRO] SEM CONEXÃO COM A INTERNET${NC}" \
            "${RED_NEON}[ERROR] NO INTERNET CONNECTION${NC}" \
            "${RED_NEON}[ERROR] SIN CONEXIÓN A INTERNET${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"    
        echo ""
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${YELLOW_NEON}[!] Nenhuma conexão com a internet disponível, protocolo abortado.${NC}" \
            "${YELLOW_NEON}[!] Sentinel Protocol aborted. Please check your network connection.${NC}" \
            "${YELLOW_NEON}[!] Protocolo Sentinel abortado. Por favor, compruebe su conexión de red.${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        exit 1
    fi
}

QUEBRAR_TEXTO() {
    # Quebra $2 em linhas de no máximo $1 caracteres, sem cortar palavras (uma linha por saída)
    local largura="$1" texto="$2" linha="" palavra
    local -a palavras
    read -ra palavras <<< "$texto"
    for palavra in "${palavras[@]}"; do
        if [ -z "$linha" ]; then
            linha="$palavra"
        elif [ $(( ${#linha} + 1 + ${#palavra} )) -le "$largura" ]; then
            linha+=" $palavra"
        else
            printf '%s\n' "$linha"
            linha="$palavra"
        fi
    done
    printf '%s\n' "$linha"
}

BOX_ERROR() {
    local LARGURA=${LARGURA_BOX:-86}
    local INTERNO=$((LARGURA - 4))
    local LINHA SUB_LINHA PAD

    echo -e "\n${RED_NEON}╔$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╗${NC}"

    for LINHA in "$@"; do
        while IFS= read -r SUB_LINHA; do
            PAD=$(( INTERNO - ${#SUB_LINHA} ))
            [ "$PAD" -lt 0 ] && PAD=0
            printf "${RED_NEON}║${NC} ${YELLOW_NEON}%s%*s${NC} ${RED_NEON}║${NC}\n" "$SUB_LINHA" "$PAD" ""
        done < <(QUEBRAR_TEXTO "$INTERNO" "$LINHA")
    done

    echo -e "${RED_NEON}╚$(printf '═%.0s' $(seq 1 $((LARGURA-2))))╝${NC}"
}

