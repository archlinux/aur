                "${RED_NEON}[ERROR] Error al descargar el paquete de fondos de pantalla del repositorio. Verifica tu conexión a internet.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        echo ""

        if ! unzip -tq "$zip_temp" &>/dev/null; then
            rm -f "$zip_temp"
            msg "${RED_NEON}[ERRO] O arquivo baixado está corrompido ou incompleto.${NC}" \
                "${RED_NEON}[ERROR] The downloaded file is corrupted or incomplete.${NC}" \
                "${RED_NEON}[ERROR] El archivo descargado está dañado o incompleto.${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            return 1
        fi
        zip_usar="$zip_temp"
    fi

  
    msg "${CYAN_NEON}Instalando wallpapers personalizados em: $target_folder${NC}" \
        "${CYAN_NEON}Installing custom wallpapers at: $target_folder${NC}" \
        "${CYAN_NEON}Instalando fondos de pantalla personalizados en: $target_folder${NC}"
