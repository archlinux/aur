    _hk_linha_pkg() {
        local p="$1" st="$2" repo="$3"
        case "$st" in
            instalado)
                msg "  ${GREEN_NEON}[já instalado]${NC}  $p" "  ${GREEN_NEON}[already installed]${NC}  $p" "  ${GREEN_NEON}[ya instalado]${NC}  $p" ;;
            disponivel)
                msg "  ${CYAN_NEON}[disponível: ${repo:-?}]${NC}  $p" "  ${CYAN_NEON}[available: ${repo:-?}]${NC}  $p" "  ${CYAN_NEON}[disponible: ${repo:-?}]${NC}  $p" ;;
            indisponivel)
                msg "  ${YELLOW_NEON}[indisponível]${NC}  $p" "  ${YELLOW_NEON}[unavailable]${NC}  $p" "  ${YELLOW_NEON}[no disponible]${NC}  $p" ;;
            *)
                msg "  ${RED_NEON}[falha na consulta]${NC}  $p" "  ${RED_NEON}[query failed]${NC}  $p" "  ${RED_NEON}[fallo de consulta]${NC}  $p" ;;
