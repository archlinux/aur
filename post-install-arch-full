        echo ""
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}Detalhamento das partições e espaço total do sistema:${NC}" \
            "${CYAN_NEON}System partitions and total storage details:${NC}" \
            "${CYAN_NEON}Detalles de las particiones y espacio total del sistema:${NC}"
        echo ""
        
