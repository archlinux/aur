#===============================================================
# DEFINIÇÃO DE CORES ANSI PARA O TERMINAL
#===============================================================
NC="\033[0m"
CYAN_NEON="\033[1;36m"
GREEN_NEON="\033[1;32m"
YELLOW_NEON="\033[1;33m"
NEON_BLUE="\033[1;34m"
WHITE_NEON='\033[1;97m'

# ==============================================================================
# PALETA DE CORES E GRADIENTE (RGB TRUE COLOR)
# ==============================================================================
GRAD_1="\e[38;2;0;220;255m"   # Neon Blue
GRAD_2="\e[38;2;80;185;255m"  # Azul Claro
GRAD_3="\e[38;2;130;160;250m" # Azul Lavanda
GRAD_4="\e[38;2;170;135;245m" # Roxo Suave
GRAD_5="\e[38;2;190;120;235m" # Roxo Pastel
GRAD_6="\e[38;2;160;100;210m" # Roxo Atenuado

