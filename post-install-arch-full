    T_GRP[re]="blackarch-reversing blackarch-binary blackarch-malware"
    T_GRP[code]="blackarch-code-audit"

    # --------------------------------------------------------------------------
    # Auxiliares de mensagem (sempre msg com 3 idiomas, cor sempre fechada)
    # --------------------------------------------------------------------------
    _hk_i() { msg "${CYAN_NEON}$1${NC}" "${CYAN_NEON}$2${NC}" "${CYAN_NEON}$3${NC}"; }
    _hk_ok() { msg "${GREEN_NEON}[OK] $1${NC}" "${GREEN_NEON}[OK] $2${NC}" "${GREEN_NEON}[OK] $3${NC}"; }
    _hk_w() { msg "${YELLOW_NEON}[AVISO] $1${NC}" "${YELLOW_NEON}[WARNING] $2${NC}" "${YELLOW_NEON}[AVISO] $3${NC}"; }
    _hk_e() { msg "${RED_NEON}[ERRO] $1${NC}" "${RED_NEON}[ERROR] $2${NC}" "${RED_NEON}[ERROR] $3${NC}"; }
    _hk_n() { msg "${YELLOW_NEON}[NOTA] $1${NC}" "${YELLOW_NEON}[NOTE] $2${NC}" "${YELLOW_NEON}[NOTA] $3${NC}"; }

    # Texto digitado pelo usuário nunca vai cru para o msg (echo -e interpreta \).
    _hk_safe() {
        SAFE="${1//[^[:alnum:]._+@-]/?}"
        SAFE="${SAFE:0:40}"
    }

    # Lê uma linha em $1. EOF => abortar=1 e retorno 1.
    _hk_ler() {
        IFS= read -r -p ">> " "$1" && return 0
        abortar=1
        return 1
    }

    _hk_recusada() {
        _hk_w "Instalação recusada." "Installation declined." "Instalación rechazada."
    }

    _hk_msg_est() {
        msg "${CYAN_NEON}Tamanho instalado estimado: ~$1 MiB${NC}" \
            "${CYAN_NEON}Estimated installed size: ~$1 MiB${NC}" \
            "${CYAN_NEON}Tamaño instalado estimado: ~$1 MiB${NC}"
    }

    _hk_trim() {
        local s="$1"
        s="${s#"${s%%[![:space:]]*}"}"
        TRIM="${s%"${s##*[![:space:]]}"}"
    }

    # Adiciona sem duplicar (a lista é passada por nome).
    _hk_add() {
        local -n _lista="$1"
        [[ " ${_lista[*]} " == *" $2 "* ]] || _lista+=("$2")
    }

    # Registro da sessão: data/hora, ação e resultado (sem dados sensíveis).
    _hk_reg() {
        local t=""
        printf -v t '%(%H:%M:%S)T' -1
        REGISTRO+=("$t | $1 | $2")
    }

    # Pergunta s/n. 0 = sim; 1 = não OU entrada encerrada (abortar=1 em EOF).
    _hk_sn() {
        local r=""
        while true; do
            msg "${YELLOW_NEON}$1 (s/n)${NC}" "${YELLOW_NEON}$2 (y/n)${NC}" "${YELLOW_NEON}$3 (s/n)${NC}"
            _hk_ler r || return 1
            _hk_trim "${r,,}"
            if [[ "$TRIM" =~ ^(s|sim|y|yes|si|sí)$ ]]; then
                return 0
            elif [[ "$TRIM" =~ ^(n|nao|não|no)$ ]]; then
                return 1
            else
                _hk_e "Resposta inválida! Digite s ou n." \
                      "Invalid answer! Type y or n." \
                      "¡Respuesta inválida! Escriba s o n."
                sleep 1
            fi
        done
    }

    _hk_carregar_inst() {
        local p="" lista=""
        INST=()
        lista=$(pacman -Qq 2>/dev/null) || return 1
        while IFS= read -r p; do
            [[ -n "$p" ]] && INST[$p]=1
        done <<< "$lista"
        return 0
    }

    _hk_parse_si() {
        local linha="" repo="" nome="" val="" num="" un="" v=0 alvo=""
        while IFS= read -r linha; do
            if [[ "$linha" == Repository*:* ]]; then
                repo="${linha#*: }"
                repo="${repo%% *}"
            elif [[ "$linha" == Name*:* ]]; then
                nome="${linha#*: }"
                nome="${nome%% *}"
                CLS_MAP[$nome]="disponivel"
                REPO_MAP[$nome]="$repo"
                SZ_MAP[$nome]=-1
            elif [[ "$linha" == "Installed Size"*:* ]]; then
                val="${linha#*: }"
                num="${val%% *}"
                un="${val##* }"
                if [[ -n "$nome" && "$num" =~ ^[0-9]+\.[0-9]{2}$ ]]; then
                    v="${num/./}"
                    v=$((10#$v))
                    case "$un" in
                        MiB) ;;
                        KiB) v=$((v / 1024)) ;;
                        GiB) v=$((v * 1024)) ;;
                        B)   v=$((v / 1048576)) ;;
                        *)   v=-100 ;;
                    esac
                    if (( v >= 0 )); then SZ_MAP[$nome]=$(( (v + 99) / 100 )); fi
                fi
            elif [[ "$linha" == error:* ]]; then
                if [[ "$linha" == *"was not found"* || "$linha" == *"target not found"* ]]; then
                    if [[ "$linha" == *"'"* ]]; then
                        alvo="${linha#*\'}"
                        alvo="${alvo%%\'*}"
                    else
                        alvo="${linha##*: }"
                    fi
                    CLS_MAP[$alvo]="indisponivel"
                fi
            fi
        done
    }

    _hk_classificar_lote() {
        local p="" out="" prc=0 sat=""
        local -a consulta=() indisp=()
        CLS_MAP=() REPO_MAP=() SZ_MAP=()
        if ! _hk_carregar_inst; then
            for p in "$@"; do CLS_MAP[$p]="erro"; done
            return 1
        fi
        for p in "$@"; do
            if [[ ! "$p" =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
                CLS_MAP[$p]="indisponivel"
            elif [[ -n "${INST[$p]:-}" ]]; then
                CLS_MAP[$p]="instalado"
            else
                consulta+=("$p")
            fi
        done
        (( ${#consulta[@]} > 0 )) || return 0
        out=$(LC_ALL=C pacman -Si -- "${consulta[@]}" 2>&1)
        _hk_parse_si <<< "$out"
        for p in "${consulta[@]}"; do
            if [[ -z "${CLS_MAP[$p]:-}" ]]; then
                CLS_MAP[$p]="erro"
            elif [[ "${CLS_MAP[$p]}" == "indisponivel" ]]; then
                indisp+=("$p")
            fi
        done
        if (( ${#indisp[@]} > 0 )); then
            sat=$(pacman -T -- "${indisp[@]}" 2>/dev/null)
            prc=$?
            if (( prc == 0 || prc == 127 )); then
                sat=$'\n'"$sat"$'\n'
                for p in "${indisp[@]}"; do
                    [[ "$sat" == *$'\n'"$p"$'\n'* ]] || CLS_MAP[$p]="instalado"
                done
            fi
        fi
        return 0
    }

    _hk_resolver() {
        local cand="" c=""
        local -a alts=()
        IFS='|' read -r -a alts <<< "$1"
        CLS="indisponivel"
        for cand in "${alts[@]}"; do
            c="${CLS_MAP[$cand]:-erro}"
            if [[ "$c" == "instalado" || "$c" == "disponivel" ]]; then
                ALT="$cand"
                CLS="$c"
                CLS_REPO="${REPO_MAP[$cand]:-}"
                return 0
            fi
            [[ "$c" == "erro" ]] && CLS="erro"
        done
        ALT="${alts[0]}"
        CLS_REPO=""
        return 0
    }

    #
    _hk_soma_sz() {
        local p="" v=0
        EST_MB=0
        for p in "$@"; do
            v="${SZ_MAP[$p]:--1}"
            (( v >= 0 )) || return 1
            EST_MB=$((EST_MB + v))
        done
        return 0
    }

    _hk_membros() {
        local out="" rc=0 a="" b=""
        local -A vistos=()
        membros=()
        out=$(LC_ALL=C pacman -Sg -- "$1" 2>&1)
        rc=$?
        if (( rc != 0 )); then
            if [[ "$out" == *"was not found"* || "$out" == *"target not found"* ]]; then
                return 1
            fi
            return 2
        fi
        while read -r a b; do
            if [[ "$a" == "$1" && -n "$b" && -z "${vistos[$b]:-}" ]]; then
                vistos[$b]=1
                membros+=("$b")
            fi
        done <<< "$out"
        (( ${#membros[@]} > 0 )) || return 1
        return 0
    }

    
    _hk_estimar_mb() {
        local -a todos=("$@")
        local i=0 out=""
        EST_MB=0
        (( ${#todos[@]} > 0 )) || return 1
        CLS_MAP=() REPO_MAP=() SZ_MAP=()
        for (( i = 0; i < ${#todos[@]}; i += 150 )); do
            out=$(LC_ALL=C pacman -Si -- "${todos[@]:i:150}" 2>/dev/null) || return 1
            _hk_parse_si <<< "$out"
        done
        _hk_soma_sz "${todos[@]}"
    }

    # Espaço livre (MiB) no menor entre / e o cache do pacman.
    _hk_livre_mb() {
        local av=""
        LIVRE_MB=-1
        while read -r _ _ _ av _; do
            [[ "$av" =~ ^[0-9]+$ ]] || continue
            if (( LIVRE_MB < 0 || av < LIVRE_MB )); then LIVRE_MB="$av"; fi
        done < <(df -Pm / /var/cache/pacman/pkg 2>/dev/null)
        (( LIVRE_MB >= 0 ))
    }

    # Bloqueia a operação se não houver espaço (não começa para descobrir no meio).
    _hk_checar_espaco() {
        local nec="$1"
        if ! _hk_livre_mb; then
            _hk_e "Não foi possível medir o espaço livre em disco. Operação bloqueada por segurança." \
                  "Could not measure the free disk space. Operation blocked for safety." \
                  "No se pudo medir el espacio libre en disco. Operación bloqueada por seguridad."
            return 1
        fi
        if (( LIVRE_MB < nec )); then
            _hk_e "Espaço insuficiente: necessário ~${nec} MiB, livre ${LIVRE_MB} MiB." \
                  "Insufficient space: ~${nec} MiB required, ${LIVRE_MB} MiB free." \
                  "Espacio insuficiente: se necesitan ~${nec} MiB, libres ${LIVRE_MB} MiB."
            return 1
        fi
        _hk_ok "Espaço verificado: ~${nec} MiB necessários, ${LIVRE_MB} MiB livres." \
               "Space verified: ~${nec} MiB required, ${LIVRE_MB} MiB free." \
               "Espacio verificado: ~${nec} MiB necesarios, ${LIVRE_MB} MiB libres."
        return 0
    }

    # Espera um pacman legítimo terminar; NUNCA remove a trava nem mata processo.
    _hk_trava() {
        local espera=0
        while [[ -e "$pacman_lock" ]] && pgrep -x pacman &>/dev/null && (( espera < 30 )); do
            if (( espera == 0 )); then
                _hk_w "Há outro pacman em execução. Aguardando ele terminar..." \
                      "Another pacman is running. Waiting for it to finish..." \
                      "Hay otro pacman en ejecución. Esperando a que termine..."
            fi
            sleep 2
            espera=$((espera + 1))
        done
        if [[ -e "$pacman_lock" ]]; then
            _hk_e "O banco do pacman está travado ($pacman_lock). Nada foi removido. Se nenhum pacman estiver rodando, remova a trava manualmente e tente de novo." \
                  "The pacman database is locked ($pacman_lock). Nothing was removed. If no pacman is running, remove the lock manually and try again." \
                  "La base de datos de pacman está bloqueada ($pacman_lock). No se eliminó nada. Si no hay ningún pacman en ejecución, elimine el bloqueo manualmente e inténtelo de nuevo."
            return 1
        fi
        return 0
    }

    # Condições comuns antes de QUALQUER instalação.
    _hk_pre() {
        local pend="" prc=0 npend=0 l=""
        _hk_ferramentas || return 1
       
        _hk_repo_estado
        if [[ "$repo_estado" != "ausente" && "$repo_estado" != "funcional" ]]; then
            _hk_estado_txt
            _hk_e "Instalação bloqueada: corrija a configuração do BlackArch (opção 1 ou manualmente) e tente de novo." \
                  "Installation blocked: fix the BlackArch configuration (option 1 or manually) and try again." \
                  "Instalación bloqueada: corrija la configuración de BlackArch (opción 1 o manualmente) e inténtelo de nuevo."
            return 1
        fi
        if ! compgen -G "$pacman_sync/*.db" >/dev/null; then
            _hk_e "Nenhuma base do pacman está sincronizada. Atualize o sistema (pacman -Syu) antes." \
                  "No pacman database is synchronized. Update the system (pacman -Syu) first." \
                  "Ninguna base de datos de pacman está sincronizada. Actualice el sistema (pacman -Syu) antes."
            return 1
        fi
        _hk_trava || return 1
        if (( sync_pendente )); then
            _hk_w "O BlackArch acabou de ser habilitado e o sistema ainda NÃO foi atualizado. Instalar agora causaria atualização parcial (não suportada pelo Arch)." \
                  "BlackArch was just enabled and the system has NOT been updated yet. Installing now would cause a partial upgrade (unsupported by Arch)." \
                  "BlackArch se acaba de habilitar y el sistema AÚN NO se actualizó. Instalar ahora causaría una actualización parcial (no soportada por Arch)."
            _hk_exigir_syu || return 1
        fi
      
        pend=$(LC_ALL=C pacman -Qu 2>&1)
        prc=$?
        if (( prc != 0 )) && [[ "$pend" == *"error:"* ]]; then
            _hk_e "A consulta de atualizações pendentes falhou; por segurança a instalação foi interrompida." \
                  "The pending-updates query failed; installation was stopped for safety." \
                  "Falló la consulta de actualizaciones pendientes; la instalación se detuvo por seguridad."
            _hk_add CONSULTA_FALHOU "pacman-Qu"
            return 1
        fi
        while IFS= read -r l; do
            [[ "$l" == *" -> "* ]] && npend=$((npend + 1))
        done <<< "$pend"
        if (( npend > 0 )); then
            _hk_w "Há ${npend} pacote(s) com atualização disponível. Para evitar atualização parcial, conclua o pacman -Syu antes de instalar ferramentas." \
                  "${npend} package(s) have updates available. To avoid a partial upgrade, finish pacman -Syu before installing tools." \
                  "Hay ${npend} paquete(s) con actualización disponible. Para evitar una actualización parcial, complete pacman -Syu antes de instalar herramientas."
            _hk_exigir_syu || return 1
        fi
        return 0
    }

    _hk_sn_syu() {
        _hk_sn "Executar a atualização completa (pacman -Syu) agora?" \
               "Run the full system update (pacman -Syu) now?" \
               "¿Ejecutar la actualización completa (pacman -Syu) ahora?"
    }

    # Oferece o -Syu; recusar adia a instalação (retorno 1).
    _hk_exigir_syu() {
        if ! _hk_sn_syu; then
            _hk_w "Instalação adiada: atualize o sistema primeiro." \
                  "Installation postponed: update the system first." \
                  "Instalación aplazada: actualice el sistema primero."
            return 1
        fi
        _hk_atualizar
    }

    _hk_atualizar() {
        _hk_i "Executando: pacman -Syu (acompanhe a lista de pacotes e confirme)..." \
              "Running: pacman -Syu (review the package list and confirm)..." \
              "Ejecutando: pacman -Syu (revise la lista de paquetes y confirme)..."
        if "${SUDO[@]}" pacman -Syu; then
            sync_pendente=0
            _hk_reg "pacman -Syu" "OK"
            _hk_ok "Sistema sincronizado e atualizado." \
                   "System synchronized and updated." \
                   "Sistema sincronizado y actualizado."
            return 0
        fi
        _hk_reg "pacman -Syu" "FALHOU"
        _hk_e "A atualização completa falhou ou foi recusada. Nenhuma instalação será feita enquanto o sistema não estiver atualizado." \
              "The full update failed or was declined. Nothing will be installed until the system is up to date." \
              "La actualización completa falló o fue rechazada. No se instalará nada hasta que el sistema esté actualizado."
        return 1
    }

    _hk_so() {
        local os_id="" os_like="" arq="" k="" v=""
        so_ok=1
        so_artix=0
        if [[ -r /etc/os-release ]]; then
            while IFS='=' read -r k v; do
                v="${v//\"/}"
                v="${v//\'/}"
                if [[ "$k" == "ID" ]]; then
                    os_id="${v,,}"
                elif [[ "$k" == "ID_LIKE" ]]; then
                    os_like="${v,,}"
                fi
            done < /etc/os-release
        fi
        arq="${HOSTTYPE:-}"
        [[ -n "$arq" ]] || arq=$(uname -m 2>/dev/null)
        case "$os_id" in
            arch|archarm) ;;
            manjaro) so_ok=0 ;;
            artix) so_artix=1 ;;
            *) [[ " $os_like " == *" arch "* ]] || so_ok=0 ;;
        esac
        if [[ "$arq" != "x86_64" && "$arq" != "aarch64" ]]; then so_ok=0; fi
        msg "${CYAN_NEON}Sistema: ${os_id:-?} (${os_like:--}) | Arquitetura: ${arq:-?}${NC}" \
            "${CYAN_NEON}System: ${os_id:-?} (${os_like:--}) | Architecture: ${arq:-?}${NC}" \
            "${CYAN_NEON}Sistema: ${os_id:-?} (${os_like:--}) | Arquitectura: ${arq:-?}${NC}"
        if (( ! so_ok )); then
            _hk_e "Sistema não compatível com o BlackArch (é preciso Arch Linux ou derivado direto, em x86_64/aarch64; Manjaro não é suportado)." \
                  "System not compatible with BlackArch (Arch Linux or a direct derivative on x86_64/aarch64 is required; Manjaro is unsupported)." \
                  "Sistema no compatible con BlackArch (se requiere Arch Linux o un derivado directo en x86_64/aarch64; Manjaro no está soportado)."
            return 1
        fi
        if (( so_artix )); then
            _hk_w "Artix detectado: o BlackArch é projetado para Arch Linux; o uso aqui não é oficialmente suportado." \
                  "Artix detected: BlackArch is designed for Arch Linux; usage here is not officially supported." \
                  "Artix detectado: BlackArch está diseñado para Arch Linux; su uso aquí no está soportado oficialmente."
        fi
        return 0
    }

    _hk_ferramentas() {
        local t="" falta="" lista="awk sort df pgrep"
        [[ "${1:-}" == "repo" ]] && lista+=" curl sha1sum mktemp install stat"
        for t in $lista; do
            command -v "$t" &>/dev/null || falta+="$t "
        done
        if [[ -n "$falta" ]]; then
            _hk_e "Ferramentas necessárias ausentes: $falta" \
                  "Required tools are missing: $falta" \
                  "Faltan herramientas necesarias: $falta"
            return 1
        fi
        return 0
    }

    # Distingue DNS, conexão, TLS e tempo esgotado.
    _hk_rede() {
        local rc=0
        curl -fsS --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 10 --max-time 20 -o /dev/null "$downloads_url" 2>/dev/null
        rc=$?
        case "$rc" in
            0) return 0 ;;
            6)
                _hk_e "Falha de DNS: não foi possível resolver blackarch.org." \
                      "DNS failure: could not resolve blackarch.org." \
                      "Fallo de DNS: no se pudo resolver blackarch.org."
                ;;
            7|35|51|58|60)
                _hk_e "Falha de conexão/TLS com blackarch.org (curl código $rc)." \
                      "Connection/TLS failure reaching blackarch.org (curl code $rc)." \
                      "Fallo de conexión/TLS con blackarch.org (código curl $rc)."
                ;;
            28)
                _hk_e "Tempo esgotado ao contatar blackarch.org." \
                      "Timed out contacting blackarch.org." \
                      "Tiempo agotado al contactar blackarch.org."
                ;;
            *)
                _hk_e "Sem acesso ao site do BlackArch (curl código $rc)." \
                      "No access to the BlackArch site (curl code $rc)." \
                      "Sin acceso al sitio de BlackArch (código curl $rc)."
                ;;
        esac
        return 1
    }

    _hk_repo_estado() {
        local info="" rest="" n=0 l="" achou=0 out=""
        repo_estado="ausente"
        repo_include=""
        if [[ ! -r /etc/pacman.conf ]]; then
            repo_estado="config-invalida"
            return 2
        fi
        info=$(awk '
            /^[[:space:]]*#/ {next}
            /^[[:space:]]*\[/ {
                sec = $0; gsub(/[[:space:]]/, "", sec); gsub(/\[|\]/, "", sec)
                if (sec == "blackarch") n++
                next
            }
            /^[[:space:]]*SigLevel[[:space:]]*=/ {
                if (sec == "options") g = g " " tolower($0)
                else if (sec == "blackarch") r = r " " tolower($0)
            }
            sec == "blackarch" && n == 1 && inc == "" && /^[[:space:]]*Include[[:space:]]*=/ {
                x = $0; sub(/^[^=]*=[[:space:]]*/, "", x); sub(/[[:space:]]+#.*/, "", x); gsub(/^[[:space:]]+|[[:space:]]+$/, "", x); inc = x
            }
            END {
                a = (r != "") ? r : g; ok = "ok"
                if (a != "" && (a ~ /(^|[ \t=])(never|trustall|optional)([ \t]|$)/ || a !~ /required/)) ok = "bad"
                print ok "|" n + 0 "|" inc
            }' /etc/pacman.conf 2>/dev/null)
        if [[ "${info%%|*}" != "ok" ]]; then
            repo_estado="assinatura-insegura"
            return 2
        fi
        rest="${info#*|}"
        n="${rest%%|*}"
        repo_include="${rest#*|}"
        [[ "$n" =~ ^[0-9]+$ ]] || n=0
        if (( n == 0 )); then
            # Definida fora do pacman.conf (ex.: arquivo incluído)? Não é "ausente".
            if command -v pacman-conf &>/dev/null; then
                out=$(pacman-conf --repo-list 2>/dev/null)
                if [[ $'\n'"$out"$'\n' == *$'\n'blackarch$'\n'* ]]; then
                    repo_estado="config-externa"
                    return 2
                fi
            fi
            return 1
        fi
        if (( n > 1 )); then
            repo_estado="duplicada"
            return 2
        fi
        if [[ -z "$repo_include" ]]; then
            repo_estado="config-parcial"
            return 2
        fi
        if [[ "$repo_include" == /* && -r "$repo_include" ]]; then
            while IFS= read -r l; do
                if [[ "$l" =~ ^[[:space:]]*Server[[:space:]]*=[[:space:]]*https:// ]]; then
                    achou=1
                    break
                fi
            done < "$repo_include"
        fi
        if (( ! achou )); then
            repo_estado="mirrorlist-parcial"
            return 2
        fi
        if ! pacman -Q blackarch-keyring &>/dev/null; then
            repo_estado="keyring-ausente"
            return 2
        fi
        l=""
        read -r l < <(pacman -Sl blackarch 2>/dev/null)
        if [[ -z "$l" ]]; then
            repo_estado="precisa-sync"
            return 2
        fi
        repo_estado="funcional"
        return 0
    }

    
    _hk_estado_txt() {
        case "$repo_estado" in
            funcional)
                _hk_ok "BlackArch: FUNCIONAL (seção, mirrorlist HTTPS, keyring e banco sincronizado)." \
                       "BlackArch: HEALTHY (section, HTTPS mirrorlist, keyring and synchronized database)." \
                       "BlackArch: FUNCIONAL (sección, mirrorlist HTTPS, keyring y base sincronizada)." ;;
