    # Kernels instalados (pkgbase de /usr/lib/modules/*/pkgbase) em dv_kern; padrão: linux
    _dv_kern() {
        local f="" k=""
        dv_kern=()
        for f in /usr/lib/modules/*/pkgbase; do
            [[ -r $f ]] || continue
            IFS= read -r k < "$f" || :
            [[ $k =~ ^[a-z0-9._+-]+$ && " ${dv_kern[*]} " != *" $k "* ]] && dv_kern+=("$k")
        done
        if ((${#dv_kern[@]} == 0)); then
            for k in linux linux-lts linux-zen linux-hardened; do
                [[ $dv_in == *$'\n'"$k"$'\n'* ]] && dv_kern+=("$k")
            done
        fi
        ((${#dv_kern[@]})) || dv_kern=(linux)
    }

    # Fim (normal ou por Ctrl+C/TERM): para o keep-alive, limpa o temporário, restaura os traps, remove os ajudantes
    _dv_fim() {
        local s="$dv_sig"
        if [[ -n $s ]]; then
            echo ""
            msg "${YELLOW_NEON}[AVISO] MODO DEV interrompido. Limpando temporários...${NC}" \
                "${YELLOW_NEON}[WARNING] DEV MODE interrupted. Cleaning up temporary files...${NC}" \
                "${YELLOW_NEON}[AVISO] MODO DEV interrumpido. Limpiando archivos temporales...${NC}"
        fi
        if [[ -n $dv_ka ]]; then kill "$dv_ka" 2>/dev/null || :; dv_ka=""; fi
        if [[ $dv_tmp == "${dv_tb%/}"/odin-dev-yay.* && -d $dv_tmp ]]; then rm -rf -- "${dv_tmp:?}"; fi
        dv_tmp=""
        if ((dv_ts)); then
            eval "${dv_oi:-trap - INT}"; eval "${dv_ot:-trap - TERM}"
            dv_ts=0
        fi
        unset -f _dv_ln _dv_hdr _dv_skip _dv_av _dv_ask _dv_trim _dv_safe _dv_qq _dv_prime _dv_grp _dv_cls _dv_ok _dv_ja \
            _dv_triar _dv_lote _dv_conf _dv_edid _dv_yay _dv_run _dv_cmd _dv_val _dv_lin _dv_kas _dv_grupo _dv_svc \
            _dv_rede _dv_hw _dv_kern _dv_main _dv_fim
        [[ -n $s ]] || return 0
        kill -s "$s" $$
        [[ $s == INT ]] && exit 130
        exit 143
    }

