    # --------------------------------------------------------------------------
    # Habilitar BlackArch (strap.sh oficial, com verificação de integridade)
    # --------------------------------------------------------------------------
    _hk_limpar_tmp() {
        if [[ -n "$tmp_user" && -d "$tmp_user" && "$tmp_user" == "${tmp_base%/}"/odin-hk.* ]]; then
            rm -rf -- "${tmp_user:?}"
        fi
        tmp_user=""
        if [[ -n "$tmp_root" && "$tmp_root" == /var/tmp/odin-hk-root.* ]]; then
            "${SUDO[@]}" rm -rf -- "${tmp_root:?}" 2>/dev/null
        fi
        tmp_root=""
    }

    _hk_habilitar_blackarch() {
        local strap="" calc="" calc2="" first="" interp="sh" tam=0 rc=0 mirror_antes=0
        local mirror_path="/etc/pacman.d/blackarch-mirrorlist"

        _hk_i "[BlackArch] Verificando o ambiente e o estado do repositório..." \
              "[BlackArch] Checking the environment and the repository state..." \
              "[BlackArch] Verificando el entorno y el estado del repositorio..."
        _hk_ferramentas repo || return 1
        _hk_trava || return 1

        _hk_mostrar_repo
        case "$repo_estado" in
            funcional)
                _hk_ok "O repositório BlackArch já está configurado e funcional. Nada a fazer." \
                       "The BlackArch repository is already configured and functional. Nothing to do." \
                       "El repositorio BlackArch ya está configurado y funcional. Nada que hacer."
                _hk_add JA_INSTALADOS "repo-blackarch"
                _hk_reg "BlackArch" "já funcional"
                return 0
                ;;
            duplicada|config-invalida|assinatura-insegura|config-parcial|config-externa)
                _hk_e "O instalador oficial NÃO será executado sobre uma configuração ambígua/insegura. Corrija e tente de novo." \
                      "The official installer will NOT be run on top of an ambiguous/unsafe configuration. Fix it and retry." \
                      "El instalador oficial NO se ejecutará sobre una configuración ambigua/insegura. Corríjala e inténtelo de nuevo."
                _hk_reg "BlackArch" "bloqueado: $repo_estado"
                return 1
                ;;
            mirrorlist-parcial)
                if [[ "$repo_include" != "$mirror_path" ]]; then
                    _hk_e "O mirrorlist configurado é personalizado ($repo_include). Para preservá-lo, o módulo não o substitui. Corrija-o manualmente." \
                          "The configured mirrorlist is custom ($repo_include). To preserve it, the module will not replace it. Fix it manually." \
                          "El mirrorlist configurado es personalizado ($repo_include). Para preservarlo, el módulo no lo sustituye. Corríjalo manualmente."
                    _hk_reg "BlackArch" "mirrorlist personalizado"
                    return 1
                fi
                ;;
            precisa-sync)
                _hk_n "O repositório já está configurado: só falta sincronizar. Isto se resolve com a atualização completa, sem executar o strap.sh." \
                      "The repository is already configured: it only needs syncing. A full update fixes this, without running strap.sh." \
                      "El repositorio ya está configurado: solo falta sincronizar. Se resuelve con la actualización completa, sin ejecutar strap.sh."
                if _hk_sn_syu; then
                    _hk_trava && _hk_atualizar
                    _hk_repo_estado
                    [[ "$repo_estado" == "funcional" ]] && return 0
                fi
                return 1
                ;;
        esac

        _hk_rede || { _hk_reg "BlackArch" "sem rede"; return 1; }
        _hk_checar_espaco 2048 || return 1

        if ! _hk_sn "Baixar, verificar (SHA-1 fixado) e executar o instalador OFICIAL do BlackArch (strap.sh)? Ele altera /etc/pacman.conf, instala chaves e sincroniza os bancos. Se ele perguntar sobre 'pacman -Su', responda n: o Odin oferece o -Syu completo depois." \
                    "Download, verify (pinned SHA-1) and run the OFFICIAL BlackArch installer (strap.sh)? It edits /etc/pacman.conf, installs keys and syncs the databases. If it asks about 'pacman -Su', answer n: Odin offers the full -Syu afterwards." \
                    "¿Descargar, verificar (SHA-1 fijado) y ejecutar el instalador OFICIAL de BlackArch (strap.sh)? Modifica /etc/pacman.conf, instala claves y sincroniza las bases. Si pregunta por 'pacman -Su', responda n: Odin ofrece el -Syu completo después."; then
            _hk_w "Operação cancelada pelo usuário." \
                  "Operation cancelled by the user." \
                  "Operación cancelada por el usuario."
            _hk_reg "BlackArch" "cancelado"
            return 1
        fi

        tmp_user=$(mktemp -d "${tmp_base%/}/odin-hk.XXXXXX" 2>/dev/null) || tmp_user=""
        if [[ -z "$tmp_user" ]]; then
            _hk_e "Não foi possível criar o diretório temporário." \
                  "Could not create the temporary directory." \
                  "No se pudo crear el directorio temporal."
            return 1
        fi
        chmod 700 "$tmp_user" 2>/dev/null
        strap="$tmp_user/strap.sh"

        _hk_i "Baixando strap.sh por HTTPS..." \
              "Downloading strap.sh over HTTPS..." \
              "Descargando strap.sh por HTTPS..."
        if ! curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 2 --connect-timeout 15 --max-time 120 -o "$strap" "$strap_url"; then
            _hk_e "Falha no download do strap.sh. Nada foi executado." \
                  "strap.sh download failed. Nothing was executed." \
                  "Falló la descarga de strap.sh. No se ejecutó nada."
            _hk_reg "BlackArch" "download falhou"
            _hk_limpar_tmp
            return 1
        fi
        tam=$(stat -c '%s' "$strap" 2>/dev/null)
        [[ "$tam" =~ ^[0-9]+$ ]] || tam=0
        IFS= read -r first < "$strap" 2>/dev/null
        if (( tam < 100 || tam > 500000 )) || [[ "$first" != '#!'* ]]; then
            _hk_e "O arquivo baixado não parece um script válido. Nada foi executado." \
                  "The downloaded file does not look like a valid script. Nothing was executed." \
                  "El archivo descargado no parece un script válido. No se ejecutó nada."
            _hk_reg "BlackArch" "arquivo inválido"
            _hk_limpar_tmp
            return 1
        fi
        [[ "$first" == *bash* ]] && interp="bash"

        calc=""
        read -r calc _ < <(sha1sum "$strap" 2>/dev/null)
        msg "${CYAN_NEON}SHA-1 do arquivo baixado : ${calc:-?}${NC}\n${CYAN_NEON}SHA-1 oficial fixado     : ${pinned_sha1}${NC}" \
            "${CYAN_NEON}Downloaded file SHA-1 : ${calc:-?}${NC}\n${CYAN_NEON}Pinned official SHA-1  : ${pinned_sha1}${NC}" \
            "${CYAN_NEON}SHA-1 del archivo     : ${calc:-?}${NC}\n${CYAN_NEON}SHA-1 oficial fijado  : ${pinned_sha1}${NC}"
        if [[ ! "$calc" =~ ^[0-9a-f]{40}$ ]]; then
            _hk_e "Não foi possível calcular o checksum. Nada foi executado." \
                  "Could not compute the checksum. Nothing was executed." \
                  "No se pudo calcular el checksum. No se ejecutó nada."
            _hk_limpar_tmp
            return 1
        fi
        if [[ "$calc" != "$pinned_sha1" ]]; then
            _hk_e "CHECKSUM INVÁLIDO: o strap.sh NÃO confere com o SHA-1 oficial fixado e NÃO foi executado. Se o BlackArch publicou uma nova versão, confira o hash em blackarch.org/downloads.html e atualize o valor fixado no módulo." \
                  "INVALID CHECKSUM: strap.sh does NOT match the pinned official SHA-1 and was NOT executed. If BlackArch published a new version, check the hash at blackarch.org/downloads.html and update the value pinned in the module." \
                  "CHECKSUM INVÁLIDO: strap.sh NO coincide con el SHA-1 oficial fijado y NO se ejecutó. Si BlackArch publicó una versión nueva, compruebe el hash en blackarch.org/downloads.html y actualice el valor fijado en el módulo."
            _hk_reg "BlackArch" "checksum inválido"
            _hk_limpar_tmp
            return 1
        fi
        _hk_ok "Checksum confere com o valor oficial fixado." \
               "Checksum matches the pinned official value." \
               "El checksum coincide con el valor oficial fijado."

        
        tmp_root=$("${SUDO[@]}" mktemp -d /var/tmp/odin-hk-root.XXXXXX 2>/dev/null) || tmp_root=""
        if [[ -z "$tmp_root" ]] \
            || ! "${SUDO[@]}" chmod 700 "$tmp_root" \
            || ! "${SUDO[@]}" install -m 0700 -o root -g root -- "$strap" "$tmp_root/strap.sh"; then
            _hk_e "Não foi possível preparar a cópia segura do instalador (privilégios)." \
                  "Could not prepare the secure copy of the installer (privileges)." \
                  "No se pudo preparar la copia segura del instalador (privilegios)."
            _hk_limpar_tmp
            return 1
        fi
        calc2=""
        read -r calc2 _ < <("${SUDO[@]}" sha1sum "$tmp_root/strap.sh" 2>/dev/null)
        if [[ "$calc2" != "$calc" ]]; then
            _hk_e "A cópia segura não confere com o arquivo verificado. Abortado." \
                  "The secure copy does not match the verified file. Aborted." \
                  "La copia segura no coincide con el archivo verificado. Abortado."
            _hk_limpar_tmp
            return 1
        fi
        if ! "${SUDO[@]}" cp -a -- /etc/pacman.conf "$tmp_root/pacman.conf.bak"; then
            _hk_e "Não foi possível salvar o backup de /etc/pacman.conf; execução bloqueada." \
                  "Could not back up /etc/pacman.conf; execution blocked." \
                  "No se pudo respaldar /etc/pacman.conf; ejecución bloqueada."
            _hk_limpar_tmp
            return 1
        fi
        if [[ -f "$mirror_path" ]] && "${SUDO[@]}" cp -a -- "$mirror_path" "$tmp_root/mirrorlist.bak"; then
            mirror_antes=1
        fi

        _hk_i "Executando o instalador oficial (ele é interativo: acompanhe e responda)..." \
              "Running the official installer (it is interactive: follow and answer)..." \
              "Ejecutando el instalador oficial (es interactivo: siga y responda)..."
        "${SUDO[@]}" "$interp" "$tmp_root/strap.sh"
        rc=$?
        if (( rc != 0 )); then
            "${SUDO[@]}" cp -a -- "$tmp_root/pacman.conf.bak" /etc/pacman.conf 2>/dev/null
            (( mirror_antes )) && "${SUDO[@]}" cp -a -- "$tmp_root/mirrorlist.bak" "$mirror_path" 2>/dev/null
            _hk_e "O instalador oficial terminou com erro (código $rc). /etc/pacman.conf e o mirrorlist anteriores foram restaurados quando possível; chaveiro/pacotes já alterados podem exigir verificação manual." \
                  "The official installer finished with an error (code $rc). The previous /etc/pacman.conf and mirrorlist were restored when possible; keyring/packages already changed may need manual checking." \
                  "El instalador oficial terminó con error (código $rc). Se restauraron /etc/pacman.conf y el mirrorlist anteriores cuando fue posible; el llavero/paquetes ya cambiados pueden requerir revisión manual."
            _hk_reg "strap.sh" "FALHOU rc=$rc (rollback da configuração)"
        else
            _hk_reg "strap.sh" "OK"
        fi
        _hk_limpar_tmp

        _hk_mostrar_repo
        if [[ "$repo_estado" == "funcional" ]]; then
            _hk_ok "Repositório BlackArch habilitado e validado." \
                   "BlackArch repository enabled and validated." \
                   "Repositorio BlackArch habilitado y validado."
            _hk_add INSTALADOS "repo-blackarch"
            sync_pendente=1
            _hk_n "O instalador sincroniza apenas os bancos. É NECESSÁRIO atualizar o sistema completo (pacman -Syu) antes de instalar ferramentas." \
                  "The installer only syncs the databases. A FULL system update (pacman -Syu) is REQUIRED before installing tools." \
                  "El instalador solo sincroniza las bases. Es NECESARIO actualizar el sistema completo (pacman -Syu) antes de instalar herramientas."
            if _hk_sn_syu; then
                _hk_trava && _hk_atualizar
            else
                _hk_w "Atualização pendente. As instalações ficam bloqueadas até você atualizar." \
                      "Update pending. Installations stay blocked until you update." \
                      "Actualización pendiente. Las instalaciones quedan bloqueadas hasta que actualice."
            fi
            return 0
        fi
        _hk_e "O repositório NÃO ficou funcional. Revise a saída do instalador acima; nada mais foi alterado." \
              "The repository did NOT become functional. Review the installer output above; nothing else was changed." \
              "El repositorio NO quedó funcional. Revise la salida del instalador arriba; no se cambió nada más."
        _hk_add FALHARAM "repo-blackarch"
        return 1
    }

