        inst=${inst//$'\n'/ }
        if [[ $kr == *zen* || $kr == *lts* || $inst == *" linux-zen "* || $inst == *" linux-lts "* ]]; then cust=1; fi

        _ot_ln
        msg "${CYAN_NEON}[GPU - NVIDIA] Configurando placa gráfica NVIDIA...${NC}" \
            "${CYAN_NEON}[GPU - NVIDIA] Configuring NVIDIA graphics card...${NC}" \
            "${CYAN_NEON}[GPU - NVIDIA] Configurando tarjeta gráfica NVIDIA...${NC}"
        _ot_ln
        echo ""

        if ((cust)); then
            _ot_ln 147
            msg "${YELLOW_NEON}[RECOMENDAÇÃO] Kernel Zen ou LTS detectado. O uso de pacotes DKMS é altamente recomendado para garantir a compilação correta dos módulos.${NC}" \
                "${YELLOW_NEON}[RECOMMENDATION] Zen or LTS kernel detected. Using DKMS packages is highly recommended to ensure correct module compilation.${NC}" \
                "${YELLOW_NEON}[RECOMENDACIÓN] Kernel Zen o LTS detectado. Se recomienda encarecidamente usar paquetes DKMS para garantizar la compilación.${NC}"
            _ot_ln 147
            echo ""
        fi

        while true; do
            _ot_ln
            msg "Qual versão do driver NVIDIA deseja instalar?" \
                "Which version of the NVIDIA driver do you want to install?" \
                "¿Qué versión del controlador NVIDIA desea instalar?"
            if ((cust)); then
