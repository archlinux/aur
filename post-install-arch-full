FUNCAO_AUR_HELPER() {
    local ah_yay=0 ah_paru=0 ah_tmp="" ah_sig="" ah_oi="" ah_ot="" ah_ts=0 ah_rc=0

    # Linha decorativa: _ah_ln [largura=86]
    _ah_ln() { local s=""; printf -v s '%*s' "${1:-86}" ''; echo -e "${NEON_BLUE}${s// /-}${NC}"; }

    # Mensagem entre duas linhas: _ah_box <larg_topo> <larg_base> <pt> <en> <es>
    _ah_box() { _ah_ln "$1"; msg "$3" "$4" "$5"; _ah_ln "$2"; }

    # Lê a opção em <variável> (sem espaços, minúscula); se houver 3º argumento, fecha com linha dessa largura
    _ah_ask() {
        local -n _r="$1"
        read -rp "$2" _r || return 1
        [[ -n ${3:-} ]] && _ah_ln "$3"
        _r="${_r//[[:space:]]/}"; _r="${_r,,}"
        return 0
    }

    _ah_bin() {
        local n="$1" dep=go
        [[ $n == paru ]] && dep=rust
        if (($2)); then
            ah_tmp=$(mktemp -d) || return 1
            msg "Instalando o $n-bin complementar..." \
                "Installing complementary $n-bin..." \
                "Instalando $n-bin complementario..."
        else
            msg "Instalando o $n-bin..." \
                "Installing $n-bin..." \
                "Instalando $n-bin..."
        fi
        echo ""
        [[ -n $ah_tmp ]] || ah_tmp=$(mktemp -d) || return 1
        if sudo pacman -S --needed --noconfirm git base-devel "$dep" && \
           git clone "https://aur.archlinux.org/$n-bin.git" "$ah_tmp/$n-bin" && \
           (cd "$ah_tmp/$n-bin" && makepkg -si --noconfirm); then
            rm -rf "$ah_tmp"; ah_tmp=""
            if [[ $n == yay ]]; then ah_yay=1; else ah_paru=1; fi
            msg "$n-bin instalado com sucesso." \
                "$n-bin successfully installed." \
                "$n-bin instalado con éxito."
        else
            if (($2)); then
                msg "${RED_NEON}Falha na instalação do $n-bin complementar.${NC}" \
                    "${RED_NEON}Failed to install complementary $n-bin.${NC}" \
                    "${RED_NEON}Error al instalar $n-bin complementario.${NC}"
            else
                msg "${RED_NEON}Falha na instalação do $n-bin.${NC}" \
                    "${RED_NEON}Failed to install $n-bin.${NC}" \
                    "${RED_NEON}Error al instalar $n-bin.${NC}"
            fi
            rm -rf "$ah_tmp"; ah_tmp=""
        fi
        return 0
    }

    # Fim da função (normal ou por Ctrl+C/TERM): limpa o temporário, restaura os traps e remove os ajudantes
    _ah_fim() {
        local s="$ah_sig"
        if [[ -n $s ]]; then
            echo ""
            msg "${YELLOW_NEON}[AVISO] AUR Helper interrompido. Limpando arquivos temporários...${NC}" \
                "${YELLOW_NEON}[WARNING] AUR Helper interrupted. Cleaning up temporary files...${NC}" \
                "${YELLOW_NEON}[AVISO] AUR Helper interrumpido. Limpiando archivos temporales...${NC}"
        fi
        if [[ -n $ah_tmp ]]; then rm -rf "$ah_tmp"; ah_tmp=""; fi
        if ((ah_ts)); then
            if [[ -n $ah_oi ]]; then eval "$ah_oi"; else trap - INT; fi
            if [[ -n $ah_ot ]]; then eval "$ah_ot"; else trap - TERM; fi
            ah_ts=0
        fi
        unset -f _ah_ln _ah_box _ah_ask _ah_bin _ah_main _ah_fim
        [[ -n $s ]] || return 0
        kill -s "$s" $$
        [[ $s == INT ]] && exit 130
        exit 143
    }

    _ah_main() {
        local op="" ver="" hc="" pk="" snap=0 helper="" enc="" n=""

        command -v yay &>/dev/null && ah_yay=1
        command -v paru &>/dev/null && ah_paru=1

        # --- ETAPA 1: Gerenciamento dos Helpers (yay / paru) ---
        if ((ah_yay && ah_paru)); then
            _ah_box 86 86 "${CYAN_NEON}Ambos os AUR helpers (yay e paru) já estão instalados no sistema.${NC}" \
                "${CYAN_NEON}Both AUR helpers (yay and paru) are already installed on the system.${NC}" \
                "${CYAN_NEON}Ambos los AUR helpers (yay y paru) ya están instalados en el sistema.${NC}"
            echo ""
            sleep 0.5
            msg "Prosseguindo..." \
                "Proceeding..." \
                "Prosiguiendo..."
            sleep 0.5
        elif ((!ah_yay && !ah_paru)); then
            while true; do
                _ah_ln
                msg "${CYAN_NEON}Nenhum AUR helper (yay ou paru) foi encontrado.${NC}" \
                    "${CYAN_NEON}No AUR helper (yay or paru) was found.${NC}" \
                    "${CYAN_NEON}No se encontró ningún AUR helper (yay o paru).${NC}"
                echo ""
                msg "${CYAN_NEON}Esta ferramenta é necessária para baixar pacotes e software da comunidade no Arch Linux.${NC}" \
                    "${CYAN_NEON}This tool is required to download packages and community software on Arch Linux.${NC}" \
