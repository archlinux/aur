DEV_MODE() {
    # --------------------------------------------------------------------------
    # Estado do módulo (nada se perde: o resumo final usa estas estruturas)
    # --------------------------------------------------------------------------
    local IFS=$' \t\n'
    local -a SUDO=()
    local -a INSTALADOS=() JA_INSTALADOS=() FALHARAM=() INDISPONIVEIS=() VALIDACAO_FALHOU=()
    local -a AVISOS=() CRITICOS=()
    local -a fila_aur=() lote=() toks=() words=()
    local -a sel_editores=() ed_itens=() ed_oficial=() ed_aur=()
    local -A status_val=()

    local helper="" helper_ok=0 aur_permitido=1 bloqueado=0
    local has_yay=0 has_paru=0 helper_novo=0
    local CLS_KIND="" CLS_PKG="" editor_id=""
    local tmp_base="${TMPDIR:-/tmp}" tmp_dir=""
    local pacman_lock="/var/lib/pacman/db.lck"
    local pacman_sync="/var/lib/pacman/sync"
    local dev_sep="${NEON_BLUE}============================================================================================================================${NC}"
    local rec="" label="" rest="" tok="" opcao_h="" opcao_ed="" ed_multi="" word="" ed=""
    local espera=0
    local ka_pid=""
    local traps_set=0 old_int="" old_term=""

    # Stacks: "Rótulo|comando:flag,comando:flag". `pkg:NOME` valida o pacote.
    local -a STACKS=(
        "C|gcc:--version"
        "C++|g++:--version"
        "Rust|rustc:--version,cargo:--version"
        "Python|python:--version,pip:--version"
        "Java|java:--version,javac:--version"
        "C#|dotnet:--version"
        "JavaScript|node:--version,npm:--version"
        "TypeScript|tsc:--version"
        "PHP|php:--version"
        "Go|go:version"
        "SQL|sqlite3:--version"
        "Bash/Shell|bash:--version"
        "PowerShell|pwsh:--version"
        "Kotlin|kotlinc:-version"
        "Lua|lua:-v"
        "Node.js|node:--version,npm:--version"
        ".NET|dotnet:--version"
    )
    local -a FERRAMENTAS=(
        "Git|git:--version"
        "GitHub CLI|gh:--version"
        "OpenSSH|ssh:-V"
        "Make|make:--version"
        "CMake|cmake:--version"
        "Ninja|ninja:--version"
        "GDB|gdb:--version"
        "pkgconf|pkgconf:--version"
        "base-devel|pkg:base-devel"
        "debugedit|pkg:debugedit"
    )

    # Grupos lógicos de instalação: uma falha fica isolada dentro do seu grupo.
    local -a GRUPOS=(
        "Base de build e ferramentas|base-devel gcc binutils make cmake ninja pkgconf gdb debugedit git github-cli openssh"
        "Linguagens e runtimes|rust python python-pip jdk-openjdk nodejs npm typescript php go sqlite bash kotlin lua powershell:powershell-bin"
        "Plataforma .NET|dotnet-sdk"
    )

    # --------------------------------------------------------------------------
    # Auxiliares aninhados
    # --------------------------------------------------------------------------
    _dev_safe() {
        local s="${1//[^[:alnum:]._+@-]/?}"
        printf '%s' "${s:0:24}"
    }

    _dev_trim() {
        local s="$1"
        s="${s#"${s%%[![:space:]]*}"}"
        s="${s%"${s##*[![:space:]]}"}"
        printf '%s' "$s"
    }

    _dev_instalado() {
        local n="$1" m
        local -a g=()
        pacman -Q "$n" &>/dev/null && return 0
        pacman -T "$n" &>/dev/null && return 0
        mapfile -t g < <(pacman -Sgq "$n" 2>/dev/null)
        (( ${#g[@]} > 0 )) || return 1
        for m in "${g[@]}"; do
            pacman -Q "$m" &>/dev/null || return 1
        done
        return 0
    }

    _dev_ja() {
        [[ " ${INSTALADOS[*]} " == *" $1 "* ]] || JA_INSTALADOS+=("$1")
    }

    _dev_classificar() {
        local nome="${1%%:*}" alt=""
        [[ "$1" == *:* ]] && alt="${1#*:}"
        CLS_KIND="none"
        CLS_PKG="${nome:-$alt}"

        if [[ -n "$nome" ]]; then
            if pacman -Q "$nome" &>/dev/null; then CLS_KIND="installed"; return 0; fi
            if _dev_instalado "$nome"; then CLS_KIND="provided"; return 0; fi
            if pacman -Si "$nome" &>/dev/null || [[ -n "$(pacman -Sgq "$nome" 2>/dev/null)" ]]; then
                CLS_KIND="official"
                return 0
            fi
        fi
        if [[ -n "$alt" ]]; then
            CLS_PKG="$alt"
            if pacman -Q "$alt" &>/dev/null; then
                CLS_KIND="installed"
            elif (( helper_ok )) && "$helper" -Si "$alt" &>/dev/null; then
                CLS_KIND="aur"
            fi
        fi
        return 0
    }

    _dev_instalar_lote() {
        local tipo="$1"; shift
        local -a pacotes=("$@") cmd=()
        local p consecutivas=0
        (( ${#pacotes[@]} > 0 )) || return 0

        if [[ "$tipo" == "aur" ]]; then
            cmd=("$helper" -S --needed --noconfirm)
        else
            cmd=("${SUDO[@]}" pacman -S --needed --noconfirm)
        fi

        if "${cmd[@]}" "${pacotes[@]}"; then
            for p in "${pacotes[@]}"; do
                if _dev_instalado "$p"; then INSTALADOS+=("$p"); else FALHARAM+=("$p"); fi
            done
            return 0
        fi

        msg "${YELLOW_NEON}[AVISO] O lote falhou (${pacotes[*]}). Tentando um por um...${NC}" \
            "${YELLOW_NEON}[WARNING] The batch failed (${pacotes[*]}). Trying one by one...${NC}" \
            "${YELLOW_NEON}[AVISO] El lote falló (${pacotes[*]}). Intentando uno por uno...${NC}"
        for p in "${pacotes[@]}"; do
            if (( consecutivas >= 3 )); then
                FALHARAM+=("$p")
                continue
            fi
            if _dev_instalado "$p"; then
                INSTALADOS+=("$p")
                consecutivas=0
            elif "${cmd[@]}" "$p" && _dev_instalado "$p"; then
                INSTALADOS+=("$p")
                consecutivas=0
            else
                FALHARAM+=("$p")
                consecutivas=$((consecutivas + 1))
                if (( consecutivas == 3 )); then
                    AVISOS+=("falhas-consecutivas")
                    msg "${RED_NEON}[ERRO] 3 falhas seguidas: provável problema de rede/mirror/repositório. Interrompendo as tentativas restantes deste lote.${NC}" \
                        "${RED_NEON}[ERROR] 3 failures in a row: likely a network/mirror/repository problem. Stopping the remaining attempts of this batch.${NC}" \
                        "${RED_NEON}[ERROR] 3 fallos seguidos: probable problema de red/mirror/repositorio. Se detienen los intentos restantes de este lote.${NC}"
                fi
            fi
        done
        return 1
    }

    _dev_conflita() {
        local outro=""
        case "$1" in
            code) outro="visual-studio-code-bin" ;;
            visual-studio-code-bin) outro="code" ;;
            *) return 1 ;;
        esac
        pacman -Q "$outro" &>/dev/null && return 0
        [[ " ${ed_oficial[*]} ${ed_aur[*]} " == *" $outro "* ]]
    }

    _dev_editor_id() {
        editor_id=""
        case "$1" in
            1|kate) editor_id=1 ;;
            2|code|vscode-oss|oss) editor_id=2 ;;
            3|vscode|vscode-bin|visual-studio-code|visual-studio-code-bin|microsoft) editor_id=3 ;;
            4|insiders|vscode-insiders|visual-studio-code-insiders-bin) editor_id=4 ;;
            5|zed|zed-bin) editor_id=5 ;;
        esac
    }

    _dev_construir_yay() {
        local base="yay-bin" rc=1 p
        local -a tmo=() faltavam=()
        if pacman -Q yay &>/dev/null && ! pacman -Q yay-bin &>/dev/null; then
            base="yay"
        fi

        for p in base-devel git go; do
            _dev_instalado "$p" || faltavam+=("$p")
        done
        if ! "${SUDO[@]}" pacman -S --needed --noconfirm base-devel git go; then
            msg "${YELLOW_NEON}[AVISO] Não foi possível instalar os pré-requisitos do yay (base-devel, git, go).${NC}" \
                "${YELLOW_NEON}[WARNING] Could not install the yay prerequisites (base-devel, git, go).${NC}" \
                "${YELLOW_NEON}[AVISO] No se pudieron instalar los requisitos de yay (base-devel, git, go)."
            return 1
        fi
        for p in "${faltavam[@]}"; do
            _dev_instalado "$p" && INSTALADOS+=("$p")
        done
        if ! command -v git &>/dev/null || ! command -v makepkg &>/dev/null; then
            msg "${YELLOW_NEON}[AVISO] git ou makepkg indisponível após instalar os pré-requisitos.${NC}" \
                "${YELLOW_NEON}[WARNING] git or makepkg is unavailable after installing the prerequisites.${NC}" \
                "${YELLOW_NEON}[AVISO] git o makepkg no está disponible tras instalar los requisitos."
            return 1
        fi
        tmp_dir=$(mktemp -d "${tmp_base%/}/odin-dev-yay.XXXXXX") || tmp_dir=""
        if [[ -z "$tmp_dir" ]]; then
            msg "${YELLOW_NEON}[AVISO] Não foi possível criar o diretório temporário para compilar o yay.${NC}" \
                "${YELLOW_NEON}[WARNING] Could not create the temporary directory to build yay.${NC}" \
                "${YELLOW_NEON}[AVISO] No se pudo crear el directorio temporal para compilar yay."
            return 1
        fi

        command -v timeout &>/dev/null && tmo=(timeout 180)
        if GIT_TERMINAL_PROMPT=0 "${tmo[@]}" git clone --depth=1 "https://aur.archlinux.org/${base}.git" "$tmp_dir/$base" \
            && chown -R nobody:nobody "$tmp_dir/$base" 2>/dev/null || true \
            && ( cd "$tmp_dir/$base" && sudo -u nobody makepkg --syncdeps --install --noconfirm ); then
            hash -r
            if command -v yay &>/dev/null && yay --version &>/dev/null; then
                rc=0
            fi
        fi

        if [[ "$tmp_dir" == "${tmp_base%/}"/odin-dev-yay.* && -d "$tmp_dir" ]]; then
            rm -rf -- "${tmp_dir:?}"
        fi
        tmp_dir=""
        return "$rc"
    }

    _dev_cmd_ok() {
        local exe="$1" flag="$2"
        local -a tmo=()
        if [[ "$exe" == "pkg" ]]; then
            _dev_instalado "$flag"
            return
        fi
        command -v "$exe" &>/dev/null || return 1
        command -v timeout &>/dev/null && tmo=(timeout 25)
        DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
            "${tmo[@]}" "$exe" "$flag" >/dev/null 2>&1 && return 0
        sleep 1
        DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
            "${tmo[@]}" "$exe" "$flag" >/dev/null 2>&1
    }

    _dev_validar_rec() {
        local lbl="${1%%|*}" specs="${1#*|}" spec="" all_ok=1
        local -a lst=()
        IFS=',' read -r -a lst <<< "$specs"
        for spec in "${lst[@]}"; do
            _dev_cmd_ok "${spec%%:*}" "${spec#*:}" || all_ok=0
        done
        if (( all_ok )); then
            status_val["$lbl"]="OK"
        else
            status_val["$lbl"]="FALHA"
            VALIDACAO_FALHOU+=("$lbl")
        fi
    }

    _dev_linha() {
        local lbl="$1" st="$2"
        if [[ "$st" == "OK" ]]; then
            msg "${GREEN_NEON}[OK]${NC}    $lbl" \
                "${GREEN_NEON}[OK]${NC}    $lbl" \
                "${GREEN_NEON}[OK]${NC}    $lbl"
        else
            msg "${RED_NEON}[FALHA]${NC} $lbl" \
                "${RED_NEON}[FAIL]${NC}  $lbl" \
                "${RED_NEON}[FALLO]${NC} $lbl"
        fi
    }

    _dev_ka_iniciar() {
        local pai=$$
        (
            while kill -0 "$pai" 2>/dev/null; do
                sudo -n true 2>/dev/null
                sleep 45
            done
        ) >/dev/null 2>&1 &
        ka_pid=$!
        disown "$ka_pid" 2>/dev/null
        return 0
    }

    _dev_encerrar() {
        if [[ -n "$ka_pid" ]]; then
            kill "$ka_pid" 2>/dev/null || true
            ka_pid=""
        fi
        if [[ -n "$tmp_dir" && -d "$tmp_dir" && "$tmp_dir" == "${tmp_base%/}"/odin-dev-yay.* ]]; then
            rm -rf -- "${tmp_dir:?}"
        fi
        tmp_dir=""
        if (( traps_set )); then
            if [[ -n "$old_int" ]]; then eval "$old_int"; else trap - INT; fi
            if [[ -n "$old_term" ]]; then eval "$old_term"; else trap - TERM; fi
            traps_set=0
        fi
        unset -f _dev_safe _dev_trim _dev_instalado _dev_ja _dev_classificar \
            _dev_instalar_lote _dev_conflita _dev_editor_id \
            _dev_construir_yay _dev_cmd_ok _dev_validar_rec _dev_linha _dev_ka_iniciar _dev_interrompido _dev_encerrar
        return 0
    }

    # shellcheck disable=SC2329
    _dev_interrompido() {
        local sinal="$1"
        echo ""
        msg "${YELLOW_NEON}[AVISO] MODO DEV interrompido. Limpando temporários...${NC}" \
            "${YELLOW_NEON}[WARNING] DEV MODE interrupted. Cleaning up temporary files...${NC}" \
            "${YELLOW_NEON}[AVISO] MODO DEV interrumpido. Limpiando archivos temporales..."
        _dev_encerrar
        kill -s "$sinal" $$
        [[ "$sinal" == "INT" ]] && exit 130
        exit 143
    }

    if ! command -v pacman &>/dev/null; then
        msg "${RED_NEON}[ERRO CRÍTICO] pacman não foi encontrado. O MODO DEV não pode continuar.${NC}" \
            "${RED_NEON}[CRITICAL ERROR] pacman was not found. DEV MODE cannot continue.${NC}" \
            "${RED_NEON}[ERROR CRÍTICO] No se encontró pacman. El MODO DEV no puede continuar."
        _dev_encerrar
        return 1
    fi

    old_int=$(trap -p INT)
    old_term=$(trap -p TERM)
    trap '_dev_interrompido INT' INT
    trap '_dev_interrompido TERM' TERM
    traps_set=1

    echo -e "$dev_sep"
    msg "${CYAN_NEON}[MODO DEV]${NC} Iniciando protocolo profissional de preparação para Desenvolvimento..." \
        "${CYAN_NEON}[DEV MODE]${NC} Starting professional development environment setup..." \
        "${CYAN_NEON}[MODO DEV]${NC} Iniciando protocolo profesional de preparación para Desarrollo..."
    echo -e "$dev_sep"
    sleep 1.5
    echo ""

    # ==========================================================================
    # [1/5] Ambiente: privilégios (sudo) e trava do pacman
    # ==========================================================================
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    msg "${CYAN_NEON}[1/5] Verificando privilégios (sudo) e o estado do pacman...${NC}" \
        "${CYAN_NEON}[1/5] Checking privileges (sudo) and the pacman state...${NC}" \
        "${CYAN_NEON}[1/5] Verificando privilegios (sudo) y el estado de pacman..."
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""
    sleep 1
    if (( EUID != 0 )); then
        SUDO=(sudo)
        if ! command -v sudo &>/dev/null; then
            msg "${RED_NEON}[ERRO CRÍTICO] sudo não foi encontrado.${NC}" \
                "${RED_NEON}[CRITICAL ERROR] sudo was not found.${NC}" \
                "${RED_NEON}[ERROR CRÍTICO] No se encontró sudo."
            CRITICOS+=("sudo")
            bloqueado=1
        elif ! sudo -n true 2>/dev/null && ! sudo -v; then
            msg "${RED_NEON}[ERRO CRÍTICO] Não foi possível obter privilégios de administrador (sudo).${NC}" \
                "${RED_NEON}[CRITICAL ERROR] Could not obtain administrator privileges (sudo).${NC}" \
                "${RED_NEON}[ERROR CRÍTICO] No se pudieron obtener privilegios de administrador (sudo)."
            CRITICOS+=("sudo")
            bloqueado=1
        else
            _dev_ka_iniciar
        fi
    fi

    if [[ -e "$pacman_lock" ]]; then
        while [[ -e "$pacman_lock" ]] && pgrep -x pacman &>/dev/null && (( espera < 30 )); do
            if (( espera == 0 )); then
                msg "${YELLOW_NEON}[AVISO] Há outro pacman em execução. Aguardando ele terminar...${NC}" \
                    "${YELLOW_NEON}[WARNING] Another pacman is running. Waiting for it to finish...${NC}" \
                    "${YELLOW_NEON}[AVISO] Hay otro pacman en ejecución. Esperando a que termine..."
            fi
            sleep 2
            espera=$((espera + 1))
        done
        if [[ -e "$pacman_lock" ]]; then
            msg "${RED_NEON}[ERRO CRÍTICO] O banco do pacman está travado ($pacman_lock). Remova a trava se nenhum pacman estiver rodando.${NC}" \
                "${RED_NEON}[CRITICAL ERROR] The pacman database is locked ($pacman_lock). Remove the lock if no pacman is running.${NC}" \
                "${RED_NEON}[ERROR CRÍTICO] La base de datos de pacman está bloqueada ($pacman_lock). Elimine el bloqueo si no hay pacman ejecutándose."
            CRITICOS+=("db.lck")
            bloqueado=1
        fi
    fi

    # Verificação robusta e segura de bases sincronizadas do pacman
    if [[ ! -d "$pacman_sync" ]] || ! find "$pacman_sync" -maxdepth 1 -name "*.db" -print -quit | grep -q .; then
        msg "${RED_NEON}[ERRO CRÍTICO] Nenhuma base de dados do pacman foi encontrada em $pacman_sync. Atualize o sistema antes do MODO DEV.${NC}" \
            "${RED_NEON}[CRITICAL ERROR] No pacman databases found in $pacman_sync. Update the system before DEV MODE.${NC}" \
            "${RED_NEON}[ERROR CRÍTICO] No se encontraron bases de datos de pacman en $pacman_sync. Actualice el sistema antes del MODO DEV."
        CRITICOS+=("bases-pacman")
        bloqueado=1
    fi

    if (( bloqueado )); then
        msg "${YELLOW_NEON}[AVISO] As instalações foram interrompidas por falha crítica no ambiente. Apenas a validação será executada.${NC}" \
            "${YELLOW_NEON}[WARNING] Installations were halted by a critical environment failure. Only validation will run.${NC}" \
            "${YELLOW_NEON}[AVISO] Las instalaciones se detuvieron por un fallo crítico del entorno. Solo se ejecutará la validación."
    else
        msg "${GREEN_NEON}[OK] Ambiente verificado.${NC}" \
            "${GREEN_NEON}[OK] Environment verified.${NC}" \
            "${GREEN_NEON}[OK] Entorno verificado."
    fi
    echo ""
    sleep 1

    # ==========================================================================
    # [2/5] AUR helper (detectar / escolher / preparar). Nunca como root.
    # ==========================================================================
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    msg "${CYAN_NEON}[2/5] Detectando e configurando o AUR helper (yay/paru)...${NC}" \
        "${CYAN_NEON}[2/5] Detecting and configuring the AUR helper (yay/paru)...${NC}" \
        "${CYAN_NEON}[2/5] Detectando y configurando el AUR helper (yay/paru)...${NC}"
    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
    echo ""
    sleep 1
    if (( bloqueado )); then
        msg "${YELLOW_NEON}[PULADO] Etapa ignorada por falha crítica anterior.${NC}" \
            "${YELLOW_NEON}[SKIPPED] Step skipped due to an earlier critical failure.${NC}" \
            "${YELLOW_NEON}[OMITIDO] Paso omitido por un fallo crítico anterior.${NC}"
    elif (( EUID == 0 )); then
        aur_permitido=0
        AVISOS+=("root-sem-aur")
        msg "${YELLOW_NEON}[AVISO] Executando como root: o AUR será ignorado.${NC}" \
            "${YELLOW_NEON}[WARNING] Running as root: AUR will be skipped.${NC}" \
            "${YELLOW_NEON}[AVISO] Ejecutando como root: se omitirá AUR."
    else
        command -v yay &>/dev/null && yay --version &>/dev/null && has_yay=1
        command -v paru &>/dev/null && paru --version &>/dev/null && has_paru=1

        if (( has_yay && has_paru )); then
            while true; do
                echo -e "$dev_sep"
                msg "${CYAN_NEON}                                    AUR HELPER${NC}" \
                    "${CYAN_NEON}                                    AUR HELPER${NC}" \
                    "${CYAN_NEON}                                    AUR HELPER${NC}"
                echo -e "$dev_sep"
                msg "${YELLOW_NEON}Ambos os AUR helpers (yay e paru) foram detectados. Escolha qual deseja utilizar:${NC}\n${GREEN_NEON}[1]${NC} yay\n${GREEN_NEON}[2]${NC} paru" \
                    "${YELLOW_NEON}Both AUR helpers (yay and paru) were detected. Choose which one to use:${NC}\n${GREEN_NEON}[1]${NC} yay\n${GREEN_NEON}[2]${NC} paru" \
                    "${YELLOW_NEON}Se detectaron ambos AUR helpers (yay y paru). Elija cuál utilizar:${NC}\n${GREEN_NEON}[1]${NC} yay\n${GREEN_NEON}[2]${NC} paru"
                if ! IFS= read -r -p ">> " opcao_h; then
                    msg "${RED_NEON}[ERRO] A escolha do AUR helper é obrigatória.${NC}" \
                        "${RED_NEON}[ERROR] Choosing an AUR helper is required.${NC}" \
                        "${RED_NEON}[ERROR] Es obligatorio elegir un AUR helper."
                    _dev_encerrar
                    return 1
                fi
                opcao_h="${opcao_h//[[:space:]]/}"
                opcao_h="${opcao_h,,}"
                case "$opcao_h" in
                    1|yay)  helper="yay";  break ;;
                    2|paru) helper="paru"; break ;;
                    *)
                        msg "${RED_NEON}[ERRO] Opção inválida! Digite [1] para yay ou [2] para paru.${NC}" \
                            "${RED_NEON}[ERROR] Invalid option! Type [1] for yay or [2] for paru.${NC}" \
                            "${RED_NEON}[ERROR] ¡Opción inválida! Escriba [1] para yay o [2] para paru."
                        sleep 1
                        ;;
                esac
            done
            JA_INSTALADOS+=("$helper")
        elif (( has_yay )); then
            helper="yay"
            JA_INSTALADOS+=("yay")
        elif (( has_paru )); then
            helper="paru"
            JA_INSTALADOS+=("paru")
        else
