        echo ""

        while true; do
            _gm_ln 177
            msg "${YELLOW_NEON}Deseja instalar o MangoHud e lib32-mangohud para monitoramento de FPS e desempenho? Digite [1] para Sim ou [2] para Não (ou digite sim/não):${NC}\n[1] Sim / Yes\n[2] Não / No" \
                "${YELLOW_NEON}Do you want to install MangoHud and lib32-mangohud for FPS and performance monitoring? Type [1] for Yes or [2] for No (or yes/no):${NC}\n[1] Sim / Yes\n[2] Não / No" \
                "${YELLOW_NEON}¿Deseas instalar MangoHud y lib32-mangohud para monitoreo de FPS y rendimiento? Escribe [1] para Sí o [2] para No (o sim/no):${NC}\n[1] Sim / Yes\n[2] Não / No"
            _gm_ln 177
            echo ""
            _gm_ask gm_op ">>  " || return 1

            if [[ $gm_op == @(1|s|sim|y|yes|si) ]]; then
                if pacman -Q mangohud lib32-mangohud &>/dev/null; then
                    msg "${CYAN_NEON}[OK] MangoHud já está instalado.${NC}" \
