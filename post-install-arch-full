                        "${RED_NEON}[ERROR] ¡Opción inválida! Escriba [1] para yay o [2] para paru.${NC}"
                    sleep 1.5
                fi
            done
        elif ((gm_y)); then
            gm_helper="yay"
        elif ((gm_p)); then
            gm_helper="paru"
        else
            _gm_box 86 86 "${YELLOW_NEON}[AVISO] Nenhum AUR helper detectado. Instalando o 'yay-bin' automaticamente...${NC}" \
