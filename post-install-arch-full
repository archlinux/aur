DEV_MODE() {
    local IFS=$' \t\n'
    local dv_fresh=0 dv_hok=0 dv_aurok=1 dv_blk=0 dv_hnew=0 dv_helper="" dv_kind="" dv_pkg="" dv_s="" dv_id=""
    local dv_in=$'\n' dv_un=$'\n' dv_miss=$'\n'
    local dv_tb="${TMPDIR:-/tmp}" dv_tmp="" dv_ka="" dv_sig="" dv_ts=0 dv_oi="" dv_ot="" dv_rc=0
    local dv_lock="/var/lib/pacman/db.lck" dv_sync="/var/lib/pacman/sync"
    local -a dv_sudo=() dv_tg=() dv_tc=() dv_inst=() dv_ja=() dv_fail=() dv_indis=() dv_valfail=() dv_avisos=() dv_crit=()
    local -a dv_lote=() dv_aurq=() dv_vsel=() dv_kern=() dv_regrp=() dv_vspec=() dv_edit=() dv_edof=() dv_edaur=() dv_vbm=()
    local -A dv_cache=() dv_stat=()

    # Stacks: "Rótulo|comando:flag,comando:flag". `pkg:NOME` valida o pacote.
    local -a dv_stacks=(
        "C|gcc:--version"
        "C++|g++:--version"
        "Rust|rustc:--version,cargo:--version"
        "Python|python:--version,pip:--version"
        "Java|java:--version,javac:--version"
        "C#|dotnet:--version"
        "JavaScript|node:--version,npm:--version"
        "TypeScript|tsc:--version"
        "PHP|php:--version"
        "Go|go:version"
        "SQL|sqlite3:--version"
        "Bash/Shell|bash:--version"
        "PowerShell|pwsh:--version"
        "Kotlin|kotlinc:-version"
        "Lua|lua:-v"
        "Node.js|node:--version,npm:--version"
        ".NET|dotnet:--version"
    )
    local -a dv_tools=(
        "Git|git:--version"
        "GitHub CLI|gh:--version"
        "OpenSSH|ssh:-V"
        "Make|make:--version"
        "CMake|cmake:--version"
        "Ninja|ninja:--version"
        "GDB|gdb:--version"
        "pkgconf|pkgconf:--version"
        "base-devel|pkg:base-devel"
        "debugedit|pkg:debugedit"
    )
    # Grupos lógicos de instalação: uma falha fica isolada dentro do seu grupo.
    local -a dv_grupos=(
        "Base de build e ferramentas|base-devel gcc binutils make cmake ninja pkgconf gdb debugedit git github-cli openssh"
        "Linguagens e runtimes|rust python python-pip jdk-openjdk nodejs npm typescript php go sqlite bash kotlin lua powershell:powershell-bin"
        "Plataforma .NET|dotnet-sdk"
    )
    # Editores (id 1..5): pacote[:alternativa AUR] e rótulo
    local -a dv_edtok=("" "kate" "code" ":visual-studio-code-bin" ":visual-studio-code-insiders-bin" "zed:zed-bin")
    local -a dv_edlbl=("" "Kate" "VS Code OSS" "VS Code Microsoft" "VS Code Insiders" "Zed")

    # Linha decorativa: _dv_ln [largura=86] [caractere=-]
    _dv_ln() { local s=""; printf -v s '%*s' "${1:-86}" ''; echo -e "${NEON_BLUE}${s// /${2:--}}${NC}"; }

    # Cabeçalho de etapa: linha, título, linha, linha em branco e pausa
    _dv_hdr() { _dv_ln; msg "$1" "$2" "$3"; _dv_ln; echo ""; sleep 1; }

    _dv_skip() {
        msg "${YELLOW_NEON}[PULADO] Etapa ignorada por falha crítica anterior.${NC}" \
            "${YELLOW_NEON}[SKIPPED] Step skipped due to an earlier critical failure.${NC}" \
            "${YELLOW_NEON}[OMITIDO] Paso omitido por un fallo crítico anterior.${NC}"
    }

    # Aviso sem repetição
    _dv_av() { [[ " ${dv_avisos[*]} " == *" $1 "* ]] || dv_avisos+=("$1"); }

    # Lê a resposta em <variável>; retorna 1 no fim da entrada (EOF)
    _dv_ask() { local -n _r="$1"; IFS= read -r -p ">> " _r; }

    # Remove espaços das pontas de <variável>
    _dv_trim() { local -n _t="$1"; _t="${_t#"${_t%%[![:space:]]*}"}"; _t="${_t%"${_t##*[![:space:]]}"}"; }

    # Texto seguro para mensagens (vai para dv_s)
    _dv_safe() { dv_s="${1//[^[:alnum:]._+@-]/?}"; dv_s="${dv_s:0:24}"; }

    # Pacotes instalados (uma consulta)
    _dv_qq() { dv_in=$'\n'$(pacman -Qq 2>/dev/null)$'\n'; dv_fresh=1; }

    _dv_prime() {
        local o="" p=""
        local -a dv_pq=()
        ((dv_fresh)) || _dv_qq
        dv_un=$'\n'; dv_miss=$'\n'
        for p in "$@"; do [[ -z $p || $dv_in == *$'\n'"$p"$'\n'* ]] || dv_pq+=("$p"); done
        set -- "${dv_pq[@]}"
        (($#)) || return 0
        o=$(pacman -T -- "$@" 2>/dev/null) || :
        dv_un+="$o"$'\n'
        if ! o=$(LC_ALL=C pacman -Si -- "$@" 2>&1 >/dev/null); then
            for p in "$@"; do
                if [[ $o == *"package '$p' was not found"* ]]; then dv_miss+="$p"$'\n'; fi
            done
            if [[ $dv_miss == $'\n' ]]; then
                for p in "$@"; do pacman -Si -- "$p" &>/dev/null || dv_miss+="$p"$'\n'; done
            fi
        fi
    }

    _dv_grp() {
        local g="" m=""
        g=$(pacman -Sgq -- "$1" 2>/dev/null) || return 1
        [[ -n $g ]] || return 1
        dv_kind=provided
        while IFS= read -r m; do
            [[ $dv_in == *$'\n'"$m"$'\n'* ]] || { dv_kind=official; break; }
        done <<< "$g"
        return 0
    }

    # Classifica <pacote[:alternativa AUR]> em dv_kind (installed|provided|official|aur|none) e dv_pkg
    _dv_cls() {
        local n="${1%%:*}" a=""
        [[ $1 == *:* ]] && a="${1#*:}"
        dv_kind=none
        dv_pkg="${n:-$a}"
        if [[ -n $n ]]; then
            if [[ $dv_in == *$'\n'"$n"$'\n'* ]]; then dv_kind=installed; return 0; fi
            if [[ $dv_un != *$'\n'"$n"$'\n'* ]]; then dv_kind=provided; return 0; fi
            if [[ $dv_miss != *$'\n'"$n"$'\n'* ]]; then dv_kind=official; return 0; fi
            if _dv_grp "$n"; then return 0; fi
        fi
        if [[ -n $a ]]; then
            dv_pkg="$a"
            if [[ $dv_in == *$'\n'"$a"$'\n'* ]]; then
                dv_kind=installed
            elif ((dv_hok)) && "$dv_helper" -Si "$a" &>/dev/null; then
                dv_kind=aur
            fi
        fi
        return 0
    }

    _dv_ok() {
        local g="" m=""
        [[ $dv_in == *$'\n'"$1"$'\n'* ]] && return 0
        if pacman -Q -- "$1" &>/dev/null; then dv_in+="$1"$'\n'; return 0; fi
        pacman -T -- "$1" &>/dev/null && return 0
        g=$(pacman -Sgq -- "$1" 2>/dev/null) || return 1
        [[ -n $g ]] || return 1
        while IFS= read -r m; do
            [[ $dv_in == *$'\n'"$m"$'\n'* ]] || pacman -Q -- "$m" &>/dev/null || return 1
        done <<< "$g"
        return 0
    }

    _dv_ja() { [[ " ${dv_inst[*]} " == *" $1 "* ]] || dv_ja+=("$1"); }

    # Separa <pacote[:alt]>… em dv_lote (oficiais) e dv_aurq (AUR); o resto vira "indisponível"
    _dv_triar() {
        local t=""
        for t in "$@"; do
            _dv_cls "$t"
            if [[ $dv_kind == installed ]]; then
                _dv_ja "$dv_pkg"
            elif [[ $dv_kind == provided ]]; then
                _dv_ja "$dv_pkg"
                msg "${CYAN_NEON}[INFO] $dv_pkg já é fornecido por outro pacote instalado.${NC}" \
                    "${CYAN_NEON}[INFO] $dv_pkg is already provided by another installed package.${NC}" \
                    "${CYAN_NEON}[INFO] $dv_pkg ya lo proporciona otro paquete instalado.${NC}"
            elif [[ $dv_kind == official ]]; then
                dv_lote+=("$dv_pkg")
            elif [[ $dv_kind == aur ]]; then
                dv_aurq+=("$dv_pkg")
            else
                dv_indis+=("$dv_pkg")
                msg "${YELLOW_NEON}[AVISO] Pacote indisponível nesta execução: $dv_pkg${NC}" \
                    "${YELLOW_NEON}[WARNING] Package unavailable in this run: $dv_pkg${NC}" \
                    "${YELLOW_NEON}[AVISO] Paquete no disponible en esta ejecución: $dv_pkg${NC}"
            fi
        done
    }

    # Instala <official|aur> <pacotes…> em lote; se falhar, um a um (3 falhas seguidas interrompem o lote)
    _dv_lote() {
        local t="$1" p="" n=0
        local -a dv_cm=()
        shift
        (($#)) || return 0
        if [[ $t == aur ]]; then dv_cm=("$dv_helper" -S --needed --noconfirm); else dv_cm=("${dv_sudo[@]}" pacman -S --needed --noconfirm); fi

        if "${dv_cm[@]}" "$@"; then
            _dv_qq
            for p in "$@"; do
                if _dv_ok "$p"; then dv_inst+=("$p"); else dv_fail+=("$p"); fi
            done
            return 0
        fi

        msg "${YELLOW_NEON}[AVISO] O lote falhou ($*). Tentando um por um...${NC}" \
            "${YELLOW_NEON}[WARNING] The batch failed ($*). Trying one by one...${NC}" \
            "${YELLOW_NEON}[AVISO] El lote falló ($*). Intentando uno por uno...${NC}"
        dv_fresh=0
        for p in "$@"; do
            if ((n >= 3)); then
                dv_fail+=("$p")
            elif _dv_ok "$p" || { "${dv_cm[@]}" "$p" && _dv_ok "$p"; }; then
                dv_inst+=("$p")
                n=0
            else
                dv_fail+=("$p")
                ((++n))
                if ((n == 3)); then
                    _dv_av "falhas-consecutivas"
                    msg "${RED_NEON}[ERRO] 3 falhas seguidas: provável problema de rede/mirror/repositório. Interrompendo as tentativas restantes deste lote.${NC}" \
                        "${RED_NEON}[ERROR] 3 failures in a row: likely a network/mirror/repository problem. Stopping the remaining attempts of this batch.${NC}" \
                        "${RED_NEON}[ERROR] 3 fallos seguidos: probable problema de red/mirror/repositorio. Se detienen los intentos restantes de este lote.${NC}"
                fi
            fi
        done
        return 1
    }

    # code <-> visual-studio-code-bin não convivem
    _dv_conf() {
        local o=""
        if [[ $1 == code ]]; then o="visual-studio-code-bin"
        elif [[ $1 == visual-studio-code-bin ]]; then o="code"
        else return 1; fi
        [[ $dv_in == *$'\n'"$o"$'\n'* ]] && return 0
        [[ " ${dv_edof[*]} ${dv_edaur[*]} " == *" $o "* ]]
    }

    # Número/nome do editor -> id 1..5 (vazio se inválido)
    _dv_edid() {
        dv_id=""
        case "$1" in
            1|kate) dv_id=1 ;;
            2|code|vscode-oss|oss) dv_id=2 ;;
            3|vscode|vscode-bin|visual-studio-code|visual-studio-code-bin|microsoft) dv_id=3 ;;
            4|insiders|vscode-insiders|visual-studio-code-insiders-bin) dv_id=4 ;;
            5|zed|zed-bin) dv_id=5 ;;
        esac
    }

    # Compila o yay (usuário comum; makepkg não roda como root). Se um yay quebrado já existe, recompila o `yay`
    _dv_yay() {
        local b="yay-bin" rc=1 p=""
        local -a dv_fa=()
        _dv_qq
        if [[ $dv_in == *$'\n'yay$'\n'* && $dv_in != *$'\n'yay-bin$'\n'* ]]; then b="yay"; fi
        for p in base-devel git go; do _dv_ok "$p" || dv_fa+=("$p"); done
        if ((${#dv_fa[@]})); then
            if ! "${dv_sudo[@]}" pacman -S --needed --noconfirm base-devel git go; then
                msg "${YELLOW_NEON}[AVISO] Não foi possível instalar os pré-requisitos do yay (base-devel, git, go).${NC}" \
                    "${YELLOW_NEON}[WARNING] Could not install the yay prerequisites (base-devel, git, go).${NC}" \
                    "${YELLOW_NEON}[AVISO] No se pudieron instalar los requisitos de yay (base-devel, git, go).${NC}"
                return 1
            fi
            _dv_qq
            for p in "${dv_fa[@]}"; do _dv_ok "$p" && dv_inst+=("$p"); done
        fi
        if ! command -v git &>/dev/null || ! command -v makepkg &>/dev/null; then
            msg "${YELLOW_NEON}[AVISO] git ou makepkg indisponível após instalar os pré-requisitos.${NC}" \
                "${YELLOW_NEON}[WARNING] git or makepkg is unavailable after installing the prerequisites.${NC}" \
                "${YELLOW_NEON}[AVISO] git o makepkg no está disponible tras instalar los requisitos.${NC}"
            return 1
        fi
        dv_tmp=$(mktemp -d "${dv_tb%/}/odin-dev-yay.XXXXXX") || dv_tmp=""
        if [[ -z $dv_tmp ]]; then
            msg "${YELLOW_NEON}[AVISO] Não foi possível criar o diretório temporário para compilar o yay.${NC}" \
                "${YELLOW_NEON}[WARNING] Could not create the temporary directory to build yay.${NC}" \
                "${YELLOW_NEON}[AVISO] No se pudo crear el directorio temporal para compilar yay.${NC}"
            return 1
        fi
        if GIT_TERMINAL_PROMPT=0 "${dv_tg[@]}" git clone --depth=1 "https://aur.archlinux.org/$b.git" "$dv_tmp/$b" \
            && (cd "$dv_tmp/$b" && makepkg --syncdeps --install --noconfirm); then
            hash -r
            if command -v yay &>/dev/null && yay --version &>/dev/null; then rc=0; fi
        fi
        dv_fresh=0
        if [[ $dv_tmp == "${dv_tb%/}"/odin-dev-yay.* && -d $dv_tmp ]]; then rm -rf -- "${dv_tmp:?}"; fi
        dv_tmp=""
        return "$rc"
    }

    # Executa <comando> <flag> silenciosamente (com timeout e telemetria do dotnet desligada)
    _dv_run() {
        DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
            "${dv_tc[@]}" "$1" "$2" >/dev/null 2>&1
    }

    _dv_cmd() {
        local k="$1 $2"
        if [[ $1 == pkg ]]; then _dv_ok "$2"; return; fi
        if [[ -z ${dv_cache[$k]:-} ]]; then
            if ! command -v "$1" &>/dev/null; then
                dv_cache[$k]=1
            elif _dv_run "$1" "$2"; then
                dv_cache[$k]=0
            else
                sleep 1
                _dv_run "$1" "$2"
                dv_cache[$k]=$?
            fi
        fi
        return "${dv_cache[$k]}"
    }

    # Valida um registro "Rótulo|cmd:flag,cmd:flag" e guarda OK/FALHA em dv_stat
    _dv_val() {
        local dv_vl="${1%%|*}" dv_vs="" dv_vk=1
        local -a dv_vq=()
        IFS=',' read -r -a dv_vq <<< "${1#*|}"
        for dv_vs in "${dv_vq[@]}"; do _dv_cmd "${dv_vs%%:*}" "${dv_vs#*:}" || dv_vk=0; done
        if ((dv_vk)); then
            dv_stat["$dv_vl"]="OK"
        else
            dv_stat["$dv_vl"]="FALHA"
            dv_valfail+=("$dv_vl")
        fi
    }

    _dv_lin() {
        if [[ $2 == OK ]]; then
            msg "${GREEN_NEON}[OK]${NC}    $1" \
                "${GREEN_NEON}[OK]${NC}    $1" \
                "${GREEN_NEON}[OK]${NC}    $1"
        else
            msg "${RED_NEON}[FALHA]${NC} $1" \
                "${RED_NEON}[FAIL]${NC}  $1" \
                "${RED_NEON}[FALLO]${NC} $1"
        fi
    }

    _dv_kas() {
        local pai=$$ s=""
        (
            trap 'kill "$s" 2>/dev/null; exit 0' TERM
            while kill -0 "$pai" 2>/dev/null; do
                sudo -n true 2>/dev/null || :
                sleep 45 & s=$!
                wait "$s"
            done
        ) >/dev/null 2>&1 &
        dv_ka=$!
        disown "$dv_ka" 2>/dev/null
        return 0
    }

    _dv_grupo() {
        local g="$1" u="${SUDO_USER:-${USER:-}}" gn="" gm="" fnd=0 has=0
        if [[ -z $u || $u == root ]]; then
            msg "${CYAN_NEON}[INFO] Executando como root: adicione seu usuário ao grupo '$g' manualmente (gpasswd -a USUARIO $g).${NC}" \
                "${CYAN_NEON}[INFO] Running as root: add your user to the '$g' group manually (gpasswd -a USER $g).${NC}" \
                "${CYAN_NEON}[INFO] Ejecutando como root: añada su usuario al grupo '$g' manualmente (gpasswd -a USUARIO $g).${NC}"
            return 0
        fi
        while IFS=: read -r gn _ _ gm; do
            [[ $gn == "$g" ]] || continue
            fnd=1
            [[ ",$gm," == *",$u,"* ]] && has=1
            break
        done < /etc/group
        _dv_safe "$u"
        if ((! fnd)); then
            _dv_av "grupo-$g"
            msg "${YELLOW_NEON}[AVISO] O grupo '$g' não existe. Adicione '$dv_s' a ele manualmente depois.${NC}" \
                "${YELLOW_NEON}[WARNING] The '$g' group does not exist. Add '$dv_s' to it manually later.${NC}" \
                "${YELLOW_NEON}[AVISO] El grupo '$g' no existe. Añada '$dv_s' manualmente después.${NC}"
        elif ((has)); then
            msg "${GREEN_NEON}[OK] Usuário '$dv_s' já está no grupo '$g'.${NC}" \
                "${GREEN_NEON}[OK] User '$dv_s' is already in the '$g' group.${NC}" \
                "${GREEN_NEON}[OK] El usuario '$dv_s' ya está en el grupo '$g'.${NC}"
        elif "${dv_sudo[@]}" gpasswd -a "$u" "$g" &>/dev/null; then
            dv_regrp+=("$g")
            msg "${GREEN_NEON}[OK] Usuário '$dv_s' adicionado ao grupo '$g'.${NC}" \
                "${GREEN_NEON}[OK] User '$dv_s' added to the '$g' group.${NC}" \
                "${GREEN_NEON}[OK] Usuario '$dv_s' añadido al grupo '$g'.${NC}"
        else
            _dv_av "grupo-$g"
            msg "${YELLOW_NEON}[AVISO] Não foi possível adicionar '$dv_s' ao grupo '$g'.${NC}" \
                "${YELLOW_NEON}[WARNING] Could not add '$dv_s' to the '$g' group.${NC}" \
                "${YELLOW_NEON}[AVISO] No se pudo añadir '$dv_s' al grupo '$g'.${NC}"
        fi
    }

    # Habilita e inicia <serviço>: 0 ok, 1 falhou, 2 init não suportado (systemd; OpenRC melhor esforço)
    _dv_svc() {
        if [[ -d /run/systemd/system ]] && command -v systemctl &>/dev/null; then
            "${dv_sudo[@]}" systemctl enable --now "$1.service"
        elif command -v rc-update &>/dev/null && command -v rc-service &>/dev/null; then
            "${dv_sudo[@]}" rc-update add "$1" default && "${dv_sudo[@]}" rc-service "$1" start
        else
            return 2
        fi
    }

    _dv_rede() {
        local all="" act="" i=0
        for ((i = 0; i < 5; i++)); do
            all=$("${dv_sudo[@]}" virsh -c qemu:///system net-list --all --name 2>/dev/null) && break
            sleep 1
        done
        if [[ $'\n'$all$'\n' != *$'\n'default$'\n'* ]]; then
            msg "${CYAN_NEON}[INFO] Rede NAT 'default' do libvirt não encontrada (crie uma no virt-manager se precisar).${NC}" \
                "${CYAN_NEON}[INFO] libvirt 'default' NAT network not found (create one in virt-manager if needed).${NC}" \
                "${CYAN_NEON}[INFO] Red NAT 'default' de libvirt no encontrada (cree una en virt-manager si la necesita).${NC}"
            return 0
        fi
        act=$("${dv_sudo[@]}" virsh -c qemu:///system net-list --name 2>/dev/null) || act=""
        if "${dv_sudo[@]}" virsh -c qemu:///system net-autostart default &>/dev/null \
            && { [[ $'\n'$act$'\n' == *$'\n'default$'\n'* ]] || "${dv_sudo[@]}" virsh -c qemu:///system net-start default &>/dev/null; }; then
            msg "${CYAN_NEON}[OK] Rede NAT 'default' ativa e com início automático.${NC}" \
                "${CYAN_NEON}[OK] 'default' NAT network active and set to autostart.${NC}" \
                "${CYAN_NEON}[OK] Red NAT 'default' activa y con inicio automático.${NC}"
        else
            _dv_av "rede-libvirt"
            msg "${YELLOW_NEON}[AVISO] Não foi possível ativar a rede NAT 'default' do libvirt.${NC}" \
                "${YELLOW_NEON}[WARNING] Could not activate the libvirt 'default' NAT network.${NC}" \
                "${YELLOW_NEON}[AVISO] No se pudo activar la red NAT 'default' de libvirt.${NC}"
        fi
    }

    _dv_hw() {
        local c=""
        [[ -r /proc/cpuinfo ]] || return 0
        c=$(< /proc/cpuinfo)
        [[ $c =~ [[:space:]](vmx|svm)[[:space:]] ]] && return 0
        _dv_av "virtualizacao-hw"
        msg "${YELLOW_NEON}[AVISO] A CPU não expõe VT-x/AMD-V (vmx/svm). Ative a virtualização na BIOS/UEFI; sem ela as VMs ficam muito lentas ou não iniciam.${NC}" \
            "${YELLOW_NEON}[WARNING] The CPU does not expose VT-x/AMD-V (vmx/svm). Enable virtualization in the BIOS/UEFI; without it VMs are very slow or will not start.${NC}" \
