                    "${YELLOW_NEON}[WARNING] Both AUR helpers (yay and paru) were detected. Choose by typing the number [1 or 2] or name [yay or paru]:${NC}\n[1] yay\n[2] paru" \
                    "${YELLOW_NEON}[AVISO] Ambos los AUR helpers (yay y paru) fueron detectados. Elija escribiendo el número [1 o 2] o el nombre [yay o paru]:${NC}\n[1] yay\n[2] paru"
                _gm_ask gm_op ">>  " || return 1
                if [[ $gm_op == @(1|yay) ]]; then
