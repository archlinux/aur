                            read -rp "Escolha / Choice / Opción: 1-2-0 " h_choice || return 1
                            echo -e "${NEON_BLUE}-------------------------------------------------------------------------------------------------${NC}"
                            h_choice="${h_choice//[[:space:]]/}"; h_choice="${h_choice,,}"
                            case "$h_choice" in
                                1|yay) chosen_helper="yay"; break ;;
                                2|paru) chosen_helper="paru"; break ;;
                                0|não|no|skip|omitir|pular) break 2 ;;
                                *)
                                    msg "Comando inválido! Tente novamente." \
                                        "Invalid command! Try again." \
                                        "¡Comando inválido! Inténtelo de nuevo."
                                    echo ""
                                    ;;
                            esac
                        done
                    elif [ $has_yay -eq 1 ]; then
                        chosen_helper="yay"
                    elif [ $has_paru -eq 1 ]; then
                        chosen_helper="paru"
                    fi

                    # Se for o pamac-all, instala o snapd DIRETAMENTE DO AUR usando o helper escolhido e ativa o socket
                    if [ $needs_snap -eq 1 ]; then
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                        msg "${CYAN_NEON}Instalando e configurando o snapd via AUR ($chosen_helper) para o pamac-all...${NC}" \
                            "${CYAN_NEON}Installing and configuring snapd via AUR ($chosen_helper) for pamac-all...${NC}" \
                            "${CYAN_NEON}Instalando y configurando snapd vía AUR ($chosen_helper) para pamac-all...${NC}"
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"    
                        echo ""
                        sleep 0.5
                        if "$chosen_helper" -S --needed --noconfirm snapd && manage_service enable snapd.socket && manage_service start snapd.socket; then
                            echo ""
                            msg "snapd instalado e habilitado com sucesso." \
                                "snapd successfully installed and enabled." \
                                "snapd instalado y habilitado con éxito."
                        else
                            echo ""
                            msg "Falha ao instalar ou habilitar o snapd." \
                                "Failed to install or enable snapd." \
                                "Error al instalar o habilitar snapd."
                        fi
                    fi
                    echo ""
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    msg "Instalando $pkg_name utilizando o $chosen_helper..." \
                        "Installing $pkg_name using $chosen_helper..." \
                        "Instalando $pkg_name usando $chosen_helper..."
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"    
                    sleep 0.5
                    if "$chosen_helper" -S --needed --noconfirm "$pkg_name"; then
                        msg "$pkg_name instalado com sucesso." \
                            "$pkg_name successfully installed." \
                            "$pkg_name instalado con éxito."
                        break 2
                    else
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                        msg "Falha na instalação de $pkg_name. Prosseguindo com o script..." \
                            "Failed to install $pkg_name. Proceeding with the script..." \
                            "Error al instalar $pkg_name. Prosiguiendo con el script..."
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"    
                        return 0
                    fi
                done
                break
                ;;
            0|voltar|pular|back|skip|volver|omitir)
                msg "Pamac ignorado, seguindo o script..." \
                    "Pamac skipped, proceeding with the script..." \
                    "Pamac omitido, prosiguiendo con el script..."
                break
                ;;
            *)
                msg "Comando inválido! Tente novamente." \
                    "Invalid command! Try again." \
                    "¡Comando inválido! Inténtelo de nuevo."
                echo ""
                ;;
        esac
    done

    return 0
}

#=========================================
#ENCERRAMENTO FUNÇÃO HELPER
#=========================================
FUNCAO_INSTALAR_NAVEGADORES() {
    local has_yay=0
    local has_paru=0

    # Tabela única de navegadores (índice 1 a 5): nome, pacote e se é AUR (1) ou repositório oficial (0)
    local -a nav_nomes=("" "Firefox" "Vivaldi" "Google Chrome" "Brave Browser" "Zen Browser")
    local -a nav_pkgs=("" "firefox" "vivaldi" "google-chrome" "brave-bin" "zen-browser-bin")
    local -a nav_aur=(0 0 0 1 1 1)

    local nav_opt nav_multi h_inst h_choice
    local idx i ch pkg_name nome lista
    local chosen_helper helper_nome helper_dep tmp_dir
    local helper_ok aur_pode cancelado

    # Verifica os helpers já instalados no sistema
    command -v yay &> /dev/null && has_yay=1
    command -v paru &> /dev/null && has_paru=1

    while true; do
        local -a selecionados=()
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        msg "${CYAN_NEON}Selecione o navegador que deseja instalar:${NC}" \
            "${CYAN_NEON}Select the browser you want to install:${NC}" \
            "${CYAN_NEON}Seleccione el navegador que desea instalar:${NC}"
        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
        sleep 0.7
        echo ""

        msg "1) Firefox (Repositório Oficial / Extra)" \
            "1) Firefox (Official Repository / Extra)" \
            "1) Firefox (Repositorio Oficial / Extra)"

        echo ""

        msg "2) Vivaldi (Repositório Oficial / Extra)" \
            "2) Vivaldi (Official Repository / Extra)" \
            "2) Vivaldi (Repositorio Oficial / Extra)"

        echo ""

        msg "3) Google-Chrome (AUR - Requer Helper)" \
            "3) Google-Chrome (AUR - Requires Helper)" \
            "3) Google-Chrome (AUR - Requiere Helper)"

        echo ""

        msg "4) Brave Browser (AUR - Requer Helper)" \
            "4) Brave Browser (AUR - Requires Helper)" \
            "4) Brave Browser (AUR - Requiere Helper)"

        echo ""

        msg "5) Zen browser (AUR - Requer Helper)" \
            "5) Zen browser (AUR - Requires Helper)" \
            "5) Zen browser (AUR - Requiere Helper)"

        echo ""

        msg "6) Instalar multiplos navegadores" \
            "6) Install multiple browsers" \
            "6) Instalar múltiples navegadores"

        echo ""

        msg "0) Concluir / Seguir com o script" \
            "0) Finish / Proceed with script" \
            "0) Finalizar / Continuar con el script"
        echo ""
        read -rp "Escolha / Choice / Opción: 1-2-3-4-5-6-0 " nav_opt || return 1
        nav_opt="${nav_opt//[[:space:]]/}"
        nav_opt="${nav_opt,,}"

        case "$nav_opt" in
            1|firefox)
                selecionados=(1)
                ;;
            2|vivaldi)
                selecionados=(2)
                ;;
            3|google-chrome|googlechrome|chrome)
                selecionados=(3)
                ;;
            4|brave|brave-browser|brave-bin)
                selecionados=(4)
                ;;
            5|zen|zen-browser|zenbrowser|zen-browser-bin)
                selecionados=(5)
                ;;
            6|multi|multiplo|multiplos|multiple|multiples|múltiples|instalar-multiplo|install-multiple|instalar-múltiples)
                # Seleção livre: aceita qualquer sequência de números de 1 a 5, em qualquer ordem,
                # com qualquer separador e com repetições (ex: "1 4 2 3 4 1 2 3 4 5 5 2", "1,3,5", "245").
                # Cada dígito 1-5 vira uma escolha; duplicados são descartados mantendo a ordem de entrada.
                cancelado=0
                echo ""
                while true; do
                    local -A vistos=()
                    local -A rejeitados=()
                    local -a ignorados=()
                    selecionados=()
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    msg "${CYAN_NEON}Digite os números dos navegadores que quer instalar (de 1 a 5):${NC}" \
                        "${CYAN_NEON}Enter the numbers of the browsers you want to install (from 1 to 5):${NC}" \
                        "${CYAN_NEON}Introduce los números de los navegadores que quieres instalar (del 1 al 5):${NC}"
                    echo ""
                    msg "Exemplos: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (qualquer ordem, repetidos são ignorados)" \
                        "Examples: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (any order, repeated ones are ignored)" \
                        "Ejemplos: 1 4 2  |  1,3,5  |  1-2-3-4-5  |  12345  (cualquier orden, los repetidos se ignoran)"
                    echo ""
                    msg "0) Voltar ao menu" \
                        "0) Back to menu" \
                        "0) Volver al menú"
                    echo ""
                    read -rp "Escolha / Choice / Opción: " nav_multi || return 1
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    nav_multi="${nav_multi,,}"

                    # Entrada só com "0" (ou palavra de cancelamento): volta ao menu principal
                    case "${nav_multi//[[:space:]]/}" in
                        0|cancelar|cancel|voltar|back|volver|n|no|nao|não)
                            cancelado=1
                            break
                            ;;
                    esac

                    # Percorre caractere por caractere: dígitos 1-5 entram na lista (sem repetir),
                    # separadores e conectivos (e / y / and) são ignorados em silêncio,
                    # qualquer outra coisa é avisada ao usuário e descartada.
                    for ((i = 0; i < ${#nav_multi}; i++)); do
                        ch="${nav_multi:i:1}"
                        case "$ch" in
                            [1-5])
                                if [ -z "${vistos[$ch]:-}" ]; then
                                    vistos[$ch]=1
                                    selecionados+=("$ch")
                                fi
                                ;;
                            [[:space:]]|[,\;.:/+_\\\|-]|[eyand])
                                ;;
                            *)
                                if [ -z "${rejeitados[$ch]:-}" ]; then
                                    rejeitados[$ch]=1
                                    ignorados+=("$ch")
                                fi
                                ;;
                        esac
                    done

                    if [ "${#selecionados[@]}" -eq 0 ]; then
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                        msg "${YELLOW_NEON}Nenhum navegador válido na entrada. Use números de 1 a 5.${NC}" \
                            "${YELLOW_NEON}No valid browser in the input. Use numbers from 1 to 5.${NC}" \
                            "${YELLOW_NEON}Ningún navegador válido en la entrada. Use números del 1 al 5.${NC}"
                        echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                        echo ""
                        continue
                    fi

                    if [ "${#ignorados[@]}" -gt 0 ]; then
                        echo ""
                        msg "${YELLOW_NEON}[AVISO]: Entradas ignoradas (fora de 1-5): ${ignorados[*]}${NC}" \
                            "${YELLOW_NEON}[WARNING]: Ignored entries (outside 1-5): ${ignorados[*]}${NC}" \
                            "${YELLOW_NEON}[AVISO]: Entradas ignoradas (fuera de 1-5): ${ignorados[*]}${NC}"
                    fi
                    break
                done

                if [ "$cancelado" -eq 1 ]; then
                    echo ""
                    continue
                fi
                ;;
            0|concluir|finish|finalizar)
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${CYAN_NEON}Instalação de navegadores finalizada. Prosseguindo com o script...${NC}" \
                    "${CYAN_NEON}Browser installation completed. Proceeding with the script...${NC}" \
                    "${CYAN_NEON}Instalación de navegadores finalizada. Prosiguiendo con el script...${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                return 0
                ;;
            *)
                msg "Comando inválido! Tente novamente." \
                    "Invalid command! Try again." \
                    "¡Comando inválido! Inténtelo de nuevo."
                echo ""
                continue
                ;;
        esac

        # Fila de instalação: repositório oficial primeiro, AUR depois (o helper é resolvido uma única vez)
        local -a aur_fila=()
        local -a res_ok=() res_falha=() res_pulado=()

        echo ""
        lista=""
        for idx in "${selecionados[@]}"; do
            lista+="${nav_nomes[$idx]}, "
        done
        lista="${lista%, }"
        if [ "${#selecionados[@]}" -gt 1 ]; then
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "${CYAN_NEON}Navegadores selecionados: ${lista}${NC}" \
                "${CYAN_NEON}Selected browsers: ${lista}${NC}" \
                "${CYAN_NEON}Navegadores seleccionados: ${lista}${NC}"
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            echo ""
            sleep 0.5
        fi

        # ---------------------------------------------------------------
        # Etapa 1: pacotes do repositório oficial (Extra)
        # ---------------------------------------------------------------
        for idx in "${selecionados[@]}"; do
            nome="${nav_nomes[$idx]}"
            pkg_name="${nav_pkgs[$idx]}"

            if [ "${nav_aur[$idx]}" -eq 1 ]; then
                aur_fila+=("$idx")
                continue
            fi
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            msg "Instalando $nome ($pkg_name) via Pacman..." \
                "Installing $nome ($pkg_name) via Pacman..." \
                "Instalando $nome ($pkg_name) vía Pacman..."
            echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
            echo ""
            sleep 0.5

            # Pacote inexistente derrubaria a transação inteira: verifica antes
            if ! pacman -Si "$pkg_name" &> /dev/null; then
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"            
                msg "${RED_NEON}Pacote $pkg_name não encontrado nos repositórios. Sincronize o pacman (pacman -Syu) e tente novamente.${NC}" \
                    "${RED_NEON}Package $pkg_name not found in the repositories. Sync pacman (pacman -Syu) and try again.${NC}" \
                    "${RED_NEON}Paquete $pkg_name no encontrado en los repositorios. Sincroniza pacman (pacman -Syu) e inténtalo de nuevo.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                res_falha+=("$nome")
                continue
            fi

            if sudo pacman -S --needed --noconfirm "$pkg_name"; then
                echo ""
                echo -e "${NEON_BLUE}------------------------------------------------------------------${NC}"
                msg "${CYAN_NEON}$nome instalado com sucesso!${NC}" \
                    "${CYAN_NEON}$nome successfully installed!${NC}" \
                    "${CYAN_NEON}¡$nome instalado con éxito!${NC}"
                echo -e "${NEON_BLUE}------------------------------------------------------------------${NC}"    
                sleep 0.5
                echo ""
                res_ok+=("$nome")
            else
                echo ""
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${RED_NEON}Falha ao instalar $nome.${NC}" \
                    "${RED_NEON}Failed to install $nome.${NC}" \
                    "${RED_NEON}Error al instalar $nome.${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                res_falha+=("$nome")
            fi
        done

        # ---------------------------------------------------------------
        # Etapa 2: pacotes do AUR (helper resolvido uma vez para todos)
        # ---------------------------------------------------------------
        if [ "${#aur_fila[@]}" -gt 0 ]; then
            aur_pode=1
            chosen_helper=""

            # makepkg/yay/paru se recusam a rodar como root
            if [ "$(id -u)" -eq 0 ]; then
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${RED_NEON}Os pacotes do AUR não podem ser instalados como root. Execute o script com um usuário comum (com sudo).${NC}" \
                    "${RED_NEON}AUR packages cannot be installed as root. Run the script as a regular user (with sudo).${NC}" \
                    "${RED_NEON}Los paquetes del AUR no pueden instalarse como root. Ejecute el script con un usuario normal (con sudo).${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                aur_pode=0
            fi

            # Se não houver nenhum helper instalado, oferece a instalação sob demanda
            if [ "$aur_pode" -eq 1 ] && [ "$has_yay" -eq 0 ] && [ "$has_paru" -eq 0 ]; then
                lista=""
                for idx in "${aur_fila[@]}"; do
                    lista+="${nav_nomes[$idx]}, "
                done
                lista="${lista%, }"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                msg "${YELLOW_NEON}Atenção: os pacotes do AUR (${lista}) requerem um AUR helper (yay ou paru).${NC}" \
                    "${YELLOW_NEON}Attention: the AUR packages (${lista}) require an AUR helper (yay or paru).${NC}" \
                    "${YELLOW_NEON}Atención: los paquetes del AUR (${lista}) requieren un AUR helper (yay o paru).${NC}"
                echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                echo ""
                sleep 0.5
                helper_ok=0
                while true; do
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"                
                    msg "${CYAN_NEON}Deseja instalar um AUR helper agora para prosseguir?${NC}" \
                        "${CYAN_NEON}Do you want to install an AUR helper now to proceed?${NC}" \
                        "${CYAN_NEON}¿Desea instalar un AUR helper ahora para continuar?${NC}"
                   echo ""

                    msg "1) Instalar 'yay'" \
                        "1) Install 'yay'" \
                        "1) Instalar 'yay'"

                    echo ""

                    msg "2) Instalar 'paru'" \
                        "2) Install 'paru'" \
                        "2) Instalar 'paru'"

                    echo ""

                    msg "0) Cancelar instalação dos pacotes do AUR" \
                        "0) Cancel the AUR packages installation" \
                        "0) Cancelar la instalación de los paquetes del AUR"
                    echo ""
                    read -rp "Escolha / Choice / Opción: 1-2-0 " h_inst || return 1
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    h_inst="${h_inst//[[:space:]]/}"
                    h_inst="${h_inst,,}"

                    case "$h_inst" in
                        1|yay)
                            helper_nome="yay"
                            helper_dep="go"
                            ;;
                        2|paru)
                            helper_nome="paru"
                            helper_dep="rust"
                            ;;
                        0|cancelar|cancel)
                            msg "Instalação do AUR helper cancelada." \
                                "AUR helper installation canceled." \
                                "Instalación del AUR helper cancelada."
                            echo ""
                            break
                            ;;
                        *)
                            msg "Comando inválido! Tente novamente." \
                                "Invalid command! Try again." \
                                "¡Comando inválido! Inténtelo de nuevo."
                            echo ""
                            continue
                            ;;
                    esac

                    msg "Instalando ${helper_nome}-bin..." \
                        "Installing ${helper_nome}-bin..." \
                        "Instalando ${helper_nome}-bin..."
                    echo ""

                    tmp_dir=$(mktemp -d) || {
                        msg "${RED_NEON}Não foi possível criar o diretório temporário.${NC}" \
                            "${RED_NEON}Could not create the temporary directory.${NC}" \
                            "${RED_NEON}No se pudo crear el directorio temporal.${NC}"
                        echo ""
                        break
                    }

                    if sudo pacman -S --needed --noconfirm git base-devel "$helper_dep" && \
                       git clone "https://aur.archlinux.org/${helper_nome}-bin.git" "$tmp_dir/${helper_nome}-bin" && \
                       (cd "$tmp_dir/${helper_nome}-bin" && makepkg -si --noconfirm); then
                        rm -rf "$tmp_dir"
                        if command -v "$helper_nome" &> /dev/null; then
                            if [ "$helper_nome" = "yay" ]; then
                                has_yay=1
                            else
                                has_paru=1
                            fi
                            helper_ok=1
                            echo ""
                            msg "${CYAN_NEON}${helper_nome}-bin instalado com sucesso!${NC}" \
                                "${CYAN_NEON}${helper_nome}-bin successfully installed!${NC}" \
                                "${CYAN_NEON}¡${helper_nome}-bin instalado con éxito!${NC}"
                            echo ""
                            break
                        fi
                    else
                        rm -rf "$tmp_dir"
                    fi

                    msg "${RED_NEON}Falha na instalação do ${helper_nome}-bin.${NC}" \
                        "${RED_NEON}Failed to install ${helper_nome}-bin.${NC}" \
                        "${RED_NEON}Error al instalar ${helper_nome}-bin.${NC}"
                    echo ""
                done

                # Cancelou ou falhou: os navegadores do AUR são pulados e o menu volta
                if [ "$helper_ok" -eq 0 ]; then
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"
                    msg "${YELLOW_NEON}Nenhum helper disponível. Navegadores do AUR cancelados: ${lista}.${NC}" \
                        "${YELLOW_NEON}No helper available. AUR browsers canceled: ${lista}.${NC}" \
                        "${YELLOW_NEON}Ningún helper disponible. Navegadores del AUR cancelados: ${lista}.${NC}"
                    echo -e "${NEON_BLUE}--------------------------------------------------------------------------------------${NC}"    
                    echo ""
                    aur_pode=0
                fi
            fi

            # Seleciona qual helper utilizar (uma única vez) caso ambos estejam instalados
            if [ "$aur_pode" -eq 1 ]; then
                if [ "$has_yay" -eq 1 ] && [ "$has_paru" -eq 1 ]; then
                    while true; do
                        echo -e "${NEON_BLUE}-----------------------------------------------------------------------------------------------------------${NC}"
                        msg "${CYAN_NEON}Ambos os helpers (yay e paru) estão instalados. Qual deseja usar para instalar os pacotes do AUR?${NC}" \
                            "${CYAN_NEON}Both helpers (yay and paru) are installed. Which one do you want to use to install the AUR packages?${NC}" \
                            "${CYAN_NEON}Ambos los helpers (yay y paru) están instalados. ¿Cuál desea usar para instalar los paquetes del AUR?${NC}"
                        echo ""
                        sleep 0.5
                        msg "1) yay" \
                            "1) yay" \
                            "1) yay"

                        echo ""

                        msg "2) paru" \
                            "2) paru" \
                            "2) paru"

                        echo ""

                        msg "0) Cancelar instalação dos pacotes do AUR" \
                            "0) Cancel the AUR packages installation" \
                            "0) Cancelar la instalación de los paquetes del AUR"
                        echo ""
                        read -rp "Escolha / Choice / Opción: 1-2-0 " h_choice || return 1
                        echo -e "${NEON_BLUE}-----------------------------------------------------------------------------------------------------------${NC}"
                        h_choice="${h_choice//[[:space:]]/}"
                        h_choice="${h_choice,,}"
                        case "$h_choice" in
                            1|yay) chosen_helper="yay"; break ;;
                            2|paru) chosen_helper="paru"; break ;;
                            0|cancelar|cancel)
                                msg "${YELLOW_NEON}Instalação dos pacotes do AUR cancelada.${NC}" \
                                    "${YELLOW_NEON}AUR packages installation canceled.${NC}" \
                                    "${YELLOW_NEON}Instalación de los paquetes del AUR cancelada.${NC}"
                                echo ""
                                aur_pode=0
                                break
                                ;;
                            *)
                                msg "Comando inválido! Tente novamente." \
                                    "Invalid command! Try again." \
                                    "¡Comando inválido! Inténtelo de nuevo."
                                echo ""
                                ;;
                        esac
                    done
                elif [ "$has_yay" -eq 1 ]; then
                    chosen_helper="yay"
                elif [ "$has_paru" -eq 1 ]; then
                    chosen_helper="paru"
                fi
            fi

            # Instalação de cada navegador do AUR com o helper escolhido
            if [ "$aur_pode" -eq 1 ] && [ -n "$chosen_helper" ]; then
                for idx in "${aur_fila[@]}"; do
                    nome="${nav_nomes[$idx]}"
                    pkg_name="${nav_pkgs[$idx]}"

                    sleep 0.5
                    msg "Instalando $nome ($pkg_name) utilizando $chosen_helper..." \
                        "Installing $nome ($pkg_name) using $chosen_helper..." \
                        "Instalando $nome ($pkg_name) usando $chosen_helper..."
                    echo ""

                    if "$chosen_helper" -S --needed --noconfirm "$pkg_name"; then
                        echo ""
                        msg "${CYAN_NEON}$nome instalado com sucesso via $chosen_helper!${NC}" \
                            "${CYAN_NEON}$nome successfully installed via $chosen_helper!${NC}" \
                            "${CYAN_NEON}¡$nome instalado con éxito vía $chosen_helper!${NC}"
                        res_ok+=("$nome")
                    else
                        echo ""
                        msg "${RED_NEON}Falha na instalação de $nome via $chosen_helper.${NC}" \
                            "${RED_NEON}Failed to install $nome via $chosen_helper.${NC}" \
                            "${RED_NEON}Error al instalar $nome vía $chosen_helper.${NC}"
                        res_falha+=("$nome")
                    fi
                    echo ""
                done
            else
                for idx in "${aur_fila[@]}"; do
                    res_pulado+=("${nav_nomes[$idx]}")
                done
            fi
        fi

        # ---------------------------------------------------------------
        # Resumo (apenas quando houve mais de um navegador na seleção)
        # ---------------------------------------------------------------
        if [ "${#selecionados[@]}" -gt 1 ]; then
            msg "${CYAN_NEON}Resumo da instalação:${NC}" \
                "${CYAN_NEON}Installation summary:${NC}" \
                "${CYAN_NEON}Resumen de la instalación:${NC}"
            echo ""
            if [ "${#res_ok[@]}" -gt 0 ]; then
                printf -v lista '%s, ' "${res_ok[@]}"
                lista="${lista%, }"
                msg "${CYAN_NEON}Instalados: ${lista}${NC}" \
                    "${CYAN_NEON}Installed: ${lista}${NC}" \
                    "${CYAN_NEON}Instalados: ${lista}${NC}"
            fi
            if [ "${#res_falha[@]}" -gt 0 ]; then
                printf -v lista '%s, ' "${res_falha[@]}"
                lista="${lista%, }"
                msg "${RED_NEON}Falharam: ${lista}${NC}" \
                    "${RED_NEON}Failed: ${lista}${NC}" \
                    "${RED_NEON}Fallaron: ${lista}${NC}"
            fi
            if [ "${#res_pulado[@]}" -gt 0 ]; then
                printf -v lista '%s, ' "${res_pulado[@]}"
                lista="${lista%, }"
                msg "${YELLOW_NEON}Pulados (AUR): ${lista}${NC}" \
                    "${YELLOW_NEON}Skipped (AUR): ${lista}${NC}" \
                    "${YELLOW_NEON}Omitidos (AUR): ${lista}${NC}"
            fi
            echo ""
            sleep 0.5
        fi
    done

    return 0
}

