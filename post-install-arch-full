                rm -rf -- "$gm_tmp"; gm_tmp=""
                gm_helper="yay"
                msg "${CYAN_NEON}[OK] yay-bin instalado com sucesso.${NC}" \
                    "${CYAN_NEON}[OK] yay-bin successfully installed.${NC}" \
                    "${CYAN_NEON}[OK] yay-bin instalado con éxito.${NC}"
            else
                if [[ -n $gm_tmp ]]; then rm -rf -- "$gm_tmp"; gm_tmp=""; fi
                ((++gm_opc))
                msg "${YELLOW_NEON}[AVISO] Não foi possível instalar o yay-bin automaticamente. Etapa AUR ignorada.${NC}" \
                    "${YELLOW_NEON}[WARNING] Could not install yay-bin automatically. AUR step skipped.${NC}" \
